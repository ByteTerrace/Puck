<Project>
    <!-- Generated by `puck shaders generate` from Puck.Shaders.ShaderCompiler.StepsOf, the DXC recipe the runtime
         shader compiler runs too; never edit it. build/Shaders.targets compiles every stage source with these
         options, followed by -Fo <bytecode> <source>. -->
    <PropertyGroup>
        <PuckDxcVertexSpirv>-spirv -fspv-target-env=vulkan1.3 -fspv-entrypoint-name=main -enable-16bit-types -O3 -T vs_6_6 -E VSMain</PuckDxcVertexSpirv>
        <PuckDxcVertexDxil>-Wno-ignored-attributes -enable-16bit-types -O3 -T vs_6_6 -E VSMain</PuckDxcVertexDxil>
        <PuckDxcFragmentSpirv>-spirv -fspv-target-env=vulkan1.3 -fspv-entrypoint-name=main -enable-16bit-types -O3 -T ps_6_6 -E PSMain</PuckDxcFragmentSpirv>
        <PuckDxcFragmentDxil>-Wno-ignored-attributes -enable-16bit-types -O3 -T ps_6_6 -E PSMain</PuckDxcFragmentDxil>
        <PuckDxcComputeSpirv>-spirv -fspv-target-env=vulkan1.3 -fspv-entrypoint-name=main -enable-16bit-types -O3 -T cs_6_6 -E CSMain</PuckDxcComputeSpirv>
        <PuckDxcComputeDxil>-Wno-ignored-attributes -enable-16bit-types -O3 -T cs_6_6 -E CSMain</PuckDxcComputeDxil>
    </PropertyGroup>
</Project>
