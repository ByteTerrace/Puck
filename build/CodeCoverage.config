<?xml version="1.0" encoding="utf-8"?>
<!-- The coverage settings every CI test run takes (CliTestRun.Coverage): it measures the Puck assemblies a test host
     loads, never a test assembly or a verification harness (the Puck.*.Post emulator batteries, which the suites run to
     reach the cores they check), and leaves out sources generated under obj/. Which lines may stay unmeasured
     (hardware-only code) is not decided here: `puck artifacts coverage` reads build/CoverageHardwareOnly.txt, the one list,
     and leaves the Puck.*.Post projects out of its denominator. -->
<Configuration>
  <Format>cobertura</Format>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Puck\.[^\\/]*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*Tests\.dll$</ModulePath>
        <ModulePath>.*[\\/]Puck\.[^\\/]*\.Post\.dll$</ModulePath>
        <ModulePath>.*[\\/]Puck\.State\.Rebuild\.Corpus\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
