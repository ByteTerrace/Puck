<Project>
    <!--
        The shared shader build. DXC compiles HLSL to SPIR-V (Vulkan) and DXIL (DirectX) from whatever
        @(VertexShaderSource)/@(FragmentShaderSource)/@(ComputeShaderSource) items a consuming project declares in its
        own csproj; this file adds no stage sources and no project-specific branching. Imported once by
        Directory.Build.targets into every project; a project declaring none of the three item types runs nothing here
        unless bytecode remains under its Assets/Shaders, which the build then removes as it removes any deleted source's.
        Per-project knobs, set in a project's own PropertyGroup before this file imports: $(DxcCommand) (default "dxc",
        a bare name resolved on the search path or a path to the executable), $(PuckShaderDxilEnabled) (default true:
        vertex and fragment DXIL), $(PuckComputeShaderDxilEnabled) (default true: compute DXIL) and
        $(PuckShaderSpirvEnabled) (default true: SPIR-V for every stage). A project with no DirectX consumer sheds the
        DXIL, and one whose shaders run only on Direct3D 12 sheds the SPIR-V, it would otherwise ship unread.

        Every output compiles through Puck.Shaders.ShaderCompiler, the compiler the runtime and the CLI run, in its
        content-addressed cache: $(PuckShaderCacheDirectory), by default `shaders` in the per-user Puck directory
        (ShaderCompiler.DefaultCacheDirectory). An output is keyed by its stage source's precise include closure
        (ShaderSourceClosure), the options ShaderCompiler.StepsOf gives it, and the DXC it runs, never by where the
        checkout lies, so a shader any checkout on this machine has compiled is published from the cache and runs no
        compiler, and editing one include recompiles only the outputs whose closure holds it. Missing outputs compile
        concurrently, the longest first, on cores MSBuild grants through its own core budget, which every project node
        shares. Point $(PuckShaderCacheDirectory) at another directory to share a cache on purpose, or at an empty one to
        compile everything afresh, as the cross-host shader comparison does. Every compile stamps the entries it uses,
        which is what `puck shaders cache prune` evicts by.
    -->
    <UsingTask AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll" TaskFactory="RoslynCodeTaskFactory" TaskName="PuckShaderBuild">
        <ParameterGroup>
            <Host ParameterType="System.String" Required="true" />
            <Tool ParameterType="System.String" Required="true" />
            <Mode ParameterType="System.String" Required="true" />
            <ProjectDirectory ParameterType="System.String" Required="true" />
            <LockFile ParameterType="System.String" Required="true" />
            <RequestFile ParameterType="System.String" Required="true" />
            <Outputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <CacheDirectory ParameterType="System.String" />
            <DxcCommand ParameterType="System.String" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckShaderBuild.cs" Type="Class" />
        </Task>
    </UsingTask>

    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckCompileDirect3D11Kernels"
    >
        <ParameterGroup>
            <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <Bytecode ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckDirect3D11KernelBytecode.cs" Type="Class" />
        </Task>
    </UsingTask>
    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckCollectDirect3D11Kernels"
    >
        <ParameterGroup>
            <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <Bytecode ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckDirect3D11KernelBytecode.cs" Type="Class" />
        </Task>
    </UsingTask>

    <PropertyGroup>
        <!-- The lock belongs to the source-tree bytecode, which all configurations and intermediate-output paths share. -->
        <_PuckShaderPublishLock>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'obj', 'shader-publish.lock'))</_PuckShaderPublishLock>
        <DxcCommand Condition="'$(DxcCommand)' == ''">dxc</DxcCommand>
        <PuckShaderDxilEnabled Condition="'$(PuckShaderDxilEnabled)' == ''">true</PuckShaderDxilEnabled>
        <PuckComputeShaderDxilEnabled Condition="'$(PuckComputeShaderDxilEnabled)' == ''">true</PuckComputeShaderDxilEnabled>
        <PuckShaderSpirvEnabled Condition="'$(PuckShaderSpirvEnabled)' == ''">true</PuckShaderSpirvEnabled>
        <!-- The build-only host that runs the shader build; every shader project references it with
             ReferenceOutputAssembly="false", so it is built before CompileShaders runs. -->
        <_PuckShaderBuildToolProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'src', 'Puck.Shaders.Generator', 'Puck.Shaders.Generator.csproj'))</_PuckShaderBuildToolProject>
        <_PuckShaderBuildHost>$(DOTNET_HOST_PATH)</_PuckShaderBuildHost>
        <_PuckShaderBuildHost Condition="'$(_PuckShaderBuildHost)' == ''">dotnet</_PuckShaderBuildHost>
    </PropertyGroup>

    <!-- One output a stage source and enabled target, written beside the source as <stem>.spv or <stem>.dxil with a
         <stem>.<target>.hash sidecar. -->
    <ItemGroup>
        <_PuckExistingShaderBytecode Include="$(MSBuildProjectDirectory)/Assets/Shaders/**/*.spv;$(MSBuildProjectDirectory)/Assets/Shaders/**/*.dxil" />
        <PuckShaderOutput Include="@(VertexShaderSource -> '%(RootDir)%(Directory)%(Filename).spv')" Condition="'$(PuckShaderSpirvEnabled)' == 'true'">
            <Stage>Vertex</Stage>
            <Backend>Spirv</Backend>
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
        </PuckShaderOutput>
        <PuckShaderOutput Include="@(VertexShaderSource -> '%(RootDir)%(Directory)%(Filename).dxil')" Condition="'$(PuckShaderDxilEnabled)' == 'true'">
            <Stage>Vertex</Stage>
            <Backend>Dxil</Backend>
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
        </PuckShaderOutput>
        <PuckShaderOutput Include="@(FragmentShaderSource -> '%(RootDir)%(Directory)%(Filename).spv')" Condition="'$(PuckShaderSpirvEnabled)' == 'true'">
            <Stage>Fragment</Stage>
            <Backend>Spirv</Backend>
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
        </PuckShaderOutput>
        <PuckShaderOutput Include="@(FragmentShaderSource -> '%(RootDir)%(Directory)%(Filename).dxil')" Condition="'$(PuckShaderDxilEnabled)' == 'true'">
            <Stage>Fragment</Stage>
            <Backend>Dxil</Backend>
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
        </PuckShaderOutput>
        <PuckShaderOutput Include="@(ComputeShaderSource -> '%(RootDir)%(Directory)%(Filename).spv')" Condition="'$(PuckShaderSpirvEnabled)' == 'true'">
            <Stage>Compute</Stage>
            <Backend>Spirv</Backend>
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
        </PuckShaderOutput>
        <PuckShaderOutput Include="@(ComputeShaderSource -> '%(RootDir)%(Directory)%(Filename).dxil')" Condition="'$(PuckComputeShaderDxilEnabled)' == 'true'">
            <Stage>Compute</Stage>
            <Backend>Dxil</Backend>
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
        </PuckShaderOutput>
    </ItemGroup>

    <Target Name="ResolveShaderBuildTool" Condition="('@(PuckShaderOutput)' != '' or '@(_PuckExistingShaderBytecode)' != '') and '$(PuckShaderBuildTool)' == ''">
        <MSBuild Projects="$(_PuckShaderBuildToolProject)" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
            <Output PropertyName="PuckShaderBuildTool" TaskParameter="TargetOutputs" />
        </MSBuild>
    </Target>

    <!-- Makes every output current: publishes what the cache holds and compiles the rest, with no compiler run while the
         project's publication lock is held. A kernel may include a declaration generated from C# (sdf-isa.hlsli, a
         *.interface.hlsli): the generator writes those as it builds, which ResolveProjectReferences finishes first. -->
    <Target Name="CompileShaders" AfterTargets="ResolveProjectReferences" Condition="'@(PuckShaderOutput)' != '' or '@(_PuckExistingShaderBytecode)' != ''" DependsOnTargets="ResolveShaderBuildTool">
        <PuckShaderBuild CacheDirectory="$(PuckShaderCacheDirectory)" DxcCommand="$(DxcCommand)" Host="$(_PuckShaderBuildHost)" LockFile="$(_PuckShaderPublishLock)" Mode="compile" Outputs="@(PuckShaderOutput)" ProjectDirectory="$(MSBuildProjectDirectory)" RequestFile="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'shader-build.txt'))" Tool="$(PuckShaderBuildTool)" />
        <PropertyGroup>
            <_PuckShadersCompiled>true</_PuckShadersCompiled>
        </PropertyGroup>
    </Target>

    <!-- Ships every output as content. A build has just made each one current under the publication lock; a pack that
         skips the build (CI packs over a finished build) instead checks that each is on disk with the sidecar its
         current closure and options publish, compiling nothing, so it ships exactly what a build would. -->
    <Target Name="CollectShaderBytecode" AfterTargets="CompileShaders" BeforeTargets="AssignTargetPaths;_GetPackageFiles" Condition="'@(PuckShaderOutput)' != '' or '@(_PuckExistingShaderBytecode)' != ''" DependsOnTargets="ResolveShaderBuildTool">
        <PuckShaderBuild Condition="'$(_PuckShadersCompiled)' != 'true'" DxcCommand="$(DxcCommand)" Host="$(_PuckShaderBuildHost)" LockFile="$(_PuckShaderPublishLock)" Mode="check" Outputs="@(PuckShaderOutput)" ProjectDirectory="$(MSBuildProjectDirectory)" RequestFile="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'shader-check.txt'))" Tool="$(PuckShaderBuildTool)" />
        <ItemGroup>
            <Content Include="@(PuckShaderOutput)" CopyToOutputDirectory="PreserveNewest" RemoveMetadata="Stage;Backend;SourcePath" />
        </ItemGroup>
    </Target>

    <!-- Kernel-class probe kernels and the camera frame converter's conversion kernels run on a camera graph's own
         Direct3D 11 device, so each @(Direct3D11KernelSource) item's entry points (its Entries metadata) compile to
         cs_5_0 DXBC here, beside the source as <stem>.<entry>.dxbc, and ship as content: a world run creates a kernel
         from its bytecode and compiles nothing. Direct3D 11 exists only on Windows, so a build elsewhere writes no kernel
         bytecode. Compilation is a build operation; packing collects and validates existing outputs separately. -->
    <Target Name="CompileDirect3D11Kernels" BeforeTargets="AssignTargetPaths">
        <PuckCompileDirect3D11Kernels Condition="'@(Direct3D11KernelSource)' != '' and $([MSBuild]::IsOSPlatform('Windows'))" Sources="@(Direct3D11KernelSource)">
            <Output ItemName="_PuckDirect3D11KernelBytecode" TaskParameter="Bytecode" />
        </PuckCompileDirect3D11Kernels>
    </Target>
    <Target Name="CollectDirect3D11KernelBytecode" AfterTargets="CompileDirect3D11Kernels" BeforeTargets="AssignTargetPaths;_GetPackageFiles">
        <PuckCollectDirect3D11Kernels Condition="'@(Direct3D11KernelSource)' != '' and $([MSBuild]::IsOSPlatform('Windows'))" Sources="@(Direct3D11KernelSource)">
            <Output ItemName="_PuckCollectedDirect3D11KernelBytecode" TaskParameter="Bytecode" />
        </PuckCollectDirect3D11Kernels>
        <ItemGroup>
            <Content Include="@(_PuckCollectedDirect3D11KernelBytecode)" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

</Project>
