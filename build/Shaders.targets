<Project>
    <!--
        The shared shader-compile recipe. DXC compiles HLSL to SPIR-V (Vulkan) and DXIL (DirectX) from whatever
        @(VertexShaderSource)/@(FragmentShaderSource)/@(ComputeShaderSource) items a consuming project declares in its
        own csproj — this file adds no stage sources and no project-specific branching. Imported once by
        Directory.Build.targets into EVERY project; a project declaring none of the three item types never triggers a
        single Exec. Per-project knobs, set in a project's own PropertyGroup BEFORE this file imports: $(DxcCommand)
        (default "dxc"), $(PuckShaderDxilEnabled) (default true — governs vertex/fragment DXIL emission),
        $(PuckComputeShaderDxilEnabled) (default true — governs compute DXIL emission),
        $(PuckShaderSpirvEnabled) (default true — governs SPIR-V emission for every stage). A project with no DirectX
        consumer (or whose compute kernels only ever run on Vulkan) sheds the DXIL, and one whose shaders run only on
        Direct3D 12 sheds the SPIR-V, it would otherwise ship unread.

        This is the SAME physical file two ways: an in-repo project imports it transitively through
        Directory.Build.targets, and an external ByteTerrace.Puck.Shaders package consumer imports the identical file
        via buildTransitive/ByteTerrace.Puck.Shaders.targets (src/Puck.Shaders/Puck.Shaders.csproj packs it there).
        Never fork the two paths — a change here reaches both consumers identically.
    -->
    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckWriteShaderHashSidecars"
    >
        <ParameterGroup>
            <BytecodeFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <Includes ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <Token ParameterType="System.String" />
            <LockFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckShaderHashSidecars.cs" Type="Class" />
        </Task>
    </UsingTask>
    <UsingTask AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll" TaskFactory="RoslynCodeTaskFactory" TaskName="PuckSelectShaderCompiles">
        <ParameterGroup>
            <BytecodeFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <Includes ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <LockFile ParameterType="System.String" Required="true" />
            <Stale ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckShaderHashSidecars.cs" Type="Class" />
        </Task>
    </UsingTask>
    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckValidateShaderBytecodeFresh"
    >
        <ParameterGroup>
            <ProjectDirectory ParameterType="System.String" Required="true" />
            <ExpectedBytecode ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <RecipeBytecode ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <BytecodeFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
            <Includes ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <LockFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckShaderHashSidecars.cs" Type="Class" />
        </Task>
    </UsingTask>

    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckRemoveOrphanedShaderBytecode"
    >
        <ParameterGroup>
            <BytecodeFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <Sidecars ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <Removed ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
            <LockFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckShaderHashSidecars.cs" Type="Class" />
        </Task>
    </UsingTask>

    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckCompileDirect3D11Kernels"
    >
        <ParameterGroup>
            <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <Bytecode ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckDirect3D11KernelBytecode.cs" Type="Class" />
        </Task>
    </UsingTask>
    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckCollectDirect3D11Kernels"
    >
        <ParameterGroup>
            <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <Bytecode ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckDirect3D11KernelBytecode.cs" Type="Class" />
        </Task>
    </UsingTask>

    <!-- The DXC options of every stage and target, generated from Puck.Shaders.ShaderCompiler.StepsOf, which the
         runtime shader compiler runs too: one recipe. -->
    <Import Project="$(MSBuildThisFileDirectory)ShaderRecipe.targets" />

    <PropertyGroup>
        <!-- The lock belongs to the source-tree bytecode, which all configurations and intermediate-output paths share. -->
        <_PuckShaderPublishLock>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'obj', 'shader-publish.lock'))</_PuckShaderPublishLock>
        <DxcCommand Condition="'$(DxcCommand)' == ''">dxc</DxcCommand>
        <PuckShaderDxilEnabled Condition="'$(PuckShaderDxilEnabled)' == ''">true</PuckShaderDxilEnabled>
        <PuckComputeShaderDxilEnabled Condition="'$(PuckComputeShaderDxilEnabled)' == ''">true</PuckComputeShaderDxilEnabled>
        <PuckShaderSpirvEnabled Condition="'$(PuckShaderSpirvEnabled)' == ''">true</PuckShaderSpirvEnabled>
    </PropertyGroup>

    <!-- Bytecode with no same-stem .hlsl: the build removes what it wrote (its sidecar records the file's bytes),
         naming each removal on one line, and refuses anything else, which it leaves in place. Sidecars are found by
         the Assets/Shaders convention CollectShaderBytecode ships from. -->
    <Target Name="ValidateShaderBytecodeSources" BeforeTargets="PrepareForBuild">
        <ItemGroup>
            <_PuckShaderSidecar Include="Assets/Shaders/**/*.spv.hash;Assets/Shaders/**/*.dxil.hash" />
        </ItemGroup>
        <PuckRemoveOrphanedShaderBytecode Condition="'@(ShaderBytecode)' != '' or '@(_PuckShaderSidecar)' != ''" BytecodeFiles="@(ShaderBytecode)" LockFile="$(_PuckShaderPublishLock)" Sidecars="@(_PuckShaderSidecar)">
            <Output ItemName="_PuckRemovedShaderBytecode" TaskParameter="Removed" />
        </PuckRemoveOrphanedShaderBytecode>
        <ItemGroup>
            <ShaderBytecode Remove="@(_PuckRemovedShaderBytecode)" />
        </ItemGroup>
    </Target>

    <!-- Compiles each declared source for its enabled backends: SPIR-V (Vulkan; entry renamed to "main") when
         PuckShaderSpirvEnabled is true, and DXIL (DirectX) when the stage's DXIL-enabled property is true, with the
         options ShaderRecipe.targets holds for the stage and
         target (generated from ShaderCompiler.StepsOf: the capability floor, explicit -O3 and -enable-16bit-types,
         and on DXIL the suppressed "attribute ignored" warnings for the SPIR-V-only vk:: attributes).
         Content admission checks source, recipe and bytecode against the existing sidecar. File timestamps do not
         select compiles: restoring equal inputs leaves valid outputs alone. The source hash covers that .hlsl plus
         every @(ShaderInclude), in item order, conservatively invalidating all kernels when any include changes.
         Only actual successful compiles publish sidecars; collection independently verifies their content and recipe.

         Kernels compile after ResolveProjectReferences, so every project a consumer references is built first. A kernel
         may include a declaration generated from C# (sdf-isa.hlsli, a *.interface.hlsli): an in-repo kernel project
         references Puck.Shaders.Generator, whose build writes those from the model before this target runs. -->
    <ItemGroup>
        <_PuckShaderBytecode Include="@(VertexShaderSource -> '%(RootDir)%(Directory)%(Filename).spv')">
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
            <Recipe>&quot;$(DxcCommand)&quot; $(PuckDxcVertexSpirv)</Recipe>
            <Enabled>$(PuckShaderSpirvEnabled)</Enabled>
        </_PuckShaderBytecode>
        <_PuckShaderBytecode Include="@(VertexShaderSource -> '%(RootDir)%(Directory)%(Filename).dxil')">
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
            <Recipe>&quot;$(DxcCommand)&quot; $(PuckDxcVertexDxil)</Recipe>
            <Enabled>$(PuckShaderDxilEnabled)</Enabled>
        </_PuckShaderBytecode>
        <_PuckShaderBytecode Include="@(FragmentShaderSource -> '%(RootDir)%(Directory)%(Filename).spv')">
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
            <Recipe>&quot;$(DxcCommand)&quot; $(PuckDxcFragmentSpirv)</Recipe>
            <Enabled>$(PuckShaderSpirvEnabled)</Enabled>
        </_PuckShaderBytecode>
        <_PuckShaderBytecode Include="@(FragmentShaderSource -> '%(RootDir)%(Directory)%(Filename).dxil')">
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
            <Recipe>&quot;$(DxcCommand)&quot; $(PuckDxcFragmentDxil)</Recipe>
            <Enabled>$(PuckShaderDxilEnabled)</Enabled>
        </_PuckShaderBytecode>
        <_PuckShaderBytecode Include="@(ComputeShaderSource -> '%(RootDir)%(Directory)%(Filename).spv')">
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
            <Recipe>&quot;$(DxcCommand)&quot; $(PuckDxcComputeSpirv)</Recipe>
            <Enabled>$(PuckShaderSpirvEnabled)</Enabled>
        </_PuckShaderBytecode>
        <_PuckShaderBytecode Include="@(ComputeShaderSource -> '%(RootDir)%(Directory)%(Filename).dxil')">
            <SourcePath>$([System.IO.Path]::ChangeExtension('%(FullPath)', '.hlsl'))</SourcePath>
            <Recipe>&quot;$(DxcCommand)&quot; $(PuckDxcComputeDxil)</Recipe>
            <Enabled>$(PuckComputeShaderDxilEnabled)</Enabled>
        </_PuckShaderBytecode>
        <_PuckExpectedBytecode Include="@(_PuckShaderBytecode->WithMetadataValue('Enabled', 'true'))" />
    </ItemGroup>
    <!-- ResolveProjectReferences can restore a missing generated include after evaluation's glob expanded. Refresh
         before compilation and collection, preserving explicit outside includes and the same hash order in no-build readers. -->
    <Target Name="RefreshShaderIncludes" BeforeTargets="CompileShaders;CollectShaderBytecode">
        <ItemGroup>
            <_PuckConventionalShaderInclude Include="Assets/Shaders/**/*.hlsli" />
            <ShaderInclude Remove="@(_PuckConventionalShaderInclude)" />
            <ShaderInclude Include="@(_PuckConventionalShaderInclude)" />
        </ItemGroup>
    </Target>
    <Target Name="CompileShaders" AfterTargets="ResolveProjectReferences">
        <PuckSelectShaderCompiles Condition="'@(_PuckExpectedBytecode)' != ''" BytecodeFiles="@(_PuckExpectedBytecode)" Includes="@(ShaderInclude)" LockFile="$(_PuckShaderPublishLock)">
            <Output ItemName="_PuckCompiledBytecode" TaskParameter="Stale" />
        </PuckSelectShaderCompiles>
        <PropertyGroup>
            <!-- Only this invocation's temporary files are published or removed. A warm build invokes no compiler. -->
            <_PuckShaderToken>$([System.Guid]::NewGuid().ToString('N'))</_PuckShaderToken>
        </PropertyGroup>
        <ItemGroup>
            <_PuckTemporaryBytecode Include="@(_PuckCompiledBytecode -> '%(Identity).$(_PuckShaderToken).tmp')" />
        </ItemGroup>
        <Exec Condition="'@(_PuckCompiledBytecode)' != ''" Command="&quot;$(DxcCommand)&quot; --version" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="High" StandardOutputImportance="Low">
            <Output PropertyName="DxcProbeExitCode" TaskParameter="ExitCode" />
        </Exec>
        <Error Condition="'@(_PuckCompiledBytecode)' != '' and '$(DxcProbeExitCode)' != '0'" Text="$(MSBuildProjectName) shader compilation requires '$(DxcCommand)' (the DirectX Shader Compiler) to run. Install the Vulkan SDK or Windows SDK, or pass /p:DxcCommand=&quot;path/to/dxc&quot;." />
        <Exec Condition="'%(_PuckCompiledBytecode.Identity)' != ''" Command="%(_PuckCompiledBytecode.Recipe) -Fo &quot;%(_PuckCompiledBytecode.FullPath).$(_PuckShaderToken).tmp&quot; &quot;%(_PuckCompiledBytecode.SourcePath)&quot;" />
        <PuckWriteShaderHashSidecars Condition="'@(_PuckCompiledBytecode)' != ''" BytecodeFiles="@(_PuckCompiledBytecode)" Includes="@(ShaderInclude)" LockFile="$(_PuckShaderPublishLock)" Token="$(_PuckShaderToken)" />
        <Delete Files="@(_PuckTemporaryBytecode)" />
        <OnError ExecuteTargets="CleanShaderTemporaries" />
    </Target>
    <!-- Delete only this invocation's files, including earlier successful batches when a later DXC Exec fails. -->
    <Target Name="CleanShaderTemporaries">
        <Delete Files="@(_PuckTemporaryBytecode)" />
    </Target>

    <!-- Shared by every shader project: one that declares no VertexShaderSource never triggers a vertex Exec above,
         so re-globbing here is a no-op for a stage that never ran. Fixes the from-clean-build gap for every consumer:
         MSBuild expands item globs once, before any target runs, so an evaluation-time ShaderBytecode/Content glob
         cannot see bytecode CompileShaders emits later in the SAME build — a brand-new shader
         would ship with an incomplete Content list otherwise. Owns the shipped Content declaration alone; a
         consuming project keeps only its own evaluation-time @(ShaderBytecode) glob (needed by
         ValidateShaderBytecodeSources, which runs before CompileShaders can populate anything), not a second
         static Content declaration. It also runs ahead of NuGet's _GetPackageFiles, after the orphan sweep, so a
         pack that skips the build (CI packs over a finished build) ships the same bytecode a build does: no build
         target runs then, and the bytecode is otherwise declared nowhere. A project that declares no stage source and
         no bytecode (most of the tree imports this file) skips it whole, so it neither compiles the inline task nor
         takes a publication lock. -->
    <Target Name="CollectShaderBytecode" AfterTargets="CompileShaders" BeforeTargets="AssignTargetPaths;_GetPackageFiles"
            Condition="'@(VertexShaderSource)' != '' or '@(FragmentShaderSource)' != '' or '@(ComputeShaderSource)' != '' or '@(ShaderBytecode)' != ''"
            DependsOnTargets="ValidateShaderBytecodeSources">
        <ItemGroup>
            <ShaderBytecode Remove="@(ShaderBytecode)" />
        </ItemGroup>
        <!-- Enumeration, required-output checks and pair validation share one lock. A first publication cannot land
             between an empty glob and an existence check and leave a successful pack with an omitted kernel. -->
        <PuckValidateShaderBytecodeFresh ExpectedBytecode="@(_PuckExpectedBytecode)" RecipeBytecode="@(_PuckShaderBytecode)" Includes="@(ShaderInclude)" LockFile="$(_PuckShaderPublishLock)" ProjectDirectory="$(MSBuildProjectDirectory)">
            <Output ItemName="ShaderBytecode" TaskParameter="BytecodeFiles" />
        </PuckValidateShaderBytecodeFresh>
        <ItemGroup>
            <Content Include="@(ShaderBytecode)" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <!-- Kernel-class probe kernels and the camera frame converter's conversion kernels run on a camera graph's own
         Direct3D 11 device, so each @(Direct3D11KernelSource) item's entry points (its Entries metadata) compile to
         cs_5_0 DXBC here, beside the source as <stem>.<entry>.dxbc, and ship as content: a world run creates a kernel
         from its bytecode and compiles nothing. Direct3D 11 exists only on Windows, so a build elsewhere writes no kernel
         bytecode. Compilation is a build operation; packing collects and validates existing outputs separately. -->
    <Target Name="CompileDirect3D11Kernels" BeforeTargets="AssignTargetPaths">
        <PuckCompileDirect3D11Kernels Condition="'@(Direct3D11KernelSource)' != '' and $([MSBuild]::IsOSPlatform('Windows'))" Sources="@(Direct3D11KernelSource)">
            <Output ItemName="_PuckDirect3D11KernelBytecode" TaskParameter="Bytecode" />
        </PuckCompileDirect3D11Kernels>
    </Target>
    <Target Name="CollectDirect3D11KernelBytecode" AfterTargets="CompileDirect3D11Kernels" BeforeTargets="AssignTargetPaths;_GetPackageFiles">
        <PuckCollectDirect3D11Kernels Condition="'@(Direct3D11KernelSource)' != '' and $([MSBuild]::IsOSPlatform('Windows'))" Sources="@(Direct3D11KernelSource)">
            <Output ItemName="_PuckCollectedDirect3D11KernelBytecode" TaskParameter="Bytecode" />
        </PuckCollectDirect3D11Kernels>
        <ItemGroup>
            <Content Include="@(_PuckCollectedDirect3D11KernelBytecode)" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

</Project>
