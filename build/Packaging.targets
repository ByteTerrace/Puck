<Project>
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <Authors>ByteTerrace</Authors>
        <Company>ByteTerrace</Company>
        <Copyright>Copyright © 2026 ByteTerrace</Copyright>
        <!--
            Every package declares its license as an SPDX expression, which NuGet.org displays and
            tooling reads, and also carries the full text as LICENSE.md. The engine is Apache-2.0; a
            project with <PuckLicenseKind>GamingBricks</PuckLicenseKind> is offered under MIT or
            Apache-2.0 (src/Puck.GamingBricks/LICENSE.md).
        -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseExpression Condition="'$(PuckLicenseKind)' != 'GamingBricks'">Apache-2.0</PackageLicenseExpression>
        <PackageLicenseExpression Condition="'$(PuckLicenseKind)' == 'GamingBricks'">MIT OR Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/ByteTerrace/Puck</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Product>ByteTerrace.Puck</Product>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/ByteTerrace/Puck.git</RepositoryUrl>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Version>0.1.0-alpha</Version>
    </PropertyGroup>
    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <!--
            The gallery icon. One shared 200x200 PNG for every packable project (NuGet.org accepts PNG/JPG up to
            1 MB; this is 41 KB). The maintained source is owned by branding. PackagePath carries the FILENAME, not just the directory: pack derives the packed
            entry's name from the source file otherwise, and `logo.png` in the root would not be the `icon.png` that
            <PackageIcon> names — NU5046 at pack time. Link only affects how the item shows in an IDE.
        -->
        <None Include="$(MSBuildThisFileDirectory)..\branding\assets\puck-logo-200.png" Link="icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
        <None Condition="'$(PuckLicenseKind)' != 'GamingBricks'" Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
        <None Condition="'$(PuckLicenseKind)' == 'GamingBricks'" Include="$(MSBuildThisFileDirectory)..\src\Puck.GamingBricks\LICENSE.md" Pack="true" PackagePath="LICENSE.md" Visible="false" />
        <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
