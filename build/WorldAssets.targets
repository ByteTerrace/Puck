<Project>
    <!-- The game's shipped worlds. The build hands every .puck source and every .world.json document under Assets/worlds
         to one tree-mode run of the CLI's compile verb, which writes the documents the game ships, beside each that
         draws as a world its compiled world (<name>.puckb), and at the root the one bake pack (bakes.puckbake) holding
         the creation bakes those compiled worlds name and the package store (packages/) holding one compiled shader
         package per graph source their views.graphs rows name, so no device compiles a shipped pipeline and the
         run needs dxc as the shader build does, into this project's intermediate directory; the output's
         Assets/worlds carries exactly those. Nothing is written into the source tree, and neither the sources nor the
         tree's own documents are shipped from it: a document name resolves to its .puck source where one emits a
         document and to its .world.json document otherwise (WorldDocumentName, PuckDocumentComposer), and only a compile
         knows which sources emit documents and under which names (a module library emits none, a composition emits the
         worlds it declares), so the run reports the files it wrote and the build ships that report rather than deriving
         it from the sources' names. The CLI is a build-time tool here, never a runtime dependency. -->
    <PropertyGroup>
        <PuckWorldSourceDirectory>$(MSBuildProjectDirectory)\Assets\worlds\</PuckWorldSourceDirectory>
    </PropertyGroup>
    <ItemGroup>
        <PuckWorldSource Include="$(PuckWorldSourceDirectory)**\*.puck;$(PuckWorldSourceDirectory)**\*.world.json" />
        <!-- The pipeline sources the shipped worlds' rows can name, so an edited shader re-runs the tree run that packages
             it. They ship as content too: a World keys a row's package by the closure it reads beside the document. -->
        <PuckWorldPipelineSource Include="Assets\**\*.hlsl;Assets\**\*.hlsli;Assets\**\*.graph.json" Exclude="Assets\worlds\**" />
        <!-- Every world document, compiled world and bake pack under Assets/worlds ships from the tree run's report instead. -->
        <Content Include="Assets\**" Exclude="Assets\worlds\**\*.puck;Assets\worlds\**\*.world.json;Assets\worlds\**\*.puckb;Assets\worlds\**\*.puckbake" CopyToOutputDirectory="PreserveNewest" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Puck.Cli\Puck.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
    </ItemGroup>
    <UsingTask
        AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"
        TaskFactory="RoslynCodeTaskFactory"
        TaskName="PuckRemoveStaleWorldPackages"
    >
        <ParameterGroup>
            <OutputDirectory ParameterType="System.String" Required="true" />
            <PackageDirectory ParameterType="System.String" Required="true" />
            <Deployed ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
        </ParameterGroup>
        <Task>
            <Code Language="cs" Source="$(MSBuildThisFileDirectory)PuckRemoveStaleWorldPackages.cs" Type="Class" />
        </Task>
    </UsingTask>
    <!-- The intermediate directory is set by the SDK's targets, after this file is read, so the report is named here.
         The files the last run reported are outputs of the next one, so a run is repeated when one of them is gone. -->
    <Target Name="PuckNameWorldReport">
        <PropertyGroup>
            <PuckWorldDocumentDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)worlds\'))</PuckWorldDocumentDirectory>
            <PuckWorldReport>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)worlds.written'))</PuckWorldReport>
        </PropertyGroup>
        <ReadLinesFromFile File="$(PuckWorldReport)" Condition="Exists('$(PuckWorldReport)')">
            <Output TaskParameter="Lines" ItemName="PuckWorldReportedLine" />
        </ReadLinesFromFile>
        <ItemGroup>
            <PuckWorldReported Include="@(PuckWorldReportedLine->'$(PuckWorldDocumentDirectory)%(Identity)')" />
        </ItemGroup>
    </Target>
    <Target Name="PuckResolveWorldCompiler" DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
        <!-- The project instance the reference built, so the path is the CLI that build produced. -->
        <MSBuild
            Projects="@(_MSBuildProjectReferenceExistent)"
            Condition="'%(Filename)' == 'Puck.Cli'"
            Targets="GetTargetPath"
            BuildInParallel="$(BuildInParallel)"
            Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
            RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)">
            <Output TaskParameter="TargetOutputs" PropertyName="PuckWorldCompilerPath" />
        </MSBuild>
        <!-- A compiled world is keyed by the engine build it was derived under, so every engine assembly the compiler
             runs is an input: one can change while the compiler's own assembly does not. -->
        <ItemGroup>
            <PuckWorldCompilerAssembly Include="$([System.IO.Path]::GetDirectoryName('$(PuckWorldCompilerPath)'))\Puck.*.dll" />
        </ItemGroup>
    </Target>
    <Target Name="PuckGenerateWorlds" DependsOnTargets="PuckNameWorldReport;PuckResolveWorldCompiler" AfterTargets="ResolveProjectReferences"
            Condition="'$(DesignTimeBuild)' != 'true'"
            Inputs="@(PuckWorldSource);@(PuckWorldPipelineSource);$(PuckWorldCompilerPath);@(PuckWorldCompilerAssembly);$(MSBuildThisFileFullPath)"
            Outputs="$(PuckWorldReport);@(PuckWorldReported)">
        <!-- One process for the whole tree pays compiler, JIT and schema initialization once. The tree run also
             removes any document or compiled world under the directory that no source writes any more. -->
        <Exec Command="dotnet &quot;$(PuckWorldCompilerPath)&quot; compile --tree &quot;$(PuckWorldSourceDirectory.TrimEnd('\'))&quot; --output &quot;$(PuckWorldDocumentDirectory.TrimEnd('\'))&quot; --written &quot;$(PuckWorldReport)&quot; @(PuckWorldSource -> '&quot;%(FullPath)&quot;', ' ')" />
    </Target>
    <!-- The files to ship are known only once a tree run has written them, so they are read from its report, whether it
         ran in this build or an earlier one. -->
    <Target Name="PuckShipWorlds" DependsOnTargets="PuckNameWorldReport" AfterTargets="PuckGenerateWorlds" Condition="'$(DesignTimeBuild)' != 'true'">
        <ReadLinesFromFile File="$(PuckWorldReport)">
            <Output TaskParameter="Lines" ItemName="PuckWorldWrittenLine" />
        </ReadLinesFromFile>
        <ItemGroup>
            <PuckWorldWritten Include="@(PuckWorldWrittenLine->'$(PuckWorldDocumentDirectory)%(Identity)')" />
            <ContentWithTargetPath Include="@(PuckWorldWritten->'%(FullPath)')" TargetPath="Assets\worlds\$([MSBuild]::MakeRelative('$(PuckWorldDocumentDirectory)', '%(FullPath)'))" CopyToOutputDirectory="PreserveNewest" />
            <FileWrites Include="$(PuckWorldReport);@(PuckWorldWritten->'%(FullPath)')" />
        </ItemGroup>
    </Target>
    <!-- A copy never deletes, so a package no shipped row names any more would stay in the output's package store and a
         World would still find it. After the copy, the store keeps exactly the files this build deploys. -->
    <Target Name="PuckRemoveStaleWorldPackages" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
        <PuckRemoveStaleWorldPackages Deployed="@(ContentWithTargetPath);@(AllItemsFullPathWithTargetPath)" OutputDirectory="$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutDir)'))" PackageDirectory="Assets\worlds\packages" />
    </Target>
</Project>
