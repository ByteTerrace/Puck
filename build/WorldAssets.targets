<Project>
    <!-- The CLI owns world compilation. Its build generates these outputs before
         build-only consumers copy or test them; no game assembly references tooling. -->
    <PropertyGroup>
        <PuckWorldAssetDirectory Condition="'$(PuckWorldAssetDirectory)' == ''">$(MSBuildThisFileDirectory)..\src\Puck.World\Assets\worlds</PuckWorldAssetDirectory>
    </PropertyGroup>
    <ItemGroup>
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\avatars\moth.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\arena.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\backgammon.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\billiards.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\bowling.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\codenames.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\dominoes.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\freecell.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\hexlines.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\klondike.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\mancala.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\poker.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\pong.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\reversi.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\snake.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\spider.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\stratego.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\tictactoe.puck" />
        <!-- solitaire imports the klondike, spider, and freecell documents, so it compiles after them. -->
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\games\solitaire.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\moth-courtyard.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\tools\hgb-compare.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\tools\hgb-mirror.puck" />
        <PuckGeneratedWorldSource Include="$(PuckWorldAssetDirectory)\tools\shader-compare.puck" />
    </ItemGroup>
    <Target Name="GenerateWorldAssets" AfterTargets="Build"
            Condition="'$(DesignTimeBuild)' != 'true'"
            Inputs="@(PuckGeneratedWorldSource);@(ReferenceCopyLocalPaths);$(TargetPath);$(MSBuildThisFileFullPath)"
            Outputs="@(PuckGeneratedWorldSource -> '%(RootDir)%(Directory)%(Filename).world.json')">
        <!-- Preserve dependency order, but pay compiler/JIT/schema initialization once for the whole batch. -->
        <Exec Command="dotnet &quot;$(TargetPath)&quot; compile @(PuckGeneratedWorldSource -> '&quot;%(FullPath)&quot;', ' ')" />
    </Target>
</Project>
