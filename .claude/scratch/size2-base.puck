}

seatDefaults {
  identities [
    {
      id: "amber"
      name: "amber"
      color: "#ED8530"
    }
  ]
  neutralColor: "#8C8C8C"
  colorSequence {
    name: "additive"
    offset: 0
    step: 0.618034
  }
  saturation: 0.65
  value: 0.85
  colorSearchLimit: 64
  noseFactor: 0.35
  pickerThreshold: 0.6
  pickerNeutralColor: "#8C8C8C"
  pickerNeutralBlend: 0.5
  seatCameraFeel {
    yawSensitivity: 0.001
    pitchSensitivity: 0.001
    invertYaw: false
    invertPitch: false
    stickLookRate: 2.6
    autoFirstPerson: null
  }
}

channels [
  {
    name: "forward"
    shape: Bipolar
    role: MoveAdvance
    composition: false
  }
  {
    name: "strafe"
    shape: Bipolar
    role: MoveStrafe
    composition: false
  }
  {
    name: "turn"
    shape: Bipolar
    role: Turn
    composition: false
  }
]

targetRegisters []

bodyMotionPrograms [
  {
    name: "grounded"
    version: "puck.body.program.v1"
    kind: Motion
    operations [
      ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent,
      RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose
    ]
  }
  {
    name: "roam"
    version: "puck.body.program.v1"
    kind: Producer
    operations [ProduceSteeringIntent]
  }
]

kits {
  rows [
    {
      name: "traveler"
      bodyMotionProgram: "grounded"
      motion {
        speed {
          value: 4
        }
        turn {
          rate: 2.5
          falloff: 1
          pitchRate: 0
          maxPitch: 1.2
