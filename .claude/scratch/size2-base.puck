            gravity {
              rise: 14
              fall: 23
            }
            envelope {
              sinkSpeed: 20
            }
            thrust: 0
          }
        ]
        groundSnap: 0.3
        stepHeight: 0
      }
      producers {
        roam {
          scalars {
            forward: 0.375
            softRadius: 45
            weaveAmplitude: 0.5
            inwardGain: 1.6
            turnScale: 2.5
            weaveFrequencyBase: 0.3
            weaveFrequencyRange: 0.2
            altitudeGain: 0.32
