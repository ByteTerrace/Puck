      name: "additive"
      offset: 0
      step: 0.38196602
    }
  }
  peerVariation {
    phase {
      name: "additive"
      offset: -4
      step: 0.38196602
    }
    weave {
      name: "additive"
      offset: -4
      step: 0.618034
    }
    activity {
      name: "r2"
      offset: 1
      step: 0
    }
  }
  seatVariation {
    phase {
      name: "additive"
      offset: 0
      step: 0.38196602
    }
    weave {
      name: "additive"
      offset: 0
      step: 0.618034
    }
    activity {
      name: "r2"
      offset: 1
      step: 0
    }
  }
  peerColors {
    name: "additive"
    offset: -4
    step: 0.618034
  }
