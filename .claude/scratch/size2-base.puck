            activityRateRange: 1.3
            strafeWave: 0
            turnWave: 0
            upWave: 0
            pitchWave: 0
            rollTurn: 0
            pressThreshold: 0
            altitudeBase: 0
            altitudeRange: 0
          }
          channels {}
        }
      }
      actions {}
      collider: capsule(endpoint: [0, 1, 0], radius: 0.35)
      bodyContact: Overlap
      mass: 0
    }
  ]
  assignment {
    sequence {
      name: "r1"
      offset: 1
      step: 0
    }
    rows []
  }
}

