schema: "puck.world.definition.v1"
basis: "size2-base"
test "carved support reaches full size and carries its first shrink" {
  when {
    seat1: body.pose 20 1.04 0 0 0 0
    ticks 20
    seat1: world.state.cell.set growth $value 1
    ticks 1
    seat1: world.state.cell.set growth $value 0.96875
    ticks 1
  }
  expect {
    growth == 0.96875
    bodyPosition(body, 0, y) > 1.93
    bodyPosition(body, 0, y) < 2.0
    fact(body, 0, Grounded) == 1
  }
}

test "carved support grows then shrinks to a quarter" {
  when {
    seat1: body.pose 20 1.04 0 0 0 0
    ticks 20
    seat1: world.state.cell.set growth $value 1
    ticks 10
    seat1: world.state.cell.set growth $value 0.25
    ticks 10
  }
  expect {
    growth == 0.25
    bodyPosition(body, 0, y) > 0.49
    bodyPosition(body, 0, y) < 0.56
    fact(body, 0, Grounded) == 1
  }
}

