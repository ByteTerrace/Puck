{
  "autoMemoryEnabled": false,
  "enabledMcpjsonServers": [
    "puck"
  ],
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "env": {
    "MCP_TIMEOUT": "600000"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/world-devices.ps1"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-node-reuse.ps1"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-coauthor.ps1"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-transport.ps1"
            ],
            "command": "pwsh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/prose-doctrine.ps1"
            ],
            "command": "pwsh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/prose-doctrine.ps1"
            ],
            "command": "pwsh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ]
  },
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Read(/.codex/**)",
      "Edit(/.codex/**)",
      "Write(/.codex/**)",
      "Read(/.agents/**)",
      "Edit(/.agents/**)",
      "Write(/.agents/**)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "PowerShell(git push *main*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push *--mirror*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
