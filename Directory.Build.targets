<Project>
    <ItemGroup Condition="('$(PuckKind)' == 'Test' OR '$(PuckKind)' == 'Validation' OR '$(MSBuildProjectName)' == 'Puck.Cli') AND '$(MSBuildProjectName)' != 'Puck.Cli.Tests'">
        <!-- Repository-only executables resolve live files from their checkout,
             independently of deterministic compiler source-path mapping, and create every per-run directory
             through the one run-directory policy. Puck.Cli.Tests reads the CLI's own copies, which its subject's
             internals already expose; a second copy there is a type conflict. -->
        <Compile Include="$(MSBuildThisFileDirectory)build/RepositoryPaths.cs" Link="Properties/RepositoryPaths.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)build/RunDirectory.cs" Link="Properties/RunDirectory.cs" />
    </ItemGroup>
    <!-- Every law that needs a directory under the temporary root takes a TemporaryDirectory, whose verdict-bound
         disposal (and the assembly-level attribute that resolves it) the one shared source carries; its owner
         teardown waits under the one liveness bound TestLiveness states, so both are linked together. -->
    <!-- Every test project is an xUnit v3 executable on Microsoft.Testing.Platform, the runner global.json selects for
         `dotnet test`; the reference is declared once here, so no suite can drift onto another framework version. The
         executable speaks only the platform's command line, whether `dotnet test` starts it or a caller runs it
         directly, so one test selection spelling serves both. The hang-dump extension gives a run that stops making
         progress a mini dump (`puck artifacts test-windows` asks for one). -->
    <PropertyGroup Condition="'$(PuckKind)' == 'Test'">
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>
    <ItemGroup Condition="'$(PuckKind)' == 'Test'">
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="[2.*, )" />
        <PackageReference Include="xunit.v3" Version="[4.*, )" />
        <Compile Include="$(MSBuildThisFileDirectory)tests/Shared/TemporaryDirectory.cs" Link="Properties/TemporaryDirectory.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)tests/Shared/TestLiveness.cs" Link="Properties/TestLiveness.cs" />
    </ItemGroup>
    <!-- Allocation laws and the emulator batteries' allocation stages read GC.GetAllocatedBytesForCurrentThread. A
         background collection retires every thread's allocation context without subtracting the unused remainder
         from that counter, so a thread that allocated nothing reads up to one allocation quantum (about 8 KiB) it
         never allocated. Blocking collections account the remainder, so these hosts run without background GC.
         Declared here because PuckKind is set in each project's body, after Directory.Build.props. -->
    <PropertyGroup Condition="'$(PuckKind)' == 'Test' OR '$(PuckKind)' == 'Validation'">
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>
    <PropertyGroup>
        <!-- Derived here rather than in Directory.Build.props: $(NuGetPackageRoot) is set by NuGet's
             generated props, which import after Directory.Build.props but before this file. Properties
             evaluate before items, so csproj-body HintPaths resolve this correctly. -->
        <WindowsSdkNetRefRoot>$(NuGetPackageRoot)/microsoft.windows.sdk.net.ref/$(WindowsSdkNetRefVersion)/lib/net8.0</WindowsSdkNetRefRoot>
    </PropertyGroup>

    <!-- Flow the Windows Graphics Capture projection references to every project automatically. The imported
         ItemGroup self-selects (Windows + a ProjectReference to Puck.Platform.Windows), so any current or future
         executable that references Puck.Platform.Windows records Microsoft.Windows.SDK.NET.dll + WinRT.Runtime.dll
         in its .deps.json with no per-consumer csproj edit. This import lands after each project's body, so
         @(ProjectReference) is already populated when the ItemGroup condition is evaluated. -->
    <Import Project="$(MSBuildThisFileDirectory)src/Puck.Platform.Windows/WindowsCaptureProjection.targets" />

    <!-- The architecture gate. Reads the RESOLVED reference set rather than @(ProjectReference), so a
         transitively-arriving edge is checked the same as a declared one. -->
    <Import Project="$(MSBuildThisFileDirectory)build/Puck.Architecture.targets" />

    <!-- The shared shader-compile recipe (DXC to SPIR-V + DXIL, item-driven, opt-out DXIL). Imported once for
         every project; a project declaring no shader items never triggers a single Exec. -->
    <Import Project="$(MSBuildThisFileDirectory)build/Shaders.targets" />

    <!-- NuGet packaging policy for blessed projects. Imported here (after each project's body) so a
         csproj's own <IsPackable>true</IsPackable> is visible to the flag-guarded groups inside. -->
    <Import Project="$(MSBuildThisFileDirectory)build/Packaging.targets" />

    <!-- The artifact producer records evaluated test outputs, including any future test projects or TFMs.
         Consumers run these assemblies directly and do not need to evaluate the solution or install workloads. -->
    <Target Name="PuckRecordTestAssembly" AfterTargets="Build"
            Condition="'$(PuckCaptureTestArtifacts)' == 'true' AND '$(PuckKind)' == 'Test' AND '$(TargetFramework)' != ''">
        <WriteLinesToFile File="$(TargetDir)Puck.TestAssembly" Lines="$(TargetFileName)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>
</Project>
