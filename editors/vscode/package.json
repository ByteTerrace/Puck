{
    "name": "vscode-puck",
    "displayName": "Puck Authoring Language",
    "description": "IntelliSense, diagnostics, hover, formatting, and syntax highlighting for the Puck DSL (.puck).",
    "version": "1.0.0",
    "icon": "icon.png",
    "publisher": "ByteTerrace",
    "repository": {
        "type": "git",
        "url": "https://github.com/ByteTerrace/Puck.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "puck",
        "world",
        "dsl",
        "authoring",
        "simulation"
    ],
    "contributes": {
        "languages": [
            {
                "id": "puck",
                "aliases": [
                    "Puck",
                    "puck"
                ],
                "extensions": [
                    ".puck",
                    ".world.puck"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "puck",
                "scopeName": "source.puck",
                "path": "./syntaxes/puck.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "puck",
                "path": "./snippets/puck.json"
            }
        ],
        "commands": [
            {
                "title": "Puck: Restart Language Server",
                "command": "puck.restartLanguageServer"
            }
        ],
        "configuration": {
            "title": "Puck",
            "properties": {
                "puck.server.args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "lsp"
                    ],
                    "description": "Arguments passed directly without a shell. For dotnet, use an absolute Puck.Cli.dll path followed by lsp.",
                    "scope": "machine-overridable"
                },
                "puck.server.command": {
                    "type": "string",
                    "default": "puck",
                    "description": "Executable used to launch the language server. Use dotnet to launch a Puck.Cli.dll assembly.",
                    "scope": "machine-overridable"
                },
                "puck.highlighting.containerColors": {
                    "type": "boolean",
                    "description": "Use fixed, theme-aware colors for array [] and object {} delimiters instead of nesting-depth colors.",
                    "scope": "resource",
                    "default": true
                }
            }
        },
        "colors": [
            {
                "defaults": {
                    "dark": "#C586C0",
                    "highContrast": "#F3A6E8",
                    "light": "#8A237A",
                    "highContrastLight": "#7A176B"
                },
                "description": "Puck array delimiters [].",
                "id": "puck.arrayDelimiter"
            },
            {
                "defaults": {
                    "dark": "#4EC9B0",
                    "highContrast": "#70E8CB",
                    "light": "#007A68",
                    "highContrastLight": "#006B59"
                },
                "description": "Puck object delimiters {}.",
                "id": "puck.objectDelimiter"
            }
        ]
    },
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:puck"
    ],
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false
        }
    },
    "scripts": {
        "build": "esbuild extension.js --bundle --platform=node --external:vscode --outfile=dist/extension.js",
        "package": "vsce package --no-dependencies",
        "vscode:prepublish": "npm run build",
        "test": "node --test test/*.test.js"
    },
    "dependencies": {
        "vscode-languageclient": "9.0.1"
    },
    "devDependencies": {
        "@vscode/vsce": "3.9.2",
        "esbuild": "0.28.2",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
