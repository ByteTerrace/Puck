{
  "id": "travel-parity",
  "title": "A mapped border is the same world over TCP",
  "bootShape": "windowed",
  "requirements": [],
  "seconds": 25,
  "timeoutSeconds": 60,
  "binding": "The positive leg launches quilt-ne as a separate listening authority and walks through quilt-nw's mapped east border; the same script against the local discriminator must preserve arrival while losing the remote-authority evidence.",
  "fixtures": [],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw.world.json",
    "authorityWorld": "src/Puck.World/Assets/worlds/quilt-ne.world.json",
    "script": "cross-ne.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.press", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.view.camera", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      {
        "type": "line",
        "name": "commit names the separate authority",
        "stream": "stdout",
        "match": "contains",
        "text": "remote authority 127.0.0.1:38473",
        "present": true
      },
      {
        "type": "response",
        "name": "routed where answered after crossing",
        "stream": "stdout",
        "verb": "player.where",
        "occurrence": 1,
        "count": 1,
        "extract": []
      },
      {
        "type": "response",
        "name": "destination rig answered after crossing",
        "stream": "stdout",
        "verb": "world.view.camera",
        "occurrence": 1,
        "count": 1,
        "extract": []
      },
      {
        "type": "line",
        "name": "first remote projection uses the composed viewport",
        "stream": "stderr",
        "match": "contains",
        "text": "for seat 1 at 1920x1080",
        "present": true
      },
      {
        "type": "line",
        "name": "no small-panel resolution ramp",
        "stream": "stderr",
        "match": "contains",
        "text": "160x144",
        "present": false
      },
      {
        "type": "line",
        "name": "no unhandled exception",
        "stream": "stderr",
        "match": "contains",
        "text": "Unhandled exception",
        "present": false
      }
    ]
  },
  "discriminating": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw-gap.world.json",
    "script": "cross-ne.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.press", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.view.camera", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      {
        "type": "line",
        "name": "local control does not claim a remote authority",
        "stream": "stdout",
        "match": "contains",
        "text": "remote authority 127.0.0.1:38473",
        "present": false
      },
      {
        "type": "response",
        "name": "local routed where still answers",
        "stream": "stdout",
        "verb": "player.where",
        "occurrence": 1,
        "count": 1,
        "extract": []
      },
      {
        "type": "line",
        "name": "no unhandled exception",
        "stream": "stderr",
        "match": "contains",
        "text": "Unhandled exception",
        "present": false
      }
    ]
  }
}
