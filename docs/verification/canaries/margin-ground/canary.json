{
  "id": "margin-ground",
  "title": "The neighbour's ground is really under the body",
  "bootShape": "headless",
  "requirements": [],
  "seconds": 12,
  "timeoutSeconds": 40,
  "binding": "The selected player.where y component is 0.02 only while the mapped neighbour contributes its ground through the runtime border margin; the discriminating world removes that neighbour ground placement and the same pose settles at -0.98.",
  "fixtures": [
    "ne-no-support.world.json"
  ],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw-gap.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      {
        "type": "response",
        "name": "settled pose response",
        "stream": "stdout",
        "verb": "player.where",
        "occurrence": 1,
        "count": 1,
        "extract": [
          { "name": "groundY", "field": "pos", "component": 1 }
        ]
      },
      {
        "type": "response",
        "name": "grounded contact response",
        "stream": "stdout",
        "verb": "world.contacts",
        "occurrence": 2,
        "count": 2,
        "extract": [
          { "name": "grounded", "field": "grounded" },
          { "name": "resolvedContacts", "field": "resolved" }
        ]
      },
      {
        "type": "sequence",
        "name": "whole script and terminal observation completed in order",
        "stream": "stdout",
        "responses": [
          { "verb": "player.pose", "occurrence": 1, "count": 1 },
          { "verb": "world.wait", "occurrence": 1, "count": 1 },
          { "verb": "player.where", "occurrence": 1, "count": 1 },
          { "verb": "world.contacts", "occurrence": 1, "count": 2 },
          { "verb": "wire.errors", "occurrence": 1, "count": 2 },
          { "verb": "world.contacts", "occurrence": 2, "count": 2 },
          { "verb": "wire.errors", "occurrence": 2, "count": 2 }
        ]
      },
      {
        "type": "relation",
        "name": "neighbour strip holds the body at contact skin",
        "left": { "value": "groundY" },
        "operator": "betweenInclusive",
        "minimum": 0.01,
        "maximum": 0.03
      },
      {
        "type": "relation",
        "name": "body reports grounded",
        "left": { "value": "grounded" },
        "operator": "equal",
        "right": { "literal": "true" }
      },
      {
        "type": "relation",
        "name": "ground contact was resolved",
        "left": { "value": "resolvedContacts" },
        "operator": "atLeast",
        "minimum": 1
      },
      {
        "type": "line",
        "name": "no unhandled exception",
        "stream": "stderr",
        "match": "contains",
        "text": "Unhandled exception",
        "present": false
      }
    ]
  },
  "discriminating": {
    "world": "docs/verification/canaries/margin-ground/discriminating.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      {
        "type": "response",
        "name": "settled pose response",
        "stream": "stdout",
        "verb": "player.where",
        "occurrence": 1,
        "count": 1,
        "extract": [
          { "name": "groundY", "field": "pos", "component": 1 }
        ]
      },
      {
        "type": "response",
        "name": "grounded contact response",
        "stream": "stdout",
        "verb": "world.contacts",
        "occurrence": 2,
        "count": 2,
        "extract": [
          { "name": "grounded", "field": "grounded" },
          { "name": "resolvedContacts", "field": "resolved" }
        ]
      },
      {
        "type": "sequence",
        "name": "whole script and terminal observation completed in order",
        "stream": "stdout",
        "responses": [
          { "verb": "player.pose", "occurrence": 1, "count": 1 },
          { "verb": "world.wait", "occurrence": 1, "count": 1 },
          { "verb": "player.where", "occurrence": 1, "count": 1 },
          { "verb": "world.contacts", "occurrence": 1, "count": 2 },
          { "verb": "wire.errors", "occurrence": 1, "count": 2 },
          { "verb": "world.contacts", "occurrence": 2, "count": 2 },
          { "verb": "wire.errors", "occurrence": 2, "count": 2 }
        ]
      },
      {
        "type": "relation",
        "name": "without neighbour ground the body reaches its own lower plane",
        "left": { "value": "groundY" },
        "operator": "betweenInclusive",
        "minimum": -0.99,
        "maximum": -0.97
      },
      {
        "type": "relation",
        "name": "body remains grounded on the lower control plane",
        "left": { "value": "grounded" },
        "operator": "equal",
        "right": { "literal": "true" }
      },
      {
        "type": "relation",
        "name": "lower-plane contact was resolved",
        "left": { "value": "resolvedContacts" },
        "operator": "atLeast",
        "minimum": 1
      },
      {
        "type": "line",
        "name": "no unhandled exception",
        "stream": "stderr",
        "match": "contains",
        "text": "Unhandled exception",
        "present": false
      }
    ]
  }
}





