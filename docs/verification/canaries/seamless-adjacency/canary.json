{
  "id": "seamless-adjacency",
  "title": "An invisible adjacency hands off authority and exposes the remote entity",
  "bootShape": "headless",
  "requirements": [],
  "seconds": 8,
  "timeoutSeconds": 25,
  "binding": "Both legs boot the same Four Corners shard and read the same adjacency. Only the positive leg crosses east, so only it can emit a handoff and expose a generation-addressed NE entity through NW's delivered neighbour image.",
  "fixtures": [],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.press", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.adjacencies", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "line", "name": "automatic adjacency handoff fired", "stream": "stdout", "match": "contains", "text": "[world.adjacency: 'boot/east' seat 1 crossed", "present": true },
      { "type": "line", "name": "remote entity carries authority slot and generation", "stream": "stdout", "match": "contains", "text": "entities=6~global2~ne/0:1", "present": true },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  },
  "discriminating": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw.world.json",
    "script": "discriminating.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.adjacencies", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "response", "name": "adjacency read-back answered", "stream": "stdout", "verb": "world.adjacencies", "occurrence": 1, "count": 1, "extract": [] },
      { "type": "line", "name": "no automatic handoff without a crossing", "stream": "stdout", "match": "contains", "text": "[world.adjacency: 'boot/east' seat 1 crossed", "present": false },
      { "type": "line", "name": "no remote entity without a crossing", "stream": "stdout", "match": "contains", "text": "entities=6~global2~ne/0:1", "present": false },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  }
}
