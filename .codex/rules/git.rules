# Git safety for Codex lanes. A Codex lane runs headless, so a `prompt` decision reaches its automatic reviewer,
# never the owner. What only a lane's own worktree holds (its index and files) goes to that reviewer; what every lane
# shares (pushes, the stash stack, branch and tag refs, the worktree list, history rewrites) is forbidden, because an
# approved mistake there destroys another lane's work. A push to `main` deploys and must prompt the owner, so a
# lane never pushes: its work lands through the lead (AGENTS.md).

prefix_rule(
    pattern = ["git", ["-C", "--git-dir", "--work-tree", "-c"]],
    decision = "forbidden",
    justification = "A lane runs git in its own worktree; pointing it elsewhere would bypass these rules and reach another lane's work.",
    match = [
        "git -C ../other stash drop",
        "git --work-tree ../other reset --hard",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "A Codex lane never pushes: leave the work for the lead, who lands and pushes it.",
    match = [
        "git push origin HEAD:refs/heads/lead/catch-up",
        "git push origin main",
        "git push --force origin main",
    ],
)

prefix_rule(
    pattern = ["git", "stash"],
    decision = "forbidden",
    justification = "The stash stack is shared by every worktree; set work aside with a WIP commit on your own branch.",
    match = [
        "git stash",
        "git stash pop",
        "git stash drop",
    ],
)

prefix_rule(
    pattern = ["git", "branch", ["-D", "-d", "--delete", "-f", "--force", "-m", "-M", "-c", "-C"]],
    decision = "forbidden",
    justification = "Branch refs are shared by every lane; the lead deletes or moves branches.",
    match = [
        "git branch -D codex/other",
    ],
)

prefix_rule(
    pattern = ["git", "worktree", ["remove", "prune", "move", "add", "lock", "unlock", "repair"]],
    decision = "forbidden",
    justification = "The worktree list is shared by every lane; the lead manages worktrees.",
    match = [
        "git worktree remove ../other",
    ],
)

prefix_rule(
    pattern = ["git", ["filter-branch", "filter-repo", "update-ref", "replace", "gc", "prune"]],
    decision = "forbidden",
    justification = "Rewrites or collects shared history and refs; the lead decides.",
)

prefix_rule(
    pattern = ["git", "reflog", ["expire", "delete"]],
    decision = "forbidden",
    justification = "Discards the shared recovery log; the lead decides.",
)

prefix_rule(
    pattern = ["git", "tag", ["-d", "--delete", "-f", "--force"]],
    decision = "forbidden",
    justification = "Tags are shared by every lane; the lead deletes or moves tags.",
)

prefix_rule(
    pattern = ["git", ["reset", "clean", "restore"]],
    decision = "prompt",
    justification = "Discards changes in this lane's own worktree; the reviewer checks it touches only this lane's work.",
    match = [
        "git reset --hard HEAD~1",
        "git clean -fdx",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "prompt",
    justification = "Discards uncommitted changes in this lane's own worktree; the reviewer checks it touches only this lane's work.",
)
