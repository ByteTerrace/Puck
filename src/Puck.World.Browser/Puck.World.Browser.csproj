<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Composition roots</PuckLayer>
        <!-- Microsoft.NET.Sdk.WebAssembly is the one SDK that lays out a bootable browser payload on .NET 11: it
             converts the trimmed assemblies to webcil, writes the boot configuration into _framework/dotnet.js and
             publishes the lot under publish/wwwroot/ (the directory every consumer of this engine reads: the Node
             harness, the studio, `puck official build` and browser.yml). It also sets RuntimeIdentifier to browser-wasm
             and SelfContained to true, which PublishTrimmed needs; adding a command-line `-r browser-wasm` would reach
             every referenced library and change its lock graph, so the identifier stays here. The plain
             Microsoft.NET.Sdk with WasmMainJSPath no longer produces an AppBundle on this SDK (its WasmGenerateAppBundle
             target is empty), on either runtime flavour. -->
        <UseMonoRuntime>true</UseMonoRuntime>
        <!-- The browser-wasm runtime pack ships every Puck.* dependency it links as AnyCPU; PlatformTarget x64 (the
             Directory.Build.props tree default) makes Mono's browser-wasm loader refuse the whole closure at publish
             (every referenced assembly's PE machine type disagrees with the wasm host, which is neither x64 nor
             x86). This is the one project in the tree that must run at AnyCPU instead. -->
        <PlatformTarget>AnyCPU</PlatformTarget>
        <!-- Trimming is the point of a browser publish (payload size), but WorldStateDocumentValues' reflection walk
             (see its own remarks) is real and stays; TrimmerRootAssembly below keeps every member of the assemblies
             that reflect over the document graph, so a trimmed publish cannot silently strip what that walk reaches.
             PublishTrimmed itself only takes effect on `dotnet publish`, never on an ordinary build. -->
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- No console, no window, no threads, and a file system only in memory (the mounted .puck workspace):
             WasmEnableSIMD/WasmEnableExceptionHandling stay at their SDK defaults; single-threaded per the plan's own
             API contract (JSON-string marshalling, no cross-thread state). -->
        <WasmEnableThreads>false</WasmEnableThreads>
        <!-- Mono's runtime is the flavour that serves the editing loop, and only ahead of time. Measured over the
             island under Node (the project README's "Performance" table): Mono AOT composes the island in about a
             sixth of the time Mono's interpreter takes and in a small fraction of CoreCLR's interpreter, and
             CoreCLR's interpreter (.NET 11's default flavour, UseMonoRuntime=false) is the only CoreCLR mode this SDK
             offers for browser-wasm: ReadyToRun for CoreCLR browser-wasm lands in .NET 12 (dotnet/runtime#132339) and
             this SDK's CoreCLR targets neither reference it nor relink the runtime without a wasm-ld failure. AOT
             compiles every assembly in the closure to native wasm instead of interpreting IL per call.
             WasmStripILAfterAOT (the SDK default) cannot strip TrimmerRootAssembly's three rooted assemblies'
             IL — their reflection surface depends on it staying real (see the NoWarn remarks below) — so their
             AOT'd native code and their original IL both ship, which is most of the size cost this switch carries
             (see the README's own size table). The AOT step needs a short checkout path on Windows (README, "Build
             and publish"). -->
        <RunAOTCompilation>true</RunAOTCompilation>
        <!-- The payload is content-addressed downstream (`puck official build` stores every file by hash, and the
             studio verifies each by that hash), and its names are a contract: the official boot path finds
             _framework/dotnet.native.wasm by name and the README's size table reads by name. Fingerprinted file
             names would add nothing and break both. Compression is the website publisher's job (Brotli at the
             highest quality, see the README); the .br/.gz twins this SDK would otherwise write beside every asset
             would be scanned into the official manifest as engine files. -->
        <WasmFingerprintAssets>false</WasmFingerprintAssets>
        <CompressionEnabled>false</CompressionEnabled>
        <!-- Puck.Assets and Puck.World.Schema each carry IsAotCompatible=false for a REAL reason (reflection-based
             JsonSerializer calls in Puck.Assets' DocumentCanonicalizer/DocumentSpatialValues/CreationDocumentJsonConverter;
             WorldSchema/WorldNameRegistry.Walk/WorldStateDocumentValues' own reflection walk in Puck.World.Schema) —
             but that property only silences the Roslyn analyzer at THEIR OWN build, never ILLink's trim analysis of
             their IL when a downstream publish (this one) actually trims. IL2026/IL3050 fire on every
             RequiresUnreferencedCode/RequiresDynamicCode call those files make regardless of whether the calling
             assembly is itself kept whole, because the risk is in the type graph JsonSerializer reflects over at
             runtime, not in whether the caller survives trimming. TrimmerRootAssembly below keeps every member of
             Puck.World.Schema, Puck.World.Authoring, and Puck.Assets through a trimmed publish (the WorldStateDocumentValues
             walk stays real and reachable) — proven by the Node harness over the published payload and the native
             half of the browser-parity baseline, not by the trim analyzer, which none of the three assemblies pass.
             IL2070/IL2075/IL2026/IL3050 are recorded once as the accepted baseline (see the project README) rather
             than fixed member-by-member: none of the flagged call sites (schema/name-registry reflection, the
             puck.creation.v1 embedded-document converter, JsonNode diffing in WorldDocumentBasis) are reachable from
             this project's own Engine/Exports surface today. -->
        <NoWarn>$(NoWarn);IL2026;IL2070;IL2075;IL3050</NoWarn>
        <!-- Parlot (Puck.Transpiler's scanner) collapses its trim analysis to one IL2104 for the package. Every warning
             behind it sits in Parlot's parser-combinator compilation (Parser<T>.Compile, SequenceCompileHelper,
             NumberLiteralBase's static constructor: IL2026, IL2055, IL2072, IL2075, IL2090), and Puck's parser uses
             only Parlot's scanner, cursor and parse context, never a combinator. Copying the package untrimmed does
             not stop the analysis, so the collapsed warning is recorded here, with the README's trim baseline. -->
        <NoWarn>$(NoWarn);IL2104</NoWarn>
        <!-- A trimmed publish defaults this feature switch off, so System.Text.Json.JsonSerializer's generic
             Serialize<T>/Deserialize<T>(…, JsonSerializerOptions) overloads (never the JsonTypeInfo<T> ones this
             project's own Engine code uses) throw NotSupportedException("JsonSerializerIsReflectionDisabled") the
             first time DocumentJsonOptions.Shared-rooted code reaches one — verified against the published payload
             under Node: WorldDocumentBasis's JsonArray.Add(non-primitive) merge/diff logic (the same call sites
             IL2026 above already names) hits exactly this the moment a fragment composes. Puck.Assets/Puck.World.Schema
             already carry that reflection surface deliberately (see the NoWarn remarks above); this switch restores
             the runtime behavior that surface was written against, at a real payload-size cost this project's own
             README records. -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.State/Puck.State.csproj" />
        <ProjectReference Include="../Puck.State.Rules/Puck.State.Rules.csproj" />
        <ProjectReference Include="../Puck.World.Schema/Puck.World.Schema.csproj" />
        <!-- The authoring toolchain the studio edits .puck sources through: compile, diagnostics, composition of a
             source's basis/imports graph, and the language server, run unchanged over the workspace mounted in the
             runtime's in-memory file system (Engine/BrowserWorkspace.cs). -->
        <ProjectReference Include="../Puck.World.Transpiler/Puck.World.Transpiler.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
    </ItemGroup>
    <ItemGroup>
        <TrimmerRootAssembly Include="Puck.Assets" />
        <TrimmerRootAssembly Include="Puck.World.Authoring" />
        <TrimmerRootAssembly Include="Puck.World.Schema" />
    </ItemGroup>
    <!-- Directory.Build.props' win-x64/linux-x64 mimalloc None items condition off '$(RuntimeIdentifier)' ==
         'browser-wasm' for THIS project's own evaluation, but a referenced class library (Puck.Assets, Puck.Maths, …)
         never sets a RuntimeIdentifier of its own — it evaluates that condition as '' != 'browser-wasm' and still
         copies the win-x64/linux-x64 binaries into ITS OWN output, which then flow into this project's output/publish
         directories through ordinary cross-project CopyToOutputDirectory propagation (never into publish/wwwroot,
         which only ever collects static web assets — nothing here reaches the shipped payload). Deleting the stray
         copies after they land is simpler than intercepting the flow at every dependency's own item list. -->
    <Target Name="PuckRemoveNativeMimallocFromWasmOutput" AfterTargets="Build;Publish">
        <ItemGroup>
            <PuckStrayMimalloc Include="$(OutDir)mimalloc*.dll;$(OutDir)libmimalloc.so*;$(PublishDir)mimalloc*.dll;$(PublishDir)libmimalloc.so*" />
        </ItemGroup>
        <Delete Condition="'@(PuckStrayMimalloc)' != ''" Files="@(PuckStrayMimalloc)" />
    </Target>
</Project>
