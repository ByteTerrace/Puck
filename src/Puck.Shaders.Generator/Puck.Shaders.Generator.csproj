<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Shaders.Generator</RootNamespace>
        <UseAppHost>false</UseAppHost>
    </PropertyGroup>
    <!--
        The build-time host of the shader declaration generator. Every project whose kernels include a declaration the C#
        model owns (sdf-isa.hlsli, a generated *.interface.hlsli) references this project with
        ReferenceOutputAssembly="false", so its build runs before that project's kernels compile: build/Shaders.targets
        compiles kernels after ResolveProjectReferences. The generator reads only the model (Puck.Shaders.Model and
        Puck.SdfVm.Model), which compiles no shader, so a kernel reading a declaration the model has just gained builds
        in one pass, with no header seeded by hand. `puck shaders generate` runs the same list (ShaderDeclarations) and
        checks the tree. With `compile` or `check` it runs one project's shader build for build/Shaders.targets
        (ShaderBuild, through the one shader compiler and its cache).
    -->
    <ItemGroup>
        <ProjectReference Include="../Puck.SdfVm.Model/Puck.SdfVm.Model.csproj" />
    </ItemGroup>
    <!-- Reconcile whenever the generator's assemblies or a file the last run read or owns moved: the stamp lists those
         files, so one edited, deleted or restored without changing an assembly reruns it (a missing input always runs
         the target). Equal declarations are never rewritten, so a run does not invalidate unchanged kernels. -->
    <Target Name="PuckReadShaderDeclarationInputs" Condition="'$(DesignTimeBuild)' != 'true'">
        <!-- The intermediate directory is set by the SDK's targets, after this project's body, so the stamp is named here. -->
        <PropertyGroup>
            <_PuckShaderDeclarationStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'shader-declarations.inputs'))</_PuckShaderDeclarationStamp>
        </PropertyGroup>
        <ReadLinesFromFile File="$(_PuckShaderDeclarationStamp)" Condition="Exists('$(_PuckShaderDeclarationStamp)')">
            <Output TaskParameter="Lines" ItemName="_PuckShaderDeclarationInput" />
        </ReadLinesFromFile>
        <ItemGroup>
            <_PuckShaderDeclarationInput Include="$(TargetDir)*.dll" />
        </ItemGroup>
    </Target>
    <Target Name="PuckGenerateShaderDeclarations" AfterTargets="Build" DependsOnTargets="PuckReadShaderDeclarationInputs" Condition="'$(DesignTimeBuild)' != 'true'"
            Inputs="@(_PuckShaderDeclarationInput);$(MSBuildProjectFullPath)" Outputs="$(_PuckShaderDeclarationStamp)">
        <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..').TrimEnd('/'))&quot; &quot;$(_PuckShaderDeclarationStamp)&quot;" />
    </Target>
</Project>
