<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Shaders.Generator</RootNamespace>
        <UseAppHost>false</UseAppHost>
    </PropertyGroup>
    <!--
        The build-time host of the shader declaration generator. Every project whose kernels include a declaration the C#
        model owns (sdf-isa.hlsli, a generated *.interface.hlsli) references this project with
        ReferenceOutputAssembly="false", so its build runs before that project's kernels compile: build/Shaders.targets
        compiles kernels after ResolveProjectReferences. The generator reads only the model (Puck.Shaders.Model and
        Puck.SdfVm.Model), which compiles no shader, so a kernel reading a declaration the model has just gained builds
        in one pass, with no header seeded by hand. `puck shaders generate` runs the same list (ShaderDeclarations) and
        stays the one way to write the build's shader recipe and to check the tree.
    -->
    <ItemGroup>
        <ProjectReference Include="../Puck.SdfVm.Model/Puck.SdfVm.Model.csproj" />
    </ItemGroup>
    <!-- Runs once the generator is built, and again only when an assembly it runs has changed: a changed model is the
         only thing that moves a declaration's text. It writes a file only when its text differs, so a model change that
         moves no declaration recompiles no kernel. A continuous-integration build (ContinuousIntegrationBuild, which
         Directory.Build.props sets on CI) is never a generation run: it passes check-only and fails naming each drifted
         file, so no CI step after a build, such as the formatting bot's commit, can carry a regenerated file. The stamp is
         the run's one output. -->
    <Target Name="PuckGenerateShaderDeclarations" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'"
            Inputs="$(TargetPath);@(ReferenceCopyLocalPaths);$(MSBuildProjectFullPath)"
            Outputs="$(IntermediateOutputPath)declarations.stamp">
        <PropertyGroup>
            <_PuckDeclarationMode Condition="'$(ContinuousIntegrationBuild)' == 'true'"> --check</_PuckDeclarationMode>
        </PropertyGroup>
        <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..').TrimEnd('/'))&quot;$(_PuckDeclarationMode)" />
        <Touch AlwaysCreate="true" Files="$(IntermediateOutputPath)declarations.stamp" />
        <ItemGroup>
            <FileWrites Include="$(IntermediateOutputPath)declarations.stamp" />
        </ItemGroup>
    </Target>
</Project>
