<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Content-addressed asset primitives for .NET: path-based byte sources, compact SHA-256 identities, a bounded least-recently-used cache, and a persistent full-digest object store with named refs.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Assets</PackageId>
        <PackageTags>assets;caching;content-addressing</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Leaf contracts and data</PuckLayer>
    </PropertyGroup>
</Project>
