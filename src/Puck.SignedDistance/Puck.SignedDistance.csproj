<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.SignedDistance</AssemblyName>
        <Description>The signed-distance-function field as data: the instruction ISA, the packed-word program
        representation, the fluent authoring builder (including laying out Puck.Text-authored strings into marchable
        glyph geometry), the solid primitive vocabulary and its unit-size table, the isometric domain-operator family
        read both as a point fold and as the rigid copies it generates, and a warp-free deterministic fixed-point CPU
        interpreter (Puck.SignedDistance.Queries) for authoritative simulation to query the same field a GPU renders.
        No GPU or shader-compiler dependency of any kind.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.SignedDistance</PackageId>
        <PackageTags>determinism;distance-field;fixed-point;sdf;simulation</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
        <RootNamespace>Puck.SignedDistance</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- Shade identities include the live helper source closure. Embedding makes the same identity available
             to headless admission, the generator and a published host without a source-tree dependency. -->
        <EmbeddedResource Include="../Puck.SdfVm/Assets/Shaders/Sdf/field/*.hlsli" LogicalName="ShadeHelper.field.%(Filename)%(Extension)" />
        <EmbeddedResource Include="../Puck.SdfVm/Assets/Shaders/Sdf/shade/shade-weathering.hlsli" LogicalName="ShadeHelper.lines" />
        <EmbeddedResource Include="../Puck.SdfVm.Model/SdfShadeHlsl.cs" LogicalName="ShadeHelper.generator" />
        <ProjectReference Include="../Puck.Abstractions/Puck.Abstractions.csproj" />
        <ProjectReference Include="../Puck.Maths/Puck.Maths.csproj" />
        <ProjectReference Include="../Puck.Text/Puck.Text.csproj" />
    </ItemGroup>
</Project>
