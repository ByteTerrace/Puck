<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
    </PropertyGroup>
    <PropertyGroup>
        <!-- Protocol payloads select runtime types and inline document JSON uses reflection-based metadata. -->
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>
    <!--
        Puck.World.Data — the world DOCUMENT model and the wire/tape PROTOCOL DTOs, physically split out of
        Puck.World (headless P1) so the authoritative simulation is structurally unable to reach presentation: this
        project cannot see a GPU backend, a renderer, Puck.SdfVm, Puck.Overlays, Puck.Input, or Puck.World.Server, so
        nothing built on it can accidentally couple document parsing or wire framing to a window. It carries
        WorldDefinition (and every section record nested under it, including WorldHostDefaults and the identity
        section an owned world's document carries), WorldDefinitionValidator, WorldDefinitionSerialization/
        WorldJsonPayload (the JSON seams document and payload parsing shares), WorldProfile (the runtime profile
        handle both the document validator and Puck.World.Server's population/body code need), and the whole
        Protocol/ surface: PlayerIntent, WorldCommand/WorldMutation/WorldGrant/WorldPrincipal/WorldSessionLever,
        SessionRequest/WorldSnapshot/WorldComposition, IServerLink/IClientSink, LoopbackTransport, and
        WorldPrincipalMapping. Puck.World.Server references this project for the document and protocol shapes it
        folds against; Puck.World (the composition root) references both.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Puck.Abstractions\Puck.Abstractions.csproj" />
        <!-- The signed-attestation/trust-list/verifier machinery (docs/vision.md, "Signed attestation") —
             the admission section's WorldAdmissionDoor verifies a connecting peer's claim against the document's
             own admission trust list through this, off the tick thread, at the TCP hello boundary. Leaf contracts
             and data, so this edge introduces no new layer dependency. -->
        <ProjectReference Include="..\Puck.Attestation\Puck.Attestation.csproj" />
        <ProjectReference Include="..\Puck.Commands\Puck.Commands.csproj" />
        <!-- The puck.creation.v1/puck.audio.v1/puck.synth.v1 document families WorldDefinition embeds (creations,
             speakers, tunes) and their canonicalize boundary. -->
        <ProjectReference Include="..\Puck.Forge\Puck.Forge.csproj" />
        <ProjectReference Include="..\Puck.Maths\Puck.Maths.csproj" />
    </ItemGroup>
</Project>
