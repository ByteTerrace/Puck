<Project Sdk="Microsoft.NET.Sdk">
    <!-- The provider-neutral release and automation verbs. Deployment providers are installed extensions. -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Release</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../../build/CandidateCliInstall.cs" Link="NuGet/CandidateCliInstall.cs" />
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
        <ProjectReference Include="../Puck.Cli.Runs/Puck.Cli.Runs.csproj" />
        <ProjectReference Include="../Puck.Cli.Source/Puck.Cli.Source.csproj" />
        <ProjectReference Include="../Puck.Cli.Worlds/Puck.Cli.Worlds.csproj" />
        <ProjectReference Include="../Puck.Mcp/Puck.Mcp.csproj" />
        <ProjectReference Include="../Puck.World.Silo/Puck.World.Silo.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
    </ItemGroup>
</Project>
