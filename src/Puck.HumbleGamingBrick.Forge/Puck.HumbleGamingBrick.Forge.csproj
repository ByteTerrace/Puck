<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckLicenseKind>GamingBricks</PuckLicenseKind>
        <Description>Native CGB cartridge compilation from editable puck.cartridge.v1 data, with the core's shared SM83 emitter, hardware framework primitives and Tune audio-document compilation.</Description>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsAotCompatible>false</IsAotCompatible>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.HumbleGamingBrick.Forge</PackageId>
        <PackageTags>authoring;cgb;determinism;dmg;homebrew;rom;sm83</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
        <RootNamespace>Puck.HumbleGamingBrick.Forge</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.GamingBricks.Transpiler/Puck.GamingBricks.Transpiler.csproj" />
        <ProjectReference Include="../Puck.GamingBricks.Forge/Puck.GamingBricks.Forge.csproj" />
        <ProjectReference Include="../Puck.Assets/Puck.Assets.csproj" />
        <ProjectReference Include="../Puck.HumbleGamingBrick/Puck.HumbleGamingBrick.csproj" />
    </ItemGroup>
</Project>
