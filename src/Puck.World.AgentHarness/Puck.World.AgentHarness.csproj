<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Agent Framework uses reflection-driven function schemas and is not an AOT boundary. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsAotCompatible>false</IsAotCompatible>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Optional extensions</PuckLayer>
    </PropertyGroup>
    <ItemGroup>
        <!-- Pinned deliberately: Harness is a fast-moving integration surface and must not drift under Puck. -->
        <PackageReference Include="Microsoft.Agents.AI.Harness" Version="[1.20.0]" />
        <!-- Chat client providers install beside this extension and load Microsoft.Extensions.AI through its context,
             so it carries the same floor they build against (Microsoft.Extensions.AI.OpenAI [10.*, )). -->
        <PackageReference Include="Microsoft.Extensions.AI" Version="[10.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\Puck.World.AgentBridge\Puck.World.AgentBridge.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
    </ItemGroup>
</Project>
