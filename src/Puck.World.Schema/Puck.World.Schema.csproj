<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- WorldSchema's own node-converter/vocabulary lookups (TryGetNodeConverter/TryGetStringVocabulary/
             TryGetTypeVocabulary), WorldNameRegistry's instruction-payload discovery, and WorldStateDocumentValues'
             getter binding for caller-owned graph types still need reflection; document getters are generated. So does every
             JsonNode/JsonArray-based document diff/merge in WorldDocumentBasis and the composed-tree loaders in
             WorldDefinitionFileSource/WorldAssetRowLoader/WorldJsonPayload. -->
        <IsAotCompatible>false</IsAotCompatible>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Abstractions/Puck.Abstractions.csproj" />
        <ProjectReference Include="../Puck.Assets/Puck.Assets.csproj" />
        <ProjectReference Include="../Puck.Attestation/Puck.Attestation.csproj" />
        <ProjectReference Include="../Puck.Commands/Puck.Commands.csproj" />
        <ProjectReference Include="../Puck.Maths/Puck.Maths.csproj" />
        <ProjectReference Include="../Puck.Physics/Puck.Physics.csproj" />
        <ProjectReference Include="../Puck.State.Rules/Puck.State.Rules.csproj" />
        <ProjectReference Include="../Puck.State/Puck.State.csproj" />
        <ProjectReference Include="../Puck.Text/Puck.Text.csproj" />
        <ProjectReference Include="../Puck.Hosting/Puck.Hosting.csproj" />
        <ProjectReference Include="../Puck.World.Authoring/Puck.World.Authoring.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
    </ItemGroup>
    <!-- The commit this assembly is built at, embedded as a manifest resource (WorldSchema.SourceRevision). A
         resource is not part of the reference assembly, so a new commit recompiles this project alone and its
         dependents only copy it; the file is rewritten only when the commit changes. Empty outside a git tree. -->
    <Target Name="PuckEmbedSourceRevision" BeforeTargets="AssignTargetPaths" DependsOnTargets="InitializeSourceControlInformation">
        <PropertyGroup>
            <_PuckSourceRevisionFile>$(IntermediateOutputPath)puck.source-revision.txt</_PuckSourceRevisionFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_PuckSourceRevisionFile)" Lines="$(SourceRevisionId)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <EmbeddedResource Include="$(_PuckSourceRevisionFile)" LogicalName="Puck.World.Schema.SourceRevision" />
            <FileWrites Include="$(_PuckSourceRevisionFile)" />
        </ItemGroup>
    </Target>
</Project>
