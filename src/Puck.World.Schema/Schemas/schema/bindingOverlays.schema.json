{
  "type": [
    "array",
    "null"
  ],
  "items": {
    "description": "One per-world binding overlay \u2014 a whole BindingProfileDocument layered over the engine default beneath every seat\u0027s profile bindings, so a world can contextualize the controls (a kart world remapping a lane, an RTS world adding a chorded command page) as data, never a client fork. Merged in order; the composed result (default \u2295 every overlay whose When currently holds) is what the validator compiles.",
    "type": [
      "object",
      "null"
    ],
    "properties": {
      "id": {
        "description": "The overlay\u0027s stable id \u2014 its mutation address (unique within the definition; carries no meaning beyond identity).",
        "type": "string"
      },
      "document": {
        "description": "The overlay binding document merged into the composed mapping.",
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "pressThreshold": {
                  "type": "number",
                  "default": 0.5
                },
                "releaseThreshold": {
                  "type": "number",
                  "default": 0.4
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "icon": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "id",
                "sources"
              ],
              "additionalProperties": false,
              "title": "BindingModifierDefinition"
            }
          },
          "chords": {
            "type": "array",
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "group": {
                  "title": "DocumentIdentifier",
                  "type": "string"
                },
                "chord": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "default": null
                },
                "page": {
                  "$ref": "./common.schema.json#/$defs/BindingPageDefinition",
                  "default": null
                },
                "command": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "command": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null
                    },
                    "channel": {
                      "default": null,
                      "title": "ChannelRef"
                    },
                    "scale": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "default": null
                    },
                    "holdRelease": {
                      "type": "boolean",
                      "default": false
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null
                    },
                    "icon": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null
                    },
                    "value": {
                      "default": null,
                      "title": "CommandValue"
                    },
                    "mode": {
                      "enum": [
                        "Hold",
                        "Toggle"
                      ],
                      "default": "Hold",
                      "title": "BindingEntryMode"
                    },
                    "text": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null
                    },
                    "passThrough": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "additionalProperties": false,
                  "default": null,
                  "title": "BindingCommandDefinition"
                },
                "held": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "default": null
                }
              },
              "required": [
                "group"
              ],
              "additionalProperties": false,
              "title": "BindingChordDefinition"
            }
          },
          "contexts": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "family": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "group": {
                  "title": "DocumentIdentifier",
                  "type": "string"
                }
              },
              "required": [
                "family",
                "state",
                "group"
              ],
              "additionalProperties": false,
              "title": "BindingContextDefinition"
            },
            "default": null
          },
          "wheels": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "group": {
                  "title": "DocumentIdentifier",
                  "type": "string"
                },
                "holdPages": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "rings": {
                  "type": "array",
                  "items": {
                    "$ref": "./common.schema.json#/$defs/BindingPageDefinition"
                  }
                },
                "style": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "pointerSelection": {
                      "enum": [
                        "Disabled",
                        "Angle",
                        "HitTarget"
                      ],
                      "default": "Angle",
                      "title": "BindingWheelSpatialSelectionMode"
                    },
                    "placement": {
                      "enum": [
                        "Pointer",
                        "ViewportCenter"
                      ],
                      "default": "Pointer",
                      "title": "BindingWheelPlacement"
                    },
                    "deadZoneFraction": {
                      "type": "number",
                      "default": 0.1
                    },
                    "ringWidthFraction": {
                      "type": "number",
                      "default": 0.07
                    },
                    "outerGraceRingFraction": {
                      "type": "number",
                      "default": 0.5
                    },
                    "sectorOffset": {
                      "type": "number",
                      "default": 0
                    },
                    "initialRing": {
                      "type": "integer",
                      "default": 0
                    },
                    "ringSelection": {
                      "enum": [
                        "Explicit",
                        "Excursion"
                      ],
                      "default": "Explicit",
                      "title": "BindingWheelRingSelectionMode"
                    },
                    "excursion": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "deadZone": {
                          "type": "number"
                        },
                        "thresholds": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "spatialTravelFraction": {
                          "type": "number",
                          "default": 0.25
                        },
                        "hysteresis": {
                          "type": "number",
                          "default": 0.02
                        }
                      },
                      "required": [
                        "deadZone",
                        "thresholds"
                      ],
                      "additionalProperties": false,
                      "default": null,
                      "title": "BindingWheelExcursionDefinition"
                    },
                    "axisDeadZone": {
                      "type": "number",
                      "default": 0.08
                    },
                    "selectionGraceSeconds": {
                      "type": "number",
                      "default": 0.5
                    },
                    "switchFraction": {
                      "type": "number",
                      "default": 0.4
                    },
                    "fadeOutSeconds": {
                      "type": "number",
                      "default": 0.25
                    },
                    "fadeOutEase": {
                      "type": "number",
                      "default": 2
                    }
                  },
                  "additionalProperties": false,
                  "default": null,
                  "title": "BindingWheelStyleDefinition"
                },
                "labelRow": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "iconRow": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "id",
                "group",
                "holdPages",
                "rings"
              ],
              "additionalProperties": false,
              "title": "BindingWheelDefinition"
            },
            "default": null
          },
          "bindingBar": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "hideUnbound": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "scale": {
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "contrastBoost": {
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "uiScale": {
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "layout": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            },
            "additionalProperties": false,
            "default": null,
            "title": "BindingBarPreferences"
          }
        },
        "required": [
          "version",
          "modifiers",
          "chords"
        ],
        "additionalProperties": false,
        "title": "BindingProfileDocument"
      },
      "bindingBar": {
        "description": "The on-screen bar policy carried with this binding layer; null carries no policy on this layer, so bar resolution falls through to the world-authored policy, and to Absent (no bar drawn) when neither an identity nor the world authors one.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "slotSet": {
            "$ref": "./common.schema.json#/$defs/StringList",
            "description": "The physical controls this bar shows, by input source id (gamepad.buttonSouth, mouse.button1, \u2026) \u2014 the same vocabulary a binding entry\u0027s sources speak, every id validated against the engine\u0027s input-source catalog, unique, at most MaxSlots. A layout\u0027s bank places these; one it does not place is not shown on that bank."
          },
          "banks": {
            "$ref": "./common.schema.json#/$defs/WorldBindingBarBankList",
            "description": "The stacked banks \u2014 at least one, at most MaxBanks, unique ids, each naming a page the composed binding profile actually declares. List order is draw order."
          },
          "enabled": {
            "description": "Whether the bar is shown when no live override hides it.",
            "type": "boolean",
            "default": true
          },
          "text": {
            "description": "Whether the bar draws the atlas text it composes \u2014 a badge whose icon row carries a Label (LB/RB, LT/RT, LS/RS, the menu trio, the exotics), the active page\u0027s name under the modifier indicators, and a chord hint\u0027s label. false drops every label-content badge outright and leaves a purely pictographic bar: every plate, the glyph-content badges (the d-pad arrows and the face-position marks), the bound actions\u0027 icons, and the modifier indicators all still draw.",
            "type": "boolean",
            "default": true
          },
          "modifiers": {
            "description": "Whether the bar draws the modifier indicator row on its anchor line \u2014 one plate per modifier the composed profile carries (declared rows plus every chord/held token the compiler synthesizes), lit while held. false drops the row and leaves the slot clusters alone. While the row draws, it places every chord member, so every command chord can show as a hint; without it a hint shows only for a chord whose members are all in SlotSet.",
            "type": "boolean",
            "default": true
          },
          "declaredModifiersOnly": {
            "description": "Whether the modifier row (and the chord hints it places) keeps to the modifiers the binding document DECLARES in its modifiers section \u2014 the page-holding triggers an author named \u2014 and leaves out the implicit modifier the compiler mints for every raw source a chord or held row names (a bare key, a mouse button, a shoulder). false draws every one. It shapes only what Modifiers draws, so it does nothing while that is off.",
            "type": "boolean",
            "default": false
          },
          "pageLabel": {
            "description": "Whether the bar names the active page under its anchor while Text is on; false keeps every badge label and chord hint and drops only the page\u0027s name.",
            "type": "boolean",
            "default": true
          },
          "hideUnbound": {
            "description": "Whether a slot with no bound act on its bank\u0027s page should not render at all, rather than drawing the disabled tier-0 plate. A player\u0027s own BindingBarPreferences.HideUnbound overrides this.",
            "type": "boolean",
            "default": false
          },
          "multiSeatAlpha": {
            "description": "The opacity every joined seat\u0027s bar renders at while two or more seats are joined \u2014 the split-screen quieting lever, multiplied into each bank\u0027s own alpha; 1 keeps multi-seat bars fully opaque.",
            "type": "number",
            "default": 1
          },
          "iconRow": {
            "description": "The state row a slot\u0027s icon resolves through, spelled state.\u003Crow\u003E \u2014 the row\u0027s CELL KEY is the bound row\u0027s id when it authors one, else its action (command or channel; a dotted command name therefore needs an id, since a cell key holds no dot), and its value is an icons name. The engine holds no action-to-icon vocabulary of its own: the association is ordinary authored state, so it is written, read, and MUTATED like any other state (world.state.cell.set) \u2014 a spell minted at runtime gets its icon by writing a cell, never by reshaping the document. null resolves no slot icons at all; a key the row does not carry simply draws no icon.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "layouts": {
            "$ref": "./common.schema.json#/$defs/IReadOnlyDictionaryStringWorldBindingBarLayout",
            "description": "The bar\u0027s layouts by name \u2014 a crossbar, a strip, whatever an author adds next \u2014 each a whole WorldBindingBarLayout.",
            "default": null
          },
          "layout": {
            "description": "The name of the layout drawn when LayoutCell is absent or names none.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "layoutCell": {
            "description": "A text state cell, state.\u003Crow\u003E.\u003Ckey\u003E, whose value names the live entry of Layouts; a value naming none falls back to Layout. Ordinary state: a chord, a wheel sector, or the console switches the bar\u0027s whole shape by writing the cell.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "modelCell": {
            "description": "A text state cell, state.\u003Crow\u003E.\u003Ckey\u003E, whose value picks the bar\u0027s model: single draws one bar \u2014 the active page\u0027s bank, in the first authored bank\u0027s place, swapping in place as a chord is held or released; any other value (or no cell) draws every bank the live layout places, the active one at full alpha and the rest as wings. Ordinary state, flipped the same way LayoutCell is.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "visible": {
            "$ref": "./common.schema.json#/$defs/OverlayPredicateNullable",
            "description": "The bar\u0027s visibility condition over presentation facts, or null for always.",
            "default": null
          }
        },
        "required": [
          "slotSet",
          "banks"
        ],
        "additionalProperties": false,
        "default": null,
        "title": "WorldBindingBarAuthoring"
      },
      "when": {
        "description": "The condition this layer composes under; null always composes it (today\u0027s behavior). Reuses StateCondition\u0027s field convention rather than a second reading of \u0022compare a state cell\u0022 \u2014 the same state/key/comparison/value shape a placement\u0027s own response facet speaks. Re-evaluated whenever the routed definition changes, never per frame.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "state": {
            "description": "The state row compared \u2014 any declared state.world row of a numeric kind (never Text).",
            "type": "string"
          },
          "comparison": {
            "$ref": "./common.schema.json#/$defs/ExpressionComparison",
            "description": "The comparison."
          },
          "value": {
            "description": "The literal comparand, or null when ComparandState spells the comparand instead.",
            "type": [
              "number",
              "null"
            ],
            "default": null
          },
          "key": {
            "description": "The cell inside State, or null for its slot cell. Refused when State is keyed and this is absent, or unkeyed and this is present.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "comparandState": {
            "description": "Another declared state.world row, read live and compared instead of Value. Must share State\u0027s cell kind (refused by name otherwise).",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "comparandKey": {
            "description": "The cell inside ComparandState, on the same terms as Key. Refused when ComparandState is absent.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "state",
          "comparison"
        ],
        "additionalProperties": false,
        "default": null,
        "title": "WorldPlacementResponseConditionStateConditionBare"
      }
    },
    "required": [
      "id",
      "document"
    ],
    "additionalProperties": false,
    "title": "WorldBindingOverlay"
  },
  "default": null
}
