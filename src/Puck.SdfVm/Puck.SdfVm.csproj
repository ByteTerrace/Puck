<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
    </PropertyGroup>
    <!--
        The SDF GPU engine: the single-source HLSL shaders (the SDF VM interpreter sdf-vm.hlsli plus the
        world-compositor and fullscreen stages), and the GPU host that runs the VM — SdfWorldResidency (a frame
        source's device state: its captured frame, its tables and their one upload a frame, its pipeline set) and
        SdfWorldPasses (the sdf.world package's recorders, which render each view as a render-graph instance of the
        package's passes). Consumes Puck.SignedDistance for the instruction
        ISA, the program representation, and the fluent authoring builder. Fully backend-neutral: only the
        IGpuCompute* seams from Puck.Abstractions, never Vulkan or DirectX types. The C# and the shaders are
        halves of one engine and must stay in sync.
    -->
    <PropertyGroup>
        <!-- The DirectX Shader Compiler (ships with the Vulkan SDK and the Windows SDK) compiles the single
             HLSL source to both SPIR-V (Vulkan) and DXIL (DirectX). Override with /p:DxcCommand="path/to/dxc". -->
        <DxcCommand>dxc</DxcCommand>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Puck.Abstractions/Puck.Abstractions.csproj" />
        <ProjectReference Include="../Puck.Hosting/Puck.Hosting.csproj" />
        <ProjectReference Include="../Puck.Maths/Puck.Maths.csproj" />
        <!-- The model the kernels' declarations are generated from: the instruction set's HLSL declaration, the
             visibility record's shared words and the kernels' pass interfaces. -->
        <ProjectReference Include="../Puck.SdfVm.Model/Puck.SdfVm.Model.csproj" />
        <!-- Build-only: its build writes the declarations these kernels include that the C# model owns, and it runs their
             shader build (build/Shaders.targets compiles kernels after ResolveProjectReferences). -->
        <ProjectReference Include="../Puck.Shaders.Generator/Puck.Shaders.Generator.csproj" PrivateAssets="all" Private="false" ReferenceOutputAssembly="false" />
        <!-- The region-copy kernel and the device-wide pipeline cache the table upload and the mesh region record with. -->
        <ProjectReference Include="../Puck.Shaders/Puck.Shaders.csproj" />
        <!-- The instruction ISA, the packed-word program representation, and the fluent authoring builder — every
             SdfProgram/SdfProgramBuilder/SdfMaterial reference in this project resolves here. -->
        <ProjectReference Include="../Puck.SignedDistance/Puck.SignedDistance.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- SPIR-V for the Vulkan SDF renderer and DXIL for the DirectX one: the shared build/Shaders.targets compiles
             every stage source to both on Windows (neither DXIL opt-out is set), and to SPIR-V alone on any other host,
             and ships the bytecode. -->
        <VertexShaderSource Include="Assets/Shaders/**/*.vert.hlsl" />
        <FragmentShaderSource Include="Assets/Shaders/**/*.frag.hlsl" />
        <ComputeShaderSource Include="Assets/Shaders/**/*.comp.hlsl" />
    </ItemGroup>

    <!--
        The sources whose code decides a baked mesh's bytes on the CPU: the bake's lattices, its sample decoding and
        meshing, the geometry it is keyed by, the frame block rows and point table the bake kernel reads, and the store's
        own format. Their content hash is the assembly's PuckMeshBakeSources metadata, which SdfMeshStore.CodeIdentity
        keys every stored mesh by, beside Puck.SignedDistance's build (the lattice and the contouring) and the bake
        kernels' bytecode, so an edit to the rest of the renderer keeps the stored meshes and an edit here bakes afresh.
        A file the bake comes to read belongs in this list.
    -->
    <ItemGroup>
        <PuckMeshBakeSource Include="SdfFrameBlock.Mesh.cs;SdfMesh.cs;SdfMeshBakeGroup.cs;SdfMeshGeometry.cs;SdfMeshLibrary.cs;SdfMeshMaterialCut.cs;SdfMeshPathBake.cs;SdfMeshStore.cs;SdfWorldTables.MeshBakePoints.cs;../Puck.Shaders.Model/Graph/SdfWorldPackage.Mesh.cs" />
    </ItemGroup>
    <Target Name="PuckMeshBakeSourcesHash" BeforeTargets="GetAssemblyAttributes">
        <GetFileHash Files="@(PuckMeshBakeSource)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_PuckMeshBakeSourceHashed" />
        </GetFileHash>
        <Hash ItemsToHash="@(_PuckMeshBakeSourceHashed->'%(FileHash)')">
            <Output TaskParameter="HashResult" PropertyName="_PuckMeshBakeSourcesHash" />
        </Hash>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>PuckMeshBakeSources</_Parameter1>
                <_Parameter2>$(_PuckMeshBakeSourcesHash)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>
</Project>
