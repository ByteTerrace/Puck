<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
    </PropertyGroup>
    <!--
        The SDF GPU engine: the single-source HLSL shaders (the SDF VM interpreter sdf-vm.hlsli plus the
        world-compositor and fullscreen stages), and the GPU host that runs the VM — SdfWorldEngine (the
        device-explicit pipeline core: beam cull → per-view render → split-screen composite over a viewport
        table of cameras + regions) and SdfEngineNode (the host-model IRenderNode that renders the world into
        its own offscreen surface for a host to composite). Consumes Puck.SignedDistance for the instruction
        ISA, the program representation, and the fluent authoring builder. Fully backend-neutral: only the
        IGpuCompute* seams from Puck.Abstractions, never Vulkan or DirectX types. The C# and the shaders are
        halves of one engine and must stay in sync.
    -->
    <PropertyGroup>
        <!-- The DirectX Shader Compiler (ships with the Vulkan SDK and the Windows SDK) compiles the single
             HLSL source to both SPIR-V (Vulkan) and DXIL (DirectX). Override with /p:DxcCommand="path\to\dxc". -->
        <DxcCommand>dxc</DxcCommand>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\Puck.Hosting\Puck.Hosting.csproj" />
        <ProjectReference Include="..\Puck.Maths\Puck.Maths.csproj" />
        <!-- The instruction ISA, the packed-word program representation, and the fluent authoring builder — every
             SdfProgram/SdfProgramBuilder/SdfMaterial reference in this project resolves here. -->
        <ProjectReference Include="..\Puck.SignedDistance\Puck.SignedDistance.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The generated bytecode: SPIR-V for the Vulkan SDF renderer, DXIL for the DirectX SDF producer. Declared
             ONCE as ShaderBytecode (the ValidateShaderBytecodeSources staleness guard batches over it) and shipped by
             deriving Content from it, so a new bytecode glob can never be shipped without also being guarded. -->
        <ShaderBytecode Include="Assets\Shaders\**\*.spv" />
        <ShaderBytecode Include="Assets\Shaders\**\*.dxil" />
    </ItemGroup>

    <ItemGroup>
        <VertexShaderSource Include="Assets\Shaders\**\*.vert.hlsl" />
        <FragmentShaderSource Include="Assets\Shaders\**\*.frag.hlsl" />
        <ComputeShaderSource Include="Assets\Shaders\**\*.comp.hlsl" />
        <ShaderInclude Include="Assets\Shaders\**\*.hlsli" />
    </ItemGroup>

    <!-- CompileShaders / CollectShaderBytecode / ValidateShaderBytecodeSources / ValidateShaderBytecodeFresh all
         live in the shared build\Shaders.targets now (imported by Directory.Build.targets), item-driven purely
         over the ItemGroup globs above. Both DXIL opt-out properties (PuckShaderDxilEnabled,
         PuckComputeShaderDxilEnabled) stay at their shared default true — unchanged behavior: every kernel still
         emits both SPIR-V and DXIL. -->
</Project>
