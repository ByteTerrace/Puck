// Generated by `puck shaders generate` from the field catalogues.
precise float3 sdfTranslatePoint(float3 p, float3 translation) {
    return (p - translation);
}

precise float3 sdfRotatePoint(float3 p, float4 rotation) {
    return rotatePointByInverseQuaternion(p, rotation);
}

precise float3 sdfScalePoint(float3 p, float3 scale) {
    return (p / scale);
}

precise float sdfScaleDistance(float distanceScale, float factor) {
    return (distanceScale * factor);
}

precise float3 sdfElongatePoint(float3 p, float3 extents) {
    return (p - clamp(p, (-extents), extents));
}

precise float3 sdfRepeatPoint(float3 p, float3 spacing, float3 inverseSpacing) {
    return (p - (spacing * round((p * inverseSpacing))));
}

precise float3 sdfRepeatLimitedPoint(float3 p, float3 spacing, float3 limit) {
    return (p - (spacing * clamp(round((p / spacing)), (-limit), limit)));
}

precise float sdfOnionField(float distance, float thickness) {
    return (abs(distance) - thickness);
}

precise float sdfDilateField(float distance, float amount) {
    return (distance - amount);
}

precise float3 sdfSymmetryPlanePoint(float3 p, float3 normal, float offset) {
    precise float side = (dot(p, normal) + offset);
    return (p - (normal * (min(side, 0.0) * 2.0)));
}

precise float sdfReliefField(float distance, float3 p, float weight, float frequency, float amplitude, float gain, float lacunarity, float normalizer, uint seed, uint octaves) {
    if ((weight == 0.0)) { return distance; }
    precise float relief = ((amplitude * normalizer) * sdfFbm3((p * frequency), seed, octaves, gain, lacunarity));
    return (distance + (relief * weight));
}

precise float sdfCellDisplaceField(float distance, float3 p, float frequency, float amplitude, float jitter, uint seed, uint mode) {
    return (distance + (amplitude * (sdfCellDistance((p * frequency), seed, mode, jitter) - 0.5)));
}
