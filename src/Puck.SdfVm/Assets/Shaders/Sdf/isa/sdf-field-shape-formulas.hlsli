// Generated by `puck shaders generate` from the field catalogues.
precise float sdfBoxDistance(float3 q) {
    return (length(float3(max(q.x, 0.0), max(q.y, 0.0), max(q.z, 0.0))) + min(max(q.x, max(q.y, q.z)), 0.0));
}

precise float sdfBox(float3 p, float3 halfExtents, float cornerRadius) {
    precise float3 q = (abs(p) - (halfExtents - float3(cornerRadius, cornerRadius, cornerRadius)));
    return (sdfBoxDistance(q) - cornerRadius);
}

precise float sdfCapsule(float3 p, float3 endpoint, float radius) {
    precise float h = (dot(endpoint, endpoint) > 0.0 ? saturate(dot(p, endpoint) / dot(endpoint, endpoint)) : 0.0);
    return (length((p - (endpoint * h))) - radius);
}

precise float sdfSphere(float3 p, float radius) {
    return (length(p) - radius);
}

precise float sdfTorus(float3 p, float major, float minor) {
    return (length(float2((length(float2(p.x, p.z)) - major), p.y)) - minor);
}

precise float sdfBoxDistance2(float2 q) {
    return (length(float2(max(q.x, 0.0), max(q.y, 0.0))) + min(max(q.x, q.y), 0.0));
}

precise float sdfCylinder(float3 p, float radius, float halfHeight, float rounding) {
    return (sdfBoxDistance2(float2((length(float2(p.x, p.z)) - radius), (abs(p.y) - halfHeight))) - rounding);
}

precise float sdfPlane(float3 p, float3 normal, float offset) {
    return (dot(p, normal) + offset);
}

precise float sdfVesica(float3 p, float r, float d, float b) {
    precise float2 q = float2(length(float2(p.x, p.z)), abs(p.y));
    return ((((q.y - b) * d) > (q.x * b)) ? length((q - float2(0.0, b))) : (length((q - float2((-d), 0.0))) - r));
}

precise float sdfExtrudeChamfer2D(float d, float pz, float h, float c) {
    precise float2 w = float2(d, (abs(pz) - h));
    return max(sdfBoxDistance2(w), (((w.x + w.y) + c) * SDF_SQRT_HALF));
}

precise float sdfRoundBox2D(float2 p, float hx, float hy, float r) {
    return (sdfBoxDistance2(float2(((abs(p.x) - hx) + r), ((abs(p.y) - hy) + r))) - r);
}

precise float2 sdfRevolve2D(float3 p, float o) {
    return float2((length(float2(p.x, p.z)) - o), p.y);
}

precise float sdfRoundedRectangle(float3 p, float halfWidth, float halfHeight, float cornerRadius, float capChamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return (sdfExtrudeChamfer2D(sdfRoundBox2D(float2(p.x, p.y), halfWidth, halfHeight, cornerRadius), p.z, liftAmount, capChamfer) - rounding); }
    return (sdfRoundBox2D(sdfRevolve2D(p, liftAmount), halfWidth, halfHeight, cornerRadius) - rounding);
}

precise float sdfRoundCone(float3 p, float lowerRadius, float upperRadius, float height, float b, float a) {
    precise float2 q = float2(length(float2(p.x, p.z)), p.y);
    precise float k = dot(q, float2((-b), a));
    if ((k < 0.0)) { return (length(q) - lowerRadius); }
    if ((k > (a * height))) { return (length((q - float2(0.0, height))) - upperRadius); }
    return (dot(q, float2(a, b)) - lowerRadius);
}

precise float sdfTrapezoid2D(float2 p, float r1, float r2, float he) {
    precise float px = abs(p.x);
    precise float py = p.y;
    precise float2 q = float2(px, py);
    precise float2 k1 = float2(r2, he);
    precise float2 k2 = float2((r2 - r1), (2.0 * he));
    precise float2 ca = float2((px - min(px, ((py < 0.0) ? r1 : r2))), (abs(py) - he));
    precise float2 cb = ((q - k1) + (k2 * (dot(k2, k2) > 0.0 ? saturate(dot((k1 - q), k2) / dot(k2, k2)) : 0.0)));
    precise float m = sqrt(min(dot(ca, ca), dot(cb, cb)));
    return (((cb.x < 0.0) && (ca.y < 0.0)) ? (-m) : m);
}

precise float sdfTrapezoid(float3 p, float bottomHalfWidth, float topHalfWidth, float halfHeight, float capChamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return (sdfExtrudeChamfer2D(sdfTrapezoid2D(float2(p.x, p.y), bottomHalfWidth, topHalfWidth, halfHeight), p.z, liftAmount, capChamfer) - rounding); }
    return (sdfTrapezoid2D(sdfRevolve2D(p, liftAmount), bottomHalfWidth, topHalfWidth, halfHeight) - rounding);
}

precise float sdfEllipse(float3 p, float semiX, float semiY, float capChamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return (sdfExtrudeChamfer2D(sdfEllipse2D(float2(p.x, p.y), float2(semiX, semiY)), p.z, liftAmount, capChamfer) - rounding); }
    return (sdfEllipse2D(sdfRevolve2D(p, liftAmount), float2(semiX, semiY)) - rounding);
}

precise float sdfChamferBox2D(float2 p, float hx, float hy, float c) {
    precise float2 q = float2((abs(p.x) - hx), (abs(p.y) - hy));
    return max(sdfBoxDistance2(q), (((q.x + q.y) + c) * SDF_SQRT_HALF));
}

precise float sdfChamferedRectangle(float3 p, float halfWidth, float halfHeight, float chamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return (sdfExtrudeChamfer2D(sdfChamferBox2D(float2(p.x, p.y), halfWidth, halfHeight, chamfer), p.z, liftAmount, chamfer) - rounding); }
    return (sdfChamferBox2D(sdfRevolve2D(p, liftAmount), halfWidth, halfHeight, chamfer) - rounding);
}

precise float sdfClampSuperellipsoidNorm(float approximate, float norm, float exponent) {
    return clamp(((asuint(approximate) & 0x7F800000u) == 0x7F800000u ? norm : approximate), ((1.0 - (0.28 * (exponent - 2.0))) * norm), norm);
}

precise float sdfSuperellipsoid(float3 p, float3 radii, float3 inverseRadii, float exponent) {
    precise float minRadius = min(radii.x, min(radii.y, radii.z));
    precise float3 absolute = abs(p);
    precise float3 q = float3((absolute.x * (minRadius * inverseRadii.x)), (absolute.y * (minRadius * inverseRadii.y)), (absolute.z * (minRadius * inverseRadii.z)));
    if ((exponent == 2.0)) { return (length(q) - minRadius); }
    precise float m = max(q.x, max(q.y, q.z));
    if ((m <= 0.0)) { return (-minRadius); }
    precise float ux = pow((q.x / m), exponent);
    precise float uy = pow((q.y / m), exponent);
    precise float uz = pow((q.z / m), exponent);
    precise float norm = (m * pow(((ux + uy) + uz), (1.0 / exponent)));
    if (((2.0 < exponent) && (exponent <= 3.0))) { return (sdfClampSuperellipsoidNorm(norm, length(q), exponent) - minRadius); }
    return (norm - minRadius);
}
