// Generated by `puck shaders generate` from the field catalogues.
SdfDual sdfBlendUnion(SdfDual current, SdfDual candidate) {
    return sdfdMin(current, candidate);
}

SdfDual sdfBlendSmoothMinimum(SdfDual a, SdfDual b, float k) {
    SdfDual h = sdfdClamp(sdfdAdd(0.5, sdfdDivide(sdfdMultiply(0.5, sdfdSubtract(b, a)), k)), 0.0, 1.0);
    if ((h.v <= 0.0)) { return b; }
    if ((h.v >= 1.0)) { return a; }
    return sdfdSubtract(sdfdLerp(a, b, sdfdSubtract(1.0, h)), sdfdMultiply(sdfdMultiply(k, h), sdfdSubtract(1.0, h)));
}

SdfDual sdfBlendSmoothUnion(SdfDual current, SdfDual candidate, float smoothRadius) {
    float k = max(smoothRadius, SDF_SMOOTH_RADIUS_MIN);
    return sdfBlendSmoothMinimum(current, candidate, k);
}

SdfDual sdfBlendSubtraction(SdfDual current, SdfDual candidate) {
    return sdfdMax(current, sdfdNegate(candidate));
}

SdfDual sdfBlendIntersection(SdfDual current, SdfDual candidate) {
    return sdfdMax(current, candidate);
}

SdfDual sdfBlendXor(SdfDual current, SdfDual candidate) {
    return sdfdMax(sdfdMin(current, candidate), sdfdNegate(sdfdMax(current, candidate)));
}

SdfDual sdfBlendSmoothIntersection(SdfDual current, SdfDual candidate, float smoothRadius) {
    float k = max(smoothRadius, SDF_SMOOTH_RADIUS_MIN);
    return sdfdNegate(sdfBlendSmoothMinimum(sdfdNegate(current), sdfdNegate(candidate), k));
}

SdfDual sdfBlendSmoothSubtraction(SdfDual current, SdfDual candidate, float smoothRadius) {
    float k = max(smoothRadius, SDF_SMOOTH_RADIUS_MIN);
    return sdfdNegate(sdfBlendSmoothMinimum(candidate, sdfdNegate(current), k));
}

SdfDual sdfBlendChamferUnion(SdfDual current, SdfDual candidate, float smoothRadius) {
    float chamfer = max(smoothRadius, 0.0);
    return sdfdMin(sdfdMin(current, candidate), sdfdMultiply(sdfdSubtract(sdfdAdd(current, candidate), chamfer), SDF_SQRT_HALF));
}

SdfDual sdfBlendChamferIntersection(SdfDual current, SdfDual candidate, float smoothRadius) {
    float chamfer = max(smoothRadius, 0.0);
    return sdfdMax(sdfdMax(current, candidate), sdfdMultiply(sdfdAdd(sdfdAdd(current, candidate), chamfer), SDF_SQRT_HALF));
}

SdfDual sdfBlendChamferSubtraction(SdfDual current, SdfDual candidate, float smoothRadius) {
    float chamfer = max(smoothRadius, 0.0);
    return sdfdMax(sdfdMax(current, sdfdNegate(candidate)), sdfdMultiply(sdfdAdd(sdfdSubtract(current, candidate), chamfer), SDF_SQRT_HALF));
}

SdfDual sdfBlendGrooveUnion(SdfDual current, SdfDual candidate, float smoothRadius) {
    float chamfer = max(smoothRadius, 0.0);
    return sdfdMax(sdfdMin(current, candidate), sdfdSubtract(chamfer, sdfdLength(sdfdVec2(current, candidate))));
}

SdfDual sdfBlendPipeUnion(SdfDual current, SdfDual candidate, float smoothRadius) {
    float chamfer = max(smoothRadius, 0.0);
    return sdfdMin(sdfdMin(current, candidate), sdfdSubtract(sdfdLength(sdfdVec2(current, candidate)), chamfer));
}

SdfDual sdfBlendMorph(SdfDual current, SdfDual candidate, float weight) {
    return sdfdAdd(sdfdMultiply((1.0 - weight), current), sdfdMultiply(weight, candidate));
}

SdfDual sdfBlendGrooveSubtraction(SdfDual current, SdfDual candidate, float smoothRadius) {
    float chamfer = max(smoothRadius, 0.0);
    return sdfdMax(sdfdMax(current, sdfdNegate(candidate)), sdfdSubtract(chamfer, sdfdLength(sdfdVec2(current, candidate))));
}

SdfDual sdfBlendPipeSubtraction(SdfDual current, SdfDual candidate, float smoothRadius) {
    float chamfer = max(smoothRadius, 0.0);
    return sdfdMin(sdfdMax(current, sdfdNegate(candidate)), sdfdSubtract(sdfdLength(sdfdVec2(current, candidate)), chamfer));
}

SdfDual sdfBlendStairsUnion(SdfDual current, SdfDual candidate, float smoothRadius, float steps) {
    if ((steps < 1.0)) { return sdfdMin(current, candidate); }
    if ((smoothRadius <= 0.0)) { return sdfdMin(current, candidate); }
    float s = (smoothRadius / steps);
    float period = (s * 2.0);
    SdfDual u = sdfdSubtract(candidate, smoothRadius);
    SdfDual arg = sdfdAdd(sdfdSubtract(u, current), s);
    SdfDual m = sdfdSubtract(arg, (period * floor(sdfdDivide(arg, period).v)));
    SdfDual stairs = sdfdMultiply(0.5, sdfdAdd(sdfdAdd(u, current), sdfdAbs(sdfdSubtract(m, s))));
    return sdfdMin(sdfdMin(current, candidate), stairs);
}

SdfDual sdfBlendStairsSubtraction(SdfDual current, SdfDual candidate, float smoothRadius, float steps) {
    if ((steps < 1.0)) { return sdfdMax(current, sdfdNegate(candidate)); }
    if ((smoothRadius <= 0.0)) { return sdfdMax(current, sdfdNegate(candidate)); }
    float s = (smoothRadius / steps);
    float period = (s * 2.0);
    SdfDual u = sdfdSubtract(sdfdNegate(candidate), smoothRadius);
    SdfDual arg = sdfdAdd(sdfdSubtract(u, current), s);
    SdfDual m = sdfdSubtract(arg, (period * floor(sdfdDivide(arg, period).v)));
    SdfDual stairs = sdfdMultiply(0.5, sdfdAdd(sdfdAdd(u, current), sdfdAbs(sdfdSubtract(m, s))));
    return sdfdMax(sdfdMax(current, sdfdNegate(candidate)), sdfdNegate(stairs));
}
