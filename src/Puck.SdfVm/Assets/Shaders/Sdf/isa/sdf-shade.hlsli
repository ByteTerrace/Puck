        case SDF_SHADE_ACOS: switch (signature) {
            case 1u: { precise float result = sdfShade_Acos_1(slice, stamp, op.w, asfloat(a).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 2u: { precise float2 result = sdfShade_Acos_2(slice, stamp, op.w, asfloat(a).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 3u: { precise float3 result = sdfShade_Acos_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u); break; }
            case 4u: { precise float4 result = sdfShade_Acos_4(slice, stamp, op.w, asfloat(a).xyzw); value = asuint(result); break; }
        } break;
        case SDF_SHADE_ATAN: switch (signature) {
            case 1u: { precise float result = sdfShade_Atan_1(slice, stamp, op.w, asfloat(a).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 2u: { precise float2 result = sdfShade_Atan_2(slice, stamp, op.w, asfloat(a).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 3u: { precise float3 result = sdfShade_Atan_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u); break; }
            case 4u: { precise float4 result = sdfShade_Atan_4(slice, stamp, op.w, asfloat(a).xyzw); value = asuint(result); break; }
        } break;
        case SDF_SHADE_SQRT: switch (signature) {
            case 1u: { precise float result = sdfShade_Sqrt_1(slice, stamp, op.w, asfloat(a).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 2u: { precise float2 result = sdfShade_Sqrt_2(slice, stamp, op.w, asfloat(a).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 3u: { precise float3 result = sdfShade_Sqrt_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u); break; }
            case 4u: { precise float4 result = sdfShade_Sqrt_4(slice, stamp, op.w, asfloat(a).xyzw); value = asuint(result); break; }
        } break;
        case SDF_SHADE_DOT: switch (signature) {
            case 17u: { precise float result = sdfShade_Dot_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 34u: { precise float result = sdfShade_Dot_34(slice, stamp, op.w, asfloat(a).xy, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 51u: { precise float result = sdfShade_Dot_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 68u: { precise float result = sdfShade_Dot_68(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).xyzw); value = uint4(asuint(result), 0u, 0u, 0u); break; }
        } break;
        case SDF_SHADE_CROSS: switch (signature) {
            case 51u: { precise float3 result = sdfShade_Cross_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_NORMALIZE: switch (signature) {
            case 1u: { precise float result = sdfShade_Normalize_1(slice, stamp, op.w, asfloat(a).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 2u: { precise float2 result = sdfShade_Normalize_2(slice, stamp, op.w, asfloat(a).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 3u: { precise float3 result = sdfShade_Normalize_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u); break; }
            case 4u: { precise float4 result = sdfShade_Normalize_4(slice, stamp, op.w, asfloat(a).xyzw); value = asuint(result); break; }
        } break;
        case SDF_SHADE_LENGTH: switch (signature) {
            case 1u: { precise float result = sdfShade_Length_1(slice, stamp, op.w, asfloat(a).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 2u: { precise float result = sdfShade_Length_2(slice, stamp, op.w, asfloat(a).xy); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 3u: { precise float result = sdfShade_Length_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 4u: { precise float result = sdfShade_Length_4(slice, stamp, op.w, asfloat(a).xyzw); value = uint4(asuint(result), 0u, 0u, 0u); break; }
        } break;
        case SDF_SHADE_ROTATE: switch (signature) {
            case 67u: { precise float3 result = sdfShade_Rotate_67(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyzw); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_INVERSEROTATE: switch (signature) {
            case 67u: { precise float3 result = sdfShade_InverseRotate_67(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyzw); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_QUANTIZE: switch (signature) {
            case 1u: { precise uint result = sdfShade_Quantize_1(slice, stamp, op.w, asfloat(a).x); value = uint4(result, 0u, 0u, 0u); break; }
            case 3u: { precise uint3 result = sdfShade_Quantize_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(result, 0u); break; }
        } break;
        case SDF_SHADE_HASH: switch (signature) {
            case 7u: { precise uint3 result = sdfShade_Hash_7(slice, stamp, op.w, a.xyz); value = uint4(result, 0u); break; }
        } break;
        case SDF_SHADE_LATTICE: switch (signature) {
            case 83u: { precise float result = sdfShade_Lattice_83(slice, stamp, op.w, asfloat(a).xyz, b.x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
        } break;
        case SDF_SHADE_LATTICEGRADIENT: switch (signature) {
            case 83u: { precise float4 result = sdfShade_LatticeGradient_83(slice, stamp, op.w, asfloat(a).xyz, b.x); value = asuint(result); break; }
        } break;
        case SDF_SHADE_LINES: switch (signature) {
            case 338u: { precise float result = sdfShade_Lines_338(slice, stamp, op.w, asfloat(a).xy, b.x, asfloat(c).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
        } break;
        case SDF_SHADE_REFLECT: switch (signature) {
            case 51u: { precise float3 result = sdfShade_Reflect_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_REFRACT: switch (signature) {
            case 307u: { precise float3 result = sdfShade_Refract_307(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz, asfloat(c).x); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_TILT: switch (signature) {
            case 307u: { precise float3 result = sdfShade_Tilt_307(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz, asfloat(c).x); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_TOLAYER: switch (signature) {
            case 3u: { precise float3 result = sdfShade_ToLayer_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_TOWORLD: switch (signature) {
            case 3u: { precise float3 result = sdfShade_ToWorld_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_DRAWDIRECTION: switch (signature) {
            case 3u: { precise float3 result = sdfShade_DrawDirection_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_SHAPE: switch (signature) {
            case 3u: { precise float result = sdfShade_Shape_3(slice, stamp, op.w, asfloat(a).xyz); value = uint4(asuint(result), 0u, 0u, 0u); break; }
        } break;
        case SDF_SHADE_XOR: switch (signature) {
            case 85u: { precise uint result = sdfShade_Xor_85(slice, stamp, op.w, a.x, b.x); value = uint4(result, 0u, 0u, 0u); break; }
        } break;
        case SDF_SHADE_ATAN2: switch (signature) {
            case 17u: { precise float result = sdfShade_Atan2_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 33u: { precise float2 result = sdfShade_Atan2_33(slice, stamp, op.w, asfloat(a).x, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 49u: { precise float3 result = sdfShade_Atan2_49(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 65u: { precise float4 result = sdfShade_Atan2_65(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyzw); value = asuint(result); break; }
            case 18u: { precise float2 result = sdfShade_Atan2_18(slice, stamp, op.w, asfloat(a).xy, asfloat(b).x); value = uint4(asuint(result), 0u, 0u); break; }
            case 34u: { precise float2 result = sdfShade_Atan2_34(slice, stamp, op.w, asfloat(a).xy, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 19u: { precise float3 result = sdfShade_Atan2_19(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).x); value = uint4(asuint(result), 0u); break; }
            case 51u: { precise float3 result = sdfShade_Atan2_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 20u: { precise float4 result = sdfShade_Atan2_20(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).x); value = asuint(result); break; }
            case 68u: { precise float4 result = sdfShade_Atan2_68(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).xyzw); value = asuint(result); break; }
        } break;
        }
        sdfShadeWriteRegister(regs, op.y, value);
        sdfShadeWriteOutputs(outputs, op.z >> 8u, value);
        sdfWorkSteps++;
    }
}
uint sdfShadeArm(uint2 slice) { return 0u; }
bool sdfShadeHas(SdfShadeBinding binding, uint phase) { return binding.range.y != 0u && sdfShadeRead(binding.range.xy, phase).y != 0u; }
uint sdfShadeReadsOf(SdfShadeBinding binding) { return binding.range.y != 0u ? sdfShadeRead(binding.range.xy, 0u).w : 0u; }
void sdfShadeExecute(SdfShadeBinding binding, uint phase, SdfShadeStamp stamp, out SdfShadeOutputs outputs) {
    sdfShadeInterpret(binding.range.xy, binding.range.zw, phase, stamp, outputs);
}
#else
uint sdfShadeArm(uint2 slice) { return 0u; }
bool sdfShadeHas(SdfShadeBinding binding, uint phase) { return false; }
uint sdfShadeReadsOf(SdfShadeBinding binding) { return 0u; }
void sdfShadeExecute(SdfShadeBinding binding, uint phase, SdfShadeStamp stamp, out SdfShadeOutputs outputs) { outputs = (SdfShadeOutputs)0; }
#endif
SdfShadeBinding sdfShadeBinding(int material) {
    SdfShadeBinding binding = (SdfShadeBinding)0;
#ifndef SDF_SHADE_EMPTY
    uint address;
    if (passGroup.shadePrograms == 0u || !sdfMaterialBase(material, address)) return binding;
    uint4 own = asuint(sdfWords[address + 32u]);
    binding.range = own.y != 0u ? own : passGroup.shadeDefault;
    if (binding.range.y != 0u) binding.arm = sdfShadeArm(binding.range.xy);
#endif
    return binding;
}
bool sdfShadeBound(SdfShadeBinding binding) { return binding.range.y != 0u; }
float3 sdfShadeDiagnostic(int material, int mode) {
    SdfShadeBinding binding = sdfShadeBinding(material);
    if (mode == SDF_DEBUG_VIEW_SHADE_TIER) return sdfShadeBound(binding) ? (binding.arm != 0u ? float3(0.0, 1.0, 0.2) : float3(0.0, 0.8, 1.0)) : 0.15;
    float work = float(sdfShadeRead(binding.range.xy, 0u).z + sdfShadeRead(binding.range.xy, 1u).z + sdfShadeRead(binding.range.xy, 2u).z) / float(SDF_SHADE_MAX_PHASE_WORK);
    return float3(work, work * work, 0.0);
}
SdfShadeStamp sdfShadeStamp(SdfMaterialData material, float3 position, float3 layerPosition, float3 normal,
    float3 ray, float curvature, float footprint, float4 lanes, float contact, float thickness, float4 rotation, int frameSlot, uint draw) {
    SdfShadeStamp stamp = (SdfShadeStamp)0;
    stamp.layerRotation = rotation;
    uint record = sdfMeshRecord(draw);
    stamp.drawDirection = frameSlot != SDF_TRANSFORM_SLOT_NONE ? float3x3(1,0,0,0,1,0,0,0,1) : transpose(float3x3(
        sdfMeshCarryDirection(record, sdfMeshWorldDirection(record, float3(1,0,0))),
        sdfMeshCarryDirection(record, sdfMeshWorldDirection(record, float3(0,1,0))),
        sdfMeshCarryDirection(record, sdfMeshWorldDirection(record, float3(0,0,1)))));
    sdfShadeSet_surface_position(stamp, position);
    sdfShadeSet_surface_layerPosition(stamp, layerPosition);
    sdfShadeSet_surface_geometricNormal(stamp, normal);
    sdfShadeSet_surface_normal(stamp, normal);
    sdfShadeSet_surface_curvature(stamp, curvature);
    sdfShadeSet_surface_footprint(stamp, footprint);
    sdfShadeSet_surface_rayDirection(stamp, ray);
    sdfShadeSet_surface_contact(stamp, contact);
    sdfShadeSet_surface_thickness(stamp, thickness);
    sdfShadeSet_clock(stamp, passGroup.flowClock);
    sdfShadeSet_material_albedo(stamp, material.albedo);
    sdfShadeSet_material_roughness(stamp, material.roughness);
    sdfShadeSet_material_metal(stamp, material.metal);
    sdfShadeSet_material_specular(stamp, material.specular);
    sdfShadeSet_material_coat(stamp, material.coat);
    sdfShadeSet_material_sheen(stamp, material.sheen);
    sdfShadeSet_material_wrap(stamp, material.wrap);
    sdfShadeSet_material_fill(stamp, material.fill);
    sdfShadeSet_material_emissive(stamp, material.emissive);
    sdfShadeSet_lanes_slot0(stamp, sdfLane(lanes, 0u));
    sdfShadeSet_lanes_slot1(stamp, sdfLane(lanes, 1u));
    sdfShadeSet_lanes_slot2(stamp, sdfLane(lanes, 2u));
    sdfShadeSet_lanes_slot3(stamp, sdfLane(lanes, 3u));
    sdfShadeSet_lanes_world0(stamp, sdfLane(lanes, 4u));
    sdfShadeSet_lanes_world1(stamp, sdfLane(lanes, 5u));
    sdfShadeSet_lanes_world2(stamp, sdfLane(lanes, 6u));
    sdfShadeSet_lanes_world3(stamp, sdfLane(lanes, 7u));
    return stamp;
}
void sdfShadeSurfaceInputs(inout SdfShadeStamp stamp, SdfMaterialData material, float3 normal, float reveal) {
    sdfShadeSet_surface_normal(stamp, normal);
    sdfShadeSet_surface_albedo(stamp, material.albedo);
    sdfShadeSet_surface_roughness(stamp, material.roughness);
    sdfShadeSet_surface_metal(stamp, material.metal);
    sdfShadeSet_surface_specular(stamp, material.specular);
    sdfShadeSet_surface_coat(stamp, material.coat);
    sdfShadeSet_surface_sheen(stamp, material.sheen);
    sdfShadeSet_surface_wrap(stamp, material.wrap);
    sdfShadeSet_surface_fill(stamp, material.fill);
    sdfShadeSet_surface_emissive(stamp, material.emissive);
    sdfShadeSet_surface_reveal(stamp, reveal);
}
float sdfShadeUnit(uint4 value, float fallback) { return sdfShadeSanitize(asfloat(value), fallback.xxxx, 0.0, 1.0).x; }
float3 sdfShadeColor(uint4 value, float3 fallback) { return sdfShadeSanitize(asfloat(value), float4(fallback,0), 0.0, 3.402823466e+38).xyz; }
void sdfShadeSurfacePhase(SdfShadeBinding binding, inout SdfShadeStamp stamp, inout SdfMaterialData material, inout float3 normal, out float reveal) {
    reveal = 0.0;
    if (sdfShadeHas(binding, 0u)) {
        SdfShadeOutputs o;
        sdfShadeExecute(binding, 0u, stamp, o);
        if ((o.assigned & 1u) != 0u) material.albedo = sdfShadeColor(o.o0, material.albedo);
        if ((o.assigned & 2u) != 0u) material.roughness = sdfShadeUnit(o.o1, material.roughness);
        if ((o.assigned & 4u) != 0u) material.metal = sdfShadeUnit(o.o2, material.metal);
        if ((o.assigned & 8u) != 0u) material.specular = sdfShadeColor(o.o3, material.specular.xxx).x;
        if ((o.assigned & 16u) != 0u) material.coat = sdfShadeUnit(o.o4, material.coat);
        if ((o.assigned & 32u) != 0u) material.sheen = sdfShadeUnit(o.o5, material.sheen);
        if ((o.assigned & 64u) != 0u) material.wrap = sdfShadeUnit(o.o6, material.wrap);
        if ((o.assigned & 128u) != 0u) material.fill = sdfShadeColor(o.o7, material.fill);
        if ((o.assigned & 256u) != 0u) material.emissive = sdfShadeColor(o.o8, material.emissive.xxx).x;
        if ((o.assigned & 512u) != 0u) normal = sdfShadeSanitizeNormal(asfloat(o.o9).xyz, normal);
        if ((o.assigned & 1024u) != 0u) reveal = sdfShadeUnit(o.o10, 0.0);
    }
    sdfShadeSurfaceInputs(stamp, material, normal, reveal);
}
SdfLightResponse sdfShadeLightPhase(SdfShadeBinding binding, SdfShadeStamp stamp, SdfLightSource light, SdfShadeSurface surface) {
    bool authored = sdfShadeHas(binding, 1u);
    SdfLightInputs inputs = sdfLightInputs(light, surface, authored);
    SdfLightResponse response = sdfLightResponse(light, surface, inputs);
    if (!authored) return response;
    sdfShadeSet_light_direction(stamp, inputs.direction);
    sdfShadeSet_light_position(stamp, light.position);
    sdfShadeSet_light_color(stamp, light.color);
    sdfShadeSet_light_weight(stamp, light.weight);
    sdfShadeSet_light_kind(stamp, light.kind);
    sdfShadeSet_light_reach(stamp, inputs.reach);
    sdfShadeSet_light_visibility(stamp, inputs.visibility);
    sdfShadeSet_light_occlusion(stamp, surface.ambientOcclusion);
    sdfShadeSet_light_probeShare(stamp, inputs.probeShare);
    sdfShadeSet_light_cosine(stamp, dot(surface.normal, inputs.direction));
    SdfShadeOutputs o;
    sdfShadeExecute(binding, 1u, stamp, o);
    if ((o.assigned & 1u) != 0u) response.diffuse = sdfShadeColor(o.o0, response.diffuse);
    if ((o.assigned & 2u) != 0u) response.rim = sdfShadeColor(o.o1, response.rim);
    if ((o.assigned & 4u) != 0u) response.specular = sdfShadeColor(o.o2, response.specular);
    if ((o.assigned & 8u) != 0u) response.attenuation = sdfShadeUnit(o.o3, response.attenuation);
    return response;
}
float3 sdfShadeComposePhase(SdfShadeBinding binding, SdfShadeStamp stamp, float3 radiance, float3 rim, float3 specular,
    float attenuation, float3 indirect, float3 reflection, float3 environment, float adaptation, float3 fallback) {
    if (!sdfShadeHas(binding, 2u)) return fallback;
    sdfShadeSet_compose_radiance(stamp, radiance);
    sdfShadeSet_compose_rim(stamp, rim);
    sdfShadeSet_compose_specular(stamp, specular);
    sdfShadeSet_compose_attenuation(stamp, attenuation);
    sdfShadeSet_compose_indirect(stamp, indirect);
    sdfShadeSet_compose_reflection(stamp, reflection);
    sdfShadeSet_compose_environment(stamp, environment);
    sdfShadeSet_compose_adaptation(stamp, adaptation);
    sdfShadeSet_compose_exposure(stamp, passGroup.exposure);
    SdfShadeOutputs o;
    sdfShadeExecute(binding, 2u, stamp, o);
    return (o.assigned & 1u) != 0u ? sdfShadeColor(o.o0, fallback) : fallback;
}
#endif
