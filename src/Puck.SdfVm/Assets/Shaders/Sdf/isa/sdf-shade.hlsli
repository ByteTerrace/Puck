#ifndef SDF_SHADE_EMPTY

void sdfShadeInterpret(uint2 slice, uint2 parameters, uint phase, SdfShadeStamp stamp, out SdfShadeOutputs outputs) {
    SdfShadeRegisters regs = (SdfShadeRegisters)0;
    outputs = (SdfShadeOutputs)0;
    if (phase >= 3u) return;
    uint4 header = sdfShadeRead(slice, phase);
    uint count = min(header.y, SDF_SHADE_MAX_OPS);
    if (header.x > slice.y || count > (slice.y - header.x) / 3u) return;
    [loop] for (uint i = 0u; i < count; i++) {
        uint offset = header.x + i * 3u;
        uint4 op = sdfShadeRead(slice, offset);
        uint4 indices = sdfShadeRead(slice, offset + 1u);
        uint4 types = sdfShadeRead(slice, offset + 2u);
        indices &= SDF_SHADE_MAX_REGISTERS - 1u;
        op.y &= SDF_SHADE_MAX_REGISTERS - 1u;
        uint4 a = sdfShadeRegister(regs, indices.x), b = sdfShadeRegister(regs, indices.y);
        uint4 c = sdfShadeRegister(regs, indices.z), d = sdfShadeRegister(regs, indices.w);
        uint signature = types.x | (types.y << 4u) | (types.z << 8u) | (types.w << 12u);
        uint4 value = 0u;
        switch (op.x) {
        case SDF_SHADE_CONSTANT: value = sdfShadeRead(slice, op.w); break;
        case SDF_SHADE_PARAMETER: value = sdfShadeRead(parameters, op.w); break;
        case SDF_SHADE_INPUT: value = sdfShadeInput(stamp, op.w); break;
        case SDF_SHADE_COMPONENT: value.x = op.w == 0u ? a.x : op.w == 1u ? a.y : op.w == 2u ? a.z : op.w == 3u ? a.w : 0u; break;
        case SDF_SHADE_VECTOR2: switch (signature) {
            case 17u: { precise float2 result = sdfShade_Vector2_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u); break; }
        } break;
        case SDF_SHADE_VECTOR3: switch (signature) {
            case 273u: { precise float3 result = sdfShade_Vector3_273(slice, stamp, op.w, asfloat(a).x, asfloat(b).x, asfloat(c).x); value = uint4(asuint(result), 0u); break; }
        } break;
        case SDF_SHADE_VECTOR4: switch (signature) {
            case 4369u: { precise float4 result = sdfShade_Vector4_4369(slice, stamp, op.w, asfloat(a).x, asfloat(b).x, asfloat(c).x, asfloat(d).x); value = asuint(result); break; }
        } break;
        case SDF_SHADE_ADD: switch (signature) {
            case 17u: { precise float result = sdfShade_Add_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 33u: { precise float2 result = sdfShade_Add_33(slice, stamp, op.w, asfloat(a).x, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 49u: { precise float3 result = sdfShade_Add_49(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 65u: { precise float4 result = sdfShade_Add_65(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyzw); value = asuint(result); break; }
            case 18u: { precise float2 result = sdfShade_Add_18(slice, stamp, op.w, asfloat(a).xy, asfloat(b).x); value = uint4(asuint(result), 0u, 0u); break; }
            case 34u: { precise float2 result = sdfShade_Add_34(slice, stamp, op.w, asfloat(a).xy, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 19u: { precise float3 result = sdfShade_Add_19(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).x); value = uint4(asuint(result), 0u); break; }
            case 51u: { precise float3 result = sdfShade_Add_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 20u: { precise float4 result = sdfShade_Add_20(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).x); value = asuint(result); break; }
            case 68u: { precise float4 result = sdfShade_Add_68(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).xyzw); value = asuint(result); break; }
            case 85u: { precise uint result = sdfShade_Add_85(slice, stamp, op.w, a.x, b.x); value = uint4(result, 0u, 0u, 0u); break; }
        } break;
        case SDF_SHADE_SUBTRACT: switch (signature) {
            case 17u: { precise float result = sdfShade_Subtract_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 33u: { precise float2 result = sdfShade_Subtract_33(slice, stamp, op.w, asfloat(a).x, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 49u: { precise float3 result = sdfShade_Subtract_49(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 65u: { precise float4 result = sdfShade_Subtract_65(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyzw); value = asuint(result); break; }
            case 18u: { precise float2 result = sdfShade_Subtract_18(slice, stamp, op.w, asfloat(a).xy, asfloat(b).x); value = uint4(asuint(result), 0u, 0u); break; }
            case 34u: { precise float2 result = sdfShade_Subtract_34(slice, stamp, op.w, asfloat(a).xy, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 19u: { precise float3 result = sdfShade_Subtract_19(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).x); value = uint4(asuint(result), 0u); break; }
            case 51u: { precise float3 result = sdfShade_Subtract_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 20u: { precise float4 result = sdfShade_Subtract_20(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).x); value = asuint(result); break; }
            case 68u: { precise float4 result = sdfShade_Subtract_68(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).xyzw); value = asuint(result); break; }
        } break;
        case SDF_SHADE_MULTIPLY: switch (signature) {
            case 17u: { precise float result = sdfShade_Multiply_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 33u: { precise float2 result = sdfShade_Multiply_33(slice, stamp, op.w, asfloat(a).x, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 49u: { precise float3 result = sdfShade_Multiply_49(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 65u: { precise float4 result = sdfShade_Multiply_65(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyzw); value = asuint(result); break; }
            case 18u: { precise float2 result = sdfShade_Multiply_18(slice, stamp, op.w, asfloat(a).xy, asfloat(b).x); value = uint4(asuint(result), 0u, 0u); break; }
            case 34u: { precise float2 result = sdfShade_Multiply_34(slice, stamp, op.w, asfloat(a).xy, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 19u: { precise float3 result = sdfShade_Multiply_19(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).x); value = uint4(asuint(result), 0u); break; }
            case 51u: { precise float3 result = sdfShade_Multiply_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 20u: { precise float4 result = sdfShade_Multiply_20(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).x); value = asuint(result); break; }
            case 68u: { precise float4 result = sdfShade_Multiply_68(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).xyzw); value = asuint(result); break; }
        } break;
        case SDF_SHADE_DIVIDE: switch (signature) {
            case 17u: { precise float result = sdfShade_Divide_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 33u: { precise float2 result = sdfShade_Divide_33(slice, stamp, op.w, asfloat(a).x, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 49u: { precise float3 result = sdfShade_Divide_49(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 65u: { precise float4 result = sdfShade_Divide_65(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyzw); value = asuint(result); break; }
            case 18u: { precise float2 result = sdfShade_Divide_18(slice, stamp, op.w, asfloat(a).xy, asfloat(b).x); value = uint4(asuint(result), 0u, 0u); break; }
            case 34u: { precise float2 result = sdfShade_Divide_34(slice, stamp, op.w, asfloat(a).xy, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 19u: { precise float3 result = sdfShade_Divide_19(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).x); value = uint4(asuint(result), 0u); break; }
            case 51u: { precise float3 result = sdfShade_Divide_51(slice, stamp, op.w, asfloat(a).xyz, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 20u: { precise float4 result = sdfShade_Divide_20(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).x); value = asuint(result); break; }
            case 68u: { precise float4 result = sdfShade_Divide_68(slice, stamp, op.w, asfloat(a).xyzw, asfloat(b).xyzw); value = asuint(result); break; }
        } break;
        case SDF_SHADE_MIN: switch (signature) {
            case 17u: { precise float result = sdfShade_Min_17(slice, stamp, op.w, asfloat(a).x, asfloat(b).x); value = uint4(asuint(result), 0u, 0u, 0u); break; }
            case 33u: { precise float2 result = sdfShade_Min_33(slice, stamp, op.w, asfloat(a).x, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
            case 49u: { precise float3 result = sdfShade_Min_49(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyz); value = uint4(asuint(result), 0u); break; }
            case 65u: { precise float4 result = sdfShade_Min_65(slice, stamp, op.w, asfloat(a).x, asfloat(b).xyzw); value = asuint(result); break; }
            case 18u: { precise float2 result = sdfShade_Min_18(slice, stamp, op.w, asfloat(a).xy, asfloat(b).x); value = uint4(asuint(result), 0u, 0u); break; }
            case 34u: { precise float2 result = sdfShade_Min_34(slice, stamp, op.w, asfloat(a).xy, asfloat(b).xy); value = uint4(asuint(result), 0u, 0u); break; }
