// Generated by `puck shaders generate` from the field catalogues.
case SDF_RELIEF_ROW_KIND_BAND:
{
    if (open) {
        weight *= sdfReliefBandWeight(band, distance);
        if (weight <= 0.0) { return 0.0; }
    }
    band = rowData0;
    distance = SDF_FAR_DISTANCE;
    open = true;
    break;
}
case SDF_RELIEF_ROW_KIND_POSE:
{
    origin = rowData0.xyz;
    turn = rowData1;
    break;
}
case SDF_RELIEF_ROW_KIND_PRIMITIVE:
{
    if (distance > band.x) {
        float3 u = rotatePointByInverseQuaternion((q - origin), turn);
        distance = min(distance, sdfReliefRegionDistance(SDF_INSTRUCTION_SHAPE(header), u, rowData0, rowData1));
    }
    break;
}
