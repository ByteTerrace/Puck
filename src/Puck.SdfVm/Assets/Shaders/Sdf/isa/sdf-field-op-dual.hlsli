// Generated by `puck shaders generate` from the field catalogues.
SdfDual3 sdfTranslatePoint(SdfDual3 p, float3 translation) {
    return sdfdSubtract(p, translation);
}

SdfDual3 sdfRotatePoint(SdfDual3 p, float4 rotation) {
    return sdfdRotateInverse(p, rotation);
}

SdfDual3 sdfScalePoint(SdfDual3 p, float3 scale) {
    return sdfdDivideComponents(p, scale);
}

SdfDual3 sdfElongatePoint(SdfDual3 p, float3 extents) {
    return sdfdSubtract(p, sdfdClamp(p, (-extents), extents));
}

SdfDual3 sdfRepeatPoint(SdfDual3 p, float3 spacing, float3 inverseSpacing) {
    return sdfdSubtract(p, (spacing * round(sdfdMultiplyComponents(p, inverseSpacing).v)));
}

SdfDual3 sdfRepeatLimitedPoint(SdfDual3 p, float3 spacing, float3 limit) {
    return sdfdSubtract(p, (spacing * clamp(round(sdfdDivideComponents(p, spacing).v), (-limit), limit)));
}

SdfDual sdfOnionField(SdfDual distance, float thickness) {
    return sdfdSubtract(sdfdAbs(distance), thickness);
}

SdfDual sdfDilateField(SdfDual distance, float amount) {
    return sdfdSubtract(distance, amount);
}

SdfDual3 sdfSymmetryPlanePoint(SdfDual3 p, float3 normal, float offset) {
    SdfDual side = sdfdAdd(sdfdDot(p, normal), offset);
    return sdfdSubtract(p, sdfdMultiply(normal, sdfdMultiply(sdfdMin(side, 0.0), 2.0)));
}

SdfDual sdfReliefField(SdfDual distance, SdfDual3 p, float weight, float frequency, float amplitude, float gain, float lacunarity, float normalizer, uint seed, uint octaves) {
    if ((weight == 0.0)) { return distance; }
    SdfDual relief = sdfdMultiply((amplitude * normalizer), sdfFbm3(sdfdMultiply(p, frequency), seed, octaves, gain, lacunarity));
    return sdfdAdd(distance, sdfdMultiply(relief, weight));
}

SdfDual sdfCellDisplaceField(SdfDual distance, SdfDual3 p, float frequency, float amplitude, float jitter, uint seed, uint mode) {
    return sdfdAdd(distance, sdfdMultiply(amplitude, sdfdSubtract(sdfCellDistance(sdfdMultiply(p, frequency), seed, mode, jitter), 0.5)));
}
