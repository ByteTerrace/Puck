// Generated by `puck shaders generate` from the field catalogues.
case SDF_OP_TRANSLATE:
{
    p -= data0.xyz;
    break;
}
case SDF_OP_ROTATE:
{
    p = rotatePointByInverseQuaternion(p, data0);
    break;
}
case SDF_OP_SCALE:
{
    break;
}
case SDF_OP_REPEAT:
{
    p -= (data0.xyz * round(p * data1.xyz));
    break;
}
case SDF_OP_REPEAT_LIMITED:
{
    p -= (data0.xyz * clamp(round(p / data0.xyz), -data1.xyz, data1.xyz));
    break;
}
case SDF_OP_SYMMETRY_PLANE:
{
    float t = (dot(p, data0.xyz) + data0.w);
    p -= ((2.0 * min(t, 0.0)) * data0.xyz);
    break;
}
