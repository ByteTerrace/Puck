// Generated by `puck shaders generate` from the field catalogues.
// The caller bounds index against the validated instruction count.
uint4 sdfFieldHeader(uint index) {
    return sdfWords[SDF_PROGRAM_HEADER_VECTORS + index];
}
float4 sdfFieldData(uint dataOffset, uint index, uint row) {
    return asfloat(sdfWords[dataOffset + (SDF_INSTRUCTION_DATA_VECTORS * index) + row]);
}
#define SDF_VM_LOAD_DATA0 float4 data0 = sdfFieldData(dataOffset, index, 0u)
#define SDF_VM_LOAD_DATA1 float4 data1 = sdfFieldData(dataOffset, index, 1u)
