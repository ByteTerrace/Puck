#define SDF_SKY_BLEND_SCREEN 3u

// Puck.SignedDistance.SdfSkyMask.
#define SDF_SKY_MASK_NONE 0u
#define SDF_SKY_MASK_ELEVATION 1u
#define SDF_SKY_MASK_CONE 2u

