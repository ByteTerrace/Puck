// Generated by `puck shaders generate` from the field catalogues.
precise float sdfBlendUnion(float current, float candidate) {
    return min(current, candidate);
}

precise float sdfBlendSmoothMinimum(float a, float b, float k) {
    precise float h = clamp((0.5 + ((0.5 * (b - a)) / k)), 0.0, 1.0);
    if ((h <= 0.0)) { return b; }
    if ((h >= 1.0)) { return a; }
    return (lerp(a, b, (1.0 - h)) - ((k * h) * (1.0 - h)));
}

precise float sdfBlendSmoothUnion(float current, float candidate, float smoothRadius) {
    precise float k = max(smoothRadius, SDF_SMOOTH_RADIUS_MIN);
    return sdfBlendSmoothMinimum(current, candidate, k);
}

precise float sdfBlendSubtraction(float current, float candidate) {
    return max(current, (-candidate));
}

precise float sdfBlendIntersection(float current, float candidate) {
    return max(current, candidate);
}

precise float sdfBlendXor(float current, float candidate) {
    return max(min(current, candidate), (-max(current, candidate)));
}

precise float sdfBlendSmoothIntersection(float current, float candidate, float smoothRadius) {
    precise float k = max(smoothRadius, SDF_SMOOTH_RADIUS_MIN);
    return (-sdfBlendSmoothMinimum((-current), (-candidate), k));
}

precise float sdfBlendSmoothSubtraction(float current, float candidate, float smoothRadius) {
    precise float k = max(smoothRadius, SDF_SMOOTH_RADIUS_MIN);
    return (-sdfBlendSmoothMinimum(candidate, (-current), k));
}

precise float sdfBlendChamferUnion(float current, float candidate, float smoothRadius) {
    precise float chamfer = max(smoothRadius, 0.0);
    return min(min(current, candidate), (((current + candidate) - chamfer) * SDF_SQRT_HALF));
}

precise float sdfBlendChamferIntersection(float current, float candidate, float smoothRadius) {
    precise float chamfer = max(smoothRadius, 0.0);
    return max(max(current, candidate), (((current + candidate) + chamfer) * SDF_SQRT_HALF));
}

precise float sdfBlendChamferSubtraction(float current, float candidate, float smoothRadius) {
    precise float chamfer = max(smoothRadius, 0.0);
    return max(max(current, (-candidate)), (((current - candidate) + chamfer) * SDF_SQRT_HALF));
}

precise float sdfBlendGrooveUnion(float current, float candidate, float smoothRadius) {
    precise float chamfer = max(smoothRadius, 0.0);
    return max(min(current, candidate), (chamfer - length(float2(current, candidate))));
}

precise float sdfBlendPipeUnion(float current, float candidate, float smoothRadius) {
    precise float chamfer = max(smoothRadius, 0.0);
    return min(min(current, candidate), (length(float2(current, candidate)) - chamfer));
}

precise float sdfBlendGrooveSubtraction(float current, float candidate, float smoothRadius) {
    precise float chamfer = max(smoothRadius, 0.0);
    return max(max(current, (-candidate)), (chamfer - length(float2(current, candidate))));
}

precise float sdfBlendPipeSubtraction(float current, float candidate, float smoothRadius) {
    precise float chamfer = max(smoothRadius, 0.0);
    return min(max(current, (-candidate)), (length(float2(current, candidate)) - chamfer));
}
