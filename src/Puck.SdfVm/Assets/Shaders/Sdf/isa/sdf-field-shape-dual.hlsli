// Generated by `puck shaders generate` from the field catalogues.
SdfDual sdfBoxDistance(SdfDual3 q) {
    return sdfdAdd(sdfdLength(sdfdVec3(sdfdMax(sdfdX(q), 0.0), sdfdMax(sdfdY(q), 0.0), sdfdMax(sdfdZ(q), 0.0))), sdfdMin(sdfdMax(sdfdX(q), sdfdMax(sdfdY(q), sdfdZ(q))), 0.0));
}

SdfDual sdfBox(SdfDual3 p, float3 halfExtents, float cornerRadius) {
    SdfDual3 q = sdfdSubtract(sdfdAbs(p), (halfExtents - float3(cornerRadius, cornerRadius, cornerRadius)));
    return sdfdSubtract(sdfBoxDistance(q), cornerRadius);
}

SdfDual sdfCapsule(SdfDual3 p, float3 endpoint, float radius) {
    SdfDual h = sdfdSegmentParameter(p, endpoint);
    return sdfdSubtract(sdfdLength(sdfdSubtract(p, sdfdMultiply(endpoint, h))), radius);
}

SdfDual sdfSphere(SdfDual3 p, float radius) {
    return sdfdSubtract(sdfdLength(p), radius);
}

SdfDual sdfTorus(SdfDual3 p, float major, float minor) {
    return sdfdSubtract(sdfdLength(sdfdVec2(sdfdSubtract(sdfdLength(sdfdVec2(sdfdX(p), sdfdZ(p))), major), sdfdY(p))), minor);
}

SdfDual sdfBoxDistance2(SdfDual2 q) {
    return sdfdAdd(sdfdLength(sdfdVec2(sdfdMax(sdfdX(q), 0.0), sdfdMax(sdfdY(q), 0.0))), sdfdMin(sdfdMax(sdfdX(q), sdfdY(q)), 0.0));
}

SdfDual sdfCylinder(SdfDual3 p, float radius, float halfHeight, float rounding) {
    return sdfdSubtract(sdfBoxDistance2(sdfdVec2(sdfdSubtract(sdfdLength(sdfdVec2(sdfdX(p), sdfdZ(p))), radius), sdfdSubtract(sdfdAbs(sdfdY(p)), halfHeight))), rounding);
}

SdfDual sdfPlane(SdfDual3 p, float3 normal, float offset) {
    return sdfdAdd(sdfdDot(p, normal), offset);
}

SdfDual sdfVesica(SdfDual3 p, float r, float d, float b) {
    SdfDual2 q = sdfdVec2(sdfdLength(sdfdVec2(sdfdX(p), sdfdZ(p))), sdfdAbs(sdfdY(p)));
    return sdfdSelect((sdfdMultiply(sdfdSubtract(sdfdY(q), b), d).v > sdfdMultiply(sdfdX(q), b).v), sdfdLength(sdfdSubtract(q, float2(0.0, b))), sdfdSubtract(sdfdLength(sdfdSubtract(q, float2((-d), 0.0))), r));
}

SdfDual sdfExtrudeChamfer2D(SdfDual d, SdfDual pz, float h, float c) {
    SdfDual2 w = sdfdVec2(d, sdfdSubtract(sdfdAbs(pz), h));
    return sdfdMax(sdfBoxDistance2(w), sdfdMultiply(sdfdAdd(sdfdAdd(sdfdX(w), sdfdY(w)), c), SDF_SQRT_HALF));
}

SdfDual sdfRoundBox2D(SdfDual2 p, float hx, float hy, float r) {
    return sdfdSubtract(sdfBoxDistance2(sdfdVec2(sdfdAdd(sdfdSubtract(sdfdAbs(sdfdX(p)), hx), r), sdfdAdd(sdfdSubtract(sdfdAbs(sdfdY(p)), hy), r))), r);
}

SdfDual2 sdfRevolve2D(SdfDual3 p, float o) {
    return sdfdVec2(sdfdSubtract(sdfdLength(sdfdVec2(sdfdX(p), sdfdZ(p))), o), sdfdY(p));
}

SdfDual sdfRoundedRectangle(SdfDual3 p, float halfWidth, float halfHeight, float cornerRadius, float capChamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return sdfdSubtract(sdfExtrudeChamfer2D(sdfRoundBox2D(sdfdVec2(sdfdX(p), sdfdY(p)), halfWidth, halfHeight, cornerRadius), sdfdZ(p), liftAmount, capChamfer), rounding); }
    return sdfdSubtract(sdfRoundBox2D(sdfRevolve2D(p, liftAmount), halfWidth, halfHeight, cornerRadius), rounding);
}

SdfDual sdfRoundCone(SdfDual3 p, float lowerRadius, float upperRadius, float height, float b, float a) {
    SdfDual2 q = sdfdVec2(sdfdLength(sdfdVec2(sdfdX(p), sdfdZ(p))), sdfdY(p));
    SdfDual k = sdfdDot(q, float2((-b), a));
    if ((k.v < 0.0)) { return sdfdSubtract(sdfdLength(q), lowerRadius); }
    if ((k.v > (a * height))) { return sdfdSubtract(sdfdLength(sdfdSubtract(q, float2(0.0, height))), upperRadius); }
    return sdfdSubtract(sdfdDot(q, float2(a, b)), lowerRadius);
}

SdfDual sdfTrapezoid2D(SdfDual2 p, float r1, float r2, float he) {
    SdfDual px = sdfdAbs(sdfdX(p));
    SdfDual py = sdfdY(p);
    SdfDual2 q = sdfdVec2(px, py);
    float2 k1 = float2(r2, he);
    float2 k2 = float2((r2 - r1), (2.0 * he));
    SdfDual2 ca = sdfdVec2(sdfdSubtract(px, sdfdMin(px, ((py.v < 0.0) ? r1 : r2))), sdfdSubtract(sdfdAbs(py), he));
    SdfDual2 cb = sdfdAdd(sdfdSubtract(q, k1), sdfdMultiply(k2, sdfdSegmentParameter(sdfdSubtract(k1, q), k2)));
    SdfDual m = sdfdMinLength(ca, cb);
    return sdfdSelect(((sdfdX(cb).v < 0.0) && (sdfdY(ca).v < 0.0)), sdfdNegate(m), m);
}

SdfDual sdfTrapezoid(SdfDual3 p, float bottomHalfWidth, float topHalfWidth, float halfHeight, float capChamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return sdfdSubtract(sdfExtrudeChamfer2D(sdfTrapezoid2D(sdfdVec2(sdfdX(p), sdfdY(p)), bottomHalfWidth, topHalfWidth, halfHeight), sdfdZ(p), liftAmount, capChamfer), rounding); }
    return sdfdSubtract(sdfTrapezoid2D(sdfRevolve2D(p, liftAmount), bottomHalfWidth, topHalfWidth, halfHeight), rounding);
}

SdfDual sdfEllipse(SdfDual3 p, float semiX, float semiY, float capChamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return sdfdSubtract(sdfExtrudeChamfer2D(sdfEllipse2D(sdfdVec2(sdfdX(p), sdfdY(p)), float2(semiX, semiY)), sdfdZ(p), liftAmount, capChamfer), rounding); }
    return sdfdSubtract(sdfEllipse2D(sdfRevolve2D(p, liftAmount), float2(semiX, semiY)), rounding);
}

SdfDual sdfChamferBox2D(SdfDual2 p, float hx, float hy, float c) {
    SdfDual2 q = sdfdVec2(sdfdSubtract(sdfdAbs(sdfdX(p)), hx), sdfdSubtract(sdfdAbs(sdfdY(p)), hy));
    return sdfdMax(sdfBoxDistance2(q), sdfdMultiply(sdfdAdd(sdfdAdd(sdfdX(q), sdfdY(q)), c), SDF_SQRT_HALF));
}

SdfDual sdfChamferedRectangle(SdfDual3 p, float halfWidth, float halfHeight, float chamfer, float liftAmount, float lift, float rounding) {
    if ((lift > 0.5)) { return sdfdSubtract(sdfExtrudeChamfer2D(sdfChamferBox2D(sdfdVec2(sdfdX(p), sdfdY(p)), halfWidth, halfHeight, chamfer), sdfdZ(p), liftAmount, chamfer), rounding); }
    return sdfdSubtract(sdfChamferBox2D(sdfRevolve2D(p, liftAmount), halfWidth, halfHeight, chamfer), rounding);
}

SdfDual sdfClampSuperellipsoidNorm(SdfDual approximate, SdfDual norm, float exponent) {
    return sdfdClamp(sdfdFiniteOr(approximate, norm), sdfdMultiply((1.0 - (0.28 * (exponent - 2.0))), norm), norm);
}

SdfDual sdfSuperellipsoid(SdfDual3 p, float3 radii, float3 inverseRadii, float exponent) {
    float minRadius = min(radii.x, min(radii.y, radii.z));
    SdfDual3 absolute = sdfdAbs(p);
    SdfDual3 q = sdfdVec3(sdfdMultiply(sdfdX(absolute), (minRadius * inverseRadii.x)), sdfdMultiply(sdfdY(absolute), (minRadius * inverseRadii.y)), sdfdMultiply(sdfdZ(absolute), (minRadius * inverseRadii.z)));
    if ((exponent == 2.0)) { return sdfdSubtract(sdfdLength(q), minRadius); }
    SdfDual m = sdfdMax(sdfdX(q), sdfdMax(sdfdY(q), sdfdZ(q)));
    if ((m.v <= 0.0)) { return sdfdLift((-minRadius)); }
    SdfDual ux = sdfdPower(sdfdDivide(sdfdX(q), m), exponent);
    SdfDual uy = sdfdPower(sdfdDivide(sdfdY(q), m), exponent);
    SdfDual uz = sdfdPower(sdfdDivide(sdfdZ(q), m), exponent);
    SdfDual norm = sdfdMultiply(m, sdfdPower(sdfdAdd(sdfdAdd(ux, uy), uz), (1.0 / exponent)));
    if (((2.0 < exponent) && (exponent <= 3.0))) { return sdfdSubtract(sdfClampSuperellipsoidNorm(norm, sdfdLength(q), exponent), minRadius); }
    return sdfdSubtract(norm, minRadius);
}
