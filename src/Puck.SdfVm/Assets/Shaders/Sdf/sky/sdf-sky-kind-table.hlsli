// Generated by `puck shaders generate` from the sky's kind table (SdfSkyKindsHlsl.Kinds); regenerate it, never edit it.
// Included by sky/sdf-sky.hlsli after the declarations each kind's module reads.
#ifndef SDF_SKY_KIND_TABLE_HLSLI
#define SDF_SKY_KIND_TABLE_HLSLI

#include "kinds/gradient.hlsli"
#include "kinds/stars.hlsli"
#include "kinds/clouds.hlsli"
#include "kinds/aurora.hlsli"
#include "kinds/noise.hlsli"
#include "kinds/pattern.hlsli"
#include "kinds/panorama.hlsli"
#include "kinds/disc.hlsli"
#include "kinds/view.hlsli"

// A layer's colour and alpha at a sample, by its kind's module; a kind the table does not hold draws nothing.
float4 sdfSkyKindEvaluate(SdfSkyLayer layer, SdfSkySample sample) {
    switch (layer.Kind) {
    case SDF_SKY_KIND_GRADIENT:
        return sdfSkyGradientLayer(sdfSkyGradientOf(layer), layer, sample);
    case SDF_SKY_KIND_STARS:
        return sdfSkyStarsLayer(sdfSkyStarsOf(layer), layer, sample);
    case SDF_SKY_KIND_CLOUDS:
        return sdfSkyCloudsLayer(sdfSkyCloudsOf(layer), layer, sample);
    case SDF_SKY_KIND_AURORA:
        return sdfSkyAuroraLayer(sdfSkyAuroraOf(layer), layer, sample);
    case SDF_SKY_KIND_NOISE:
        return sdfSkyNoiseLayer(sdfSkyNoiseOf(layer), layer, sample);
    case SDF_SKY_KIND_PATTERN:
        return sdfSkyPatternLayer(sdfSkyPatternOf(layer), layer, sample);
    case SDF_SKY_KIND_PANORAMA:
        return sdfSkyPanoramaLayer(sdfSkyPanoramaOf(layer), layer, sample);
    case SDF_SKY_KIND_DISC:
        return sdfSkyDiscLayer(sdfSkyDiscOf(layer), layer, sample);
    case SDF_SKY_KIND_VIEW:
        return sdfSkyViewLayer(sdfSkyViewOf(layer), layer, sample);
    default:
        return float4(0.0, 0.0, 0.0, 0.0);
    }
}

#endif // SDF_SKY_KIND_TABLE_HLSLI
