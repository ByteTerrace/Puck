<Project Sdk="Microsoft.NET.Sdk">
    <!-- The verbs that choose and run verification: affected, gate, host, baselines, locks and deps. -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Gate</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.*, )" />
        <!-- host heap: the runtime's own heap dump of another process, read from its event stream. -->
        <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="[4.*, )" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="[11.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
        <ProjectReference Include="../Puck.Cli.Harness/Puck.Cli.Harness.csproj" />
        <ProjectReference Include="../Puck.Shaders/Puck.Shaders.csproj" />
        <ProjectReference Include="../Puck.World.Transpiler/Puck.World.Transpiler.csproj" />
    </ItemGroup>
</Project>