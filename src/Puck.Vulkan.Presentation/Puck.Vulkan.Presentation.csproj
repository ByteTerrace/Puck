<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Presentation</PuckLayer>
    </PropertyGroup>
    <PropertyGroup>
        <DxcCommand>dxc</DxcCommand>
        <!-- No DXIL: Puck.Vulkan.Presentation only ever ran the Vulkan half of the pair (matching the recipe
             before it moved into the shared build\Shaders.targets) — it declares no compute items, so the compute
             opt-out is moot for it. -->
        <PuckShaderDxilEnabled>false</PuckShaderDxilEnabled>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Puck.Assets\Puck.Assets.csproj" />
        <ProjectReference Include="..\Puck.Hosting\Puck.Hosting.csproj" />
        <ProjectReference Include="..\Puck.Shaders\Puck.Shaders.csproj" />
        <ProjectReference Include="..\Puck.Vulkan\Puck.Vulkan.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.*, )" />
    </ItemGroup>
    <ItemGroup>
        <!-- Evaluation-time glob for ValidateShaderBytecodeSources (build\Shaders.targets); the shipped Content
             declaration is owned by the shared CollectShaderBytecode target, which re-globs after CompileShaders. -->
        <ShaderBytecode Include="Assets\Shaders\**\*.spv" />
    </ItemGroup>
    <ItemGroup>
        <VertexShaderSource Include="Assets\Shaders\**\*.vert.hlsl" />
        <FragmentShaderSource Include="Assets\Shaders\**\*.frag.hlsl" />
        <ShaderInclude Include="Assets\Shaders\**\*.hlsli" />
    </ItemGroup>
    <!-- CompileShaders / CollectShaderBytecode / ValidateShaderBytecodeSources / ValidateShaderBytecodeFresh all
         live in the shared build\Shaders.targets now (imported by Directory.Build.targets), item-driven purely
         over the ItemGroup globs above — Puck.Vulkan.Presentation declares no ComputeShaderSource/
         RayQueryComputeShaderSource, so neither Exec ever fires for it. -->
</Project>
