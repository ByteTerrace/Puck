<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Text</AssemblyName>
        <Description>Render-agnostic font atlas generation and text layout: reads TrueType and CFF/CFF2 OpenType outlines into a queryable MTSDF/SDF/mask font atlas, lays strings out into positioned glyph quads, and supplies the distance-field sampling math and optional per-glyph markup/effect channels a renderer needs. Carries no GPU or windowing concepts; em-space geometry is left for the caller to map to screen pixels.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Text</PackageId>
        <PackageTags>cff;font;glyph;layout;msdf;opentype;sdf;text;truetype</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
        <RootNamespace>Puck.Text</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Puck.Assets\Puck.Assets.csproj" />
        <ProjectReference Include="..\Puck.Maths\Puck.Maths.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Assets\Fonts\**\*.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
        <Content Include="Assets\Fonts\**\*.png" CopyToOutputDirectory="PreserveNewest" Pack="false" />
        <Content Include="Assets\Fonts\source\**\*.ttf" Pack="false" />
        <Content Include="Assets\Fonts\source\**\*.txt" Pack="false" />
    </ItemGroup>
</Project>
