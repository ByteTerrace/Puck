<Project Sdk="Microsoft.NET.Sdk">
    <!-- The red-leg prover (`puck laws prove`) and its proof tree. -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Laws</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" Version="[17.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
    </ItemGroup>
</Project>