<Project Sdk="Microsoft.NET.Sdk">
    <!-- What describes and stages a World run for the verbs that boot one: the stored World artifact and its key, the offscreen leg, the canary manifests and their assertions, the refusal census, and the counters batch manifest. -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Harness</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
        <ProjectReference Include="../Puck.Assets/Puck.Assets.csproj" />
        <ProjectReference Include="../Puck.Commands/Puck.Commands.csproj" />
        <ProjectReference Include="../Puck.Launcher/Puck.Launcher.csproj" />
    </ItemGroup>
</Project>