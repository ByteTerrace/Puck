<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Commands</AssemblyName>
        <!-- The gallery card truncates, so the first sentence has to stand alone; the detail follows it. -->
        <Description>One typed command surface for deterministic fixed-step simulations. Keyboard, mouse, gamepad, console text, authored interface controls, replay, and network input all become the same named command carrying a per-frame value, so a handler never learns where its input came from. The fixed-step path orders every modality into per-slot snapshots and applies exactly one per host-owned tick. Source-available and dual-licensed: free for noncommercial use under PolyForm Noncommercial 1.0.0, paid commercial license otherwise.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Commands</PackageId>
        <PackageTags>bindings;commands;determinism;input;simulation</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Shared substrate</PuckLayer>
        <RootNamespace>Puck.Commands</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="[2.*, )" />
    </ItemGroup>
    <ItemGroup>
        <!-- Every enum in the binding document carries [JsonConverter(typeof(StrictEnumConverter<T>))] at its own
             declaration, which is Puck.Abstractions.Documents' type. Declared rather than left to arrive through
             Puck.Assets: this project names the type in its own source, so the edge belongs in its own file. -->
        <ProjectReference Include="..\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\Puck.Assets\Puck.Assets.csproj" />
        <ProjectReference Include="..\Puck.Maths\Puck.Maths.csproj" />
    </ItemGroup>
</Project>
