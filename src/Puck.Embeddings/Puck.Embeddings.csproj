<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Embeddings</AssemblyName>
        <Description>Deterministic embedding providers, batching, and unit vector quantization for Puck simulation state.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Embeddings</PackageId>
        <PackageTags>puck;embeddings;simulation;vectors</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
        <RootNamespace>Puck.Embeddings</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI" Version="[10.*, )" />
        <ProjectReference Include="../Puck.Maths/Puck.Maths.csproj" />
        <!-- Puck.State owns the embedding-space identity (EmbeddingIdentity) each generator is built for. -->
        <ProjectReference Include="../Puck.State/Puck.State.csproj" />
    </ItemGroup>
</Project>
