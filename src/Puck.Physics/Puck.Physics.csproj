<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Physics</AssemblyName>
        <Description>Deterministic fixed-point simulation kernels: exact and hierarchical gravitational fields (pairwise, Barnes–Hut monopole, and a low-order adaptive FMM), compound dynamic-body overlap, analytic static contact geometry and the relaxation solver over it, the contact seam a grounded body resolves against and both providers behind it (collider relaxation and scalar-field measurement), a substepping rigid-contact solver, a two-body/multi-body coupling kernel with a shape-only multi-body world orchestrator, and the body motion-program core (the instruction vocabulary, the compiler over it, and the compiled fixed-point tuning/trigger shapes a host integrates bodies from). No document parsing here — compiled shapes only. Identical results bit-for-bit for identical ordered inputs.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Physics</PackageId>
        <PackageTags>collision;determinism;gravity;motion;physics;rigid-body;simulation</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
        <RootNamespace>Puck.Physics</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\Puck.Maths\Puck.Maths.csproj" />
    </ItemGroup>
</Project>
