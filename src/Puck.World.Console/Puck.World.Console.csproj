<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- WorldRowFieldStepper reflects an arbitrary document-row Type at runtime (world.row.step's generic
             field walk) to resolve a leaf's declared CLR type — an enum-cycle target's vocabulary can only be
             read that way. The SAME reflection-based shape the authoring document families already opt out for
             (Puck.Assets' DocumentJsonOptions.Shared serializes the creation/audio/synth document families outside any
             source-generated context), reached transitively the moment a step path walks into a WorldCreation
             row's embedded CreationDocument. -->
        <IsAotCompatible>false</IsAotCompatible>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Puck.Commands\Puck.Commands.csproj" />
        <ProjectReference Include="..\Puck.Launcher\Puck.Launcher.csproj" />
        <ProjectReference Include="..\Puck.World.Protocol\Puck.World.Protocol.csproj" />
        <ProjectReference Include="..\Puck.World.Schema\Puck.World.Schema.csproj" />
        <ProjectReference Include="..\Puck.World.Server\Puck.World.Server.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
    </ItemGroup>
</Project>
