<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Stamps puck.ico into the apphost's Win32 resources at RT_GROUP_ICON 32512 (IDI_APPLICATION), replacing the
             stock .NET apphost icon. That is the one place a Windows executable's icon can live: Explorer, a pinned
             shortcut, and Alt+Tab all read it, and it is also what Win32IconLoader loads when a world authors no
             host.icon of its own. Nothing copies the file to the output directory — it is compiled in. -->
        <ApplicationIcon>puck.ico</ApplicationIcon>
        <IsAotCompatible>false</IsAotCompatible>
        <OutputType>Exe</OutputType>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Composition roots</PuckLayer>
        <!-- A World can listen (host.listen's QUIC door, the control endpoint), so `dotnet run` starts it under the
             shared dotnet host (Directory.Build.targets): one firewall decision for dotnet.exe covers every worktree,
             where each worktree's apphost is a new path Windows Firewall asks about again. -->
        <PuckRunUnderDotnetHost>true</PuckRunUnderDotnetHost>
        <!-- Prepare both desktop RIDs during restore, including the ReadyToRun compiler pack. Publishing moves
             first-use JIT work out of world startup; ordinary builds retain their portable IL output. -->
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
        <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' and '$(PublishAot)' != 'true'">true</PublishReadyToRun>
        <!-- A player build (`puck world player`) publishes the World with its own runtime. The switch is this project's
             alone: a global SelfContained or RuntimeIdentifier would flow into every referenced project's locked restore,
             whose graphs are portable, while here the current runtime identifier follows from SelfContained and the
             referenced libraries build portable as they always do. -->
        <SelfContained Condition="'$(PuckSelfContained)' == 'true'">true</SelfContained>
    </PropertyGroup>
    <!-- Presentation builds and replaces large managed workspaces (irradiance hierarchies, probe caches and decoded
         mesh arrays). ConserveMemory reduces retention of freed LOH regions after these bursts. Published mesh
         payloads use the host allocator; host.memory reports those separately from managed commitment. -->
    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="[11.*, )" />
        <PackageReference Include="System.CommandLine" Version="[3.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Abstractions/Puck.Abstractions.csproj" />
        <ProjectReference Include="../Puck.AdvancedGamingBrick/Puck.AdvancedGamingBrick.csproj" />
        <ProjectReference Include="../Puck.AdvancedGamingBrick.Forge/Puck.AdvancedGamingBrick.Forge.csproj" />
        <ProjectReference Include="../Puck.Assets/Puck.Assets.csproj" />
        <ProjectReference Include="../Puck.Commands/Puck.Commands.csproj" />
        <ProjectReference Include="../Puck.DirectX/Puck.DirectX.csproj" />
        <ProjectReference Include="../Puck.Hosting/Puck.Hosting.csproj" />
        <ProjectReference Include="../Puck.HumbleGamingBrick/Puck.HumbleGamingBrick.csproj" />
        <ProjectReference Include="../Puck.Input/Puck.Input.csproj" />
        <ProjectReference Include="../Puck.Launcher.Linux/Puck.Launcher.Linux.csproj" />
        <ProjectReference Include="../Puck.Launcher.Windows/Puck.Launcher.Windows.csproj" />
        <ProjectReference Include="../Puck.Launcher/Puck.Launcher.csproj" />
        <ProjectReference Include="../Puck.Maths/Puck.Maths.csproj" />
        <ProjectReference Include="../Puck.Networking/Puck.Networking.csproj" />
        <ProjectReference Include="../Puck.Overlays/Puck.Overlays.csproj" />
        <ProjectReference Include="../Puck.Platform.Linux/Puck.Platform.Linux.csproj" />
        <ProjectReference Include="../Puck.Platform.Windows/Puck.Platform.Windows.csproj" />
        <ProjectReference Include="../Puck.Platform/Puck.Platform.csproj" />
        <ProjectReference Include="../Puck.Recording/Puck.Recording.csproj" />
        <ProjectReference Include="../Puck.Scripting/Puck.Scripting.csproj" />
        <ProjectReference Include="../Puck.SdfVm/Puck.SdfVm.csproj" />
        <ProjectReference Include="../Puck.Shaders/Puck.Shaders.csproj" />
        <ProjectReference Include="../Puck.Storage/Puck.Storage.csproj" />
        <ProjectReference Include="../Puck.Text/Puck.Text.csproj" />
        <ProjectReference Include="../Puck.World.Addons/Puck.World.Addons.csproj" />
        <ProjectReference Include="../Puck.World.Client/Puck.World.Client.csproj" />
        <ProjectReference Include="../Puck.World.Console/Puck.World.Console.csproj" />
        <ProjectReference Include="../Puck.HumbleGamingBrick.Forge/Puck.HumbleGamingBrick.Forge.csproj" />
        <ProjectReference Include="../Puck.HumbleGamingDeck.Forge/Puck.HumbleGamingDeck.Forge.csproj" />
        <ProjectReference Include="../Puck.World.Authoring/Puck.World.Authoring.csproj" />
        <ProjectReference Include="../Puck.World.Machines/Puck.World.Machines.csproj" />
        <ProjectReference Include="../Puck.World.Protocol/Puck.World.Protocol.csproj" />
        <ProjectReference Include="../Puck.World.Schema/Puck.World.Schema.csproj" />
        <ProjectReference Include="../Puck.World.Server/Puck.World.Server.csproj" />
        <ProjectReference Include="../Puck.Transpiler/Puck.Transpiler.csproj" />
        <ProjectReference Include="../Puck.World.Transpiler/Puck.World.Transpiler.csproj" />
    </ItemGroup>
    <!-- The pinned SDK normally reuses build deps during publish. CI reuses portable IL for a RID-specific
         publish, so that manifest names the wrong runtime asset paths. Regenerate only publish metadata,
         in the publish directory, preserving the portable build and avoiding another C# compilation.
         Revalidate this SDK hook when updating global.json. -->
    <Target Name="PuckUsePublishDependencyFile" AfterTargets="_ComputeUseBuildDependencyFile"
            Condition="'$(NoBuild)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(AppendRuntimeIdentifierToOutputPath)' == 'false'">
        <PropertyGroup>
            <_UseBuildDependencyFile>false</_UseBuildDependencyFile>
            <PublishDepsFilePath Condition="'$(PublishDepsFilePath)' == ''">$(PublishDir)$(ProjectDepsFileName)</PublishDepsFilePath>
        </PropertyGroup>
    </Target>
    <!-- The precompiler's intermediate directory (obj/<config>/<tfm>/<rid>/R2R) is shared by every ReadyToRun shape, and the
         SDK's _CreateR2RImages is up to date by timestamps alone, so a per-assembly publish after a composite one keeps the
         composite's component stubs for every assembly that did not change and ships them without the composite image: the
         folder fails fast at start (0xC0000602) and boots only with DOTNET_ReadyToRun=0. The directory holds one shape's
         images: when the shape differs from the one recorded beside it, it is emptied before the images are made, so every
         image is made again. Revalidate this SDK hook when updating global.json. -->
    <Target Name="PuckReadyToRunShape" BeforeTargets="_CreateR2RImages" Condition="'$(PublishReadyToRun)' == 'true'">
        <PropertyGroup>
            <_PuckReadyToRunDirectory>$(_ReadyToRunOutputPath)</_PuckReadyToRunDirectory>
            <_PuckReadyToRunDirectory Condition="'$(_PuckReadyToRunDirectory)' == ''">$(IntermediateOutputPath)R2R</_PuckReadyToRunDirectory>
            <_PuckReadyToRunShapeFile>$(IntermediateOutputPath)R2R.shape</_PuckReadyToRunShapeFile>
            <_PuckReadyToRunShape>composite=$(PublishReadyToRunComposite);self-contained=$(SelfContained);rid=$(RuntimeIdentifier);args=$(PublishReadyToRunCrossgen2ExtraArgs);composite-args=$(PublishReadyToRunCrossgen2CompositeExtraArgs);symbols=$(PublishReadyToRunEmitSymbols)</_PuckReadyToRunShape>
            <_PuckReadyToRunRecordedShape />
        </PropertyGroup>
        <ReadLinesFromFile File="$(_PuckReadyToRunShapeFile)" Condition="Exists('$(_PuckReadyToRunShapeFile)')">
            <Output TaskParameter="Lines" PropertyName="_PuckReadyToRunRecordedShape" />
        </ReadLinesFromFile>
        <Message Importance="high" Condition="'$(_PuckReadyToRunRecordedShape)' != '$(_PuckReadyToRunShape)'"
                 Text="Puck.World: ReadyToRun shape changed ($(_PuckReadyToRunShape)); emptying $(_PuckReadyToRunDirectory) so every image is made again." />
        <RemoveDir Directories="$(_PuckReadyToRunDirectory)" Condition="'$(_PuckReadyToRunRecordedShape)' != '$(_PuckReadyToRunShape)'" />
        <MakeDir Directories="$(_PuckReadyToRunDirectory)" />
        <WriteLinesToFile File="$(_PuckReadyToRunShapeFile)" Lines="$(_PuckReadyToRunShape)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <FileWrites Include="$(_PuckReadyToRunShapeFile)" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <Using Include="Puck.State" />
    </ItemGroup>
    <!-- -p:PuckPrewarmPlayerProducts=false skips the player prewarm for a publish that boots from source state, such as
         the tools' World build store, whose Worlds derive those products into their own cache at boot. -->
    <Target Name="PuckPrewarmPlayerProducts" AfterTargets="Publish" Condition="'$(PuckPrewarmPlayerProducts)' != 'false'">
        <PropertyGroup>
            <_PuckPlayerProductDirectory>$(PublishDir.Replace('\', '/'))</_PuckPlayerProductDirectory>
        </PropertyGroup>
        <MSBuild Projects="../Puck.Cli.Worlds/Puck.Cli.Worlds.csproj" Targets="Build"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false"
                 RemoveProperties="NoBuild;PublishDir;PublishReadyToRun;AppendRuntimeIdentifierToOutputPath" />
        <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../Puck.Cli.Worlds/bin/$(Configuration)/$(TargetFramework)/Puck.Cli.Worlds.dll&quot; prewarm --output &quot;$(_PuckPlayerProductDirectory)&quot;" />
    </Target>
    <ItemGroup>
        <!-- The engine's own content: the default recording. Worlds are asset packages the engine is handed at boot,
             never shipped beside it. -->
        <Content Include="Assets/recordings/**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
