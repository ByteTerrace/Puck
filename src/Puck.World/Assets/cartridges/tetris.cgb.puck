save {
    arrays [
        "best"
    ]
    variables []
    version: 1
}

scrollX: "0"

scrollY: "0"

rule "phase-begin" {
    nph = ph
    showpiece = 0
}

rule "steer" {
    when ph == 0
    tx = px
    ty = py
    tr = pr
    want = 0
    if key(left, held) {
        want = 1
    }
    if key(right, held) {
        want = 2
    }
    mv = 0
    if want == 0 {
        dasdir = 0
        das = 0
    } else {
        if want != dasdir {
            dasdir = want
            das = 23
            mv = 1
        } else {
            das -= 1
            if das == 0 {
                mv = 1
                das = 9
            }
        }
    }
    if mv != 0 {
        if dasdir == 1 {
            tx -= 1
        } else {
            tx += 1
        }
    }
    if key(a, pressed) {
        tr += 1
        tr &= 3
    }
    if key(b, pressed) {
        tr += 3
        tr &= 3
    }
    ok = 1
    repeat 4 as k {
        si = pt
        si *= 4
        si += tr
        si *= 4
        si += k
        s = shapes[si]
        cr = s
        cr >>= 2
        cc = s
        cc &= 3
        cr += ty
        cr -= 4
        cc += tx
        cc -= 4
        if cc >= 10 {
            ok = 0
            break
        }
        if cr >= 18 {
            ok = 0
            break
        }
        fi = cr
        fi *= 10
        fi += cc
        if field[fi] != 0 {
            ok = 0
            break
        }
    }
    if ok != 0 {
        px = tx
        py = ty
        pr = tr
    }
}

rule "fall" {
    when ph == 0
    dt += 1
    if key(down, held) {
        dt += 8
    }
    if dt >= ds {
        dt = 0
        tx = px
        ty = py
        ty += 1
        tr = pr
        ok = 1
        repeat 4 as k {
            si = pt
            si *= 4
            si += tr
            si *= 4
            si += k
            s = shapes[si]
            cr = s
            cr >>= 2
            cc = s
            cc &= 3
            cr += ty
            cr -= 4
            cc += tx
            cc -= 4
            if cc >= 10 {
                ok = 0
                break
            }
            if cr >= 18 {
                ok = 0
                break
            }
            fi = cr
            fi *= 10
            fi += cc
            if field[fi] != 0 {
                ok = 0
                break
            }
        }
        if ok != 0 {
            py = ty
        } else {
            nph = 1
        }
    }
}

rule "settle" {
    when ph == 1
    pcol = pt
    pcol += 1
    repeat 4 as k {
        si = pt
        si *= 4
        si += pr
        si *= 4
        si += k
        s = shapes[si]
        cr = s
        cr >>= 2
        cc = s
        cc &= 3
        cr += py
        cr -= 4
        cc += px
        cc -= 4
        fi = cr
        fi *= 10
        fi += cc
        field[fi] = pcol
        r2 = cr
        r2 += 0
        c2 = cc
        c2 += 2
        map(column: "c2", palette: "pcol", row: "r2", tile: "1")
    }
    play(sound: "settle")
    nfull = 0
    rcur = 0
    nph = 2
}

rule "scan" {
    when ph == 2
    repeat 5 as k {
        if rcur >= 18 {
            break
        }
        cr = rcur
        full = 1
        base = cr
        base *= 10
        repeat 10 as cc {
            fi = base
            fi += cc
            if field[fi] == 0 {
                full = 0
                break
            }
        }
        rowfull[cr] = full
        if full != 0 {
            fullrows[nfull] = cr
            nfull += 1
        }
        rcur += 1
    }
    if rcur >= 18 {
        rcur = 0
        w = 17
        if nfull != 0 {
            fcol = 0
            fhold = 0
            nph = 19
        } else {
            nph = 6
        }
    }
}

rule "flash" {
    when ph == 19
    if fhold != 0 {
        fhold = 0
    } else {
        fhold = 1
        repeat 4 as k {
            if k >= nfull {
                break
            }
            cr = fullrows[k]
            cr += 0
            cc = 4
            cc -= fcol
            cc += 2
            map(column: "cc", palette: "0", row: "cr", tile: "0")
            c2 = 5
            c2 += fcol
            c2 += 2
            map(column: "c2", palette: "0", row: "cr", tile: "0")
        }
        fcol += 1
        if fcol >= 5 {
            nph = 3
        }
    }
}

rule "collapse" {
    when ph == 3
    repeat 5 as k {
        if rcur >= 18 {
            break
        }
        cr = 17
        cr -= rcur
        rcur += 1
        if rowfull[cr] == 0 {
            base = cr
            base *= 10
            wbase = w
            wbase *= 10
            repeat 10 as cc {
                fi = base
                fi += cc
                r2 = wbase
                r2 += cc
                field[r2] = field[fi]
            }
            w -= 1
        }
    }
    if rcur >= 18 {
        rcur = 0
        lines += nfull
        play(sound: "sweepaway")
        awardv = award[nfull]
        awardn = level
        awardn += 1
        nph = 7
    }
}

rule "pay" {
    when ph == 7
    if awardn == 0 {
        nph = 4
    } else {
        awardn -= 1
        carryv = awardv
        repeat 5 as k {
            if carryv == 0 {
                break
            }
            di = 4
            di -= k
            dv = carryv
            dv %= 10
            carryv /= 10
            dv += score[di]
            if dv >= 10 {
                dv -= 10
                carryv += 1
            }
            score[di] = dv
        }
    }
}

rule "sweep" {
    when ph == 4
    repeat 5 as k {
        if rcur > w {
            break
        }
        base = rcur
        base *= 10
        repeat 10 as cc {
            fi = base
            fi += cc
            field[fi] = 0
        }
        rcur += 1
    }
    if rcur > w {
        rcur = 0
        nph = 5
    }
}

rule "republish" {
    when ph == 5
    repeat 19 as k {
        if rcur >= 180 {
            break
        }
        cr = rcur
        cr /= 10
        cc = rcur
        cc %= 10
        r2 = cr
        r2 += 0
        c2 = cc
        c2 += 2
        dv = field[rcur]
        if dv == 0 {
            map(column: "c2", palette: "0", row: "r2", tile: "0")
        } else {
            map(column: "c2", palette: "dv", row: "r2", tile: "1")
        }
        rcur += 1
    }
    if rcur >= 180 {
        nph = 6
    }
}

rule "spawn" {
    when ph == 6
    pt = nt
    pr = 0
    px = 7
    py = 4
    dt = 0
    rng *= 5
    rng += 13
    nt = rng
    nt >>= 3
    nt %= 7
    if nt == pt {
        rng *= 5
        rng += 13
        nt = rng
        nt >>= 3
        nt %= 7
    }
    tx = px
    ty = py
    tr = pr
    ok = 1
    repeat 4 as k {
        si = pt
        si *= 4
        si += tr
        si *= 4
        si += k
        s = shapes[si]
        cr = s
        cr >>= 2
        cc = s
        cc &= 3
        cr += ty
        cr -= 4
        cc += tx
        cc -= 4
        if cc >= 10 {
            ok = 0
            break
        }
        if cr >= 18 {
            ok = 0
            break
        }
        fi = cr
        fi *= 10
        fi += cc
        if field[fi] != 0 {
            ok = 0
            break
        }
    }
    if ok != 0 {
        nph = 0
    } else {
        over = 1
        after = 9
        painted = 0
        tcur = 0
        wrow = 0
        wcol = 0
        nph = 12
        stop()
    }
}

rule "tick" {
    ticks += 1
}

rule "pace" {
    level = lines
    level /= 10
    level += startlevel
    if level > 20 {
        level = 20
    }
    ds = speeds[level]
}

rule "carry" {
    when ph == 0
    showpiece = 1
    pcol = pt
    pcol += 1
    repeat 4 as k {
        si = pt
        si *= 4
        si += pr
        si *= 4
        si += k
        s = shapes[si]
        cr = s
        cr >>= 2
        cc = s
        cc &= 3
        cr += py
        cr -= 4
        cc += px
        cc -= 4
        cr += 0
        cr *= 8
        sy[k] = cr
        cc += 2
        cc *= 8
        sx[k] = cc
    }
}

rule "panel" {
    pcur += 1
    if pcur >= 11 {
        pcur = 0
    }
    if ph < 8 {
        if pcur < 5 {
            dv = score[pcur]
            c2 = pcur
            c2 += 13
            dv += 4
            map(column: "c2", row: "2", tile: "dv")
        } else {
            if pcur == 5 {
                map(column: "18", row: "2", tile: "4")
            } else {
                if pcur == 6 {
                    dv = level
                    dv /= 10
                    dv += 4
                    map(column: "13", row: "6", tile: "dv")
                } else {
                    if pcur == 7 {
                        dv = level
                        dv %= 10
                        dv += 4
                        map(column: "14", row: "6", tile: "dv")
                    } else {
                        if pcur == 8 {
                            dv = lines
                            dv /= 100
                            dv += 4
                            map(column: "13", row: "10", tile: "dv")
                        } else {
                            if pcur == 9 {
                                dv = lines
                                dv /= 10
                                dv %= 10
                                dv += 4
                                map(column: "14", row: "10", tile: "dv")
                            } else {
                                if pcur == 10 {
                                    dv = lines
                                    dv %= 10
                                    dv += 4
                                    map(column: "15", row: "10", tile: "dv")
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

rule "recall" {
    when ph == 14
    load()
    nph = 8
}

rule "title-name" {
    when ph == 8
    if tcur == 0 and hold == 0 and painted == 0 {
        play(sound: "theme-title")
    }
    if hold != 0 {
        hold -= 1
    } else {
        repeat 9 as k {
            if tcur >= 117 {
                break
            }
            cr = title1[tcur]
            si = cr
            si >>= 5
            cr &= 31
            tcur += 1
            cc = title1[tcur]
            tcur += 1
            dv = title1[tcur]
            tcur += 1
            map(column: "cc", palette: "si", row: "cr", tile: "dv")
        }
        if tcur >= 117 {
            painted = 1
        }
        if painted != 0 {
            painted = 0
            tcur = 0
            hold = 24
            nph = 16
        }
    }
}

rule "title-game" {
    when ph == 16
    if hold != 0 {
        hold -= 1
    } else {
        repeat 9 as k {
            if tcur >= 120 {
                break
            }
            cr = title2[tcur]
            si = cr
            si >>= 5
            cr &= 31
            tcur += 1
            cc = title2[tcur]
            tcur += 1
            dv = title2[tcur]
            tcur += 1
            map(column: "cc", palette: "si", row: "cr", tile: "dv")
        }
        if tcur >= 120 {
            painted = 1
        }
        if painted != 0 {
            painted = 0
            tcur = 0
            hold = 16
            nph = 17
        }
    }
}

rule "title-rest" {
    when ph == 17
    if hold != 0 {
        hold -= 1
    } else {
        repeat 9 as k {
            if tcur >= 147 {
                break
            }
            cr = title3[tcur]
            si = cr
            si >>= 5
            cr &= 31
            tcur += 1
            cc = title3[tcur]
            tcur += 1
            dv = title3[tcur]
            tcur += 1
            map(column: "cc", palette: "si", row: "cr", tile: "dv")
        }
        if tcur >= 147 {
            painted = 1
        }
        if painted != 0 {
            painted = 0
            tcur = 0
            hold = 0
            nph = 18
        }
    }
}

rule "title-wait" {
    when ph == 18
    chase += 1
    if chase >= 77 {
        chase = 0
    }
    cc = chase
    cc %= 11
    si = chase
    si /= 11
    si += cc
    si %= 7
    si += 1
    dv = presstext[cc]
    cc += 4
    map(column: "cc", palette: "si", row: "14", tile: "dv")
    if key(start, pressed) {
        beat = 0
        after = 10
        painted = 0
        tcur = 0
        rcur = 0
        nph = 12
    }
}

rule "menu" {
    when ph == 10
    if painted == 0 {
        repeat 9 as k {
            if tcur >= 228 {
                break
            }
            cr = menutext[tcur]
            si = cr
            si >>= 5
            cr &= 31
            tcur += 1
            cc = menutext[tcur]
            tcur += 1
            dv = menutext[tcur]
            tcur += 1
            map(column: "cc", palette: "si", row: "cr", tile: "dv")
        }
        if tcur >= 228 {
            painted = 1
        }
    } else {
        if key(up, pressed) {
            pick = 0
        }
        if key(down, pressed) {
            pick = 1
        }
        if key(left, pressed) and startlevel != 0 {
            startlevel -= 1
        }
        if key(right, pressed) and startlevel < 9 {
            startlevel += 1
        }
        dv = startlevel
        dv += 4
        map(column: "12", palette: "0", row: "11", tile: "dv")
        if key(start, pressed) {
            gtype = pick
            after = 13
            painted = 0
            tcur = 0
            rcur = 0
            nph = 12
        }
    }
}

rule "marker" {
    showmark = 0
    if ph == 10 {
        showmark = 1
        markery = pick
        markery *= 3
        markery += 5
        markery *= 8
    }
}

rule "wipe" {
    when ph == 12
    repeat 9 as k {
        if wrow >= 18 {
            break
        }
        map(column: "wcol", palette: "0", row: "wrow", tile: "0")
        wcol += 1
        if wcol >= 20 {
            wcol = 0
            wrow += 1
        }
    }
    if wrow >= 18 {
        wrow = 0
        wcol = 0
        nph = after
    }
}

rule "begin" {
    when ph == 13
    repeat 18 as cr {
        base = cr
        base *= 10
        repeat 10 as cc {
            fi = base
            fi += cc
            field[fi] = 0
        }
    }
    lines = 0
    level = startlevel
    over = 0
    repeat 5 as k {
        score[k] = 0
    }
    if gtype != 0 {
        repeat 5 as k {
            cr = 17
            cr -= k
            base = cr
            base *= 10
            rng *= 5
            rng += 13
            dv = rng
            dv %= 10
            repeat 10 as cc {
                fi = base
                fi += cc
                si = cc
                si += k
                si %= 7
                si += 1
                if cc != dv {
                    field[fi] = si
                }
            }
        }
    }
    if gtype == 0 {
        play(sound: "theme-a")
    } else {
        play(sound: "theme-b")
    }
    if gtype == 0 {
        play(sound: "theme-a")
    } else {
        play(sound: "theme-b")
    }
    tcur = 0
    dressed = 0
    rcur = 0
    nph = 15
}

rule "dress" {
    when ph == 15
    repeat 9 as k {
        if tcur >= 165 {
            break
        }
        cr = paneltext[tcur]
        si = cr
        si >>= 5
        cr &= 31
        tcur += 1
        cc = paneltext[tcur]
        tcur += 1
        dv = paneltext[tcur]
        tcur += 1
        map(column: "cc", palette: "si", row: "cr", tile: "dv")
    }
    if tcur >= 165 {
        dressed = 1
    }
    if dressed != 0 {
        nph = 5
    }
}

rule "over" {
    when ph == 9
    if painted == 0 and beat == 0 {
        beat = 1
        cmpd = 0
        repeat 5 as k {
            if score[k] > best[k] {
                cmpd = 1
                break
            }
            if score[k] < best[k] {
                break
            }
        }
        if cmpd != 0 {
            repeat 5 as k {
                best[k] = score[k]
            }
            save()
        }
    }
    if painted == 0 {
        repeat 9 as k {
            if tcur >= 204 {
                break
            }
            cr = overtext[tcur]
            si = cr
            si >>= 5
            cr &= 31
            tcur += 1
            cc = overtext[tcur]
            tcur += 1
            dv = overtext[tcur]
            tcur += 1
            map(column: "cc", palette: "si", row: "cr", tile: "dv")
        }
        if tcur >= 204 {
            painted = 1
        }
    } else {
        if key(start, pressed) {
            hold = 0
            after = 8
            painted = 0
            tcur = 0
            rcur = 0
            nph = 12
        }
    }
}

rule "finish" {
    when ph == 0
    if gtype != 0 and lines >= 25 {
        rockety = 144
        play(sound: "theme-win")
        nph = 11
    }
}

rule "launch" {
    when ph == 11
    if rockety < 4 {
        stop()
        hold = 0
        after = 8
        painted = 0
        tcur = 0
        beat = 0
        rcur = 0
        nph = 12
    } else {
        rockety -= 2
    }
}

rule "rocket" {
    showrocket = 0
    if ph == 11 {
        showrocket = 1
        rk0 = rockety
        rk0 += 0
        rk1 = rockety
        rk1 += 8
        rk2 = rockety
        rk2 += 8
        rk3 = rockety
        rk3 += 8
    }
}

rule "tally" {
    when ph == 9
    dcur += 1
    if dcur >= 9 {
        dcur = 0
    }
    if dcur < 6 {
        cc = dcur
        cc += 7
        if dcur < 5 {
            dv = score[dcur]
            dv += 4
        } else {
            dv = 4
        }
        map(column: "cc", palette: "0", row: "9", tile: "dv")
    } else {
        dv = lines
        if dcur == 6 {
            dv /= 100
        }
        if dcur == 7 {
            dv /= 10
        }
        dv %= 10
        dv += 4
        cc = dcur
        cc -= 6
        cc += 8
        map(column: "cc", palette: "0", row: "13", tile: "dv")
    }
}

rule "best" {
    when ph == 18
    dcur += 1
    if dcur >= 6 {
        dcur = 0
    }
    cc = dcur
    cc += 10
    if dcur < 5 {
        dv = best[dcur]
        dv += 4
    } else {
        dv = 4
    }
    map(column: "cc", palette: "0", row: "16", tile: "dv")
}

rule "preview" {
    shownext = 0
    ncol = nt
    ncol += 1
    if ph < 8 {
        shownext = 1
    }
    repeat 4 as k {
        si = nt
        si *= 16
        si += k
        s = shapes[si]
        cr = s
        cr >>= 2
        cc = s
        cc &= 3
        cr += 14
        cr *= 8
        ny[k] = cr
        cc += 13
        cc *= 8
        nx[k] = cc
    }
}

rule "fade" {
    fadeto = 0
    if ph == 12 {
        fadeto = 16
    }
    if fadeamt < fadeto {
        fadeamt += 1
    }
    if fadeamt > fadeto {
        fadeamt -= 1
    }
    fade(amount: "fadeamt", toward: "black")
}

rule "phase-end" {
    ph = nph
}
