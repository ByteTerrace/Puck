          "onPress": {
            "gate": {
              "$type": "all",
              "predicates": [
                {
                  "$type": "recently",
                  "fact": "Grounded",
                  "windowSeconds": 0.09
                },
                {
                  "$type": "compareState",
                  "state": "jumpUses",
                  "comparison": "Less",
                  "value": 1
