// The shape gallery: every authorable signed-distance construct, one prototype an exhibit, each held 1.2 m over a
// labelled plinth so it reads from every side, underside included. The debug world expands `galleryPrototypes()` inside
// its `prototypes` block, `galleryPlacements()` inside its `placements` block and `galleryState()` (the motion rows'
// console controls) inside its `state.world` block. The rows stand on the open ground at +X/+Z, every exhibit 3 m from
// the next, its label facing -Z, toward the origin:
//
//   z 14  each primitive at a uniform scale
//   z 19  each primitive stretched unevenly, where an exact distance is hardest to keep
//   z 24  each prism profile, extruded
//   z 29  each prism profile, revolved
//   z 34  sweeps, the per-shape facets and a domain fold
//   z 39  every shape blend, a box and a sphere in two colours
//   z 44  the domain folds, erosion and creation noise
//   z 49  parameter forms: exponents, tapers, rounded and chamfered profiles, path holes, shears and closed strokes
//   z 54  surfaces: palette channels, weathering, panels, trims, paints, text runs, volumes, a state-bound colour
//   z 59  motion through the stamp pool: rotation, swing, slide, parent chains, moving blends and cuts, moving folds
//   z 64  motion II: paints and an inset on moving surfaces, twist and bend, a radial pulse, cells, a volume, IK, frames
//
// shapes.md beside this file holds the coverage table, the operator camera line that frames each exhibit and the
// console controls the motion rows answer to.

let galleryX = 14
let gallerySpacing = 3

let uniformRow = ["shape-sphere", "shape-box", "shape-torus", "shape-cylinder", "shape-capsule", "shape-ellipsoid", "shape-round-cone", "shape-cone", "shape-superellipsoid", "shape-plane"]
let stretchedRow = ["shape-sphere-xyz", "shape-box-xyz", "shape-torus-xz", "shape-torus-y", "shape-cylinder-xz", "shape-capsule-xz", "shape-ellipsoid-xyz", "shape-round-cone-xyz", "shape-cone-xz", "shape-superellipsoid-xyz"]
let extrudeRow = ["shape-trapezoid", "shape-rounded-rectangle", "shape-polygon-6", "shape-polygon-12", "shape-polygon-12-xy", "shape-ellipse", "shape-chamfered-rectangle", "shape-convex", "shape-path-fill", "shape-path-stroke", "shape-path-stroke-xy"]
let revolveRow = ["shape-revolve-trapezoid", "shape-revolve-rounded-rectangle", "shape-revolve-polygon-6", "shape-revolve-ellipse", "shape-revolve-chamfered-rectangle", "shape-revolve-convex"]
let facetRow = ["shape-sweep", "shape-sweep-tapered", "shape-sweep-strands", "shape-rounding", "shape-chamfer", "shape-onion", "shape-dilate", "shape-flare", "shape-shear", "shape-bumps", "shape-cells-f1", "shape-cells-f2", "shape-polar-fold"]
let foldRow = ["shape-symmetry", "shape-repeat", "shape-repeat-grid", "shape-repeat-even", "shape-repeat-clipped", "shape-polar-mirror", "shape-polar-z", "shape-polar-stride", "shape-wallpaper-pmm", "shape-wallpaper-p4m", "shape-wallpaper-p3m1", "shape-wallpaper-p6m", "shape-wallpaper-stride", "shape-erode", "shape-noise"]
let formRow = ["shape-superellipsoid-2", "shape-superellipsoid-8", "shape-prism-triangle", "shape-prism-rectangle", "shape-polygon-3", "shape-prism-rounding", "shape-prism-chamfer", "shape-cylinder-chamfer", "shape-revolve-solid", "shape-path-holes", "shape-path-shear", "shape-path-closed-stroke", "shape-path-stroke-ramp", "shape-sweep-braid"]
let surfaceRow = ["shape-metal", "shape-coat", "shape-sheen", "shape-emissive", "shape-wrap-soften", "shape-fill-bleed", "shape-weathering-edge", "shape-weathering-lines", "shape-weathering-settle", "shape-panel-recess", "shape-panel-raise", "shape-trims", "shape-paint-world", "shape-text-engrave", "shape-text-ride", "shape-volume-flow", "shape-volume-cloud", "shape-state-color"]
let motionRow = ["motion-spin", "motion-rock", "motion-slide", "motion-chain", "motion-smooth-blend", "motion-state-blend", "motion-carve", "motion-mirror", "motion-polar"]
let motionRowB = ["motion-paint", "motion-inset", "motion-twist", "motion-bend", "motion-pulse", "motion-cells", "motion-volume", "motion-ik", "motion-frames"]

let foldZ = 44
let surfaceZ = 54
let motionZB = 64

let galleryPentagon = [[0, 1], [0.95, 0.31], [0.59, -0.81], [-0.59, -0.81], [-0.95, 0.31]]

// Slot 0 the exhibit, slot 1 the plinth, slot 2 the label, slot 3 an exhibit's own second material (a blend's tool,
// a palette channel under test) and slots past it whatever else an exhibit appends.
let exhibitMaterial = 0
let accentMaterial = 3
let galleryPalette = [
  { color: "#B9C4D0", roughness: 0.45, specular: 0.3 }
  { color: "#3A3F47", roughness: 0.85 }
  { color: "#F2EEE4", roughness: 0.6 }
]
let accent = { color: "#D9822B", roughness: 0.45, specular: 0.3 }

// The palette, the plinth beneath the exhibit and the plinth's label. Expanded after the exhibit's own shapes, so an
// exhibit's subtraction or intersection never reaches the plinth. `extra` appends palette slots from 3 on, and `runs`
// text runs after the label.
template exhibit(label, extra = [], runs = []) {
  name: label
  schema: "puck.creation.v1"
  palette: concat(galleryPalette, extra)
  shape Box "plinth" {
    material: 1
    position [0, 0.15, 0]
    scale [0.6, 0.15, 0.25]
  }
  textRuns: concat([{ text: label, position [0, 0.15, 0.25], rotation [0, 0, 0, 1], emHeight: 0.1, depth: 0.006, mode: "emboss", material: 2, align: "center" }], runs)
}

template galleryRow(names, z) {
  for (name, index) in names {
    placement $"{name}" {
      prototype: name
      position [(galleryX + (gallerySpacing * index)), 0, z]
    }
  }
}

template galleryPlacements() {
  galleryRow(names: uniformRow, z: 14)
  galleryRow(names: stretchedRow, z: 19)
  galleryRow(names: extrudeRow, z: 24)
  galleryRow(names: revolveRow, z: 29)
  galleryRow(names: facetRow, z: 34)
  galleryRow(names: map(blendExhibits, entry => entry.id), z: 39)
  galleryRow(names: foldRow, z: foldZ)
  galleryRow(names: formRow, z: 49)
  galleryRow(names: surfaceRow, z: surfaceZ)
  galleryRow(names: motionRow, z: 59)
  galleryRow(names: motionRowB, z: motionZB)
}

// The gallery's motion controls. Every driver in the motion rows reads `galleryClock`, gallery seconds advancing at the
// row's rate; a rate of zero freezes every pose where it stands, and writing the cell scrubs it. Each driver is gated on
// `galleryMotion.all` and on its exhibit's own `galleryMotion` key: a zero eases that exhibit back to its rest pose.
// `galleryInputs` holds text cells three exhibits read: `probe` places motion-state-blend's sphere, `reach` is the world
// point motion-ik's arm reaches for, and `tint` colours shape-state-color. shapes.md gives the console lines.
let reachX = (galleryX + (gallerySpacing * 7))

template galleryState() {
  slot galleryClock = 0.5 advance(perSecond: 1)

  table galleryMotion {
    all = 1
    spin = 1
    rock = 1
    slide = 1
    chain = 1
    blend = 1
    carve = 1
    mirror = 1
    polar = 1
    paint = 1
    inset = 1
    twist = 1
    bend = 1
    pulse = 1
    cells = 1
    volume = 1
    ik = 1
  }

  table galleryInputs {
    probe = "[0.3, 1.35, 0.05]"
    reach = $"[{reachX + 0.35}, 1.45, {motionZB - 0.25}]"
    tint = "#D9822B"
  }
}

// The one driver every motion exhibit runs on: the gallery clock times `cadence` radians a gallery second, gated on
// the whole gallery and on the exhibit's own key, its weight easing over `ease` seconds as a gate opens or closes.
template clockDriver(key, cadence = 1, ease = 0.3) {
  drivers [
    {
      name: "clock"
      signal: "state.galleryClock"
      cadence: cadence
      blendInSeconds: ease
      blendOutSeconds: ease
      "when" [
        "state.galleryMotion.all"
        $"state.galleryMotion.{key}"
      ]
    }
  ]
}

// Every shape blend: the box first, then the sphere in the accent colour blended into it, so a seam's material winner
// shows. The intersection family's sphere is larger and nearer the box's centre, so the two overlap enough to read.
let blendExhibits = [
  { id: "shape-blend-union", label: "UNION", blend: "Union", smooth: 0, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-blend-subtraction", label: "SUBTRACTION", blend: "Subtraction", smooth: 0, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-blend-intersection", label: "INTERSECTION", blend: "Intersection", smooth: 0, tool [0.1, 1.28, 0.08], radius [0.4, 0.4, 0.4] }
  { id: "shape-blend-xor", label: "XOR", blend: "Xor", smooth: 0, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-smooth-union", label: "SMOOTH UNION", blend: "SmoothUnion", smooth: 0.15, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-smooth-subtraction", label: "SMOOTH SUBTRACT", blend: "SmoothSubtraction", smooth: 0.1, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-smooth-intersection", label: "SMOOTH INTERSECT", blend: "SmoothIntersection", smooth: 0.1, tool [0.1, 1.28, 0.08], radius [0.4, 0.4, 0.4] }
  { id: "shape-chamfer-union", label: "CHAMFER UNION", blend: "ChamferUnion", smooth: 0.1, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-chamfer-subtraction", label: "CHAMFER SUBTRACT", blend: "ChamferSubtraction", smooth: 0.08, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-chamfer-intersection", label: "CHAMFER INTERSECT", blend: "ChamferIntersection", smooth: 0.08, tool [0.1, 1.28, 0.08], radius [0.4, 0.4, 0.4] }
  { id: "shape-groove-union", label: "GROOVE UNION", blend: "GrooveUnion", smooth: 0.05, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-pipe-union", label: "PIPE UNION", blend: "PipeUnion", smooth: 0.04, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-groove-subtraction", label: "GROOVE SUBTRACT", blend: "GrooveSubtraction", smooth: 0.04, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
  { id: "shape-pipe-subtraction", label: "PIPE SUBTRACT", blend: "PipeSubtraction", smooth: 0.04, tool [0.22, 1.42, 0.16], radius [0.28, 0.28, 0.28] }
]

template blendPrototypes() {
  for entry in blendExhibits {
    prototype $"{entry.id}" {
      document {
        shape Box "subject" {
          material: exhibitMaterial
          position [0, 1.2, 0]
          scale [0.32, 0.32, 0.32]
        }
        shape Sphere "tool" {
          blend: entry.blend
          material: accentMaterial
          position: entry.tool
          scale: entry.radius
          smooth: entry.smooth
        }
        exhibit(label: entry.label, extra: [accent])
      }
    }
  }
}

// The six petals motion-pulse slides out from its core and back, sixty degrees apart in the plane facing the label.
let pulsePetals = [
  { name: "petal-0", at [0.27, 1.2, 0], out [1, 0, 0] }
  { name: "petal-1", at [0.135, 1.43383, 0], out [0.5, 0.866025, 0] }
  { name: "petal-2", at [-0.135, 1.43383, 0], out [-0.5, 0.866025, 0] }
  { name: "petal-3", at [-0.27, 1.2, 0], out [-1, 0, 0] }
  { name: "petal-4", at [-0.135, 0.96617, 0], out [-0.5, -0.866025, 0] }
  { name: "petal-5", at [0.135, 0.96617, 0], out [0.5, -0.866025, 0] }
]

// The domain folds, erosion and creation noise. A fold acts in creation space before the shape's own transform, and
// a repeat or polar origin is engine-frame: an author-frame point [x, y, z] is origin [-x, y, -z].
template foldPrototypes() {
  prototype "shape-symmetry" {
    document {
      shape Capsule "subject" {
        domain [
          symmetry(normal: [1, 0, 0])
        ]
        material: exhibitMaterial
        position [0.25, 1.2, 0]
        rotation [0, 0, 0.258819, 0.965926]
        scale [0.08, 0.25, 0.08]
      }
      exhibit(label: "SYMMETRY")
    }
  }
  prototype "shape-repeat" {
    document {
      shape Sphere "subject" {
        domain [
          repeat(spacing: [0.25, 1, 1], limit: [2, 0, 0])
        ]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.1, 0.1, 0.1]
      }
      exhibit(label: "REPEAT 5")
    }
  }
  prototype "shape-repeat-grid" {
    document {
      shape Box "subject" {
        domain [
          repeat(spacing: [0.22, 1, 0.22], limit: [1, 0, 1])
        ]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.07, 0.07, 0.07]
      }
      exhibit(label: "REPEAT 3X3")
    }
  }
  // Four copies: the symmetry fold keeps author +X, and the repeat lays three cells from engine x -0.375 to 0.125,
  // the last of which lies in the folded-away half.
  prototype "shape-repeat-even" {
    document {
      shape Sphere "subject" {
        domain [
          symmetry(normal: [1, 0, 0])
          repeat(spacing: [0.25, 1, 1], limit: [1, 0, 0], origin: [-0.125, 0, 0])
        ]
        material: exhibitMaterial
        position [0.125, 1.2, 0]
        scale [0.09, 0.09, 0.09]
      }
      exhibit(label: "REPEAT EVEN")
    }
  }
  // An unbounded lattice clipped by an intersection: the creation-wide scope keeps the clip off every other placement.
  // The sphere sits in the lattice's central cell, at the creation origin; a shape authored off it is never reached.
  prototype "shape-repeat-clipped" {
    document {
      shape Sphere "lattice" {
        domain [
          repeat(spacing: [0.18, 0.18, 0.18])
        ]
        material: exhibitMaterial
        position [0, 0, 0]
        scale [0.06, 0.06, 0.06]
      }
      shape Sphere "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "REPEAT CLIPPED")
    }
  }
  prototype "shape-polar-mirror" {
    document {
      shape Box "subject" {
        domain [
          polar(count: 5, axis: Y, mirror: true)
        ]
        material: exhibitMaterial
        position [0, 1.2, 0.3]
        rotation [0, 0, 0.258819, 0.965926]
        scale [0.05, 0.25, 0.1]
      }
      exhibit(label: "POLAR MIRROR")
    }
  }
  prototype "shape-polar-z" {
    document {
      shape Box "subject" {
        domain [
          polar(count: 8, axis: Z, origin: [0, 1.2, 0])
        ]
        material: exhibitMaterial
        position [0, 1.5, 0]
        scale [0.04, 0.12, 0.04]
      }
      exhibit(label: "POLAR Z")
    }
  }
  prototype "shape-polar-stride" {
    document {
      shape Sphere "subject" {
        domain [
          polar(count: 6, axis: Y, materialStride: 1)
        ]
        material: accentMaterial
        position [0, 1.2, 0.32]
        scale [0.12, 0.12, 0.12]
      }
      exhibit(label: "POLAR STRIDE", extra: [accent, { color: "#2B7BD9", roughness: 0.45 }, { color: "#3FA34D", roughness: 0.45 }, { color: "#C23B3B", roughness: 0.45 }, { color: "#8E5BD9", roughness: 0.45 }, { color: "#E3C547", roughness: 0.45 }])
    }
  }
  // Each wallpaper tile sits inside its group's fundamental region of the cell (`SdfWallpaperFold.Fold`), in the
  // engine frame, so author [x, y, z] lands at [-x, y, -z]: Pmm's positive quadrant, P4M below the diagonal, P3M1's
  // wedge from 30 to 90 degrees and P6M's from 30 to 60. A tile outside its region folds onto nothing and draws nothing.
  prototype "shape-wallpaper-pmm" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: Pmm, limit: [1, 1])
        ]
        material: exhibitMaterial
        position [-0.07, 1.2, -0.06]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.07, 0.03, 0.02]
      }
      exhibit(label: "WALLPAPER PMM")
    }
  }
  prototype "shape-wallpaper-p4m" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P4M, limit: [1, 1])
        ]
        material: exhibitMaterial
        position [-0.08, 1.2, -0.025]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.07, 0.03, 0.02]
      }
      exhibit(label: "WALLPAPER P4M")
    }
  }
  // A hex group carries no limit: an intersection inside the creation-wide scope bounds the lattice.
  prototype "shape-wallpaper-p3m1" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P3M1)
        ]
        material: exhibitMaterial
        position [-0.03, 1.2, -0.08]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.06, 0.03, 0.02]
      }
      shape Cylinder "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.1, 0.5]
      }
      exhibit(label: "WALLPAPER P3M1")
    }
  }
  prototype "shape-wallpaper-p6m" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P6M)
        ]
        material: exhibitMaterial
        position [-0.06, 1.2, -0.06]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.06, 0.03, 0.02]
      }
      shape Cylinder "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.1, 0.5]
      }
      exhibit(label: "WALLPAPER P6M")
    }
  }
  prototype "shape-wallpaper-stride" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P4M, limit: [1, 1], materialStride: 1)
        ]
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.13, 0.04, 0.13]
      }
      exhibit(label: "WALLPAPER STRIDE", extra: [accent, { color: "#2B7BD9", roughness: 0.45 }])
    }
  }
  // A static placement supplies no render lanes, so the lane reads zero: halfway through this from/to window.
  prototype "shape-erode" {
    document {
      shape Sphere "subject" {
        erode {
          lane: 0
          from: -1
          to: 1
          noise: 6
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "ERODE")
    }
  }
  // Creation noise displaces the whole creation's field, the plinth and its label included.
  prototype "shape-noise" {
    document {
      noise {
        frequency: 5
        amplitude: 0.025
        seed: 11
      }
      shape Sphere "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "NOISE")
    }
  }
}

// The parameter forms the first five rows leave out: exponent and taper extremes, the three-sided polygon, rounded and
// chamfered prisms and cylinders, a solid of revolution, and the path profile's holes, shear, closed stroke and radius
// ramp.
template formPrototypes() {
  prototype "shape-superellipsoid-2" {
    document {
      shape Superellipsoid "subject" {
        exponent: 2
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "SUPER EXP 2")
    }
  }
  prototype "shape-superellipsoid-8" {
    document {
      shape Superellipsoid "subject" {
        exponent: 8
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "SUPER EXP 8")
    }
  }
  prototype "shape-prism-triangle" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.45, 0.2]
        taper: 0
      }
      exhibit(label: "TAPER 0")
    }
  }
  prototype "shape-prism-rectangle" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.4, 0.2]
        taper: 1
      }
      exhibit(label: "TAPER 1")
    }
  }
  prototype "shape-polygon-3" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Polygon"
          sides: 3
        }
        scale [0.5, 0.5, 0.2]
      }
      exhibit(label: "POLYGON 3")
    }
  }
  prototype "shape-prism-rounding" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Polygon"
          sides: 6
        }
        rounding: 0.06
        scale [0.5, 0.5, 0.2]
      }
      exhibit(label: "PRISM ROUNDING")
    }
  }
  prototype "shape-prism-chamfer" {
    document {
      shape Prism "subject" {
        chamfer: 0.06
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Ellipse"
        }
        scale [0.55, 0.38, 0.2]
      }
      exhibit(label: "PRISM CHAMFER")
    }
  }
  prototype "shape-cylinder-chamfer" {
    document {
      shape Cylinder "subject" {
        chamfer: 0.08
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0.4]
      }
      exhibit(label: "CYLINDER CHAMFER")
    }
  }
  prototype "shape-revolve-solid" {
    document {
      shape Prism "subject" {
        lift: "Revolve"
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0]
        taper: 0.3
      }
      exhibit(label: "REV SOLID")
    }
  }
  // An even-odd fill: a square whose right side is a cubic Bezier, holed by a circle of two arcs.
  prototype "shape-path-holes" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            contours [
              {
                start [-0.8, -0.8]
                segments [
                  {
                    end [0.8, -0.8]
                  }
                  {
                    end [0.8, 0.8]
                    control [0.95, -0.3]
                    control2 [0.6, 0.3]
                  }
                  {
                    end [-0.8, 0.8]
                  }
                  {
                    end [-0.8, -0.8]
                  }
                ]
              }
              {
                start [0.35, 0]
                segments [
                  {
                    end [-0.35, 0]
                    arcCenter [0, 0]
                  }
                  {
                    end [0.35, 0]
                    arcCenter [0, 0]
                  }
                ]
              }
            ]
          }
        }
        scale [0.5, 0.5, 0.1]
      }
      exhibit(label: "PATH HOLES")
    }
  }
  prototype "shape-path-shear" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            shear {
              linear: 0.2
              quadratic: 0.4
              target: 0
            }
            contours [
              {
                start [-0.5, -0.7]
                segments [
                  {
                    end [0.5, -0.7]
                  }
                  {
                    end [0.5, 0.7]
                  }
                  {
                    end [-0.5, 0.7]
                  }
                  {
                    end [-0.5, -0.7]
                  }
                ]
              }
            ]
          }
        }
        scale [0.5, 0.5, 0.1]
      }
      exhibit(label: "PATH SHEAR")
    }
  }
  prototype "shape-path-closed-stroke" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            stroke {
              radiusStart: 0.06
              radiusEnd: 0.06
            }
            contours [
              {
                start [-0.6, 0]
                closed: true
                segments [
                  {
                    end [0.6, 0]
                    control [-0.6, 0.85]
                    control2 [0.6, 0.85]
                  }
                  {
                    end [-0.6, 0]
                    control [0.6, -0.85]
                    control2 [-0.6, -0.85]
                  }
                ]
              }
            ]
          }
        }
        scale [0.6, 0.6, 0.08]
      }
      exhibit(label: "PATH CLOSED")
    }
  }
  // A linear radius ramp over the middle half of the stroke, along a clockwise arc and a line.
  prototype "shape-path-stroke-ramp" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            stroke {
              radiusStart: 0.1
              radiusEnd: 0.02
              smooth: false
              from: 0.25
              to: 0.75
            }
            contours [
              {
                start [-0.6, -0.3]
                segments [
                  {
                    end [0.6, -0.3]
                    arcCenter [0, -0.3]
                    clockwise: true
                  }
                  {
                    end [0.6, 0.6]
                  }
                ]
              }
            ]
          }
        }
        scale [0.6, 0.6, 0.08]
      }
      exhibit(label: "PATH RAMP")
    }
  }
  prototype "shape-sweep-braid" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.7, 0]
        curve {
          a [0, 0, 0]
          b [0.2, 0.5, 0]
          c [0, 1.0, 0]
          radiusStart: 0.04
          radiusEnd: 0.04
          strands: 4
          strandOffset: 0.08
          twist: 2
        }
      }
      exhibit(label: "SWEEP BRAID")
    }
  }
}

// The static paint's world-space plane: a static placement shares one palette and draws an unparented paint in world
// space, so the stripe names its own exhibit's place in the surface row (index 12).
let paintX = (galleryX + (gallerySpacing * 12))

// Surfaces: palette channels, weathering, panels, trims, a world-space paint, text runs, volumes and a state-bound
// colour, each on slot 3.
template surfacePrototypes() {
  prototype "shape-metal" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "METAL", extra: [{ color: "#D4AF37", metal: 1, roughness: 0.25, specular: 0.5 }])
    }
  }
  prototype "shape-coat" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "COAT", extra: [{ color: "#B3261E", specular: 0.35, roughness: 0.4, coat: 0.5 }])
    }
  }
  prototype "shape-sheen" {
    document {
      shape Box "subject" {
        chamfer: 0.08
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.38, 0.38, 0.38]
      }
      exhibit(label: "SHEEN", extra: [{ color: "#4A6FA5", roughness: 0.7, sheen: 1 }])
    }
  }
  prototype "shape-emissive" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "EMISSIVE", extra: [{ color: "#FFB347", emissive: 3 }])
    }
  }
  prototype "shape-wrap-soften" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.18
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "WRAP SOFTEN", extra: [{ color: "#C9A27E", roughness: 0.6, wrap: 0.6, soften: 1 }])
    }
  }
  prototype "shape-fill-bleed" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "FILL BLEED", extra: [{ color: "#DDDDDD", roughness: 0.8, fill: "#2F5BFF", bleed: "#FF5A1F", receive: 1.5 }])
    }
  }
  prototype "shape-weathering-edge" {
    document {
      shape Cylinder "subject" {
        rounding: 0.1
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.38, 0.38, 0.38]
      }
      exhibit(label: "WEAR EDGE", extra: [{ color: "#2E6B3A", roughness: 0.5, weathering { edge: 1, reach: 0.08, floor: 1, seed: 5, under [{ threshold: 0.25, surface { color: "#B5895B", roughness: 0.8, metal: 0 } }, { threshold: 0.6, surface { color: "#9AA0A6", roughness: 0.3, metal: 1 } }] } }])
    }
  }
  prototype "shape-weathering-lines" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "WEAR LINES", extra: [{ color: "#7A2E2E", roughness: 0.5, weathering { lines: 0.6, floor: 1, scale: 4, seed: 9, under [{ threshold: 0.2, surface { color: "#C0C4C8", roughness: 0.3, metal: 1 } }] } }])
    }
  }
  prototype "shape-weathering-settle" {
    document {
      shape Torus "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "WEAR SETTLE", extra: [{ color: "#3B4A5A", roughness: 0.5, weathering { settle: 1, floor: 1, deposit { color: "#F4F1EA", roughness: 0.95, metal: 0 } } }])
    }
  }
  prototype "shape-panel-recess" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        panel {
          inset: 0.06
          depth: 0.03
          material: accentMaterial
        }
        position [0, 1.2, 0]
        scale [0.4, 0.35, 0.12]
      }
      exhibit(label: "PANEL RECESS", extra: [accent])
    }
  }
  prototype "shape-panel-raise" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        panel {
          inset: 0.06
          depth: -0.03
          material: accentMaterial
        }
        position [0, 1.2, 0]
        scale [0.4, 0.35, 0.12]
      }
      exhibit(label: "PANEL RAISE", extra: [accent])
    }
  }
  // The trim band follows the thin slab hidden inside the box, round its equator.
  prototype "shape-trims" {
    document {
      shape Box "band" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.34, 0.004, 0.34]
      }
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.35, 0.35, 0.35]
        trims [
          {
            shape: "band"
            width: 0.03
            material: accentMaterial
          }
        ]
      }
      exhibit(label: "TRIMS", extra: [accent])
    }
  }
  prototype "shape-paint-world" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "PAINT WORLD", extra: [{ color: "#B9C4D0", roughness: 0.45, specular: 0.3, paints [{ type: "Plane", position [paintX, 1.2, surfaceZ], rotation [0, 0, 0.258819, 0.965926], stroke: 0.035, color: "#1F4E79" }] }])
    }
  }
  prototype "shape-text-engrave" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.25, 0.08]
      }
      exhibit(label: "TEXT ENGRAVE", extra: [accent], runs: [{ text: "ENGRAVED", position [0, 1.2, 0.08], rotation [0, 0, 0, 1], emHeight: 0.13, depth: 0.012, mode: "engrave", material: accentMaterial, align: "center" }])
    }
  }
  prototype "shape-text-ride" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [0, 0, 0.173648, 0.984808]
        scale [0.45, 0.3, 0.05]
      }
      exhibit(label: "TEXT ON SHAPE", extra: [accent], runs: [{ text: "TEXT RIDES A SHAPE", shapeId: 0, position [0, 0, 1], rotation [0, 0, 0, 1], emHeight: 0.08, depth: 0.004, maxWidth: 0.7, tracking: 0.05, lineSpacing: 1.2, material: accentMaterial, align: "center" }])
    }
  }
  // A flow runs from its box's +Y face toward -Y; the half-turn about X puts the mouth on the nozzle and the plume above.
  prototype "shape-volume-flow" {
    document {
      shape Cylinder "nozzle" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        scale [0.07, 0.15, 0.07]
      }
      volumes [
        {
          kind: "flow"
          position [0, 1.35, 0]
          rotation [1, 0, 0, 0]
          halfExtent [0.2, 0.4, 0.2]
          axis: 0.8
          width: 0.06
          spread: 3
          fade: 1.2
          noiseScale: 0.06
          noiseDepth: 0.5
          speed: 1.2
          seed: 7
          steps: 40
          intensity: 30
          pulseAmplitude: 0.2
          pulseFrequency: 3
          ramp [
            {
              density: 0
              color: "#7A1F0B"
            }
            {
              density: 0.4
              color: "#E2571E"
            }
            {
              density: 1
              color: "#FFE9A8"
            }
          ]
        }
      ]
      exhibit(label: "VOLUME FLOW")
    }
  }
  prototype "shape-volume-cloud" {
    document {
      volumes [
        {
          kind: "cloud"
          position [0, 1.25, 0]
          rotation [0, 0, 0, 1]
          halfExtent [0.45, 0.3, 0.45]
          width: 0.2
          extinction: 4
          coverage: 0.6
          softness: 0.25
          ramp [
            {
              density: 0
              color: "#FFFFFF"
            }
            {
              density: 1
              color: "#C8D2DC"
            }
          ]
        }
      ]
      exhibit(label: "VOLUME CLOUD")
    }
  }
  prototype "shape-state-color" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "STATE COLOR", extra: [{ color: "state.galleryInputs.tint", roughness: 0.45, specular: 0.3 }])
    }
  }
}

// Motion through the stamp pool: every prototype here carries a driver (or frames, or an effector), so its placement
// replays through the dynamic stamp path rather than stamping statically. Blends between shapes ride only inside a
// nonzero `group` there; an ungrouped shape unions.
template motionPrototypes() {
  prototype "motion-spin" {
    document {
      clockDriver(key: "spin", cadence: 0.8, ease: 0)
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.15, 0.25]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 1
            pivot [0, 1.2, 0]
            wave: "linear"
          }
        ]
      }
      exhibit(label: "SPIN", extra: [{ color: "#7A2E2E", roughness: 0.5, weathering { lines: 0.6, floor: 1, scale: 4, seed: 9, under [{ threshold: 0.2, surface { color: "#C0C4C8", roughness: 0.3, metal: 1 } }] } }])
    }
  }
  prototype "motion-rock" {
    document {
      clockDriver(key: "rock", cadence: 2)
      shape Sphere "hook" {
        material: exhibitMaterial
        position [0, 1.65, 0]
        scale [0.05, 0.05, 0.05]
      }
      shape Cylinder "subject" {
        material: exhibitMaterial
        position [0, 1.375, 0]
        scale [0.025, 0.225, 0.025]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.6
            pivot [0, 1.65, 0]
          }
        ]
      }
      shape Sphere "bob" {
        material: accentMaterial
        parent: "subject"
        position [0, 1.05, 0]
        scale [0.12, 0.12, 0.12]
      }
      exhibit(label: "ROCK", extra: [accent])
    }
  }
  prototype "motion-slide" {
    document {
      clockDriver(key: "slide", cadence: 1.5)
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.22, 0.22, 0.22]
        slides [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.35
          }
        ]
      }
      exhibit(label: "SLIDE", extra: [accent])
    }
  }
  prototype "motion-chain" {
    document {
      clockDriver(key: "chain", cadence: 1.6)
      shape Box "upper" {
        material: exhibitMaterial
        position [0, 1.45, 0]
        scale [0.05, 0.2, 0.05]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.5
            pivot [0, 1.65, 0]
          }
        ]
      }
      shape Box "lower" {
        material: exhibitMaterial
        parent: "upper"
        position [0, 1.07, 0]
        scale [0.04, 0.18, 0.04]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.8
            phase: 1.2
            pivot [0, 1.25, 0]
            wave: "halfSine"
          }
        ]
      }
      shape Sphere "bob" {
        material: accentMaterial
        parent: "lower"
        position [0, 0.85, 0]
        scale [0.07, 0.07, 0.07]
      }
      exhibit(label: "PARENT CHAIN", extra: [accent])
    }
  }
  // The sphere slides along the side of the still box, through a smooth union. The group bakes once, at the pose its
  // program arrived in, and skins each vertex to its winning shape's slot, so the seam stretches as the sphere moves
  // away. The sphere stays partly outside the box over the whole slide: a sphere the bake found inside the box would
  // bake into no surface and never draw.
  prototype "motion-smooth-blend" {
    document {
      clockDriver(key: "blend", cadence: 1.2)
      shape Box "anchor" {
        group: 1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "visitor" {
        blend: SmoothUnion
        group: 1
        material: accentMaterial
        position [0.35, 1.2, 0]
        scale [0.18, 0.18, 0.18]
        smooth: 0.15
        slides [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.15
          }
        ]
      }
      exhibit(label: "MOVING BLEND", extra: [accent])
    }
  }
  // The same pair stamped statically, its sphere placed by the galleryInputs probe cell: each write re-emits the creation
  // and rebakes the seam exactly, where motion-smooth-blend skins one baked seam.
  prototype "motion-state-blend" {
    document {
      shape Box "anchor" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "visitor" {
        blend: SmoothUnion
        material: accentMaterial
        position: "state.galleryInputs.probe"
        scale [0.18, 0.18, 0.18]
        smooth: 0.15
      }
      exhibit(label: "STATE BLEND", extra: [accent])
    }
  }
  // A cutter sliding across the face of a still box: a cut face keeps the slot of the shape it shapes.
  prototype "motion-carve" {
    document {
      clockDriver(key: "carve", cadence: 1.2)
      shape Box "block" {
        group: 1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.3, 0.3, 0.3]
      }
      shape Sphere "cutter" {
        blend: Subtraction
        group: 1
        material: accentMaterial
        position [0, 1.25, 0.3]
        scale [0.2, 0.2, 0.2]
        slides [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.3
          }
        ]
      }
      exhibit(label: "MOVING CUT", extra: [accent])
    }
  }
  // A folded shape may not swing, but it rides its parent: the symmetry plane yaws with the hinge.
  prototype "motion-mirror" {
    document {
      clockDriver(key: "mirror", cadence: 1.4)
      shape Box "hinge" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.06, 0.06, 0.06]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.7
            pivot [0, 1.2, 0]
          }
        ]
      }
      shape Capsule "wing" {
        domain [
          symmetry(normal: [1, 0, 0])
        ]
        material: accentMaterial
        parent: "hinge"
        position [0.28, 1.25, 0]
        rotation [0, 0, 0.5, 0.866025]
        scale [0.06, 0.16, 0.06]
      }
      exhibit(label: "MOVING MIRROR", extra: [accent])
    }
  }
  // The hub spins about Z through its centre, and the polar-folded blade rides it: one shape, eight spinning copies.
  prototype "motion-polar" {
    document {
      clockDriver(key: "polar", cadence: 0.9, ease: 0)
      shape Cylinder "hub" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.08, 0.05, 0.08]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 1
            pivot [0, 1.2, 0]
            wave: "linear"
          }
        ]
      }
      shape Box "blade" {
        domain [
          polar(count: 8, axis: Z, origin: [0, 1.2, 0])
        ]
        material: accentMaterial
        parent: "hub"
        position [0, 1.45, 0]
        scale [0.035, 0.14, 0.02]
      }
      exhibit(label: "MOVING POLAR", extra: [accent])
    }
  }
}

template motionPrototypesB() {
  // Parented paints ride their shape's own slot: a stroked plane stripe, a stroked ellipse ring, a filled pentagon and
  // a swept line, each in the panel's local frame.
  prototype "motion-paint" {
    document {
      clockDriver(key: "paint", cadence: 1.2)
      shape Box "panel" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.35, 0.3, 0.1]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.6
            pivot [0, 1.2, 0]
          }
        ]
      }
      exhibit(label: "MOVING PAINT", extra: [{ color: "#E8E4DA", roughness: 0.5, paints [{ parent: "panel", type: "Plane", position [0, 0.16, 0], stroke: 0.025, color: "#E4572E" }, { parent: "panel", type: "Prism", position [0.15, -0.08, 0], scale [0.09, 0.09, 0.2], profile { kind: "Ellipse" }, stroke: 0.012, color: "#1F4E79" }, { parent: "panel", type: "Prism", position [-0.17, -0.1, 0], scale [0.08, 0.08, 0.2], profile { kind: "Polygon", sides: 5 }, color: "#3FA34D" }, { parent: "panel", type: "Sweep", curve { a [-0.25, -0.22, 0.1], b [0, -0.12, 0.1], c [0.25, -0.22, 0.1], radiusStart: 0.012, radiusEnd: 0.012 }, color: "#171210" }] }])
    }
  }
  // An eye: a radial ramp of pupil, iris, limbus and sclera on a plane under a clear cornea, in the winning slot's
  // frame. An ungrouped pooled shape's hits win the creation root's slot, so the origin is the eye's centre in that
  // frame, and the half-turn about Y faces the plane toward the label side. The root does not swing, so the iris holds
  // still while the eye turns under it: what this exhibit shows until the layer frame follows the shape's own slot.
  prototype "motion-inset" {
    document {
      clockDriver(key: "inset", cadence: 0.9)
      shape Sphere "eye" {
        material: accentMaterial
        position [0, 1.25, 0]
        scale [0.25, 0.25, 0.25]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0, 1.25, 0]
          }
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.2
            phase: 1.5708
            pivot [0, 1.25, 0]
          }
        ]
      }
      exhibit(label: "MOVING INSET", extra: [{ color: "#FFFFFF", roughness: 0.1, specular: 0.4, coat: 0.6, inset { origin [0, 1.25, -0.25], rotation [0, 1, 0, 0], depth: 0.05, ior: 1.336, paint { stops [{ radius: 0.03, color: "#0B0B0B" }, { radius: 0.075, color: "#3A7BD5" }, { radius: 0.085, color: "#1A2A40" }, { radius: 0.095, color: "#F5F3EE" }], softness: 0.15, modulationAmplitude: 0.04, modulationFrequency: 40 } } }])
    }
  }
  // Twist and bend emit only on the stamp-pool path; a static placement ignores both. The twist's constant-wave swing is
  // a pose the driver's weight blends in: a lean that eases in and out with the exhibit's gate.
  prototype "motion-twist" {
    document {
      clockDriver(key: "twist", cadence: 0.8)
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.15, 0.4, 0.15]
        twist: 1.5
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0, 1.2, 0]
          }
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.25
            pivot [0, 0.8, 0]
            wave: "constant"
          }
        ]
      }
      exhibit(label: "TWIST", extra: [accent])
    }
  }
  prototype "motion-bend" {
    document {
      clockDriver(key: "bend", cadence: 0.8)
      shape Box "subject" {
        bend: 1.2
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.08, 0.4, 0.08]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0, 1.2, 0]
          }
        ]
      }
      exhibit(label: "BEND", extra: [accent])
    }
  }
  // A dynamic slot carries a rigid pose and no scale, so a pulse is six petals sliding out from a core and back, all
  // smooth-unioned in one group.
  prototype "motion-pulse" {
    document {
      clockDriver(key: "pulse", cadence: 2.5)
      shape Sphere "core" {
        group: 1
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.12, 0.12, 0.12]
      }
      for petal in pulsePetals {
        shape Sphere $"{petal.name}" {
          blend: SmoothUnion
          group: 1
          material: accentMaterial
          position: petal.at
          scale [0.09, 0.09, 0.09]
          smooth: 0.06
          slides [
            {
              driver: "clock"
              axis: petal.out
              amplitude: 0.1
            }
          ]
        }
      }
      exhibit(label: "RADIAL PULSE", extra: [accent])
    }
  }
  prototype "motion-cells" {
    document {
      clockDriver(key: "cells", cadence: 1)
      shape Sphere "subject" {
        cells {
          amplitude: 0.12
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.35, 0.35, 0.35]
        swings [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.5
            pivot [0, 1.2, 0]
          }
        ]
      }
      exhibit(label: "MOVING CELLS", extra: [accent])
    }
  }
  // The plume rides the nozzle's slot, so it tilts with the swing.
  prototype "motion-volume" {
    document {
      clockDriver(key: "volume", cadence: 1.2)
      shape Cylinder "nozzle" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        scale [0.07, 0.15, 0.07]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.4
            pivot [0, 0.65, 0]
          }
        ]
      }
      volumes [
        {
          kind: "flow"
          parent: "nozzle"
          position [0, 0.55, 0]
          rotation [1, 0, 0, 0]
          halfExtent [0.2, 0.4, 0.2]
          axis: 0.8
          width: 0.06
          spread: 3
          fade: 1.2
          noiseScale: 0.06
          noiseDepth: 0.5
          speed: 1.2
          seed: 7
          steps: 40
          intensity: 30
          ramp [
            {
              density: 0
              color: "#0B3A7A"
            }
            {
              density: 0.4
              color: "#1E8FE2"
            }
            {
              density: 1
              color: "#D8F4FF"
            }
          ]
        }
      ]
      exhibit(label: "MOVING VOLUME")
    }
  }
  // A two-bone arm solving toward the world point the galleryInputs reach cell holds.
  prototype "motion-ik" {
    document {
      shape Cylinder "base" {
        material: exhibitMaterial
        position [0, 0.95, 0]
        scale [0.07, 0.05, 0.07]
      }
      shape Cylinder "upper" {
        joint [0, 1.0, 0]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.035, 0.2, 0.035]
      }
      shape Cylinder "lower" {
        joint [0, 1.4, 0]
        material: exhibitMaterial
        parent: "upper"
        position [0, 1.58, 0]
        scale [0.03, 0.18, 0.03]
      }
      shape Sphere "hand" {
        material: accentMaterial
        parent: "lower"
        position [0, 1.76, 0]
        scale [0.06, 0.06, 0.06]
      }
      effectors [
        {
          name: "reach"
          chain [
            "upper"
            "lower"
          ]
          tip: "hand"
          "when" [
            "state.galleryMotion.all"
            "state.galleryMotion.ik"
          ]
          target {
            kind: "state"
            reference: "state.galleryInputs.reach"
          }
        }
      ]
      exhibit(label: "IK REACH", extra: [accent])
    }
  }
  // A hold-style timeline: the stamp pool steps an animated row's frames on the render clock, eight 60 Hz frames
  // each, whatever the gallery clock reads.
  prototype "motion-frames" {
    document {
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.15, 0.15, 0.15]
      }
      frames [
        {
          name: "left"
          transforms [
            {
              id: 0
              position [-0.25, 1.2, 0]
              rotation [0, 0, 0, 1]
            }
          ]
        }
        {
          name: "up"
          transforms [
            {
              id: 0
              position [0, 1.45, 0]
              rotation [0, 0, 0.382683, 0.92388]
            }
          ]
        }
        {
          name: "right"
          transforms [
            {
              id: 0
              position [0.25, 1.2, 0]
              rotation [0, 0, 0, 1]
            }
          ]
        }
        {
          name: "down"
          transforms [
            {
              id: 0
              position [0, 0.95, 0]
              rotation [0, 0.382683, 0, 0.92388]
            }
          ]
        }
      ]
      exhibit(label: "FRAMES", extra: [accent])
    }
  }
}

