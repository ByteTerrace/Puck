          cornerRadius: 0.05
        }
        scale [0.2, 0.2, 0.3]
      }
      exhibit(label: "REV CONVEX")
    }
  }

  // Sweeps, the per-shape facets and a domain fold.
  prototype "shape-sweep" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        curve {
          a [-0.4, 0, 0]
          b [0, 1.0, 0.2]
          c [0.4, 0, 0]
          radiusStart: 0.08
          radiusEnd: 0.08
        }
      }
      exhibit(label: "SWEEP")
    }
  }
  prototype "shape-sweep-tapered" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        curve {
          a [-0.4, 0, 0]
          b [0, 1.0, 0.2]
          c [0.4, 0, 0]
          radiusStart: 0.14
          radiusEnd: 0.04
          bulge: 0.06
        }
      }
      exhibit(label: "SWEEP TAPER")
    }
  }
  prototype "shape-sweep-strands" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.7, 0]
        curve {
          a [0, 0, 0]
          b [0, 0.5, 0]
          c [0, 1.0, 0]
          radiusStart: 0.04
          radiusEnd: 0.04
          strands: 3
          strandOffset: 0.08
          twist: 1.5
        }
      }
      exhibit(label: "SWEEP STRANDS")
    }
  }
  prototype "shape-rounding" {
    document {
      shape Cylinder "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rounding: 0.12
        scale [0.4, 0.4, 0.4]
      }
      exhibit(label: "ROUNDING")
    }
  }
  prototype "shape-chamfer" {
    document {
      shape Box "subject" {
        chamfer: 0.1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0.4]
      }
      exhibit(label: "CHAMFER")
    }
  }
  prototype "shape-onion" {
    document {
      shape Sphere "subject" {
        material: exhibitMaterial
        onion: 0.04
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      shape Box "window" {
        blend: Subtraction
        material: exhibitMaterial
        position [0, 1.45, 0.35]
        scale [0.35, 0.3, 0.35]
      }
      exhibit(label: "ONION")
    }
  }
  prototype "shape-dilate" {
    document {
      shape Box "subject" {
        dilate: 0.1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.3, 0.3, 0.3]
      }
      exhibit(label: "DILATE")
    }
  }
  prototype "shape-flare" {
    document {
      shape Cylinder "subject" {
        flare {
          amount: 0.8
          bulge: 0.2
          span: 1
          top: 0.5
          axis: 1
          startScale: 1
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.5, 0.25]
      }
      exhibit(label: "FLARE")
    }
  }
  prototype "shape-shear" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.2, 0.5, 0.2]
        shear {
          linear: 0.3
          quadratic: 0.6
          target: 0
          driver: 1
        }
      }
      exhibit(label: "SHEAR")
    }
  }
  prototype "shape-bumps" {
    document {
      shape Sphere "subject" {
        bumps [
          {
            center [0.35, 0.2, 0.3]
            radii [0.15, 0.15, 0.15]
            "push" [0.08, 0.05, 0.07]
          }
          {
            center [-0.3, -0.1, 0.35]
            radii [0.2, 0.1, 0.1]
            "push" [0.05, 0.02, -0.06]
          }
        ]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "BUMPS")
    }
  }
  prototype "shape-cells-f1" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.18
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "CELLS F1")
    }
  }
  prototype "shape-cells-f2" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.09
          frequency: 4
          mode: "F2MinusF1"
          randomness: 0.2
          seed: 3751
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "CELLS F2 F1")
    }
  }
  prototype "shape-polar-fold" {
    document {
      shape Box "subject" {
        domain [
          polar(count: 6, axis: Y)
        ]
        material: exhibitMaterial
        position [0, 1.2, 0.35]
        scale [0.1, 0.3, 0.06]
      }
      exhibit(label: "POLAR FOLD")
    }
  }

  blendPrototypes()
  foldPrototypes()
  formPrototypes()
  surfacePrototypes()
  motionPrototypes()
  motionPrototypesB()
}
