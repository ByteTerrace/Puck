{
  "$schema": "./puck.world.def.v1.schema.json",
  "basis": "brio-dual.world.json",
  "documentId": "brio-faerie",
  "metadata": {
    "description": "Three legs over one BRIO stream: the ir-marker probe tracks a strip of retroreflective tape on the wall and frames it as a painting quad; the ir-blob probe tracks the head and anchors the faerie probe's orbiting light there, relighting the color frame with it; 'probe.set faerie journey 1' sends the light into the painting, and the resulting portal channel spawns a faerie-glow placement in the world that flies to the nearest seat.",
    "tags": [
      "camera",
      "brio",
      "infrared",
      "probes",
      "faerie",
      "portal"
    ],
    "title": "BRIO Faerie"
  },
