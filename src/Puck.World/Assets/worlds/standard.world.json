  "kits": [
    {
      "actions": {
        "airLeap": {
          "onPress": {
            "effects": [
              {
                "$type": "planarImpulse",
                "bodyDirection": [
                  0,
                  0,
                  -1
                ],
                "durationSeconds": 1.0,
                "speed": 9
              },
              {
                "$type": "startTimer",
                "seconds": 1.0,
                "state": "globalCooldown"
              }
            ],
            "gate": {
              "$type": "all",
              "predicates": [
                {
                  "$type": "timerElapsed",
                  "state": "globalCooldown"
                },
                {
                  "$type": "now",
                  "fact": "Airborne"
                }
              ]
            }
          }
        },
        "dash": {
          "onPress": {
            "effects": [
              {
                "$type": "planarImpulse",
                "bodyDirection": [
                  0,
                  0,
                  -1
                ],
                "durationSeconds": 0.25,
                "speed": 14
              },
              {
                "$type": "startTimer",
                "seconds": 1.0,
                "state": "globalCooldown"
              }
            ],
            "gate": {
              "$type": "timerElapsed",
              "state": "globalCooldown"
            },
            "latchSeconds": 0.1
          }
        },
        "jump": {
          "onPress": {
            "effects": [
              {
                "$type": "setVerticalVelocity",
                "velocity": 11
              },
              {
                "$type": "addState",
                "state": "jumpCounter",
                "value": 1
              }
            ],
            "gate": {
              "$type": "compareState",
              "comparison": "Less",
              "state": "jumpCounter",
              "value": 2
            },
            "latchSeconds": 0.1
          },
          "onRelease": {
            "effects": [
              {
                "$type": "scaleVerticalVelocity",
                "factor": 0.45
              }
            ],
            "gate": {
              "$type": "now",
              "fact": "Rising"
            },
            "latchSeconds": 0
          }
        },
        "leap": {
          "onPress": {
            "effects": [
              {
                "$type": "setVerticalVelocity",
                "velocity": 16
              },
              {
                "$type": "planarImpulse",
                "bodyDirection": [
                  0,
                  0,
                  -1
                ],
                "durationSeconds": 1.0,
                "speed": 9
              },
              {
                "$type": "startTimer",
                "seconds": 1.0,
                "state": "globalCooldown"
              }
            ],
            "gate": {
              "$type": "all",
              "predicates": [
                {
                  "$type": "timerElapsed",
                  "state": "globalCooldown"
                },
                {
                  "$type": "recently",
                  "fact": "Grounded",
                  "windowSeconds": 0.09
                }
              ]
            },
            "latchSeconds": 0.1
          }
        }
      },
