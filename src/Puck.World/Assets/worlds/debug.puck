// The debug world: a flat 256 m ground under a clear day, with axis markers and reference cubes at the origin and
// the Moth avatar to walk it, an open-fronted coloured room beside them for judging indirect light, and a picture
// frame ahead of the spawn whose glass is a portal onto the garden (garden.puck). It is the plain starting point the
// island is built up from, in engine: boot it with `--world src/Puck.World/Assets/worlds/debug.puck`, edit this
// source, and `world.reload` recompiles it in place. debug.md beside it says how to demo and inspect the portals.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "debug"

import "skies.puck"

// The test room's palette slots.
let roomWhite = 0 // #E6E2DA
let roomRed = 1 // #C8322B
let roomGreen = 2 // #2FA84A

// The portal frame's palette slot.
let frameGold = 0 // #C9A43A

metadata {
  title: "Debug"
  description: "A flat 256 m ground under a clear day, with axis markers, 1, 2 and 4 m reference cubes, a coloured test room near the origin and a portal frame onto the garden."
}

// A traveller coming back from the garden arrives here, and the garden's windows onto this world observe it whole.
admission [
  {
    algorithm: ""
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 8
        capability: Drive
        exclusive: true
      }
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
    publicKey: ""
    subject: null
  }
]

references [
  {
    document: "garden"
    name: "garden"
  }
]

destinations [
  {
    durability: persisted
    name: "garden"
    reference: "garden"
    scope: global
  }
]

// How many levels of windows inside windows the presentation draws; a face past it shows its session's fallback colour.
views {
  nestingDepth: 3
}

placements {
  // One derived face screen: the portal frame's glass.
  policy {
    authoringHeadroomPlacements: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    derivedFaceScreens: 1
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  // Eight metres ahead of the spawn and three to the right, so the avatar at the spawn does not hide it from the chase
  // camera, facing +Z. Its glass shows the garden through the frame, as a window, and is a door: walking -Z through it
  // arrives at the garden's arrival frame, which stands at the same point facing away, so the crossing maps as the
  // identity and the walk carries straight on.
  placement "portal" {
    prototype: "frame"
    position [3, 0, -8]
    yawDegrees: 180
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "arrival/glass"
          destination: "garden"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "garden"
          fallback: "#FF00FF"
          projection: window
        }
      }
    ]
  }

  placement "axis-x" {
    prototype: "axis-x"
    position [8, 0.02, 0]
  }

  placement "axis-z" {
    prototype: "axis-z"
    position [0, 0.02, 8]
  }

  placement "axis-up" {
    prototype: "axis-up"
    position [0, 2, 0]
  }

  placement "cube-1m" {
    prototype: "cube-1m"
    position [-4, 0.5, 6]
    solid
  }

  placement "cube-2m" {
    prototype: "cube-2m"
    position [-7, 1, 6]
    solid
  }

  placement "cube-4m" {
    prototype: "cube-4m"
    position [-12, 2, 6]
    solid
  }

  placement "gi-corner" {
    prototype: "gi-corner"
    position [-2, 0, 13]
    yawDegrees: -45
    solid
  }
}

prototypes {
  prototype "floor" {
    document {
      name: "floor"
      palette [
        {
          color: "#8C8C8C"
          roughness: 0.9
          specular: 0.02
        }
      ]
      schema: "puck.creation.v1"
      shape Box "ground" {
        material: 0
        position [0, -0.2, 0]
        scale [128, 0.2, 128]
      }
    }
  }

  prototype "axis-x" {
    document {
      name: "axis-x"
      palette [
        {
          color: "#FF3B30"
          roughness: 0.6
        }
      ]
      schema: "puck.creation.v1"
      shape Box "line" {
        material: 0
        position [0, 0, 0]
        scale [8, 0.02, 0.05]
      }
    }
  }

  prototype "axis-z" {
    document {
      name: "axis-z"
      palette [
        {
          color: "#2F6BFF"
          roughness: 0.6
        }
      ]
      schema: "puck.creation.v1"
      shape Box "line" {
        material: 0
        position [0, 0, 0]
        scale [0.05, 0.02, 8]
      }
    }
  }

  prototype "axis-up" {
    document {
      name: "axis-up"
      palette [
        {
          color: "#F2F2F2"
          roughness: 0.6
        }
      ]
      schema: "puck.creation.v1"
      shape Box "pole" {
        material: 0
        position [0, 0, 0]
        scale [0.04, 2, 0.04]
      }
    }
  }

  prototype "cube-1m" {
    document {
      name: "cube-1m"
      palette [
        {
          color: "#E8B341"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [0.5, 0.5, 0.5]
      }
    }
  }

  prototype "cube-2m" {
    document {
      name: "cube-2m"
      palette [
        {
          color: "#5BC98C"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [1, 1, 1]
      }
    }
  }

  // A Cornell-style room for judging indirect light: red and green side walls, a white back wall, ceiling and raised
  // floor, two white blocks, and one open side. Bounced light and colour bleed show inside it, where the open sky
  // elsewhere in this world hides them.
  prototype "gi-corner" {
    document {
      name: "gi-corner"
      palette [
        {
          color: "#E6E2DA"
          roughness: 0.9
          specular: 0.02
        }
        {
          color: "#C8322B"
          roughness: 0.9
          specular: 0.02
        }
        {
          color: "#2FA84A"
          roughness: 0.9
          specular: 0.02
        }
      ]
      schema: "puck.creation.v1"
      shape Box "floor" {
        material: roomWhite
        position [0, 0.05, 0]
        scale [2.1, 0.05, 2.1]
      }
      shape Box "red-wall" {
        material: roomRed
        position [-2.05, 1.6, 0]
        scale [0.05, 1.5, 2.1]
      }
      shape Box "green-wall" {
        material: roomGreen
        position [2.05, 1.6, 0]
        scale [0.05, 1.5, 2.1]
      }
      shape Box "back-wall" {
        material: roomWhite
        position [0, 1.6, -2.05]
        scale [2.1, 1.5, 0.05]
      }
      shape Box "ceiling" {
        material: roomWhite
        position [0, 3.15, 0]
        scale [2.1, 0.05, 2.1]
      }
      shape Box "low-block" {
        material: roomWhite
        position [0.8, 0.6, 0.4]
        scale [0.5, 0.5, 0.5]
      }
      shape Box "tall-block" {
        material: roomWhite
        position [-0.7, 1.1, -0.7]
        scale [0.5, 1, 0.5]
      }
    }
  }

  // A gilt picture frame round an open aperture. Face 0, the rim, carries the glass a face source shows on.
  prototype "frame" {
    document {
      behavior {
        faces [
          {
            name: "glass"
            shapeId: 0
          }
        ]
      }
      name: "frame"
      palette [
        {
          color: "#C9A43A"
          roughness: 0.4
          specular: 0.4
        }
      ]
      schema: "puck.creation.v1"
      shape Box "rim" {
        material: frameGold
        position [0, 1.75, 0]
        scale [1.25, 1.75, 0.08]
      }
      shape Box "opening" {
        blend: Subtraction
        material: frameGold
        position [0, 1.75, 0]
        scale [1.1, 1.6, 0.3]
      }
    }
  }

  prototype "cube-4m" {
    document {
      name: "cube-4m"
      palette [
        {
          color: "#5EEBE0"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [2, 2, 2]
      }
    }
  }
}

render {
  farDistance: 200
  sky {
    clearDay(cloudiness: 0.3)
  }
  atmosphere {
    clearDayAir()
  }
}
