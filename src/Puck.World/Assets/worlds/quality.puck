// The graphics presets every shipped world shares: `world.quality low|medium|high` applies one, each writing its
// shadow tier, its ambient-occlusion switch, its temporal-reconstruction switch and its render-scale tier into the live
// render levers. A world boots on its own render levers and nothing here changes them until a tier is chosen. `low` is
// the floor tier a player, or a Steam Deck, drops to; `high` is the fullest render. The standard world imports this
// table, so every world built on it inherits the table, and a world with another basis imports it by name.
render {
  low {
    shadows: Off
    ambientOcclusion: false
    temporal: false
    renderScale: Half
  }
  medium {
    shadows: Medium
    ambientOcclusion: true
    temporal: true
    renderScale: ThreeQuarter
  }
  high {
    shadows: High
    ambientOcclusion: true
    temporal: true
    renderScale: Native
  }
}
