{
  "$schema": "./puck.world.def.v1.schema.json",
  "basis": "brio-dual.world.json",
  "bindingOverlays": [
    {
      "document": {
        "chords": [
          {
            "chord": [],
            "group": "sense",
            "page": {
              "entries": [
                {
                  "channel": "turn",
                  "scale": 1,
                  "sources": [
                    "probe.head-x"
                  ]
                }
              ],
              "id": "base"
            }
          }
        ],
        "modifiers": [],
        "version": "puck.bindings.v1"
      },
      "id": "sense-turn"
    }
  ],
  "documentId": "brio-probe",
  "metadata": {
    "description": "The camera-probes vertical over the BRIO's infrared stream: an ir-blob probe feeding a turn axis, a film-grain presentation parameter, and a brightness control.",
    "tags": [
      "camera",
      "brio",
      "infrared",
      "probes"
    ],
    "title": "BRIO Probe"
  },
  "probes": [
    {
      "bindings": [
        {
          "$type": "axis",
          "channel": "x",
          "deadband": 0.04,
          "hysteresis": 0.01,
          "maxAgeSeconds": 0.25,
          "quantizeBits": 8,
          "smoothing": 0.25,
          "source": "head-x"
        },
        {
          "$type": "parameter",
          "channel": "luminance",
          "maxAgeSeconds": 0.5,
          "range": [
            0.0,
            0.35
          ],
          "target": {
            "$type": "extension",
            "field": "intensity",
            "id": "sdf-film-grain"
          }
        },
        {
          "$type": "control",
          "channel": "x",
          "control": "brightness",
          "maxAgeSeconds": 0.5,
          "maximum": 192,
          "minimum": 64
        }
      ],
      "config": {
        "minCoverage": 0.02,
        "threshold": 0.55
      },
      "id": "head",
      "inputs": {
        "lit": {
          "$type": "camera",
          "sensor": "Infrared"
        }
      },
      "kind": "ir-blob",
      "rateHz": 15
    }
  ],
  "render": {
    "extensions": [
      {
        "config": {
          "intensity": 0.0
        },
        "id": "sdf-film-grain"
      }
    ]
  },
  "simulation": {
    "rateHz": 30
  }
}