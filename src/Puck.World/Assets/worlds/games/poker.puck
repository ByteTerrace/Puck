// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

export action betAction1, betAction2, table
export binding bets, phase, stack
export read bets, community, hand1, hand2, phase, stack, table

rule "poker-transition" {
  when phase[street] != phase[next]
  mode: Level
  setState(fromKey: next, fromState: phase, key: street, state: phase)
}

rule "poker-deal" {
  when phase[street] == 0 and table[dealRequest] == 1 and (minimum(stack[1], stack[2]) >= house[bigBlind] : Int)
  local button = 3 - table[button]
  local blind = table[button]
  mode: Edge
  transaction {
    transform transfer(count: 2, draw: cardStream, from: deck, selector: Random, to: hand1)
    transform transfer(count: 2, draw: cardStream, from: deck, selector: Random, to: hand2)
    table[dealRequest] = 0
    setState(expression: button, key: button, state: table)
    setState(expression: button, key: bettor, state: table)
    streetBet[(button)] = house[smallBlind]
    streetBet[(blind)] = house[bigBlind]
    stack[(button)] += 0 - house[smallBlind]
    stack[(blind)] += 0 - house[bigBlind]
    table[pot] = house[smallBlind] + house[bigBlind]
    table[acted] = 0
    table[raises] = 0
    table[winner] = 0
    table[boardMask] = 0
    private1[hole] = 0
    private2[hole] = 0
    private1[strength] = 0
    private2[strength] = 0
    table[evalPending] = 1
    phase[next] = 1
  }
  audience1[0] = "seat1"
  audience2[0] = "seat2"
}

rule "poker-see-hand1" {
  when table[evalPending] == 1
  mode: Level
  forEach: hand1
  private1[hole] = private1[hole] | (1 << (16 * (suit[$each] - 1) + rank[$each] - 1))
}

rule "poker-see-hand2" {
  when table[evalPending] == 1
  mode: Level
  forEach: hand2
  private2[hole] = private2[hole] | (1 << (16 * (suit[$each] - 1) + rank[$each] - 1))
}

rule "poker-see-board" {
  when table[evalPending] == 1
  mode: Level
  forEach: community
  table[boardMask] = table[boardMask] | (1 << (16 * (suit[$each] - 1) + rank[$each] - 1))
}

rule "poker-evaluate-1" {
  when table[evalPending] == 1
  local s = private1[hole] | table[boardMask]
  local l0 = bitField(s, 0, 16)
  local l1 = bitField(s, 16, 16)
  local l2 = bitField(s, 32, 16)
  local l3 = bitField(s, 48, 16)
  local ranks = l0 | l1 | l2 | l3
  local pairs = (l0 & l1) | (l0 & l2) | (l0 & l3) | (l1 & l2) | (l1 & l3) | (l2 & l3)
  local trips = (l0 & l1 & l2) | (l0 & l1 & l3) | (l0 & l2 & l3) | (l1 & l2 & l3)
  local sf = (s | ((s >> 13) & repeatBits(1, 16))) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 1) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 2) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 3) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 4)
  local st = (ranks | ((ranks >> 13) & 1)) & ((ranks | ((ranks >> 13) & 1)) >> 1) & ((ranks | ((ranks >> 13) & 1)) >> 2) & ((ranks | ((ranks >> 13) & 1)) >> 3) & ((ranks | ((ranks >> 13) & 1)) >> 4)
  local fl = setBitCount(l0) >= 5 ? l0 : setBitCount(l1) >= 5 ? l1 : setBitCount(l2) >= 5 ? l2 : setBitCount(l3) >= 5 ? l3 : 0
  local top2p = setBitCount(pairs) > 2 ? clearLowestSetBit(pairs) : pairs
  local cat = sf != 0 ? 8 : (l0 & l1 & l2 & l3) != 0 ? 7 : (trips != 0) & (setBitCount(pairs) >= 2) ? 6 : fl != 0 ? 5 : st != 0 ? 4 : trips != 0 ? 3 : setBitCount(pairs) >= 2 ? 2 : pairs != 0 ? 1 : 0
  local high = cat == 8 ? 63 - leadingZeroCount((sf | (sf >> 16) | (sf >> 32) | (sf >> 48)) & 16383) : cat == 7 ? l0 & l1 & l2 & l3 : cat == 6 ? 63 - leadingZeroCount(trips) : fl ^ parallelBitDeposit((1 << maximum(setBitCount(fl) - 5, 0)) - 1, fl)
  local low = cat == 4 ? 63 - leadingZeroCount(st) : cat == 3 ? trips : cat == 2 ? top2p : cat == 1 ? pairs : clearLowestSetBit(clearLowestSetBit(ranks))
  local secondary = cat == 7 ? 63 - leadingZeroCount(ranks ^ (l0 & l1 & l2 & l3)) : cat == 6 ? 63 - leadingZeroCount(pairs ^ (1 << maximum(63 - leadingZeroCount(trips), 0))) : cat == 3 ? clearLowestSetBit(clearLowestSetBit(ranks ^ trips)) : cat == 2 ? 63 - leadingZeroCount(ranks ^ top2p) : cat == 1 ? clearLowestSetBit(clearLowestSetBit(ranks ^ pairs)) : 0
  mode: Level
  private1[strength] = (cat << 28) | ((cat >= 5 ? high : low) << 14) | secondary
}

rule "poker-evaluate-2" {
  when table[evalPending] == 1
  local s = private2[hole] | table[boardMask]
  local l0 = bitField(s, 0, 16)
  local l1 = bitField(s, 16, 16)
  local l2 = bitField(s, 32, 16)
  local l3 = bitField(s, 48, 16)
  local ranks = l0 | l1 | l2 | l3
  local pairs = (l0 & l1) | (l0 & l2) | (l0 & l3) | (l1 & l2) | (l1 & l3) | (l2 & l3)
  local trips = (l0 & l1 & l2) | (l0 & l1 & l3) | (l0 & l2 & l3) | (l1 & l2 & l3)
  local sf = (s | ((s >> 13) & repeatBits(1, 16))) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 1) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 2) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 3) & ((s | ((s >> 13) & repeatBits(1, 16))) >> 4)
  local st = (ranks | ((ranks >> 13) & 1)) & ((ranks | ((ranks >> 13) & 1)) >> 1) & ((ranks | ((ranks >> 13) & 1)) >> 2) & ((ranks | ((ranks >> 13) & 1)) >> 3) & ((ranks | ((ranks >> 13) & 1)) >> 4)
  local fl = setBitCount(l0) >= 5 ? l0 : setBitCount(l1) >= 5 ? l1 : setBitCount(l2) >= 5 ? l2 : setBitCount(l3) >= 5 ? l3 : 0
  local top2p = setBitCount(pairs) > 2 ? clearLowestSetBit(pairs) : pairs
  local cat = sf != 0 ? 8 : (l0 & l1 & l2 & l3) != 0 ? 7 : (trips != 0) & (setBitCount(pairs) >= 2) ? 6 : fl != 0 ? 5 : st != 0 ? 4 : trips != 0 ? 3 : setBitCount(pairs) >= 2 ? 2 : pairs != 0 ? 1 : 0
  local high = cat == 8 ? 63 - leadingZeroCount((sf | (sf >> 16) | (sf >> 32) | (sf >> 48)) & 16383) : cat == 7 ? l0 & l1 & l2 & l3 : cat == 6 ? 63 - leadingZeroCount(trips) : fl ^ parallelBitDeposit((1 << maximum(setBitCount(fl) - 5, 0)) - 1, fl)
  local low = cat == 4 ? 63 - leadingZeroCount(st) : cat == 3 ? trips : cat == 2 ? top2p : cat == 1 ? pairs : clearLowestSetBit(clearLowestSetBit(ranks))
  local secondary = cat == 7 ? 63 - leadingZeroCount(ranks ^ (l0 & l1 & l2 & l3)) : cat == 6 ? 63 - leadingZeroCount(pairs ^ (1 << maximum(63 - leadingZeroCount(trips), 0))) : cat == 3 ? clearLowestSetBit(clearLowestSetBit(ranks ^ trips)) : cat == 2 ? 63 - leadingZeroCount(ranks ^ top2p) : cat == 1 ? clearLowestSetBit(clearLowestSetBit(ranks ^ pairs)) : 0
  mode: Level
  private2[strength] = (cat << 28) | ((cat >= 5 ? high : low) << 14) | secondary
  table[evalPending] = 0
}

rule "poker-check-call" {
  gate: all(predicates: [
    compareState(comparison: GreaterOrEqual, key: street, state: phase, value: 1)
    compareState(comparison: LessOrEqual, key: street, state: phase, value: 4)
    compareValue(comparison: Equal, kind: Int, left: (table[bettor] == 1 ? betAction1[act] : betAction2[act]), right: 0)
    compareValue(comparison: GreaterOrEqual, kind: Int, left: stack[(table[bettor])], right: streetBet[3 - table[bettor]] - streetBet[(table[bettor])])
  ]
  )
  local toCall = streetBet[3 - table[bettor]] - streetBet[(table[bettor])]
  mode: Level
  push bets = phase[street] * 100 + table[bettor] * 10 + 0
  transaction {
    addState(expression: 0 - toCall, key: (table[bettor]), state: stack)
    addState(expression: toCall, key: pot, state: table)
    setState(expression: streetBet[3 - table[bettor]], key: (table[bettor]), state: streetBet)
    table[acted] += 1
    betAction1[act] = -1
    betAction2[act] = -1
    table[bettor] = 3 - table[bettor]
  }
}

rule "poker-raise" {
  gate: all(predicates: [
    compareState(comparison: GreaterOrEqual, key: street, state: phase, value: 1)
    compareState(comparison: LessOrEqual, key: street, state: phase, value: 4)
    compareValue(comparison: Equal, kind: Int, left: (table[bettor] == 1 ? betAction1[act] : betAction2[act]), right: 1)
    compareState(comparandKey: maxRaises, comparandState: house, comparison: Less, key: raises, state: table)
    compareValue(comparison: GreaterOrEqual, kind: Int, left: stack[(table[bettor])], right: streetBet[3 - table[bettor]] - streetBet[(table[bettor])] + house[bigBlind] * (phase[street] >= 3 ? 2 : 1))
  ]
  )
  local pay = streetBet[3 - table[bettor]] - streetBet[(table[bettor])] + house[bigBlind] * (phase[street] >= 3 ? 2 : 1)
  local bet = house[bigBlind] * (phase[street] >= 3 ? 2 : 1)
  mode: Level
  push bets = phase[street] * 100 + table[bettor] * 10 + 1
  transaction {
    addState(expression: 0 - pay, key: (table[bettor]), state: stack)
    addState(expression: pay, key: pot, state: table)
    setState(expression: streetBet[3 - table[bettor]] + bet, key: (table[bettor]), state: streetBet)
    table[acted] = 1
    table[raises] += 1
    betAction1[act] = -1
    betAction2[act] = -1
    table[bettor] = 3 - table[bettor]
  }
}

rule "poker-fold" {
  gate: all(predicates: [
    compareState(comparison: GreaterOrEqual, key: street, state: phase, value: 1)
    compareState(comparison: LessOrEqual, key: street, state: phase, value: 4)
    compareValue(comparison: Equal, kind: Int, left: (table[bettor] == 1 ? betAction1[act] : betAction2[act]), right: 2)
  ]
  )
  mode: Level
  push bets = phase[street] * 100 + table[bettor] * 10 + 2
  transaction {
    table[winner] = 3 - table[bettor]
    stack[3 - table[bettor]] += table[pot]
    table[pot] = 0
    table[hands] += 1
    betAction1[act] = -1
    betAction2[act] = -1
    phase[next] = 6
  }
}

rule "poker-street-complete" {
  when phase[street] >= 1 and phase[street] <= 4 and table[acted] >= 2 and streetBet[1] == streetBet[2]
  mode: Edge
  transaction {
    phase[next] = phase[street] + 1
    table[acted] = 0
    table[raises] = 0
    streetBet[1] = 0
    streetBet[2] = 0
    table[bettor] = 3 - table[button]
  }
}

rule "poker-flop" {
  when phase[street] == 2 and count(community) == 0
  mode: Edge
  transaction {
    transform transfer(count: 3, draw: cardStream, from: deck, selector: Random, to: community)
    table[evalPending] = 1
  }
}

rule "poker-turn" {
  when phase[street] == 3 and count(community) == 3
  mode: Edge
  transaction {
    transform transfer(count: 1, draw: cardStream, from: deck, selector: Random, to: community)
    table[evalPending] = 1
  }
}

rule "poker-river" {
  when phase[street] == 4 and count(community) == 4
  mode: Edge
  transaction {
    transform transfer(count: 1, draw: cardStream, from: deck, selector: Random, to: community)
    table[evalPending] = 1
  }
}

rule "poker-showdown" {
  when phase[street] == 5 and table[evalPending] == 0
  local winner = private1[strength] > private2[strength] ? 1 : private2[strength] > private1[strength] ? 2 : 0
  local half = table[pot] >> 1
  local odd = table[pot] & 1
  mode: Edge
  audience1[0] = "seat2"
  audience2[0] = "seat1"
  transaction {
    setState(expression: winner, key: winner, state: table)
    stack[1] += winner == 1 ? table[pot] : winner == 2 ? 0 : half + odd * (table[button] == 1)
    stack[2] += winner == 2 ? table[pot] : winner == 1 ? 0 : half + odd * (table[button] == 2)
    table[pot] = 0
    table[hands] += 1
    phase[next] = 6
  }
}

rule "poker-collect-board" {
  when phase[street] == 6 and count(community) > 0
  mode: Level
  deal 1 from community to deck
}

rule "poker-collect-hand1" {
  when phase[street] == 6 and count(hand1) > 0
  mode: Level
  deal 1 from hand1 to deck
}

rule "poker-collect-hand2" {
  when phase[street] == 6 and count(hand2) > 0
  mode: Level
  deal 1 from hand2 to deck
}

rule "poker-hand-over" {
  when phase[street] == 6 and count(community) == 0 and count(hand1) == 0 and count(hand2) == 0
  mode: Edge
  transaction {
    table[acted] = 0
    table[raises] = 0
    streetBet[1] = 0
    streetBet[2] = 0
    table[dealRequest] = house[autoDeal]
    phase[next] = 0
  }
}

rule "poker-card-conservation" {
  when (count(deck) + count(hand1) + count(hand2) + count(community) != count(cards) : Int)
  mode: Edge
  table[leak] = 1
}

rule "poker-discard" {
  when (maximum(betAction1[act], betAction2[act]) != -1 : Int)
  mode: Level
  betAction1[act] = -1
  betAction2[act] = -1
  table[refused] += 1
}

