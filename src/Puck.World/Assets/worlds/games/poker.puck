// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

export action betAction1, betAction2, table
export binding bets, phase, stack
export read bets, community, hand1, hand2, phase, stack, table

rule "poker-transition" {
  when phase[street] != phase[next]
  mode: "Level"
  setState(fromKey: "next", fromState: "phase", key: "street", state: "phase")
}

rule "poker-deal" {
  when phase[street] == 0 and table[dealRequest] == 1 and (minimum(stack[1], stack[2]) >= house[bigBlind] : Int)
  local button: Int = 3 - table[button]
  local blind: Int = table[button]
  mode: "Edge"
  transaction {
    transform transfer(count: 2, draw: "cardStream", from: "deck", selector: "Random", to: "hand1")
    transform transfer(count: 2, draw: "cardStream", from: "deck", selector: "Random", to: "hand2")
    table[dealRequest] = 0
    setState(expression: "$local:button", key: "button", state: "table")
    setState(expression: "$local:button", key: "bettor", state: "table")
    streetBet[($local:button)] = house[smallBlind]
    streetBet[($local:blind)] = house[bigBlind]
    stack[($local:button)] += 0 - house[smallBlind]
    stack[($local:blind)] += 0 - house[bigBlind]
    table[pot] = house[smallBlind] + house[bigBlind]
    table[acted] = 0
    table[raises] = 0
    table[winner] = 0
    table[boardMask] = 0
    private1[hole] = 0
    private2[hole] = 0
    private1[strength] = 0
    private2[strength] = 0
    table[evalPending] = 1
    phase[next] = 1
  }
  audience1[0] = "seat1"
  audience2[0] = "seat2"
}

rule "poker-see-hand1" {
  when table[evalPending] == 1
  mode: "Level"
  forEach: "hand1"
  private1[hole] = private1[hole] | (1 << (16 * (suit[$each] - 1) + rank[$each] - 1))
}

rule "poker-see-hand2" {
  when table[evalPending] == 1
  mode: "Level"
  forEach: "hand2"
  private2[hole] = private2[hole] | (1 << (16 * (suit[$each] - 1) + rank[$each] - 1))
}

rule "poker-see-board" {
  when table[evalPending] == 1
  mode: "Level"
  forEach: "community"
  table[boardMask] = table[boardMask] | (1 << (16 * (suit[$each] - 1) + rank[$each] - 1))
}

rule "poker-evaluate-1" {
  when table[evalPending] == 1
  local s: Int = private1[hole] | table[boardMask]
  local l0: Int = bitField($local:s, 0, 16)
  local l1: Int = bitField($local:s, 16, 16)
  local l2: Int = bitField($local:s, 32, 16)
  local l3: Int = bitField($local:s, 48, 16)
  local ranks: Int = $local:l0 | $local:l1 | $local:l2 | $local:l3
  local pairs: Int = ($local:l0 & $local:l1) | ($local:l0 & $local:l2) | ($local:l0 & $local:l3) | ($local:l1 & $local:l2) | ($local:l1 & $local:l3) | ($local:l2 & $local:l3)
  local trips: Int = ($local:l0 & $local:l1 & $local:l2) | ($local:l0 & $local:l1 & $local:l3) | ($local:l0 & $local:l2 & $local:l3) | ($local:l1 & $local:l2 & $local:l3)
  local sf: Int = ($local:s | (($local:s >> 13) & repeatBits(1, 16))) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 1) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 2) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 3) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 4)
  local st: Int = ($local:ranks | (($local:ranks >> 13) & 1)) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 1) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 2) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 3) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 4)
  local fl: Int = setBitCount($local:l0) >= 5 ? $local:l0 : setBitCount($local:l1) >= 5 ? $local:l1 : setBitCount($local:l2) >= 5 ? $local:l2 : setBitCount($local:l3) >= 5 ? $local:l3 : 0
  local top2p: Int = setBitCount($local:pairs) > 2 ? clearLowestSetBit($local:pairs) : $local:pairs
  local cat: Int = $local:sf != 0 ? 8 : ($local:l0 & $local:l1 & $local:l2 & $local:l3) != 0 ? 7 : ($local:trips != 0) & (setBitCount($local:pairs) >= 2) ? 6 : $local:fl != 0 ? 5 : $local:st != 0 ? 4 : $local:trips != 0 ? 3 : setBitCount($local:pairs) >= 2 ? 2 : $local:pairs != 0 ? 1 : 0
  local high: Int = $local:cat == 8 ? 63 - leadingZeroCount(($local:sf | ($local:sf >> 16) | ($local:sf >> 32) | ($local:sf >> 48)) & 16383) : $local:cat == 7 ? $local:l0 & $local:l1 & $local:l2 & $local:l3 : $local:cat == 6 ? 63 - leadingZeroCount($local:trips) : $local:fl ^ parallelBitDeposit((1 << maximum(setBitCount($local:fl) - 5, 0)) - 1, $local:fl)
  local low: Int = $local:cat == 4 ? 63 - leadingZeroCount($local:st) : $local:cat == 3 ? $local:trips : $local:cat == 2 ? $local:top2p : $local:cat == 1 ? $local:pairs : clearLowestSetBit(clearLowestSetBit($local:ranks))
  local secondary: Int = $local:cat == 7 ? 63 - leadingZeroCount($local:ranks ^ ($local:l0 & $local:l1 & $local:l2 & $local:l3)) : $local:cat == 6 ? 63 - leadingZeroCount($local:pairs ^ (1 << maximum(63 - leadingZeroCount($local:trips), 0))) : $local:cat == 3 ? clearLowestSetBit(clearLowestSetBit($local:ranks ^ $local:trips)) : $local:cat == 2 ? 63 - leadingZeroCount($local:ranks ^ $local:top2p) : $local:cat == 1 ? clearLowestSetBit(clearLowestSetBit($local:ranks ^ $local:pairs)) : 0
  mode: "Level"
  private1[strength] = ($local:cat << 28) | (($local:cat >= 5 ? $local:high : $local:low) << 14) | $local:secondary
}

rule "poker-evaluate-2" {
  when table[evalPending] == 1
  local s: Int = private2[hole] | table[boardMask]
  local l0: Int = bitField($local:s, 0, 16)
  local l1: Int = bitField($local:s, 16, 16)
  local l2: Int = bitField($local:s, 32, 16)
  local l3: Int = bitField($local:s, 48, 16)
  local ranks: Int = $local:l0 | $local:l1 | $local:l2 | $local:l3
  local pairs: Int = ($local:l0 & $local:l1) | ($local:l0 & $local:l2) | ($local:l0 & $local:l3) | ($local:l1 & $local:l2) | ($local:l1 & $local:l3) | ($local:l2 & $local:l3)
  local trips: Int = ($local:l0 & $local:l1 & $local:l2) | ($local:l0 & $local:l1 & $local:l3) | ($local:l0 & $local:l2 & $local:l3) | ($local:l1 & $local:l2 & $local:l3)
  local sf: Int = ($local:s | (($local:s >> 13) & repeatBits(1, 16))) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 1) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 2) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 3) & (($local:s | (($local:s >> 13) & repeatBits(1, 16))) >> 4)
  local st: Int = ($local:ranks | (($local:ranks >> 13) & 1)) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 1) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 2) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 3) & (($local:ranks | (($local:ranks >> 13) & 1)) >> 4)
  local fl: Int = setBitCount($local:l0) >= 5 ? $local:l0 : setBitCount($local:l1) >= 5 ? $local:l1 : setBitCount($local:l2) >= 5 ? $local:l2 : setBitCount($local:l3) >= 5 ? $local:l3 : 0
  local top2p: Int = setBitCount($local:pairs) > 2 ? clearLowestSetBit($local:pairs) : $local:pairs
  local cat: Int = $local:sf != 0 ? 8 : ($local:l0 & $local:l1 & $local:l2 & $local:l3) != 0 ? 7 : ($local:trips != 0) & (setBitCount($local:pairs) >= 2) ? 6 : $local:fl != 0 ? 5 : $local:st != 0 ? 4 : $local:trips != 0 ? 3 : setBitCount($local:pairs) >= 2 ? 2 : $local:pairs != 0 ? 1 : 0
  local high: Int = $local:cat == 8 ? 63 - leadingZeroCount(($local:sf | ($local:sf >> 16) | ($local:sf >> 32) | ($local:sf >> 48)) & 16383) : $local:cat == 7 ? $local:l0 & $local:l1 & $local:l2 & $local:l3 : $local:cat == 6 ? 63 - leadingZeroCount($local:trips) : $local:fl ^ parallelBitDeposit((1 << maximum(setBitCount($local:fl) - 5, 0)) - 1, $local:fl)
  local low: Int = $local:cat == 4 ? 63 - leadingZeroCount($local:st) : $local:cat == 3 ? $local:trips : $local:cat == 2 ? $local:top2p : $local:cat == 1 ? $local:pairs : clearLowestSetBit(clearLowestSetBit($local:ranks))
  local secondary: Int = $local:cat == 7 ? 63 - leadingZeroCount($local:ranks ^ ($local:l0 & $local:l1 & $local:l2 & $local:l3)) : $local:cat == 6 ? 63 - leadingZeroCount($local:pairs ^ (1 << maximum(63 - leadingZeroCount($local:trips), 0))) : $local:cat == 3 ? clearLowestSetBit(clearLowestSetBit($local:ranks ^ $local:trips)) : $local:cat == 2 ? 63 - leadingZeroCount($local:ranks ^ $local:top2p) : $local:cat == 1 ? clearLowestSetBit(clearLowestSetBit($local:ranks ^ $local:pairs)) : 0
  mode: "Level"
  private2[strength] = ($local:cat << 28) | (($local:cat >= 5 ? $local:high : $local:low) << 14) | $local:secondary
  table[evalPending] = 0
}

rule "poker-check-call" {
  gate: all(predicates: [
    compareState(comparison: "GreaterOrEqual", key: "street", state: "phase", value: 1)
    compareState(comparison: "LessOrEqual", key: "street", state: "phase", value: 4)
    compareValue(comparison: "Equal", kind: "Int", left: "(table[bettor] == 1 ? betAction1[act] : betAction2[act])", right: "0")
    compareValue(comparison: "GreaterOrEqual", kind: "Int", left: "stack[(table[bettor])]", right: "streetBet[(3 - table[bettor])] - streetBet[(table[bettor])]")
  ]
  )
  local toCall: Int = streetBet[(3 - table[bettor])] - streetBet[(table[bettor])]
  mode: "Level"
  push bets = phase[street] * 100 + table[bettor] * 10 + 0
  transaction {
    addState(expression: "0 - $local:toCall", key: "$expr:table[bettor]", state: "stack")
    addState(expression: "$local:toCall", key: "pot", state: "table")
    setState(expression: "streetBet[(3 - table[bettor])]", key: "$expr:table[bettor]", state: "streetBet")
    table[acted] += 1
    betAction1[act] = -1
    betAction2[act] = -1
    table[bettor] = 3 - table[bettor]
  }
}

rule "poker-raise" {
  gate: all(predicates: [
    compareState(comparison: "GreaterOrEqual", key: "street", state: "phase", value: 1)
    compareState(comparison: "LessOrEqual", key: "street", state: "phase", value: 4)
    compareValue(comparison: "Equal", kind: "Int", left: "(table[bettor] == 1 ? betAction1[act] : betAction2[act])", right: "1")
    compareState(comparandKey: "maxRaises", comparandState: "house", comparison: "Less", key: "raises", state: "table")
    compareValue(comparison: "GreaterOrEqual", kind: "Int", left: "stack[(table[bettor])]", right: "streetBet[(3 - table[bettor])] - streetBet[(table[bettor])] + house[bigBlind] * (phase[street] >= 3 ? 2 : 1)")
  ]
  )
  local pay: Int = streetBet[(3 - table[bettor])] - streetBet[(table[bettor])] + house[bigBlind] * (phase[street] >= 3 ? 2 : 1)
  local bet: Int = house[bigBlind] * (phase[street] >= 3 ? 2 : 1)
  mode: "Level"
  push bets = phase[street] * 100 + table[bettor] * 10 + 1
  transaction {
    addState(expression: "0 - $local:pay", key: "$expr:table[bettor]", state: "stack")
    addState(expression: "$local:pay", key: "pot", state: "table")
    setState(expression: "streetBet[(3 - table[bettor])] + $local:bet", key: "$expr:table[bettor]", state: "streetBet")
    table[acted] = 1
    table[raises] += 1
    betAction1[act] = -1
    betAction2[act] = -1
    table[bettor] = 3 - table[bettor]
  }
}

rule "poker-fold" {
  gate: all(predicates: [
    compareState(comparison: "GreaterOrEqual", key: "street", state: "phase", value: 1)
    compareState(comparison: "LessOrEqual", key: "street", state: "phase", value: 4)
    compareValue(comparison: "Equal", kind: "Int", left: "(table[bettor] == 1 ? betAction1[act] : betAction2[act])", right: "2")
  ]
  )
  mode: "Level"
  push bets = phase[street] * 100 + table[bettor] * 10 + 2
  transaction {
    table[winner] = 3 - table[bettor]
    stack[3 - table[bettor]] += table[pot]
    table[pot] = 0
    table[hands] += 1
    betAction1[act] = -1
    betAction2[act] = -1
    phase[next] = 6
  }
}

rule "poker-street-complete" {
  when phase[street] >= 1 and phase[street] <= 4 and table[acted] >= 2 and streetBet[1] == streetBet[2]
  mode: "Edge"
  transaction {
    phase[next] = phase[street] + 1
    table[acted] = 0
    table[raises] = 0
    streetBet[1] = 0
    streetBet[2] = 0
    table[bettor] = 3 - table[button]
  }
}

rule "poker-flop" {
  when phase[street] == 2 and $reduce:count:community == 0
  mode: "Edge"
  transaction {
    transform transfer(count: 3, draw: "cardStream", from: "deck", selector: "Random", to: "community")
    table[evalPending] = 1
  }
}

rule "poker-turn" {
  when phase[street] == 3 and $reduce:count:community == 3
  mode: "Edge"
  transaction {
    transform transfer(count: 1, draw: "cardStream", from: "deck", selector: "Random", to: "community")
    table[evalPending] = 1
  }
}

rule "poker-river" {
  when phase[street] == 4 and $reduce:count:community == 4
  mode: "Edge"
  transaction {
    transform transfer(count: 1, draw: "cardStream", from: "deck", selector: "Random", to: "community")
    table[evalPending] = 1
  }
}

rule "poker-showdown" {
  when phase[street] == 5 and table[evalPending] == 0
  local winner: Int = private1[strength] > private2[strength] ? 1 : private2[strength] > private1[strength] ? 2 : 0
  local half: Int = table[pot] >> 1
  local odd: Int = table[pot] & 1
  mode: "Edge"
  audience1[0] = "seat2"
  audience2[0] = "seat1"
  transaction {
    setState(expression: "$local:winner", key: "winner", state: "table")
    stack[1] += $local:winner == 1 ? table[pot] : $local:winner == 2 ? 0 : $local:half + $local:odd * (table[button] == 1)
    stack[2] += $local:winner == 2 ? table[pot] : $local:winner == 1 ? 0 : $local:half + $local:odd * (table[button] == 2)
    table[pot] = 0
    table[hands] += 1
    phase[next] = 6
  }
}

rule "poker-collect-board" {
  when phase[street] == 6 and $reduce:count:community > 0
  mode: "Level"
  deal 1 from community to deck
}

rule "poker-collect-hand1" {
  when phase[street] == 6 and $reduce:count:hand1 > 0
  mode: "Level"
  deal 1 from hand1 to deck
}

rule "poker-collect-hand2" {
  when phase[street] == 6 and $reduce:count:hand2 > 0
  mode: "Level"
  deal 1 from hand2 to deck
}

rule "poker-hand-over" {
  when phase[street] == 6 and $reduce:count:community == 0 and $reduce:count:hand1 == 0 and $reduce:count:hand2 == 0
  mode: "Edge"
  transaction {
    table[acted] = 0
    table[raises] = 0
    streetBet[1] = 0
    streetBet[2] = 0
    table[dealRequest] = house[autoDeal]
    phase[next] = 0
  }
}

rule "poker-card-conservation" {
  when ($reduce:count:deck + $reduce:count:hand1 + $reduce:count:hand2 + $reduce:count:community != $reduce:count:cards : Int)
  mode: "Edge"
  table[leak] = 1
}

rule "poker-discard" {
  when (maximum(betAction1[act], betAction2[act]) != -1 : Int)
  mode: "Level"
  betAction1[act] = -1
  betAction2[act] = -1
  table[refused] += 1
}

