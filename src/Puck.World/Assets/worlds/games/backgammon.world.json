          { "$type": "compareState", "state": "checkerPoint", "key": "b0", "comparison": "NotEqual", "comparandState": "origPoint", "comparandKey": "b0" },
          { "$type": "compareState", "state": "checkerPoint", "key": "b1", "comparison": "NotEqual", "comparandState": "origPoint", "comparandKey": "b1" }
        ]
      },
      "effects": [
        { "$type": "setState", "state": "origPoint", "key": "w0", "fromState": "checkerPoint", "fromKey": "w0" },
        { "$type": "setState", "state": "origPoint", "key": "w1", "fromState": "checkerPoint", "fromKey": "w1" },
        { "$type": "setState", "state": "origPoint", "key": "b0", "fromState": "checkerPoint", "fromKey": "b0" },
