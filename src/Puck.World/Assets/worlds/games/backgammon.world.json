          "expression": "(turn == 1) & (((origPoint[b1] == -1) & ((checkerPoint[b1] == (24 - dice[d1])) | (checkerPoint[b1] == (24 - dice[d2])))) | ((origPoint[b1] != -1) & (origPoint[b0] != -1) & (((origPoint[b1] - checkerPoint[b1]) == dice[d1]) | ((origPoint[b1] - checkerPoint[b1]) == dice[d2]))))"
        },
        { "$type": "setState", "state": "turn", "expression": "1 - turn" }
