    },
    {
      "name": "backgammon-legal-w1",
      "mode": "Edge",
      "gate": { "$type": "compareState", "state": "checkerPoint", "key": "w1", "comparison": "NotEqual", "comparandState": "origPoint", "comparandKey": "w1" },
      "effects": [
        {
          "$type": "setState",
          "state": "verdict",
          "expression": "(turn == 0) & (((origPoint[w1] == -1) & ((checkerPoint[w1] == (dice[d1] - 1)) | (checkerPoint[w1] == (dice[d2] - 1)))) | ((origPoint[w1] != -1) & (origPoint[w0] != -1) & (((checkerPoint[w1] - origPoint[w1]) == dice[d1]) | ((checkerPoint[w1] - origPoint[w1]) == dice[d2]))))"
