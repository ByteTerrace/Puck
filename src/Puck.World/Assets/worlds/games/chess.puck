// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

export action board, gameStarted, move
export binding illegalCount, inCheck, turn, verdict
export read board, chessBoard, gameStarted, inCheck, move, plan, turn, verdict

let boardCoords = [-0.7, -0.5, -0.3, -0.1, 0.1, 0.3, 0.5, 0.7]
let backRankTypes = ["rook", "knight", "bishop", "queen", "king", "bishop", "knight", "rook"]
let squareTypes = ["boardSquareLight", "boardSquareDark"]

template piecePlacement(name, prototypeName, x, z) {
  placement name {
    prototype: prototypeName
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "piece"
      look: prototypeName
      source: "Idle"
    }
    parent: "tabletop"
    position [x, 1.8, z]
  }
}

template pieceProto(color, name, sx, sy, sz) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        rotation: "state.transforms.identity"
        scale [sx, sy, sz]
      }
    }
  }
}

template crownedPieceProto(color, name, sx, sy, sz, csx, csy, csz, crownY) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        rotation: "state.transforms.identity"
        scale [sx, sy, sz]
      }
      shape Sphere "crown" {
        blend: "SmoothUnion"
        material: 0
        position [0, crownY, 0]
        rotation: "state.transforms.identity"
        scale [csx, csy, csz]
        smooth: 0.01
      }
    }
  }
}

template squareProto(name, colorKey) {
  prototype name {
    document {
      name: name
      palette [
        {
          color: $"state.boardColors.{colorKey}"
          roughness: 0.846
          specular: 0.05
        }
      ]
      schema: "puck.creation.v1"
      shape Box "square" {
        material: 0
        position [0, 0, 0]
        rotation: "state.transforms.identity"
        scale [0.095, 0.004, 0.095]
      }
    }
  }
}

// Extract kits and patterns from header_section
kits {
  rows [
    {
      bodyContact: "Solid"
      bodyMotionProgram: "walk"
      collider: box(halfExtents: [0.045, 0.12, 0.045], rotation: [0, 0, 0, 1])
      motion {
        facingSnap: true
        holds [
          {
            bond: "Free"
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: "Gravity"
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 0.001
        }
        turn {
          rate: 0.001
        }
      }
      name: "piece"
      rigid {
        angularDamping: 0.05
        friction: 0.5
        linearDamping: 0.05
        mass: 0.12
        restitution: 0.1
        rollingFriction: 0.15
      }
    }
  ]
}

patterns [
  {
    kind: "Int"
    name: "chessRayEmpty"
    pattern: star(item: symbol(name: "empty"))
    symbols [
      {
        max: 0
        min: 0
        name: "empty"
      }
    ]
  }
]

placements {
  placement "tabletop" {
    prototype: "tabletop"
    board {
      move: "move"
      occupancy: "board"
      plan: "plan"
      topology: "chessBoard"
      turn: "turn"
      verdict: "verdict"
    }
    position [-8, -0.5, 12]
    solid
  }

  for i in range(0, 8) {
    piecePlacement($"piece{i}", $"piece_white_{backRankTypes[i]}", boardCoords[i], -0.7)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{8 + i}", "piece_white_pawn", boardCoords[i], -0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{16 + i}", "piece_black_pawn", boardCoords[i], 0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{24 + i}", $"piece_black_{backRankTypes[i]}", boardCoords[i], 0.7)
  }

  for r in range(0, 8) {
    for c in range(0, 8) {
      placement $"boardSquare-{r * 8 + c}" {
        prototype: squareTypes[(r + c) % 2]
        parent: "tabletop"
        position [boardCoords[c], 1.305, boardCoords[r]]
      }
    }
  }
}

prototypes {
  prototype "tabletop" {
    document {
      name: "tabletop"
      palette [
        {
          color: "#8A6A45"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "top" {
        material: 0
        position [0, 1.25, 0]
        rotation: "state.transforms.identity"
        scale [1, 0.05, 1]
      }

      shape Cylinder "leg" {
        material: 0
        position [0, 0.6, 0]
        rotation: "state.transforms.identity"
        scale [0.08, 0.6, 0.08]
      }
    }
  }

  for color in ["white", "black"] {
    pieceProto(color, "pawn", 0.035, 0.09, 0.035)
    pieceProto(color, "knight", 0.04, 0.12, 0.04)
    pieceProto(color, "bishop", 0.04, 0.15, 0.04)
    pieceProto(color, "rook", 0.05, 0.11, 0.05)
    crownedPieceProto(color, "queen", 0.045, 0.17, 0.045, 0.055, 0.055, 0.055, 0.203)
    crownedPieceProto(color, "king", 0.045, 0.19, 0.045, 0.06, 0.06, 0.06, 0.226)
  }

  squareProto("boardSquareLight", "light")
  squareProto("boardSquareDark", "dark")
}

rule "tabletop-settle-hold-advance" {
  when $physics:quiescent == 1 and settleHold < 60
  mode: "Level"
  settleHold += 1
}

rule "tabletop-settle-hold-reset" {
  when $physics:quiescent != 1
  mode: "Level"
  settleHold = 0
}

rule "tabletop-derive-cell-upright" {
  when settleHold == 60 and $upright:placement:$each >= 0.5
  mode: "Edge"
  forEach: "pieceCode"
  pieceCell[$each] = $board:cellOf:board:placement:$each
}

rule "tabletop-derive-cell-tilted" {
  when settleHold == 60 and not $upright:placement:$each >= 0.5
  mode: "Edge"
  forEach: "pieceCode"
  pieceCell[$each] = -1
}

rule "tabletop-board-collisions" {
  when settleHold == 60
  mode: "Edge"
  boardCollisions = $reduce:count:pieceCell:between:0:63 + setBitCount($board:mask:board:0:0) - 64
}

rule "tabletop-game-start-snapshot" {
  when settleHold == 60 and gameStarted == 0 and boardCollisions == 0
  mode: "Edge"
  transform boardCombine(left: "board", operation: "Copy", row: "lastLegal")
}

rule "tabletop-candidate-cells" {
  when settleHold == 60
  local ownBefore: Int = turn == 0 ? $board:mask:lastLegal:1:6 : $board:mask:lastLegal:-6:-1
  local ownAfter: Int = turn == 0 ? $board:mask:board:1:6 : $board:mask:board:-6:-1
  local sources: Int = $local:ownBefore & ~($board:mask:board:1:6 | $board:mask:board:-6:-1)
  local destinations: Int = $local:ownAfter & ~$local:ownBefore
  local kingBefore: Int = turn == 0 ? $board:mask:lastLegal:6:6 : $board:mask:lastLegal:-6:-6
  local kingAfter: Int = turn == 0 ? $board:mask:board:6:6 : $board:mask:board:-6:-6
  local target: Int = ($local:sources & $local:kingBefore) != 0 ? $local:destinations & $local:kingAfter : $local:destinations
  mode: "Edge"
  move[from] = $local:sources == 0 ? -1 : trailingZeroCount(($local:sources & $local:kingBefore) != 0 ? $local:sources & $local:kingBefore : $local:sources)
  move[to] = $local:target == 0 ? -1 : trailingZeroCount($local:target)
}

rule "tabletop-candidate-move" {
  when settleHold == 60
  local mover: Int = lastLegal[move[from]]
  local kind: Int = (move[from] < 0) | (move[to] < 0) | (move[to] > 63) ? 0 : (absolute($local:mover) == 6) & (absolute(move[to] - move[from]) == 2) ? 4 : (absolute($local:mover) == 1) & (((move[from] ^ move[to]) & 7) != 0) & (lastLegal[move[to]] == 0) ? 3 : lastLegal[move[to]] != 0 ? 2 : 1
  mode: "Edge"
  setState(expression: "$local:mover", key: "mover", state: "move")
  setState(expression: "$local:kind", key: "kind", state: "move")
  move[captured] = $local:kind == 3 ? lastLegal[(move[to] - 8 * (1 - 2 * turn))] : lastLegal[move[to]]
}

rule "tabletop-candidate-match" {
  when settleHold == 60
  local changed: Int = (($board:mask:board:-3:-2 | $board:mask:board:1:2 | $board:mask:board:5:6) ^ ($board:mask:lastLegal:-3:-2 | $board:mask:lastLegal:1:2 | $board:mask:lastLegal:5:6)) | (($board:mask:board:-5:-3 | $board:mask:board:2:5) ^ ($board:mask:lastLegal:-5:-3 | $board:mask:lastLegal:2:5)) | (($board:mask:board:-4:3) ^ ($board:mask:lastLegal:-4:3)) | (($board:mask:board:0:7) ^ ($board:mask:lastLegal:0:7))
  local from: Int = move[from]
  local to: Int = move[to]
  local sign: Int = 1 - 2 * turn
  local clear: Int = move[kind] == 4 ? ($local:from & 56) + ($local:to > $local:from ? 7 : 0) : move[kind] == 3 ? $local:to - 8 * $local:sign : -1
  local rook: Int = move[kind] == 4 ? (($local:from + $local:to) >> 1) : -1
  local clearUnique: Int = ($local:clear >= 0) & ($local:clear < 64) & ($local:clear != $local:from) & ($local:clear != $local:to)
  local rookUnique: Int = ($local:rook >= 0) & ($local:rook < 64) & ($local:rook != $local:from) & ($local:rook != $local:to) & ($local:rook != $local:clear)
  local footprint: Int = (($local:from >= 0) * (1 << maximum($local:from, 0))) | (($local:to >= 0) * (1 << maximum($local:to, 0))) | ($local:clearUnique * (1 << clamp($local:clear, 0, 63))) | ($local:rookUnique * (1 << clamp($local:rook, 0, 63)))
  local landed: Int = (absolute(move[mover]) == 1) & ($local:to / 8 == (turn == 0 ? 7 : 0)) ? board[move[to]] : move[mover]
  mode: "Edge"
  boardMismatch = setBitCount($local:changed & ~$local:footprint) + ($local:from >= 0) * (board[move[from]] != 0) + ($local:to >= 0) * (board[move[to]] != $local:landed) + $local:clearUnique * (board[($local:clear)] != 0) + $local:rookUnique * (board[($local:rook)] != 4 * $local:sign)
  boardChanged = setBitCount($local:changed)
}

rule "tabletop-castle-transit-attacked" {
  when settleHold == 60 and move[kind] == 4
  mode: "Edge"
  castleTransitAttacked[wk] = (($board:mask:lastLegal:-1:-1 & 0x5000) != 0) | (($board:mask:lastLegal:-2:-2 & 0x508800) != 0) | (($board:mask:lastLegal:-6:-6 & 0x7050) != 0) | `$board:attacks:lastLegal:-5:-4:N,S,E,W`[5] | `$board:attacks:lastLegal:-3:-3:NE,SE,SW,NW`[5] | `$board:attacks:lastLegal:-5:-5:NE,SE,SW,NW`[5]
  castleTransitAttacked[wq] = (($board:mask:lastLegal:-1:-1 & 0x1400) != 0) | (($board:mask:lastLegal:-2:-2 & 0x142200) != 0) | (($board:mask:lastLegal:-6:-6 & 0x1C14) != 0) | `$board:attacks:lastLegal:-5:-4:N,S,E,W`[3] | `$board:attacks:lastLegal:-3:-3:NE,SE,SW,NW`[3] | `$board:attacks:lastLegal:-5:-5:NE,SE,SW,NW`[3]
  castleTransitAttacked[bk] = (($board:mask:lastLegal:1:1 & byteSwap(0x5000)) != 0) | (($board:mask:lastLegal:2:2 & byteSwap(0x508800)) != 0) | (($board:mask:lastLegal:6:6 & byteSwap(0x7050)) != 0) | `$board:attacks:lastLegal:4:5:N,S,E,W`[61] | `$board:attacks:lastLegal:3:3:NE,SE,SW,NW`[61] | `$board:attacks:lastLegal:5:5:NE,SE,SW,NW`[61]
  castleTransitAttacked[bq] = (($board:mask:lastLegal:1:1 & byteSwap(0x1400)) != 0) | (($board:mask:lastLegal:2:2 & byteSwap(0x142200)) != 0) | (($board:mask:lastLegal:6:6 & byteSwap(0x1C14)) != 0) | `$board:attacks:lastLegal:4:5:N,S,E,W`[59] | `$board:attacks:lastLegal:3:3:NE,SE,SW,NW`[59] | `$board:attacks:lastLegal:5:5:NE,SE,SW,NW`[59]
}

rule "tabletop-castle-legal" {
  when settleHold == 60
  local sign: Int = 1 - 2 * turn
  local home: Int = 4 + 56 * turn
  local direction: Int = move[to] > move[from] ? 1 : -1
  local rook: Int = $local:home + ($local:direction == 1 ? 3 : -4)
  local right: Int = ($local:direction == 1 ? 2 : 1) << (2 * turn)
  local path: Int = $local:direction == 1 ? $match:chessRayEmpty:lastLegal:E:cell[move[from]] : $match:chessRayEmpty:lastLegal:W:cell[move[from]]
  local attacked: Int = turn == 0 ? ($local:direction == 1 ? castleTransitAttacked[wk] : castleTransitAttacked[wq]) : ($local:direction == 1 ? castleTransitAttacked[bk] : castleTransitAttacked[bq])
  mode: "Edge"
  castleLegal = (move[kind] == 4) & (move[from] == $local:home) & (move[to] == $local:home + 2 * $local:direction) & ((castleRights & $local:right) == 0) & (lastLegal[($local:rook)] == 4 * $local:sign) & ($local:path == $local:rook) & (previousInCheck[turn[$value]] == 0) & ($local:attacked == 0)
}

rule "tabletop-shape-final" {
  when settleHold == 60
  local piece: Int = absolute(move[mover])
  local dx: Int = absolute(move[to] % 8 - move[from] % 8)
  local dy: Int = (move[to] / 8 - move[from] / 8) * (1 - 2 * turn)
  local straight: Int = maximum(maximum(maximum($match:chessRayEmpty:lastLegal:N:cell[move[to]] == move[from], $match:chessRayEmpty:lastLegal:S:cell[move[to]] == move[from]), $match:chessRayEmpty:lastLegal:E:cell[move[to]] == move[from]), $match:chessRayEmpty:lastLegal:W:cell[move[to]] == move[from])
  local diagonal: Int = maximum(maximum(maximum($match:chessRayEmpty:lastLegal:NE:cell[move[to]] == move[from], $match:chessRayEmpty:lastLegal:SE:cell[move[to]] == move[from]), $match:chessRayEmpty:lastLegal:SW:cell[move[to]] == move[from]), $match:chessRayEmpty:lastLegal:NW:cell[move[to]] == move[from])
  local middle: Int = move[from] + 8 * (1 - 2 * turn)
  local pawn: Int = ($local:dx == 0) & (lastLegal[move[to]] == 0) & maximum($local:dy == 1, ($local:dy == 2) & (move[from] / 8 == (turn == 0 ? 1 : 6)) & (lastLegal[($local:middle)] == 0)) | ($local:dx == 1) & ($local:dy == 1) & maximum(move[kind] == 2, (move[kind] == 3) & (move[to] == enPassantTarget) & (move[captured] == 2 * turn - 1))
  mode: "Edge"
  shapeLegal = $local:piece == 1 ? $local:pawn : $local:piece == 2 ? $local:dx * absolute($local:dy) == 2 : $local:piece == 3 ? $local:diagonal : $local:piece == 4 ? $local:straight : $local:piece == 5 ? maximum($local:diagonal, $local:straight) : $local:piece == 6 ? maximum((maximum($local:dx, absolute($local:dy)) == 1) & (move[kind] != 4), castleLegal) : 0
}

rule "tabletop-check-white" {
  when settleHold == 60
  local kingMask: Int = lowestSetBit($board:mask:board:6:6)
  local kingSquare: Int = $local:kingMask == 0 ? -1 : trailingZeroCount($local:kingMask)
  local nearFiles: Int = boardShift($local:kingMask, chessBoard, E) | boardShift($local:kingMask, chessBoard, W)
  local farFiles: Int = (boardShift($local:nearFiles, chessBoard, E) | boardShift($local:nearFiles, chessBoard, W)) & ~$local:kingMask
  local kingBand: Int = $local:kingMask | $local:nearFiles
  local closeHit: Int = ((boardShift($local:nearFiles, chessBoard, S) & $board:mask:board:-1:-1) | (($local:kingBand | boardShift($local:kingBand, chessBoard, S) | boardShift($local:kingBand, chessBoard, N)) & $board:mask:board:-6:-6)) != 0
  local knightHit: Int = ((boardShift(boardShift($local:nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift($local:nearFiles, chessBoard, N), chessBoard, N) | boardShift($local:farFiles, chessBoard, S) | boardShift($local:farFiles, chessBoard, N)) & $board:mask:board:-2:-2) != 0
  local slideHit: Int = ($local:kingMask != 0) & (`$board:attacks:board:-5:-4:N,S,E,W`[($local:kingSquare)] | `$board:attacks:board:-3:-3:NE,SE,SW,NW`[($local:kingSquare)] | `$board:attacks:board:-5:-5:NE,SE,SW,NW`[($local:kingSquare)])
  mode: "Edge"
  inCheck[0] = $local:closeHit | $local:knightHit | $local:slideHit
}

rule "tabletop-check-black" {
  when settleHold == 60
  local kingMask: Int = lowestSetBit($board:mask:board:-6:-6)
  local kingSquare: Int = $local:kingMask == 0 ? -1 : trailingZeroCount($local:kingMask)
  local nearFiles: Int = boardShift($local:kingMask, chessBoard, E) | boardShift($local:kingMask, chessBoard, W)
  local farFiles: Int = (boardShift($local:nearFiles, chessBoard, E) | boardShift($local:nearFiles, chessBoard, W)) & ~$local:kingMask
  local kingBand: Int = $local:kingMask | $local:nearFiles
  local closeHit: Int = ((boardShift($local:nearFiles, chessBoard, N) & $board:mask:board:1:1) | (($local:kingBand | boardShift($local:kingBand, chessBoard, S) | boardShift($local:kingBand, chessBoard, N)) & $board:mask:board:6:6)) != 0
  local knightHit: Int = ((boardShift(boardShift($local:nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift($local:nearFiles, chessBoard, N), chessBoard, N) | boardShift($local:farFiles, chessBoard, S) | boardShift($local:farFiles, chessBoard, N)) & $board:mask:board:2:2) != 0
  local slideHit: Int = ($local:kingMask != 0) & (`$board:attacks:board:4:5:N,S,E,W`[($local:kingSquare)] | `$board:attacks:board:3:3:NE,SE,SW,NW`[($local:kingSquare)] | `$board:attacks:board:5:5:NE,SE,SW,NW`[($local:kingSquare)])
  mode: "Edge"
  inCheck[1] = $local:closeHit | $local:knightHit | $local:slideHit
}

rule "tabletop-game-start-check" {
  when settleHold == 60 and gameStarted == 0 and boardCollisions == 0
  mode: "Edge"
  previousInCheck[0] = inCheck[0]
  previousInCheck[1] = inCheck[1]
  gameStarted = 1
}

rule "tabletop-verdict" {
  when settleHold == 60
  local sign: Int = 1 - 2 * turn
  local promotes: Int = (absolute(move[mover]) == 1) & (move[to] / 8 == (turn == 0 ? 7 : 0))
  local replacement: Int = $local:promotes ? (board[move[to]] * $local:sign >= 2) & (board[move[to]] * $local:sign <= 5) : board[move[to]] == move[mover]
  local kings: Int = (setBitCount($board:mask:board:6:6) == 1) & (setBitCount($board:mask:board:-6:-6) == 1)
  mode: "Edge"
  verdict = (move[kind] >= 1) & (move[kind] <= 4) & (boardMismatch == 0) & (boardCollisions == 0) & shapeLegal & $local:replacement & (move[mover] * $local:sign > 0) & (move[captured] * $local:sign <= 0) & (inCheck[turn[$value]] == 0) & $local:kings
  promotionPending[0] = boardChanged == 0 ? -1 : promotionPending[0]
  promotionPending[1] = boardChanged == 0 ? -1 : promotionPending[1]
}

rule "tabletop-promotion-pending" {
  gate: all(predicates: [
    compareState(comparison: "Equal", state: "settleHold", value: 60)
    compareState(comparison: "Equal", state: "verdict", value: 0)
    compareValue(comparison: "Equal", kind: "Int", left: "(absolute(move[mover]) == 1) & (move[to] / 8 == (turn == 0 ? 7 : 0)) & (board[move[to]] == move[mover]) & shapeLegal & (boardMismatch == 0) & (boardCollisions == 0) & (inCheck[turn[$value]] == 0) & (setBitCount($board:mask:board:6:6) == 1) & (setBitCount($board:mask:board:-6:-6) == 1)", right: "1")
  ]
  )
  mode: "Edge"
  promotionPending[turn[$value]] = move[to]
}

rule "tabletop-advance-turn" {
  when settleHold == 60 and verdict == 1 and move[kind] != 0
  local lostRooks: Int = (($board:mask:lastLegal:4:4 & ~$board:mask:board:4:4) & 0x81) | (($board:mask:lastLegal:-4:-4 & ~$board:mask:board:-4:-4) & (0x81 << 56))
  local lostKings: Int = (($board:mask:lastLegal:6:6 & ~$board:mask:board:6:6) & (1 << 4)) | (($board:mask:lastLegal:-6:-6 & ~$board:mask:board:-6:-6) & (1 << 60))
  mode: "Edge"
  transaction {
    castleRights = castleRights | parallelBitExtract($local:lostRooks, 0x81 | (0x81 << 56)) | (parallelBitDeposit(parallelBitExtract($local:lostKings, (1 << 4) | (1 << 60)), 5) * 3)
    transform boardCombine(left: "board", operation: "Copy", row: "lastLegal")
    previousInCheck[0] = inCheck[0]
    previousInCheck[1] = inCheck[1]
    enPassantTarget = (absolute(move[mover]) == 1) & (absolute(move[to] - move[from]) == 16) ? ((move[from] + move[to]) >> 1) : -1
    turn = 1 - turn
    promotionPending[0] = -1
    promotionPending[1] = -1
  }
}

rule "tabletop-board-history" {
  when settleHold == 60 and verdict == 1 and move[kind] != 0
  mode: "Edge"
  push boardHistory = $board:canonical:board
  repetitionCount = 1 + ($history:boardHistory:0 == $history:boardHistory:2) + ($history:boardHistory:0 == $history:boardHistory:4) + ($history:boardHistory:0 == $history:boardHistory:6) + ($history:boardHistory:0 == $history:boardHistory:8) + ($history:boardHistory:0 == $history:boardHistory:10)
}

rule "tabletop-apply-illegal" {
  when settleHold == 60 and verdict == 0 and move[kind] != 0 and boardMismatch == 0 and promotionPending[0] == -1 and promotionPending[1] == -1
  mode: "Edge"
  illegalCount += 1
}

state {
  lattices [
    grid(band: 0.3, cellSize: 0.2, depth: 8, directions: [
      {
        name: "N"
        x: 0
        y: -1
        z: 0
      }
      {
        name: "NE"
        x: 1
        y: -1
        z: 0
      }
      {
        name: "E"
        x: 1
        y: 0
        z: 0
      }
      {
        name: "SE"
        x: 1
        y: 1
        z: 0
      }
      {
        name: "S"
        x: 0
        y: 1
        z: 0
      }
      {
        name: "SW"
        x: -1
        y: 1
        z: 0
      }
      {
        name: "W"
        x: -1
        y: 0
        z: 0
      }
      {
        name: "NW"
        x: -1
