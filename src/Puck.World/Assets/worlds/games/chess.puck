test "white kingside castle records legal" {
  when {
    seat1: body.pose -7.1 1.3 11.3 0 0 0 34
    seat1: body.pose -7.1 1.3 11.5 0 0 0 33
    ticks 400
    seat1: body.pose -7.1 1.3 11.7 0 0 0 32
    ticks 400
    seat1: body.pose -7.3 1.3 11.3 0 0 0 32
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 35
    seat1: body.pose -7.7 1.3 11.3 0 0 0 32
    ticks 400
  }
  expect {
    verdict == 1
    move[kind] == MoveKind.Castle
    move[mover] == PieceKind.King
    move[from] == 4
    move[to] == 6
    pieceCell[piece4] == 6
    pieceCell[piece7] == 5
    castleRights == 3
    turn == TurnColor.Black
  }
}

test "castle cannot cross knight attack" {
  when {
    seat1: body.pose -7.1 1.3 11.3 0 0 0 34
    seat1: body.pose -7.1 1.3 11.5 0 0 0 33
    seat1: body.pose -7.5 1.3 11.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 35
    seat1: body.pose -7.7 1.3 11.3 0 0 0 32
    ticks 400
  }
  expect {
    castleTransitAttacked[wk] == 1
    verdict == 0
    turn == TurnColor.White
    castleRights == 0
  }
}

test "castle safe when knight does not attack transit" {
  when {
    seat1: body.pose -7.1 1.3 11.3 0 0 0 34
    seat1: body.pose -7.1 1.3 11.5 0 0 0 33
    seat1: body.pose -8.5 1.3 11.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 35
    seat1: body.pose -7.7 1.3 11.3 0 0 0 32
    ticks 400
  }
  expect {
    castleTransitAttacked[wk] == 0
    verdict == 1
    turn == TurnColor.Black
    castleRights == 3
  }
}

test "move leaving king in check is refused" {
  when {
    ticks 400
    seat1: body.pose -7.7 1.3 11.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.9 1.3 11.9 0 0 0 27
    ticks 400
