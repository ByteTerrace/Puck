test "initial position counts in threefold repetition" {
  when {
    ticks 400
    seat1: body.pose -7.7 1.3 11.7 0 0 0 33
    ticks 400
    seat1: body.pose -7.7 1.3 12.3 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 33
    ticks 400
    seat1: body.pose -7.5 1.3 12.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.7 1.3 11.7 0 0 0 33
    ticks 400
    seat1: body.pose -7.7 1.3 12.3 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 33
    ticks 400
    seat1: body.pose -7.5 1.3 12.7 0 0 0 9
    ticks 400
  }
  expect {
    verdict == 1
    turn == TurnColor.White
    repetitionCount == 3
    historyLength == 9
    halfmoveClock == 8
  }
}


test "AI White makes one legal opening move and waits for Black" {
  given {
    aiSide = 0
  }
  when {
    ticks 900
  }
  expect {
    turn == TurnColor.Black
    verdict == 1
    ai[pending] == 0
    aiEnabled == 0
    aiBest[token] == -1
    boardCollisions == 0
  }
}

test "AI Black replies after a human opening" {
  given {
    aiSide = 1
  }
  when {
    ticks 400
    seat1: body.pose -7.9 1.3 11.9 0 0 0 27
    ticks 900
  }
  expect {
    turn == TurnColor.White
    ai[pending] == 0
    aiEnabled == 0
    aiBest[token] == -1
    boardCollisions == 0
  }
}

test "a stale AI answer cannot move a piece" {
  given {
    aiSide = 0
    aiBest[token] = 12
    aiBest[to] = 63
    aiBest[revision] = 0
  }
  when {
    ticks 900
  }
  expect {
    turn == TurnColor.Black
    pieceCell[piece12] != 63
    boardCollisions == 0
    ai[pending] == 0
  }
}
