// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

schema: "puck.world.definition.v1"
documentId: "chinese-checkers"

// What a seat may do to this board: place a piece on a cell. The tests below act as seat 1 and need no more
// authority than a player moving a piece does.
grants [
  {
    capability: "Mutate"
    principal: "seat1"
    subject: "section:state"
  }
  {
    capability: "Edit"
    principal: "seat1"
    subject: "state:pieceCell"
  }
]

state {
  lattices [
    hex(name: "ccHex", origin: [0, 0, 0], cellSize: 1, radius: 3)
  ]

  world {
    row {
      name: "ccBoard"
      kind: "Int"
      domain: cellsOf(topology: "ccHex")
    }

    table pieceCell: Int {
      s0p0 = 21
      s0p1 = 22
      s1p0 = 27
      s1p1 = 26
      s2p0 = 33
      s2p1 = 34
    }

    table pieceCellPrev: Int {
      s0p0 = 21
      s0p1 = 22
      s1p0 = 27
      s1p1 = 26
      s2p0 = 33
      s2p1 = 34
    }

    table pieceSeat: Int {
      s0p0 = 0
      s0p1 = 0
      s1p0 = 1
      s1p1 = 1
      s2p0 = 2
      s2p1 = 2
    }

    slot turn: Int = 0

    slot verdict: Int = 0

    slot moverSeat: Int = 0

    slot moverFrom: Int = -1

    slot moverCell: Int = -1

    slot movedCount: Int = 0

    slot collisionCount: Int = 0

    row {
      name: "legal"
      kind: "Int"
      capacity: 8
      domain: keysOf(row: "pieceCell")
    }

    row {
      name: "counts"
      kind: "Int"
      capacity: 8
      domain: keysOf(row: "pieceCell")
    }

    table best: Int {
      token = -1
      to = -1
      score = 0
    }

    table scores: Int {
      "0" = 0
      "1" = 0
      "2" = 0
    }

    slot appliedToken: Int = -1

    slot appliedTo: Int = -1

    slot shouldApply: Int = 0

    slot home[0..2]: Int = 0

    slot winner: Int = -1

    slot moveCount: Int = 0
  }
}

rule "cc-judge" {
  moverSeat = (pieceSeat[s0p0] * (pieceCell[s0p0] != pieceCellPrev[s0p0])) + (pieceSeat[s0p1] * (pieceCell[s0p1] != pieceCellPrev[s0p1])) + (pieceSeat[s1p0] * (pieceCell[s1p0] != pieceCellPrev[s1p0])) + (pieceSeat[s1p1] * (pieceCell[s1p1] != pieceCellPrev[s1p1])) + (pieceSeat[s2p0] * (pieceCell[s2p0] != pieceCellPrev[s2p0])) + (pieceSeat[s2p1] * (pieceCell[s2p1] != pieceCellPrev[s2p1]))
  moverFrom = (pieceCellPrev[s0p0] * (pieceCell[s0p0] != pieceCellPrev[s0p0])) + (pieceCellPrev[s0p1] * (pieceCell[s0p1] != pieceCellPrev[s0p1])) + (pieceCellPrev[s1p0] * (pieceCell[s1p0] != pieceCellPrev[s1p0])) + (pieceCellPrev[s1p1] * (pieceCell[s1p1] != pieceCellPrev[s1p1])) + (pieceCellPrev[s2p0] * (pieceCell[s2p0] != pieceCellPrev[s2p0])) + (pieceCellPrev[s2p1] * (pieceCell[s2p1] != pieceCellPrev[s2p1]))
  moverCell = (pieceCell[s0p0] * (pieceCell[s0p0] != pieceCellPrev[s0p0])) + (pieceCell[s0p1] * (pieceCell[s0p1] != pieceCellPrev[s0p1])) + (pieceCell[s1p0] * (pieceCell[s1p0] != pieceCellPrev[s1p0])) + (pieceCell[s1p1] * (pieceCell[s1p1] != pieceCellPrev[s1p1])) + (pieceCell[s2p0] * (pieceCell[s2p0] != pieceCellPrev[s2p0])) + (pieceCell[s2p1] * (pieceCell[s2p1] != pieceCellPrev[s2p1]))
  movedCount = (pieceCell[s0p0] != pieceCellPrev[s0p0]) + (pieceCell[s0p1] != pieceCellPrev[s0p1]) + (pieceCell[s1p0] != pieceCellPrev[s1p0]) + (pieceCell[s1p1] != pieceCellPrev[s1p1]) + (pieceCell[s2p0] != pieceCellPrev[s2p0]) + (pieceCell[s2p1] != pieceCellPrev[s2p1])
  collisionCount = (pieceCell[s0p0] == moverCell) + (pieceCell[s0p1] == moverCell) + (pieceCell[s1p0] == moverCell) + (pieceCell[s1p1] == moverCell) + (pieceCell[s2p0] == moverCell) + (pieceCell[s2p1] == moverCell)
  verdict = (movedCount == 1) & (moverSeat == turn) & (collisionCount == 1) & ((hexDistance(moverFrom, moverCell) == 1) | ((hexDistance(moverFrom, moverCell) % 2) == 0))
  turn = (turn + verdict) % 3
  home0 = ((pieceCell[s0p0] == 30) | (pieceCell[s0p0] == 14)) + ((pieceCell[s0p1] == 30) | (pieceCell[s0p1] == 14))
  home1 = ((pieceCell[s1p0] == 36) | (pieceCell[s1p0] == 19)) + ((pieceCell[s1p1] == 36) | (pieceCell[s1p1] == 19))
  home2 = ((pieceCell[s2p0] == 24) | (pieceCell[s2p0] == 25)) + ((pieceCell[s2p1] == 24) | (pieceCell[s2p1] == 25))
  scores[0] = (home0 * 100) - (hexDistance(pieceCell[s0p0], 30) + hexDistance(pieceCell[s0p1], 30))
  scores[1] = (home1 * 100) - (hexDistance(pieceCell[s1p0], 36) + hexDistance(pieceCell[s1p1], 36))
  scores[2] = (home2 * 100) - (hexDistance(pieceCell[s2p0], 24) + hexDistance(pieceCell[s2p1], 24))
  winner = (home0 == 2) ? 0 : ((home1 == 2) ? 1 : ((home2 == 2) ? 2 : winner))
}

rule "cc-apply-best" {
  shouldApply = (best[token] >= 0) & ((best[token] != appliedToken) | (best[to] != appliedTo))
  pieceCell[s0p0] = shouldApply ? ((best[token] == 0) ? best[to] : pieceCell[s0p0]) : pieceCell[s0p0]
  pieceCell[s0p1] = shouldApply ? ((best[token] == 1) ? best[to] : pieceCell[s0p1]) : pieceCell[s0p1]
  pieceCell[s1p0] = shouldApply ? ((best[token] == 2) ? best[to] : pieceCell[s1p0]) : pieceCell[s1p0]
  pieceCell[s1p1] = shouldApply ? ((best[token] == 3) ? best[to] : pieceCell[s1p1]) : pieceCell[s1p1]
  pieceCell[s2p0] = shouldApply ? ((best[token] == 4) ? best[to] : pieceCell[s2p0]) : pieceCell[s2p0]
  pieceCell[s2p1] = shouldApply ? ((best[token] == 5) ? best[to] : pieceCell[s2p1]) : pieceCell[s2p1]
  setState(state: "pieceCellPrev", key: "s0p0", fromState: "pieceCell", fromKey: "s0p0")
  setState(state: "pieceCellPrev", key: "s0p1", fromState: "pieceCell", fromKey: "s0p1")
  setState(state: "pieceCellPrev", key: "s1p0", fromState: "pieceCell", fromKey: "s1p0")
  setState(state: "pieceCellPrev", key: "s1p1", fromState: "pieceCell", fromKey: "s1p1")
  setState(state: "pieceCellPrev", key: "s2p0", fromState: "pieceCell", fromKey: "s2p0")
  setState(state: "pieceCellPrev", key: "s2p1", fromState: "pieceCell", fromKey: "s2p1")
  turn = shouldApply ? ((turn + 1) % 3) : turn
  appliedToken = shouldApply ? best[token] : appliedToken
  appliedTo = shouldApply ? best[to] : appliedTo
  moveCount = moveCount + shouldApply
}

search {
  jobs [
    {
      name: "ccSearch"
      tokens: "pieceCell"
      board: "ccBoard"
      turn: "turn"
      verdict: "verdict"
      shapes [
        relocate(displace: false)
        jump(over: [
          "any"
        ], maxHops: 2
        )
      ]
      legal: "legal"
      counts: "counts"
      depth: 2
      scores: "scores"
      best: "best"
    }
  ]
}

// The win condition, stated in the world's own language: a seat's row of home cells reaching every one of its
// pieces. Seat 0 opens with both pieces off the target cluster (30 and 14), so landing one still leaves the seat
// short and landing the second is the last piece to land.

test "one piece home is not a win" {
  when {
    seat1: world.state.cell.set pieceCell s0p1 14
    ticks 1
  }
  expect {
    home0 == 1
    winner == -1
  }
}

test "the win condition fires when the last piece lands" {
  when {
    seat1: world.state.cell.set pieceCell s0p1 14
    ticks 1
    seat1: world.state.cell.set pieceCell s0p0 30
    ticks 1
  }
  expect {
    home0 == 2
    winner == 0
  }
}
