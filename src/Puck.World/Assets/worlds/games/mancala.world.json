{
  "exports": {
    "actions": [
      "mancalaBoard",
      "mancalaMoveRequest",
      "mancalaSelectedPit"
    ],
    "bindings": [
      "mancalaStatus",
      "mancalaTurn"
    ],
    "reads": [
      "mancalaBoard",
      "mancalaMoveApplied",
      "mancalaPitSeeds",
      "mancalaSelectedPit",
      "mancalaStatus",
      "mancalaTurn"
    ]
  },
  "placements": {
    "rows": [
      {
        "board": {
          "move": "mancalaSelectedPit",
          "occupancy": "mancalaBoard",
          "topology": "mancalaBoard",
          "turn": "mancalaTurn",
          "verdict": "mancalaStatus"
        },
        "id": "mancalaTable",
        "position": [
          -8.0,
          -0.5,
          -16.0
        ],
        "prototypeId": "tabletop",
        "scale": 1.0,
        "yawDegrees": 0.0
      }
    ]
  },
  "rules": [
    {
      "effects": [
        {
          "$type": "setState",
          "fromState": "mancalaMoveRequest",
          "state": "mancalaMoveApplied"
        }
      ],
      "gate": {
        "$type": "all",
        "predicates": [
          {
            "$type": "compareState",
            "comparandState": "mancalaMoveApplied",
            "comparison": "NotEqual",
            "state": "mancalaMoveRequest"
          },
          {
            "$type": "any",
            "predicates": [
              {
                "$type": "compareState",
                "comparison": "Less",
                "state": "mancalaSelectedPit",
                "value": 0
              },
              {
                "$type": "compareState",
                "comparison": "Greater",
                "state": "mancalaSelectedPit",
                "value": 12
              },
              {
                "$type": "compareState",
                "comparison": "Equal",
                "state": "mancalaSelectedPit",
                "value": 6
              }
            ]
          }
        ]
      },
      "mode": "Level",
      "name": "mancala-reject-out-of-range"
    },
    {
      "effects": [
        {
          "$type": "setState",
          "fromState": "mancalaMoveRequest",
          "state": "mancalaMoveApplied"
        }
      ],
      "gate": {
        "$type": "all",
        "predicates": [
          {
            "$type": "compareState",
            "comparandState": "mancalaMoveApplied",
            "comparison": "NotEqual",
            "state": "mancalaMoveRequest"
          },
          {
            "$type": "compareState",
            "comparison": "GreaterOrEqual",
            "state": "mancalaSelectedPit",
            "value": 0
          },
          {
            "$type": "compareState",
            "comparison": "LessOrEqual",
            "state": "mancalaSelectedPit",
            "value": 12
          },
          {
            "$type": "compareState",
            "comparison": "NotEqual",
            "state": "mancalaSelectedPit",
            "value": 6
          },
          {
            "$type": "any",
            "predicates": [
              {
                "$type": "compareState",
                "comparison": "NotEqual",
                "state": "mancalaStatus",
                "value": 0
              },
              {
                "$type": "all",
                "predicates": [
                  {
                    "$type": "compareState",
                    "comparison": "Equal",
                    "state": "mancalaTurn",
                    "value": 0
                  },
                  {
                    "$type": "compareState",
                    "comparison": "Greater",
                    "state": "mancalaSelectedPit",
                    "value": 5
                  }
                ]
              },
              {
                "$type": "all",
                "predicates": [
                  {
                    "$type": "compareState",
                    "comparison": "Equal",
                    "state": "mancalaTurn",
                    "value": 1
                  },
                  {
                    "$type": "compareState",
                    "comparison": "Less",
                    "state": "mancalaSelectedPit",
                    "value": 7
                  }
                ]
              },
              {
                "$type": "compareState",
                "comparison": "Equal",
                "key": "$cell:mancalaSelectedPit:$value",
                "state": "mancalaBoard",
                "value": 0
              }
            ]
          }
        ]
      },
      "mode": "Level",
      "name": "mancala-reject-illegal"
    },
    {
      "bindings": [
        {
          "expression": "(mancalaSelectedPit + 7 * mancalaTurn) % 14",
          "kind": "Int",
          "name": "cStart"
        },
        {
          "expression": "($bind:cStart + mancalaBoard[(mancalaSelectedPit)]) % 13",
          "kind": "Int",
          "name": "cLast"
        },
        {
          "expression": "($bind:cLast + 7 * mancalaTurn) % 14",
          "kind": "Int",
          "name": "pLast"
        },
        {
          "expression": "$bind:cLast == 6 ? 1 : 0",
          "kind": "Int",
          "name": "extra"
        }
      ],
      "effects": [
        {
          "$type": "setState",
          "fromKey": "$cell:mancalaSelectedPit:$value",
          "fromState": "mancalaBoard",
          "state": "mancalaPitSeeds"
        },
        {
          "$type": "setState",
          "expression": "$bind:pLast",
          "state": "mancalaLastPit"
        },
        {
          "$type": "setState",
          "expression": "$bind:extra",
          "state": "mancalaExtraTurn"
        },
        {
          "$type": "setState",
          "fromState": "mancalaMoveRequest",
          "state": "mancalaMoveApplied"
        },
        {
          "$type": "setState",
          "state": "mancalaStage",
          "value": 1
        }
      ],
      "gate": {
        "$type": "all",
        "predicates": [
          {
            "$type": "compareState",
            "comparandState": "mancalaMoveApplied",
            "comparison": "NotEqual",
            "state": "mancalaMoveRequest"
          },
          {
            "$type": "compareState",
            "comparison": "Equal",
            "state": "mancalaStatus",
            "value": 0
          },
          {
            "$type": "any",
            "predicates": [
              {
                "$type": "all",
                "predicates": [
                  {
                    "$type": "compareState",
                    "comparison": "Equal",
                    "state": "mancalaTurn",
                    "value": 0
                  },
                  {
                    "$type": "compareState",
                    "comparison": "GreaterOrEqual",
                    "state": "mancalaSelectedPit",
                    "value": 0
                  },
                  {
                    "$type": "compareState",
                    "comparison": "LessOrEqual",
                    "state": "mancalaSelectedPit",
                    "value": 5
                  }
                ]
              },
              {
                "$type": "all",
                "predicates": [
                  {
                    "$type": "compareState",
                    "comparison": "Equal",
                    "state": "mancalaTurn",
                    "value": 1
                  },
                  {
                    "$type": "compareState",
                    "comparison": "GreaterOrEqual",
                    "state": "mancalaSelectedPit",
                    "value": 7
                  },
                  {
                    "$type": "compareState",
                    "comparison": "LessOrEqual",
                    "state": "mancalaSelectedPit",
                    "value": 12
                  }
                ]
              }
            ]
          },
          {
            "$type": "compareState",
            "comparison": "Greater",
            "key": "$cell:mancalaSelectedPit:$value",
            "state": "mancalaBoard",
            "value": 0
          }
        ]
      },
      "mode": "Level",
      "name": "mancala-stage-move"
    },
    {
      "bindings": [
        {
          "expression": "mancalaPitIndex[$each]",
          "kind": "Int",
          "name": "p"
        },
        {
          "expression": "(mancalaSelectedPit + 7 * mancalaTurn) % 14",
          "kind": "Int",
          "name": "cStart"
        },
        {
          "expression": "($bind:p + 7 * mancalaTurn) % 14",
          "kind": "Int",
          "name": "cp"
        },
        {
          "expression": "($bind:cp - $bind:cStart + 26) % 13",
          "kind": "Int",
          "name": "dRaw"
        },
        {
          "expression": "$bind:dRaw == 0 ? 13 : $bind:dRaw",
          "kind": "Int",
          "name": "dist"
        },
        {
          "expression": "(($bind:cp == 13) | (mancalaPitSeeds < $bind:dist)) ? 0 : (1 + (mancalaPitSeeds - $bind:dist) / 13)",
          "kind": "Int",
          "name": "added"
        }
      ],
      "effects": [
        {
          "$type": "setState",
          "expression": "($bind:p == mancalaSelectedPit ? 0 : mancalaBoard[$each]) + $bind:added",
          "key": "$each",
          "state": "mancalaBoard"
        }
      ],
      "forEach": "mancalaBoard",
      "gate": {
        "$type": "compareState",
        "comparison": "Equal",
        "state": "mancalaStage",
        "value": 1
      },
      "mode": "Level",
      "name": "mancala-sow-board"
    },
    {
      "effects": [
        {
          "$type": "setState",
          "state": "mancalaStage",
          "value": 2
        }
      ],
      "gate": {
        "$type": "compareState",
        "comparison": "Equal",
        "state": "mancalaStage",
        "value": 1
      },
      "mode": "Level",
      "name": "mancala-advance-to-capture"
    },
    {
      "bindings": [
        {
          "expression": "((mancalaLastPit + 7 * mancalaTurn) % 14 <= 5) ? 1 : 0",
          "kind": "Int",
          "name": "isOwnSide"
        },
        {
          "expression": "mancalaLastPit != mancalaSelectedPit ? 1 : 0",
          "kind": "Int",
          "name": "isNotSelected"
        },
        {
          "expression": "mancalaBoard[(mancalaLastPit)] == (1 + (mancalaPitSeeds - 1) / 13) ? 1 : 0",
          "kind": "Int",
          "name": "wasEmpty"
        },
        {
          "expression": "mancalaBoard[(12 - mancalaLastPit)] > 0 ? 1 : 0",
          "kind": "Int",
          "name": "oppositeHasSeeds"
        },
        {
          "expression": "$bind:isOwnSide & $bind:isNotSelected & $bind:wasEmpty & $bind:oppositeHasSeeds",
          "kind": "Int",
          "name": "canCapture"
        }
      ],
      "effects": [
        {
          "$type": "setState",
          "expression": "mancalaBoard[(6 + 7 * mancalaTurn)] + mancalaBoard[(mancalaLastPit)] + mancalaBoard[(12 - mancalaLastPit)]",
          "key": "$expr:6 + 7 * mancalaTurn",
          "state": "mancalaBoard"
        },
        {
          "$type": "setState",
          "key": "$cell:mancalaLastPit:$value",
          "state": "mancalaBoard",
          "value": 0
        },
        {
          "$type": "setState",
          "key": "$expr:12 - mancalaLastPit",
          "state": "mancalaBoard",
          "value": 0
        },
        {
          "$type": "setState",
          "state": "mancalaStage",
          "value": 3
        }
      ],
      "gate": {
        "$type": "all",
        "predicates": [
          {
            "$type": "compareState",
            "comparison": "Equal",
            "state": "mancalaStage",
            "value": 2
          },
          {
            "$type": "compareState",
            "comparison": "Equal",
            "state": "$bind:canCapture",
            "value": 1
          }
        ]
      },
      "mode": "Level",
      "name": "mancala-apply-capture"
    },
    {
      "effects": [
        {
          "$type": "setState",
          "state": "mancalaStage",
          "value": 3
        }
      ],
      "gate": {
        "$type": "compareState",
        "comparison": "Equal",
        "state": "mancalaStage",
        "value": 2
      },
      "mode": "Level",
      "name": "mancala-skip-capture"
    },
    {
      "effects": [
        {
          "$type": "setState",
          "expression": "mancalaExtraTurn == 1 ? mancalaTurn : (1 - mancalaTurn)",
          "state": "mancalaTurn"
        },
        {
          "$type": "setState",
          "state": "mancalaStage",
          "value": 4
        }
      ],
      "gate": {
        "$type": "compareState",
        "comparison": "Equal",
        "state": "mancalaStage",
        "value": 3
      },
      "mode": "Level",
      "name": "mancala-update-turn"
    },
    {
      "bindings": [
        {
          "expression": "mancalaBoard[0] + mancalaBoard[1] + mancalaBoard[2] + mancalaBoard[3] + mancalaBoard[4] + mancalaBoard[5]",
          "kind": "Int",
          "name": "p0Sum"
        },
        {
          "expression": "mancalaBoard[7] + mancalaBoard[8] + mancalaBoard[9] + mancalaBoard[10] + mancalaBoard[11] + mancalaBoard[12]",
          "kind": "Int",
          "name": "p1Sum"
        },
        {
          "expression": "($bind:p0Sum == 0) | ($bind:p1Sum == 0) ? 1 : 0",
          "kind": "Int",
          "name": "isGameOver"
        },
        {
          "expression": "mancalaBoard[6] + $bind:p0Sum",
          "kind": "Int",
          "name": "final0"
        },
        {
          "expression": "mancalaBoard[13] + $bind:p1Sum",
          "kind": "Int",
          "name": "final1"
        },
        {
          "expression": "$bind:final0 > $bind:final1 ? 1 : ($bind:final1 > $bind:final0 ? 2 : 3)",
          "kind": "Int",
          "name": "winner"
        }
      ],
      "effects": [
        {
          "$type": "setState",
          "expression": "$bind:final0",
          "key": "6",
          "state": "mancalaBoard"
        },
        {
          "$type": "setState",
          "expression": "$bind:final1",
          "key": "13",
          "state": "mancalaBoard"
        },
        {
          "$type": "setState",
          "key": "0",
          "state": "mancalaBoard",
          "value": 0
