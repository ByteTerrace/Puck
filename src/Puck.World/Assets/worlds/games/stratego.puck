// Stratego — the classic two-army game of hidden ranks on a 10x10 board.
// Rule set: the Milton Bradley / Jumbo classic rules as summarised by
// https://en.wikipedia.org/wiki/Stratego (ranks, the 40-piece army, the two
// lakes, the Spy/Marshal, Miner/Bomb and Scout exceptions). The reductions this
// module makes deliberately are listed in the games README.
//
// This is a module fragment, not a bootable world: a host supplies the seats,
// the `attack` channel the two ready presses arrive on, and the simulation rate.
// tests/Puck.World.Tests/Fixtures/minimal-stratego-host.world.json is that host.
//
// Ranks. 1 Marshal, 2 General, 3 Colonel, 4 Major, 5 Captain, 6 Lieutenant,
// 7 Sergeant, 8 Miner, 9 Scout, 10 Spy, 11 Bomb, 12 Flag. A LOWER number wins,
// so 1 beats 2. 11 and 12 never move; 1..10 do.
//
// Board. Cell ordinal = row * 10 + column, rows counted from red's back rank.
// `strategoOwner` is the one public board: 0 empty, 1 red, 2 blue, 3 lake. The
// lakes are authored as owner 3 and never change, so a ray pattern over
// `strategoOwner` stops at a lake exactly as it stops at a piece.

export action strategoFrom, strategoRequest, strategoTo
export binding strategoMoves, strategoPhase, strategoResult, strategoTurn, strategoWinner
// One line: `puck fmt` unindents a wrapped export continuation and the parser then
// reads the facet as empty, so a wrapped list silently loses every name.
export read strategoApplied, strategoBlueKnows, strategoBlueRank, strategoMoves, strategoOwner, strategoPhase, strategoReady, strategoRedKnows, strategoRedRank, strategoResult, strategoTurn, strategoWinner

// Red's army, cell 0 (back rank, left) through cell 39 (front rank, right).
let redSetup = [
  11, 12, 11, 3, 6, 7, 5, 4, 6, 11,
  7, 11, 7, 5, 2, 1, 5, 4, 6, 3,
  8, 8, 10, 8, 5, 6, 4, 7, 8, 11,
  9, 9, 9, 9, 8, 9, 9, 9, 9, 11
]

// Blue's army, cell 60 (front rank) through cell 99 (back rank), the same
// forty pieces read the other way up.
let blueSetup = [
  11, 9, 9, 9, 9, 8, 9, 9, 9, 9,
  11, 8, 7, 4, 6, 5, 8, 10, 8, 8,
  3, 6, 4, 5, 1, 2, 5, 7, 11, 7,
  11, 6, 4, 5, 7, 6, 3, 11, 12, 11
]

// The two 2x2 lakes, rows 4 and 5, columns 2-3 and 6-7.
let lakeCells = [42, 43, 46, 47, 52, 53, 56, 57]

patterns [
  {
    kind: "Int"
    name: "strategoEmptyRun"
    pattern: star(item: symbol(name: "vacant"))
    symbols [
      {
        max: 0
        min: 0
        name: "vacant"
      }
    ]
  }
]

// Each side declares its setup finished by holding its own seat's `attack`
// control. Until both have, every move request is refused.
rule "stratego-red-ready" {
  when strategoPhase == 0 and $channel:1:attack >= 1
  mode: "Edge"
  strategoReady[red] = 1
}

rule "stratego-blue-ready" {
  when strategoPhase == 0 and $channel:2:attack >= 1
  mode: "Edge"
  strategoReady[blue] = 1
}

rule "stratego-begin" {
  when strategoPhase == 0 and strategoReady[red] == 1 and strategoReady[blue] == 1
  mode: "Edge"
  strategoPhase = 1
}

// One judgement per pending request. Every later rule reads the slots this
// writes, so the legality of a move is stated once rather than per outcome.
rule "stratego-judge" {
  when strategoRequest != strategoApplied and strategoPhase == 1 and strategoWinner == 0
  mode: "Edge"
  local mover: Int = strategoOwner[strategoFrom[$value]]
  local rank: Int = strategoTurn == 1 ? strategoRedRank[strategoFrom[$value]] : strategoBlueRank[strategoFrom[$value]]
  local target: Int = strategoOwner[strategoTo[$value]]
  local dRow: Int = strategoTo / 10 - strategoFrom / 10
  local dCol: Int = strategoTo % 10 - strategoFrom % 10
  local dist: Int = absolute($local:dRow) + absolute($local:dCol)
  local line: Int = (($local:dRow == 0) + ($local:dCol == 0)) == 1
  local blocker: Int = $local:dRow < 0 ? $match:strategoEmptyRun:strategoOwner:N:distance[strategoFrom[$value]] : ($local:dRow > 0 ? $match:strategoEmptyRun:strategoOwner:S:distance[strategoFrom[$value]] : ($local:dCol > 0 ? $match:strategoEmptyRun:strategoOwner:E:distance[strategoFrom[$value]] : $match:strategoEmptyRun:strategoOwner:W:distance[strategoFrom[$value]]))
  local reach: Int = $local:rank == 9 ? ($local:target == 0 ? (($local:blocker < 0) | ($local:blocker > $local:dist)) : ($local:dist == 1)) : ($local:dist == 1)
  strategoMoveRank = $local:rank
  strategoTargetOwner = $local:target
  strategoDefRank = strategoTurn == 1 ? strategoBlueRank[strategoTo[$value]] : strategoRedRank[strategoTo[$value]]
  strategoLegal = ($local:mover == strategoTurn) & ($local:rank >= 1) & ($local:rank <= 10) & ($local:target != strategoTurn) & ($local:target != 3) & ($local:line == 1) & $local:reach
}

rule "stratego-red-move" {
  when strategoRequest != strategoApplied and strategoPhase == 1 and strategoWinner == 0 and strategoLegal == 1 and strategoTurn == 1 and strategoTargetOwner == 0
  mode: "Edge"
  local rank: Int = strategoRedRank[strategoFrom[$value]]
  strategoOwner[strategoTo[$value]] = 1
  strategoOwner[strategoFrom[$value]] = 0
  strategoRedRank[strategoTo[$value]] = $local:rank
  remove strategoRedRank[strategoFrom[$value]]
  strategoTurn = 2
  strategoMoves += 1
  strategoResult = 1
  strategoApplied = strategoRequest
}

rule "stratego-blue-move" {
  when strategoRequest != strategoApplied and strategoPhase == 1 and strategoWinner == 0 and strategoLegal == 1 and strategoTurn == 2 and strategoTargetOwner == 0
  mode: "Edge"
  local rank: Int = strategoBlueRank[strategoFrom[$value]]
  strategoOwner[strategoTo[$value]] = 2
  strategoOwner[strategoFrom[$value]] = 0
  strategoBlueRank[strategoTo[$value]] = $local:rank
  remove strategoBlueRank[strategoFrom[$value]]
  strategoTurn = 1
  strategoMoves += 1
  strategoResult = 1
  strategoApplied = strategoRequest
}

// A strike reveals both pieces to each other before anything is removed: the
// seen mask is raised over the one square each side learns about, `observe`
// folds the source rank into that side's knowledge board with its own tick
// stamp, and the mask is lowered again so a later strike elsewhere cannot
// overwrite the memory with whatever stands on the square afterwards.
rule "stratego-red-strike" {
  when strategoRequest != strategoApplied and strategoPhase == 1 and strategoWinner == 0 and strategoLegal == 1 and strategoTurn == 1 and strategoTargetOwner == 2
  mode: "Edge"
  local rank: Int = strategoRedRank[strategoFrom[$value]]
  local def: Int = strategoBlueRank[strategoTo[$value]]
  local outcome: Int = $local:def == 12 ? 1 : ($local:def == 11 ? ($local:rank == 8 ? 1 : -1) : ($local:def == 10 ? 1 : ($local:rank == 10 ? ($local:def == 1 ? 1 : -1) : ($local:rank < $local:def ? 1 : ($local:rank > $local:def ? -1 : 0)))))
  strategoRedSeen[strategoTo[$value]] = 1
  strategoBlueSeen[strategoFrom[$value]] = 1
  transform observe(row: "strategoRedKnows")
  transform observe(row: "strategoBlueKnows")
  strategoRedSeen[strategoTo[$value]] = 0
  strategoBlueSeen[strategoFrom[$value]] = 0
  if $local:outcome == 1 {
    remove strategoBlueRank[strategoTo[$value]]
    remove strategoRedRank[strategoFrom[$value]]
    strategoRedRank[strategoTo[$value]] = $local:rank
    strategoOwner[strategoTo[$value]] = 1
    strategoOwner[strategoFrom[$value]] = 0
  } else if $local:outcome == -1 {
    remove strategoRedRank[strategoFrom[$value]]
    strategoOwner[strategoFrom[$value]] = 0
  } else {
    remove strategoRedRank[strategoFrom[$value]]
    remove strategoBlueRank[strategoTo[$value]]
    strategoOwner[strategoFrom[$value]] = 0
    strategoOwner[strategoTo[$value]] = 0
  }
  if $local:def == 12 {
    strategoWinner = 1
    strategoPhase = 2
    strategoReveal[red] = "seat2"
    strategoReveal[blue] = "seat1"
  }
  strategoTurn = 2
  strategoMoves += 1
  strategoResult = 1
  strategoApplied = strategoRequest
}

rule "stratego-blue-strike" {
  when strategoRequest != strategoApplied and strategoPhase == 1 and strategoWinner == 0 and strategoLegal == 1 and strategoTurn == 2 and strategoTargetOwner == 1
  mode: "Edge"
  local rank: Int = strategoBlueRank[strategoFrom[$value]]
  local def: Int = strategoRedRank[strategoTo[$value]]
  local outcome: Int = $local:def == 12 ? 1 : ($local:def == 11 ? ($local:rank == 8 ? 1 : -1) : ($local:def == 10 ? 1 : ($local:rank == 10 ? ($local:def == 1 ? 1 : -1) : ($local:rank < $local:def ? 1 : ($local:rank > $local:def ? -1 : 0)))))
  strategoBlueSeen[strategoTo[$value]] = 1
  strategoRedSeen[strategoFrom[$value]] = 1
  transform observe(row: "strategoBlueKnows")
  transform observe(row: "strategoRedKnows")
  strategoBlueSeen[strategoTo[$value]] = 0
  strategoRedSeen[strategoFrom[$value]] = 0
  if $local:outcome == 1 {
    remove strategoRedRank[strategoTo[$value]]
    remove strategoBlueRank[strategoFrom[$value]]
    strategoBlueRank[strategoTo[$value]] = $local:rank
    strategoOwner[strategoTo[$value]] = 2
    strategoOwner[strategoFrom[$value]] = 0
  } else if $local:outcome == -1 {
    remove strategoBlueRank[strategoFrom[$value]]
    strategoOwner[strategoFrom[$value]] = 0
  } else {
    remove strategoBlueRank[strategoFrom[$value]]
    remove strategoRedRank[strategoTo[$value]]
    strategoOwner[strategoFrom[$value]] = 0
    strategoOwner[strategoTo[$value]] = 0
  }
  if $local:def == 12 {
    strategoWinner = 2
    strategoPhase = 2
    strategoReveal[red] = "seat2"
    strategoReveal[blue] = "seat1"
  }
  strategoTurn = 1
  strategoMoves += 1
  strategoResult = 1
  strategoApplied = strategoRequest
}

// An illegal move is acknowledged without moving a piece and without ending the
// turn: the mover requests again.
rule "stratego-refuse" {
  when strategoRequest != strategoApplied and strategoPhase == 1 and strategoWinner == 0 and strategoLegal == 0
  mode: "Edge"
  strategoResult = -1
  strategoApplied = strategoRequest
}

rule "stratego-refuse-closed" {
  when strategoRequest != strategoApplied and (strategoPhase != 1 or strategoWinner != 0)
  mode: "Edge"
  strategoResult = -1
  strategoApplied = strategoRequest
}

state {
  lattices [
    grid(cellSize: 1, depth: 10, name: "strategoField", origin: [0, 0, 0], width: 10)
  ]

  world {
    // The one public board. `phaseOf` names the guarded submission stamp an
    // external gameplay transform writing this board must present.
    row {
      cells: concat(concat(map(range(0, 40), i => {
        key: $"{i}",
        value: 1
      }
      ), map(range(0, 40), i => {
        key: $"{60 + i}",
        value: 2
      }
      )
      ), map(lakeCells, c => {
        key: $"{c}",
        value: 3
      }
      )
      )
      domain: cellsOf(topology: "strategoField")
      kind: "Int"
      name: "strategoOwner"
      phaseOf: "strategoTurnGuard"
    }

    row {
      kind: "Int"
      name: "strategoTurnGuard"
      phase {
        sequence: 0
      }
    }

    // Each side's own ranks, readable by that side alone until the armies
    // are revealed through `strategoReveal` at the end of the game.
    row {
      cells: map(range(0, 40), i => {
        key: $"{i}",
        value: redSetup[i]
      }
      )
      domain: cellsOf(topology: "strategoField")
      kind: "Int"
      name: "strategoRedRank"
      visibility {
        readers [
          "seat1"
        ]
        readersFrom: "strategoReveal"
      }
    }

    row {
      cells: map(range(0, 40), i => {
        key: $"{60 + i}",
        value: blueSetup[i]
      }
      )
      domain: cellsOf(topology: "strategoField")
      kind: "Int"
      name: "strategoBlueRank"
      visibility {
        readers [
          "seat2"
        ]
        readersFrom: "strategoReveal"
      }
    }

    // The observation masks: one square is raised for the duration of one
    // strike and lowered again in the same rule.
    row {
      domain: cellsOf(topology: "strategoField")
      kind: "Bool"
      name: "strategoRedSeen"
    }

    row {
      domain: cellsOf(topology: "strategoField")
      kind: "Bool"
      name: "strategoBlueSeen"
    }

    // What each side remembers of the other's ranks, square by square.
    row {
      domain: cellsOf(topology: "strategoField")
      kind: "Int"
      knowledge {
        mask: "strategoRedSeen"
        source: "strategoBlueRank"
      }
      name: "strategoRedKnows"
      visibility {
        readers [
          "seat1"
        ]
      }
    }

    row {
      domain: cellsOf(topology: "strategoField")
      kind: "Int"
      knowledge {
        mask: "strategoBlueSeen"
        source: "strategoRedRank"
      }
      name: "strategoBlueKnows"
      visibility {
        readers [
          "seat2"
        ]
      }
    }

    // The live audience both rank boards widen through when the flag falls.
    row {
      capacity: 2
      cells []
      kind: "Text"
      name: "strategoReveal"
    }

    table strategoReady: Int {
      red = 0
      blue = 0
    }

    slot strategoPhase: Int = 0 bounds(minimum: 0, maximum: 2)

    slot strategoTurn: Int = 1 bounds(minimum: 1, maximum: 2)

    slot strategoFrom: Int = 0 bounds(minimum: 0, maximum: 99)

    slot strategoTo: Int = 0 bounds(minimum: 0, maximum: 99)

    slot strategoRequest: Int = 0 bounds(minimum: 0)

    slot strategoApplied: Int = 0 bounds(minimum: 0)

    slot strategoResult: Int = 0 bounds(minimum: -1, maximum: 1)

    slot strategoLegal: Int = 0 bounds(minimum: 0, maximum: 1)

    slot strategoMoveRank: Int = 0 bounds(minimum: 0, maximum: 12)

    slot strategoDefRank: Int = 0 bounds(minimum: 0, maximum: 12)

    slot strategoTargetOwner: Int = 0 bounds(minimum: 0, maximum: 3)

    slot strategoMoves: Int = 0 bounds(minimum: 0)

    slot strategoWinner: Int = 0 bounds(minimum: 0, maximum: 2)
  }
}
