// Word spy — a 5x5 word grid, a key card only the two spymasters see, and two
// teams racing to find their own words.
//
// Rule set: twenty-five word cards; a key card assigning nine cards to the
// starting team, eight to the other, seven neutral cards and one trap; the
// spymaster gives a one-word clue and a number; the team touches cards one at a
// time and may make the number plus one guesses; touching one of its own words
// lets it guess again, anything else ends the turn, and the trap loses the game
// outright; the first team to find all its own words wins. The reductions this
// module makes deliberately are listed in the games README.
//
// Seats are the four roles: 1 red spymaster, 2 red guesser, 3 blue spymaster,
// 4 blue guesser. `wordSpyKey`, the four hidden live masks derived from it,
// and everything the spymaster computes from them (the aim, the clue, its log,
// the chosen word, the shortlist) admit seats 1 and 3 as readers and nobody
// else; every other row is public. No transform writes a row a wider audience
// reads than the rows it reads, so the clue word reaches the guessers only
// through the number rules' own write.
//
// A cell is its own key: grid ordinal "0".."24", row-major over the 5x5 board.
// `wordSpyWords` carries the word at each ordinal and `embeds` mints the
// companion vector row beside it, so a board ordinal addresses the word, its
// vector, its key-card identity and its reveal state under one key.
//
// This is a module fragment, not a bootable world: a host supplies the four
// seats. tests/Puck.World.Tests/Fixtures/minimal-wordspy-host.world.json is
// that host.
//
// The array order is the schedule. Every pending flag is consumed by a rule
// declared ABOVE the rule that raises it, so each stage of the clue pipeline
// reads a frame the previous tick already folded — which is what the vector
// transforms need, since `mean`, `mix`, `nearest` and `remember` all take the
// cross-row path and land at the tick boundary rather than in the rule frame.

// One line: `puck format` unindents a wrapped export continuation and the parser then
// reads the facet as empty, so a wrapped list silently loses every name.
export action wordSpyAct
export binding wordSpyClueNumber, wordSpyStage, wordSpyTurn, wordSpyWinner
export read wordSpyAct, wordSpyAim, wordSpyBlueLeft, wordSpyBoardLive, wordSpyBoardShown, wordSpyClue, wordSpyClueChoice, wordSpyClueLog, wordSpyClueNumber, wordSpyClueWord, wordSpyHint, wordSpyKey, wordSpyLexicon, wordSpyRedLeft, wordSpyStage, wordSpyTable, wordSpyTurn, wordSpyWinner, wordSpyWords

// The key card. 1 red word, 2 blue word, 3 neutral, 4 trap.
// Nine red, eight blue, seven neutral, one trap — red leads.
let keyCard = [
  1, 3, 2, 1, 2,
  2, 1, 3, 1, 3,
  2, 1, 4, 3, 1,
  3, 2, 1, 2, 1,
  2, 3, 1, 2, 3
]

// The public board: one row per grid cell, its reveal state and whether it is
// still on the table. `shown` is 0 face down, else the key-card identity the
// touch turned up; `live` is the keyed Bool mask `nearest` and `mean` filter on.
sql {
  CREATE TABLE wordSpyBoard (
    id    TEXT PRIMARY KEY,
    shown INT  NOT NULL DEFAULT 0 CHECK (shown BETWEEN 0 AND 4),
    live  BOOL NOT NULL DEFAULT TRUE
  ) CAPACITY 25;

  INSERT INTO wordSpyBoard (id, shown, live) VALUES
  ('0',  0, TRUE),
  ('1',  0, TRUE),
  ('2',  0, TRUE),
  ('3',  0, TRUE),
  ('4',  0, TRUE),
  ('5',  0, TRUE),
  ('6',  0, TRUE),
  ('7',  0, TRUE),
  ('8',  0, TRUE),
  ('9',  0, TRUE),
  ('10', 0, TRUE),
  ('11', 0, TRUE),
  ('12', 0, TRUE),
  ('13', 0, TRUE),
  ('14', 0, TRUE),
  ('15', 0, TRUE),
  ('16', 0, TRUE),
  ('17', 0, TRUE),
  ('18', 0, TRUE),
  ('19', 0, TRUE),
  ('20', 0, TRUE),
  ('21', 0, TRUE),
  ('22', 0, TRUE),
  ('23', 0, TRUE),
  ('24', 0, TRUE);

  DECLARE wordSpyStage INT DEFAULT 0 CHECK (wordSpyStage BETWEEN 0 AND 3);

  DECLARE wordSpyTurn INT DEFAULT 1 CHECK (wordSpyTurn BETWEEN 1 AND 2);

  DECLARE wordSpyRedLeft INT DEFAULT 9 CHECK (wordSpyRedLeft >= 0);

  DECLARE wordSpyBlueLeft INT DEFAULT 8 CHECK (wordSpyBlueLeft >= 0);

  DECLARE wordSpyWinner INT DEFAULT 0 CHECK (wordSpyWinner BETWEEN 0 AND 2);

  DECLARE wordSpyClueNumber INT DEFAULT 0 CHECK (wordSpyClueNumber >= 0);
}

// The clue number is read off the shortlist: how many of the three board words
// the clue pulled are the clueing team's own live words. That is exactly what a
// clue's number says, and it is public while the shortlist itself is not. The
// chosen clue word is said here too, beside its number.
rule "wordspy-number-red" {
  when wordSpyTable[numberPending] == 1 and wordSpyTurn == 1
  local n = count(wordSpyHint, where: wordSpyRedLive)
  mode: Level
  wordSpyClueWord = wordSpyClueChoice
  wordSpyClueNumber = n
  wordSpyTable[guessesLeft] = n + 1
  wordSpyTable[clueNo] += 1
  wordSpyStage = 2
  wordSpyTable[numberPending] = 0
}

rule "wordspy-number-blue" {
  when wordSpyTable[numberPending] == 1 and wordSpyTurn == 2
  local n = count(wordSpyHint, where: wordSpyBlueLive)
  mode: Level
  wordSpyClueWord = wordSpyClueChoice
  wordSpyClueNumber = n
  wordSpyTable[guessesLeft] = n + 1
  wordSpyTable[clueNo] += 1
  wordSpyStage = 2
  wordSpyTable[numberPending] = 0
}

// The spymaster speaks. `nearest` over the lexicon picks the one clue word its
// aim is closest to; `nearest` over the board words, filtered to the cells still
// on the table, is the private shortlist the number is counted from; `remember`
// files the aim under the clue's own number and refuses a near-duplicate of a
// clue this game already carries.
rule "wordspy-pick" {
  when wordSpyTable[pickPending] == 1
  mode: Level
  transform nearest(from: wordSpyLexiconVectors, query: wordSpyClue, into: wordSpyClueChoice, k: 1)
  transform nearest(from: wordSpyWordVectors, query: wordSpyClue, into: wordSpyHint, k: 3, where: wordSpyBoardLive)
  transform remember(into: wordSpyClueLog, key: wordSpyTable[clueNo], from: wordSpyClue, unlessWithin: 0.9)
  wordSpyTable[pickPending] = 0
  wordSpyTable[numberPending] = 1
}

// Aim at our own words and away from the cards that would cost us the turn or
// the game: three parts toward the team's live words, one part away from the
// mean of the opposing words and the trap. Negative weights are what `mix`
// is for.
rule "wordspy-mix" {
  when wordSpyTable[mixPending] == 1
  mode: Level
  transform mix(into: wordSpyClue, terms: [
    {
      from: wordSpyAim[own]
      weight: 3
    }
    {
      from: wordSpyAim[avoid]
      weight: -1
    }
  ]
  )
  wordSpyTable[mixPending] = 0
  wordSpyTable[pickPending] = 1
}

rule "wordspy-aim-red" {
  when wordSpyTable[aimPending] == 1 and wordSpyTurn == 1
  mode: Level
  transform mean(from: wordSpyWordVectors, into: wordSpyAim[own], where: wordSpyRedLive)
  transform mean(from: wordSpyWordVectors, into: wordSpyAim[avoid], where: wordSpyRedAvoid)
  wordSpyTable[aimPending] = 0
  wordSpyTable[mixPending] = 1
}

rule "wordspy-aim-blue" {
  when wordSpyTable[aimPending] == 1 and wordSpyTurn == 2
  mode: Level
  transform mean(from: wordSpyWordVectors, into: wordSpyAim[own], where: wordSpyBlueLive)
  transform mean(from: wordSpyWordVectors, into: wordSpyAim[avoid], where: wordSpyBlueAvoid)
  wordSpyTable[aimPending] = 0
  wordSpyTable[mixPending] = 1
}

// The four hidden masks the spymasters aim with, rebuilt from the key card and
// the public reveal state whenever a card turns over. A `mean`/`nearest` filter
// must be a keyed Bool row.
rule "wordspy-live-refresh" {
  when wordSpyTable[livePending] == 1
  mode: Level
  forEach: wordSpyKey
  if wordSpyBoardLive[$each] == 1 and wordSpyKey[$each] == 1 {
    wordSpyRedLive[$each] = 1
    wordSpyBlueLive[$each] = 0
    wordSpyRedAvoid[$each] = 0
    wordSpyBlueAvoid[$each] = 1
  } else if wordSpyBoardLive[$each] == 1 and wordSpyKey[$each] == 2 {
    wordSpyRedLive[$each] = 0
    wordSpyBlueLive[$each] = 1
    wordSpyRedAvoid[$each] = 1
    wordSpyBlueAvoid[$each] = 0
  } else if wordSpyBoardLive[$each] == 1 and wordSpyKey[$each] == 4 {
    wordSpyRedLive[$each] = 0
    wordSpyBlueLive[$each] = 0
    wordSpyRedAvoid[$each] = 1
    wordSpyBlueAvoid[$each] = 1
  } else {
    wordSpyRedLive[$each] = 0
    wordSpyBlueLive[$each] = 0
    wordSpyRedAvoid[$each] = 0
    wordSpyBlueAvoid[$each] = 0
  }
}

// A clue is only asked for when a team is on turn with none pending; the mask
// refresh itself runs after every reveal.
rule "wordspy-live-done" {
  when wordSpyTable[livePending] == 1
  mode: Level
  wordSpyTable[livePending] = 0
  wordSpyTable[aimPending] = wordSpyStage == 1 ? 1 : 0
}

// What the card turned out to be decides the rest: an own word lets the team
// guess again while it has guesses left, anything else passes the turn, the
// trap hands the game to the other team, and a team out of words wins.
rule "wordspy-settle" {
  when wordSpyTable[settlePending] == 1
  local card = wordSpyTable[revealCard]
  local mine = card == wordSpyTurn ? 1 : 0
  local winner = card == 4 ? (wordSpyTurn == 1 ? 2 : 1) : (wordSpyRedLeft == 0 ? 1 : (wordSpyBlueLeft == 0 ? 2 : 0))
  local more = (mine == 1) & (wordSpyTable[guessesLeft] > 0)
  mode: Level
  transaction {
    wordSpyWinner = winner
    wordSpyStage = winner != 0 ? 3 : (more == 1 ? 2 : 1)
    wordSpyTurn = (winner == 0) & (more == 0) ? (wordSpyTurn == 1 ? 2 : 1) : wordSpyTurn
    wordSpyTable[guessesLeft] = more == 1 ? wordSpyTable[guessesLeft] : 0
    wordSpyTable[livePending] = winner == 0 ? 1 : 0
    wordSpyTable[settlePending] = 0
  }
}

// The touch itself, one tick after the judgement, so the two computed keys the
// board write needs are the only ones any rule in this document spells.
rule "wordspy-reveal" {
  when wordSpyTable[revealPending] == 1
  mode: Level
  wordSpyBoardShown[wordSpyTable[revealWord]] = wordSpyTable[revealCard]
  wordSpyBoardLive[wordSpyTable[revealWord]] = 0
  wordSpyTable[revealPending] = 0
  wordSpyTable[settlePending] = 1
}

// An accepted guess: the guesser of the team on turn, a cell in range that is
// still on the table, and a guess still owed on the current clue.
rule "wordspy-guess" {
  when wordSpyStage == 2 and wordSpyAct[ready] == 1 and legal == 1
  local legal = wordSpyAct[wordOk] & wordSpyAct[seatOk] & wordSpyAct[isLive] & (wordSpyTable[guessesLeft] > 0 ? 1 : 0)
  mode: Level
  transaction {
    wordSpyTable[revealWord] = wordSpyAct[safeWord]
    wordSpyTable[revealCard] = wordSpyAct[card]
    wordSpyTable[revealPending] = 1
    wordSpyRedLeft += wordSpyAct[card] == 1 ? -1 : 0
    wordSpyBlueLeft += wordSpyAct[card] == 2 ? -1 : 0
    wordSpyTable[guessesLeft] += -1
    wordSpyTable[accepted] += 1
    wordSpyAct[applied] = wordSpyAct[request]
    wordSpyAct[result] = 1
    wordSpyAct[ready] = 0
  }
}

// Everything the rule above did not accept is refused by name: the request is
// acknowledged, no card turns over, and the refusal is counted. A spymaster
// guessing, a card already face up, a cell off the board, a guess before the
// clue lands, and a guess after the game is over all land here.
rule "wordspy-refuse" {
  when wordSpyAct[ready] == 1
  mode: Level
  wordSpyAct[applied] = wordSpyAct[request]
  wordSpyAct[result] = -1
  wordSpyAct[ready] = 0
  wordSpyTable[refused] += 1
}

// The request resolved into plain literal-keyed numbers one tick before any rule
// judges it, so the judging rules spell no computed cell key at all.
rule "wordspy-resolve" {
  when wordSpyAct[request] != wordSpyAct[applied] and wordSpyAct[ready] == 0 and wordSpyTable[revealPending] == 0 and wordSpyTable[settlePending] == 0
  local wordOk = (wordSpyAct[word] >= 0) & (wordSpyAct[word] <= 24)
  local safeWord = wordOk == 1 ? wordSpyAct[word] : 0
  local guesser = wordSpyTurn == 1 ? 2 : 4
  mode: Level
  wordSpyAct[wordOk] = wordOk
  wordSpyAct[safeWord] = safeWord
  wordSpyAct[seatOk] = wordSpyAct[seat] == guesser
  if wordSpyBoardLive[(safeWord)] == 1 {
    wordSpyAct[isLive] = wordOk
  } else {
    wordSpyAct[isLive] = 0
  }
  wordSpyAct[card] = wordSpyKey[(safeWord)]
  wordSpyAct[ready] = 1
}

rule "wordspy-begin" {
  when wordSpyStage == 0
  mode: Level
  wordSpyStage = 1
  wordSpyTable[livePending] = 1
}

state {
  spaces {
    space wordSpySpace {
      model: "puck-fixture"
      revision: "1"
      dimensions: 64
    }
  }

  world {
    // The twenty-five board words, keyed by grid ordinal. `embeds` mints
    // `wordSpyWordVectors` beside this row, one vector per key, locked in
    // wordspy.embeddings.json by `puck embed`.
    table wordSpyWords capacity(25) embeds(wordSpyWordVectors) {
      "0" = "anchor"
      "1" = "blanket"
      "2" = "canyon"
      "3" = "comet"
      "4" = "compass"
      "5" = "ember"
      "6" = "falcon"
      "7" = "feather"
      "8" = "glacier"
      "9" = "harbor"
      "10" = "kettle"
      "11" = "ladder"
      "12" = "lagoon"
      "13" = "lantern"
      "14" = "meadow"
      "15" = "orchard"
      "16" = "pepper"
      "17" = "pillow"
      "18" = "quarry"
      "19" = "saddle"
      "20" = "thunder"
      "21" = "tunnel"
      "22" = "velvet"
      "23" = "violin"
      "24" = "whistle"
    }

    // The clue vocabulary: twelve words that are NOT on the board, which is what
    // makes a clue a clue. `nearest` writes the winning key into a Text slot and
    // this row reads the word back.
    table wordSpyLexicon capacity(12) embeds(wordSpyLexiconVectors) {
      cold = "cold"
      heat = "heat"
      water = "water"
      flight = "flight"
      music = "music"
      metal = "metal"
      money = "money"
      hunting = "hunting"
      sport = "sport"
      journey = "journey"
      night = "night"
      medicine = "medicine"
    }

    // The key card. Only the two spymasters may read it.
    row {
      capacity: 25
      cells: map(range(0, 25), i => {
        key: $"{i}",
        value: keyCard[i]
      }
      )
      kind: "Int"
      name: "wordSpyKey"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    // The four masks derived from the key card, each the candidate filter one
    // `mean` reads. Derived from the key, so they carry the key's audience.
    row {
      capacity: 25
      cells []
      kind: "Bool"
      name: "wordSpyRedLive"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    row {
      capacity: 25
      cells []
      kind: "Bool"
      name: "wordSpyBlueLive"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    row {
      capacity: 25
      cells []
      kind: "Bool"
      name: "wordSpyRedAvoid"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    row {
      capacity: 25
      cells []
      kind: "Bool"
      name: "wordSpyBlueAvoid"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    // The spymaster's two poles: the mean of the team's live words and the mean
    // of everything it must steer away from. A mean over a hidden mask is a
    // reading of the mask, so the poles, the clue aimed from them, and the log
    // of clues all carry the key's audience.
    row {
      capacity: 2
      kind: "Vector"
      name: "wordSpyAim"
      space: "wordSpySpace"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    // The live clue, aimed at `own` and away from `avoid`.
    row {
      kind: "Vector"
      name: "wordSpyClue"
      space: "wordSpySpace"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    // Every clue this game has carried, newest evicting oldest.
    row {
      capacity: 4
      evicts: true
      kind: "Vector"
      name: "wordSpyClueLog"
      space: "wordSpySpace"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    // The clue word `nearest` chose, as a key of `wordSpyLexicon`, before the
    // spymaster says it.
    row {
      kind: "Text"
      name: "wordSpyClueChoice"
      value: ""
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    // The clue word the spymaster said: the one hidden value the game shows
    // every seat, copied out of `wordSpyClueChoice` by the number rules.
    slot wordSpyClueWord = ""

    // The spymaster's private shortlist: the three cells still on the table
    // closest to the clue, keyed by grid ordinal, valued by their dot product.
    row {
      capacity: 3
      cells []
      kind: "Int"
      name: "wordSpyHint"
      visibility {
        readers [
          "seat1"
          "seat3"
        ]
      }
    }

    // The one door a player acts through: name a seat and a cell, then bump the
    // request counter. `result` answers 1 accepted or -1 refused.
    table wordSpyAct capacity(16) {
      card = 0
      applied = 0
      isLive = 0
      ready = 0
      request = 0
      result = 0
      safeWord = 0
      seat = 0
      seatOk = 0
      word = 0
      wordOk = 0
    }

    table wordSpyTable capacity(24) {
      accepted = 0
      aimPending = 0
      clueNo = 0
      guessesLeft = 0
      livePending = 0
      mixPending = 0
      numberPending = 0
      pickPending = 0
      refused = 0
      revealCard = 0
      revealPending = 0
      revealWord = 0
      settlePending = 0
    }
  }
}
