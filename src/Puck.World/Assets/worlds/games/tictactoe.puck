  world {
    row {
      domain: cellsOf(topology: tttCube)
      kind: "Int"
      name: "tttBoard"
    }

    slot tttActive = 1 bounds(1..2)

    slot tttMoveCell = -1 bounds(-1..63)

    slot tttMoveRequest = 0 bounds(0..)

    slot tttMoveApplied = 0 bounds(0..)

    slot tttBoardVersion = 0 bounds(0..)

    slot tttWinCheckVersion = 0 bounds(0..)

    slot tttWinner = 0 bounds(0..3)

    slot tttMoveCount = 0 bounds(0..64)

    slot tttXWin = 0 bounds(0..1)

    slot tttOWin = 0 bounds(0..1)

    slot tttMaskX = 0 bounds(-9223372036854775808..9223372036854775807)

    slot tttMaskO = 0 bounds(-9223372036854775808..9223372036854775807)
  }
