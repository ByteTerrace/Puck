// Arena deathmatch — the free-for-all rule set id Software's Quake III Arena ships as its
// default game type: https://en.wikipedia.org/wiki/Quake_III_Arena and, for the genre's own
// rules, https://en.wikipedia.org/wiki/Deathmatch_(video_games)
//
// Every fighter is everyone else's target. A kill scores its killer one frag and its victim one
// death; a killed fighter leaves the match until its respawn deadline passes and fires nothing
// until then. Health regenerates on its own between hits, up to the fighter's ceiling, and
// health pickups scattered around the arena restore more of it at once — each pickup is consumed
// on contact and returns on its own respawn timer, the "item respawn" clock the genre is built
// on. A participant may enter a match already under way; the first fighter is in from the start,
// the second takes its seat and then enters the roster through its own submission. The first
// fighter to the frag limit wins.
//
// This is a module: a host supplies the seats, the attack channel the two fighters reach the
// match through, the population capacity, the pickup bodies' motion program and their look.
// tests/Puck.World.Tests/Fixtures/minimal-arena-host.world.json is the smallest one that
// completes it.
//
// Deliberate reductions, stated rather than left to be discovered: a shot always hits (there is
// no aim, no weapon inventory and no projectile — the arena is a state-and-rules document, and a
// fighter's body is a marker the pickup geometry is measured against, not a shooter); the two
// fighters are a fixed pair rather than an open lobby; armour, powerups and the self-damage rule
// are not modelled; and the frag limit ends the match rather than a time limit.

enum ArenaBody {
  Detached
  First
  Second
}

enum ArenaPickupBody {
  Detached
  Medkit
  Mega
}

// --- Firing, and the refusal a dead fighter earns ---------------------------------------------
// Both shot rules write the same contended momentum follower: seat 1 pulls it toward +1, seat 2
// toward -1. Two presses landing on the same tick both write it, document order decides which
// target the cell carries out of the tick, and the follower's own rebase carries the loser's
// velocity through — the cell's clock is where that contention is visible.

rule "arena-fire-1" {
  when channel(1, attack) >= 0.5 and arenaFighters[0].alive == 1 and arenaFighters[1].alive == 1 and arenaOver == 0
  mode: Edge
  arenaFighters[1].health += -60
  arenaShots += 1
  arenaMomentum[0] = 1
}

rule "arena-fire-2" {
  when channel(2, attack) >= 0.5 and arenaJoined == 1 and arenaFighters[1].alive == 1 and arenaFighters[0].alive == 1 and arenaOver == 0
  mode: Edge
  arenaFighters[0].health += -60
  arenaShots += 1
  arenaMomentum[0] = -1
}

// A dead fighter's attack is refused by the game's own rule: nothing fires until the respawn
// deadline has passed. arenaRefused counts the shots the arena took away.

rule "arena-refuse-1" {
  when channel(1, attack) >= 0.5 and arenaFighters[0].alive == 0
  mode: Edge
  arenaRefused += 1
}

rule "arena-refuse-2" {
  when channel(2, attack) >= 0.5 and arenaJoined == 1 and arenaFighters[1].alive == 0
  mode: Edge
  arenaRefused += 1
}

// --- Entering the match ----------------------------------------------------------------------
// Seat 1's fighter is in from boot. Seat 2's body does not exist until the seat joins (its own
// activation is OnDemand), so until then it carries no fighter tag, no pickup can find it, and
// nothing can shoot it. Entering the live match is its own submission — arenaEnter — rather than
// a gesture on the attack control, so that a newcomer's entrance is never also its opening shot.
//
// This rule sits AFTER the four rules above on purpose. A rule's writes land on the tick's own
// frame and every rule after it reads through that frame, so an arena-join placed first would
// hand arena-fire-2 a fighter that had joined and was alive in the same tick.

rule "arena-join" {
  when arenaEnter == 1 and arenaJoined == 0
  mode: Level
  arenaJoined = 1
  arenaRoster += 1
  claim arenaFighters as joined {
    joined.body = ArenaBody.Second
    joined.alive = 1
    joined.health = 100
  }
}

// --- Dying ------------------------------------------------------------------------------------
// A fighter whose health reaches its floor in the same tick it was shot leaves the match: its
// fighter tag drops, so no pickup can reach it while it waits, its killer scores a frag, and its
// respawn deadline is armed.

rule "arena-death-1" {
  when arenaFighters[0].alive == 1 and arenaFighters[0].health == 0
  mode: Level
  arenaFighters[0].alive = 0
  arenaFighters[0].body = ArenaBody.Detached
  arenaFighters[0].deaths += 1
  arenaFighters[1].frags += 1
  schedule arenaFighters[0].respawn in 1s
}

rule "arena-death-2" {
  when arenaFighters[1].alive == 1 and arenaFighters[1].health == 0
  mode: Level
  arenaFighters[1].alive = 0
  arenaFighters[1].body = ArenaBody.Detached
  arenaFighters[1].deaths += 1
  arenaFighters[0].frags += 1
  schedule arenaFighters[1].respawn in 1s
}

// --- The respawn deadlines -------------------------------------------------------------------
// Each fighter's respawn field holds the tick it may spawn again, so the wait is a real duration rather
// than a tick count, and the spawn rule re-enters the fighter at full health the tick $tick
// reaches it.

rule "arena-spawn-1" {
  when arenaFighters[0].alive == 0 and $tick >= arenaFighters[0].respawn and arenaOver == 0
  mode: Edge
  arenaFighters[0].alive = 1
  arenaFighters[0].health = 100
  arenaFighters[0].body = ArenaBody.First
  arenaSpawns += 1
}

rule "arena-spawn-2" {
  when arenaFighters[1].alive == 0 and $tick >= arenaFighters[1].respawn and arenaJoined == 1 and arenaOver == 0
  mode: Edge
  arenaFighters[1].alive = 1
  arenaFighters[1].health = 100
  arenaFighters[1].body = ArenaBody.Second
  arenaSpawns += 1
}

// --- Item respawn -----------------------------------------------------------------------------
// A consumed pickup drops its own tag, which is what takes it out of the distance interaction
// below; its deadline works the same way a fighter's respawn does and returns the tag.

rule "arena-item-return-medkit" {
  when arenaPickups[0].active == 0 and $tick >= arenaPickups[0].respawn
  mode: Edge
  arenaPickups[0].active = 1
  arenaPickups[0].body = ArenaPickupBody.Medkit
  arenaItemSpawns += 1
}

rule "arena-item-return-mega" {
  when arenaPickups[1].active == 0 and $tick >= arenaPickups[1].respawn
  mode: Edge
  arenaPickups[1].active = 1
  arenaPickups[1].body = ArenaPickupBody.Mega
  arenaItemSpawns += 1
}

// --- The frag limit ---------------------------------------------------------------------------

rule "arena-over" {
  when arenaOver == 0 and (arenaFighters[0].frags >= 2 or arenaFighters[1].frags >= 2)
  mode: Edge
  arenaOver = 1
  arenaWinner = arenaFighters[0].frags >= 2 ? 1 : 2
}

// --- The arena's own geometry -------------------------------------------------------------------
// Two health pickups, each an inhabited placement so it is a body the distance interaction can
// measure against. Both start out on the far galleries, well past the pickup radius: an item is
// reached by moving a fighter and an item into the same part of the arena, which is exactly what
// the interaction measures.

kits {
  rows [
    {
      bodyContact: Overlap
      bodyMotionProgram: "walk"
      collider: sphere(radius: 0.25)
      motion {
        facingSnap: false
        holds [
          {
            bond: Free
            hold: None
            name: "floating"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 0.001
        }
        turn {
          rate: 0.001
        }
      }
      name: "arenaItem"
    }
  ]
}

// Each logical pickup carries a named body role. The carrier table below resolves that role to its inhabited
// placement, so population slot allocation never leaks into gameplay state.

placements {
  placement "arenaMegaHealth" {
    prototype: "arenaItem"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "arenaItem"
      look: "arenaItem"
      source: "Idle"
    }
    position [40, 0, 0]
  }

  placement "arenaMedkit" {
    prototype: "arenaItem"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "arenaItem"
      look: "arenaItem"
      source: "Idle"
    }
    position [20, 0, 0]
  }
}

prototypes {
  prototype "arenaItem" {
    document {
      name: "arenaItem"
      palette [
        {
          color: "state.colors.axisX"
          roughness: 0.4
          specular: 0.5
        }
      ]
      schema: "puck.creation.v1"
      shape Box "core" {
        material: 0
        position [0, 0.25, 0]
        rotation: "state.transforms.identity"
        scale [0.25, 0.25, 0.25]
      }
    }
  }
}

// --- Picking an item up -------------------------------------------------------------------------
// The one door a fighter's body opens rather than its controls: every (fighter, item) pair inside
// the pickup radius fires once per crossing, the fighter bound as $left and the item as $right. A
// dead fighter and a consumed item both select their Detached body role, excluding them until
// their respawn rules restore the logical binding.

properties {
  names []
  carriers [
    { pool: arenaFighters, field: body, bindings [{ member: Detached }, { member: First, seat: 0 }, { member: Second, seat: 1 }] }
    { pool: arenaPickups, field: body, bindings [{ member: Detached }, { member: Medkit, placement: "arenaMedkit" }, { member: Mega, placement: "arenaMegaHealth" }] }
  ]
}

interactions {
  interactions [
    {
      coOccurrence: Distance
      effects [
        addState(state: left.health, value: 45)
        addState(state: left.taken, value: 1)
        setState(state: right.active, value: 0)
        setState(state: right.body, value: 0)
        scheduleState(state: right.respawn, delaySeconds: 2)
      ]
      left: arenaFighters
      mode: Edge
      name: "arena-item-taken"
      range: 8
      right: arenaPickups
    }
  ]
}

dynamics [
  {
    f: 2
    name: "arenaMomentum"
    r: 0
    zeta: 0.7
  }
]

state {
  // Stable fighter lifetimes keep combat state, timed health, and respawn continuation together.
  record ArenaFighter {
    body: ArenaBody = ArenaBody.Detached
    alive: Int bounds(0..1)
    frags: Int bounds(0..99)
    deaths: Int bounds(0..99)
    // Regeneration advances from the last explicit write and saturates at full health.
    health: Int bounds(0..100, overflow: Saturate) advance(perSecond: 6) = 100
    respawn: Int = 0
    taken: Int bounds(0..99) = 0
  }
  record ArenaPickup {
    body: ArenaPickupBody = ArenaPickupBody.Detached
    active: Int bounds(0..1) = 1
    respawn: Int = 0
  }
  pool arenaFighters of ArenaFighter capacity(2) = [{ body: ArenaBody.First, alive: 1 }]
  pool arenaPickups of ArenaPickup capacity(2) = [{ body: ArenaPickupBody.Medkit }, { body: ArenaPickupBody.Mega }]
  world {
    // The contended follower: an eased reading of which fighter last took a shot.
    row {
      cells [
        {
          dynamics {
            row: "arenaMomentum"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      min: "-1"
      max: "1"
      name: "arenaMomentum"
    }

    slot arenaEnter = 0 bounds(0..1)

    slot arenaJoined = 0 bounds(0..1)

    slot arenaRoster = 1 bounds(0..2)

    slot arenaShots = 0 bounds(0..999)

    slot arenaRefused = 0 bounds(0..999)

    slot arenaSpawns = 0 bounds(0..999)

    slot arenaItemSpawns = 0 bounds(0..999)

    slot arenaOver = 0 bounds(0..1)

    slot arenaWinner = 0 bounds(0..2)
  }
}

export action arenaEnter
export binding arenaFighters, arenaOver
export read arenaFighters, arenaEnter, arenaItemSpawns, arenaJoined, arenaMomentum, arenaOver, arenaPickups, arenaRefused, arenaRoster, arenaShots, arenaSpawns, arenaWinner
