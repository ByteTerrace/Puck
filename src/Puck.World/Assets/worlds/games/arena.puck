// Arena deathmatch — the free-for-all rule set id Software's Quake III Arena ships as its
// default game type: https://en.wikipedia.org/wiki/Quake_III_Arena and, for the genre's own
// rules, https://en.wikipedia.org/wiki/Deathmatch_(video_games)
//
// Every fighter is everyone else's target. A kill scores its killer one frag and its victim one
// death; a killed fighter leaves the match for a respawn countdown and fires nothing until the
// countdown drains. Health regenerates on its own between hits, up to the fighter's ceiling, and
// health pickups scattered around the arena restore more of it at once — each pickup is consumed
// on contact and returns on its own respawn timer, the "item respawn" clock the genre is built
// on. A participant may enter a match already under way; the first fighter is in from the start,
// the second takes its seat and then enters the roster through its own submission. The first
// fighter to the frag limit wins.
//
// This is a module: a host supplies the seats, the attack channel the two fighters reach the
// match through, the population capacity, the pickup bodies' motion program and their look.
// tests/Puck.World.Tests/Fixtures/minimal-arena-host.world.json is the smallest one that
// completes it.
//
// Deliberate reductions, stated rather than left to be discovered: a shot always hits (there is
// no aim, no weapon inventory and no projectile — the arena is a state-and-rules document, and a
// fighter's body is a marker the pickup geometry is measured against, not a shooter); the two
// fighters are a fixed pair rather than an open lobby; armour, powerups and the self-damage rule
// are not modelled; and the frag limit ends the match rather than a time limit.

// --- Firing, and the refusal a dead fighter earns ---------------------------------------------
// Both shot rules write the same contended momentum follower: seat 1 pulls it toward +1, seat 2
// toward -1. Two presses landing on the same tick both write it, document order decides which
// target the cell carries out of the tick, and the follower's own rebase carries the loser's
// velocity through — the cell's clock is where that contention is visible.

rule "arena-fire-1" {
  when $channel:1:attack >= 0.5 and arenaAlive[0] == 1 and arenaAlive[1] == 1 and arenaOver == 0
  mode: "Edge"
  arenaHealth[1] += -60
  arenaShots += 1
  arenaMomentum[0] = 1
}

rule "arena-fire-2" {
  when $channel:2:attack >= 0.5 and arenaJoined == 1 and arenaAlive[1] == 1 and arenaAlive[0] == 1 and arenaOver == 0
  mode: "Edge"
  arenaHealth[0] += -60
  arenaShots += 1
  arenaMomentum[0] = -1
}

// A dead fighter's attack is refused by the game's own rule: nothing fires until the respawn
// countdown has drained. arenaRefused counts the shots the arena took away.

rule "arena-refuse-1" {
  when $channel:1:attack >= 0.5 and arenaAlive[0] == 0
  mode: "Edge"
  arenaRefused += 1
}

rule "arena-refuse-2" {
  when $channel:2:attack >= 0.5 and arenaJoined == 1 and arenaAlive[1] == 0
  mode: "Edge"
  arenaRefused += 1
}

// --- Entering the match ----------------------------------------------------------------------
// Seat 1's fighter is in from boot. Seat 2's body does not exist until the seat joins (its own
// activation is OnDemand), so until then it carries no fighter tag, no pickup can find it, and
// nothing can shoot it. Entering the live match is its own submission — arenaEnter — rather than
// a gesture on the attack control, so that a newcomer's entrance is never also its opening shot.
//
// This rule sits AFTER the four rules above on purpose. A rule's writes land on the tick's own
// frame and every rule after it reads through that frame, so an arena-join placed first would
// hand arena-fire-2 a fighter that had joined and was alive in the same tick.

rule "arena-join" {
  when arenaEnter == 1 and arenaJoined == 0
  mode: "Level"
  arenaJoined = 1
  arenaRoster += 1
  arenaFighter[1] = 1
  arenaAlive[1] = 1
  arenaHealth[1] = 100
}

// --- Dying ------------------------------------------------------------------------------------
// A fighter whose health reaches its floor in the same tick it was shot leaves the match: its
// fighter tag drops, so no pickup can reach it while it waits, its killer scores a frag, and its
// respawn countdown is armed.

rule "arena-death-1" {
  when arenaAlive[0] == 1 and arenaHealth[0] == 0
  mode: "Level"
  arenaAlive[0] = 0
  arenaFighter[0] = 0
  arenaDeaths[0] += 1
  arenaFrags[1] += 1
  arenaRespawn[0] = 1s
}

rule "arena-death-2" {
  when arenaAlive[1] == 1 and arenaHealth[1] == 0
  mode: "Level"
  arenaAlive[1] = 0
  arenaFighter[1] = 0
  arenaDeaths[1] += 1
  arenaFrags[0] += 1
  arenaRespawn[1] = 1s
}

// --- The respawn countdowns -------------------------------------------------------------------
// countdown drains the armed row by the step's own engine-tick width, so the wait is a real
// duration rather than a tick count, and the spawn rule re-enters the fighter at full health the
// step the countdown reads zero.

rule "arena-respawn-count-1" {
  when arenaAlive[0] == 0 and arenaRespawn[0] > 0
  mode: "Level"
  countdown arenaRespawn[0]
}

rule "arena-respawn-count-2" {
  when arenaAlive[1] == 0 and arenaRespawn[1] > 0
  mode: "Level"
  countdown arenaRespawn[1]
}

rule "arena-spawn-1" {
  when arenaAlive[0] == 0 and arenaRespawn[0] == 0 and arenaOver == 0
  mode: "Edge"
  arenaAlive[0] = 1
  arenaHealth[0] = 100
  arenaFighter[0] = 1
  arenaSpawns += 1
}

rule "arena-spawn-2" {
  when arenaAlive[1] == 0 and arenaRespawn[1] == 0 and arenaJoined == 1 and arenaOver == 0
  mode: "Edge"
  arenaAlive[1] = 1
  arenaHealth[1] = 100
  arenaFighter[1] = 1
  arenaSpawns += 1
}

// --- Item respawn -----------------------------------------------------------------------------
// A consumed pickup drops its own tag, which is what takes it out of the distance interaction
// below; its cooldown drains the same way a fighter's respawn does and returns the tag.

rule "arena-item-count-medkit" {
  when arenaPickup[2] == 0 and arenaPickupClock[2] > 0
  mode: "Level"
  countdown arenaPickupClock[2]
}

rule "arena-item-count-mega" {
  when arenaPickup[3] == 0 and arenaPickupClock[3] > 0
  mode: "Level"
  countdown arenaPickupClock[3]
}

rule "arena-item-return-medkit" {
  when arenaPickup[2] == 0 and arenaPickupClock[2] == 0
  mode: "Edge"
  arenaPickup[2] = 1
  arenaItemSpawns += 1
}

rule "arena-item-return-mega" {
  when arenaPickup[3] == 0 and arenaPickupClock[3] == 0
  mode: "Edge"
  arenaPickup[3] = 1
  arenaItemSpawns += 1
}

// --- The frag limit ---------------------------------------------------------------------------

rule "arena-over" {
  when arenaOver == 0 and (arenaFrags[0] >= 2 or arenaFrags[1] >= 2)
  mode: "Edge"
  arenaOver = 1
  arenaWinner = arenaFrags[0] >= 2 ? 1 : 2
}

// --- The arena's own geometry -------------------------------------------------------------------
// Two health pickups, each an inhabited placement so it is a body the distance interaction can
// measure against. Both start out on the far galleries, well past the pickup radius: an item is
// reached by moving a fighter and an item into the same part of the arena, which is exactly what
// the interaction measures.

kits {
  rows [
    {
      bodyContact: "Overlap"
      bodyMotionProgram: "walk"
      collider: sphere(radius: 0.25)
      motion {
        facingSnap: false
        holds [
          {
            bond: "Free"
            hold: "None"
            name: "floating"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 0.001
        }
        turn {
          rate: 0.001
        }
      }
      name: "arenaItem"
    }
  ]
}

// An inhabited placement claims the HIGHEST free entity slot in document order
// (WorldPopulation.ReconcileOneInhabitedCount), and a property tag is keyed by body index, so the order these two
// are declared in is what makes the item tags below read in ascending order against a host declaring two seats and
// exactly two peer slots: the mega health takes 3 and the medkit takes 2.

placements {
  placement "arenaMegaHealth" {
    prototype: "arenaItem"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "arenaItem"
      look: "arenaItem"
      source: "Idle"
    }
    position [40, 0, 0]
  }

  placement "arenaMedkit" {
    prototype: "arenaItem"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "arenaItem"
      look: "arenaItem"
      source: "Idle"
    }
    position [20, 0, 0]
  }
}

prototypes {
  prototype "arenaItem" {
    document {
      name: "arenaItem"
      palette [
        {
          color: "state.colors.axisX"
          roughness: 0.4
          specular: 0.5
        }
      ]
      schema: "puck.creation.v1"
      shape Box "core" {
        material: 0
        position [0, 0.25, 0]
        rotation: "state.transforms.identity"
        scale [0.25, 0.25, 0.25]
      }
    }
  }
}

// --- Picking an item up -------------------------------------------------------------------------
// The one door a fighter's body opens rather than its controls: every (fighter, item) pair inside
// the pickup radius fires once per crossing, the fighter bound as $left and the item as $right. A
// fighter that is dead carries no tag and a consumed item carries none either, so the same table
// that grants the heal is what enforces both.

properties {
  names [
    "arenaFighter",
    "arenaPickup"
  ]
}

interactions {
  interactions [
    {
      coOccurrence: "Distance"
      effects [
        addState(state: "arenaHealth", key: "$left", value: 45)
        addState(state: "arenaTaken", key: "$left", value: 1)
        setState(state: "arenaPickup", key: "$right", value: 0)
        setState(state: "arenaPickupClock", key: "$right", valueSeconds: 2)
      ]
      left: "arenaFighter"
      mode: "Edge"
      name: "arena-item-taken"
      range: 8
      right: "arenaPickup"
    }
  ]
}

dynamics [
  {
    f: 2
    name: "arenaMomentum"
    r: 0
    zeta: 0.7
  }
]

state {
  world {
    // The two carrier tables the interaction above reads, keyed by body index: the seats take 0 and 1, the medkit
    // takes 2 and the mega health takes 3 (see the placements block for why that is the order they are declared in).
    table arenaFighter: Int capacity(4) bounds(minimum: 0, maximum: 1) {
      "0" = 1
      "1" = 0
    }

    table arenaPickup: Int capacity(4) bounds(minimum: 0, maximum: 1) {
      "2" = 1
      "3" = 1
    }

    table arenaPickupClock: Int capacity(4) bounds(minimum: 0, maximum: 504000) {
      "2" = 0
      "3" = 0
    }

    // Health regenerates on its own between hits: the advance trait accumulates from the last
    // explicit write's base, and the row's own ceiling clamps every read, so a fighter at full
    // health simply stays there.
    table arenaHealth: Int capacity(2) bounds(minimum: 0, maximum: 100, overflow: Saturate) advance(perSecond: 6) {
      "0" = 100
      "1" = 100
    }

    table arenaAlive: Int capacity(2) bounds(minimum: 0, maximum: 1) {
      "0" = 1
      "1" = 0
    }

    table arenaRespawn: Int capacity(2) bounds(minimum: 0, maximum: 504000) {
      "0" = 0
      "1" = 0
    }

    // The score record each fighter carries out of the match.
    table arenaFrags: Int capacity(2) bounds(minimum: 0, maximum: 99) {
      "0" = 0
      "1" = 0
    }

    table arenaDeaths: Int capacity(2) bounds(minimum: 0, maximum: 99) {
      "0" = 0
      "1" = 0
    }

    table arenaTaken: Int capacity(2) bounds(minimum: 0, maximum: 99) {
      "0" = 0
      "1" = 0
    }

    // The contended follower: an eased reading of which fighter last took a shot.
    row {
      cells [
        {
          dynamics {
            row: "arenaMomentum"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      min: "-1"
      max: "1"
      name: "arenaMomentum"
    }

    slot arenaEnter: Int = 0 bounds(minimum: 0, maximum: 1)

    slot arenaJoined: Int = 0 bounds(minimum: 0, maximum: 1)

    slot arenaRoster: Int = 1 bounds(minimum: 0, maximum: 2)

    slot arenaShots: Int = 0 bounds(minimum: 0, maximum: 999)

    slot arenaRefused: Int = 0 bounds(minimum: 0, maximum: 999)

    slot arenaSpawns: Int = 0 bounds(minimum: 0, maximum: 999)

    slot arenaItemSpawns: Int = 0 bounds(minimum: 0, maximum: 999)

    slot arenaOver: Int = 0 bounds(minimum: 0, maximum: 1)

    slot arenaWinner: Int = 0 bounds(minimum: 0, maximum: 2)
  }
}

export action arenaEnter
export binding arenaHealth, arenaFrags, arenaOver
export read arenaAlive, arenaDeaths, arenaEnter, arenaFighter, arenaFrags, arenaHealth, arenaItemSpawns, arenaJoined, arenaMomentum, arenaOver, arenaPickup, arenaPickupClock, arenaRefused, arenaRespawn, arenaRoster, arenaShots, arenaSpawns, arenaTaken, arenaWinner
