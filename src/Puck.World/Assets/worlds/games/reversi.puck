  mode: Level
  transform setRay(row: reversiBoard, from: 61, direction: N, pattern: reversiBlackBracket, value: 2)
  transform setRay(row: reversiBoard, from: 61, direction: NE, pattern: reversiBlackBracket, value: 2)
