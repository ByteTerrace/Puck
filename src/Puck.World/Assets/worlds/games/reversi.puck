  transform setRay(row: reversiBoard, from: 61, direction: SW, pattern: reversiWhiteBracket, value: 1)
  transform setRay(row: reversiBoard, from: 61, direction: W, pattern: reversiWhiteBracket, value: 1)
  transform setRay(row: reversiBoard, from: 61, direction: NW, pattern: reversiWhiteBracket, value: 1)
}

