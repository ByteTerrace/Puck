// A pending request the door did not admit is answered, not applied: the board stays where it was and the
// refusal is counted. This is the rules refusing an illegal move, not the engine refusing a write.
rule "reversi-reject" {
  when reversiWinner == 0 and reversiFlipping == 0 and reversiMoveRequest != reversiMoveApplied
  mode: Edge
  reversiRejected += 1
  reversiMoveApplied = reversiMoveRequest
}

rule "reversi-finish" {
  when reversiFlipping == 1
  mode: Level
  reversiFlips = (reversiTurn == 1 ? setBitCount(board(mask, reversiBoard, 1, 1)) : setBitCount(board(mask, reversiBoard, 2, 2))) - reversiPrevOwn - 1
  reversiMoveCount += 1
  reversiMoveApplied = reversiMoveRequest
  reversiPasses = 0
  reversiTurn = 3 - reversiTurn
  reversiFlipping = 0
}

rule "reversi-score" {
  mode: Level
  reversiBlack = setBitCount(board(mask, reversiBoard, 1, 1))
  reversiWhite = setBitCount(board(mask, reversiBoard, 2, 2))
  reversiWinner = ((reversiBlack + reversiWhite) >= 64) | (reversiPasses >= 2) ? (reversiBlack > reversiWhite ? 1 : (reversiWhite > reversiBlack ? 2 : 3)) : 0
}
// There is no 'search' job here, and the games README records why: this document's own flip rules price a
// judge run past what the work sheet leaves, so a job over them cannot be planned. The CPU opponent G2
// asks for waits on that.
