      name: "solitaireFreecellRank"
      kind: "Int"
      domain: keysOf(row: "solitaireFreecellCards")
      capacity: 52
      cells: map(range(0, 52), i => { key: $"{i}", value: i % 13 + 1 })
    }

    row {
      name: "solitaireFreecellSuit"
      kind: "Int"
      domain: keysOf(row: "solitaireFreecellCards")
      capacity: 52
      cells: map(range(0, 52), i => { key: $"{i}", value: floor(i / 13) })
    }

    row {
      name: "solitaireFreecellFace"
      kind: "Int"
      domain: keysOf(row: "solitaireFreecellCards")
      capacity: 52
      cells: map(range(0, 52), i => { key: $"{i}", value: 0 })
    }
    pile solitaireFreecellPile0 of solitaireFreecellCards capacity(52) {
      "0"
      "1"
      "2"
