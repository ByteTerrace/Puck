// Pong — Atari's 1972 coin-op, played by the arcade cabinet's own rules
// (https://en.wikipedia.org/wiki/Pong): two paddles face each other across a court, the ball is
// served from the side that was last scored upon, a paddle that meets the ball returns it, a ball
// that passes a paddle and reaches the goal behind it scores one point for the other side, and the
// first side to eleven points wins the game.
//
// This is a module: a host supplies the seat, the 'attack' channel the serve press arrives on, the
// 'walk' motion program the kits name, the three looks, and the population the five bodies need.
// tests/Puck.World.Tests/Fixtures/minimal-pong-host.world.json is the smallest one that completes it.
//
// What makes this Pong rather than a board game is that the court is physical. The ball is a rigid
// body on a solid floor, served by a real impulse down the court, and the three things the rules
// care about — the ball meeting a paddle, the ball loitering in a paddle's reach, and the ball
// reaching a goal — are read off body geometry by the 'interactions' table rather than by a rule
// spelling a coordinate. The three latch shapes that table carries are all three here: a
// Distance x Edge strike, a Distance x Level pressure meter, and a Region x Edge goal.
//
// The serve's direction comes from a pair of fixed posts standing in the court's far corners, never
// from the serving paddle itself: 'applyRigidImpulse' aims along a body's own facing, and a paddle
// that has been moved has had its facing reset to zero by the move, so a paddle can carry a lane
// but not a heading. The posts are never moved and their authored facings are the court's two ends.
//
// Deliberate reductions, stated rather than left to be discovered: the paddles are moved by placing
// their bodies rather than by a per-seat drive program, so a second seat is not needed to play the
// far side; the ball's return is the strike latch's own bookkeeping rather than a reflected
// velocity, since an impulse effect can add momentum but cannot replace it; a rolled ball on a real
// floor stops where the cabinet's never does, so a rally that goes quiet is called a let and served
// again rather than awarded to somebody; an unopposed serve always reaches the far goal, so with
// the conceding side serving the model's scores alternate and a finished game reads 11-10; and the
// cabinet's speed-up-per-rally and shrinking paddle are not modelled.

let ballColor = "#F5F1E6"
let paddleColor = "#7FD4FF"
let goalColor = "#FF9E7F"
let courtColor = "#1E2A33"

enum PongBallBody {
  Detached
  Ball
}

enum PongPaddleBody {
  Detached
  East
  West
}

// --- The kits: what the court is played with ------------------------------------------------
// The ball carries a 'rigid' facet, so it is integrated by the rigid solver and takes the serve's
// impulse through the same WorldBody.TryApplyRigidImpulse door 'body.impulse' uses. The paddles
// carry none: they are ordinary solid bodies that stand where they are put.

kits {
  rows [
    {
      bodyContact: Solid
      bodyMotionProgram: "walk"
      collider: sphere(radius: 0.18)
      motion {
        facingSnap: true
        holds [
          {
            bond: Free
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 0.001
        }
        turn {
          rate: 0.001
        }
      }
      name: "pongBall"
      rigid {
        angularDamping: 0.2
        friction: 0.1
        linearDamping: 0.1
        mass: 0.25
        restitution: 0.6
        rollingFriction: 0.01
      }
    }
    {
      bodyContact: Solid
      bodyMotionProgram: "walk"
      collider: box(halfExtents: [0.125, 0.25, 0.5], rotation: [0, 0, 0, 1])
      motion {
        facingSnap: false
        holds [
          {
            bond: Surface
            cone [0, 60]
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "ground"
            reach: 1.2
          }
          {
            bond: Free
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 4
        }
        turn {
          rate: 2.5
        }
      }
      name: "pongPaddle"
    }
  ]
}

// --- The court ------------------------------------------------------------------------------
// The court sits twelve units east of the world origin, clear of the spawn the host's own seat body
// takes, so nothing but the game's own bodies ever stands on it. Its floor's top face is the
// court's local y = 0. The two long sides carry walls and the two ends are open; a goal region sits
// in each opening, four units out, with a paddle two units out in front of it and a backstop behind
// it so a scored ball stays on the court. The ball's root starts on the floor; its sphere center
// is one radius above that root, and contact is established before the first serve.

placements {
  placement "pongCourt" {
    prototype: "pongCourt"
    position [12, 0, 0]
    solid
  }

  placement "pongGoalWest" {
    prototype: "pongGoalMarker"
    parent: "pongCourt"
    position [-4, 0.25, 0]
    region {
      radius: 0.5
    }
  }

  placement "pongGoalEast" {
    prototype: "pongGoalMarker"
    parent: "pongCourt"
    position [4, 0.25, 0]
    region {
      radius: 0.5
    }
  }

  placement "pongBall" {
    prototype: "pongBall"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "pongBall"
      look: "pongBall"
      source: "Idle"
    }
    parent: "pongCourt"
    position [0, 0, 0]
  }

  placement "pongPaddleWest" {
    prototype: "pongPaddle"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "pongPaddle"
      look: "pongPaddle"
      source: "Idle"
    }
    parent: "pongCourt"
    position [-2, 0, 0]
    yawDegrees: 270
  }

  placement "pongPaddleEast" {
    prototype: "pongPaddle"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "pongPaddle"
      look: "pongPaddle"
      source: "Idle"
    }
    parent: "pongCourt"
    position [2, 0, 0]
    yawDegrees: 90
  }

  placement "pongPostWest" {
    prototype: "pongPost"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "pongPaddle"
      look: "pongPost"
      source: "Idle"
    }
    parent: "pongCourt"
    position [-4.4, 0, 2.2]
    yawDegrees: 270
  }

  placement "pongPostEast" {
    prototype: "pongPost"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "pongPaddle"
      look: "pongPost"
      source: "Idle"
    }
    parent: "pongCourt"
    position [4.4, 0, 2.2]
    yawDegrees: 90
  }
}

prototypes {
  prototype "pongBall" {
    document {
      name: "pongBall"
      palette [
        {
          color: ballColor
          roughness: 0.4
          specular: 0.5
        }
      ]
      schema: "puck.creation.v1"
      shape Sphere "sphere" {
        material: 0
        position [0, 0.18, 0]
        scale [0.18, 0.18, 0.18]
      }
    }
  }

  prototype "pongPaddle" {
    document {
      name: "pongPaddle"
      palette [
        {
          color: paddleColor
          roughness: 0.6
          specular: 0.2
        }
      ]
      schema: "puck.creation.v1"
      shape Box "blade" {
        material: 0
        position [0, 0.25, 0]
        scale [0.125, 0.25, 0.5]
      }
    }
  }

  prototype "pongPost" {
    document {
      name: "pongPost"
      palette [
        {
          color: goalColor
          roughness: 0.8
          specular: 0.1
        }
      ]
      schema: "puck.creation.v1"
      shape Box "pillar" {
        material: 0
        position [0, 0.25, 0]
        scale [0.1, 0.25, 0.1]
      }
    }
  }

  prototype "pongGoalMarker" {
    document {
      name: "pongGoalMarker"
      palette [
        {
          color: goalColor
          roughness: 0.9
          specular: 0.05
        }
      ]
      schema: "puck.creation.v1"
      shape Box "line" {
        material: 0
        position [0, 0, 0]
        scale [0.04, 0.02, 2.4]
      }
    }
  }

  prototype "pongCourt" {
    document {
      name: "pongCourt"
      palette [
        {
          color: courtColor
          roughness: 0.9
          specular: 0.05
        }
      ]
      schema: "puck.creation.v1"
      shape Box "floor" {
        material: 0
        position [0, -0.05, 0]
        scale [4.5, 0.05, 2.4]
      }

      shape Box "wallNorth" {
        material: 0
        position [0, 0.15, 2.5]
        scale [4.5, 0.15, 0.1]
      }

      shape Box "wallSouth" {
        material: 0
        position [0, 0.15, -2.5]
        scale [4.5, 0.15, 0.1]
      }

      shape Box "backstopWest" {
        material: 0
        position [-4.6, 0.15, 0]
        scale [0.1, 0.15, 2.4]
      }

      shape Box "backstopEast" {
        material: 0
        position [4.6, 0.15, 0]
        scale [0.1, 0.15, 2.4]
      }
    }
  }
}

// --- What the interaction table watches -----------------------------------------------------
// The ball and paddles are logical pool instances carried by named inhabited placements. Runtime
// body indices may change without changing their state identity; the posts carry no role, so
// no interaction binds one. Paddle slots retain the game's established state-key ordering: the east
// paddle is slot 0 and the west paddle is slot 1.

properties {
  names []
  carriers [
    { pool: pongBalls, field: body, bindings [{ member: Detached }, { member: Ball, placement: "pongBall" }] }
    { pool: pongPaddles, field: body, bindings [{ member: Detached }, { member: East, placement: "pongPaddleEast" }, { member: West, placement: "pongPaddleWest" }] }
  ]
}

interactions {
  interactions [
    // The return. Edge: one firing per approach, however many ticks the attached ball spends
    // touching an attached paddle, which is exactly what "the paddle met the ball once" means.
    {
      coOccurrence: Distance
      effects [
        addState(state: pongRally, value: 1)
        addState(state: right.hits, value: 1)
        setState(fromState: pongRally, state: right.rally)
        setState(state: pongSpin, value: 0.75)
      ]
      left: pongBalls
      mode: Edge
      name: "pong-paddle-strike"
      range: 1
      right: pongPaddles
    }
    // The pressure meter. Level: it fires again every tick the ball is still inside a paddle's
    // reach, so the cell counts ticks-under-threat rather than approaches.
    {
      coOccurrence: Distance
      effects [
        addState(state: pongPressure, value: 1)
      ]
      left: pongBalls
      mode: Level
      name: "pong-paddle-pressure"
      range: 1.8
      right: pongPaddles
    }
    // The two goals. A goal is an event, not a point: the rules below decide whether the ball was
    // in play when it arrived, because an interaction row carries no gate of its own.
    {
      coOccurrence: Region
      effects [
        addState(state: pongWestGoalSerial, value: 1)
      ]
      left: pongBalls
      mode: Edge
      name: "pong-goal-west"
      range: 0
      right: pongGoalWest
    }
    {
      coOccurrence: Region
      effects [
        addState(state: pongEastGoalSerial, value: 1)
      ]
      left: pongBalls
      mode: Edge
      name: "pong-goal-east"
      range: 0
      right: pongGoalEast
    }
  ]
}

// --- The serve door ---------------------------------------------------------------------------
// A press on the seat's own 'attack' control and an ordered console submission reach the same
// request pair (pongServeSerial, pongServeApplied); the three rules below judge it.

rule "pong-serve-press" {
  when channel(1, attack) >= 1
  mode: Edge
  pongServeSerial += 1
}

// The refusal the cabinet itself enforces: there is only ever one ball, so a serve asked for while
// the ball is live, while the between-points deadline has not yet passed, or after the game has
// been won, is turned away and counted.
rule "pong-serve-refuse" {
  when pongServeSerial != pongServeApplied and (pongInPlay == 1 or $tick < pongServeTimer or pongWinner != 0)
  mode: Level
  pongServeApplied = pongServeSerial
  pongRefused += 1
}

rule "pong-serve-west" {
  when pongServeSerial != pongServeApplied and pongInPlay == 0 and $tick >= pongServeTimer and pongWinner == 0 and pongServeSide == 0
  mode: Level
  pongServeApplied = pongServeSerial
  pongInPlay = 1
  pongRally = 0
  pongRallyClock = 0
  pongSpin = 0
  pongServes += 1
  applyRigidImpulse(headingKey: `placement:pongPostWest`, key: `placement:pongBall`, magnitudeState: pongServeSpeed)
}

rule "pong-serve-east" {
  when pongServeSerial != pongServeApplied and pongInPlay == 0 and $tick >= pongServeTimer and pongWinner == 0 and pongServeSide == 1
  mode: Level
  pongServeApplied = pongServeSerial
  pongInPlay = 1
  pongRally = 0
  pongRallyClock = 0
  pongSpin = 0
  pongServes += 1
  applyRigidImpulse(headingKey: `placement:pongPostEast`, key: `placement:pongBall`, magnitudeState: pongServeSpeed)
}

// --- Points, dead balls, and the deadline between them -----------------------------------------
// The goal behind the west paddle is east's point, and the side that conceded serves next.

rule "pong-point-east" {
  when pongWestGoalSerial != pongWestGoalApplied and pongInPlay == 1
  mode: Level
  pongWestGoalApplied = pongWestGoalSerial
  pongPaddles[1].score += 1
  pongInPlay = 0
  pongServeSide = 0
  schedule pongServeTimer in 1s
  pongSpin = 0
}

rule "pong-point-west" {
  when pongEastGoalSerial != pongEastGoalApplied and pongInPlay == 1
  mode: Level
  pongEastGoalApplied = pongEastGoalSerial
  pongPaddles[0].score += 1
  pongInPlay = 0
  pongServeSide = 1
  schedule pongServeTimer in 1s
  pongSpin = 0
}

// A ball that reaches a goal while no ball is in play scores nothing — the other half of the
// serve refusal, counted separately so the export says which kind of illegal arrival happened.
rule "pong-dead-ball-west" {
  when pongWestGoalSerial != pongWestGoalApplied and pongInPlay == 0
  mode: Level
  pongWestGoalApplied = pongWestGoalSerial
  pongDeadBalls += 1
}

rule "pong-dead-ball-east" {
  when pongEastGoalSerial != pongEastGoalApplied and pongInPlay == 0
  mode: Level
  pongEastGoalApplied = pongEastGoalSerial
  pongDeadBalls += 1
}

// A let. The cabinet's ball never stops, but a rolled ball on a real floor does: a rally whose ball
// has been alive five seconds and has come to rest short of either goal is no point at all, and the
// same side serves again. '$physics:quiescent' is the world's own rigid-body rest fact, and the ball
// is the only rigid body on the court, so it reads exactly "the ball has stopped".
rule "pong-let" {
  when pongInPlay == 1 and pongRallyClock >= 5 and physics(quiescent) == 1
  mode: Edge
  pongInPlay = 0
  pongLets += 1
  schedule pongServeTimer in 0.5s
  pongSpin = 0
}

// --- The scoreboard ---------------------------------------------------------------------------

rule "pong-longest-rally" {
  when pongRally > pongLongestRally
  mode: Level
  pongLongestRally = pongRally
}

rule "pong-game-west" {
  when pongWinner == 0 and pongPaddles[0].score >= 11
  mode: Edge
  pongWinner = 1
  pongInPlay = 0
}

rule "pong-game-east" {
  when pongWinner == 0 and pongPaddles[1].score >= 11
  mode: Edge
  pongWinner = 2
  pongInPlay = 0
}

// The spin a strike puts on the ball is the stored truth; the eased read the dynamics row computes
// is what a presentation layer would draw. Between points it is released back to nothing, and the
// follower glides there rather than snapping.
rule "pong-spin-release" {
  when pongInPlay == 0 and pongSpin != 0
  mode: Level
  pongSpin = 0
}

dynamics [
  {
    f: 2
    name: "pongSpinEase"
    r: 0.375
    zeta: 0.875
  }
]

state {
  record PongBall {
    body: PongBallBody = PongBallBody.Detached
    active: Bool = true
  }
  record PongPaddle {
    body: PongPaddleBody = PongPaddleBody.Detached
    hits: Int bounds(0..9999) = 0
    rally: Int bounds(0..999) = 0
    score: Int bounds(0..99) = 0
  }
  pool pongBalls of PongBall capacity(1) = [{ body: PongBallBody.Ball, active: true }]
  pool pongPaddles of PongPaddle capacity(2) = [
    { body: PongPaddleBody.East, hits: 0, rally: 0, "score": 0 }
    { body: PongPaddleBody.West, hits: 0, rally: 0, "score": 0 }
  ]

  world {
    // The rally clock accumulates one a second from the serve that started the rally; every serve
    // and every point rebases it.
    slot pongRallyClock = 0 bounds(0..3600) advance(perSecond: 1)

    // The impulse magnitude the serve rides, in the kind=Fixed row applyRigidImpulse requires.
    slot pongServeSpeed = 2.0

    // The spin a strike imparts. Presentation reads ease toward the stored target; rules and simulation
    // read stored truth. A write sets stored truth and kicks the follower from its current position toward
    // the new target.
    row {
      dynamics {
        row: "pongSpinEase"
      }
      kind: "Fixed"
      name: "pongSpin"
      value: "0"
    }

    slot pongInPlay = 0 bounds(0..1)

    slot pongServeSide = 0 bounds(0..1)

    slot pongServeTimer = 0

    slot pongServeSerial = 0 bounds(0..9999)

    slot pongServeApplied = 0 bounds(0..9999)

    slot pongServes = 0 bounds(0..9999)

    slot pongRefused = 0 bounds(0..9999)

    slot pongDeadBalls = 0 bounds(0..9999)

    slot pongLets = 0 bounds(0..9999)

    slot pongRally = 0 bounds(0..999)

    slot pongLongestRally = 0 bounds(0..999)

    slot pongPressure = 0 bounds(0..999999)

    slot pongWinner = 0 bounds(0..2)

    slot pongWestGoalSerial = 0 bounds(0..9999)

    slot pongWestGoalApplied = 0 bounds(0..9999)

    slot pongEastGoalSerial = 0 bounds(0..9999)

    slot pongEastGoalApplied = 0 bounds(0..9999)
  }
}

export action pongServeSerial
export binding pongInPlay, pongRally, pongWinner
export read pongDeadBalls, pongInPlay, pongLets, pongLongestRally, pongPaddles, pongPressure, pongRally, pongRallyClock, pongRefused, pongServeSide, pongServeTimer, pongServes, pongSpin, pongWinner
