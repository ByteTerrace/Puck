    }

    row {
      name: "solitaireKlondikeRank"
      kind: "Int"
      domain: keysOf(row: solitaireKlondikeCards)
      capacity: 52
      cells: map(range(0, 52), i => { key: $"{i}", value: i % 13 + 1 })
    }

    row {
      name: "solitaireKlondikeSuit"
      kind: "Int"
      domain: keysOf(row: solitaireKlondikeCards)
      capacity: 52
      cells: map(range(0, 52), i => { key: $"{i}", value: floor(i / 13) })
    }

    row {
      name: "solitaireKlondikeFace"
      kind: "Int"
      domain: keysOf(row: solitaireKlondikeCards)
      capacity: 52
      cells: map(range(0, 52), i => { key: $"{i}", value: 0 })
    }
    pile solitaireKlondikePile0 of solitaireKlondikeCards capacity(52) {
      "0"
      "1"
      "2"
      "3"
      "4"
      "5"
