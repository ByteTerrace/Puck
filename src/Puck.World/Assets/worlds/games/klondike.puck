      gatherStep = 0
      scan = 0
      changed = 0
      attributeStep = 0
      drawLeft = 0
    }

    row {
      name: "solitaireKlondikeStream"
      kind: "Int"
      draw {
        generator {
          source: "StreamDraw"
        }
        timing: "Event"
      }
    }
  }
}

patterns [
  {
    name: "solitaireKlondikeLength"
    kind: Int
    value: 1
    symbols [
      {
        name: "any"
        min: 1
        max: 1
      }
    ]
    pattern: star(item: any())
  }
  {
    name: "solitaireKlondikeSingle"
    kind: Int
    value: 1
    symbols [
      {
        name: "any"
        min: 1
        max: 1
      }
    ]
    pattern: any()
  }
  {
    name: "solitaireKlondikeRun"
    kind: Int
    value: solitaireKlondikeFace[$token] * (1 + (solitaireKlondikeRank[$token] == solitaireKlondikeRank[$previous] - 1) * (solitaireKlondikeSuit[$token] % 2 != solitaireKlondikeSuit[$previous] % 2))
    symbols [
      {
        name: "face"
        min: 1
        max: 2
      }
      {
        name: "next"
        min: 2
        max: 2
      }
    ]
    pattern: sequence(items: [
      symbol(name: "face")
      star(item: symbol(name: "next"))
    ]
    )
  }
  {
    name: "solitaireKlondikeLanding"
    kind: Int
    value: (solitaireKlondikeRank[$token] == solitaireKlondikeRank[solitaireKlondike[card]] + 1) * (solitaireKlondikeSuit[$token] % 2 != solitaireKlondikeSuit[solitaireKlondike[card]] % 2)
    symbols [
      {
        name: "yes"
        min: 1
        max: 1
      }
    ]
    pattern: sequence(items: [
      star(item: any())
      symbol(name: "yes")
    ]
    )
  }
]

rule "solitaireKlondike-new-deal" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[action] == 1 and (solitaireKlondike[option] == 1 or solitaireKlondike[option] == 3)
  solitaireKlondike[activeOption] = solitaireKlondike[option]
  solitaireKlondike[stage] = 1
  solitaireKlondike[status] = 0
  solitaireKlondike[result] = 0
  solitaireKlondike[busy] = 1
}

rule "solitaireKlondike-gather" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 1 and count($zones[solitaireKlondike[gatherStep]]) > 0
  zones [
    solitaireKlondikePile1
    solitaireKlondikePile2
    solitaireKlondikePile3
    solitaireKlondikePile4
    solitaireKlondikePile5
    solitaireKlondikePile6
    solitaireKlondikePile7
    solitaireKlondikePile8
    solitaireKlondikePile10
    solitaireKlondikePile11
    solitaireKlondikePile12
    solitaireKlondikePile13
  ]
  transform transfer(from: $zones[solitaireKlondike[gatherStep]], to: solitaireKlondikePile0, selector: Slice, key: zone($zones[solitaireKlondike[gatherStep]], first))
}

rule "solitaireKlondike-attributes-start" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 1 and solitaireKlondike[gatherStep] == 11 and count(solitaireKlondikePile0) == 52
  solitaireKlondike[stage] = 5
}

rule "solitaireKlondike-reset-attributes" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 5
  solitaireKlondikeFace[solitaireKlondike[attributeStep]] = 0
}

rule "solitaireKlondike-shuffle" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 5 and solitaireKlondike[attributeStep] == 51
  transaction {
    shuffle solitaireKlondikePile0 with solitaireKlondikeStream
    solitaireKlondike[stage] = 3
  }
}

rule "solitaireKlondike-deal" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 3 and solitaireKlondike[dealStep] <= 27
  zones [
    solitaireKlondikePile0
    solitaireKlondikePile1
    solitaireKlondikePile2
    solitaireKlondikePile3
    solitaireKlondikePile4
    solitaireKlondikePile5
    solitaireKlondikePile6
    solitaireKlondikePile7
    solitaireKlondikePile8
    ""
    solitaireKlondikePile10
    solitaireKlondikePile11
    solitaireKlondikePile12
    solitaireKlondikePile13
  ]
  draw solitaireKlondikePile0 to $zones[(solitaireKlondike[dealStep] < 7) ? (2 + solitaireKlondike[dealStep]) : ((solitaireKlondike[dealStep] < 13) ? (solitaireKlondike[dealStep] - 4) : ((solitaireKlondike[dealStep] < 18) ? (solitaireKlondike[dealStep] - 9) : ((solitaireKlondike[dealStep] < 22) ? (solitaireKlondike[dealStep] - 13) : ((solitaireKlondike[dealStep] < 25) ? (solitaireKlondike[dealStep] - 16) : ((solitaireKlondike[dealStep] < 27) ? (solitaireKlondike[dealStep] - 18) : 8)))))]
}

rule "solitaireKlondike-deal-finish" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 3 and solitaireKlondike[dealStep] == 27
  transaction {
    solitaireKlondike[stage] = 0
    solitaireKlondike[status] = 1
    solitaireKlondike[moves] = 0
    solitaireKlondike[score] = 0
    solitaireKlondike[passes] = 0
    solitaireKlondike[deals] = solitaireKlondike[deals] + 1
    solitaireKlondike[result] = 1
    solitaireKlondike[applied] = solitaireKlondike[request]
  }
}

rule "solitaireKlondike-prepare-move" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 2
  solitaireKlondike[sourceOk] = 0
  solitaireKlondike[targetOk] = 0
  solitaireKlondike[runLength] = 0
}

rule "solitaireKlondike-source" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 2 and $zones[solitaireKlondike[from]][solitaireKlondike[card]] == 1
  zones [
    ""
    ""
    solitaireKlondikePile2
    solitaireKlondikePile3
    solitaireKlondikePile4
    solitaireKlondikePile5
    solitaireKlondikePile6
    solitaireKlondikePile7
    solitaireKlondikePile8
  ]
  solitaireKlondike[sourceOk] = match(solitaireKlondikeRun, $zones[solitaireKlondike[from]])[solitaireKlondike[card]]
  solitaireKlondike[runLength] = match(solitaireKlondikeLength, $zones[solitaireKlondike[from]], prefix)[solitaireKlondike[card]]
}

rule "solitaireKlondike-source-1" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 2 and $zones[solitaireKlondike[from]][solitaireKlondike[card]] == 1
  zones [
    ""
    solitaireKlondikePile1
    ""
    ""
    ""
    ""
    ""
    ""
    ""
    ""
    solitaireKlondikePile10
    solitaireKlondikePile11
    solitaireKlondikePile12
    solitaireKlondikePile13
  ]
  solitaireKlondike[sourceOk] = match(solitaireKlondikeSingle, $zones[solitaireKlondike[from]])[solitaireKlondike[card]]
  solitaireKlondike[runLength] = match(solitaireKlondikeLength, $zones[solitaireKlondike[from]], prefix)[solitaireKlondike[card]]
}

rule "solitaireKlondike-target" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 2 and solitaireKlondike[sourceOk] == 1
  zones [
    ""
    ""
    solitaireKlondikePile2
    solitaireKlondikePile3
    solitaireKlondikePile4
    solitaireKlondikePile5
    solitaireKlondikePile6
    solitaireKlondikePile7
    solitaireKlondikePile8
  ]
  solitaireKlondike[targetOk] = count($zones[solitaireKlondike[to]]) == 0 ? (solitaireKlondikeRank[solitaireKlondike[card]] == 13) : match(solitaireKlondikeLanding, $zones[solitaireKlondike[to]])
}

rule "solitaireKlondike-target-10" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 2 and solitaireKlondike[sourceOk] == 1
  zones [
    ""
    ""
    ""
    ""
    ""
    ""
    ""
    ""
    ""
    ""
    solitaireKlondikePile10
    solitaireKlondikePile11
    solitaireKlondikePile12
    solitaireKlondikePile13
  ]
  solitaireKlondike[targetOk] = (solitaireKlondike[runLength] == 1) * (solitaireKlondikeSuit[solitaireKlondike[card]] == solitaireKlondike[to] - 10) * (solitaireKlondikeRank[solitaireKlondike[card]] == count($zones[solitaireKlondike[to]]) + 1)
}

rule "solitaireKlondike-move" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 2 and solitaireKlondike[sourceOk] == 1 and solitaireKlondike[targetOk] == 1 and (solitaireKlondike[from] != solitaireKlondike[to] : Int)
  zones [
    solitaireKlondikePile0
    solitaireKlondikePile1
    solitaireKlondikePile2
    solitaireKlondikePile3
    solitaireKlondikePile4
    solitaireKlondikePile5
    solitaireKlondikePile6
    solitaireKlondikePile7
    solitaireKlondikePile8
    ""
    solitaireKlondikePile10
    solitaireKlondikePile11
    solitaireKlondikePile12
    solitaireKlondikePile13
  ]
  transaction {
    transform transfer(from: $zones[solitaireKlondike[from]], to: $zones[solitaireKlondike[to]], selector: Slice, key: solitaireKlondike[card])
    solitaireKlondike[moves] = solitaireKlondike[moves] + 1
    solitaireKlondike[busy] = 1
    solitaireKlondike[score] = maximum(0, solitaireKlondike[score] + ((solitaireKlondike[to] >= 10) ? 10 : ((solitaireKlondike[from] >= 10) ? -15 : ((solitaireKlondike[from] == 1) ? 5 : 0))))
    solitaireKlondike[result] = 1
    solitaireKlondike[applied] = solitaireKlondike[request]
  }
}

rule "solitaireKlondike-draw-start" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 3 and count(solitaireKlondikePile0) > 0
  transaction {
    solitaireKlondike[stage] = 4
    solitaireKlondike[drawLeft] = minimum(solitaireKlondike[activeOption], count(solitaireKlondikePile0))
    solitaireKlondike[busy] = 1
  }
}

rule "solitaireKlondike-draw-card" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 4
  transaction {
    solitaireKlondikeFace[zone(solitaireKlondikePile0, first)] = 1
    draw solitaireKlondikePile0 to solitaireKlondikePile1
    solitaireKlondike[drawLeft] = solitaireKlondike[drawLeft] - 1
  }
}

rule "solitaireKlondike-draw-finish" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 4 and solitaireKlondike[drawLeft] == 0
  transaction {
    solitaireKlondike[stage] = 0
    solitaireKlondike[moves] = solitaireKlondike[moves] + 1
    solitaireKlondike[result] = 1
    solitaireKlondike[applied] = solitaireKlondike[request]
  }
}

rule "solitaireKlondike-recycle-start" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0 and solitaireKlondike[status] == 1 and solitaireKlondike[action] == 3 and count(solitaireKlondikePile0) == 0 and count(solitaireKlondikePile1) > 0
  solitaireKlondike[stage] = 2
  solitaireKlondike[passes] = solitaireKlondike[passes] + 1
}

rule "solitaireKlondike-recycle-card" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 2 and count(solitaireKlondikePile1) > 0
  draw solitaireKlondikePile1 to solitaireKlondikePile0
}

rule "solitaireKlondike-recycle-face-down" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 2 and solitaireKlondikeFace[$each] == 1
  forEach: solitaireKlondikePile0
  solitaireKlondikeFace[$each] = 0
}

rule "solitaireKlondike-recycle-finish" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 2 and count(solitaireKlondikePile1) == 0
  transaction {
    solitaireKlondike[stage] = 0
    solitaireKlondike[moves] = solitaireKlondike[moves] + 1
    solitaireKlondike[result] = 1
    solitaireKlondike[applied] = solitaireKlondike[request]
  }
}

rule "solitaireKlondike-deal-advance" {
  when solitaire[table] == 1 and (solitaireKlondike[stage] == 0 or solitaireKlondike[stage] == 3 or solitaireKlondike[stage] == 4)
  solitaireKlondike[dealStep] = solitaireKlondike[stage] == 0 ? 0 : solitaireKlondike[dealStep] + 1
}

rule "solitaireKlondike-reject" {
  when solitaire[table] == 1 and solitaireKlondike[request] != solitaireKlondike[applied] and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 0
  transaction {
    solitaireKlondike[result] = -1
    solitaireKlondike[applied] = solitaireKlondike[request]
  }
}

rule "solitaireKlondike-maintenance-start" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 1
  solitaireKlondike[busy] = 0
}

rule "solitaireKlondike-reveal" {
  when solitaire[table] == 1 and solitaireKlondike[status] == 1 and solitaireKlondike[stage] == 0 and count($zones[$each]) > 0 and ((solitaireKlondikeFace[zone($zones[$each], last)] ?? 1) == 0 : Int)
  forEach: $zones
  zones [
    solitaireKlondikePile2
    solitaireKlondikePile3
    solitaireKlondikePile4
    solitaireKlondikePile5
    solitaireKlondikePile6
    solitaireKlondikePile7
    solitaireKlondikePile8
    solitaireKlondikePile1
  ]
  solitaireKlondikeFace[zone($zones[$each], last)] = 1
  solitaireKlondike[busy] = 1
}

rule "solitaireKlondike-gather-advance" {
  when solitaire[table] == 1 and (solitaireKlondike[stage] == 0 or solitaireKlondike[stage] == 1)
  solitaireKlondike[gatherStep] = solitaireKlondike[stage] == 0 ? 0 : minimum(11, solitaireKlondike[gatherStep] + 1)
}

rule "solitaireKlondike-attribute-advance" {
  when solitaire[table] == 1 and (solitaireKlondike[stage] == 0 or solitaireKlondike[stage] == 5)
  solitaireKlondike[attributeStep] = solitaireKlondike[stage] == 0 ? 0 : solitaireKlondike[attributeStep] + 1
}

rule "solitaireKlondike-win" {
  when solitaire[table] == 1 and solitaireKlondike[status] == 1 and solitaireKlondike[busy] == 0
  solitaireKlondike[status] = (count(solitaireKlondikePile10) + count(solitaireKlondikePile11) + count(solitaireKlondikePile12) + count(solitaireKlondikePile13)) == 52 ? 2 : 1
}
