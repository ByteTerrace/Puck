    }

    pile solitaireKlondikePile1 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile2 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile3 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile4 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile5 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile6 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile7 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile8 of solitaireKlondikeCards capacity(52)

    pile solitaireKlondikePile10 of solitaireKlondikeCards capacity(13)

    pile solitaireKlondikePile11 of solitaireKlondikeCards capacity(13)

    pile solitaireKlondikePile12 of solitaireKlondikeCards capacity(13)

    pile solitaireKlondikePile13 of solitaireKlondikeCards capacity(13)

    table solitaireKlondike capacity(27) {
      request = 0
      applied = 0
      action = 0
      from = -1
      to = -1
      card = -1
      option = 1
      activeOption = 1
      stage = 0
      busy = 0
      status = 0
