      "99" = 99
      "100" = 100
      "101" = 101
      "102" = 102
      "103" = 103
    }

    row {
      name: "solitaireSpiderRank"
      kind: "Int"
      domain: keysOf(row: "solitaireSpiderCards")
      capacity: 104
      cells: map(range(0, 104), i => { key: $"{i}", value: (i % 13) + 1 })
    }

    row {
      name: "solitaireSpiderSuit"
      kind: "Int"
      domain: keysOf(row: "solitaireSpiderCards")
      capacity: 104
      cells: map(range(0, 104), i => { key: $"{i}", value: floor((i % 52) / 13) })
    }

    row {
      name: "solitaireSpiderFace"
      kind: "Int"
      domain: keysOf(row: "solitaireSpiderCards")
      capacity: 104
      cells: map(range(0, 104), i => { key: $"{i}", value: 0 })
    }
    pile solitaireSpiderPile0 of solitaireSpiderCards capacity(104) {
      "0"
      "1"
      "2"
      "3"
      "4"
      "5"
      "6"
      "7"
