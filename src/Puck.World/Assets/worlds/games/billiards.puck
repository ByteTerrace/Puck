prototypes {
  prototype "billiardBall" {
    document {
      name: "billiardBall"
      palette [
        {
          color: "state.billiardsColors.ball"
          roughness: 0.522
          specular: 0.4
        }
      ]
      schema: "puck.creation.v1"
      shape Sphere "sphere" {
        material: 0
        position [0, 0.15, 0]
        rotation: "state.transforms.identity"
        scale [0.15, 0.15, 0.15]
      }
    }
  }

  prototype "billiardsTray" {
    document {
      name: "billiardsTray"
      palette [
        {
          color: "state.billiardsColors.tray"
          roughness: 0.891
          specular: 0.05
        }
      ]
      schema: "puck.creation.v1"
      shape Box "floor" {
        material: 0
        position [0, -0.45, 0]
        rotation: "state.transforms.identity"
        scale [1.4, 0.05, 1.4]
      }

      shape Box "wallNorth" {
        material: 0
        position [0, -0.31, 1.35]
        rotation: "state.transforms.identity"
        scale [1.4, 0.14, 0.05]
      }

      shape Box "wallSouth" {
        material: 0
        position [0, -0.31, -1.35]
        rotation: "state.transforms.identity"
        scale [1.4, 0.14, 0.05]
      }

      shape Box "wallEast" {
        material: 0
        position [1.35, -0.31, 0]
        rotation: "state.transforms.identity"
        scale [0.05, 0.14, 1.4]
      }

      shape Box "wallWest" {
        material: 0
        position [-1.35, -0.31, 0]
        rotation: "state.transforms.identity"
        scale [0.05, 0.14, 1.4]
      }
    }
  }
}

rule "cue-charge" {
  when $channel:1:attack >= 1
  mode: "Level"
  cue[0] = minimum(cue[0] + 0.1, 3.0)
}

rule "cue-release" {
  when $channel:1:attack < 1 and cue[0] > 0
  mode: "Edge"
  applyRigidImpulse(headingKey: "body:0", key: "placement:cueBall", magnitudeKey: "0", magnitudeState: "cue")
  cue[0] = 0
}

state {
  world {
    table cue: Fixed {
      "0" = 0
    }
  }
}
