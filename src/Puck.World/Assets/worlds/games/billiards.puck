kits {
  rows [
    {
      bodyContact: "Solid"
      bodyMotionProgram: "walk"
      collider: sphere(radius: 0.15)
      motion {
        facingSnap: true
        holds [
          {
            bond: "Free"
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: "Gravity"
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 0.001
        }
        turn {
          rate: 0.001
        }
      }
      name: "billiardBall"
      rigid {
        angularDamping: 0.8
        friction: 0.25
        linearDamping: 0.5
        mass: 0.3
        restitution: 0.55
        rollingFriction: 1.2
      }
    }
  ]
}

