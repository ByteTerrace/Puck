// 'for' in it, none of which the document carries.

export action mancalaBoard, mancalaMoveRequest, mancalaSelectedPit
export binding mancalaStatus, mancalaTurn
export read mancalaBoard, mancalaMoveApplied, mancalaPitSeeds, mancalaSelectedPit, mancalaStatus, mancalaTurn

placements {
  placement "mancalaTable" {
    prototype: "tabletop"
    board {
      move: "mancalaSelectedPit"
      occupancy: "mancalaBoard"
      topology: "mancalaBoard"
      turn: "mancalaTurn"
      verdict: "mancalaStatus"
    }
    position [-8, -0.5, -16]
  }
}

rule "mancala-reject-out-of-range" {
  when mancalaMoveRequest != mancalaMoveApplied and (mancalaSelectedPit < 0 or mancalaSelectedPit > 12 or mancalaSelectedPit == 6)
  mode: "Level"
  mancalaMoveApplied = mancalaMoveRequest
}

rule "mancala-reject-illegal" {
  when mancalaMoveRequest != mancalaMoveApplied and mancalaSelectedPit >= 0 and mancalaSelectedPit <= 12 and mancalaSelectedPit != 6 and (mancalaStatus != 0 or (mancalaTurn == 0 and mancalaSelectedPit > 5) or (mancalaTurn == 1 and mancalaSelectedPit < 7) or mancalaBoard[mancalaSelectedPit[$value]] == 0)
  mode: "Level"
  mancalaMoveApplied = mancalaMoveRequest
}

rule "mancala-stage-move" {
  when mancalaMoveRequest != mancalaMoveApplied and mancalaStatus == 0 and ((mancalaTurn == 0 and mancalaSelectedPit >= 0 and mancalaSelectedPit <= 5) or (mancalaTurn == 1 and mancalaSelectedPit >= 7 and mancalaSelectedPit <= 12)) and mancalaBoard[mancalaSelectedPit[$value]] > 0
  local cStart: Int = (mancalaSelectedPit + 7 * mancalaTurn) % 14
  local cLast: Int = ($local:cStart + mancalaBoard[(mancalaSelectedPit)]) % 13
  local pLast: Int = ($local:cLast + 7 * mancalaTurn) % 14
  local extra: Int = $local:cLast == 6 ? 1 : 0
  mode: "Level"
  setState(fromKey: "$cell:mancalaSelectedPit:$value", fromState: "mancalaBoard", state: "mancalaPitSeeds")
  setState(expression: "$local:pLast", state: "mancalaLastPit")
  setState(expression: "$local:extra", state: "mancalaExtraTurn")
  mancalaMoveApplied = mancalaMoveRequest
  mancalaStage = 1
}

rule "mancala-sow-board" {
  when mancalaStage == 1
  local p: Int = mancalaPitIndex[$each]
  local cStart: Int = (mancalaSelectedPit + 7 * mancalaTurn) % 14
  local cp: Int = ($local:p + 7 * mancalaTurn) % 14
  local dRaw: Int = ($local:cp - $local:cStart + 26) % 13
  local dist: Int = $local:dRaw == 0 ? 13 : $local:dRaw
  local added: Int = (($local:cp == 13) | (mancalaPitSeeds < $local:dist)) ? 0 : (1 + (mancalaPitSeeds - $local:dist) / 13)
  mode: "Level"
  forEach: "mancalaBoard"
  mancalaBoard[$each] = ($local:p == mancalaSelectedPit ? 0 : mancalaBoard[$each]) + $local:added
}

rule "mancala-advance-to-capture" {
  when mancalaStage == 1
  mode: "Level"
  mancalaStage = 2
}

rule "mancala-apply-capture" {
  when mancalaStage == 2 and $local:canCapture == 1
  local isOwnSide: Int = ((mancalaLastPit + 7 * mancalaTurn) % 14 <= 5) ? 1 : 0
  local isNotSelected: Int = mancalaLastPit != mancalaSelectedPit ? 1 : 0
  local wasEmpty: Int = mancalaBoard[(mancalaLastPit)] == (1 + (mancalaPitSeeds - 1) / 13) ? 1 : 0
  local oppositeHasSeeds: Int = mancalaBoard[(12 - mancalaLastPit)] > 0 ? 1 : 0
  local canCapture: Int = $local:isOwnSide & $local:isNotSelected & $local:wasEmpty & $local:oppositeHasSeeds
  mode: "Level"
  mancalaBoard[6 + 7 * mancalaTurn] = mancalaBoard[(6 + 7 * mancalaTurn)] + mancalaBoard[(mancalaLastPit)] + mancalaBoard[(12 - mancalaLastPit)]
  mancalaBoard[mancalaLastPit[$value]] = 0
  mancalaBoard[12 - mancalaLastPit] = 0
  mancalaStage = 3
}

rule "mancala-skip-capture" {
  when mancalaStage == 2
  mode: "Level"
  mancalaStage = 3
}

rule "mancala-update-turn" {
  when mancalaStage == 3
  mode: "Level"
  mancalaTurn = mancalaExtraTurn == 1 ? mancalaTurn : (1 - mancalaTurn)
  mancalaStage = 4
}

rule "mancala-check-game-over" {
  when mancalaStage == 4 and $local:isGameOver == 1
  local p0Sum: Int = mancalaBoard[0] + mancalaBoard[1] + mancalaBoard[2] + mancalaBoard[3] + mancalaBoard[4] + mancalaBoard[5]
  local p1Sum: Int = mancalaBoard[7] + mancalaBoard[8] + mancalaBoard[9] + mancalaBoard[10] + mancalaBoard[11] + mancalaBoard[12]
  local isGameOver: Int = ($local:p0Sum == 0) | ($local:p1Sum == 0) ? 1 : 0
  local final0: Int = mancalaBoard[6] + $local:p0Sum
  local final1: Int = mancalaBoard[13] + $local:p1Sum
  local winner: Int = $local:final0 > $local:final1 ? 1 : ($local:final1 > $local:final0 ? 2 : 3)
  mode: "Level"
  setState(expression: "$local:final0", key: "6", state: "mancalaBoard")
  setState(expression: "$local:final1", key: "13", state: "mancalaBoard")
  mancalaBoard[0] = 0
  mancalaBoard[1] = 0
  mancalaBoard[2] = 0
  mancalaBoard[3] = 0
  mancalaBoard[4] = 0
  mancalaBoard[5] = 0
  mancalaBoard[7] = 0
  mancalaBoard[8] = 0
  mancalaBoard[9] = 0
  mancalaBoard[10] = 0
  mancalaBoard[11] = 0
  mancalaBoard[12] = 0
  setState(expression: "$local:winner", state: "mancalaStatus")
  mancalaStage = 0
}

rule "mancala-game-continues" {
  when mancalaStage == 4
  mode: "Level"
  mancalaStage = 0
}

