{
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "lattice": {
      "description": "The lattice\u0027s extent, resolution, and step cadence.",
      "type": "object",
      "properties": {
        "origin": {
          "description": "The minimum corner, world units."
        },
        "cellSize": {
          "description": "The cubic cell edge, world units.",
          "type": "number"
        },
        "width": {
          "description": "Cells along \u002BX.",
          "type": "integer"
        },
        "depth": {
          "description": "Cells along \u002BZ.",
          "type": "integer"
        },
        "layers": {
          "description": "Cells along \u002BY.",
          "type": "integer",
          "default": 1
        },
        "stepEveryTicks": {
          "description": "Simulation ticks between reaction steps.",
          "type": "integer",
          "default": 8
        }
      },
      "required": [
        "origin",
        "cellSize",
        "width",
        "depth"
      ],
      "additionalProperties": false
    },
    "fields": {
      "description": "The declared fields, in order; a reaction, paint, or render row names them.",
      "type": "array",
      "items": {
        "description": "One field: a scalar per cell clamped to [Min, Max].",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "name": {
            "description": "The field\u0027s name \u2014 unique within the section, dot-free.",
            "type": "string"
          },
          "initial": {
            "description": "The value every cell starts at before paint.",
            "type": "number",
            "default": 0
          },
          "min": {
            "description": "The least value a cell holds.",
            "type": "number",
            "default": 0
          },
          "max": {
            "description": "The greatest value a cell holds.",
            "type": "number",
            "default": 1
          },
          "heightScale": {
            "description": "World units of solid surface per unit of value above the lattice origin \u2014 0 for a field that is not geometry.",
            "type": "number",
            "default": 0
          },
          "color": {
            "description": "The #RRGGBB the field\u0027s surface shades with; required when HeightScale is nonzero.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "reactions": {
      "description": "The per-step reactions, applied in document order each lattice step.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "description": "One reaction \u2014 a local rule every cell (or every tagged body) applies each lattice step. Reactions run in document order; Diffuse reads the previous step\u0027s values for the whole field, every other kind reads and writes cells in place, row-major.",
        "type": [
          "object",
          "null"
        ],
        "required": [
          "$type"
        ],
        "anyOf": [
          {
            "description": "Moves each cell a fraction of the way toward the mean of its face neighbours (four on a ground lattice, six in a volume).",
            "properties": {
              "$type": {
                "const": "diffuse"
              },
              "field": {
                "description": "The field diffused.",
                "type": "string"
              },
              "rate": {
                "description": "The fraction per step, in [0, 1].",
                "type": "number"
              }
            },
            "required": [
              "field",
              "rate"
            ],
            "additionalProperties": false
          },
          {
            "description": "Scales each cell toward zero: v -= v\u00B7rate.",
            "properties": {
              "$type": {
                "const": "decay"
              },
              "field": {
                "description": "The field decayed.",
                "type": "string"
              },
              "rate": {
                "description": "The fraction per step, in [0, 1].",
                "type": "number"
              }
            },
            "required": [
              "field",
              "rate"
            ],
            "additionalProperties": false
          },
          {
            "description": "Where every condition holds at a cell, applies every write at that cell \u2014 ignition, melting, evaporation, freezing are rows of this shape.",
            "properties": {
              "$type": {
                "const": "transform"
              },
              "when": {
                "description": "The conditions, all of which must hold.",
                "type": "array",
                "items": {
                  "description": "One per-cell condition of a Transform.",
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "field": {
                      "description": "The field read at the cell.",
                      "type": "string"
                    },
                    "comparison": {
                      "$ref": "./common.schema.json#/$defs/ActionStateComparison",
                      "description": "The comparison."
                    },
                    "value": {
                      "description": "The constant compared against.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "field",
                    "comparison",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "then": {
                "description": "The writes, applied in order.",
                "type": "array",
                "items": {
                  "description": "One per-cell write of a Transform.",
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "field": {
                      "description": "The field written at the cell.",
                      "type": "string"
                    },
                    "op": {
                      "description": "Set or add.",
                      "enum": [
                        "Set",
                        "Add"
                      ]
                    },
                    "value": {
                      "description": "The constant written or added; the result clamps to the field\u0027s range.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "when",
              "then"
            ],
            "additionalProperties": false
          },
          {
            "description": "Every active body whose cell in the keyed state row Tag reads nonzero adds Amount to Field at the cell it occupies \u2014 a burning body is a heat source.",
            "properties": {
              "$type": {
                "const": "emit"
              },
              "tag": {
                "description": "The keyed int state row whose nonzero cells name the emitting bodies.",
                "type": "string"
              },
              "field": {
                "description": "The field deposited into.",
                "type": "string"
              },
              "amount": {
                "description": "The amount per step; the cell clamps to the field\u0027s range.",
                "type": "number"
              }
            },
            "required": [
              "tag",
              "field",
              "amount"
            ],
            "additionalProperties": false
          },
          {
            "description": "Writes 1 or 0 into Row\u0027s cell for every active body, by whether Field at the body\u0027s cell satisfies the comparison \u2014 a body standing in a burning cell becomes tagged, and body-level chemistry takes it from there.",
            "properties": {
              "$type": {
                "const": "expose"
              },
              "field": {
                "description": "The field sampled at the body.",
                "type": "string"
              },
              "comparison": {
                "$ref": "./common.schema.json#/$defs/ActionStateComparison",
                "description": "The comparison."
              },
              "value": {
                "description": "The constant compared against.",
                "type": "number"
              },
              "row": {
                "description": "The keyed int state row written, keyed by body index.",
                "type": "string"
              }
            },
            "required": [
              "field",
              "comparison",
              "value",
              "row"
            ],
            "additionalProperties": false
          }
        ]
      },
      "default": null
    },
    "paint": {
      "description": "The initial fills, applied in order over the fields\u0027 Initial.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "description": "One initial fill: every cell whose XZ centre lies in the rectangle takes Value.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "field": {
            "description": "The field painted.",
            "type": "string"
          },
          "value": {
            "description": "The value written.",
            "type": "number"
          },
          "minX": {
            "description": "The rectangle\u0027s least X, world units.",
            "type": "number"
          },
          "minZ": {
            "description": "The rectangle\u0027s least Z, world units.",
            "type": "number"
          },
          "maxX": {
            "description": "The rectangle\u0027s greatest X, world units.",
            "type": "number"
          },
          "maxZ": {
            "description": "The rectangle\u0027s greatest Z, world units.",
            "type": "number"
          }
        },
        "required": [
          "field",
          "value",
          "minX",
          "minZ",
          "maxX",
          "maxZ"
        ],
        "additionalProperties": false
      },
      "default": null
    }
  },
  "required": [
    "lattice",
    "fields"
  ],
  "additionalProperties": false,
  "default": null
}
