      },
      "bindingBar": {
        "description": "The on-screen bar policy carried with this binding layer; null carries no policy on this layer, so bar resolution falls through to the world-authored policy, and to Absent (no bar drawn) when neither an identity nor the world authors one.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "slotSet": {
            "description": "The physical controls this bar shows, by INPUT SOURCE ID (gamepad.buttonSouth, mouse.button1, \u2026) in authored order (an exotic slot\u0027s left-to-right position in its row follows this order) \u2014 the same vocabulary a binding entry\u0027s sources speak, every id validated against the engine\u0027s input-source catalog, unique, at most MaxSlots.",
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "banks": {
            "description": "The stacked banks \u2014 at least one, at most MaxBanks, unique ids, each naming a page the composed binding profile actually declares.",
            "type": "array",
            "items": {
              "description": "One stacked binding-bar bank: the page it renders and its position in the stack. Several banks of the SAME slot set render simultaneously, each showing what that bank\u0027s OWN page binds \u2014 the WoW-addon original\u0027s \u0022five banks of one compass\u0022 idea (resting, LT, RT, LT\u003ERT, RT\u003ELT are the natural five, though a bank may name any page). The engine ARRANGES the stack from Order alone, pitching it off the authored theme\u0027s spacing grid; the two offsets exist only for a world that wants to place one bank by hand.",
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "description": "The bank\u0027s stable id \u2014 its mutation address (unique within the authoring row).",
                  "type": "string"
                },
                "pageId": {
                  "description": "The BindingPageDefinition.Id this bank renders \u2014 validated to exist somewhere in the composed binding profile.",
                  "type": "string"
                },
                "order": {
                  "description": "This bank\u0027s place in the derived stack (unique within the authoring row): 0 sits on the bar\u0027s shared anchor, and each higher order fans one step further out and up.",
                  "type": "integer"
                },
                "alpha": {
                  "description": "This bank\u0027s opacity when it is NOT the seat\u0027s currently active page.",
                  "type": "number"
                },
                "activeAlpha": {
                  "description": "This bank\u0027s opacity when it IS the seat\u0027s currently active page; null draws fully opaque (1.0) while active.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "default": null
                },
                "offsetX": {
                  "description": "Overrides the derived horizontal displacement from the bar\u0027s shared anchor, in region-height units; null takes the derived arrangement. Authoring one offset overrides BOTH axes\u0027 derivation only for the axis it names.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "default": null
                },
                "offsetY": {
                  "description": "Overrides the derived vertical displacement, region-height units, Y DOWN (positive moves toward the bottom of the seat\u0027s viewport); null takes the derived arrangement.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "id",
                "pageId",
                "order",
                "alpha"
              ],
              "additionalProperties": false
            }
          },
          "enabled": {
            "description": "Whether the bar is shown when no live override hides it.",
            "type": "boolean",
            "default": true
          },
          "text": {
            "description": "Whether the bar draws the ATLAS TEXT it composes \u2014 a badge whose icon row carries a Label (LB/RB, LT/RT, LS/RS, the menu trio, the exotics), the active page\u0027s name under the modifier indicators, and the chord-hint lines above them. false drops every label-content badge outright and leaves a purely pictographic bar: every plate, the glyph-content badges (the d-pad arrows and the face-position marks), the bound actions\u0027 icons, and the modifier indicators all still draw.",
            "type": "boolean",
            "default": true
          },
          "modifiers": {
            "description": "Whether the bar draws the modifier indicator row on its anchor line \u2014 one plate per modifier the composed profile carries (declared rows plus every chord/held token the compiler synthesizes), lit while held. false drops the row and leaves the slot clusters alone; the chord hints and page label are Text\u0027s, not this one\u0027s.",
            "type": "boolean",
            "default": true
          },
          "hideUnbound": {
            "description": "Whether a slot with no bound act on its bank\u0027s page should not render at all, rather than drawing the DISABLED tier-0 plate. A player\u0027s own BindingBarPreferences.HideUnbound overrides this.",
            "type": "boolean",
            "default": false
          },
          "multiSeatAlpha": {
            "description": "The opacity every joined seat\u0027s bar renders at while two or more seats are joined \u2014 the split-screen quieting lever, multiplied into each bank\u0027s own alpha; 1 keeps multi-seat bars fully opaque.",
            "type": "number",
            "default": 1
          },
          "iconRow": {
            "description": "The state row a slot\u0027s icon resolves through, spelled state.\u003Crow\u003E \u2014 the row\u0027s CELL KEY is the bound row\u0027s id when it authors one, else its action (command or channel; a dotted command name therefore needs an id, since a cell key holds no dot), and its value is an icons name. The engine holds no action-to-icon vocabulary of its own: the association is ordinary authored state, so it is written, read, and MUTATED like any other state (world.state.cell.set) \u2014 a spell minted at runtime gets its icon by writing a cell, never by reshaping the document. null resolves no slot icons at all; a key the row does not carry simply draws no icon.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "layout": {
            "description": "The bar\u0027s tuning; null uses Default.",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "scale": {
                "description": "The uniform cluster scale.",
                "type": "number",
                "default": 1
              },
              "buttonSize": {
                "description": "The unscaled slot-plate size.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "centerGap": {
                "description": "The unscaled extra half-gap between the mirrored clusters.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "anchorOffsetY": {
                "description": "The anchor\u0027s lift above the viewport\u0027s bottom edge.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "glyphOffsetRatio": {
                "description": "The badge\u0027s corner offset as a fraction of ButtonSize.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "glyphSizeRatio": {
                "description": "The badge\u0027s size as a fraction of ButtonSize.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "centerRowLift": {
                "description": "The menu row\u0027s lift above the anchor, in scaled button sizes.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "centerSlotSpacing": {
                "description": "The menu row\u0027s slot pitch, in scaled button sizes.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "exoticRowLift": {
                "description": "The exotics row\u0027s lift above the anchor, in scaled button sizes.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "exoticSlotSpacing": {
                "description": "The exotics row\u0027s slot pitch, in scaled button sizes.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "badgeCorner": {
                "description": "The fixed corner direction a menu/exotics slot\u0027s badge nudges toward (the compass categories take their direction from the pad pictogram geometry instead).",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "modifierHalfRatio": {
                "description": "The modifier indicator\u0027s plate half-extent, in scaled button sizes.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "modifierSpacingRatio": {
                "description": "The modifier indicators\u0027 pitch, in scaled button sizes.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "modifierGlyphRatio": {
                "description": "The modifier badge\u0027s half-extent, as a fraction of the modifier plate half.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "labelCellRatio": {
                "description": "The page label\u0027s glyph-cell height, as a fraction of the modifier plate half.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "labelCellMinPx": {
                "description": "The page label\u0027s glyph-cell floor, px.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "labelGapRatio": {
                "description": "The page label\u0027s drop below the anchor, as a fraction of the modifier plate half.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "hintCellRatio": {
                "description": "A chord-hint line\u0027s glyph-cell height, as a fraction of the modifier plate half.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "hintCellMinPx": {
                "description": "A chord-hint line\u0027s glyph-cell floor, px.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "hintLineStepRatio": {
                "description": "The chord-hint line pitch, as a fraction of the hint cell height.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "hintBaseGapRatio": {
                "description": "The hint stack\u0027s lift above the anchor, as a fraction of the modifier plate half.",
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              }
            },
            "additionalProperties": false,
            "default": null
          },
          "visible": {
            "$ref": "./common.schema.json#/$defs/OverlayPredicateNullable",
            "description": "The bar\u0027s visibility condition over presentation facts, or null for always.",
            "default": null
          }
        },
        "required": [
          "slotSet",
          "banks"
        ],
        "additionalProperties": false,
        "default": null
      }
    },
    "required": [
