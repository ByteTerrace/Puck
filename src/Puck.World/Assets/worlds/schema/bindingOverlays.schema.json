                        ],
                        "default": null
                      }
                    },
                    "required": [
                      "id",
                      "entries"
                    ],
                    "additionalProperties": false
                  }
                },
                "style": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "pointerSelection": {
                      "enum": [
                        "Disabled",
                        "Angle",
                        "HitTarget"
                      ],
                      "default": "Angle"
                    },
                    "placement": {
                      "enum": [
                        "Pointer",
                        "ViewportCenter"
                      ],
                      "default": "Pointer"
                    },
                    "deadZoneFraction": {
                      "type": "number",
                      "default": 0.1
                    },
                    "ringWidthFraction": {
                      "type": "number",
                      "default": 0.07
                    },
                    "outerGraceRingFraction": {
                      "type": "number",
                      "default": 0.5
                    },
                    "rotationDegrees": {
                      "type": "number",
                      "default": 0
                    },
                    "clockwise": {
                      "type": "boolean",
                      "default": true
                    },
                    "initialRing": {
                      "type": "integer",
                      "default": 0
                    },
                    "ringSelection": {
                      "enum": [
                        "Explicit",
                        "Excursion"
                      ],
                      "default": "Explicit"
                    },
                    "excursion": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "deadZone": {
                          "type": "number"
                        },
                        "thresholds": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "spatialTravelFraction": {
                          "type": "number",
                          "default": 0.25
                        },
                        "hysteresis": {
                          "type": "number",
                          "default": 0.02
                        }
                      },
                      "required": [
                        "deadZone",
                        "thresholds"
                      ],
                      "additionalProperties": false,
                      "default": null
