{
  "type": [
    "array",
    "null"
  ],
  "items": {
    "description": "One per-world binding overlay \u2014 a whole BindingProfileDocument layered over the engine default beneath every seat\u0027s profile bindings, so a world can contextualize the controls (a kart world remapping a lane, an RTS world adding a chorded command page) as data, never a client fork. Merged in order; the composed result (default \u2295 every overlay) is what the validator compiles.",
    "type": [
      "object",
      "null"
    ],
    "properties": {
      "id": {
        "description": "The overlay\u0027s stable id \u2014 its mutation address (unique within the definition; carries no meaning beyond identity).",
        "type": "string"
      },
      "document": {
        "description": "The overlay binding document merged into the composed mapping.",
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "pressThreshold": {
                  "type": "number",
                  "default": 0.5
                },
                "releaseThreshold": {
                  "type": "number",
                  "default": 0.4
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "icon": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "id",
                "sources"
              ],
              "additionalProperties": false
            }
          },
          "chords": {
            "type": "array",
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "group": {
                  "type": "string"
                },
                "chord": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "default": null
                },
                "page": {
                  "$ref": "./common.schema.json#/$defs/BindingPageDefinition",
                  "default": null
                },
                "command": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "command": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null
                    },
                    "channel": {
                      "default": null
                    },
                    "scale": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "default": null
                    },
                    "holdRelease": {
                      "type": "boolean",
                      "default": false
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null
                    },
                    "icon": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null
                    },
                    "value": {
                      "default": null
                    },
                    "mode": {
                      "enum": [
                        "Hold",
                        "Toggle"
                      ],
                      "default": "Hold"
                    }
                  },
                  "additionalProperties": false,
                  "default": null
                },
                "held": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "default": null
                },
                "isResting": {
                  "type": "boolean"
                },
                "members": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "required": [
                "group"
              ],
              "additionalProperties": false
            }
          },
          "contexts": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "family": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                }
              },
              "required": [
                "family",
                "state",
                "group"
              ],
              "additionalProperties": false
            },
            "default": null
          },
          "wheels": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                },
                "holdPages": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "rings": {
                  "type": "array",
                  "items": {
                    "$ref": "./common.schema.json#/$defs/BindingPageDefinition"
                  }
                },
                "style": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "pointerSelection": {
                      "enum": [
                        "Disabled",
                        "Angle",
                        "HitTarget"
                      ],
                      "default": "Angle"
                    },
                    "placement": {
                      "enum": [
                        "Pointer",
                        "ViewportCenter"
                      ],
                      "default": "Pointer"
                    },
                    "deadZoneFraction": {
                      "type": "number",
                      "default": 0.1
                    },
                    "ringWidthFraction": {
                      "type": "number",
                      "default": 0.07
                    },
                    "outerGraceRingFraction": {
                      "type": "number",
                      "default": 0.5
                    },
                    "rotationDegrees": {
                      "type": "number",
                      "default": 0
                    },
                    "clockwise": {
                      "type": "boolean",
                      "default": true
                    },
                    "initialRing": {
                      "type": "integer",
                      "default": 0
                    },
                    "ringSelection": {
                      "enum": [
                        "Explicit",
                        "Excursion"
                      ],
                      "default": "Explicit"
                    },
                    "excursion": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "deadZone": {
                          "type": "number"
                        },
                        "thresholds": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "spatialTravelFraction": {
                          "type": "number",
                          "default": 0.25
                        },
                        "hysteresis": {
                          "type": "number",
                          "default": 0.02
                        }
                      },
                      "required": [
                        "deadZone",
                        "thresholds"
                      ],
                      "additionalProperties": false,
                      "default": null
                    },
                    "axisDeadZone": {
                      "type": "number",
                      "default": 0.08
                    },
                    "selectionGraceSeconds": {
                      "type": "number",
                      "default": 0.5
                    },
                    "switchFraction": {
                      "type": "number",
                      "default": 0.4
                    }
                  },
                  "additionalProperties": false,
                  "default": null
                }
              },
              "required": [
                "id",
                "group",
                "holdPages",
                "rings"
              ],
              "additionalProperties": false
            },
            "default": null
          },
          "bindingBar": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "hideUnbound": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "stacked": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "scale": {
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              }
            },
            "additionalProperties": false,
            "default": null
          }
        },
        "required": [
          "version",
          "modifiers",
          "chords"
        ],
        "additionalProperties": false
      },
      "bindingBar": {
        "description": "The on-screen bar policy carried with this binding layer; null carries no policy on this layer, so bar resolution falls through to the world-authored policy, and to Absent (no bar drawn) when neither an identity nor the world authors one.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "slotSet": {
            "description": "The physical buttons this bar shows, in authored order (an exotic button\u0027s left-to-right position in its row follows this order) \u2014 every name validated against the full GamepadButtons catalog by name, unique, so the catalog itself bounds the count (the reservation sizes from Puck.Input.Devices.GamepadButtonCatalog.Count).",
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "banks": {
            "description": "The stacked banks \u2014 at least one, at most MaxBanks, unique ids, each naming a page the composed binding profile actually declares.",
            "type": "array",
            "items": {
              "description": "One stacked binding-bar bank: the page it renders and where it renders relative to the bar\u0027s shared anchor. Several banks of the SAME slot set render simultaneously, each showing what that bank\u0027s OWN page binds \u2014 the WoW-addon original\u0027s \u0022five banks of one compass\u0022 idea (resting, LT, RT, LT\u003ERT, RT\u003ELT are the natural five, though a bank may name any page).",
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "description": "The bank\u0027s stable id \u2014 its mutation address (unique within the authoring row).",
                  "type": "string"
                },
                "pageId": {
                  "description": "The BindingPageDefinition.Id this bank renders \u2014 validated to exist somewhere in the composed binding profile.",
                  "type": "string"
                },
                "offsetX": {
                  "description": "This bank\u0027s horizontal displacement from the bar\u0027s shared anchor, in region-height units (the same unit WorldBindingBarLayout\u0027s lengths use).",
                  "type": "number"
                },
                "offsetY": {
                  "description": "This bank\u0027s vertical displacement, region-height units, Y DOWN (positive moves toward the bottom of the seat\u0027s viewport).",
                  "type": "number"
                },
                "alpha": {
                  "description": "This bank\u0027s opacity when it is NOT the seat\u0027s currently active page.",
                  "type": "number"
                },
                "activeAlpha": {
                  "description": "This bank\u0027s opacity when it IS the seat\u0027s currently active page; null draws fully opaque (1.0) while active.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "id",
                "pageId",
                "offsetX",
                "offsetY",
                "alpha"
              ],
              "additionalProperties": false
            }
          },
          "enabled": {
            "description": "Whether the bar is shown when no live override hides it.",
            "type": "boolean",
            "default": true
          },
          "text": {
            "description": "Whether the bar draws the ATLAS TEXT it composes \u2014 a badge whose icon row carries a Label (LB/RB, LT/RT, LS/RS, the menu trio, the exotics), the active page\u0027s name under the modifier indicators, and the chord-hint lines above them. false drops every label-content badge outright and leaves a purely pictographic bar: every plate, the glyph-content badges (the d-pad arrows and the face-position marks), the bound actions\u0027 icons, and the modifier indicators all still draw.",
            "type": "boolean",
            "default": true
          },
          "hideUnbound": {
            "description": "Whether a slot with no bound act on its bank\u0027s page should not render at all, rather than drawing the DISABLED tier-0 plate. A player\u0027s own BindingBarPreferences.HideUnbound overrides this.",
            "type": "boolean",
            "default": false
          },
          "multiSeatAlpha": {
            "description": "The opacity every joined seat\u0027s bar renders at while two or more seats are joined \u2014 the split-screen quieting lever, multiplied into each bank\u0027s own alpha; 1 keeps multi-seat bars fully opaque.",
            "type": "number",
            "default": 1
          },
          "layout": {
            "description": "The bar\u0027s tuning; null uses Default.",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "buttonSize": {
                "description": "The unscaled slot-plate size.",
                "type": "number"
              },
              "centerGap": {
                "description": "The unscaled extra half-gap between the mirrored clusters.",
                "type": "number"
              },
              "anchorOffsetY": {
                "description": "The anchor\u0027s lift above the viewport\u0027s bottom edge.",
                "type": "number"
              },
              "glyphOffsetRatio": {
                "description": "The gamepad glyph\u0027s corner offset as a fraction of ButtonSize.",
                "type": "number"
              },
              "glyphSizeRatio": {
                "description": "The gamepad glyph\u0027s size as a fraction of ButtonSize.",
                "type": "number"
              },
              "scale": {
                "description": "The uniform cluster scale.",
                "type": "number"
              }
            },
            "required": [
              "buttonSize",
              "centerGap",
              "anchorOffsetY",
              "glyphOffsetRatio",
              "glyphSizeRatio",
              "scale"
            ],
            "additionalProperties": false,
            "default": null
          },
          "visible": {
            "$ref": "./common.schema.json#/$defs/OverlayPredicateNullable",
            "description": "The bar\u0027s visibility condition over presentation facts, or null for always.",
            "default": null
          }
        },
        "required": [
          "slotSet",
          "banks"
        ],
        "additionalProperties": false,
        "default": null
      }
    },
    "required": [
      "id",
      "document"
    ],
    "additionalProperties": false
  },
  "default": null
}
