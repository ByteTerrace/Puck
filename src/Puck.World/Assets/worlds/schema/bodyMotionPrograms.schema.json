{
  "type": [
    "array",
    "null"
  ],
  "items": {
    "description": "An authored fixed-phase body motion program.",
    "type": [
      "object",
      "null"
    ],
    "properties": {
      "name": {
        "description": "The stable name kits use to select the program.",
        "type": "string"
      },
      "version": {
        "description": "The instruction-set version.",
        "type": "string"
      },
      "kind": {
        "description": "The declared program profile that gates operations and registers.",
        "enum": [
          "Motion",
          "Producer",
          null
        ]
      },
      "operations": {
        "description": "The selected domain operations; their phases are intrinsic and cannot be reordered.",
        "type": "array",
        "items": {
          "enum": [
            "SenseNearestInCone",
            "ProduceSteeringIntent",
            "FaceSensorTarget",
            "ProduceFlockIntent",
            "ResolveYawAttitudeAndPlanarFrame",
            "IntegrateLocalAttitude",
            "ComputePlanarTargetVelocity",
            "ComputeLocalTargetVelocity",
            "ShapeVelocity",
            "SnapYawToPlanarIntent",
            "ResolveDriveFrame",
            "ResolveHold",
            "RunActionTriggers",
            "ApplyHold",
            "IntegratePlanarAndVerticalVelocity",
            "IntegrateScratchVelocity",
            "CommitPose",
            "SetVerticalVelocity",
            "ScaleVerticalVelocity",
            "PlanarImpulse",
            "SetState",
            "AddState",
            "StartTimer",
            "Designate",
            "Generate"
          ]
        }
      },
      "target": {
        "description": "The single source supplying the program\u0027s target, when it uses target-aware operations.",
        "type": [
          "object",
          "null"
        ],
        "required": [
          "$type"
        ],
        "anyOf": [
          {
            "properties": {
              "$type": {
                "const": "sensed"
              },
              "scope": {
                "enum": [
                  "Seats",
                  "Bodies"
                ]
              },
              "range": {
                "type": "number"
              },
              "halfAngleDegrees": {
                "type": "number"
              },
              "requiresLineOfSight": {
                "type": "boolean"
              }
            },
            "required": [
              "scope",
              "range",
              "halfAngleDegrees",
              "requiresLineOfSight"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "$type": {
                "const": "designated"
              },
              "register": {
                "type": "string"
              }
            },
            "required": [
              "register"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "$type": {
                "const": "curve"
              },
              "curve": {
                "type": "string"
              },
              "rate": {
                "type": "number"
              }
            },
            "required": [
              "curve",
              "rate"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "$type": {
                "const": "navigated"
              },
              "domain": {
                "type": "string"
              },
              "register": {
                "type": "string"
              }
            },
            "required": [
              "domain",
              "register"
            ],
            "additionalProperties": false
          }
        ],
        "default": null
      }
    },
    "required": [
      "name",
      "version",
      "kind",
      "operations"
    ],
    "additionalProperties": false
  },
  "default": null
}
