      shape Superellipsoid "pelvis" {
        id: 1
        position [0, 1.0215, 0]
        scale [0.195, 0.1425, 0.1475]
        material: charcoal
        exponent: softness
        // The whole body rides the pelvis: it turns its hips into a diagonal (0.7 rad at 45 degrees off the facing,
        // none in a pure strafe or backpedal), trails a turn by 0.12 s of turn rate, and leans about the ground into
        // its planar acceleration, sideways into a curving run and forward into a start.
        swings [
          {
            driver: "gait"
            axis [0, 1, 0]
            amplitude: 0.08
            pivot [0, 1.0765, 0]
            wave: "sine"
            phase: 0
          }
          {
            driver: "run"
            axis [1, 0, 0]
            amplitude: 0.1
            pivot [0, 0, 0]
            wave: "constant"
            phase: 0
          }
          {
            driver: "gait"
            axis [0, 0, 1]
            amplitude: 0.05
            pivot [0, 1.0765, 0]
            wave: "sine"
            phase: 0
          }
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: 0.7
            pivot [0, 1.0765, 0]
            wave: "sine"
          }
          {
            driver: "trail"
            axis [0, 1, 0]
            amplitude: -0.12
            pivot [0, 1.0765, 0]
            wave: "linear"
          }
          {
            driver: "lean"
            axis [0, 0, 1]
            amplitude: -0.016
            pivot [0, 0, 0]
            wave: "linear"
          }
          {
            driver: "surge"
            axis [1, 0, 0]
            amplitude: 0.006
            pivot [0, 0, 0]
            wave: "linear"
          }
        ]
        slides [
          {
            driver: "bob"
            axis [0, 1, 0]
            amplitude: 0.022
            phase: -1.5708
            wave: "sine"
          }
        ]
      }

