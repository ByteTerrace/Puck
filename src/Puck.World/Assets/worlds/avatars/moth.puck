      shape Sweep "thigh-left" {
        id: 174
        position [0.135, 1.0265, 0]
        material: charcoal
        parent: "pelvis"
        curve {
          a [0, 0, 0]
          b [0.025, -0.135, 0]
          c [0.05, -0.285, 0]
          radiusStart: 0.095
          radiusEnd: 0.095
        }
        // The stride swings in the plane of travel: the hip's own turn into the travel direction is undone, the plane
        // is turned to the full travel direction, the leg strides, and both turns are put back. A forward diagonal
        // strides straight ahead of the turned hips, a pure strafe abducts into a sidestep, and a backpedal strides
        // backward.
        swings [
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: 0.7
            pivot [0.145, 1.0265, 0]
            wave: "sine"
          }
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: -0.5
            pivot [0.145, 1.0265, 0]
            wave: "linear"
          }
          {
            driver: "gait"
            axis [1, 0, 0]
            amplitude: 0.7
            pivot [0.145, 1.0265, 0]
            wave: "sine"
            phase: 0
          }
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0.145, 1.0265, 0]
            wave: "linear"
          }
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: -0.7
            pivot [0.145, 1.0265, 0]
            wave: "sine"
          }
          {
            driver: "flight"
            axis [1, 0, 0]
            amplitude: -0.2
            pivot [0.145, 1.0265, 0]
            wave: "linear"
            phase: 0
          }
        ]
      }

