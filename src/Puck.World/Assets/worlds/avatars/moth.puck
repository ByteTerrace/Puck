    name: "legs-front"
    renderHeight: 450
    renderWidth: 320
    rig {
      anchorOp {
        opcode: "anchor"
        subject: worldPoint(point: [48, 1.05, -50])
      }
      fovOp {
        fieldOfViewRadians: 0.62
        opcode: "fov"
      }
      lookAtOp {
        focusDistance: 6
        opcode: "lookAt"
        subject: worldPoint(point: [48, 0.36, -48])
        worldAxes: false
      }
      name: "legs-front"
      operations [
