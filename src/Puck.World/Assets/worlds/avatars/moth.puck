template cameraLayout(name) {
  layout name {
    seatCount: 0
    slots [
      {
        camera: name
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }
}

template fringeChain(chainIdx, baseId, groupIdx, positions, scales) {
  for i in range(0, 10) {
    shape Superellipsoid $"fringe-{chainIdx}-{i}" {
      id: baseId + i
      blend: fringeBlend[i]
      exponent: softness
      group: groupIdx
      material: ink
      parent: "helmet"
      position: positions[i]
      rotation [0, 0, 0, 1]
      scale: scales[i]
      smooth: 0.008
    }
  }
}

template braidChain(chainIdx, baseId, positions, rotations) {
  for i in range(0, 12) {
    shape Superellipsoid $"braid-{chainIdx}-{i}" {
      id: baseId + i
      blend: "Union"
      exponent: softness
      material: ink
      parent: braidParent[i]
      position: positions[i]
      rotation: rotations[i]
      scale [0.014, 0.026, 0.016]
      smooth: 0
    }
  }
}

documentId: "moth-flight-studio"

bindingOverlays [
  {
    document {
      chords [
        {
          chord []
          group: "play"
          page {
            entries [
              {
                channel: "forward"
                scale: 1
                sources [
                  "keyboard.w"
                  "keyboard.arrowUp"
                ]
              }
              {
                channel: "forward"
                scale: -1
                sources [
                  "keyboard.s"
                  "keyboard.arrowDown"
                ]
              }
              {
                channel: "strafe"
                scale: -1
                sources [
                  "keyboard.a"
                ]
              }
              {
                channel: "strafe"
                scale: 1
                sources [
                  "keyboard.d"
                ]
              }
              {
                channel: "turn"
                scale: 1
                sources [
                  "keyboard.arrowLeft"
                ]
              }
              {
                channel: "turn"
                scale: -1
                sources [
                  "keyboard.arrowRight"
                ]
              }
              {
                command: "player.move.strafe"
                sources [
                  "gamepad.leftStick"
                ]
              }
              {
                command: "player.look.steer"
                sources [
                  "gamepad.rightStick"
                ]
              }
              {
                command: "player.look.recenter"
                label: "Recenter"
                sources [
                  "gamepad.rightStickPress"
                ]
              }
              {
                command: "player.orbit"
                sources [
                  "mouse.button1"
                ]
              }
              {
                command: "player.steer"
                label: "Steer"
                sources [
                  "mouse.button2"
                ]
              }
              {
                channel: "flight"
                scale: 1
                sources [
                  "keyboard.f"
                  "gamepad.buttonNorth"
                ]
              }
              {
                channel: "rise"
                scale: 1
                sources [
                  "keyboard.space"
                  "gamepad.buttonSouth"
                ]
              }
              {
                channel: "jump"
                scale: 1
                sources [
                  "keyboard.space"
                  "gamepad.buttonSouth"
                ]
              }
              {
                channel: "rise"
                scale: -1
                sources [
                  "keyboard.controlLeft"
                  "keyboard.controlRight"
                  "gamepad.buttonEast"
                ]
              }
              {
                command: "view.override"
                id: "camera1"
                sources [
                  "keyboard.1"
                ]
                value {
                  kind: "Axis1D"
                  raw [1, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera2"
                sources [
                  "keyboard.2"
                ]
                value {
                  kind: "Axis1D"
                  raw [2, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera3"
                sources [
                  "keyboard.3"
                ]
                value {
                  kind: "Axis1D"
                  raw [3, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera4"
                sources [
                  "keyboard.4"
                ]
                value {
                  kind: "Axis1D"
                  raw [4, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera5"
                sources [
                  "keyboard.5"
                ]
                value {
                  kind: "Axis1D"
                  raw [5, 0, 0, 0]
                }
              }
            ]
            id: "base"
          }
        }
      ]
      modifiers []
      version: "puck.input.bindings.v1"
    }
    id: "bare"
  }
]

bodies {
  capacity: 8
  localSeats: 1
  networkPlayers: 0
  reconnectGraceSeconds: 0
  seatSpawns [
    "stage"
  ]
  sleepAfterSeconds: 0s
}

bodyMotionPrograms [
  {
    kind: Motion
    name: "walk"
    operations [
      ResolveYawAttitudeAndPlanarFrame
      ResolveHold
      ComputePlanarTargetVelocity
      ShapeVelocity
      SnapYawToPlanarIntent
      RunActionTriggers
      ApplyHold
      IntegratePlanarAndVerticalVelocity
      CommitPose
    ]
    planarTarget {
      backward: 0.7
      strafe: 0.85
    }
    version: "puck.body.program.v1"
  }
]

cameras [
  // Eight hero cameras round the shoulders at the hero spawn, at 45-degree steps from the front, tiled by the
  // shoulders-hero layout; each looks down 24 degrees so its frame shows only plain ground behind her.
  {
    name: "shoulders-front"
    renderHeight: 450
    renderWidth: 320
    rig {
      anchorOp {
        opcode: "anchor"
        subject: worldPoint(point: [48, 2.4885, -50.4])
      }
      fovOp {
        fieldOfViewRadians: 0.62
        opcode: "fov"
      }
      lookAtOp {
        focusDistance: 6
        opcode: "lookAt"
        subject: worldPoint(point: [48, 1.42, -48])
        worldAxes: false
      }
      name: "shoulders-front"
      operations [
        anchor(opcode: "anchor", subject: worldPoint(point: [48, 2.4885, -50.4]))
