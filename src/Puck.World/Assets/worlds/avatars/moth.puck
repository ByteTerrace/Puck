render {
    ambientOcclusion: true
    farDistance: 80
    lighting {
        curvature {
            cavity: 0.15
            ink: 0.04
            inkColor: "#241E28"
            inkHigh: 90
            inkLow: 30
            rim: 0.02
        }
        lights [
            directional(direction: [3, 5, -4], color: "#FFF0DC", weight: 0.95, shadows: true, angularRadius: 0.2)
            directional(direction: [-0.7, 0.3, -0.65], color: "#DDE3FF", weight: 0.32)
            hemisphere(color: "#F1E5DE", base: 0.3, gradient: 0.1)
        ]
    }
    renderScale: "Native"
    shadowCrowdRadius: 0
    shadows: "High"
    sky {
        layers [
            gradient(stops: [
                {
                    color: "#8E8AA3"
                    elevation: -1
                }
                {
                    color: "#BDB8C9"
                    elevation: -0.05
                }
                {
                    color: "#E8E3EC"
                    elevation: 0.35
                }
                {
                    color: "#F4EFF2"
                    elevation: 1
                }
            ])
            fog(density: 0.012)
        ]
    }
    upscaleSharpness: 0
    tonemap: "Filmic"
    environment {
        softboxes [
            {
                direction [0.6, 1, -0.5]
                size [0.25, 0.5]
                color: "#FFF1E0"
                weight: 1.8
                blur: 0.15
            }
            {
                direction [-0.6, 0.75, 0.6]
                size [0.24, 0.6]
                color: "#EEE4FF"
                weight: 1
                blur: 0.18
            }
        ]
        horizon {
            low: "#151117"
            high: "#6E6572"
        }
    }
}

rule "airborne-on" {
    when $fact:each:Airborne == 1
    mode: "Edge"
    forEach: "airPose"
    setState(key: "$each", state: "airPose", target: "Self", value: 1)
    setState(key: "$each", state: "airWings", target: "Self", value: 1)
}

rule "airborne-off" {
    when $fact:each:Airborne == 0
    mode: "Edge"
    forEach: "airPose"
    setState(key: "$each", state: "airPose", target: "Self", value: 0)
    setState(key: "$each", state: "airWings", target: "Self", value: 0)
}

rule "blink-close" {
    gate: all(predicates: [
        compareState(comparison: "Equal", key: "$each", state: "blink", value: 0)
        compareState(comparandKey: "$each", comparandState: "blinkAt", comparison: "GreaterOrEqual", state: "$tick")
    ])
    mode: "Level"
    forEach: "blink"
    setState(key: "$each", state: "blink", target: "Self", value: 1)
    schedule blinkAt[$each] in 0.12s
}

rule "blink-open" {
    gate: all(predicates: [
        compareState(comparison: "Equal", key: "$each", state: "blink", value: 1)
        compareState(comparandKey: "$each", comparandState: "blinkAt", comparison: "GreaterOrEqual", state: "$tick")
    ])
    mode: "Level"
    forEach: "blink"
    setState(key: "$each", state: "blink", target: "Self", value: 0)
    generate(row: "blinkRest")
    setState(expression: "$tick + blinkRest", key: "$each", state: "blinkAt", target: "Self")
}

simulation {
    rateHz: 30
}

spawnPoints [
    {
        id: "stage"
        position [0, 0, 0]
        yawDegrees: 0
    }
]

state {
    world [
        {
            cells [
                {
                    dynamics {
                        epochTick: 0
                        row: "flight-pose"
                        v0: "0"
                        y0: "0"
                    }
                    key: "0"
                    value: "0"
                }
            ]
            kind: "Fixed"
            name: "airPose"
        }
        {
            cells [
                {
                    dynamics {
                        epochTick: 0
                        row: "wing-deploy"
                        v0: "0"
                        y0: "0"
                    }
                    key: "0"
                    value: "0"
                }
            ]
            kind: "Fixed"
            name: "airWings"
        }
        {
            cells [
                {
                    key: "0"
                    value: 0
                }
            ]
            kind: "Int"
            name: "blink"
        }
        {
            cells [
                {
                    key: "0"
                    value: 90
                }
            ]
            kind: "Int"
            name: "blinkAt"
        }
        {
            draw {
                generator {
                    bound: 1
                    mode: "WithReplacement"
                    rangeMax: 150
                    rangeMin: 75
                    source: "UniformRange"
                }
                skip: 0
                timing: "Event"
            }
            kind: "Int"
            name: "blinkRest"
            value: 90
        }
    ]
}

