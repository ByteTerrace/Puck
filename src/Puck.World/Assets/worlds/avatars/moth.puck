        operations [
            orbit(distance: 6, opcode: "orbit", pitch: 0.2, pivotOffset: [0, 1.2, 0], yaw: 0)
            lookAt(focusDistance: 6, opcode: "lookAt", subject: reference(), targetOffset: [0, 1.2, 0], worldAxes: true)
            fieldOfView(fieldOfViewRadians: 0.65, opcode: "fov")
        ]
        fovOp {
            fieldOfViewRadians: 0.65
            opcode: "fov"
