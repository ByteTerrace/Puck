        curvature: 0
      }
      {
        position [3.75, 0, 0.84375]
        tangentYaw: 0.358771
        curvature: -0.27363
      }
      {
        position [4.5, 0, 1]
        tangentYaw: 0
        curvature: -0.666667
      }
    ]
  }
]

defaultSeatKit: "walker"

dynamics [
  {
    f: 4
    name: "camera-boom"
    r: 0
    zeta: 1
  }
  {
    f: 3
    name: "flight-pose"
    r: 0.5
    zeta: 0.9
  }
  {
    f: 1.2
    name: "wing-deploy"
    r: 0.2
    zeta: 0.8
  }
  // The moth rig's followers: the turn her hips trail and settle from, and the lean her planar acceleration builds.
  {
    f: 2.2
    name: "body-turn"
    r: 0
    zeta: 0.55
  }
  {
    f: 1.8
    name: "body-lean"
    r: 0
    zeta: 0.75
  }
  // Her pace, the speed her gait curves read, settles without overshoot so a stick sweep eases the stride open.
  {
    f: 3
    name: "gait-pace"
    r: 0
    zeta: 1
  }
]

gravity {
  attractors []
  gravitationalConstant: 0
  isActive: true
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, -18, 0]
}

host {
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  height: 900
  journalDepth: 2000
  presentMode: Vsync
  presentation: Windowed
  surfaceFormat: r8g8b8a8
  targetHertz: 60
  width: 1280
}

kits {
  rows [
    {
      bodyContact: Solid
      bodyMotionProgram: "walk"
      // The capsule stands as tall as the drawn Moth: its 0.35 m spheres span 0 to 2.06 m, the top of the helmet.
      collider: capsule(endpoint: [0, 1.36, 0], radius: 0.35)
      mass: 0
      motion {
        facingSnap: false
        groundStick: 2
        // Flight mode's rows come first and spend flightFuel, so they are offered only while it is switched on: on the
        // ground the rise channel lifts her off, and in the air she hovers and thrusts. Out of flight mode she walks and
        // falls with no hover and no thrust, and jumps instead.
        holds [
          {
            name: "groundFlight"
            bond: Surface
            hold: Gravity
            cone [0, 60]
            reach: 1.2
            forward: Heading
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
            thrust: 1
            spend {
              state: "flightFuel"
              ratePerSecond: 0.001
            }
          }
          {
            name: "ground"
            bond: Surface
            hold: Gravity
            cone [0, 60]
            reach: 1.2
            forward: Heading
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
          }
          {
            name: "flight"
            bond: Free
            hold: Lift
            forward: Heading
            lift: 1
            gravity {
              fall: 46
              rise: 28
            }
            thrust: 1
            spend {
              state: "flightFuel"
              ratePerSecond: 0.001
            }
          }
          {
            name: "fall"
            bond: Free
            hold: Gravity
            forward: Heading
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
          }
        ]
        moveFrame: World
        shaping [
          {
            along {
              engage: 40
              release: 50
            }
            turnScale: 1
          }
        ]
        speed {
          value: 5
        }
        // Knee height: she walks up a kerb or the test room's raised floor; anything taller stops her.
        stepHeight: 0.3
        turn {
          falloff: 1
          maxPitch: 1.2
          pitchRate: 0
          rate: 2.5
        }
      }
      // Out of flight mode, south or space jumps: 5.1 m/s peaks about 1.2 m under the rise the world's 18 m/s² gravity
      // makes of the holds' 28:46 arc, a second press in the air jumps again, and letting go while still rising cuts the
      // arc short. North or F switches flight mode.
      actions {
        jump {
          onPress {
            gate: all(predicates: [
              compareState(state: flightFuel, comparison: Equal, value: 0)
              compareState(state: jumps, comparison: Greater, value: 0)
            ]
            )
            latchSeconds: 0
            effects [
              setVerticalVelocity(velocity: 5.1)
              addState(state: jumps, value: -1)
            ]
          }
          onRelease {
            gate: all(predicates: [
              compareState(state: flightFuel, comparison: Equal, value: 0)
              now(fact: Rising)
            ]
            )
            latchSeconds: 0
            effects [
              scaleVerticalVelocity(factor: 0.45)
            ]
          }
        }
        // A press is counted, then flipped on the next tick whether she stands or flies: on to 1000, or off to 0.
        flight {
          onPress {
            latchSeconds: 0
            effects [
              setState(state: flightPress, value: 1)
            ]
          }
          onFact [
            {
              fact: "Grounded"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Equal, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 1000)
                setState(state: flightPress, value: 0)
              ]
            }
            {
              fact: "Airborne"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Equal, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 1000)
                setState(state: flightPress, value: 0)
              ]
            }
            {
              fact: "Grounded"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Greater, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 0)
                setState(state: flightPress, value: 0)
              ]
            }
            {
              fact: "Airborne"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Greater, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 0)
                setState(state: flightPress, value: 0)
              ]
            }
          ]
        }
      }

      name: "walker"
    }
  ]
}

looks {
  assignment {
    rows [
      "moth"
    ]
    sequence {
      name: "r1"
      offset: 0
      step: 0
    }
  }
  rows [
    {
      motion {
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
        // Lane 1 is the jets: dark out of flight mode, a pilot flame at a fifth when flight mode is on, full burn as she
        // flies. Lane 2 is flight mode itself, the heel and nozzle glows it lights.
        lanes [
          0
          flightMode[$body] * (0.2 + 0.8 * airPose[$body])
          flightMode[$body]
        ]
        poses {
          blink: "state.blink.$body"
        }
      }
      name: "moth"
      scale: 1
      source: creation(prototypeId: moth)
    }
  ]
}

