          "when" [
            "always"
          ]
        }
        // The one stride cycle her feet plant on and every gait driver below rides; its radians per metre fall as her
        // pace rises, so her stride lengthens and her step rate climbs more slowly than her speed.
        {
          name: "stride"
          cadence: 1
          signal: "planarTravel"
          cadenceBy {
            driver: "pace"
            curve: "moth-stride"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        // The stride swings, half their amplitude at a walk and whole at a run.
        {
          name: "gait"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-gait"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        // What only a run has: the forward lean and the bent elbows, and at twice the stride's rate, the bob.
        {
          name: "run"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "bob"
          cadence: 2
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "breath"
          cadence: 1.7
          signal: "time"
          "when" [
            "still"
          ]
        }
        {
          name: "flight"
          cadence: 1
          signal: "state.airPose.$body"
          "when" [
            "always"
          ]
        }
        {
          name: "wings"
          cadence: 1
          signal: "state.airWings.$body"
          "when" [
            "always"
          ]
        }
        {
          name: "bank"
          cadence: 0.26
          signal: "turnRate"
          "when" [
            "Airborne"
          ]
        }
        {
          name: "cruise"
          cadence: 0.18
          signal: "speed"
          "when" [
            "Airborne"
            "moving"
          ]
        }
        // Twice the travel direction off the facing: a sine of it peaks on the diagonals and vanishes on a pure
        // strafe or backpedal, and half of it, linear, is the direction itself.
        {
          name: "heading"
          cadence: 2
          signal: "travelDirection"
          blendInSeconds: 0.12
          blendOutSeconds: 0.3
          "when" [
            "Grounded"
            "moving"
          ]
        }
        // The turn rate through an underdamped response: a part swinging against it trails a turn, catches up a
        // beat after the turn stops and overshoots a little as it settles.
        {
          name: "trail"
          cadence: 1
          signal: "turnRate"
          dynamics: "body-turn"
          "when" [
            "always"
          ]
        }
        {
          name: "lean"
          cadence: 1
          signal: "lateralAcceleration"
          dynamics: "body-lean"
          "when" [
            "Grounded"
          ]
        }
        {
          name: "surge"
          cadence: 1
          signal: "forwardAcceleration"
          dynamics: "body-lean"
          "when" [
            "Grounded"
          ]
        }
      ]
      volumes [
        {
          kind: "flow"
          parent: "nozzle-left"
          position [0, -0.27, 0]
          rotation [0, 0, 0, 1]
          halfExtent [0.2, 0.25, 0.2]
          axis: 0.5
          width: 0.039
          spread: 4
          fade: 1.5
          noiseScale: 0.08
          noiseDepth: 0.4
          speed: 1.5
          seed: 31
          steps: 40
          intensity: 60
          extinction: 1.2
          pulseAmplitude: 0.04
          pulseFrequency: 14
          intensityLane: 1
          ramp [
            {
              density: 0
              color: "#134D8B"
            }
            {
              density: 0.3
              color: "#238EDB"
            }
            {
              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
        {
          kind: "flow"
          parent: "nozzle-right"
          position [0, -0.27, 0]
          rotation [0, 0, 0, 1]
          halfExtent [0.2, 0.25, 0.2]
          axis: 0.5
          width: 0.039
          spread: 4
          fade: 1.5
          noiseScale: 0.08
          noiseDepth: 0.4
          speed: 1.5
          seed: 39
          steps: 40
          intensity: 60
          extinction: 1.2
          pulseAmplitude: 0.04
          pulseFrequency: 14
          intensityLane: 1
          ramp [
            {
              density: 0
              color: "#134D8B"
            }
            {
              density: 0.3
              color: "#238EDB"
            }
            {
              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
      ]
      effectors [
        {
          name: "foot-left"
          chain [
            "thigh-left"
            "shin-left"
          ]
          tip: "boot-left"
          // The sole stays flat on the ground however far the planted boot sits from its rest offset, so the boot
          // centre's rest height is the standoff that puts the whole sole on the surface.
          align: 1
          "when" [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [0, 3.1415925]
            // At rest the boot holds its spot and steps once its stance point drifts 9 cm: turning in place, or
            // settling into the stance after a stop.
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
        {
          name: "foot-right"
          chain [
            "thigh-right"
            "shin-right"
          ]
          tip: "boot-right"
          align: 1
          "when" [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [3.1415925, 6.28]
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
      ]
    }
  }
}

render {
  ambientOcclusion: true
  farDistance: 80
  lighting {
    curvature {
      cavity: 0.15
      ink: 0.04
      inkColor: "#241E28"
      inkHigh: 90
      inkLow: 30
      rim: 0.02
    }
    lights [
      directional(name: "key", direction: [3, 5, -4], color: "#FFF0DC", weight: 0.95, shadow: always, angularRadius: 0.2)
      directional(direction: [-0.7, 0.3, -0.65], color: "#DDE3FF", weight: 0.32)
    ]
  }
  renderScale: 1
  shadowLights: 1
  shadows: High
  sky {
    layers [
      gradient(visibility: camera, stops: [
        {
          color: "#8E8AA3"
          elevation: -1
        }
        {
          color: "#BDB8C9"
          elevation: -0.05
        }
        {
          color: "#E8E3EC"
          elevation: 0.35
        }
        {
          color: "#F4EFF2"
          elevation: 1
        }
      ]
      )
      gradient(name: "studio", visibility: lighting, stops: [{ elevation: -1, color: "#151117" }, { elevation: 1, color: "#6E6572" }])
      panel(name: "panel1", direction: [0.6, 1, -0.5], size: [0.25, 0.5], color: "#FFF1E0", intensity: 1.8, blur: 0.15, visibility: lighting)
      panel(name: "panel2", direction: [-0.6, 0.75, 0.6], size: [0.24, 0.6], color: "#EEE4FF", intensity: 1, blur: 0.18, visibility: lighting)
    ]
  }
  atmosphere {
    fog {
      density: 0.012
    }
  }
  upscaleSharpness: 0
  tonemap: Filmic
  environment {
    ambient: 0.4
    reflection: 1
  }
}

// The flight pose and wings deploy only in flight mode; an ordinary jump keeps her upright.
rule "flight-mode" {
  when channel(1, flight) > 0
  mode: Edge
  flightMode[0] = 1 - flightMode[0]
}

rule "airborne-on" {
  when fact(each, Airborne) == 1 and flightMode[$each] > 0
  mode: Edge
  forEach: airPose
  airPose[$each] = 1
  airWings[$each] = 1
}

rule "airborne-off" {
  when fact(each, Airborne) == 0 or flightMode[$each] == 0
  mode: Edge
  forEach: airPose
  airPose[$each] = 0
  airWings[$each] = 0
}

rule "blink-close" {
  when blink[$each] == 0 and $tick >= blinkAt[$each]
  mode: Level
  forEach: blink
  blink[$each] = 1
  schedule blinkAt[$each] in 0.12s
}

rule "blink-open" {
  when blink[$each] == 1 and $tick >= blinkAt[$each]
  mode: Level
  forEach: blink
  blink[$each] = 0
  generate(row: blinkRest)
  blinkAt[$each] = $tick + blinkRest
}

// The seat camera's feel: pointer orbit at a milliradian a pixel, and the look stick (or a typed player.look) at 2.6
// radians a second at full deflection. Without it every look input turns the camera by zero.
seatDefaults {
  seatCameraFeel {
    invertPitch: false
    invertYaw: false
    pitchSensitivity: 0.001
    stickLookRate: 3.5
    yawSensitivity: 0.001
  }
}

simulation {
  rateHz: 30
}

spawnPoints [
  // A clean stage for inspection shots, 68 m clear of the debug world's test room, cubes, axis markers and portal.
  {
    id: "hero"
    position [48, 0, -48]
    yawDegrees: 0
  }
  {
    id: "stage"
    position [0, 0, 0]
    yawDegrees: 0
  }
]

state {
  // Flight mode is fuel the flight holds spend: 1000 while switched on (it drains a thousandth a second), 0 off, so the
  // hover and thrust rows are offered only in flight mode. Jumps counts the jumps left before landing.
  body [
    {
      name: "flightFuel"
      kind: "Counter"
      initial: 0
    }
    {
      name: "flightPress"
      kind: "Counter"
      initial: 0
    }
    {
      name: "jumps"
      kind: "Counter"
      initial: 2
      resetFact: "Grounded"
    }
  ]

  world {
    row {
      cells [
        {
          dynamics {
            row: "flight-pose"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      name: "airPose"
    }
    row {
      cells [
        {
          dynamics {
            row: "wing-deploy"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      name: "airWings"
    }
    // Flight mode as the look and the flight-pose rules see it: the walker's flightFuel is per-body action state, which
    // world rules and render lanes cannot read, so this row flips on the same flight press.
    table flightMode {
      "0" = 0
    }
    table blink {
      "0" = 0
    }
    table blinkAt {
      "0" = 90
    }
    row {
      draw {
        generator {
          bound: 1
          mode: "WithReplacement"
          rangeMax: 150
          rangeMin: 75
          source: "UniformRange"
        }
        skip: 0
        timing: "Event"
      }
      kind: "Int"
      name: "blinkRest"
      value: 90
    }
  }
}

views {
  // The seat's own camera comes first, so it is what a boot shows; the named inspection cameras follow.
  layout "play" {
    seatCount: 0
    slots [
      {
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  cameraLayout("three-quarter")
  cameraLayout("front")
  cameraLayout("rear")
  cameraLayout("flight-stage")

  cameraLayout("head")
  cameraLayout("face")
  cameraLayout("face-side")
  cameraLayout("shoulder")
  cameraLayout("back-close")
  cameraLayout("shoulder-top")
  cameraLayout("boots")
  cameraLayout("knee")
  cameraLayout("boots-side")
  cameraLayout("boots-rear")

  // The legs from eight sides at once, for judging the greaves and boots against the model sheet.
  layout "legs-hero" {
    seatCount: 0
    slots [
      {
        camera: "legs-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "legs-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "legs-left"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "legs-back-left"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "legs-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "legs-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "legs-right"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "legs-front-right"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  // The shoulders from eight sides at once.
  layout "shoulders-hero" {
    seatCount: 0
    slots [
      {
        camera: "shoulders-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "shoulders-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "shoulders-left"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "shoulders-back-left"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "shoulders-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "shoulders-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "shoulders-right"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "shoulders-front-right"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  layout "pipeline" {
    seatCount: 0
    slots [
      {
        height: 1
        instance: "moth-pipeline"
        width: 0.5
        x: 0
        y: 0
      }
      {
        camera: "three-quarter"
        height: 1
        width: 0.5
        x: 0.5
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  // A dual-stick third-person action camera: the left stick moves and strafes relative to the camera, the right stick
  // turns the camera and the body with it, and the right-stick press recenters it behind the body.
  seatControl {
    maxPitch: 1.2
    minPitch: -0.5
    yawReference: "World"
  }

  seatRig "moth-camera" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 4.2, opcode: "orbit", pitch: 0.3, pivotOffset: [0, 1, 0], yaw: 0)
      lookAt(focusDistance: 4.2, opcode: "lookAt", subject: reference(), targetOffset: [0, 1, 0], worldAxes: true)
      fieldOfView(fieldOfViewRadians: 0.96, opcode: "fov")
      dynamics(row: `camera-boom`)
    ]
    fovOp {
      fieldOfViewRadians: 0.96
      opcode: "fov"
    }
    lookAtOp {
      focusDistance: 4.2
      opcode: "lookAt"
      subject: reference()
      targetOffset [0, 1, 0]
      worldAxes: true
    }
    orbitOp {
      distance: 4.2
      opcode: "orbit"
      pitch: 0.3
      pivotOffset [0, 1, 0]
      yaw: 0
    }
  }

  graph "moth-pipeline" {
    camera: "three-quarter"
    source: "../../pipelines/moth.hlsl"
    timeScale: 1
  }
}
