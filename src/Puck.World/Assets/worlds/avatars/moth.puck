documentId: "moth-flight-studio"

bindingOverlays [
    {
        document {
            chords [
                {
                    chord []
                    group: "play"
                    page {
                        entries [
                            {
                                channel: "forward"
                                scale: 1
                                sources [
                                    "keyboard.w"
                                    "keyboard.arrowUp"
                                ]
                            }
                            {
                                channel: "forward"
                                scale: -1
                                sources [
                                    "keyboard.s"
                                    "keyboard.arrowDown"
                                ]
                            }
                            {
                                channel: "strafe"
                                scale: -1
                                sources [
                                    "keyboard.a"
                                ]
                            }
                            {
                                channel: "strafe"
                                scale: 1
                                sources [
                                    "keyboard.d"
                                ]
                            }
                            {
                                channel: "turn"
                                scale: 1
                                sources [
                                    "keyboard.arrowLeft"
                                ]
                            }
                            {
                                channel: "turn"
                                scale: -1
                                sources [
                                    "keyboard.arrowRight"
                                ]
                            }
                            {
                                command: "player.move.strafe"
                                sources [
                                    "gamepad.leftStick"
                                ]
                            }
                            {
                                command: "player.look.steer"
                                sources [
                                    "gamepad.rightStick"
                                ]
                            }
                            {
                                command: "player.orbit"
                                sources [
                                    "mouse.button1"
                                ]
                            }
                            {
                                command: "player.steer"
                                label: "Steer"
                                sources [
                                    "mouse.button2"
                                ]
                            }
                            {
                                channel: "rise"
                                scale: 1
                                sources [
                                    "keyboard.space"
                                    "gamepad.buttonSouth"
                                ]
                            }
                            {
                                channel: "rise"
                                scale: -1
                                sources [
                                    "keyboard.controlLeft"
                                    "keyboard.controlRight"
                                    "gamepad.buttonEast"
                                ]
                            }
                            {
                                command: "view.override"
                                id: "camera1"
                                sources [
                                    "keyboard.1"
                                ]
                                value {
                                    kind: "Axis1D"
                                    raw [1, 0, 0, 0]
                                }
                            }
                            {
                                command: "view.override"
                                id: "camera2"
                                sources [
                                    "keyboard.2"
                                ]
                                value {
                                    kind: "Axis1D"
                                    raw [2, 0, 0, 0]
                                }
                            }
                            {
                                command: "view.override"
                                id: "camera3"
                                sources [
                                    "keyboard.3"
                                ]
                                value {
                                    kind: "Axis1D"
                                    raw [3, 0, 0, 0]
                                }
                            }
                            {
                                command: "view.override"
                                id: "camera4"
                                sources [
                                    "keyboard.4"
                                ]
                                value {
                                    kind: "Axis1D"
                                    raw [4, 0, 0, 0]
                                }
                            }
                            {
                                command: "view.override"
                                id: "camera5"
                                sources [
                                    "keyboard.5"
                                ]
                                value {
                                    kind: "Axis1D"
                                    raw [5, 0, 0, 0]
                                }
                            }
                        ]
                        id: "base"
                    }
                }
            ]
            modifiers []
            version: "puck.bindings.v1"
        }
        id: "bare"
    }
]

bodies {
    capacity: 8
    localSeats: 1
    networkPlayers: 0
    reconnectGraceSeconds: 0
    seatSpawns [
        "stage"
    ]
    sleepAfterTicks: 0
}

bodyMotionPrograms [
    {
        kind: "Motion"
        name: "walk"
        operations [
            "ResolveYawAttitudeAndPlanarFrame"
            "ResolveHold"
            "ComputePlanarTargetVelocity"
            "ShapeVelocity"
            "SnapYawToPlanarIntent"
            "RunActionTriggers"
            "ApplyHold"
            "IntegratePlanarAndVerticalVelocity"
            "CommitPose"
        ]
        version: "puck.body-motion.v1"
    }
]

