// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

schema: "puck.world.definition.v1"
import "../quality"

// The palette, by role. A slot number says nothing; a name says what the surface IS.
let skin = 0 // #EED3A6
let violet = 1 // #9D66C6
let charcoal = 2 // #252630
let rust = 3 // #B76B3C
let ink = 4 // #171210
let ivory = 5 // #FFF8E9
let cyan = 6 // #2ED6EC
let leather = 7 // #754137
let brass = 8 // #B88335
let umber = 9 // #89481D
let jet = 10 // #120D13
let pearl = 11 // #FFF8EF
let violetBandLeft = 12 // violet under the left shoulder pad's #EED3A6 band
let violetBandRight = 13 // violet under the right shoulder pad's #EED3A6 band
let violetPodLeft = 14 // violet of the left back pod's plates, under its vent and grey plate
let violetPodRight = 15 // violet of the right back pod's plates, under its vent and grey plate
let violetChest = 16 // violet under the breastplate's #EED3A6 lower band
let shinCream = 17 // #EED3A6, the back pods' cream bands
let shinViolet = 18 // #9D66C6 greaves under their #EED3A6 arch band and side panel
let gunmetal = 19 // #43464E heel lens housing and heel block
let steel = 20 // #8B9099 the lens housing's bright ring
let glow = 21 // #D8FDFF the heel lenses' white-hot cores

