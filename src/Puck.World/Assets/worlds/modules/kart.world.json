  "rules": [
    {
      "name": "kart-gate-0",
      "mode": "Edge",
      "gate": {
        "$type": "all",
        "predicates": [
          {
            "$type": "compareState",
            "state": "gateStage",
            "comparison": "Equal",
            "value": 0
          },
          {
            "$type": "compareState",
            "state": "$region:gate0",
            "comparison": "Greater",
            "value": 0
          }
        ]
      },
      "effects": [
        {
          "$type": "addState",
          "state": "gateStage",
          "value": 1
        },
        {
          "$type": "setState",
          "state": "lapStart",
          "expression": "$tick"
        }
      ]
    },
