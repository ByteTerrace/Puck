// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

export action
export binding reached
export read reached, falls

prototypes {
  prototype "jumpDeck" {
    document {
      schema: "puck.creation.v1"
      name: "jumpDeck"
      palette [
        {
          color: "#8C8780"
        }
      ]
      shape Box "deck" {
        position [0, 0.2, 0]
        scale [4, 0.2, 4]
        material: 0
      }
    }
  }

  prototype "jumpPlatform" {
    document {
      schema: "puck.creation.v1"
      name: "jumpPlatform"
      palette [
        {
          color: "#6FA383"
        }
      ]
      shape Box "step" {
        position [0, 0.2, 0]
        scale [1.5, 0.2, 1.5]
        material: 0
      }
    }
  }

  prototype "jumpWall" {
    document {
      schema: "puck.creation.v1"
      name: "jumpWall"
      palette [
        {
          color: "#4E5C55"
        }
      ]
      shape Box "panel" {
        position [0, 3, 0]
        scale [0.15, 3, 2]
        material: 0
      }
    }
  }

  prototype "jumpTrophy" {
    document {
      schema: "puck.creation.v1"
      name: "jumpTrophy"
      palette [
        {
          color: "#4A4A52"
        }
        {
          color: "#FFD24C"
          emissive: 0.6
        }
      ]
      shape Box "pedestal" {
        position [0, 0.3, 0]
        scale [0.5, 0.3, 0.5]
        material: 0
      }

      shape Sphere "prize" {
        position [0, 0.95, 0]
        scale [0.35, 0.35, 0.35]
        material: 1
      }
    }
  }

  prototype "jumpFallMarker" {
    document {
      schema: "puck.creation.v1"
      name: "jumpFallMarker"
      palette [
        {
          color: "#B23A3A"
        }
      ]
      shape Box "net" {
        position [0, 0.05, 0]
        scale [20, 0.05, 20]
        material: 0
      }
    }
  }
}

placements {
  placement "jumpCourt" {
    prototype: "jumpDeck"
    position [0, 0, 0]
    solid
  }

  placement "platform1" {
    prototype: "jumpPlatform"
    position [0, 2, -6]
    parent: "jumpCourt"
    solid
  }

  placement "wallSegment" {
    prototype: "jumpWall"
    position [3.4, 4, -12]
    parent: "jumpCourt"
    solid
  }

  placement "platform2" {
    prototype: "jumpPlatform"
    position [1.5, 4, -12]
    parent: "jumpCourt"
    solid
  }

  placement "platform3" {
    prototype: "jumpPlatform"
    position [0, 6, -18]
    parent: "jumpCourt"
    solid
  }

  placement "platform4" {
    prototype: "jumpPlatform"
    position [0, 8, -24]
    parent: "jumpCourt"
    solid
  }

  placement "jumpTrophy" {
    prototype: "jumpTrophy"
    position [6, 3, -10]
    parent: "jumpCourt"
    region {
      radius: 1.2
    }
  }

  placement "jumpFallZone" {
    prototype: "jumpFallMarker"
    position [0, -6, -12]
    parent: "jumpCourt"
    region {
      radius: 20
    }
  }
}

spawnPoints [
  {
    id: "jump-arrival"
    position [0, 0.4, 3]
    yawDegrees: 0
  }
]

navigation {
  domains [
    {
      name: "jumpSurface"
      kind: Surface
      origin [-8, 4, -28]
      cellSize: 1
      width: 24
      depth: 32
      layers: 1
      agentRadius: 0.35
      agentHeight: 1.2
      arrivalDistance: 0.5
      maxExpandedNodes: 512
      maxPathNodes: 128
      probeUp: 8
      probeDown: 6
      maxStepHeight: 0.6
      maxSlopeDegrees: 55
    }
  ]
}

state {
  world {
    slot reached = 0 bounds(0..)

    slot falls = 0 bounds(0..)
  }

  body [
    {
      name: "jumpCounter"
      kind: "Counter"
      initial: 0
      resetFact: "Grounded"
    }
  ]
}

rule "jumpFallsCounter" {
  when region(jumpFallZone) > 0
  mode: Edge
  falls += 1
}

rule "jumpTrophyReached" {
  when region(jumpTrophy) > 0
  mode: Edge
  reached = 1
}

bodyMotionPrograms [
  {
    name: "vaultMotion"
    version: "puck.body.program.v1"
    kind: Motion
    operations [ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
  }
]

kits {
  rows [
    {
      name: "vaulter"
      bodyContact: Solid
      bodyMotionProgram: "vaultMotion"
      collider: capsule(endpoint: [0, 1, 0], radius: 0.35)
      motion {
        facingSnap: false
        holds [
          {
            name: "ledge"
            bond: Surface
            cone [112, 150]
            hold: Pull
            pull: 1.2
            reach: 1
            upLean: 0.7
            speed: 1.6
            forward: Heading
            release: "jump"
          }
          {
            name: "wall"
            bond: Surface
            cone [65, 110]
            hold: Pull
            pull: 1
            reach: 0.8
            upLean: 0
            speed: 2
            forward: Heading
            onDrive: true
            driveAlignment: 0.5
            release: "jump"
          }
          {
            name: "ground"
            bond: Surface
            cone [0, 60]
            hold: Gravity
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
            reach: 1.2
            thrust: 0.6
          }
          {
            name: "air"
            bond: Free
            hold: Gravity
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
            thrust: 0.6
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 5
        }
        turn {
          rate: 2.5
        }
      }
      actions {
        jump {
          onPress {
            gate: compareState(state: jumpCounter, comparison: Less, value: 2)
            latchSeconds: 0.1
            effects [
              setVerticalVelocity(velocity: 11)
              addState(state: jumpCounter, value: 1)
            ]
          }
          onRelease {
            gate: now(fact: Rising)
            latchSeconds: 0
            effects [
              scaleVerticalVelocity(factor: 0.45)
            ]
          }
        }
      }
    }
  ]
}
