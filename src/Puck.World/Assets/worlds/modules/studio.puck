// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

export action look
export binding look
export read look, studioTurntable

prototypes {
  prototype "studioStage" {
    document {
      schema: "puck.creation.v1"
      name: "studioStage"
      palette [
        {
          color: "#3A3A42"
        }
        {
          color: "#C7B36A"
        }
      ]
      shape Box {
        position [0, -0.2, 0]
        scale [8, 0.4, 8]
        material: 0
      }

      shape Cylinder {
        position [0, 0.03, 0]
        scale [1.4, 0.06, 1.4]
        material: 1
      }
    }
  }

  prototype "studioTurntableMarker" {
    document {
      schema: "puck.creation.v1"
      name: "studioTurntableMarker"
      shapes []
    }
  }

  prototype "studioMirrorWall" {
    document {
      schema: "puck.creation.v1"
      name: "studioMirrorWall"
      palette [
        {
          color: "#DDE8EA"
        }
      ]
      shape Box {
        position [0, 0, 0]
        scale [2.4, 2.4, 0.12]
        material: 0
      }
      behavior {
        faces [
          {
            name: "mirror"
            shapeId: 0
            defaultSource: null
          }
        ]
      }
    }
  }

  prototype "studioGateClosed" {
    document {
      schema: "puck.creation.v1"
      name: "studioGateClosed"
      palette [
        {
          color: "#4A3F52"
        }
      ]
      shape Box {
        position [0, 0, 0]
        scale [2.4, 2.2, 0.15]
        material: 0
      }
    }
  }

  prototype "studioGateOpen" {
    document {
      schema: "puck.creation.v1"
      name: "studioGateOpen"
      shapes []
    }
  }
}

placements {
  placement "studioCourt" {
    prototype: "studioStage"
    position [0, 0, 0]
    solid
  }

  placement "studioTurntable" {
    prototype: "studioTurntableMarker"
    parent: "studioCourt"
    position [0, 0, 0]
    region {
      radius: 1.6
    }
  }

  placement "studioMirror" {
    prototype: "studioMirrorWall"
    parent: "studioCourt"
    position [0, 1.4, -3.6]
    yawDegrees: 180deg
    faceSources [
      {
        face: "mirror"
        source: view(cameraName: "studioStage")
      }
    ]
    solid
  }

  placement "studioGate" {
    prototype: "studioGateClosed"
    parent: "studioCourt"
    position [0, 1.1, 3.6]
    respond [
      {
        "when": state(state: identity, key: `0-awakened`, comparison: GreaterOrEqual, value: 1)
        prototypeId: "studioGateOpen"
      }
      {
        "when": state(state: identity, key: `1-awakened`, comparison: GreaterOrEqual, value: 1)
        prototypeId: "studioGateOpen"
      }
    ]
    solid
  }
}

cameras [
  {
    name: "studioStage"
    anchor: null
    rig {
      name: "studioStage"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: placement(placementId: studioTurntable))
        offset(value: [0, 1.6, 3.2])
        lookAt(subject: placement(placementId: studioTurntable), targetOffset: [0, 1, 0])
        fieldOfView(fieldOfViewRadians: 0.9)
      ]
    }
    renderWidth: 512
    renderHeight: 512
  }
]

navigation {
  domains [
    {
      name: "studioFloor"
      kind: Surface
      origin [-5, -1, -5]
      cellSize: 0.5
      width: 20
      depth: 20
      agentRadius: 0.3
      agentHeight: 1.6
      arrivalDistance: 0.4
      maxExpandedNodes: 320
      maxPathNodes: 64
      maxStepHeight: 0.4
      maxSlopeDegrees: 50
      probeUp: 2
      probeDown: 2
    }
  ]
}

spawnPoints [
  {
    id: "studio-arrival"
    position [0, 0, 0]
    yawDegrees: 0
  }
]

state {
  world {
    slot look = 0 bounds(0..7)
  }
}

rule "studio-look-cycle" {
  when region(studioTurntable) >= 1 and channel(1, jump) >= 1
  mode: Edge
  look = (look + 1) % 8
  setIdentityFact(key: 0, fact: "awakened", value: 1)
}
