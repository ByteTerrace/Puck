<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Carriage</AssemblyName>
        <Description>The signed-carriage envelope: issuer-signed claims that travel between federated worlds and verify offline against an authored trust list. Canonical CBOR byte layout, chain walk with depth and window enforcement, purpose and domain binding, replay marks, and sealed carriages with bound encryption.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Carriage</PackageId>
        <PackageTags>cbor;claims;federation;offline-verification;signing</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Leaf contracts and data</PuckLayer>
        <RootNamespace>Puck.Carriage</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System.Formats.Cbor" Version="[9.*, )" />
    </ItemGroup>
</Project>
