<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Cli</AssemblyName>
        <!-- Roslyn workspace loading and BenchmarkDotNet require runtime code generation. -->
        <IsAotCompatible>false</IsAotCompatible>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>puck</ToolCommandName>
        <PackageId>ByteTerrace.Puck.Cli</PackageId>
        <Description>Puck developer tools: source analysis, world authoring, build automation, and shared-version NuGet releases.</Description>
        <PackageTags>puck;cli;dotnet-tool;development;nuget</PackageTags>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <OutputType>Exe</OutputType>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>
    <!-- The puck root composes one command tree from the verb assemblies (PuckRootCommand); each assembly references only
         what its own verbs need, so a change reaches the suites of the verbs it can change and no others. -->
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Bench/Puck.Cli.Bench.csproj" />
        <ProjectReference Include="../Puck.Cli.Content/Puck.Cli.Content.csproj" />
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
        <ProjectReference Include="../Puck.Cli.Format/Puck.Cli.Format.csproj" />
        <ProjectReference Include="../Puck.Cli.Gate/Puck.Cli.Gate.csproj" />
        <ProjectReference Include="../Puck.Cli.Harness/Puck.Cli.Harness.csproj" />
        <ProjectReference Include="../Puck.Cli.Laws/Puck.Cli.Laws.csproj" />
        <ProjectReference Include="../Puck.Cli.Release/Puck.Cli.Release.csproj" />
        <ProjectReference Include="../Puck.Cli.Runs/Puck.Cli.Runs.csproj" />
        <ProjectReference Include="../Puck.Cli.Shaders/Puck.Cli.Shaders.csproj" />
        <ProjectReference Include="../Puck.Cli.Source/Puck.Cli.Source.csproj" />
        <ProjectReference Include="../Puck.Cli.Worktrees/Puck.Cli.Worktrees.csproj" />
        <ProjectReference Include="../Puck.Cli.Worlds/Puck.Cli.Worlds.csproj" />
    </ItemGroup>
    <Target Name="PublishPuckLauncher" AfterTargets="Publish">
        <Copy
            Condition="'$(OS)' == 'Windows_NT'"
            DestinationFiles="$(PublishDir)puck.exe"
            SourceFiles="$(PublishDir)$(AssemblyName).exe"
        />
        <Copy
            Condition="'$(OS)' != 'Windows_NT'"
            DestinationFiles="$(PublishDir)puck"
            SourceFiles="$(PublishDir)$(AssemblyName)"
        />
    </Target>
</Project>
