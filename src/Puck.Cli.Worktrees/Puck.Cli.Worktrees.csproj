<Project Sdk="Microsoft.NET.Sdk">
    <!-- The worktree verbs (`puck worktree-base`, `puck worktree-report`). -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Worktrees</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
    </ItemGroup>
</Project>