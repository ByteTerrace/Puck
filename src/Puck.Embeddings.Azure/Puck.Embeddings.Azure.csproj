<Project Sdk="Microsoft.NET.Sdk">
    <!-- The Azure OpenAI embedding provider: an IEmbeddingGenerator over an Azure OpenAI deployment, authenticated by an
         Azure token credential. World hosts reach it through Puck.World.Azure's embedding provider type; the CLI's
         embed verb references it as a tool. -->
    <PropertyGroup>
        <AssemblyName>Puck.Embeddings.Azure</AssemblyName>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
        <PuckProvider>Azure</PuckProvider>
        <RootNamespace>Puck.Embeddings.Azure</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="[10.*, )" />
        <ProjectReference Include="../Puck.Embeddings/Puck.Embeddings.csproj" />
    </ItemGroup>
</Project>
