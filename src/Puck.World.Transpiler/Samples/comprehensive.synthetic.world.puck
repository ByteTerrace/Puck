schema: "puck.world.definition.v1"
basis: "worlds/base"
documentId: "comprehensive-synthetic-v1"

// Compile-time constants
let defaultGravity = [0, -9.81, 0]
let tickRate = 0.25s
let targetFps = 60hz
let turnAngle = 45deg
let zeroAngle = 0rad
let feltColor = #1b4d3e
let accentColor = #ffaa00ff
let doubleFps = 60 * 2

// Module imports
import "extensions/rules.world.puck" as rules
import "modules/arcade"

// Parametric templates
template seatRigPreset(rigName, angle = 0rad, dist = 2.5m) {
  seatRig rigName {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: dist, pitch: angle, yaw: 0)
      fieldOfView(fieldOfViewRadians: 0.001)
    ]
  }
}

// Host settings block
host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 720
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: Windowed
  surfaceFormat: r8g8b8a8
  targetHertz: targetFps
  width: 1280
}

// Views section
views {
  layout "arena" {
    seatCount: 2
    slots [
      {
        camera: null
        height: 1
        pipeline: "moth-pipeline"
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: tickRate
  }

  seatControl {
    maxPitch: 0.01
    minPitch: -0.01
    yawReference: "World"
  }

  seatRigPreset("pilot", turnAngle, 2.5m)

  pipeline "moth-pipeline" {
    camera: null
    source: "../pipelines/moth.hlsl"
    timeScale: 1
  }
}

// Addon with auto-hashing
addon "rules-engine" {
  modulePath: "addons/rules.wasm"
  fuel: 1000000
  enabled: true
  hash: "auto"
}

// State catalog with world cells
state {
  world [
    {
      name: "tableState"
      kind: "Int"
      capacity: 4
      cells [
        {
          key: "activeRound"
          value: 1
        }
        {
          key: "locked"
          value: 0
        }
        {
          key: "busy"
          value: 0
        }
        {
          key: "choice"
          value: 0
        }
      ]
    }
    {
      name: "tableText"
      kind: "Text"
      capacity: 2
      cells [
        {
          key: "feltColor"
          value: feltColor
        }
        {
          key: "status"
          value: "idle"
        }
      ]
    }
    {
      name: "seat"
      kind: "Int"
      capacity: 2
      cells [
        {
          key: "occupied"
          value: 0
        }
      ]
    }
  ]
}

// Prototypes: `prototype "<id>" { document { } }` rows, each a creation document authored with
// `shape <Type> "<name>" { }` rows and the canonicalizer's own defaults elided.
prototypes {
  prototype "tableTop" {
    document {
      schema: "puck.creation.v1"

      shape Box "felt" {
        material: 0
        position [0, -1, 0]
        scale [24, 0.5, 24]
      }

      shape Cylinder "post" {
        material: 1
        position [0, 0, 0]
        smooth: 0.25
      }
    }
  }

  prototype "seat" {
    document {
      schema: "puck.creation.v1"

      shape Cylinder "stool" {
        material: 1
        position [0, 0, 0]
        scale [0.5, 0.5, 0.5]
      }
    }
  }
}

// Placements: `placement "<id>" { }` rows, with `prototype:` and the bare `solid` flag.
placements {
  placement "table" {
    prototype: tableTop
    position [0, 0, 0]
    yawDegrees: 45deg
    solid
  }

  placement "stool" {
    prototype: seat
    parent: table
    position [2, 0, 0]
    scale: 2
  }
}

// Rules: an infix `when` gate, effect statements, and a decision with one scored option.
rule "advance-round" {
  when tableState[activeRound] < 8 and not tableState[locked] == 1
  mode: Edge
  local remainingRounds = 8 - tableState[activeRound]
  tableState[activeRound] += 1
  schedule tableState[settle] in 0.25s
  transaction {
    tableState[busy] = 1
    tableText[status] = "dealing"
  } onFailure {
    tableState[busy] = 0
  }
}

rule "choose-seat" {
  forEach: seat
  decision {
    periodSeconds: 1s
    commitmentSeconds: 3s
    seed: 11
    option "hold" {
      when tableState[activeRound] >= 1
      score: 2.0
      tableState[choice] = 1
    }
  }
}
