state {
  spaces {
    space lore {
      model: "puck-fixture"
      revision: "1"
      dimensions: 256
    }
  }
  world {
    table said capacity(32) evicts
    table saidVectors capacity(32) evicts
    table saidStatus capacity(32) evicts
    table intents embeds(intentVectors) {
      directions = "Where is the road north?"
      rumours = "Have you heard anything strange lately?"
      threat = "Hand over your coin or else"
    }
    table answers {
      directions = "Follow the river until the old mill."
      rumours = "Lights in the marsh, three nights running."
      threat = "Guards!"
    }
    slot heard = ""
  }
}

rule "understand" {
  forEach: saidStatus
  mode: Edge
  when saidStatus[$each] == 3
  transform nearest(from: intentVectors, query: saidVectors[$each], into: heard, k: 1, threshold: 0.6)
}
