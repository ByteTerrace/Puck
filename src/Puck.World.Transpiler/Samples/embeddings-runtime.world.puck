schema: "puck.world.definition.v1"

state {
  spaces {
    space lore {
      model: "puck-fixture"
      revision: "1"
      dimensions: 256
    }
  }
  world {
    // A table with no cells infers Int, so the Text request table a runtime embedding connection
    // reads is spelled as an explicit row.
    row {
      name: "said"
      kind: "Text"
      capacity: 32
      evicts: true
    }
    table saidVectors capacity(32) evicts space(lore)
    table saidStatus capacity(32) evicts
    table intents embeds(intentVectors) {
      directions = "Where is the road north?"
      rumours = "Have you heard anything strange lately?"
      threat = "Hand over your coin or else"
    }
    table answers {
      directions = "Follow the river until the old mill."
      rumours = "Lights in the marsh, three nights running."
      threat = "Guards!"
    }
    slot heard = ""
  }
}

rule "understand" {
  forEach: saidStatus
  mode: Edge
  when saidStatus[$each] == 3
  transform nearest(from: intentVectors, query: saidVectors[$each], into: heard, k: 1, threshold: 0.6)
}
