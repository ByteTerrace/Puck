<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.State.Rules</AssemblyName>
        <!-- The gallery card truncates, so the first sentence has to stand alone; the detail follows it. -->
        <Description>The rule compiler of a deterministic fixed-step simulation: authored rules lower to compiled gates, effects, and expression programs over a Puck.State arena, addressed by row ordinal and interned cell key rather than by name. A rule's compiled form carries the facets its facts declare, so a host is admitted or refused by capability before it ever evaluates, and the same document compiles to the same program on every host and backend. Licensed under the Apache License 2.0.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.State.Rules</PackageId>
        <PackageTags>compiler;determinism;rules;simulation;state</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
        <RootNamespace>Puck.State.Rules</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- Puck.State carries the arena, the catalog, the authored rule vocabulary, the expression IR and its
             runtime; Puck.Maths carries the Q48.16 carrier and the tick conversion every duration rides;
             Puck.State.Generators carries the draw engine the generate effect dispatches to; Puck.State.Topology
             carries the board queries and pattern walk the match/board operands dispatch to; Puck.State.Vectors
             carries the mix, mean, nearest and remember kernels the four vector transforms dispatch to. Nothing
             else, and nothing points back. -->
        <ProjectReference Include="..\Puck.Maths\Puck.Maths.csproj" />
        <ProjectReference Include="..\Puck.State\Puck.State.csproj" />
        <ProjectReference Include="..\Puck.State.Generators\Puck.State.Generators.csproj" />
        <ProjectReference Include="..\Puck.State.Topology\Puck.State.Topology.csproj" />
        <ProjectReference Include="..\Puck.State.Vectors\Puck.State.Vectors.csproj" />
    </ItemGroup>
</Project>
