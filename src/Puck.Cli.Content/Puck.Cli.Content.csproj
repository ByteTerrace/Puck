<Project Sdk="Microsoft.NET.Sdk">
    <!-- The checked-in content generators: branding, firmware, cartridge-cost, font-atlas and wasm-stdlib. -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Content</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
        <ProjectReference Include="../Puck.AdvancedGamingBrick.Forge/Puck.AdvancedGamingBrick.Forge.csproj" />
        <ProjectReference Include="../Puck.Assets/Puck.Assets.csproj" />
        <ProjectReference Include="../Puck.HumbleGamingBrick.Forge/Puck.HumbleGamingBrick.Forge.csproj" />
        <ProjectReference Include="../Puck.Scripting/Puck.Scripting.csproj" />
        <ProjectReference Include="../Puck.Text/Puck.Text.csproj" />
    </ItemGroup>
</Project>