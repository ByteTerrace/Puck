inputHold {
  ceilingSeconds: 0.5
  lowerAfterSeconds: 0.25
  defaultSeconds: 0
  equalizeByDefault: true
  participants []
}

rule "solitaireKlondike-new-deal" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: action)
    any(predicates: [
      compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: option)
      compareState(state: solitaireKlondike, comparison: Equal, value: 3, key: option)
    ]
    )
  ]
  )
  mode: Level
  setState(state: solitaireKlondike, value: null, target: Self, key: activeOption, expression: solitaireKlondike[option])
  setState(state: solitaireKlondike, value: 1, target: Self, key: stage)
  setState(state: solitaireKlondike, value: 0, target: Self, key: status)
  setState(state: solitaireKlondike, value: 0, target: Self, key: result)
  setState(state: solitaireKlondike, value: 1, target: Self, key: busy)
}

rule "solitaireKlondike-gather" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 1 and count($zones[solitaireKlondike[gatherStep]]) > 0
  mode: Level
  zones [solitaireKlondikePile1, solitaireKlondikePile2, solitaireKlondikePile3, solitaireKlondikePile4, solitaireKlondikePile5, solitaireKlondikePile6, solitaireKlondikePile7, solitaireKlondikePile8, solitaireKlondikePile10, solitaireKlondikePile11, solitaireKlondikePile12, solitaireKlondikePile13]
  transform transfer(from: $zones[solitaireKlondike[gatherStep]], to: solitaireKlondikePile0, selector: Slice, key: zone($zones[solitaireKlondike[gatherStep]], first), insertFirst: false, draw: null, count: 1)
}

rule "solitaireKlondike-attributes-start" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 1 and solitaireKlondike[gatherStep] == 11 and count(solitaireKlondikePile0) == 52
  mode: Level
  setState(state: solitaireKlondike, value: 5, target: Self, key: stage)
}

rule "solitaireKlondike-reset-attributes" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 5
  mode: Level
  setState(state: solitaireKlondikeFace, value: 0, target: Self, key: solitaireKlondike[attributeStep])
}

rule "solitaireKlondike-shuffle" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 5 and solitaireKlondike[attributeStep] == 51
  mode: Level
  transaction {
    shuffle solitaireKlondikePile0 with solitaireKlondikeStream
    setState(state: solitaireKlondike, value: 3, target: Self, key: stage)
  }
}

rule "solitaireKlondike-deal" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 3 and solitaireKlondike[dealStep] <= 27
  mode: Level
  zones [solitaireKlondikePile0, solitaireKlondikePile1, solitaireKlondikePile2, solitaireKlondikePile3, solitaireKlondikePile4, solitaireKlondikePile5, solitaireKlondikePile6, solitaireKlondikePile7, solitaireKlondikePile8, "", solitaireKlondikePile10, solitaireKlondikePile11, solitaireKlondikePile12, solitaireKlondikePile13]
  deal 1 from solitaireKlondikePile0 to $zones[solitaireKlondike[dealStep] < 7 ? 2 + solitaireKlondike[dealStep] : solitaireKlondike[dealStep] < 13 ? solitaireKlondike[dealStep] - 4 : solitaireKlondike[dealStep] < 18 ? solitaireKlondike[dealStep] - 9 : solitaireKlondike[dealStep] < 22 ? solitaireKlondike[dealStep] - 13 : solitaireKlondike[dealStep] < 25 ? solitaireKlondike[dealStep] - 16 : solitaireKlondike[dealStep] < 27 ? solitaireKlondike[dealStep] - 18 : 8]
}

rule "solitaireKlondike-deal-finish" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 3 and solitaireKlondike[dealStep] == 27
  mode: Level
  transaction {
    setState(state: solitaireKlondike, value: 0, target: Self, key: stage)
    setState(state: solitaireKlondike, value: 1, target: Self, key: status)
    setState(state: solitaireKlondike, value: 0, target: Self, key: moves)
    setState(state: solitaireKlondike, value: 0, target: Self, key: score)
    setState(state: solitaireKlondike, value: 0, target: Self, key: passes)
    setState(state: solitaireKlondike, value: null, target: Self, key: deals, expression: solitaireKlondike[deals] + 1)
    setState(state: solitaireKlondike, value: 1, target: Self, key: result)
    setState(state: solitaireKlondike, value: null, target: Self, key: applied, expression: solitaireKlondike[request])
  }
}

rule "solitaireKlondike-prepare-move" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 2, key: action)
  ]
  )
  mode: Level
  setState(state: solitaireKlondike, value: 0, target: Self, key: sourceOk)
  setState(state: solitaireKlondike, value: 0, target: Self, key: targetOk)
  setState(state: solitaireKlondike, value: 0, target: Self, key: runLength)
}

rule "solitaireKlondike-source" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 2, key: action)
    compareState(state: $zones[solitaireKlondike[from]], comparison: Equal, value: 1, key: solitaireKlondike[card])
  ]
  )
  mode: Level
  zones ["", "", solitaireKlondikePile2, solitaireKlondikePile3, solitaireKlondikePile4, solitaireKlondikePile5, solitaireKlondikePile6, solitaireKlondikePile7, solitaireKlondikePile8]
  setState(state: solitaireKlondike, value: null, target: Self, key: sourceOk, expression: match(solitaireKlondikeRun, $zones[solitaireKlondike[from]])[solitaireKlondike[card]])
  setState(state: solitaireKlondike, value: null, target: Self, key: runLength, expression: match(solitaireKlondikeLength, $zones[solitaireKlondike[from]], prefix)[solitaireKlondike[card]])
}

rule "solitaireKlondike-source-1" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 2, key: action)
    compareState(state: $zones[solitaireKlondike[from]], comparison: Equal, value: 1, key: solitaireKlondike[card])
  ]
  )
  mode: Level
  zones ["", solitaireKlondikePile1, "", "", "", "", "", "", "", "", solitaireKlondikePile10, solitaireKlondikePile11, solitaireKlondikePile12, solitaireKlondikePile13]
  setState(state: solitaireKlondike, value: null, target: Self, key: sourceOk, expression: match(solitaireKlondikeSingle, $zones[solitaireKlondike[from]])[solitaireKlondike[card]])
  setState(state: solitaireKlondike, value: null, target: Self, key: runLength, expression: match(solitaireKlondikeLength, $zones[solitaireKlondike[from]], prefix)[solitaireKlondike[card]])
}

rule "solitaireKlondike-target" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 2, key: action)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: sourceOk)
  ]
  )
  mode: Level
  zones ["", "", solitaireKlondikePile2, solitaireKlondikePile3, solitaireKlondikePile4, solitaireKlondikePile5, solitaireKlondikePile6, solitaireKlondikePile7, solitaireKlondikePile8]
  setState(state: solitaireKlondike, value: null, target: Self, key: targetOk, expression: count($zones[solitaireKlondike[to]]) == 0 ? solitaireKlondikeRank[solitaireKlondike[card]] == 13 : match(solitaireKlondikeLanding, $zones[solitaireKlondike[to]]))
}

rule "solitaireKlondike-target-10" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 2, key: action)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: sourceOk)
  ]
  )
  mode: Level
  zones ["", "", "", "", "", "", "", "", "", "", solitaireKlondikePile10, solitaireKlondikePile11, solitaireKlondikePile12, solitaireKlondikePile13]
  setState(state: solitaireKlondike, value: null, target: Self, key: targetOk, expression: (solitaireKlondike[runLength] == 1) * (solitaireKlondikeSuit[solitaireKlondike[card]] == solitaireKlondike[to] - 10) * (solitaireKlondikeRank[solitaireKlondike[card]] == count($zones[solitaireKlondike[to]]) + 1))
}

rule "solitaireKlondike-move" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 2, key: action)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: sourceOk)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: targetOk)
    compareValue(left: solitaireKlondike[from], comparison: NotEqual, right: solitaireKlondike[to], kind: Int)
  ]
  )
  mode: Level
  zones [solitaireKlondikePile0, solitaireKlondikePile1, solitaireKlondikePile2, solitaireKlondikePile3, solitaireKlondikePile4, solitaireKlondikePile5, solitaireKlondikePile6, solitaireKlondikePile7, solitaireKlondikePile8, "", solitaireKlondikePile10, solitaireKlondikePile11, solitaireKlondikePile12, solitaireKlondikePile13]
  transaction {
    transform transfer(from: $zones[solitaireKlondike[from]], to: $zones[solitaireKlondike[to]], selector: Slice, key: solitaireKlondike[card], insertFirst: false, draw: null, count: 1)
    setState(state: solitaireKlondike, value: null, target: Self, key: moves, expression: solitaireKlondike[moves] + 1)
    setState(state: solitaireKlondike, value: 1, target: Self, key: busy)
    setState(state: solitaireKlondike, value: null, target: Self, key: score, expression: maximum(0, solitaireKlondike[score] + (solitaireKlondike[to] >= 10 ? 10 : solitaireKlondike[from] >= 10 ? -15 : solitaireKlondike[from] == 1 ? 5 : 0)))
    setState(state: solitaireKlondike, value: 1, target: Self, key: result)
    setState(state: solitaireKlondike, value: null, target: Self, key: applied, expression: solitaireKlondike[request])
  }
}

rule "solitaireKlondike-draw-start" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 3, key: action)
    compareState(state: count(solitaireKlondikePile0), comparison: Greater, value: 0)
  ]
  )
  mode: Level
  transaction {
    setState(state: solitaireKlondike, value: 4, target: Self, key: stage)
    setState(state: solitaireKlondike, value: null, target: Self, key: drawLeft, expression: minimum(solitaireKlondike[activeOption], count(solitaireKlondikePile0)))
    setState(state: solitaireKlondike, value: 1, target: Self, key: busy)
  }
}

rule "solitaireKlondike-draw-card" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 4
  mode: Level
  transaction {
    setState(state: solitaireKlondikeFace, value: 1, target: Self, key: zone(solitaireKlondikePile0, first))
    deal 1 from solitaireKlondikePile0 to solitaireKlondikePile1
    setState(state: solitaireKlondike, value: null, target: Self, key: drawLeft, expression: solitaireKlondike[drawLeft] - 1)
  }
}

rule "solitaireKlondike-draw-finish" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 4 and solitaireKlondike[drawLeft] == 0
  mode: Level
  transaction {
    setState(state: solitaireKlondike, value: 0, target: Self, key: stage)
    setState(state: solitaireKlondike, value: null, target: Self, key: moves, expression: solitaireKlondike[moves] + 1)
    setState(state: solitaireKlondike, value: 1, target: Self, key: result)
    setState(state: solitaireKlondike, value: null, target: Self, key: applied, expression: solitaireKlondike[request])
  }
}

rule "solitaireKlondike-recycle-start" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
    compareState(state: solitaireKlondike, comparison: Equal, value: 1, key: status)
    compareState(state: solitaireKlondike, comparison: Equal, value: 3, key: action)
    compareState(state: count(solitaireKlondikePile0), comparison: Equal, value: 0)
    compareState(state: count(solitaireKlondikePile1), comparison: Greater, value: 0)
  ]
  )
  mode: Level
  setState(state: solitaireKlondike, value: 2, target: Self, key: stage)
  setState(state: solitaireKlondike, value: null, target: Self, key: passes, expression: solitaireKlondike[passes] + 1)
}

rule "solitaireKlondike-recycle-card" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 2 and count(solitaireKlondikePile1) > 0
  mode: Level
  deal 1 from solitaireKlondikePile1 to solitaireKlondikePile0
}

rule "solitaireKlondike-recycle-face-down" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 2 and solitaireKlondikeFace[$each] == 1
  mode: Level
  forEach: solitaireKlondikePile0
  setState(state: solitaireKlondikeFace, value: 0, target: Self, key: $each)
}

rule "solitaireKlondike-recycle-finish" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 2 and count(solitaireKlondikePile1) == 0
  mode: Level
  transaction {
    setState(state: solitaireKlondike, value: 0, target: Self, key: stage)
    setState(state: solitaireKlondike, value: null, target: Self, key: moves, expression: solitaireKlondike[moves] + 1)
    setState(state: solitaireKlondike, value: 1, target: Self, key: result)
    setState(state: solitaireKlondike, value: null, target: Self, key: applied, expression: solitaireKlondike[request])
  }
}

rule "solitaireKlondike-deal-advance" {
  when solitaire[table] == 1 and (solitaireKlondike[stage] == 0 or solitaireKlondike[stage] == 3 or solitaireKlondike[stage] == 4)
  mode: Level
  setState(state: solitaireKlondike, value: null, target: Self, key: dealStep, expression: solitaireKlondike[stage] == 0 ? 0 : solitaireKlondike[dealStep] + 1)
}

rule "solitaireKlondike-reject" {
  gate: all(predicates: [
    compareState(state: solitaire, comparison: Equal, value: 1, key: table)
    compareState(state: solitaireKlondike, comparison: NotEqual, value: null, key: request, comparandState: solitaireKlondike, comparandKey: applied)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: stage)
    compareState(state: solitaireKlondike, comparison: Equal, value: 0, key: busy)
  ]
  )
  mode: Level
  transaction {
    setState(state: solitaireKlondike, value: -1, target: Self, key: result)
    setState(state: solitaireKlondike, value: null, target: Self, key: applied, expression: solitaireKlondike[request])
  }
}

rule "solitaireKlondike-maintenance-start" {
  when solitaire[table] == 1 and solitaireKlondike[stage] == 0 and solitaireKlondike[busy] == 1
  mode: Level
  setState(state: solitaireKlondike, value: 0, target: Self, key: busy)
}

rule "solitaireKlondike-reveal" {
  when solitaire[table] == 1 and solitaireKlondike[status] == 1 and solitaireKlondike[stage] == 0 and count($zones[$each]) > 0 and solitaireKlondikeFace[zone($zones[$each], last)] == 0
  mode: Level
  forEach: $zones
  zones [solitaireKlondikePile2, solitaireKlondikePile3, solitaireKlondikePile4, solitaireKlondikePile5, solitaireKlondikePile6, solitaireKlondikePile7, solitaireKlondikePile8, solitaireKlondikePile1]
  setState(state: solitaireKlondikeFace, value: 1, target: Self, key: zone($zones[$each], last))
  setState(state: solitaireKlondike, value: 1, target: Self, key: busy)
}

rule "solitaireKlondike-gather-advance" {
  when solitaire[table] == 1 and (solitaireKlondike[stage] == 0 or solitaireKlondike[stage] == 1)
  mode: Level
  setState(state: solitaireKlondike, value: null, target: Self, key: gatherStep, expression: solitaireKlondike[stage] == 0 ? 0 : minimum(11, solitaireKlondike[gatherStep] + 1))
}

rule "solitaireKlondike-attribute-advance" {
  when solitaire[table] == 1 and (solitaireKlondike[stage] == 0 or solitaireKlondike[stage] == 5)
  mode: Level
  setState(state: solitaireKlondike, value: null, target: Self, key: attributeStep, expression: solitaireKlondike[stage] == 0 ? 0 : solitaireKlondike[attributeStep] + 1)
}

rule "solitaireKlondike-win" {
  when solitaire[table] == 1 and solitaireKlondike[status] == 1 and solitaireKlondike[busy] == 0
  mode: Level
  setState(state: solitaireKlondike, value: null, target: Self, key: status, expression: count(solitaireKlondikePile10) + count(solitaireKlondikePile11) + count(solitaireKlondikePile12) + count(solitaireKlondikePile13) == 52 ? 2 : 1)
}

simulation {
  rateHz: 240
}

pattern solitaireKlondikeLength: Int {
  value: "1"
  maxStates: 64
  symbols {
    any = 1
  }
  match: any*
}

pattern solitaireKlondikeSingle: Int {
  value: "1"
  maxStates: 64
  symbols {
    any = 1
  }
  match: any
}

pattern solitaireKlondikeRun: Int {
  value: "solitaireKlondikeFace[$token] * (1 + (solitaireKlondikeRank[$token] == solitaireKlondikeRank[$previous] - 1) * (solitaireKlondikeSuit[$token] % 2 != solitaireKlondikeSuit[$previous] % 2))"
  maxStates: 64
  symbols {
    face = 1..2
    next = 2
  }
  match: face next*
}

pattern solitaireKlondikeLanding: Int {
  value: "(solitaireKlondikeRank[$token] == solitaireKlondikeRank[solitaireKlondike[card]] + 1) * (solitaireKlondikeSuit[$token] % 2 != solitaireKlondikeSuit[solitaireKlondike[card]] % 2)"
  maxStates: 64
  symbols {
    yes = 1
  }
  match: any* yes
}
