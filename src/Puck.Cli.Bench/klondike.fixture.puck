schema: "puck.world.definition.v1"

motion {
  moveSpeed: 4
  turnSpeed: 2.5
  maxSmoothError: 3
}

spawnPoints [
  {
    id: "seat-1"
    position [0, 0, 0]
    yawDegrees: 0
  }
  {
    id: "seat-2"
    position [2, 0, 0]
    yawDegrees: 0
  }
  {
    id: "seat-3"
    position [0, 0, 2]
    yawDegrees: 0
  }
  {
    id: "seat-4"
    position [2, 0, 2]
    yawDegrees: 0
  }
]

screens [
  {
    index: 0
    origin [0, 1, 0]
    right [1, 0, 0]
    up [0, 1, 0]
    halfWidth: 1
    halfHeight: 1
    halfDepth: 0.1
    round: 0
    source: producer(id: "testPattern", settings: {
      width: 320
      height: 240
    }
    )
    route {
      engageable: false
      engageRadius: 0
      autoInsert: false
    }
  }
]

cameras []

bodies {
  seatActivation [Eager, Eager, Eager, Eager]
  networkPlayers: 0
  defaultPeerSource: "Idle"
  seatSpawns [
    "seat-1"
    "seat-2"
    "seat-3"
    "seat-4"
  ]
  distribution {
    region: disc(radius: 40, sampleCount: 124)
    fill {
      name: "additive"
      offset: 0
      step: 0.38196602
    }
  }
  peerVariation {
    phase {
      name: "additive"
      offset: -4
      step: 0.38196602
    }
    weave {
      name: "additive"
      offset: -4
      step: 0.618034
    }
    activity {
      name: "r2"
      offset: 1
      step: 0
    }
  }
  seatVariation {
    phase {
      name: "additive"
      offset: 0
      step: 0.38196602
    }
    weave {
      name: "additive"
      offset: 0
      step: 0.618034
    }
    activity {
      name: "r2"
      offset: 1
      step: 0
    }
  }
  peerColors {
    name: "additive"
    offset: -4
    step: 0.618034
  }
  capacity: 4
  reconnectGraceSeconds: 3
}

seatDefaults {
  identities [
    {
      id: "amber"
      name: "amber"
      color: "#ED8530"
    }
  ]
  neutralColor: "#8C8C8C"
  colorSequence {
    name: "additive"
    offset: 0
    step: 0.618034
  }
  saturation: 0.65
  value: 0.85
  colorSearchLimit: 64
  noseFactor: 0.35
  pickerThreshold: 0.6
  pickerNeutralColor: "#8C8C8C"
  pickerNeutralBlend: 0.5
  seatCameraFeel {
    yawSensitivity: 0.001
    pitchSensitivity: 0.001
    invertYaw: false
    invertPitch: false
    stickLookRate: 2.6
  }
}

channels [
  {
    name: "forward"
    shape: Bipolar
    role: MoveAdvance
    composition: false
  }
  {
    name: "strafe"
    shape: Bipolar
    role: MoveStrafe
    composition: false
  }
  {
    name: "turn"
    shape: Bipolar
    role: Turn
    composition: false
  }
]

targetRegisters []

bodyMotionPrograms [
  {
    name: "grounded"
    version: "puck.body.program.v1"
    kind: Motion
    operations [ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
  }
  {
    name: "roam"
    version: "puck.body.program.v1"
    kind: Producer
    operations [ProduceSteeringIntent]
  }
]

kits {
  rows [
    {
      name: "traveler"
      bodyMotionProgram: "grounded"
      motion {
        speed {
          value: 4
        }
        turn {
          rate: 2.5
          falloff: 1
          pitchRate: 0
          maxPitch: 1.2
        }
        shaping [
          {
            along {}
            turnScale: 1
          }
        ]
        moveFrame: World
        facingSnap: true
        holds [
          {
            name: "air"
            bond: Free
            hold: Gravity
            pull: 0
            lift: 0
            reach: 0
            upLean: 0
            forward: Heading
            onDrive: false
            driveAlignment: 0
            gravity {
              rise: 14
              fall: 23
            }
            envelope {
              sinkSpeed: 20
            }
            thrust: 0
          }
        ]
        groundStick: 2
      }
      producers {
        roam {
          scalars {
            forward: 0.375
            softRadius: 45
            weaveAmplitude: 0.5
            inwardGain: 1.6
            turnScale: 2.5
            weaveFrequencyBase: 0.3
            weaveFrequencyRange: 0.2
            altitudeGain: 0.32
            activityRateBase: 2.2
            activityRateRange: 1.3
            strafeWave: 0
            turnWave: 0
            upWave: 0
            pitchWave: 0
            rollTurn: 0
            pressThreshold: 0
            altitudeBase: 0
            altitudeRange: 0
          }
          channels {}
        }
      }
      actions {}
      bodyContact: Overlap
      mass: 0
    }
  ]
  assignment {
    sequence {
      name: "r1"
      offset: 1
      step: 0
    }
    rows []
  }
}

defaultSeatKit: "traveler"

addon "probe" {
  modulePath: "probe.wasm"
  hash: "sha256-64/0123456789abcdef"
  fuel: 1000000
  enabled: false
  revision: 0
}


bindingOverlays []

storage {
  endpoint: null
  userId: null
  discoveryEndpoint: null
}

prototypes {}

placements {
  policy {
    authoringHeadroomScreens: 4
    authoringHeadroomPlacements: 8
    minPlacementScale: 0.2
    maxPlacementScale: 5
    candidateRadius: 32
    candidateCap: 16
    previewDeadlineFrames: 12
    derivedFaceScreens: 4
  }
}

speakers []

tunes []

patches []

collision {
  requirements []
  contactSkin: 0.02
  maxIterations: 4
  maxSlopeDegrees: 60
  gradientProbe: 0
  defaultHold: false
}

host {
  presentation: Windowed
  width: 1280
  height: 800
  surfaceFormat: r8g8b8a8
  fullscreen: false
  presentMode: Immediate
  targetHertz: 0
  exitAfterSeconds: 0
  genlock: null
  listen: null
  authority: null
  backend: auto
}

views {
  seatControl {
    yawReference: World
    minPitch: -0.35
    maxPitch: 1.2
  }

  seatRig "seatChase" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 5.4626, yaw: 0, pitch: 0.4145069, pivotOffset: [0, 0, 0], opcode: "orbit")
      lookAt(subject: reference(), targetOffset: [0, 1, 0], worldAxes: false, focusDistance: 6, opcode: "lookAt")
      fieldOfView(fieldOfViewRadians: 0.9599311, opcode: "fov")
      dynamics(row: chase, opcode: "dynamics")
    ]
    anchorOp: null
    blendOp: null
    clampPitchOp: null
    fovOp {
      fieldOfViewRadians: 0.9599311
      opcode: "fov"
    }
    lookAtOp {
      subject: reference()
      targetOffset [0, 1, 0]
      worldAxes: false
      focusDistance: 6
      opcode: "lookAt"
    }
    offsetOp: null
    orbitOp {
      distance: 5.4626
      yaw: 0
      pitch: 0.4145069
      pivotOffset [0, 0, 0]
      opcode: "orbit"
    }
    pathOp: null
    dynamicsOp {
      row: "chase"
      opcode: "dynamics"
    }
    selectOp: null
  }
}

looks {
  rows []
  assignment {
    sequence {
      name: "r1"
      offset: 129
      step: 0
    }
    rows []
  }
}

dynamics [
  {
    name: "chase"
    f: 0.9549
    zeta: 1
    r: 1
  }
  {
    name: "probe"
    f: 2
    zeta: 1
    r: 0
  }
]

grants []

hud {
  defaults {
    enabled: true
    cursor: null
  }
  panels []
}

