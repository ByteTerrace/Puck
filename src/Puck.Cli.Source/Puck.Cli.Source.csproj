<Project Sdk="Microsoft.NET.Sdk">
    <!-- The source and repository verbs: search, scan, references, declarations, derivations, architecture, and the docs checks. -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Source</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.*, )" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[5.*, )" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="[5.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
        <ProjectReference Include="../Puck.Cli.Harness/Puck.Cli.Harness.csproj" />
    </ItemGroup>
</Project>
