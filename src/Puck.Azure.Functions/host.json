{
    "logging": {
        "applicationInsights": {
            "enableLiveMetricsFilters": true,
            "samplingSettings": {
                "excludedTypes": "Request",
                "isEnabled": true
            }
        },
        "logLevel": {
            "Function": "Warning",
            "Host.Results": "Warning",
            "default": "Warning"
        }
    },
    "telemetryMode": "OpenTelemetry",
    "version": "2.0"
}
