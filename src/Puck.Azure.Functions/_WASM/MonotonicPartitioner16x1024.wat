    "\94\1c\b0\1c\cb\1c\e3\1c\fb\1c\19\1d\2e\1d\46\1d\5d\1d\75\1d\8d\1d\a8\1d\c5\1d\de\1d\03\1e\1d\1e"
    "\3c\1e\54\1e\70\1e\8c\1e\ae\1e\ce\1e\f8\1e\14\1f\30\1f\56\1f\77\1f\98\1f\bc\1f\da\1f\f7\1f\20\20"
    "\39\20\53\20\6d\20\87\20\af\20\c8\20\e6\20\09\21\2f\21\4f\21\69\21\88\21\aa\21\c4\21\da\21\07\22"
    "\28\22\42\22\5d\22\80\22\9a\22\b5\22\d7\22\fd\22\1f\23\38\23\5a\23\76\23\8f\23\b2\23\da\23\09\24"
    "\29\24\52\24\78\24\96\24\b1\24\d0\24\f4\24\18\25\33\25\56\25\72\25\9e\25\c4\25\e3\25\0b\26\34\26"
    "\57\26\7a\26\99\26\be\26\e0\26\07\27\2e\27\72\27\91\27\b9\27\df\27\0c\28\2a\28\4e\28\8e\28\b7\28"
    "\e0\28\13\29\3c\29\66\29\94\29\b8\29\e0\29\0a\2a\2a\2a\56\2a\7f\2a\af\2a\dd\2a\04\2b\4d\2b\78\2b"
    "\a1\2b\c7\2b\f1\2b\34\2c\5c\2c\83\2c\a8\2c\d9\2c\01\2d\2b\2d\5f\2d\a4\2d\d9\2d\16\2e\6b\2e\ac\2e"
    "\e0\2e\18\2f\57\2f\94\2f\d7\2f\0f\30\46\30\81\30\b9\30\ff\30\3a\31\8b\31\db\31\2e\32\79\32\c5\32"
    "\04\33\51\33\a2\33\f1\33\54\34\ac\34\0f\35\82\35\09\36\b9\36"
  )

  ;; PRIVATE METHODS
  (func $mp_decode_tail_owner (param $tail_entry_index i32) (param $starting_bucket i32) (param $bucket_count i32) (result i32)
    (local $current_bucket i32)
    (local $stream_position i32)
    (local $first_byte i32)
    (local $bucket_delta i32)
    (local $continuation_byte i32)
    (local $candidate_bucket i32)

    local.get $starting_bucket
    local.set $current_bucket

    i32.const 63400
    local.get $tail_entry_index
    i32.const 1
    i32.shl
    i32.add
    i32.load16_u align=2
    local.set $stream_position

    block $exit
      loop $again
        i32.const 48448
        local.get $stream_position
        i32.add
        i32.load8_u align=1
        local.set $first_byte

        local.get $stream_position
        i32.const 1
        i32.add
        local.set $stream_position

        local.get $first_byte
        i32.eqz
        if
          local.get $current_bucket
          return
        end

        local.get $first_byte
        i32.const 127
        i32.and
        local.set $bucket_delta

        local.get $first_byte
        i32.const 128
        i32.and
        i32.eqz
        i32.eqz
        if
          i32.const 48448
          local.get $stream_position
          i32.add
          i32.load8_u align=1
          local.set $continuation_byte

          local.get $stream_position
          i32.const 1
          i32.add
          local.set $stream_position

          local.get $bucket_delta
          local.get $continuation_byte
          i32.const 127
          i32.and
          i32.const 7
          i32.shl
          i32.or
          local.set $bucket_delta
        end

        local.get $current_bucket
        local.get $bucket_delta
        i32.add
        local.set $candidate_bucket

        local.get $candidate_bucket
        local.get $bucket_count
        i32.ge_s
        if
          local.get $current_bucket
          return
        end

        local.get $candidate_bucket
        local.set $current_bucket
        br $again
      end
    end

    local.get $current_bucket)
  (func $mp_get_bucket_id_slow_path (param $checkpoint_bucket i32) (param $checkpoint_rank_offset i32) (param $bucket_count i32) (param $rank i32) (result i32)
    (local $tail_block_offset i32)
    (local $rank_bit_in_block i64)
    (local $tail_presence_bits i64)
    (local $tail_count_before_block i32)
    (local $tail_count_within_block i32)
    (local $tail_entry_index i32)

    local.get $rank
    i32.const 6
    i32.shr_s
    i32.const 935
    i32.sub
    local.set $tail_block_offset

    local.get $tail_block_offset
    i32.const 89
    i32.lt_u
    if
      i64.const 1
      local.get $rank
      i32.const 63
      i32.and
      i64.extend_i32_u
      i64.shl
      local.set $rank_bit_in_block

      i32.const 62688
      local.get $tail_block_offset
      i32.const 3
      i32.shl
      i32.add
      i64.load align=8
      local.set $tail_presence_bits

      local.get $tail_presence_bits
      local.get $rank_bit_in_block
      i64.and
      i64.eqz
      i32.eqz
      if
        i32.const 31872
        local.get $tail_block_offset
        i32.const 1
        i32.shl
        i32.add
        i32.load16_u align=2
        local.set $tail_count_before_block

        local.get $tail_presence_bits
        local.get $rank_bit_in_block
        i64.const 1
        i64.sub
        i64.and
        i64.popcnt
        i32.wrap_i64
        local.set $tail_count_within_block

        local.get $tail_count_before_block
        local.get $tail_count_within_block
        i32.add
        local.set $tail_entry_index

        local.get $tail_entry_index
        local.get $checkpoint_bucket
        local.get $bucket_count
        call $mp_decode_tail_owner
        return
      end
    end

    local.get $bucket_count
    local.get $checkpoint_bucket
    local.get $rank
    local.get $checkpoint_rank_offset
    i32.add
    i32.const 65535
    i32.and
    call $mp_walk_jump_chain)
  (func $mp_get_guid_hash (param $entropy i32) (result i32)
    i64.const 65534
    local.get $entropy
    i64.extend_i32_u
    i64.mul
    i64.const 32
    i64.shr_u
    i32.wrap_i64
    i32.const 1
    i32.add)
  (func $mp_get_normalized_rank_u16 (param $value i32) (result i32)
    (local $rank i32)
    (local $x i32)
    (local $mask i32)

    local.get $value
    i32.const 40503
    i32.mul
    i32.const 65535
    i32.and
    local.set $rank

    local.get $rank
    i32.const 25033
    i32.xor
    i32.const 1
    i32.sub
    local.get $rank
    i32.const 65535
    i32.xor
    i32.const 1
    i32.sub
    i32.or
    local.set $x

    local.get $x
    call $mp_sign_mask_u32
    local.set $mask

    local.get $rank
    local.get $mask
    i32.const 40502
    i32.and
    i32.xor)
  (func $mp_highest_set_bit_u64 (param $value i64) (result i32)
    i32.const 63
    local.get $value
    i64.clz
    i32.wrap_i64
    i32.xor)
  (func $mp_keep_lowest_bits_u64 (param $value i64) (param $bit_count i32) (result i64)
    local.get $bit_count
    i32.const 64
    i32.ge_u
    if (result i64)
      local.get $value
    else
      local.get $value
      i64.const 1
      local.get $bit_count
      i64.extend_i32_u
      i64.shl
      i64.const 1
      i64.sub
      i64.and
    end)
  (func $mp_sign_mask_u32 (param $value i32) (result i32)
    i32.const 0
    local.get $value
    i32.const 31
    i32.shr_u
    i32.sub)
  (func $mp_walk_jump_chain (param $bucket_count i32) (param $current_bucket i32) (param $remaining_rank i32) (result i32)
    (local $jump_at_bucket_count i32)
    (local $donor_bucket i32)
    (local $prior_div_mod i64)
    (local $jump_div_mod i64)
    (local $prior_quotient i32)
    (local $prior_remainder i32)
    (local $jump_quotient i32)
    (local $jump_remainder i32)
    (local $diff_prior i32)
    (local $min_prior i32)
    (local $diff_jump i32)
    (local $min_jump i32)
    (local $prior_donation_total i32)
    (local $donation_threshold i32)

    block $exit
      loop $again
        local.get $remaining_rank
        i32.eqz
        br_if $exit

        i32.const 65535
        local.get $current_bucket
        i32.sub
        local.get $remaining_rank
        i32.div_u
        i32.const 1
        i32.add
        local.set $jump_at_bucket_count

        local.get $jump_at_bucket_count
        local.get $bucket_count
        i32.gt_u
        br_if $exit

        local.get $jump_at_bucket_count
        i32.const 1
        i32.sub
        local.set $donor_bucket

        i32.const 32056
        local.get $donor_bucket
        i32.const 3
        i32.shl
        i32.add
        i64.load align=8
        local.set $prior_div_mod

        i32.const 32056
        local.get $jump_at_bucket_count
        i32.const 3
        i32.shl
        i32.add
        i64.load align=8
        local.set $jump_div_mod

        local.get $prior_div_mod
        i64.const 32
        i64.shr_u
        i32.wrap_i64
        local.set $prior_quotient

        local.get $prior_div_mod
        i32.wrap_i64
        local.set $prior_remainder

        local.get $jump_div_mod
        i64.const 32
        i64.shr_u
        i32.wrap_i64
        local.set $jump_quotient

        local.get $jump_div_mod
        i32.wrap_i64
        local.set $jump_remainder

        local.get $current_bucket
        local.get $prior_remainder
        i32.sub
        local.set $diff_prior

        local.get $prior_remainder
        local.get $current_bucket
        local.get $prior_remainder
        i32.sub
        local.get $diff_prior
        call $mp_sign_mask_u32
        i32.and
        i32.add
        local.set $min_prior

        local.get $current_bucket
        local.get $jump_remainder
        i32.sub
        local.set $diff_jump

        local.get $jump_remainder
        local.get $current_bucket
        local.get $jump_remainder
        i32.sub
        local.get $diff_jump
        call $mp_sign_mask_u32
        i32.and
        i32.add
        local.set $min_jump

        local.get $current_bucket
        local.get $prior_quotient
        local.get $jump_quotient
        i32.sub
        i32.mul
        local.get $min_prior
        i32.add
        local.get $min_jump
        i32.sub
        local.set $prior_donation_total

        local.get $jump_quotient
        local.get $diff_jump
        i32.const 31
        i32.shr_u
        i32.add
        local.set $donation_threshold

        local.get $prior_donation_total
        local.get $remaining_rank
        local.get $donation_threshold
        i32.sub
        i32.add
        local.set $remaining_rank

        local.get $donor_bucket
        local.set $current_bucket

        br $again
      end
    end

    local.get $current_bucket)
  ;; PUBLIC METHODS
  (func $mp_get_bucket_id_u16_dangerous (export "mp_get_bucket_id_u16_dangerous") (param $value i32) (param $bucket_count i32) (result i32)
    (local $rank i32)
    (local $checkpoint_index i32)
    (local $checkpoint_ptr i32)
    (local $lower_bucket_bitmask i64)

    local.get $value
    i32.const 65535
    i32.and
    call $mp_get_normalized_rank_u16
    local.set $rank

    i32.const 40256
    local.get $rank
    i32.const 4
    i32.shr_u
    i32.const 1
    i32.shl
    i32.add
    i32.load16_u align=2
    local.set $checkpoint_index

    i32.const 1024
    local.get $checkpoint_index
    i32.const 4
    i32.shl
    i32.add
    local.set $checkpoint_ptr

    block $found
      loop $scan
        local.get $checkpoint_ptr
        i32.load16_u offset=8 align=2
        local.get $rank
        i32.lt_u
        i32.eqz
        br_if $found

        local.get $checkpoint_ptr
        i32.const 16
        i32.add
        local.set $checkpoint_ptr
        br $scan
      end
    end

    local.get $checkpoint_ptr
    i64.load align=8
    local.set $lower_bucket_bitmask

    local.get $bucket_count
    i32.const 64
    i32.le_s
    if (result i32)
      local.get $lower_bucket_bitmask
      local.get $bucket_count
      call $mp_keep_lowest_bits_u64
      call $mp_highest_set_bit_u64
    else
      local.get $lower_bucket_bitmask
      call $mp_highest_set_bit_u64
      local.get $checkpoint_ptr
      i32.load16_u offset=10 align=2
      local.get $bucket_count
      local.get $rank
      call $mp_get_bucket_id_slow_path
    end)

  (func $mp_get_bucket_id_u16 (export "mp_get_bucket_id_u16") (param $value i32) (param $bucket_count i32) (result i32)
    local.get $bucket_count
    i32.const 1
    i32.sub
    i32.const 1024
    i32.ge_u
    if (result i32)
      i32.const -1
    else
      local.get $value
      local.get $bucket_count
      call $mp_get_bucket_id_u16_dangerous
    end)
  (func $mp_get_bucket_id_guid_dangerous (export "mp_get_bucket_id_guid_dangerous") (param $guid_ptr i32) (param $bucket_count i32) (result i32)
    local.get $guid_ptr
    i32.load offset=12 align=1
    call $mp_get_guid_hash
    local.get $bucket_count
    call $mp_get_bucket_id_u16_dangerous)
  (func $mp_get_bucket_id_guid (export "mp_get_bucket_id_guid") (param $guid_ptr i32) (param $bucket_count i32) (result i32)
    local.get $bucket_count
    i32.const 1
    i32.sub
    i32.const 1024
    i32.ge_u
    if (result i32)
      i32.const -1
    else
      local.get $guid_ptr
      i32.load offset=12 align=1
      call $mp_get_guid_hash
      local.get $bucket_count
      call $mp_get_bucket_id_u16_dangerous
    end)
)
