<Project Sdk="Microsoft.NET.Sdk">
    <!-- The convention rewriters (`puck format`), the format-shape ledger (`puck formats`), and the pull-request formatter. -->
    <PropertyGroup>
        <AssemblyName>Puck.Cli.Format</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PuckKind>Tool</PuckKind>
        <RootNamespace>Puck.Cli</RootNamespace>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Cli.Core/Puck.Cli.Core.csproj" />
        <ProjectReference Include="../Puck.Cli.Source/Puck.Cli.Source.csproj" />
        <ProjectReference Include="../Puck.Assets/Puck.Assets.csproj" />
        <ProjectReference Include="../Puck.GamingBricks.Transpiler/Puck.GamingBricks.Transpiler.csproj" />
        <ProjectReference Include="../Puck.Transpiler/Puck.Transpiler.csproj" />
        <ProjectReference Include="../Puck.World.Transpiler/Puck.World.Transpiler.csproj" />
    </ItemGroup>
</Project>