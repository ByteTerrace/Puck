<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Launcher.Stub</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <OutputType>Exe</OutputType>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Composition roots</PuckLayer>
        <RootNamespace>Puck.Launcher.Stub</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- The update lease and the launched version's registration are the same handle-held directories the
             launcher's pruner and registration use; AtomicFile supplies the same durable writer as the updater. -->
        <ProjectReference Include="../Puck.Confinement/Puck.Confinement.csproj" />
        <ProjectReference Include="../Puck.Abstractions/Puck.Abstractions.csproj" />
    </ItemGroup>
</Project>
