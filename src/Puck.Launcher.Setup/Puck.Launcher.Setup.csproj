<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Puck.Launcher.Setup</AssemblyName>
        <IsAotCompatible>false</IsAotCompatible>
        <OutputType>Exe</OutputType>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Composition roots</PuckLayer>
        <RootNamespace>Puck.Launcher.Setup</RootNamespace>
        <!-- A consumer machine has no .NET: a player build (`puck world player`) publishes this installer as one
             self-contained file. The switch is this project's alone, as Puck.World's is, so referenced libraries keep their
             portable locked restores. -->
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
        <SelfContained Condition="'$(PuckSelfContained)' == 'true'">true</SelfContained>
        <PublishSingleFile Condition="'$(PuckSelfContained)' == 'true'">true</PublishSingleFile>
        <!-- The single-file analyzer would add the ILLink package only to a self-contained restore, which the portable
             locked restore does not record. -->
        <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
        <EnableCompressionInSingleFile Condition="'$(PuckSelfContained)' == 'true'">true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract Condition="'$(PuckSelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>
    <ItemGroup>
        <!-- The installer is the ordinary update chain (verifier, stager, applier, release record) run against a fresh
             install root; it carries no installation logic of its own. -->
        <ProjectReference Include="../Puck.Launcher/Puck.Launcher.csproj" />
    </ItemGroup>
</Project>
