<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Engine services</PuckLayer>
    </PropertyGroup>
    <PropertyGroup>
        <!-- The DirectX Shader Compiler (ships with the Vulkan SDK and the Windows SDK) compiles the overlay HLSL to
             both SPIR-V (Vulkan) and DXIL (DirectX) — the overlay is backend-neutral.
             Override with /p:DxcCommand="path\to\dxc". -->
        <DxcCommand>dxc</DxcCommand>
        <!-- No compute DXIL: Puck.Overlays' compute kernels have no DirectX consumer today (SPIR-V only, matching
             the recipe before it moved into the shared build\Shaders.targets). Fragment DXIL is unaffected —
             PuckShaderDxilEnabled stays at its shared default true. -->
        <PuckComputeShaderDxilEnabled>false</PuckComputeShaderDxilEnabled>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\Puck.Assets\Puck.Assets.csproj" />
        <ProjectReference Include="..\Puck.Commands\Puck.Commands.csproj" />
        <ProjectReference Include="..\Puck.Hosting\Puck.Hosting.csproj" />
        <ProjectReference Include="..\Puck.Input\Puck.Input.csproj" />
        <ProjectReference Include="..\Puck.Text\Puck.Text.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Puck.Text owns and propagates the shared pre-baked MTSDF image and layout JSON. -->
        <!-- The prepacked overlay glyph artifact (OverlayGlyphSdfPack) — committed so every consumer's FIRST run
             takes the ~19 ms warm path instead of the ~2 s full-atlas decode. Keyed to the PNG+JSON hashes: a rebake
             invalidates it and the next run rebuilds+rewrites it in place (commit the refreshed file with the bake). -->
        <Content Include="Assets\Fonts\**\*.pack" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- The committed bytecode: SPIR-V for Vulkan, DXIL for DirectX (fragment only — PuckComputeShaderDxilEnabled
             is false above), both compiled from the same HLSL source. This evaluation-time glob is what
             ValidateShaderBytecodeSources (build\Shaders.targets) checks; the Content declaration itself is owned
             by the shared CollectShaderBytecode target, which re-globs after CompileShaders so a from-clean build
             with a brand-new, not-yet-committed shader still ships a complete Content list. -->
        <ShaderBytecode Include="Assets\Shaders\**\*.spv" />
        <ShaderBytecode Include="Assets\Shaders\**\*.dxil" />
    </ItemGroup>
    <ItemGroup>
        <FragmentShaderSource Include="Assets\Shaders\**\*.frag.hlsl" />
        <ComputeShaderSource Include="Assets\Shaders\**\*.comp.hlsl" />
        <!-- Not compiled directly — an Input to the shared CompileShaders target so an overlay-common.hlsli edit
             invalidates every *.frag.hlsl/*.comp.hlsl that includes it. -->
        <ShaderInclude Include="Assets\Shaders\**\*.hlsli" />
    </ItemGroup>
</Project>
