<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Backend-neutral shader definitions, connected multi-pass pipelines, and live shader compilation. Documents declare resources, dependencies, history, configuration, and named outputs; the shared compiler targets SPIR-V and DXIL, and the executor uses the registered GPU backend. Includes the build-time HLSL shader packaging recipe.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Shaders</PackageId>
        <PackageTags>bytecode;dxil;manifest;post-process;shaders;spir-v;validation</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Shared substrate</PuckLayer>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\Puck.Assets\Puck.Assets.csproj" />
        <ProjectReference Include="..\Puck.Hosting\Puck.Hosting.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\..\build\PuckShaderHashSidecars.cs" Pack="true" PackagePath="buildTransitive\PuckShaderHashSidecars.cs" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)..\..\build\PuckDirect3D11KernelBytecode.cs" Pack="true" PackagePath="buildTransitive\PuckDirect3D11KernelBytecode.cs" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)..\..\build\Shaders.targets" Pack="true" PackagePath="buildTransitive\ByteTerrace.Puck.Shaders.targets" Visible="false" />
    </ItemGroup>
    <ItemGroup>
        <VertexShaderSource Include="Assets\Runtime\pipeline-preview.vert.hlsl" />
        <FragmentShaderSource Include="Assets\Runtime\pipeline-preview.frag.hlsl" />
        <Content Include="Assets\Runtime\pipeline-preview.vert.hlsl;Assets\Runtime\pipeline-preview.frag.hlsl;Assets\Runtime\pipeline-preview.vert.spv;Assets\Runtime\pipeline-preview.frag.spv;Assets\Runtime\pipeline-preview.vert.dxil;Assets\Runtime\pipeline-preview.frag.dxil" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- The image-source conversion passes (Puck.Abstractions.Sources.ImageSourceConversion), compiled to SPIR-V and
             DXIL at build and shipped by the shared CollectShaderBytecode target. -->
        <ShaderBytecode Include="Assets\Shaders\**\*.spv" />
        <ShaderBytecode Include="Assets\Shaders\**\*.dxil" />
        <ComputeShaderSource Include="Assets\Shaders\**\*.comp.hlsl" />
        <ShaderInclude Include="Assets\Shaders\**\*.hlsli" />
        <!-- The graph's package-library kernels: compute pass sources a graph package runs, compiled with their generated
             interface when loaded rather than at build. -->
        <RenderGraphPackageSource Include="Assets\Shaders\Graph\**\*.hlsl" />
    </ItemGroup>
    <ItemGroup>
        <!-- puck.probe.v1 kind manifests and their kernel HLSL sources ship as content; each kernel's entry points compile
             to cs_5_0 DXBC at build (CompileDirect3D11Kernels in build/Shaders.targets), which ships beside them, because a
             kernel runs on a camera graph's own Direct3D 11 device and compiles nothing there. -->
        <Content Include="Assets\Probes\**" Exclude="Assets\Probes\**\*.dxbc" CopyToOutputDirectory="PreserveNewest" />
        <Direct3D11KernelSource Include="Assets\Probes\faerie.hlsl;Assets\Probes\ir-blob.hlsl;Assets\Probes\ir-marker.hlsl" Entries="accumulate;finalize" />
    </ItemGroup>
</Project>
