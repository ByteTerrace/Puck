<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Backend-neutral shader definitions, connected multi-pass pipelines, and live shader compilation. Documents declare resources, dependencies, history, configuration, and named outputs; the shared compiler targets SPIR-V and DXIL, and the executor uses the registered GPU backend.</Description>
        <IsPackable>true</IsPackable>
        <PackageId>ByteTerrace.Puck.Shaders</PackageId>
        <PackageTags>bytecode;dxil;manifest;post-process;shaders;spir-v;validation</PackageTags>
        <PuckKind>Production</PuckKind>
        <PuckLayer>Shared substrate</PuckLayer>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Puck.Abstractions/Puck.Abstractions.csproj" />
        <ProjectReference Include="../Puck.Assets/Puck.Assets.csproj" />
        <ProjectReference Include="../Puck.Hosting/Puck.Hosting.csproj" />
        <ProjectReference Include="../Puck.Shaders.Model/Puck.Shaders.Model.csproj" />
        <!-- Build-only: its build writes the declarations these kernels include that the C# model owns, and it runs their
             shader build (build/Shaders.targets compiles kernels after ResolveProjectReferences). -->
        <ProjectReference Include="../Puck.Shaders.Generator/Puck.Shaders.Generator.csproj" PrivateAssets="all" Private="false" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- The image-source conversion passes (Puck.Abstractions.Sources.ImageSourceConversion), the region copy, the
             graph's place package, and the display encode under Runtime (SurfaceEncoder: the fullscreen triangle and the
             encode every swapchain compositor, the float preview and a capture of a float output draw with), compiled to
             SPIR-V and, on Windows, DXIL at build and shipped by the shared CollectShaderBytecode target. -->
        <VertexShaderSource Include="Assets/Shaders/**/*.vert.hlsl" />
        <FragmentShaderSource Include="Assets/Shaders/**/*.frag.hlsl" />
        <ComputeShaderSource Include="Assets/Shaders/**/*.comp.hlsl" />
    </ItemGroup>
    <ItemGroup>
        <!-- puck.probe.v1 kind manifests and their kernel HLSL sources ship as content; each kernel's entry points compile
             to cs_5_0 DXBC at build (CompileDirect3D11Kernels in build/Shaders.targets), which ships beside them, because a
             kernel runs on its host's own Direct3D 11 device and compiles nothing there. -->
        <Content Include="Assets/Probes/**" Exclude="Assets/Probes/**/*.dxbc" CopyToOutputDirectory="PreserveNewest" />
        <Direct3D11KernelSource Include="Assets/Probes/average.hlsl;Assets/Probes/faerie.hlsl;Assets/Probes/ir-blob.hlsl;Assets/Probes/ir-marker.hlsl" Entries="accumulate;finalize" />
    </ItemGroup>
</Project>
