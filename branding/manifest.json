{
  "schema": "puck.branding.v1",
  "provenance": "Canonical rasters are verified byte-for-byte against first-party consumers; the canonical file is the source of truth and no hash is recorded.",
  "selectionPolicy": "Use the authored size closest to the consumer slot. Keep separate entries for intentional size or treatment variants.",
  "assets": [
    {
      "id": "puck-logo-200",
      "source": "branding/assets/puck-logo-200.png",
      "variant": "Primary square product mark for the documentation site and NuGet package icon.",
      "consumers": ["docs/site/_theme/logo.png", "NuGet package icon (icon.png)"]
    },
    {
      "id": "puck-logo-256",
      "source": "branding/assets/puck-logo-256.png",
      "variant": "Dashboard portal header mark retained at its authored 256x256 size.",
      "consumers": ["src/Puck.Dashboard/src/portal/src/ui/puck-mark.png"]
    },
    {
      "id": "puck-editor-icon-128",
      "source": "branding/assets/puck-editor-icon-128.png",
      "variant": "Editor extension icon retained at its authored 128x128 size.",
      "consumers": ["editors/vscode/icon.png"]
    },
    {
      "id": "puck-palette-tokens",
      "source": "branding/tokens.css",
      "variant": "Shared light/dark CSS custom properties consumed by the site, DocFX, and dashboard adapters.",
      "consumers": ["docs/site/_theme/tokens.css", "docs/site/_theme/theme.css", "docs/api/templates/byteterrace/public/main.css", "src/Puck.Dashboard/src/portal/src/theme/global.css", "src/Puck.Dashboard/src/host/src/host.css"]
    },
    {
      "id": "puck-favicon",
      "source": "branding/assets/puck-favicon.ico",
      "variant": "Shared browser favicon.",
      "consumers": ["docs/site/favicon.ico", "docs/site/icons/favicon.ico", "src/Puck.Dashboard/src/host/public/favicon.ico"]
    },
    {
      "id": "puck-touch-icon-180",
      "source": "branding/assets/puck-touch-icon-180.png",
      "variant": "Apple touch icon.",
      "consumers": ["docs/site/icons/apple-touch-icon.png", "src/Puck.Dashboard/src/host/public/apple-touch-icon.png"]
    },
    {
      "id": "puck-app-icon-16",
      "source": "branding/assets/puck-app-icon-16.png",
      "variant": "Dark application icon at 16x16.",
      "consumers": ["docs/site/icons/puck-dark-16.png", "src/Puck.Dashboard/src/host/public/puck-dark-16.png"]
    },
    {
      "id": "puck-app-icon-20",
      "source": "branding/assets/puck-app-icon-20.png",
      "variant": "Dark application icon at 20x20.",
      "consumers": ["docs/site/icons/puck-dark-20.png", "src/Puck.Dashboard/src/host/public/puck-dark-20.png"]
    },
    {
      "id": "puck-app-icon-24",
      "source": "branding/assets/puck-app-icon-24.png",
      "variant": "Dark application icon at 24x24.",
      "consumers": ["docs/site/icons/puck-dark-24.png", "src/Puck.Dashboard/src/host/public/puck-dark-24.png"]
    },
    {
      "id": "puck-app-icon-32",
      "source": "branding/assets/puck-app-icon-32.png",
      "variant": "Dark application icon at 32x32.",
      "consumers": ["docs/site/icons/puck-dark-32.png", "src/Puck.Dashboard/src/host/public/puck-dark-32.png"]
    },
    {
      "id": "puck-app-icon-40",
      "source": "branding/assets/puck-app-icon-40.png",
      "variant": "Dark application icon at 40x40.",
      "consumers": ["docs/site/icons/puck-dark-40.png", "src/Puck.Dashboard/src/host/public/puck-dark-40.png"]
    },
    {
      "id": "puck-app-icon-48",
      "source": "branding/assets/puck-app-icon-48.png",
      "variant": "Dark application icon at 48x48.",
      "consumers": ["docs/site/icons/puck-dark-48.png", "src/Puck.Dashboard/src/host/public/puck-dark-48.png"]
    },
    {
      "id": "puck-app-icon-64",
      "source": "branding/assets/puck-app-icon-64.png",
      "variant": "Dark application icon at 64x64.",
      "consumers": ["docs/site/icons/puck-dark-64.png", "src/Puck.Dashboard/src/host/public/puck-dark-64.png"]
    },
    {
      "id": "puck-app-icon-192",
      "source": "branding/assets/puck-app-icon-192.png",
      "variant": "Dark application icon at 192x192 for manifests.",
      "consumers": ["docs/site/icons/puck-dark-192.png", "src/Puck.Dashboard/src/host/public/puck-dark-192.png"]
    },
    {
      "id": "puck-app-icon-512",
      "source": "branding/assets/puck-app-icon-512.png",
      "variant": "Dark application icon at 512x512 for manifests.",
      "consumers": ["docs/site/icons/puck-dark-512.png", "src/Puck.Dashboard/src/host/public/puck-dark-512.png"]
    }
  ],
  "copies": [
    { "asset": "puck-logo-200", "path": "docs/site/_theme/logo.png" },
    { "asset": "puck-logo-256", "path": "src/Puck.Dashboard/src/portal/src/ui/puck-mark.png" },
    { "asset": "puck-editor-icon-128", "path": "editors/vscode/icon.png" },
    { "asset": "puck-palette-tokens", "path": "docs/site/_theme/tokens.css" },
    { "asset": "puck-favicon", "path": "docs/site/favicon.ico" },
    { "asset": "puck-favicon", "path": "docs/site/icons/favicon.ico" },
    { "asset": "puck-favicon", "path": "src/Puck.Dashboard/src/host/public/favicon.ico" },
    { "asset": "puck-touch-icon-180", "path": "docs/site/icons/apple-touch-icon.png" },
    { "asset": "puck-touch-icon-180", "path": "src/Puck.Dashboard/src/host/public/apple-touch-icon.png" },
    { "asset": "puck-app-icon-16", "path": "docs/site/icons/puck-dark-16.png" },
    { "asset": "puck-app-icon-16", "path": "src/Puck.Dashboard/src/host/public/puck-dark-16.png" },
    { "asset": "puck-app-icon-20", "path": "docs/site/icons/puck-dark-20.png" },
    { "asset": "puck-app-icon-20", "path": "src/Puck.Dashboard/src/host/public/puck-dark-20.png" },
    { "asset": "puck-app-icon-24", "path": "docs/site/icons/puck-dark-24.png" },
    { "asset": "puck-app-icon-24", "path": "src/Puck.Dashboard/src/host/public/puck-dark-24.png" },
    { "asset": "puck-app-icon-32", "path": "docs/site/icons/puck-dark-32.png" },
    { "asset": "puck-app-icon-32", "path": "src/Puck.Dashboard/src/host/public/puck-dark-32.png" },
    { "asset": "puck-app-icon-40", "path": "docs/site/icons/puck-dark-40.png" },
    { "asset": "puck-app-icon-40", "path": "src/Puck.Dashboard/src/host/public/puck-dark-40.png" },
    { "asset": "puck-app-icon-48", "path": "docs/site/icons/puck-dark-48.png" },
    { "asset": "puck-app-icon-48", "path": "src/Puck.Dashboard/src/host/public/puck-dark-48.png" },
    { "asset": "puck-app-icon-64", "path": "docs/site/icons/puck-dark-64.png" },
    { "asset": "puck-app-icon-64", "path": "src/Puck.Dashboard/src/host/public/puck-dark-64.png" },
    { "asset": "puck-app-icon-192", "path": "docs/site/icons/puck-dark-192.png" },
    { "asset": "puck-app-icon-192", "path": "src/Puck.Dashboard/src/host/public/puck-dark-192.png" },
    { "asset": "puck-app-icon-512", "path": "docs/site/icons/puck-dark-512.png" },
    { "asset": "puck-app-icon-512", "path": "src/Puck.Dashboard/src/host/public/puck-dark-512.png" }
  ],
  "typography": {
    "fontDirectory": "docs/site/_theme/fonts",
    "families": ["Lora", "JetBrains Mono"],
    "licenseNote": "Existing self-hosted font files and their existing license/provenance treatment are retained."
  },
  "palette": {
    "tokens": "branding/tokens.css",
    "adapters": ["docs/site/_theme/theme.css", "docs/api/templates/byteterrace/public/main.css", "src/Puck.Dashboard/src/portal/src/theme/global.css", "src/Puck.Dashboard/src/host/src/host.css"]
  },
  "wiring": [
    { "path": "build/Packaging.targets", "contains": "branding/assets/puck-logo-200.png", "description": "NuGet packages consume the canonical product mark." },
    { "path": "docs/site/_theme/theme.css", "contains": "@import url(\"/_theme/tokens.css\");", "description": "The staged site theme consumes its shared token copy." },
    { "path": "docs/site/_theme/theme.css", "contains": "font-family: var(--font-body);", "description": "The site consumes the canonical body font stack." },
    { "path": "docs/site/_theme/theme.css", "contains": "font-family: var(--font-code);", "description": "The site consumes the canonical code font stack." },
    { "path": "docs/api/templates/byteterrace/public/main.css", "contains": "@import url(\"/_theme/tokens.css\");", "description": "The DocFX adapter consumes the staged shared token copy." },
    { "path": "docs/api/templates/byteterrace/public/main.css", "contains": "--bs-body-font-family: var(--font-body);", "description": "The DocFX adapter maps the canonical body font stack." },
    { "path": "docs/api/templates/byteterrace/public/main.css", "contains": "--bs-font-monospace: var(--font-code);", "description": "The DocFX adapter maps the canonical code font stack." },
    { "path": "src/Puck.Dashboard/src/portal/src/theme/global.css", "contains": "@import url(\"../../../../../../branding/tokens.css\");", "description": "The dashboard adapter consumes the canonical token source directly." },
    { "path": "src/Puck.Dashboard/src/portal/src/theme/global.css", "contains": "font-family: var(--font-body);", "description": "The dashboard sets display type and prose in the canonical body font stack." },
    { "path": "src/Puck.Dashboard/src/host/src/host.css", "contains": "@import url(\"../../../../../branding/tokens.css\");", "description": "The dashboard host loading screen consumes the canonical token source directly." }
  ]
}
