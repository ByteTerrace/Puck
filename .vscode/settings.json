{
    "azureFunctions.projectSubpath": "src/Puck.Azure.Functions",
    "chat.tools.terminal.autoApprove": {
        "dotnet build": true
    },
    "files.exclude": {
        "**/.tmp": true,
        "**/.worktrees": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.tmp/**": true,
        "**/.worktrees/**": true,
        "**/node_modules/*/**": true
    },
    "puck.server.args": [
        "./src/Puck.Cli/bin/Release/net10.0/Puck.Cli.dll",
        "lsp"
    ],
    "puck.server.command": "dotnet",
    "search.exclude": {
        "**/.claude": true,
        "**/.worktrees": true
    }
}
