<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- Exercises public hosting contracts directly through small deterministic fakes. -->
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.Hosting/Puck.Hosting.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/VirtualClock.cs" Link="VirtualClock.cs" />
    </ItemGroup>
</Project>
