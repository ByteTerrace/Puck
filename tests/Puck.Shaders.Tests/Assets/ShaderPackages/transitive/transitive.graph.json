{
  "$schema": "puck.render.graph.v1",
  "name": "graph",
  "resources": [
    {
      "name": "field",
      "kind": "Image",
      "format": "R16G16B16A16Float",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }
    },
    {
      "name": "image",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }
    }
  ],
  "passes": [
    {
      "name": "blur",
      "source": "blur.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [ { "name": "field" } ]
    },
    {
      "name": "present",
      "source": "present.hlsl",
      "entryPoint": "main",
      "kind": "Fullscreen",
      "inputs": [ { "name": "field" } ],
      "outputs": [ { "name": "image" } ]
    }
  ],
  "outputs": ["image"]
}
