<?xml version="1.0" encoding="utf-8"?>
<!-- Bound as the project's default via RunSettingsFilePath: a plain `dotnet test` runs Smoke + Default only. -->
<RunSettings>
    <RunConfiguration>
        <TestCaseFilter>tier!=Deep&amp;tier!=Bench&amp;tier!=Exhaustive</TestCaseFilter>
    </RunConfiguration>
</RunSettings>
