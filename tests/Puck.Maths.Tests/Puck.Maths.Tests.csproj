<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- Coverage and ownership checks discover the Puck.Maths public surface through reflection. -->
        <IsAotCompatible>false</IsAotCompatible>
        <RunSettingsFilePath>$(MSBuildProjectDirectory)\default.runsettings</RunSettingsFilePath>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.*, )" />
        <PackageReference Include="xunit.runner.visualstudio" Version="[3.*, )" />
        <PackageReference Include="xunit.v3" Version="[3.*, )" />
    </ItemGroup>
    <ItemGroup>
        <!-- Allocation claims measure through Puck.Abstractions.Counting.AllocationWindow. -->
        <ProjectReference Include="..\..\src\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\..\src\Puck.Maths\Puck.Maths.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\TestRecords.cs" Link="TestRecords.cs" />
    </ItemGroup>
</Project>
