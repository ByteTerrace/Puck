{
  "id": "quilt-nw-gap-corner-strip",
  "title": "The four-way corner pocket stands on the delivered neighbour strip, not local geometry",
  "bootShape": "headless",
  "requirements": [],
  "seconds": 18,
  "timeoutSeconds": 35,
  "binding": "Both legs boot a world whose own local ground never reaches the corner pocket beyond NW's east and south edges (the collision probe there is identical and off-surface in both legs). The positive leg keeps both direct adjacencies, so the pocket is covered by a neighbour's delivered terrain and a body resting there is grounded. The discriminating leg is quilt-nw-gap — the same world with both adjacencies delivering that corner removed — so the identical pocket carries nothing and the same body falls through, isolating the delivered strip as the source of the continuity rather than any local geometry.",
  "fixtures": [],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.collision.probe", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 2, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "response", "name": "the corner pocket carries no local geometry", "stream": "stdout", "verb": "world.collision.probe", "occurrence": 1, "count": 1, "extract": [{ "name": "cornerDistance", "field": "distance" }] },
      { "type": "relation", "name": "the pocket is off the local field's surface", "left": { "value": "cornerDistance" }, "operator": "atLeast", "minimum": 1.0 },
      { "type": "response", "name": "the resting body has a settled height", "stream": "stdout", "verb": "player.where", "occurrence": 1, "count": 2, "extract": [{ "name": "restY", "field": "pos", "component": 1 }] },
      { "type": "relation", "name": "the body rests on the delivered floor, not thin air", "left": { "value": "restY" }, "operator": "betweenInclusive", "minimum": 0.119, "maximum": 0.121 },
      { "type": "response", "name": "contacts reads the corner body", "stream": "stdout", "verb": "world.contacts", "occurrence": 1, "count": 2, "extract": [{ "name": "grounded", "field": "grounded" }] },
      { "type": "relation", "name": "the corner body is grounded", "left": { "value": "grounded" }, "operator": "equal", "right": { "literal": "true" } },
      { "type": "response", "name": "the resting body's height is still settled 600 ticks later", "stream": "stdout", "verb": "player.where", "occurrence": 2, "count": 2, "extract": [{ "name": "laterRestY", "field": "pos", "component": 1 }] },
      { "type": "relation", "name": "the body still rests on the delivered floor after standing", "left": { "value": "laterRestY" }, "operator": "betweenInclusive", "minimum": 0.119, "maximum": 0.121 },
      { "type": "response", "name": "contacts still reads the corner body grounded 600 ticks later", "stream": "stdout", "verb": "world.contacts", "occurrence": 2, "count": 2, "extract": [{ "name": "laterGrounded", "field": "grounded" }] },
      { "type": "relation", "name": "the corner body is still grounded after standing", "left": { "value": "laterGrounded" }, "operator": "equal", "right": { "literal": "true" } },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  },
  "discriminating": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw-gap.world.json",
    "script": "discriminating.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.collision.probe", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "response", "name": "the same corner pocket still carries no local geometry", "stream": "stdout", "verb": "world.collision.probe", "occurrence": 1, "count": 1, "extract": [{ "name": "cornerDistance", "field": "distance" }] },
      { "type": "relation", "name": "the pocket is off the local field's surface, unchanged from the positive leg", "left": { "value": "cornerDistance" }, "operator": "atLeast", "minimum": 1.0 },
      { "type": "response", "name": "the falling body's height reads well below the floor", "stream": "stdout", "verb": "player.where", "occurrence": 1, "count": 1, "extract": [{ "name": "restY", "field": "pos", "component": 1 }] },
      { "type": "relation", "name": "with the delivering adjacencies gone the body has fallen through", "left": { "value": "restY" }, "operator": "atMost", "maximum": -5.0 },
      { "type": "response", "name": "contacts reads the falling body", "stream": "stdout", "verb": "world.contacts", "occurrence": 1, "count": 1, "extract": [{ "name": "grounded", "field": "grounded" }] },
      { "type": "relation", "name": "the falling body is not grounded", "left": { "value": "grounded" }, "operator": "equal", "right": { "literal": "false" } },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  }
}
