schema: "puck.world.definition.v1"
documentId: "kernel-counters"

host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 64
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: offscreen
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 64
}

placements {
  placement "cloud" {
    prototype: "cloud"
    position [0, 0, 0]
  }
}

prototypes {
  prototype "cloud" {
    document {
      name: "cloud"
      schema: "puck.creation.v1"
      shapes []
      volumes [
        {
          halfExtent [2, 1.5, 2]
          kind: "cloud"
          position [0, 0, 0]
          ramp [
            {
              color: "#D7E3ED"
              density: 0
            }
          ]
          rotation [0, 0, 0, 1]
          seed: 7
          steps: 16
        }
      ]
    }
  }

  prototype "cloud-32" {
    document {
      name: "cloud-32"
      schema: "puck.creation.v1"
      shapes []
      volumes [
        {
          halfExtent [2, 1.5, 2]
          kind: "cloud"
          position [0, 0, 0]
          ramp [
            {
              color: "#D7E3ED"
              density: 0
            }
          ]
          rotation [0, 0, 0, 1]
          seed: 7
          steps: 32
        }
      ]
    }
  }
}

views {
  layout "world" {
    seatCount: 0
    slots [
      {
        camera: null
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0.25
  }

  seatControl {
    maxPitch: 0.01
    minPitch: -0.01
    yawReference: World
  }

  seatRig "world" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 6, pitch: 0, yaw: 0)
      fieldOfView(fieldOfViewRadians: 0.9)
    ]
  }

  post "grain" {
    config {
      intensity: 0.1
    }
    package: "sdf.film-grain"
  }
}
