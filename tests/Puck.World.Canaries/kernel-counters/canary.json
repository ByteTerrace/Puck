{
  "id": "kernel-counters",
  "title": "world.counters gpu reads the march steps the SDF kernels count where they march: a bounded volume's samples double when its step count does, and a pass that marches nothing reads zero",
  "binding": "The positive leg boots a still offscreen world whose one placement is a creation with no shapes and one cloud volume integrating sixteen samples along every ray through it, turns the cadence gate off so every frame renders every pass, waits for the engine to be ready, and reads world.counters gpu. It then sets the prototype's row again with the cloud at thirty-two samples and reads again. The sky pass marches nothing but the volume, so every march step it counts is a volume sample, and each ray through the cloud integrates exactly its step count: the second read's sky march steps are exactly twice the first's, and the first's are more than zero. The cull arguments pass walks no field and writes no texel, so it reads zero of both. The discriminating leg sets the row again at the same sixteen samples, so the second read's sky march steps equal the first's: the count follows the samples, not the edit.",
  "bootShape": "offscreen",
  "backends": [
    "vulkan",
    "directx"
  ],
  "requirements": [
    "gpu"
  ],
  "timeoutSeconds": 60,
  "fixtures": [],
  "positive": {
    "world": "tests/Puck.World.Canaries/kernel-counters/fixture.world.json",
    "script": "positive.script.txt",
    "commands": [
      {
        "verb": "world.cadence",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.counters",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.row.set",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 3,
        "outcome": "accepted"
      },
      {
        "verb": "world.counters",
        "occurrence": 2,
        "outcome": "accepted"
      }
    ],
    "expect": [
      {
        "type": "response",
        "name": "sixteen-samples",
        "stream": "stdout",
