      { "verb": "world.screenshot", "occurrence": 4, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 9, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "line", "name": "the-seat-builds", "stream": "stdout", "match": "contains", "text": "[player.build: seat 1", "present": true },
      { "type": "line", "name": "the-grid-echoes-its-working-plane", "stream": "stdout", "match": "contains", "text": "[world.grid: seat=1 visible=true mode=plane pitch=1,1,1 plane=1]", "present": true },
