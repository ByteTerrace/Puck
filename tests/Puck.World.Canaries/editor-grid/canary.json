{
  "id": "editor-grid",
  "title": "A building seat's grid lies on the working plane at the platform's height, or on every surface, and a hidden grid leaves the frame as it was",
  "binding": "The positive leg boots an offscreen 256x144 world whose seat looks from 0,6,9 at 0,0.5,0 over four red solids: a floor slab with its top at height 0, a two-unit-square platform with its top at height 1 left of centre, a ramp rising 25 degrees away from the viewer right of centre (its top between heights 0 and 0.72), and a wall facing the viewer behind them. With no grid the scene is captured as plain.png. The seat enters build mode (player.build), sets a one-unit pitch and a working plane at height 1, and switches the grid on: plane.png shows blue grid lines on the platform's top, whose region's mean blue rises above 0.22, while the floor's region stays below 0.16, since the floor lies a unit under the plane's band and the lines draw only on the plane. In surface mode (surface.png) the lattice lies on every surface, projected along each surface's normal: the floor, the platform, the ramp and the wall regions each rise above 0.22. With the grid switched off, off.png agrees with plain.png. The discriminating leg runs the same verbs without player.build, so the seat plays: none of its views draws a grid, every grid-present observation fails, and surface.png agrees with plain.png.",
  "bootShape": "offscreen",
  "backends": ["vulkan", "directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "positive": {
    "world": "tests/Puck.World.Canaries/editor-grid/fixture.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.cadence", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "player.build", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.grid", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.grid", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.grid", "occurrence": 3, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 4, "outcome": "accepted" },
