      { "type": "imageRegion", "name": "on-every-surface-the-platform-shows-the-grid", "capture": "surface.png", "extent": [256, 144], "region": [0.32, 0.44, 0.4, 0.49], "reduce": "mean", "minimum": [0, 0, 0.22, 0], "maximum": [1, 1, 1, 1], "toleranceCodes": 2, "holds": true },
      { "type": "imageRegion", "name": "on-every-surface-the-ramp-shows-the-grid", "capture": "surface.png", "extent": [256, 144], "region": [0.61, 0.46, 0.67, 0.54], "reduce": "mean", "minimum": [0, 0, 0.22, 0], "maximum": [1, 1, 1, 1], "toleranceCodes": 2, "holds": true },
      { "type": "imageRegion", "name": "on-every-surface-the-wall-shows-the-grid", "capture": "surface.png", "extent": [256, 144], "region": [0.44, 0.26, 0.56, 0.36], "reduce": "mean", "minimum": [0, 0, 0.22, 0], "maximum": [1, 1, 1, 1], "toleranceCodes": 2, "holds": true },
      { "type": "framesAgree", "name": "a-grid-on-the-plane-changes-the-frame", "before": "plain.png", "after": "plane.png", "agree": false },
      { "type": "framesAgree", "name": "a-hidden-grid-leaves-the-frame-as-it-was", "before": "plain.png", "after": "off.png", "agree": true }
