schema: "puck.world.definition.v1"

host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 256
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: offscreen
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 256
}

render {
  sky {
    layers [
      gradient(stops: [
        {
          elevation: -1
          color: "#000000"
        }
        {
          elevation: 1
          color: "#000000"
        }
      ]
      )
    ]
  }
  lighting {
    lights [
      directional(direction: [0, 0.435, -0.9], color: "#FFFFFF", weight: 1)
    ]
  }
}

views {
  layout "world" {
    seatCount: 0
    slots [
      {
        camera: "sky-cam"
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0.25
  }

  seatControl {
    maxPitch: 0.01
    minPitch: -0.01
    yawReference: World
  }

  seatRig "world" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 0.01, pitch: 0.45, yaw: 0)
      fieldOfView(fieldOfViewRadians: 1.4)
    ]
  }
}

cameras [
  {
    name: "sky-cam"
    renderWidth: 256
    renderHeight: 256
    rig {
      name: "sky-cam"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 0, 0]))
        lookAt(subject: worldPoint(point: [0, 0.5, -1]))
        fieldOfView(fieldOfViewRadians: 1.4)
      ]
    }
  }
]

prototypes {
  prototype "fog-target" {
    document {
      name: "fog-target"
      schema: "puck.creation.v1"
      palette [
        {
          roughness: 1
          specular: 0
          color: "#FF0000"
        }
      ]
      shape Sphere "sphere" {
        material: 0
        position [0, 0, 0]
        scale [2, 2, 2]
      }
    }
  }
}

placements {
  placement "fog-target" {
    prototype: "fog-target"
    position [0, -10, -8]
  }
}

screens [
  {
    index: 0
    origin [0, -60, 0]
    right [1, 0, 0]
    up [0, 0, 1]
    halfWidth: 1
    halfHeight: 1
    halfDepth: 0.1
    round: 0
    source: producer(id: "testPattern", settings: {
      width: 64
      height: 32
    }
    )
    route {
      engageable: false
      engageRadius: 0
    }
  }
]
