{
  "id": "state-cycle-trait",
  "title": "A cycle trait turns a state row with the tick — rotation steps, turns, a rotor component, and a symmetry-lattice ring walk — and reads back the same bits at every fence",
  "binding": "The positive leg boots a minimal headless fixture whose state rows each carry a cycle trait at twenty ticks per step: 'spin' (plane 0, Step) reads 0 at tick 0, 1 by tick 30 and 3 by tick 70; 'spinPhased' stores phase 7 and reads 10 at tick 70; 'spinTurns' (Turns) reads floor(3*2^16/30) = 0.0999908447265625; 'spinCos' on plane 3 (thirteen steps per step) reads the rotor cosine at index 13 (-0.913543701171875) then at index 39 mod 30 = 9 (-0.3090057373046875); 'orbit' (plane 1, Node) starts on node 5 and is carried seven ring positions per step to node 87 then node 54, and 'orbitX' reads that node's projected X. Every value is a pure function of the tick — no per-tick write, no journal entry — so a fence at any tick reads the same bits. The discriminating leg boots the same rows with no cycle trait: every row reads its stored value at all three fences and none of the positive leg's turned values ever appears.",
  "bootShape": "headless",
  "requirements": [],
  "seconds": 5,
  "timeoutSeconds": 20,
  "fixtures": [],
  "positive": {
    "world": "tests/Puck.World.Canaries/state-cycle-trait/fixture.world.json",
    "script": "positive.script.txt",
    "commands": [
      {
        "verb": "world.status",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.state",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.state",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.state",
        "occurrence": 3,
        "outcome": "accepted"
      },
      {
        "verb": "wire.errors",
        "occurrence": 1,
        "outcome": "accepted"
      }
    ],
    "expect": [
