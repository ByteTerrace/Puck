schema: "puck.world.definition.v1"
basis: "../../../src/Puck.World/Assets/worlds/standard"

import "../../../src/Puck.World/Assets/worlds/modules/kart" as kart

bodies {
  capacity: 8
  localSeats: 1
  seatSpawns [
    "kart-arrival"
  ]
}

channels [
  {
    frame: Heading
    name: "forward"
    role: MoveAdvance
    shape: Bipolar
  }
  {
    frame: Heading
    name: "strafe"
    role: MoveStrafe
    shape: Bipolar
  }
  {
    name: "turn"
    role: Turn
    shape: Bipolar
  }
]

collision {
  contactSkin: 0.02
  gradientProbe: 0
  maxIterations: 4
  maxSlopeDegrees: 60
  requirements [SmoothUnionContact]
}

gravity {
  attractors []
  gravitationalConstant: 0
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, -46, 0]
}

simulation {
  rateHz: 30
}

views {
  layout "action" {
    seatCount: 0
    slots [
      {
        camera: null
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 0.5
    transitionSeconds: 0.4
  }

  seatControl {
    maxPitch: 1.2
    minPitch: -0.35
    yawReference: World
  }

  seatRig "seatChase" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 5.4626001, pitch: 0.4145069, yaw: 0)
      lookAt(subject: reference(), targetOffset: [0, 1, 0], worldAxes: false)
      fieldOfView(fieldOfViewRadians: 0.9599311)
    ]
  }
}
