{
  "id": "pipeline-supersede",
  "title": "Of two pipeline edits loaded back to back on a paused instance, only the latest renders, and the last rendered frame stays presented until the step",
  "binding": "Both legs boot the pipeline-feedback graph offscreen, pause, reset and step to submission 2 (2/16), then load two valid edits of the middle pass back to back. A reload is not a step, so the paused instance may install the first edit before the second arrives, or the runtime may report it superseded while it compiles or builds; which one happens depends on compile and build timing, so no line names it. Neither edit renders without a step: captures while the latest edit compiles and after it compiles still read the last rendered frame's 2/16. The next step renders the latest edit whole over the retained history. In the positive leg the latest edit halves the history, so submission 3 reads (3/16) / 2 = 3/32, derived from the arithmetic rather than recorded. The discriminating leg loads the same two edits in the opposite order, so the latest edit is one minus the history and submission 3 reads 1 - 3/16 = 13/16: the positive's post-edit oracle turns red, which it would equally do if the stale first edit had been installed.",
  "bootShape": "offscreen",
  "backends": ["vulkan", "directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "fixtures": [
    "halved.graph.json",
    "convert-halved.hlsl"
  ],
  "positive": {
    "world": "tests/Puck.World.Canaries/pipeline-supersede/fixture.world.json",
    "script": "latest-wins.script.txt",
    "commands": [
      { "verb": "pipeline.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.time", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.reset", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "pipeline.step", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 4, "outcome": "accepted" },
      { "verb": "pipeline.load", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.status", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.load", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.status", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.capture", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 5, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 6, "outcome": "accepted" },
      { "verb": "pipeline.capture", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 7, "outcome": "accepted" },
      { "verb": "pipeline.step", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 8, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 9, "outcome": "accepted" },
      { "verb": "pipeline.capture", "occurrence": 3, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 10, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "imageRegion", "name": "installed-graph-presents-while-compiling", "capture": "during.png", "extent": [32, 32], "region": [0.03125, 0.03125, 0.96875, 0.96875], "reduce": "every", "minimum": [0.125, 0.125, 0.125, 1], "maximum": [0.125, 0.125, 0.125, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "installed-graph-presents-while-held", "capture": "held.png", "extent": [32, 32], "region": [0.03125, 0.03125, 0.96875, 0.96875], "reduce": "every", "minimum": [0.125, 0.125, 0.125, 1], "maximum": [0.125, 0.125, 0.125, 1], "toleranceCodes": 1, "holds": true },
      { "type": "line", "name": "the-latest-edit-compiles", "stream": "stderr", "match": "exact", "text": "[pipeline: feedback wait compiled reached]", "present": true },
      { "type": "line", "name": "the-latest-edit-installs", "stream": "stderr", "match": "contains", "text": "[pipeline: feedback wait installed failed", "present": false },
      { "type": "imageRegion", "name": "latest-edit-renders-three-thirty-seconds", "capture": "post-edit.png", "extent": [32, 32], "region": [0.03125, 0.03125, 0.96875, 0.96875], "reduce": "every", "minimum": [0.09375, 0.09375, 0.09375, 1], "maximum": [0.09375, 0.09375, 0.09375, 1], "toleranceCodes": 1, "holds": true }
    ]
  },
  "discriminating": {
