// Two rooms joined by a door: the lobby, with a blue landmark behind its arch, and the garden, with a green landmark
// ahead of its arrival. The seat walks forward from the lobby's arrival through the arch and arrives mapped in the
// garden, walking on; the frame the seat's camera composes shows the lobby's blue before the crossing and the garden's
// green after it. Each room is the verdicts plot (a ground, a walking kit, a chase rig and one seat) presented
// offscreen at the canary's capture size.

schema: "puck.world.definition.v1"

import "../../Puck.World.Verdicts/composition/plot.puck"

module room(landmark) {
  use plot(centre: [0m, 0m, 0m], landingAt: [0, 0, 0], threshold: 3)

  host {
    authority: null
    backend: auto
    exitAfterSeconds: 0
    fullscreen: false
    genlock: null
    height: 144
    journalDepth: 2000
    listen: null
    presentMode: Immediate
    presentation: offscreen
    surfaceFormat: r8g8b8a8
    targetHertz: 0
    width: 256
  }

  prototypes {
    prototype "landmark" {
      document {
        name: "landmark"
        palette [
          {
            color: landmark
            roughness: 0.6
            specular: 0.1
          }
        ]
        schema: "puck.creation.v1"
        shape Box "slab" {
          material: 0
          position [0, 3, 0]
          scale [6, 3, 0.5]
        }
      }
    }
  }

  placements {
    placement "landmark" {
      position [0, 0, -14]
      prototype: "landmark"
    }
  }
}

// The lobby adds the door: an arch whose face looks back along +Z at the walker, its aperture the thin slab in front
// of it that a walk along -Z enters from the front.
module lobby() {
  use room(landmark: "#2F5DDE")

  prototypes {
    prototype "arch" {
      document {
        behavior {
          faces [
            {
              name: "portal"
              shapeId: 0
            }
          ]
        }
        name: "arch"
        palette [
          {
            color: "#7A7A7A"
          }
        ]
        schema: "puck.creation.v1"
        shape Box "frame" {
          material: 0
          position [0, 1.5, 0]
          scale [1.5, 1.5, 0.1]
        }
      }
    }
  }

  placements {
    placement "arch" {
      faceSources [
        {
          face: "portal"
          source {
            "$type": "none"
          }
        }
      ]
      position [0, 0, -6]
      prototype: "arch"
      yawDegrees: 180
    }
  }
}

entry world lobby = lobby()
world garden = room(landmark: "#2FB84A")

door lobby.arch, garden.arrival
