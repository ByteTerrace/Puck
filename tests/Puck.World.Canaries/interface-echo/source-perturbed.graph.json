{
  "$schema": "puck.render.graph.v1",
  "name": "source-perturbed",
  "resources": [
    {
      "name": "echo",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 14,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "source-perturbed",
      "source": "source-perturbed.echo.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "echo"
        }
      ],
      "config": {
        "workCounterRow": { "type": "uint", "default": 0, "description": "The pass's row of the work counters." }
      }
    }
  ],
  "outputs": ["echo"]
}
