{
  "$schema": "puck.render.graph.v1",
  "name": "sdf-world",
  "resources": [
    {
      "name": "echo",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 21,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "sdf-world",
      "source": "sdf-world.echo.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "echo"
        }
      ],
      "config": {
        "imageExtent": { "type": "uint2", "default": [0, 0], "description": "The sdf.world pass's engine extent, in pixels." },
        "instanceMaskWordCount": { "type": "uint", "default": 0, "description": "The sdf.world pass's per-tile instance-mask width." },
        "meshDraws": { "type": "uint", "default": 0, "description": "The sdf.world pass's mesh draw count." },
        "sampleIndex": { "type": "uint", "default": 0, "description": "The sdf.world pass's star twinkle clock." },
        "screenMask": { "type": "uint", "default": 0, "description": "The sdf.world pass's bound-screen mask." },
        "tileGrid": { "type": "uint2", "default": [0, 0], "description": "The sdf.world pass's tiles per viewport." },
        "viewBase": { "type": "uint", "default": 0, "description": "The sdf.world pass's view." },
        "viewportCount": { "type": "uint", "default": 0, "description": "The sdf.world pass's view count." }
      }
    }
  ],
  "outputs": ["echo"]
}