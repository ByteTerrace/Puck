{
  "$schema": "puck.render.graph.v1",
  "name": "sdf-film-grain-perturbed",
  "resources": [
    {
      "name": "echo",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 17,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "sdf-film-grain-perturbed",
      "source": "sdf-film-grain-perturbed.echo.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "echo"
        }
      ],
      "config": {
        "flickerHz": { "type": "uint", "default": 24, "min": 1, "description": "How many times per second the grain pattern advances." },
        "intensity": { "type": "float", "default": 0.05, "min": 0, "max": 1, "description": "The peak per-channel offset." },
        "seed": { "type": "uint", "default": 0, "description": "Folded into the per-pixel hash." },
        "size": { "type": "float", "default": 1, "min": 1, "description": "The grain cell size, in pixels." }
      }
    }
  ],
  "outputs": ["echo"]
}
