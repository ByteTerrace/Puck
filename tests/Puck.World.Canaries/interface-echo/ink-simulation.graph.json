{
  "$schema": "puck.render.graph.v1",
  "name": "ink-simulation",
  "resources": [
    {
      "name": "echo",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 14,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "ink-simulation",
      "source": "ink-simulation.echo.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "echo"
        }
      ],
      "config": {
        "decay": {
          "default": 0.987,
          "max": 1,
          "description": "Fraction of ink retained per pipeline frame.",
          "min": 0,
          "type": "float"
        }
      }
    }
  ],
  "outputs": ["echo"]
}
