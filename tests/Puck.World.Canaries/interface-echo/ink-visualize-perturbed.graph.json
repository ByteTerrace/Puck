{
  "$schema": "puck.render.graph.v1",
  "name": "ink-visualize-perturbed",
  "resources": [
    {
      "name": "echo",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 14,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "ink-visualize-perturbed",
      "source": "ink-visualize-perturbed.echo.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "echo"
        }
      ],
      "config": {
        "exposure": {
          "default": 1,
          "max": 4,
          "description": "Visualized pigment intensity.",
          "min": 0,
          "type": "float"
        }
      }
    }
  ],
  "outputs": ["echo"]
}
