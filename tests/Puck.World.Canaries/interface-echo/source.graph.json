{
  "$schema": "puck.render.graph.v1",
  "name": "source",
  "resources": [
    {
      "name": "echo",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 17,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "source",
      "source": "source.echo.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "echo"
        }
      ],
      "config": {
        "paperWhiteNits": { "type": "float", "default": 80, "min": 80, "max": 10000, "description": "The paper-white level, in cd/m², a working value of one shows at." },
        "workCounterDetailRow": { "type": "uint", "default": 0, "description": "The pass's first named detail row of the work counters." },
        "workCounterRow": { "type": "uint", "default": 0, "description": "The pass's row of the work counters." }
      }
    }
  ],
  "outputs": ["echo"]
}
