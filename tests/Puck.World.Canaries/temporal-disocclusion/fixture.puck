// A fixed camera observes an analytic radius0.6 sphere moving three metres across the sample-grid tiles.
schema: "puck.world.definition.v1"
import "../../Puck.World.Verdicts/composition/plot.puck"
use plot(centre: [0m, 0m, 0m], landingAt: [10, 0, 10], threshold: 3)
documentId: "temporal-disocclusion"

cameras [
  {
    anchor: null
    name: "fixed"
    renderHeight: 128
    renderWidth: 128
    rig {
      name: "fixed"
      operations [
        anchor(subject: worldPoint(point: [0, 1, 8]))
        lookAt(subject: worldPoint(point: [0, 1, 0]))
        fieldOfView(fieldOfViewRadians: 0.9)
      ]
      version: "puck.camera.program.v1"
    }
  }
  {
    anchor: null
    name: "reference"
    renderHeight: 128
    renderWidth: 128
    rig {
      name: "reference"
      operations [
        anchor(subject: worldPoint(point: [0, 1, 8]))
        lookAt(subject: worldPoint(point: [0, 1, 0]))
        fieldOfView(fieldOfViewRadians: 0.9)
      ]
      version: "puck.camera.program.v1"
    }
  }
]

host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 128
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: offscreen
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 128
}

render {
  temporal: false
  ambientOcclusion: false
  shadows: Off
  upscaleSharpness: 0
}

looks {
  assignment {
    rows ["sphere"]
    sequence {
      name: "r1"
      offset: 0
      step: 0
    }
  }
  rows [
    {
      name: "sphere"
      source: creation(prototypeId: `moving-sphere`)
      scale: 1
      motion {
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
      }
    }
  ]
}

prototypes [
  {
    id: "moving-sphere"
    document {
      name: "moving-sphere"
      schema: "puck.creation.v1"
      palette [
        {
          color: "#E84838"
          roughness: 1
          specular: 0
        }
      ]
      shapes [
        {
          id: 0
          name: "sphere"
          type: Sphere
          material: 0
          position [0, 1, 0]
          rotation [0, 0, 0, 1]
          scale [0.6, 0.6, 0.6]
        }
      ]
    }
  }
  {
    document {
      behavior {
        faces [
          {
            defaultSource: null
            name: "display"
            shapeId: 0
          }
        ]
      }
      frames [
        {
          name: "idle"
          transforms [
          ]
        }
      ]
      name: "screen"
      palette [
        {
          color: "#DDE8EA"
        }
      ]
      schema: "puck.creation.v1"
      shapes [
        {
          blend: "Union"
          id: 0
          material: 0
          name: "panel"
          position [0, 0, 0]
          rotation [0, 0, 0, 1]
          scale [0.9, 0.6, 0.05]
          smooth: 0
          type: Box
        }
      ]
    }
    id: "screen"
  }
  {
    id: "panel"
    document {
      name: "panel"
      schema: "puck.creation.v1"
      palette [
        {
          color: "#38B8A0"
          roughness: 1
          specular: 0
        }
      ]
      shapes [
        {
          id: 0
          name: "panel"
          type: Box
          material: 0
          position [0, 1, 0]
          rotation [0, 0, 0, 1]
          scale [1.3, 1.3, 0.1]
        }
      ]
    }
  }
]

placements {
  policy {
    authoringHeadroomPlacements: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    derivedFaceScreens: 1
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }
  rows [
    {
      id: "reference-demand"
      prototypeId: "screen"
      position [0, -50, 0]
      scale: 1
      yawDegrees: 0
      faceSources [
        {
          face: "display"
          source: view(cameraName: "reference")
        }
      ]
    }
    {
      id: "panel"
      prototypeId: "panel"
      position [0, 0, -1]
      scale: 1
      yawDegrees: 0
    }
  ]
}

views {
  layouts [
    {
      name: "fixed"
      seatCount: 1
      slots [
        {
          camera: "fixed"
          height: 1
          width: 1
          x: 0
          y: 0
        }
      ]
      transitionRenderScale: 1
      transitionSeconds: 0
    }
  ]
}

simulation {
  rateHz: 30
}

captures {
  rows [
    {
      station: before
      palette [{ material: 0, color: "#FFFFFF" }]
      ticks [60]
      instance: "world"
    }
    {
      station: revealed
      palette [{ material: 0, color: "#FFFFFF" }]
      ticks [71, 72]
      instance: "world"
    }
    {
      station: spatial
      palette [{ material: 0, color: "#FFFFFF" }]
      ticks [90]
      instance: "reference"
    }
  ]
}

schedule {
  settleTicks: 4
  rows [
    {
      tick: 69
      principal: "seat1"
      command: "body.pose 3 0 0 0 0 0"
    }
  ]
}
