{
  "$schema": "puck.render.graph.v1",
  "name": "tint",
  "tiers": ["high"],
  "resources": [
    {
      "name": "image",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Relative",
        "width": 1,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "tint",
      "source": "tint.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "image"
        }
      ],
      "config": {
        "gain": {
          "default": 1,
          "max": 1,
          "description": "The red channel of every pixel; green is its complement.",
          "min": 0,
          "type": "float"
        }
      }
    }
  ],
  "outputs": ["image"]
}
