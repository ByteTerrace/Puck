        "verb": "world.wait",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.counters",
        "occurrence": 1,
        "outcome": "accepted"
      }
    ],
    "expect": [
      {
        "type": "imageRegion",
        "name": "the-seeded-view-shows-the-slab-in-every-pixel",
        "capture": "state/captures/occluded~65.png",
        "extent": [
          256,
          144
        ],
        "region": [
          0.475,
          0.45,
          0.525,
          0.555
        ],
        "reduce": "every",
