{
  "$schema": "puck.render.graph.v1",
  "name": "echo",
  "resources": [
    {
      "name": "echo",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 17,
        "height": 1
      }
    }
  ],
  "passes": [
    {
      "name": "frame",
      "source": "frame.echo.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "echo"
        }
      ],
      "config": {
        "bias": {
          "default": [0, 0, 0],
          "description": "A float3 member, which starts a 16-byte row.",
          "type": "float3"
        },
        "count": {
          "default": 0,
          "description": "A uint member.",
          "type": "uint"
        },
        "scale": {
          "default": [1, 1],
          "description": "A float2 member, which starts an 8-byte boundary.",
          "type": "float2"
        },
        "shift": {
          "default": 0,
          "description": "An int member.",
          "type": "int"
        }
      }
    }
  ],
  "outputs": ["echo"]
}