{
  "id": "travel-frame-portal-remote",
  "title": "A remote portal arrival frame follows its body",
  "bootShape": "windowed",
  "requirements": ["gpu"],
  "seconds": 25,
  "timeoutSeconds": 60,
  "binding": "Both legs cross Play's mapped archway into a runner-owned remote Studio authority and capture twice; only the positive leg moves the arrived body.",
  "fixtures": [],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/prototypes/nexus.world.json",
    "authorityWorld": "src/Puck.World/Assets/worlds/prototypes/studio.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "console", "occurrence": 1, "outcome": "accepted" }, { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" }, { "verb": "player.press", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" }, { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 1, "outcome": "accepted" }, { "verb": "world.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "player.fly", "occurrence": 1, "outcome": "accepted" }, { "verb": "world.wait", "occurrence": 4, "outcome": "accepted" },
      { "verb": "player.where", "occurrence": 2, "outcome": "accepted" }, { "verb": "world.screenshot", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 5, "outcome": "accepted" }, { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "line", "name": "arrival names remote authority", "stream": "stdout", "match": "contains", "text": "remote authority {authority}", "present": true },
      { "type": "response", "name": "remote portal pose before move", "stream": "stdout", "verb": "player.where", "occurrence": 1, "count": 2, "extract": [{ "name": "beforeZ", "field": "pos", "component": 2 }] },
      { "type": "response", "name": "remote portal pose after move", "stream": "stdout", "verb": "player.where", "occurrence": 2, "count": 2, "extract": [{ "name": "afterZ", "field": "pos", "component": 2 }] },
      { "type": "relation", "name": "remote arrived body moved", "left": { "value": "beforeZ" }, "operator": "minimumMargin", "right": { "value": "afterZ" }, "margin": 1 },
      { "type": "framesAgree", "name": "moving the remote portal body changes the composed frame", "before": "before.png", "after": "after.png", "agree": false },
      { "type": "line", "name": "both captures resolved", "stream": "stderr", "match": "contains", "text": "after.png", "present": true },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  },
  "discriminating": {
    "world": "src/Puck.World/Assets/worlds/prototypes/nexus.world.json",
    "authorityWorld": "src/Puck.World/Assets/worlds/prototypes/studio.world.json",
    "script": "discriminating.script.txt",
    "commands": [
      { "verb": "console", "occurrence": 1, "outcome": "accepted" }, { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" }, { "verb": "player.press", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" }, { "verb": "player.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 1, "outcome": "accepted" }, { "verb": "world.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 4, "outcome": "accepted" }, { "verb": "player.where", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 2, "outcome": "accepted" }, { "verb": "world.wait", "occurrence": 5, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "response", "name": "remote portal pose before control wait", "stream": "stdout", "verb": "player.where", "occurrence": 1, "count": 2, "extract": [{ "name": "beforeZ", "field": "pos", "component": 2 }] },
      { "type": "response", "name": "remote portal pose after control wait", "stream": "stdout", "verb": "player.where", "occurrence": 2, "count": 2, "extract": [{ "name": "afterZ", "field": "pos", "component": 2 }] },
      { "type": "relation", "name": "without input the remote portal body stays put", "left": { "value": "beforeZ" }, "operator": "equal", "right": { "value": "afterZ" } },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  }
}
