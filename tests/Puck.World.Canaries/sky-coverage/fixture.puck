schema: "puck.world.definition.v1"

host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 128
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: offscreen
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 128
}

render {
  atmosphere {
    fog {
      density: 0
    }
  }
  sky {
    layers [
      gradient(stops: [
        {
          elevation: -1
          color: "#000000"
        }
        {
          elevation: 1
          color: "#000000"
        }
      ]
      )
      sunDisc(light: 0, radius: 0.3, intensity: 16)
    ]
  }
  lighting {
    lights [
      directional(direction: [0, 0.447, -0.894], color: "#FFFFFF", weight: 0)
    ]
  }
  renderScale: 0.70980394
}

views {
  layout "world" {
    seatCount: 0
    slots [
      {
        camera: "sky-cam"
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0.25
  }

  seatControl {
    maxPitch: 0.01
    minPitch: -0.01
    yawReference: World
  }

  seatRig "world" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 0.01, pitch: 0.45, yaw: 0)
      fieldOfView(fieldOfViewRadians: 1.4)
    ]
  }
}

cameras [
  {
    name: "sky-cam"
    renderWidth: 128
    renderHeight: 128
    rig {
      name: "sky-cam"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 0, 0]))
        lookAt(subject: worldPoint(point: [0, 0.5, -1]))
        fieldOfView(fieldOfViewRadians: 0.6)
      ]
    }
  }
]

prototypes {
  prototype "edge" {
    document {
      name: "edge"
      schema: "puck.creation.v1"
      palette [
        {
          roughness: 1
          specular: 0
          color: "#808080"
          emissive: 1
        }
      ]
      shape Sphere "sphere" {
        material: 0
        position [0, 0, 0]
      }
    }
  }
}

placements {
  placement "edge" {
    prototype: "edge"
    position [0, 1.68, -5.37]
  }
}
