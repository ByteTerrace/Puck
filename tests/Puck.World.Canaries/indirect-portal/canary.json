    "expect": [
      {
        "type": "response",
        "name": "the-fenced-floor-incoming-screen-source",
        "stream": "stdout",
        "verb": "world.explain",
        "occurrence": 1,
        "count": 1,
        "extract": [
          {
            "name": "screen-r",
            "field": "screens",
            "component": 0,
            "line": "sources sky="
          },
          {
            "name": "screen-g",
            "field": "screens",
            "component": 1,
            "line": "sources sky="
          },
          {
            "name": "screen-b",
            "field": "screens",
            "component": 2,
            "line": "sources sky="
          }
        ]
      },
      {
        "type": "relation",
        "name": "portal-radiance-reaches-the-floor",
        "operator": "greater",
        "left": {
          "value": "screen-r"
        },
        "right": {
          "literal": 0.001
        }
      },
      {
        "type": "relation",
        "name": "the-destination-adds-no-g-source",
        "operator": "equal",
        "left": {
          "value": "screen-g"
        },
        "right": {
          "literal": 0
        }
      },
      {
        "type": "relation",
        "name": "the-destination-adds-no-b-source",
        "operator": "equal",
        "left": {
          "value": "screen-b"
        },
        "right": {
          "literal": 0
        }
      },
      {
        "type": "imageRegion",
        "name": "the-floor-image-follows-screen-source-admission",
        "capture": "floor.png",
        "extent": [
          96,
          96
        ],
        "region": [
          0.45,
          0.45,
          0.55,
          0.55
        ],
        "reduce": "mean",
        "minimum": [
          0.01,
          0,
          0,
          1
        ],
        "maximum": [
          1,
          0.005,
          0.005,
          1
        ],
        "toleranceCodes": 1,
        "holds": true
      },
      {
        "type": "line",
        "name": "the-current-shared-cache-is-fenced",
        "stream": "stderr",
        "match": "contains",
        "text": "[indirect: settled at tick",
        "present": true
      }
    ]
  },
