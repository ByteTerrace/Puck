{
  "id": "music-judge-press",
  "title": "A judge press grades against the musical clock, with a genuinely live tick each time",
  "bootShape": "windowed",
  "requirements": ["gpu"],
  "seconds": 15,
  "timeoutSeconds": 30,
  "binding": "Both legs boot the Play world over real stdin; only the positive leg presses the seat kit's judge composition channel (bound to ActionEffect.Judge over the arcade cabinet's nexus-drum-easy row).",
  "fixtures": [],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/play.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "console", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "player.press", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "judge.state", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "player.press", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 4, "outcome": "accepted" },
      { "verb": "judge.state", "occurrence": 2, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "response", "name": "judge state after the first press", "stream": "stdout", "verb": "judge.state", "occurrence": 1, "count": 2, "extract": [
        { "name": "firstGrade", "field": "body0.nexus-drum-easy.grade" },
        { "name": "firstTick", "field": "body0.nexus-drum-easy.tick" }
      ] },
      { "type": "response", "name": "judge state after the second press", "stream": "stdout", "verb": "judge.state", "occurrence": 2, "count": 2, "extract": [
        { "name": "secondGrade", "field": "body0.nexus-drum-easy.grade" },
        { "name": "secondTick", "field": "body0.nexus-drum-easy.tick" }
      ] },
      { "type": "relation", "name": "the second press grades against a genuinely later tick, never a stale cached one", "left": { "value": "secondTick" }, "operator": "minimumMargin", "right": { "value": "firstTick" }, "margin": 1 },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false },
      { "type": "line", "name": "no codec refusal", "stream": "stderr", "match": "contains", "text": "codec refused", "present": false }
    ]
  },
  "discriminating": {
    "world": "src/Puck.World/Assets/worlds/play.world.json",
    "script": "discriminating.script.txt",
    "commands": [
      { "verb": "console", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "judge.state", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "judge.state", "occurrence": 2, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "line", "name": "the declared judge row still echoes", "stream": "stdout", "match": "contains", "text": "nexus-drum-easy [perfect:105,good:315]", "present": true },
      { "type": "line", "name": "without a press no grade ever appears", "stream": "stdout", "match": "contains", "text": "body0.nexus-drum-easy.grade=", "present": false },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  }
}
