      { "type": "imageRegion", "name": "the-right-pane-shows-the-codes-quiet-zone", "capture": "frame.png", "extent": [64, 128], "region": [0.51, 0.005, 0.55, 0.06], "reduce": "every", "minimum": [1, 1, 1, 1], "maximum": [1, 1, 1, 1], "toleranceCodes": 1, "holds": false },
