      { "type": "imageRegion", "name": "the-edge-view-blends-green-into-magenta", "capture": "state/captures/edge~96.png", "extent": [64, 128], "region": [0.3, 0.55, 0.7, 0.95], "reduce": "every", "minimum": [0.1, 0.1, 0.1, 1], "maximum": [1, 1, 1, 1], "toleranceCodes": 2, "holds": false }
