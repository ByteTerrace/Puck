{
  "id": "uploaded-sources",
  "title": "Uploaded sources convert through their source graphs, show in their panes, and hold exactly to the images they state",
  "binding": "The positive leg boots an offscreen 64x128 world whose views.graphs rows are two uploaded source instances, a 32x64 test pattern (source.testPattern) and a QR code of 'puck' with a four-module quiet zone (source.qr), each an instance of the render-graph runtime whose one pass is the shipped source-rgba conversion reading the region its producer writes, placed in the left and right halves of the display's top half by the one layout, whose bottom half shows camera 'edge', and a world-space screen showing a tune instrument's video output, a machine source instance whose upload writes the output's latest frame into its region once per completed tick. A captures row captures the test pattern's source instance at tick 60, before composition: its bars are the pattern's own yellow, red and blue, in the columns WorldTestPatternProducer draws them, so the conversion swapped the producer's BGRA into RGBA, and the capture holds exactly to the pattern the producer states for tick 60 (ImageSourceVerdict, narrated as the capture's verdict). A second row captures screen 0's source, the machine source instance, at tick 90, and it holds exactly to the frame the upload wrote for that tick. The root's screenshot shows the red and blue bars in the left pane, and in the right pane the code's white quiet zone and the dark center of its top-left finder pattern. A second world-space screen shows a 7x3 test pattern, one texel per bar, through the Linear sampler, and camera 'edge' looks square onto it from one unit away, framed so its view runs from the centre of the green bar's texel to the centre of the magenta one's: under Linear each pixel column blends the two by its own fraction of the view. A captures row captures the root at tick 96, where the pattern's sweep lies over its first three columns, and the view shows green at its left edge and, across its middle two fifths, a blend in which every channel is lit. The discriminating leg authors the code with no quiet zone and captures the pattern at tick 448, where the pattern's sweep covers the yellow bar's columns: the yellow observation turns red because the source converts the image of the tick it presents, and the quiet-zone and finder observations turn red because the right pane shows the changed code, while the bars that neither change moves hold. Its edge screen samples Nearest, so the view's middle is pure green then pure magenta, each with a dark channel: the blend observation turns red while the green one holds, which shows the screen bound and drawing the same pattern. Both of its source captures still hold exactly to their references, since a conversion is exact at every tick.",
  "bootShape": "offscreen",
  "backends": ["vulkan", "directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "fixtures": ["instrument.audio.json"],
  "positive": {
    "world": "tests/Puck.World.Canaries/uploaded-sources/fixture.world.json",
    "script": "sources.script.txt",
    "commands": [
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 3, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "line", "name": "the-pattern-capture-holds-exactly-to-its-reference", "stream": "stderr", "match": "contains", "text": "[captures] pattern tick 60: verdict testPattern 32x64 exact.", "present": true },
      { "type": "line", "name": "the-machine-capture-holds-exactly-to-its-reference", "stream": "stderr", "match": "contains", "text": "[captures] machine tick 90: verdict machine 160x144 exact.", "present": true },
      { "type": "line", "name": "no-source-capture-differs-from-its-reference", "stream": "stderr", "match": "contains", "text": "pixel(s) differ", "present": false },
      { "type": "line", "name": "no-source-reference-states-another-tick", "stream": "stderr", "match": "contains", "text": "states the image of tick", "present": false },
      { "type": "imageRegion", "name": "the-source-instance-shows-its-yellow-bar", "capture": "state/captures/pattern~60.png", "extent": [32, 64], "region": [0.19, 0.07, 0.27, 0.56], "reduce": "every", "minimum": [1, 1, 0, 1], "maximum": [1, 1, 0, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-source-instance-shows-its-red-bar", "capture": "state/captures/pattern~60.png", "extent": [32, 64], "region": [0.76, 0.07, 0.83, 0.56], "reduce": "every", "minimum": [1, 0, 0, 1], "maximum": [1, 0, 0, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-source-instance-shows-its-blue-bar", "capture": "state/captures/pattern~60.png", "extent": [32, 64], "region": [0.91, 0.07, 0.96, 0.56], "reduce": "every", "minimum": [0, 0, 1, 1], "maximum": [0, 0, 1, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-left-pane-shows-the-red-bar", "capture": "frame.png", "extent": [64, 128], "region": [0.38, 0.035, 0.41, 0.28], "reduce": "every", "minimum": [1, 0, 0, 1], "maximum": [1, 0, 0, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-left-pane-shows-the-blue-bar", "capture": "frame.png", "extent": [64, 128], "region": [0.455, 0.035, 0.48, 0.28], "reduce": "every", "minimum": [0, 0, 1, 1], "maximum": [0, 0, 1, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-right-pane-shows-the-codes-quiet-zone", "capture": "frame.png", "extent": [64, 128], "region": [0.51, 0.005, 0.55, 0.06], "reduce": "every", "minimum": [1, 1, 1, 1], "maximum": [1, 1, 1, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-right-pane-shows-the-finders-dark-center", "capture": "frame.png", "extent": [64, 128], "region": [0.615, 0.115, 0.64, 0.14], "reduce": "every", "minimum": [0, 0, 0, 1], "maximum": [0, 0, 0, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-edge-view-shows-the-green-bar-at-its-left", "capture": "state/captures/edge~96.png", "extent": [64, 128], "region": [0, 0.55, 0.03, 0.95], "reduce": "every", "minimum": [0, 0.5, 0, 1], "maximum": [0.3, 1, 0.3, 1], "toleranceCodes": 2, "holds": true },
      { "type": "imageRegion", "name": "the-edge-view-blends-green-into-magenta", "capture": "state/captures/edge~96.png", "extent": [64, 128], "region": [0.3, 0.55, 0.7, 0.95], "reduce": "every", "minimum": [0.1, 0.1, 0.1, 1], "maximum": [1, 1, 1, 1], "toleranceCodes": 2, "holds": true }
    ]
  },
  "discriminating": {
