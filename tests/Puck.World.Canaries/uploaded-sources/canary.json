      { "type": "imageRegion", "name": "the-source-instance-shows-its-red-bar", "capture": "state/captures/pattern~448.png", "extent": [32, 64], "region": [0.76, 0.07, 0.83, 0.56], "reduce": "every", "minimum": [1, 0, 0, 1], "maximum": [1, 0, 0, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "the-source-instance-shows-its-blue-bar", "capture": "state/captures/pattern~448.png", "extent": [32, 64], "region": [0.91, 0.07, 0.96, 0.56], "reduce": "every", "minimum": [0, 0, 1, 1], "maximum": [0, 0, 1, 1], "toleranceCodes": 1, "holds": true },
