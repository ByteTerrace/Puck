{
  "id": "temporal-standing",
  "title": "A standing camera completes temporal convergence and does no further temporal or resolve work",
  "binding": "The screen-free 128x128 offscreen world uses temporal reconstruction at Quarter scale with cadence on and no animated sky, media, bodies or screens. After readiness and settling, a camera-anchor pan restarts the epoch. Reads one and three ticks after that pan carry advancing World submissions despite identical camera inputs, nonempty primary and shading writes, and an executed resolve with nonzero output writes. Another thirty ticks finish convergence; thirty further ticks advance the root's completed submission while the World's completed submission and revision stay equal. Thus no new World submission records temporal or resolve work during those later still-camera frames: counters retain the last completed sample, rather than replacing its historical counts with zeros. The shading texel count equals the primary count: today's views counter counts color writes, not the separate reactivity-buffer writes. The discriminating leg changes only the final camera input, panning again and waiting two ticks. The named zero-further-work relation turns red because the World submits new temporal shading and resolve work; their executed-work checks still hold.",
  "bootShape": "offscreen",
  "backends": ["vulkan","directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "positive": {
    "world": "tests/Puck.World.Canaries/temporal-standing/fixture.puck",
    "script": "positive.script.txt",
    "commands": [
      {"verb":"world.temporal","occurrence":1,"outcome":"accepted"},
      {"verb":"world.render-scale","occurrence":1,"outcome":"accepted"},
      {"verb":"world.ao","occurrence":1,"outcome":"accepted"},
      {"verb":"world.shadows","occurrence":1,"outcome":"accepted"},
      {"verb":"world.upscale-sharpness","occurrence":1,"outcome":"accepted"},
      {"verb":"world.cadence","occurrence":1,"outcome":"accepted"},
      {"verb":"world.wait","occurrence":1,"outcome":"accepted"},
      {"verb":"world.wait","occurrence":2,"outcome":"accepted"},
      {"verb":"world.row.set","occurrence":1,"outcome":"accepted"},
      {"verb":"world.wait","occurrence":3,"outcome":"accepted"},
      {"verb":"world.counters","occurrence":1,"outcome":"accepted"},
      {"verb":"world.wait","occurrence":4,"outcome":"accepted"},
      {"verb":"world.counters","occurrence":2,"outcome":"accepted"},
      {"verb":"world.wait","occurrence":5,"outcome":"accepted"},
      {"verb":"world.counters","occurrence":3,"outcome":"accepted"},
      {"verb":"world.wait","occurrence":6,"outcome":"accepted"},
      {"verb":"world.counters","occurrence":4,"outcome":"accepted"}
    ],
    "expect": [
      {"type":"response","name":"work-reading-1","stream":"stdout","verb":"world.counters","occurrence":1,"count":4,"extract":[{"name":"world-1","field":"submission","line":"node world work"},{"name":"root-1","field":"submission","line":"node main work"},{"name":"revision-1","field":"revision","line":"node world work"},{"name":"primary-1","field":"texels.written","line":"work sdf.world$primary executed:","after":"node world work"},{"name":"views-1","field":"texels.written","line":"work sdf.world$views executed:","after":"node world work"},{"name":"resolve-1","field":"texels.written","line":"work sdf.world$resolve executed:","after":"node world work"},{"name":"resolve-dispatches-1","field":"dispatches","line":"work sdf.world$resolve executed:","after":"node world work"}]},
      {"type":"response","name":"work-reading-2","stream":"stdout","verb":"world.counters","occurrence":2,"count":4,"extract":[{"name":"world-2","field":"submission","line":"node world work"},{"name":"root-2","field":"submission","line":"node main work"},{"name":"revision-2","field":"revision","line":"node world work"},{"name":"primary-2","field":"texels.written","line":"work sdf.world$primary executed:","after":"node world work"},{"name":"views-2","field":"texels.written","line":"work sdf.world$views executed:","after":"node world work"},{"name":"resolve-2","field":"texels.written","line":"work sdf.world$resolve executed:","after":"node world work"},{"name":"resolve-dispatches-2","field":"dispatches","line":"work sdf.world$resolve executed:","after":"node world work"}]},
      {"type":"response","name":"work-reading-3","stream":"stdout","verb":"world.counters","occurrence":3,"count":4,"extract":[{"name":"world-3","field":"submission","line":"node world work"},{"name":"root-3","field":"submission","line":"node main work"},{"name":"revision-3","field":"revision","line":"node world work"},{"name":"primary-3","field":"texels.written","line":"work sdf.world$primary executed:","after":"node world work"},{"name":"views-3","field":"texels.written","line":"work sdf.world$views executed:","after":"node world work"},{"name":"resolve-3","field":"texels.written","line":"work sdf.world$resolve executed:","after":"node world work"},{"name":"resolve-dispatches-3","field":"dispatches","line":"work sdf.world$resolve executed:","after":"node world work"}]},
      {"type":"response","name":"work-reading-4","stream":"stdout","verb":"world.counters","occurrence":4,"count":4,"extract":[{"name":"world-4","field":"submission","line":"node world work"},{"name":"root-4","field":"submission","line":"node main work"},{"name":"revision-4","field":"revision","line":"node world work"},{"name":"primary-4","field":"texels.written","line":"work sdf.world$primary executed:","after":"node world work"},{"name":"views-4","field":"texels.written","line":"work sdf.world$views executed:","after":"node world work"},{"name":"resolve-4","field":"texels.written","line":"work sdf.world$resolve executed:","after":"node world work"},{"name":"resolve-dispatches-4","field":"dispatches","line":"work sdf.world$resolve executed:","after":"node world work"}]},
      {"type":"relation","name":"convergence-renders-another-sample","operator":"greater","left":{"value":"world-2"},"right":{"value":"world-1"}},
      {"type":"relation","name":"convergence-finishes-after-the-early-reads","operator":"greater","left":{"value":"world-3"},"right":{"value":"world-2"}},
      {"type":"relation","name":"primary-grid-1-is-nonempty","operator":"greater","left":{"value":"primary-1"},"right":{"literal":0}},
