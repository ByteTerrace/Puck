      {"type":"relation","name":"primary-grid-3-is-nonempty","operator":"greater","left":{"value":"primary-3"},"right":{"literal":0}},
      {"type":"relation","name":"shading-3-writes-the-primary-grid","operator":"equal","left":{"value":"views-3"},"right":{"value":"primary-3"}},
      {"type":"relation","name":"resolve-3-writes-output","operator":"greater","left":{"value":"resolve-3"},"right":{"literal":0}},
      {"type":"relation","name":"resolve-3-dispatches","operator":"equal","left":{"value":"resolve-dispatches-3"},"right":{"literal":1}},
      {"type":"relation","name":"primary-grid-4-is-nonempty","operator":"greater","left":{"value":"primary-4"},"right":{"literal":0}},
      {"type":"relation","name":"shading-4-writes-the-primary-grid","operator":"equal","left":{"value":"views-4"},"right":{"value":"primary-4"}},
      {"type":"relation","name":"resolve-4-writes-output","operator":"greater","left":{"value":"resolve-4"},"right":{"literal":0}},
      {"type":"relation","name":"resolve-4-dispatches","operator":"equal","left":{"value":"resolve-dispatches-4"},"right":{"literal":1}},
      {"type":"relation","name":"converged-view-does-no-further-temporal-or-resolve-work","operator":"equal","left":{"value":"world-4","minus":"world-3"},"right":{"literal":0}},
      {"type":"relation","name":"standing-view-keeps-its-graph","operator":"equal","left":{"value":"revision-4"},"right":{"value":"revision-3"}},
      {"type":"relation","name":"further-frames-reach-the-root","operator":"greater","left":{"value":"root-4"},"right":{"value":"root-3"}}
    ]
  },
