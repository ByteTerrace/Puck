        }
      },
      {
        "type": "relation",
        "name": "primary-grid-is-nonempty",
        "operator": "greater",
        "left": {
          "value": "primary-texels"
        },
        "right": {
          "literal": 0
        }
      },
      {
        "type": "relation",
        "name": "temporal-shading-writes-one-reactivity-texel-per-color-texel",
        "operator": "equal",
        "left": {
          "minus": "primary-texels",
          "value": "views-texels"
        },
        "right": {
          "value": "primary-texels"
        }
      }
    ]
  }
}
