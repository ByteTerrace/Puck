        "occurrence": 2,
        "outcome": "accepted"
      }
    ],
    "expect": [
      {
        "type": "line",
        "name": "quarter-grid-writes-72-squared-sky-texels",
        "stream": "stdout",
        "match": "contains",
        "text": "march.steps=0 texels.written=5184 copies.buffer-bytes=0",
        "present": true
      },
      {
        "type": "response",
        "name": "settled-first",
        "stream": "stdout",
        "verb": "world.counters",
        "occurrence": 1,
        "count": 2,
        "extract": [
          {
            "name": "world-first",
            "field": "submission",
            "line": "node world work"
          },
          {
            "name": "primary-texels",
            "field": "texels.written",
            "line": "work sdf.world$primary executed:"
          },
          {
            "name": "views-texels",
            "field": "texels.written",
            "line": "work sdf.world$views executed:"
          }
        ]
      },
      {
        "type": "response",
        "name": "settled-second",
        "stream": "stdout",
