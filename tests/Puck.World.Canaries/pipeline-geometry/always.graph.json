        ],
        "indices": [ 3, 2, 1, 0, 1, 2 ],
        "indexFormat": "UInt16"
      }
    },
    {
      "name": "far",
      "source": "layers.hlsl",
      "entryPoint": "ps",
      "kind": "Geometry",
      "outputs": [ { "name": "c1" }, { "name": "d1" } ],
      "depthCompare": "Always",
      "geometry": {
        "vertexEntryPoint": "vs",
        "strideBytes": 24,
        "attributes": [
          { "location": 0, "format": "R32G32B32Float", "offsetBytes": 0 },
          { "location": 1, "format": "R32G32B32Float", "offsetBytes": 12 }
        ],
        "vertices": [
          -1,   -1, 0.75, 0, 0, 1,
           0.5, -1, 0.75, 0, 0, 1,
          -1,    1, 0.75, 0, 0, 1,
           0.5,  1, 0.75, 0, 0, 1,
