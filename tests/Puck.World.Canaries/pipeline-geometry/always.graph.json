           1,    1, 0.5,  0, 1, 0
        ],
        "indices": [ 7, 6, 5, 4, 5, 6, 3, 2, 1, 0, 1, 2 ],
        "indexFormat": "UInt32"
      }
    },
    {
      "name": "present",
      "source": "present.hlsl",
      "entryPoint": "main",
      "kind": "Fullscreen",
      "inputs": [ { "name": "c1", "as": "layers" } ],
      "outputs": [ { "name": "image" } ]
    },
    {
      "name": "stripes",
      "source": "stripes.hlsl",
      "entryPoint": "main",
