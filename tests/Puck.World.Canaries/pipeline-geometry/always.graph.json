{
  "$schema": "puck.render.graph.v1",
  "name": "geometry",
  "resources": [
    { "name": "c0", "kind": "Image", "format": "R8G8B8A8Unorm", "dimensions": { "mode": "Absolute", "width": 32, "height": 32 } },
    { "name": "c1", "kind": "Image", "format": "R8G8B8A8Unorm", "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }, "from": "c0" },
    { "name": "d0", "kind": "Depth", "format": "D32Float", "dimensions": { "mode": "Absolute", "width": 32, "height": 32 } },
    { "name": "d1", "kind": "Depth", "format": "D32Float", "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }, "from": "d0" },
    { "name": "image", "kind": "Image", "format": "R8G8B8A8Unorm", "dimensions": { "mode": "Absolute", "width": 32, "height": 32 } },
    { "name": "stripes", "kind": "Image", "format": "R8G8B8A8Unorm", "dimensions": { "mode": "Absolute", "width": 32, "height": 32 } },
    { "name": "oriented", "kind": "Image", "format": "R8G8B8A8Unorm", "dimensions": { "mode": "Absolute", "width": 32, "height": 32 } }
  ],
  "passes": [
    {
      "name": "near",
      "source": "layers.hlsl",
      "entryPoint": "ps",
