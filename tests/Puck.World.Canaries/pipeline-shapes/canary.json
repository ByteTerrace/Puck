{
  "id": "pipeline-shapes",
  "title": "A compute, compute, fullscreen pipeline with half-float intermediates, sparse bindings, a raw buffer and the POSITION adapter computes each stage's arithmetic",
  "binding": "The positive leg boots an offscreen world whose one pipeline seeds a 32x32 half-float field with (3/8, 0, 0, 1) and a raw word table with 96 at byte 0 and 32 at byte 4 (bindings 4 and 9), combines them into a half-float image of (2 * field.r, word0 / 256, word1 / 256, 1) = (3/4, 3/8, 1/8, 1) (bindings 2, 7 and 5), and presents that through a fullscreen pass drawn with the POSITION vertex adapter, which adds 1/2 to blue on the right half. Paused, it captures the RGBA8 image, then each float intermediate through the float preview; resumed, it captures the field again from a produced frame. Every expectation is derived from that arithmetic, not recorded. The discriminating leg reads the table's blue word at byte 0 instead of byte 4, so the combined image and the presented image turn to blue 3/8 and 7/8 and the positive oracles for those stages turn red, while the first stage's field oracle holds in both legs.",
  "bootShape": "offscreen",
  "backends": ["vulkan", "directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "fixtures": [
    "shapes.pipeline.json",
    "misaddressed.pipeline.json",
    "seed.hlsl",
    "combine.hlsl",
    "combine-misaddressed.hlsl",
    "present.hlsl"
  ],
