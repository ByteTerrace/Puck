schema: "puck.world.definition.v1"
documentId: "portal-nested-middle"

admission [
  {
    algorithm: ""
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
    publicKey: ""
    subject: null
  }
]

destinations [
  {
    durability: persisted
    name: "inner"
    reference: "inner"
    scope: global
  }
]

placements {
  policy {
    authoringHeadroomPlacements: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    derivedFaceScreens: 1
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  placement "arch" {
    prototype: "arch"
    position [0, 1.5, 0]
  }

  placement "door" {
    prototype: "door"
    faceSources [
      {
        face: "glass"
        portal {
          arrival: "mapped"
          counterpart: "arch/glass"
          destination: "inner"
        }
        source: session(destination: "inner", projection: window, resolution: [144, 120], fallback: "#FF00FF")
      }
    ]
    position [0, 1.5, -3]
    yawDegrees: 180deg
  }

  placement "backdrop" {
    prototype: "backdrop"
    position [0, 1.5, -12]
  }
}

prototypes {
  prototype "arch" {
    document {
      behavior {
        faces [
          {
            defaultSource: null
            name: "glass"
            shapeId: 0
          }
        ]
      }
      name: "arch"
      palette [
        {
          color: "#303030"
          roughness: 0.8
          sheen: 0
          specular: 0
        }
      ]
      schema: "puck.creation.v1"
      shape Box "rim" {
        material: 0
        position [0, 0, 0]
        scale [1.2, 1, 0.05]
      }

      shape Box "opening" {
        blend: "Subtraction"
        material: 0
        position [0, 0, 0]
        scale [1.15, 0.95, 0.3]
      }
    }
  }

  prototype "door" {
    document {
      behavior {
        faces [
          {
            defaultSource: null
            name: "glass"
            shapeId: 0
          }
        ]
      }
      name: "door"
      palette [
        {
          color: "#DDE8EA"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "panel" {
        material: 0
        position [0, 0, 0]
        scale [1.2, 1, 0.05]
      }
    }
  }

  prototype "backdrop" {
    document {
      name: "backdrop"
      palette [
        {
          color: "#2040FF"
          emissive: 0.5
          roughness: 0.8
          sheen: 0
          specular: 0
        }
      ]
      schema: "puck.creation.v1"
      shape Box "wall" {
        material: 0
        position [0, 0, 0]
        scale [12, 8, 0.1]
      }
    }
  }
}

references [
  {
    document: "inner"
    name: "inner"
  }
]

simulation {
  rateHz: 30
}
