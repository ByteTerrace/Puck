      { "type": "imageRegion", "name": "step-bilinear-column-30-is-an-eighth", "capture": "bilinear.png", "extent": [64, 192], "region": [0.46875, 0.03, 0.484375, 0.28], "reduce": "every", "minimum": [0.12549, 0.12549, 0.12549, 1], "maximum": [0.12549, 0.12549, 0.12549, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "step-bilinear-column-33-is-seven-eighths", "capture": "bilinear.png", "extent": [64, 192], "region": [0.515625, 0.03, 0.53125, 0.28], "reduce": "every", "minimum": [0.87451, 0.87451, 0.87451, 1], "maximum": [0.87451, 0.87451, 0.87451, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "step-bilinear-right-plateau-is-one", "capture": "bilinear.png", "extent": [64, 192], "region": [0.90625, 0.03, 0.921875, 0.28], "reduce": "every", "minimum": [1, 1, 1, 1], "maximum": [1, 1, 1, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "step-catmull-rom-column-30", "capture": "catmull-rom.png", "extent": [64, 192], "region": [0.46875, 0.03, 0.484375, 0.28], "reduce": "every", "minimum": [0.082353, 0.082353, 0.082353, 1], "maximum": [0.082353, 0.082353, 0.082353, 1], "toleranceCodes": 1, "holds": true },
      { "type": "imageRegion", "name": "step-catmull-rom-column-33", "capture": "catmull-rom.png", "extent": [64, 192], "region": [0.515625, 0.03, 0.53125, 0.28], "reduce": "every", "minimum": [0.917647, 0.917647, 0.917647, 1], "maximum": [0.917647, 0.917647, 0.917647, 1], "toleranceCodes": 1, "holds": true },
