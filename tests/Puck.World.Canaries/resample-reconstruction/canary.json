      { "type": "imageRegion", "name": "step-catmull-rom-right-plateau-is-one", "capture": "catmull-rom.png", "extent": [64, 192], "region": [0.90625, 0.03, 0.921875, 0.28], "reduce": "every", "minimum": [1, 1, 1, 1], "maximum": [1, 1, 1, 1], "toleranceCodes": 1, "holds": true },
