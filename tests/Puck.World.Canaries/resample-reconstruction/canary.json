      { "type": "imageRegion", "name": "edge-step-bilinear-column-2", "capture": "bilinear.png", "extent": [64, 192], "region": [0.03125, 0.72, 0.046875, 0.95], "reduce": "every", "minimum": [0.313725, 0.313725, 0.313725, 1], "maximum": [0.313725, 0.313725, 0.313725, 1], "toleranceCodes": 1, "holds": true },
