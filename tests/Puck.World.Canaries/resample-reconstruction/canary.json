{
  "id": "resample-reconstruction",
  "title": "The graph's resample pass reconstructs known steps at four times their extent exactly as bilinear and clamped Catmull-Rom predict",
  "binding": "The positive leg boots an offscreen world showing a two-pass pipeline: a seed pass writes a 16x48 source in three 16-row bands, and the package library's place kernel reconstructs it over the whole of a 64x192 output. Paused, each reset renders one frame. Band one steps from 0 to 1 between columns 7 and 8: at sharpness 0 the destination columns beside the edge hold the bilinear values 0.125 and 0.875 (codes 32 and 223), at sharpness 1 clamped Catmull-Rom's 0.0840 and 0.9160 (codes 21 and 234), from the weights at fractions 1/8 and 7/8, and the plateaus stay exactly 0 and 1. Band two steps from 0.25 to 0.75, which the 8-bit source stores as codes 64 and 191: column 30 holds 0.3132 bilinear and 0.2928 cubic (codes 80 and 75), and at column 29 the raw cubic undershoots to 0.2271 (code 58), so it holds 0.25 (code 64) only because the neighbourhood clamp bounds it by the central texels. Band three steps between source columns 0 and 1: destination column 2's cubic reaches past the image, and with its tap clamped to the edge texel it holds 0.2928 (code 75), where a wrapped tap would give 0.2690 (code 69). The discriminating leg renders the first frame at sharpness 1, so the bilinear observations turn red.",
  "bootShape": "offscreen",
  "backends": ["vulkan", "directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "fixtures": [
    "resample.graph.json",
    "seed.hlsl"
  ],
  "positive": {
    "world": "tests/Puck.World.Canaries/resample-reconstruction/fixture.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "pipeline.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.time", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.set", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.reset", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "pipeline.capture", "occurrence": 1, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 4, "outcome": "accepted" },
      { "verb": "pipeline.set", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.reset", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 5, "outcome": "accepted" },
      { "verb": "pipeline.capture", "occurrence": 2, "outcome": "accepted" },
      { "verb": "pipeline.wait", "occurrence": 6, "outcome": "accepted" }
    ],
    "expect": [
