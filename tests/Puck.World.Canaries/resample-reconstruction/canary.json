      { "type": "imageRegion", "name": "sharpened-column-33-is-not-bilinear", "capture": "bilinear.png", "extent": [64, 64], "region": [0.515625, 0.25, 0.53125, 0.75], "reduce": "every", "minimum": [0.87451, 0.87451, 0.87451, 1], "maximum": [0.87451, 0.87451, 0.87451, 1], "toleranceCodes": 1, "holds": false },
