{
  "$schema": "puck.render.graph.v1",
  "name": "resample",
  "resources": [
    {
      "name": "step",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Absolute", "width": 16, "height": 48 }
    },
    {
      "name": "resampled",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Absolute", "width": 64, "height": 192 }
    }
  ],
  "passes": [
    {
      "name": "seed",
      "source": "seed.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [ { "name": "step" } ]
    },
    {
      "name": "resample",
      "source": "../../../src/Puck.Shaders/Assets/Shaders/Graph/resample.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "inputs": [ { "name": "step", "as": "source" } ],
      "outputs": [ { "name": "resampled", "as": "destination" } ],
      "config": {
        "sharpness": {
          "default": 0,
          "max": 1,
          "description": "Reconstruction sharpness: 0 is bilinear, 1 clamped Catmull-Rom.",
          "min": 0,
          "type": "float"
        }
      }
    }
  ],
  "outputs": ["resampled"]
}
