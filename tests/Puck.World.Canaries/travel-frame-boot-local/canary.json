{
  "id": "travel-frame-boot-local",
  "title": "A local boot frame follows its body",
  "bootShape": "windowed",
  "requirements": ["gpu"],
  "seconds": 20,
  "timeoutSeconds": 45,
  "binding": "The positive leg captures quilt-nw, moves its body, and captures again; the control omits the body move so the same pixel observation turns red.",
  "fixtures": [],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "console", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "player.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 4, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "filesDiffer", "name": "moving the boot body changes the composed frame", "before": "before.png", "after": "after.png" },
      { "type": "line", "name": "both captures resolved", "stream": "stderr", "match": "contains", "text": "after.png", "present": true },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  },
  "discriminating": {
    "world": "src/Puck.World/Assets/worlds/quilt-nw.world.json",
    "script": "discriminating.script.txt",
    "commands": [
      { "verb": "console", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 3, "outcome": "accepted" },
      { "verb": "world.screenshot", "occurrence": 2, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 4, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "filesDiffer", "name": "without a body move the two frames stay identical", "before": "before.png", "after": "after.png", "different": false },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  }
}
