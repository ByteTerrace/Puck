{
  "$schema": "puck.render.graph.v1",
  "name": "sharpen",
  "resources": [
    {
      "name": "step",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 16,
        "height": 48
      }
    },
    {
      "name": "base",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 16,
        "height": 48
      },
      "initialization": "Zero"
    },
    {
      "name": "sharpened",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": {
        "mode": "Absolute",
        "width": 16,
        "height": 48
      }
    }
  ],
  "passes": [
    {
      "name": "seed",
      "source": "seed.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [
        {
          "name": "step"
        }
      ]
    },
    {
      "name": "place",
      "source": "../../../src/Puck.Shaders/Assets/Shaders/Graph/place.comp.hlsl",
      "entryPoint": "CSMain",
      "kind": "Compute",
      "inputs": [
        {
          "name": "base"
        },
        {
          "name": "step",
          "as": "source"
        }
      ],
      "outputs": [
        {
          "name": "sharpened",
          "as": "destination"
        }
      ],
      "config": {
        "compareMode": {
          "type": "uint",
          "default": 0,
          "min": 0,
          "max": 3,
          "description": "0 places normally; comparison modes use a held source and the base image's current rect."
        },
        "letterbox": {
          "type": "uint",
          "default": 0,
          "min": 0,
          "max": 1,
          "description": "1 fills the destination outside the rect with the letterbox color rather than the base."
        },
        "rect": {
          "type": "float4",
          "default": [
            0,
            0,
            1,
            1
          ],
          "min": 0,
          "max": 1,
          "description": "The destination rect as fractions of the destination extent: left, top, width, height."
        },
        "sharpen": {
          "type": "uint",
          "default": 0,
          "min": 0,
          "max": 1,
          "description": "1 sharpens a source at the rect's own extent by a contrast-adaptive sharpen of the sharpness's strength; 0 keeps its exact copy."
        },
        "sharpness": {
          "type": "float",
          "default": 0,
          "min": 0,
          "max": 1,
          "description": "Reconstruction sharpness: 0 is bilinear, 1 clamped Catmull-Rom."
        },
        "tonemap": {
          "type": "uint",
          "default": 0,
          "min": 0,
          "max": 1,
          "description": "1 puts the reconstructed source through the filmic tonemap inside the rect; the base and the letterbox color are never tonemapped."
        },
        "wipe": {
          "type": "float",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "description": "The held image's fraction of the rect in wipe mode."
        }
      }
    }
  ],
  "outputs": [
    "sharpened"
  ]
}
