{
  "id": "rulepush-overworld",
  "title": "A rulepush level cleared on the visitor's record opens the overworld's west gate",
  "binding": "Boots the rulepush overworld with a fresh identity bound to the seat. The seat walks across the east border into Hedges and clears it with the puzzle presses, which writes 'pushCleared' onto its own identity; it walks back, north into Rewrite, clears it ('rewriteCleared'), and back again. The overworld's own rule reads both facts off the identity that arrived with the body, opens the west gate, and the respond facet swaps the solid gate for the open one; the seat then walks west into Sink and clears it too. Nothing crosses between the worlds but the body and its identity. The discriminating leg leaves Rewrite unsolved, so the record carries one clear, the gate stays shut, and the walk west ends at the gate.",
  "bootShape": "headless",
  "requirements": [],
  "timeoutSeconds": 60,
  "fixtures": [],
  "positive": {
    "expect": [
      {
        "name": "hedges-cleared-on-the-record",
        "present": true,
        "match": "contains",
        "text": "facts=pushCleared:1]",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "rewrite-cleared-on-the-record",
        "present": true,
        "match": "contains",
        "text": "facts=pushCleared:1,rewriteCleared:1]",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "gate-shut-after-one-clear",
        "present": true,
        "match": "contains",
        "text": "'westOpen'.'$value' value=0",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "gate-open-after-two-clears",
        "present": true,
        "match": "contains",
        "text": "'westOpen'.'$value' value=1",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "gate-swapped-open",
        "present": true,
        "match": "contains",
        "text": "'westGate' prototype=gateOpen",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "walked-through-into-sink",
        "present": true,
        "match": "contains",
        "text": "link~west' seat 1 arrived as impfan",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "sink-cleared-on-the-record",
        "present": true,
        "match": "contains",
        "text": "facts=pushCleared:1,rewriteCleared:1,sinkCleared:1]",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "no-rule-refusal",
        "present": false,
        "match": "contains",
        "text": "effect refused",
        "stream": "stderr",
        "type": "line"
      },
      {
        "name": "clean-wire",
        "present": true,
        "match": "contains",
        "text": "[wire.errors: 0 rejected]",
        "stream": "stdout",
        "type": "line"
      }
    ],
