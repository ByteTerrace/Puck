{
  "id": "source-conversion",
  "title": "The shipped palette and NV12 conversion passes turn uploaded source regions into the pixels the CPU reference computes",
  "binding": "The positive leg boots an offscreen world whose one pipeline seeds a 32x32 palette-indexed region and a 32x32 NV12 region in the uploaded-source layout, runs the shipped source-palette and source-nv12 kernels from src/Puck.Shaders over them, and captures each converted image paused. Each quadrant of the palette image is the palette entry (i, 255 - i, 3i mod 256) its index selects, and each quadrant of the NV12 image is the BT.709 limited-range conversion of its Y, Cb, Cr sample, clamped; every expectation is the CPU reference ImageSourceConversion applied to the same regions, which SourceConversionCanaryFixtureTests recomputes. The discriminating leg names BT.601 in the NV12 header and raises every palette index by one: the neutral white quadrant holds, and every other quadrant turns to the value the changed header or index predicts.",
  "bootShape": "offscreen",
  "backends": ["vulkan", "directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "fixtures": ["conversion.pipeline.json", "discriminating.pipeline.json", "seed.hlsl", "seed-discriminating.hlsl"],
  "positive": {
    "world": "tests/Puck.World.Canaries/source-conversion/fixture.world.json",
    "script": "conversion.script.txt",
    "commands": [
