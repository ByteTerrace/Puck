        "verb": "pipeline.wait",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "pipeline.wait",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "pipeline.time",
