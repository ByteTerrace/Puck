{
  "$schema": "puck.render.graph.v1",
  "name": "conversion",
  "resources": [
    {
      "name": "palette-region",
      "kind": "Buffer",
      "sizeBytes": 2080
    },
    {
      "name": "nv12-region",
      "kind": "Buffer",
      "sizeBytes": 1568
    },
    {
      "name": "palette",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }
    },
    {
      "name": "nv12",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }
    }
  ],
  "passes": [
    {
      "name": "seed",
      "source": "seed-discriminating.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "outputs": [ { "name": "palette-region" }, { "name": "nv12-region" } ]
    },
    {
      "name": "convert-palette",
      "source": "../../../src/Puck.Shaders/Assets/Shaders/Sources/source-palette.comp.hlsl",
      "entryPoint": "CSMain",
      "kind": "Compute",
      "inputs": [ { "name": "palette-region", "as": "region" } ],
      "outputs": [ { "name": "palette", "as": "image" } ]
    },
    {
      "name": "convert-nv12",
      "source": "../../../src/Puck.Shaders/Assets/Shaders/Sources/source-nv12.comp.hlsl",
      "entryPoint": "CSMain",
      "kind": "Compute",
      "inputs": [ { "name": "nv12-region", "as": "region" } ],
      "outputs": [ { "name": "nv12", "as": "image" } ]
    }
  ],
  "outputs": ["palette", "nv12"]
}
