{
  "id": "gpu-pass-timing",
  "title": "Per-pass GPU timestamp pairs publish after completion only while the readout is demanded",
  "binding": "The still world node starts with timing disabled, enables the neutral timestamp service, advances ten frames, and prints its completed primary-pass sample count. It then disables and drains the in-flight slots before inspection reports no timestamp readback bytes. The discriminating leg leaves timing disabled and therefore never publishes a timestamp pair. Both backends run with their native timestamp pools and validation enabled. Neither elapsed milliseconds nor frame rate is a correctness threshold. CPU laws separately prove zero off-state pool/query operations, exactly paired queries, fence and epoch rejection, named creation-fault wrapping and device-loss release.",
  "bootShape": "offscreen",
  "backends": [
    "vulkan",
    "directx"
  ],
  "requirements": [
    "gpu"
  ],
  "timeoutSeconds": 60,
  "positive": {
    "world": "tests/Puck.World.Canaries/world-counters/fixture.world.json",
    "script": "positive.script.txt",
    "commands": [
      {
        "verb": "world.cadence",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 3,
        "outcome": "accepted"
      },
      {
        "verb": "pipeline.inspect",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 4,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 3,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 5,
        "outcome": "accepted"
      },
      {
        "verb": "pipeline.inspect",
        "occurrence": 2,
        "outcome": "accepted"
      }
    ],
    "expect": [
      {
        "type": "line",
        "name": "timestamps-start-off",
        "stream": "stdout",
        "match": "contains",
        "text": "[world.gpu-timing: off window=32]",
        "present": true
      },
      {
        "type": "line",
        "name": "completed-native-pair-is-published",
        "stream": "stdout",
        "match": "contains",
        "text": "world/sdf.world$primary:",
        "present": true
      },
      {
        "type": "line",
        "name": "completed-readout-has-samples",
        "stream": "stdout",
        "match": "contains",
        "text": " ms samples=",
        "present": true
      },
      {
        "type": "line",
        "name": "disabled-query-memory-is-released",
        "stream": "stdout",
        "match": "contains",
        "text": "timing-readback-bytes=0",
        "present": true
      }
    ]
  },
  "discriminating": {
    "world": "tests/Puck.World.Canaries/world-counters/fixture.world.json",
    "script": "discriminating.script.txt",
    "commands": [
      {
        "verb": "world.cadence",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 2,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 3,
        "outcome": "accepted"
      },
      {
        "verb": "pipeline.inspect",
        "occurrence": 1,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 4,
        "outcome": "accepted"
      },
      {
        "verb": "world.wait",
        "occurrence": 3,
        "outcome": "accepted"
      },
      {
        "verb": "world.gpu-timing",
        "occurrence": 5,
        "outcome": "accepted"
      },
      {
        "verb": "pipeline.inspect",
        "occurrence": 2,
        "outcome": "accepted"
      }
    ],
    "expect": [
      {
        "type": "line",
        "name": "timestamps-start-off",
        "stream": "stdout",
        "match": "contains",
        "text": "[world.gpu-timing: off window=32]",
        "present": true
      },
      {
        "type": "line",
        "name": "completed-native-pair-is-published",
        "stream": "stdout",
        "match": "contains",
        "text": "world/sdf.world$primary:",
        "present": false
      },
      {
        "type": "line",
        "name": "completed-readout-has-samples",
        "stream": "stdout",
        "match": "contains",
        "text": " ms samples=",
        "present": false
      },
      {
        "type": "line",
        "name": "disabled-query-memory-is-released",
        "stream": "stdout",
        "match": "contains",
        "text": "timing-readback-bytes=0",
        "present": true
      }
    ]
  }
}
