{
  "$schema": "puck.shader.pipeline.v1",
  "name": "feedback",
  "resources": [
    {
      "name": "history",
      "kind": "Image",
      "format": "R16G16B16A16Float",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 },
      "history": true,
      "initialization": "Zero"
    },
    {
      "name": "stale",
      "kind": "Image",
      "format": "R16G16B16A16Float",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 },
      "history": true,
      "initialization": "Zero"
    },
    {
      "name": "gray",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }
    },
    {
      "name": "image",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Absolute", "width": 32, "height": 32 }
    }
  ],
  "passes": [
    {
      "name": "accumulate",
      "source": "accumulate.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "inputs": [ { "name": "stale", "previousFrame": true, "binding": 1 } ],
      "outputs": [ { "name": "history", "binding": 0 } ]
    },
    {
      "name": "convert",
      "source": "convert.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "inputs": [ { "name": "history", "binding": 1 } ],
      "outputs": [ { "name": "gray", "binding": 0 } ]
    },
    {
      "name": "copy",
      "source": "copy.hlsl",
      "entryPoint": "main",
      "kind": "Fullscreen",
      "inputs": [ { "name": "gray", "binding": 0 } ],
      "outputs": [ { "name": "image" } ]
    }
  ],
  "outputs": ["image"]
}
