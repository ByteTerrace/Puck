{
  "$schema": "puck.render.graph.v1",
  "name": "feedback",
  "resources": [
    {
      "name": "history",
      "kind": "Image",
      "format": "R16G16B16A16Float",
      "dimensions": { "mode": "Absolute", "width": 64, "height": 64 },
      "history": true,
      "initialization": "Zero"
    },
    {
      "name": "gray",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Relative", "width": 1, "height": 1 }
    },
    {
      "name": "image",
      "kind": "Image",
      "format": "R8G8B8A8Unorm",
      "dimensions": { "mode": "Relative", "width": 1, "height": 1 }
    }
  ],
  "passes": [
    {
      "name": "accumulate",
      "source": "../pipeline-feedback/accumulate.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "inputs": [ { "name": "history", "previousFrame": true } ],
      "outputs": [ { "name": "history" } ]
    },
    {
      "name": "convert",
      "source": "../pipeline-feedback/convert.hlsl",
      "entryPoint": "main",
      "kind": "Compute",
      "inputs": [ { "name": "history" } ],
      "outputs": [ { "name": "gray" } ]
    },
    {
      "name": "copy",
      "source": "../pipeline-feedback/copy.hlsl",
      "entryPoint": "main",
      "kind": "Fullscreen",
      "inputs": [ { "name": "gray" } ],
      "outputs": [ { "name": "image" } ]
    }
  ],
  "outputs": ["image", "history"]
}
