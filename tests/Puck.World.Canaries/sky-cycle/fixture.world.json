{
  "host": {
    "authority": null,
    "backend": "auto",
    "exitAfterSeconds": 0,
    "fullscreen": false,
    "genlock": null,
    "height": 256,
    "journalDepth": 2000,
    "listen": null,
    "presentMode": "Immediate",
    "presentation": "offscreen",
    "surfaceFormat": "r8g8b8a8",
    "targetHertz": 0,
    "width": 256
  },
  "render": {
    "farDistance": 100,
    "sky": {
      "clock": "skyMode",
      "keys": [
        {
          "at": 0,
          "layers": {
            "air": {
              "$type": "gradient",
              "stops": [
                {
                  "color": "#B6B2BA",
                  "elevation": -1
                },
                {
                  "color": "#B6B2BA",
                  "elevation": -0.05
                },
                {
                  "color": "#B6B2BA",
                  "elevation": 0.35
                },
                {
                  "color": "#B6B2BA",
                  "elevation": 1
                }
              ]
            },
            "haze": {
              "$type": "fog",
              "density": 0
            },
            "sun": {
              "$type": "sunDisc",
              "intensity": 0
            }
          }
        },
        {
          "at": 0.5,
          "layers": {
            "air": {
              "$type": "gradient",
              "stops": [
                {
                  "color": "#9AABB7",
                  "elevation": -1
                },
                {
                  "color": "#D5DCE0",
                  "elevation": -0.05
                },
                {
                  "color": "#7CA7C6",
                  "elevation": 0.35
                },
                {
                  "color": "#3C658F",
                  "elevation": 1
                }
              ]
            },
            "haze": {
              "$type": "fog",
              "density": 0.004
            },
            "sun": {
              "$type": "sunDisc",
              "intensity": 1.5
            }
          }
        }
      ],
      "layers": [
        {
          "$type": "gradient",
          "name": "air",
          "stops": [
            {
              "color": "#9AABB7",
              "elevation": -1
            },
            {
              "color": "#D5DCE0",
              "elevation": -0.05
            },
            {
              "color": "#7CA7C6",
              "elevation": 0.35
            },
            {
              "color": "#3C658F",
              "elevation": 1
            }
          ]
        },
        {
          "$type": "fog",
          "density": 0.004,
          "name": "haze"
        },
        {
          "$type": "sunDisc",
          "intensity": 1.5,
          "light": 0,
          "name": "sun",
          "radius": 0.018
        }
      ]
    }
  },
  "schema": "puck.world.definition.v1",
  "views": {
    "layouts": [
      {
        "name": "world",
        "seatCount": 0,
        "slots": [
          {
            "camera": "sky-cam",
            "height": 1,
            "width": 1,
            "x": 0,
            "y": 0
          }
        ],
        "transitionRenderScale": 1,
        "transitionSeconds": 0.25
      }
    ],
    "seatControl": {
      "maxPitch": 0.01,
      "minPitch": -0.01,
      "yawReference": "World"
    },
    "seatRig": {
      "name": "world",
      "operations": [
        {
          "$type": "orbit",
          "distance": 0.01,
          "pitch": 0.45,
          "yaw": 0
        },
        {
          "$type": "fieldOfView",
          "fieldOfViewRadians": 1.4
        }
      ],
      "version": "puck.camera.program.v1"
    }
  },
  "state": {
    "world": [
      {
        "name": "skyMode",
        "kind": "Fixed",
        "value": "0.5"
      }
    ]
  },
  "timeline": {
    "clocks": [
      {
        "name": "skyMode",
        "state": "skyMode"
      }
    ]
  },
  "cameras": [
    {
      "name": "sky-cam",
      "renderWidth": 256,
      "renderHeight": 256,
      "rig": {
        "name": "sky-cam",
        "version": "puck.camera.program.v1",
        "operations": [
          {
            "$type": "anchor",
            "subject": {
              "$type": "worldPoint",
              "point": [
                0,
                0,
                0
              ]
            }
          },
          {
            "$type": "lookAt",
            "subject": {
              "$type": "worldPoint",
              "point": [
                0,
                0.5,
                -1
              ]
            }
          },
          {
            "$type": "fieldOfView",
            "fieldOfViewRadians": 1.4
          }
        ]
      }
    }
  ]
}
