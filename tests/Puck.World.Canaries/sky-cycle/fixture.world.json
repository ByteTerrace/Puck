{
  "host": {
    "authority": null,
    "backend": "auto",
    "exitAfterSeconds": 0,
    "fullscreen": false,
    "genlock": null,
    "height": 256,
    "journalDepth": 2000,
    "listen": null,
    "presentMode": "Immediate",
    "presentation": "offscreen",
    "surfaceFormat": "r8g8b8a8",
    "targetHertz": 0,
    "width": 256
  },
  "render": {
    "farDistance": 100,
    "sky": {
      "layers": [
        {
          "$type": "gradient",
          "stops": [
            {
              "color": "#9AABB7",
              "elevation": -1,
              "name": "stop0"
            },
            {
              "color": "#D5DCE0",
              "elevation": -0.05,
              "name": "stop1"
            },
            {
              "color": "#7CA7C6",
              "elevation": 0.35,
              "name": "stop2"
            },
            {
              "color": "#3C658F",
              "elevation": 1,
              "name": "stop3"
            }
          ],
          "name": "gradient"
        },
        {
          "$type": "fog",
          "density": 0.004,
          "name": "fog"
        },
        {
          "$type": "sunDisc",
          "intensity": 1.5,
          "light": 0,
          "radius": 0.018,
          "name": "sunDisc"
        }
      ]
    },
    "keys": {
      "clock": "skyMode",
      "keys": [
        {
          "at": 0,
          "sky": {
            "layers": {
              "gradient": {
                "stops": {
                  "stop0": {
                    "color": "#B6B2BA",
                    "elevation": -1
                  },
                  "stop1": {
                    "color": "#B6B2BA",
                    "elevation": -0.05
                  },
                  "stop2": {
                    "color": "#B6B2BA",
                    "elevation": 0.35
                  },
                  "stop3": {
                    "color": "#B6B2BA",
                    "elevation": 1
                  }
                }
              },
              "fog": {
                "density": 0
              },
              "sunDisc": {
                "intensity": 0
              }
            }
          }
        },
        {
          "at": 0.5,
          "sky": {
            "layers": {
              "gradient": {
                "stops": {
                  "stop0": {
                    "color": "#9AABB7",
                    "elevation": -1
                  },
                  "stop1": {
                    "color": "#D5DCE0",
                    "elevation": -0.05
                  },
                  "stop2": {
                    "color": "#7CA7C6",
                    "elevation": 0.35
                  },
                  "stop3": {
                    "color": "#3C658F",
                    "elevation": 1
                  }
                }
              },
              "fog": {
                "density": 0.004
              },
              "sunDisc": {
                "intensity": 1.5
              }
            }
          }
        }
      ]
    }
  },
  "schema": "puck.world.definition.v1",
  "views": {
    "layouts": [
      {
        "name": "world",
        "seatCount": 0,
        "slots": [
          {
            "camera": "sky-cam",
            "height": 1,
            "width": 1,
            "x": 0,
            "y": 0
          }
        ],
        "transitionRenderScale": 1,
        "transitionSeconds": 0.25
      }
    ],
    "seatControl": {
      "maxPitch": 0.01,
      "minPitch": -0.01,
      "yawReference": "World"
    },
    "seatRig": {
      "name": "world",
      "operations": [
        {
          "$type": "orbit",
          "distance": 0.01,
          "pitch": 0.45,
          "yaw": 0
        },
        {
          "$type": "fieldOfView",
          "fieldOfViewRadians": 1.4
        }
      ],
      "version": "puck.camera.program.v1"
    }
  },
  "state": {
    "world": [
      {
        "name": "skyMode",
        "kind": "Fixed",
        "value": "0.5"
      }
    ]
  },
  "cameras": [
    {
      "name": "sky-cam",
      "renderWidth": 256,
      "renderHeight": 256,
      "rig": {
        "name": "sky-cam",
        "version": "puck.camera.program.v1",
        "operations": [
          {
            "$type": "anchor",
            "subject": {
              "$type": "worldPoint",
              "point": [
                0,
                0,
                0
              ]
            }
          },
          {
            "$type": "lookAt",
            "subject": {
              "$type": "worldPoint",
              "point": [
                0,
                0.5,
                -1
              ]
            }
          },
          {
            "$type": "fieldOfView",
            "fieldOfViewRadians": 1.4
          }
        ]
      }
    }
  ],
  "timeline": {
    "clocks": [
      {
        "name": "skyMode",
        "state": "skyMode"
      }
    ]
  }
}
