{
  "id": "seamless-adjacency",
  "title": "An invisible adjacency hands off authority and exposes the remote entity",
  "bootShape": "headless",
  "requirements": [],
  "seconds": 30,
  "timeoutSeconds": 280,
  "binding": "Both legs boot the same quilt-nw shard over the island basis, prove authored ground reaches the invisible east seam, and require grounded contacts with zero wire errors. Only the positive leg flies east, so its post-crossing contacts must follow the seat authority and only it can emit a handoff and expose a generation-addressed NE entity through NW's delivered neighbour image.",
  "fixtures": [],
  "positive": {
    "world": "src/Puck.World/Assets/worlds/shards/quilt-nw.world.json",
    "script": "positive.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.collision.probe", "occurrence": 1, "outcome": "accepted" },
      { "verb": "body.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "body.fly", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "body.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.adjacencies", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "response", "name": "ground reaches near the invisible seam", "stream": "stdout", "verb": "world.collision.probe", "occurrence": 1, "count": 1, "extract": [{ "name": "seamGroundDistance", "field": "distance" }] },
      { "type": "relation", "name": "the seam probe finds nw's own solid ground, not open air", "left": { "value": "seamGroundDistance" }, "operator": "atMost", "maximum": 0.6 },
      { "type": "response", "name": "the crossed body has a resting height", "stream": "stdout", "verb": "body.where", "occurrence": 1, "count": 1, "extract": [{ "name": "restY", "field": "pos", "component": 1 }] },
      { "type": "relation", "name": "the crossed body rests on NE's authored floor", "left": { "value": "restY" }, "operator": "betweenInclusive", "minimum": -0.49, "maximum": -0.47 },
      { "type": "response", "name": "contacts follows the seat authority", "stream": "stdout", "verb": "world.contacts", "occurrence": 1, "count": 1, "extract": [{ "name": "grounded", "field": "grounded" }] },
      { "type": "relation", "name": "the crossed body remains grounded", "left": { "value": "grounded" }, "operator": "equal", "right": { "literal": "true" } },
      { "type": "line", "name": "automatic adjacency handoff fired", "stream": "stdout", "match": "contains", "text": "[world.adjacency: 'boot/east' seat 1 crossed", "present": true },
      { "type": "line", "name": "remote entity carries authority slot and generation", "stream": "stdout", "match": "contains", "text": "entities=6~global2~ne/0:1", "present": true },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  },
  "discriminating": {
    "world": "src/Puck.World/Assets/worlds/shards/quilt-nw.world.json",
    "script": "discriminating.script.txt",
    "commands": [
      { "verb": "wire.errors", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.collision.probe", "occurrence": 1, "outcome": "accepted" },
      { "verb": "body.pose", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.wait", "occurrence": 1, "outcome": "accepted" },
      { "verb": "body.where", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.contacts", "occurrence": 1, "outcome": "accepted" },
      { "verb": "world.adjacencies", "occurrence": 1, "outcome": "accepted" },
      { "verb": "wire.errors", "occurrence": 2, "outcome": "accepted" }
    ],
    "expect": [
      { "type": "response", "name": "control ground reaches near the invisible seam", "stream": "stdout", "verb": "world.collision.probe", "occurrence": 1, "count": 1, "extract": [{ "name": "seamGroundDistance", "field": "distance" }] },
      { "type": "relation", "name": "the control seam probe finds nw's own solid ground, not open air", "left": { "value": "seamGroundDistance" }, "operator": "atMost", "maximum": 0.6 },
      { "type": "response", "name": "control body has a resting height", "stream": "stdout", "verb": "body.where", "occurrence": 1, "count": 1, "extract": [{ "name": "restY", "field": "pos", "component": 1 }] },
      { "type": "relation", "name": "control body rests on nw's own floor", "left": { "value": "restY" }, "operator": "betweenInclusive", "minimum": -0.49, "maximum": -0.47 },
      { "type": "response", "name": "control contacts answers", "stream": "stdout", "verb": "world.contacts", "occurrence": 1, "count": 1, "extract": [{ "name": "grounded", "field": "grounded" }] },
      { "type": "relation", "name": "control body remains grounded", "left": { "value": "grounded" }, "operator": "equal", "right": { "literal": "true" } },
      { "type": "response", "name": "adjacency read-back answered", "stream": "stdout", "verb": "world.adjacencies", "occurrence": 1, "count": 1, "extract": [] },
      { "type": "line", "name": "no automatic handoff without a crossing", "stream": "stdout", "match": "contains", "text": "[world.adjacency: 'boot/east' seat 1 crossed", "present": false },
      { "type": "line", "name": "no remote entity without a crossing", "stream": "stdout", "match": "contains", "text": "entities=6~global2~ne/0:1", "present": false },
      { "type": "line", "name": "no unhandled exception", "stream": "stderr", "match": "contains", "text": "Unhandled exception", "present": false }
    ]
  }
}
