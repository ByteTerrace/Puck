schema: "puck.world.definition.v1"
documentId: "flow-conservation-live-canary-discriminating"

simulation {
  rateHz: 240
}

state {
  world {
    row {
      name: "water"
      kind: "Fixed"
      domain: cellsOf(topology: channel)
      field {
        initial: 0
        min: 0
        max: 1000
        heightScale: 0
      }
    }

    slot spill = 0.0 bounds(0.0..1000000.0)
  }

  lattices [
    field(name: "channel", origin: [0, 0, 0], cellSize: 1, width: 3, depth: 1, layers: 1, stepEveryTicks: 1, reactions: [
      flow(field: water, rate: 1, spillRow: spill)
    ]
    )
  ]
}
