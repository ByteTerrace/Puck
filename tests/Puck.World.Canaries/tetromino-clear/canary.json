{
  "id": "tetromino-clear",
  "title": "Three tetromino pieces lock and the row they complete clears",
  "binding": "Boots the tetromino world and plays it with the seat's own presses. The bottom row starts with columns 6 to 9 filled and the next three pieces set to O through the bag's cell. The first O moves to the left wall and hard-drops, the second drops beside it, and the third drops where it appears, which completes the bottom row: three pieces lock, one row clears, and the row above drops into its place. The run is recorded and replays exactly. The discriminating leg moves the third O one column right, where it rests on the filled columns a row higher and leaves column 4 open, so nothing clears.",
  "bootShape": "headless",
  "requirements": [],
  "timeoutSeconds": 60,
  "fixtures": [],
  "positive": {
    "expect": [
      {
        "name": "three-locked",
        "present": true,
        "match": "contains",
        "text": "'locked'.'$value' value=3",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "one-row-cleared",
        "present": true,
        "match": "contains",
        "text": "'lines'.'$value' value=1",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "row-above-dropped",
        "present": true,
        "match": "contains",
        "text": "'well'.'23' value=57855",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "replay-match",
        "present": true,
        "match": "contains",
        "text": "[replay.verify: 'tetromino-clear' | MATCH",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "no-rule-refusal",
