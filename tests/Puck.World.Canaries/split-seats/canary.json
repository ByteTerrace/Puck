      { "type": "imageRegion", "name": "the-left-half-is-seat-1-at-the-wall", "capture": "split.png", "extent": [1280, 800], "region": [0.05, 0.1, 0.45, 0.6], "reduce": "mean", "minimum": [0, 0, 0, 1], "maximum": [0.3, 0.3, 0.3, 1], "toleranceCodes": 2, "holds": true },
