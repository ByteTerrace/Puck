schema: "puck.world.definition.v1"
basis: "../gi-furnace/base"
documentId: "indirect-off-scene"
render { indirect { tier: off } }
placements { placement "floor" { prototype: "floor", position [0, 0, 0] } }
cameras [{
  name: "floor"
  anchor: null
  renderWidth: 128
  renderHeight: 128
  rig {
    name: "floor"
    version: "puck.camera.program.v1"
    operations [
      anchor(subject: worldPoint(point: [0, 1, 1.2]))
      lookAt(subject: worldPoint(point: [0, 0, 0]))
      fieldOfView(fieldOfViewRadians: 0.65)
    ]
  }
}]
views {
  layout "physical" {
    seatCount: 0
    slots [{ camera: "floor", x: 0, y: 0, width: 1, height: 1 }]
    transitionSeconds: 0
    transitionRenderScale: 1
  }
}
