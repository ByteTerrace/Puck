      {"type":"line","name":"no-unhandled","stream":"stderr","match":"contains","text":"Unhandled exception","present":false},
      {"type":"imageDifference","name":"off-is-identical-after-completed-on","capture":"off-after.png","reference":"off-before.png","extent":[128,128],"region":[0.4,0.4,0.6,0.6],"maximumMeanCodes":0,"holds":true},
      {"type":"imageDifference","name":"off-is-identical-to-fresh-filled-boot","capture":"off-after.png","reference":"off-reference.png","extent":[128,128],"region":[0.4,0.4,0.6,0.6],"maximumMeanCodes":0,"holds":false},
