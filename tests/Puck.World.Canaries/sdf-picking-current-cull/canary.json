{
  "id": "sdf-picking-current-cull",
  "title": "A stationary sample rejects an old hit outside the current GPU cull box",
  "binding": "A fixed camera sees one centered block. Both legs read the exact center pixel, then edit the same placement row and read that pixel again. The positive leg moves the only block right, leaving the old center outside the new cull box; the discriminating leg keeps it centered. Visibility storage can retain the old center row, so only validation against the same submission's GPU cull bounds rejects it. The composed visibility image and the occurrence-scoped pick answer must both identify the current center as background after motion. No anchor keeps the old center in the dispatch box.",
  "bootShape": "offscreen",
  "backends": [
    "vulkan",
    "directx"
  ],
  "requirements": [
    "gpu"
  ],
  "timeoutSeconds": 60,
