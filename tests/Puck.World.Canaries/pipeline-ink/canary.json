      { "type": "imageRegion", "name": "exposure-one-distant-background", "capture": "exposure-one.png", "extent": [256, 256], "region": [0.2, 0.2, 0.3, 0.3], "reduce": "every", "minimum": [0.0162, 0.0243, 0.054, 1], "maximum": [0.018, 0.027, 0.06, 1], "toleranceCodes": 1, "holds": true }
    ]
