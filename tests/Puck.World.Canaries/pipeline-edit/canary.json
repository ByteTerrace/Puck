{
  "id": "pipeline-edit",
  "title": "A broken middle-pass edit leaves the installed feedback graph producing, and a corrected edit replaces it whole and renders on the next step",
  "binding": "Both legs boot the pipeline-feedback graph offscreen, pause, reset and step to submission 2 (2/16), then load an edit whose middle pass does not compile: pipeline.wait compiled reports failed, the paused capture still reads 2/16, and one step renders 3/16 through the installed graph. The positive leg then loads a corrected edit whose middle pass writes one minus the history; it compiles and, a reload not being a step, installs without rendering, so the paused capture still reads 3/16; the next step renders submission 4 through the whole corrected graph over the retained history as 1 - 4/16 = 0.75, derived from the arithmetic rather than recorded. The discriminating leg loads the broken edit again instead, so the step renders submission 4 through the old graph as 4/16 = 0.25 and the positive's post-edit oracle turns red.",
  "bootShape": "offscreen",
  "backends": ["vulkan", "directx"],
  "requirements": ["gpu"],
  "timeoutSeconds": 60,
  "fixtures": [
    "broken.graph.json",
    "corrected.graph.json",
    "convert-broken.hlsl",
    "convert-inverted.hlsl"
  ],
  "positive": {
