<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- The harness dynamically compiles source through runtime-loaded assemblies. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- The compiler this suite drives: every case is a source string compiled in memory and handed to the
             analyzer, so the test project needs the same Roslyn surface the analyzer is written against. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.*, )" />
    </ItemGroup>
    <ItemGroup>
        <!-- Directory.Build.props hands every project Puck.Analyzers as a compiler extension
             (OutputItemType="Analyzer", ReferenceOutputAssembly="false"). This suite instead needs the analyzer as
             an ordinary assembly reference, because it instantiates each analyzer directly and drives it over
             compilations it builds itself. Running the analyzer over this project as well would only add a second,
             uncontrolled execution whose diagnostics are not the ones under test. -->
        <ProjectReference
            Update="../../src/Puck.Analyzers/Puck.Analyzers.csproj"
            OutputItemType=""
            ReferenceOutputAssembly="true"
        />
    </ItemGroup>
</Project>
