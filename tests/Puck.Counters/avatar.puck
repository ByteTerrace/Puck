// The seated-avatar counters workload: the debug world as played at 1280x720 before the default third-person camera,
// driven offscreen by avatar.script.txt.

schema: "puck.world.definition.v1"
basis: "../../worlds/debug/debug"
documentId: "counters-avatar"

host {
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  height: 720
  listen: null
  presentMode: Immediate
  presentation: offscreen
  targetHertz: 0
  width: 1280
}

simulation {
  rateHz: 30
}
