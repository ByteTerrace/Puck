schema: "puck.world.definition.v1"
basis: "../../Puck.World.Canaries/indirect-near/scenes"
documentId: "indirect-comparison"

host { width: 1920, height: 1080 }

// Both measured tiers explicitly cast and receive through this real stationary body.
// The zero-seat catch-all layout below keeps both named cameras when this eager seat joins.
bodies { localSeats: 1, capacity: 1, seatSpawns ["comparison-body"] }
spawnPoints [{ id: "comparison-body", position [-0.12, 0, 0.15], yawDegrees: 0 }]
channels [
  { name: "forward", shape: Bipolar, role: MoveAdvance }
  { name: "strafe", shape: Bipolar, role: MoveStrafe }
  { name: "turn", shape: Bipolar, role: Turn }
]
bodyMotionPrograms [{ name: "stander", version: "puck.body.program.v1", kind: Motion,
  operations [ResolveYawAttitudeAndPlanarFrame, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, IntegratePlanarAndVerticalVelocity, CommitPose] }]
kits { rows [{ name: "stander", bodyMotionProgram: "stander",
  motion { speed { value: 0 } turn { rate: 0 } holds [{ name: "air", bond: Free, hold: None }] },
  collider: sphere(radius: 0.06), bodyContact: Overlap }] }
defaultSeatKit: "stander"
looks { rows [{ name: "comparison-body", source: creation(prototypeId: `comparison-body`), scale: 1,
  motion { gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 } }] }
prototypes {
  prototype "comparison-body" { document {
    schema: "puck.creation.v1"
    name: "comparison-body"
    palette [{ color: "#FF0000", roughness: 1, specular: 0, fill: "#000000", bleed: "#FFFFFF", receive: 1 }]
    shape Sphere "body" { material: 0, position [0, 0.06, 0], scale [0.06, 0.06, 0.06] }
  } }
}

state {
  world {
    slot cameraPose = 0
    slot orbitYaw = 0.0
    slot orbitRunning = 0
    slot dayPhase = 0.25
    slot dayRunning = 0
  }
}
timeline { clocks [{ name: "comparison-day", state: dayPhase }] }
rule "advance-day" {
  when dayRunning == 1
  mode: Level
  dayPhase += 0.001
}
rule "advance-orbit" {
  when orbitRunning == 1
  mode: Level
  orbitYaw += 0.005
}
render {
  indirect { bodies: Cast }
  lighting {
    lights [
      directional(name: "source-key", direction: {
        clock: `comparison-day`
        keys [
          { at: 0, value [-1, 0.2, 0] }
          { at: 0.5, value [-0.3, 0.8, -0.5] }
        ]
      }, color: "#FFE4BB", weight: 1, shadow: always, bounce: 1)
      directional(name: "fill-key", direction: [0.6, 0.8, 0.3], color: "#BBDDFF", weight: 0.5, shadow: always, bounce: 1)
    ]
  }
}
cameras [
  {
    name: "workload-camera"
    anchor: null
    renderWidth: 960
    renderHeight: 1080
    rig {
      name: "workload-camera"
      version: "puck.camera.program.v1"
      operations [selectProgram(cases: [
        { program: "orbit-camera", value: 0 }
        { program: "pan-camera", value: 1 }
        { program: "cut-camera", value: 2 }
      ], default: "orbit-camera", key: "state.cameraPose")]
    }
  }
  {
    name: "orbit-camera"
    anchor: null
    renderWidth: 960
    renderHeight: 1080
    rig {
      name: "orbit-camera"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 0, 0]))
        orbit(distance: 0.8, pitch: 0.65, yaw: "state.orbitYaw")
        lookAt(subject: worldPoint(point: [0, 0, 0]))
        fieldOfView(fieldOfViewRadians: 0.65)
      ]
    }
  }
  {
    name: "pan-camera"
    anchor: null
    renderWidth: 960
    renderHeight: 1080
    rig {
      name: "pan-camera"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 0, 0]))
        orbit(distance: 0.8, pitch: 0.65, yaw: "state.orbitYaw")
        lookAt(subject: worldPoint(point: [0.12, 0, 0]))
        fieldOfView(fieldOfViewRadians: 0.65)
      ]
    }
  }
  {
    name: "cut-camera"
    anchor: null
    renderWidth: 960
    renderHeight: 1080
    rig {
      name: "cut-camera"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [8, 0.6, 0.3]))
        lookAt(subject: worldPoint(point: [8, 0.4, 0]))
        fieldOfView(fieldOfViewRadians: 0.65)
      ]
    }
  }
  {
    name: "observer-camera"
    anchor: null
    renderWidth: 960
    renderHeight: 1080
    rig {
      name: "observer-camera"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [-0.4, 0.45, 0.6]))
        lookAt(subject: worldPoint(point: [0, 0, 0]))
        fieldOfView(fieldOfViewRadians: 0.65)
      ]
    }
  }
]
views {
  layout "study" {
    seatCount: 0
    slots [
      { camera: "workload-camera", x: 0, y: 0, width: 0.5, height: 1 }
      { camera: "observer-camera", x: 0.5, y: 0, width: 0.5, height: 1 }
    ]
    transitionSeconds: 0
    transitionRenderScale: 1
  }
}
