<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.State.Rules/Puck.State.Rules.csproj" />
        <!-- A trait law's fixture is checked against the world validator, so it cannot rest on a shape no world admits. -->
        <ProjectReference Include="../../src/Puck.World.Schema/Puck.World.Schema.csproj" />
    </ItemGroup>
</Project>
