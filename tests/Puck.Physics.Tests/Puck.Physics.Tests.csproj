<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.Physics/Puck.Physics.csproj" />
        <!-- One fixture builds a standalone SdfProgram and reads it through SdfFieldEvaluator, so the field-sample
             budget is measured against the real evaluator rather than an analytic stand-in. No GPU host is touched. -->
        <ProjectReference Include="../../src/Puck.SignedDistance/Puck.SignedDistance.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Allocation laws measure optimized code directly; JIT promotion must not require thousands of warmup ticks. -->
        <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
    </ItemGroup>
</Project>
