<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.Abstractions/Puck.Abstractions.csproj" />
        <ProjectReference Include="../../src/Puck.Transpiler/Puck.Transpiler.csproj" />
        <ProjectReference Include="../../src/Puck.World.Transpiler/Puck.World.Transpiler.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/TestRecords.cs" Link="TestRecords.cs" />
    </ItemGroup>
</Project>
