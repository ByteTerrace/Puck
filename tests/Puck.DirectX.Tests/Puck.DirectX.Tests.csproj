<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.DirectX/Puck.DirectX.csproj" />
        <ProjectReference Include="../../src/Puck.DirectX.Presentation/Puck.DirectX.Presentation.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- The neutral group layouts the backends' planners and the spike's interfaces are held to. -->
        <Compile Include="../Shared/GpuGroupLayoutTables.cs" Link="GpuGroupLayoutTables.cs" />
        <!-- The devices the device laws run on. -->
        <Compile Include="../Shared/DirectXTestDevices.cs" Link="DirectXTestDevices.cs" />
        <Compile Include="../Shared/FakeGpuDevice.cs" Link="FakeGpuDevice.cs" />
    </ItemGroup>
</Project>
