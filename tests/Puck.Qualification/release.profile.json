{
  "schema": "puck.release.profile.v1",
  "publish": {
    "mode": "ReadyToRun",
    "entryAssembly": "Puck.World.dll",
    "compiler": "None"
  },
  "backends": [
    "vulkan",
    "directx"
  ],
  "debugLayers": [
    "vulkan",
    "directx"
  ],
  "functional": [
    "pipeline-feedback",
    "pipeline-ink",
    "pipeline-edit",
    "pipeline-supersede",
    "pipeline-shapes",
    "pipeline-resize",
    "pipeline-counters",
    "pipeline-override",
    "pipeline-package",
    "pipeline-budget",
    "pipeline-churn",
    "pipeline-geometry",
    "pipeline-echo",
    "no-device-compile",
    "world-counters",
    "source-conversion",
    "sdf-decode-sign-refusal"
  ],
  "resolutions": [
    {
      "width": 1280,
      "height": 800
    },
    {
      "width": 1920,
      "height": 1080
    }
  ],
  "workloads": [
    {
      "name": "flagship",
      "world": "Assets/worlds/puck.world.json",
      "warmupTicks": 300,
      "soakTicks": 1800,
      "worldReloads": 2,
      "pipeline": null,
      "timeoutSeconds": 900
    },
    {
      "name": "ink-pipeline",
      "world": "Assets/worlds/pipeline.world.json",
      "warmupTicks": 120,
      "soakTicks": 900,
      "worldReloads": 0,
      "pipeline": {
        "instance": "ink",
        "layout": "pipeline",
        "settleFrames": 4,
        "reloads": 3,
        "resizes": 3,
        "loads": 3
      },
      "timeoutSeconds": 600
    }
  ],
  "thresholds": [
    {
      "workload": "flagship",
      "backend": "vulkan",
      "width": 1280,
      "height": 800,
      "peakOwnedPipelineBytes": null,
      "peakDeviceLocalBytes": null
    },
    {
      "workload": "flagship",
      "backend": "vulkan",
      "width": 1920,
      "height": 1080,
      "peakOwnedPipelineBytes": null,
      "peakDeviceLocalBytes": null
    },
    {
      "workload": "flagship",
      "backend": "directx",
      "width": 1280,
      "height": 800,
      "peakOwnedPipelineBytes": null,
      "peakDeviceLocalBytes": null
    },
    {
      "workload": "flagship",
      "backend": "directx",
      "width": 1920,
      "height": 1080,
      "peakOwnedPipelineBytes": null,
      "peakDeviceLocalBytes": null
    },
    {
      "workload": "ink-pipeline",
      "backend": "vulkan",
      "width": 1280,
      "height": 800,
      "peakOwnedPipelineBytes": 98304000,
      "peakDeviceLocalBytes": null
    },
    {
      "workload": "ink-pipeline",
      "backend": "vulkan",
      "width": 1920,
      "height": 1080,
      "peakOwnedPipelineBytes": 199065600,
      "peakDeviceLocalBytes": null
    },
    {
      "workload": "ink-pipeline",
      "backend": "directx",
      "width": 1280,
      "height": 800,
      "peakOwnedPipelineBytes": 98304000,
      "peakDeviceLocalBytes": null
    },
    {
      "workload": "ink-pipeline",
      "backend": "directx",
      "width": 1920,
      "height": 1080,
      "peakOwnedPipelineBytes": 199065600,
      "peakDeviceLocalBytes": null
    }
  ],
  "deferred": [
    {
      "check": "DeviceLocalPeak",
      "reason": "memory.vulkan and memory.directx count the device-local bytes a World process allocates and releases, and its peak, and each cell's peakDeviceLocalBytes judges that peak once it is set, but no cell carries a value yet: each is set from a qualification reading of the published package on the reference devices, and none has been taken."
    },
    {
      "check": "FrameTime",
      "reason": "Frame-time median and tail need wall-clock and GPU timing, which are deferred with no date; qualification sets no frame-time threshold."
    },
    {
      "check": "ReloadStall",
      "reason": "How long a reload stalls presentation needs wall-clock timing, which is deferred with no date; qualification counts that every reload installs, never how long it took."
    }
  ]
}
