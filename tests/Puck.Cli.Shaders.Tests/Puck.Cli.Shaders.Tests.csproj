<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <RootNamespace>Puck.Cli.Shaders.Tests</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- The shader host lifetime laws compile the inline task and exercise it through MSBuild's task interfaces. The
             package keeps Microsoft.Build.Framework and Microsoft.Build.Utilities.Core at one version. -->
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="[17.*, )" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.*, )" />
    </ItemGroup>
    <ItemGroup>
        <!-- The shader verbs and the shared shader build targets they drive. -->
        <ProjectReference Include="../../src/Puck.Cli.Shaders/Puck.Cli.Shaders.csproj" />
        <!-- The SDF engine whose generated kernel interfaces the generate laws hold on the real tree. -->
        <ProjectReference Include="../../src/Puck.SdfVm/Puck.SdfVm.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/Cli/ConsoleCapture.cs" Link="ConsoleCapture.cs" />
        <Compile Include="../Shared/Cli/GitScratchCheckout.cs" Link="GitScratchCheckout.cs" />
        <Compile Include="../Shared/Cli/ShaderBuildFixture.cs" Link="ShaderBuildFixture.cs" />
        <Compile Include="../Shared/Cli/ThreadPoolFloor.cs" Link="ThreadPoolFloor.cs" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.Cli.Testing" />
    </ItemGroup>
</Project>