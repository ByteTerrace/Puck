<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Shared/TopologyArenaFixture.cs" Link="TopologyArenaFixture.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- WorldPatternDifferentialLawTests holds the pattern machine to the Re# derivative engine, which runs on
             FSharp.Core. -->
        <PackageReference Include="FSharp.Core" Version="[11.*, )" />
        <PackageReference Include="Resharp" Version="[1.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.State/Puck.State.csproj" />
        <ProjectReference Include="../../src/Puck.State.Topology/Puck.State.Topology.csproj" />
    </ItemGroup>
</Project>
