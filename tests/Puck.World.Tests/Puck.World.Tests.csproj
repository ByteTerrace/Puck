<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- The document/protocol/server surface this project exercises is read directly (public members only —
             see CLAUDE.md's InternalsVisibleTo ruling), never through reflection, so AOT/trim analysis holds. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- Composes IObjectBlobStore through PuckStorageServiceRegistration.AddCore so the backend law suite
             drives the real routed store (IObjectBlobStoreBackend is internal to Puck.Storage) rather than a second,
             hand-rolled dispatch. -->
        <PackageReference Include="FSharp.Core" Version="[10.*, )" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.*, )" />
        <PackageReference Include="Resharp" Version="[1.*, )" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.*, )" />
        <PackageReference Include="xunit.runner.visualstudio" Version="[3.*, )" />
        <PackageReference Include="xunit.v3" Version="[3.*, )" />
    </ItemGroup>
    <ItemGroup>
        <!-- Reference the engine seams directly. -->
        <ProjectReference Include="..\..\src\Puck.Networking\Puck.Networking.csproj" />
        <!-- The Schema-to-presentation capacity seam: Puck.World.Client's bridge derives Puck.Overlays' capacity from
             Schema's ceilings, and the lease table it builds must fit the overlay's backstops — a property neither
             assembly can state alone. -->
        <ProjectReference Include="..\..\src\Puck.Overlays\Puck.Overlays.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Machines\Puck.World.Machines.csproj" />
        <ProjectReference Include="..\..\src\Puck.HumbleGamingBrick\Puck.HumbleGamingBrick.csproj" />
        <ProjectReference Include="..\..\src\Puck.HumbleGamingBrick.Forge\Puck.HumbleGamingBrick.Forge.csproj" />
        <ProjectReference Include="..\..\src\Puck.AdvancedGamingBrick\Puck.AdvancedGamingBrick.csproj" />
        <ProjectReference Include="..\..\src\Puck.AdvancedGamingBrick.Forge\Puck.AdvancedGamingBrick.Forge.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Addons\Puck.World.Addons.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Azure\Puck.World.Azure.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Embeddings\Puck.World.Embeddings.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Client\Puck.World.Client.csproj" />
        <!-- The generic world.row.step field walker (public, no InternalsVisibleTo needed) — see
             WorldRowFieldStepperLawTests. -->
        <ProjectReference Include="..\..\src\Puck.World.Console\Puck.World.Console.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Protocol\Puck.World.Protocol.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Schema\Puck.World.Schema.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.Server\Puck.World.Server.csproj" />
        <!-- Canonical .puck gameplay laws compile and compose their authored basis graph through the same
             PuckDocumentComposer path as the executable host. -->
        <ProjectReference Include="..\..\src\Puck.World.Transpiler\Puck.World.Transpiler.csproj" />
        <!-- Retirement must close the real silo routing session, including work awaiting a row's clock. -->
        <ProjectReference Include="..\..\src\Puck.World.Silo\Puck.World.Silo.csproj" />
        <ProjectReference Include="..\..\src\Puck.Launcher\Puck.Launcher.csproj" />
        <ProjectReference Include="..\..\src\Puck.Hosting\Puck.Hosting.csproj" />
        <ProjectReference Include="..\..\src\Puck.Mcp\Puck.Mcp.csproj" />
        <ProjectReference Include="..\..\src\Puck.Mcp.Azure\Puck.Mcp.Azure.csproj" />
        <!-- The desktop composition root, linked so WorldBootCompositionLawTests builds each boot shape's service
             collection through the public WorldBootComposition with no device created; MachineHostSeamLawTests
             also reads the assembly out of its own build output. -->
        <ProjectReference Include="..\..\src\Puck.World\Puck.World.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.AgentHarness\Puck.World.AgentHarness.csproj" />
        <ProjectReference Include="..\..\src\Puck.World.AgentHarness.Azure\Puck.World.AgentHarness.Azure.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
    </ItemGroup>
    <ItemGroup>
        <!-- Allocation laws measure optimized code directly; JIT promotion must not require thousands of warmup ticks. -->
        <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\VirtualClock.cs" Link="VirtualClock.cs" />
        <Compile Include="..\Shared\TemporaryDirectory.cs" Link="TemporaryDirectory.cs" />
        <Compile Include="..\Shared\TestRecords.cs" Link="TestRecords.cs" />
        <Compile Include="..\Shared\ShippedWorldDocuments.cs" Link="ShippedWorldDocuments.cs" />
        <Compile Include="..\Shared\FakeGpuDevice.cs" Link="FakeGpuDevice.cs" />
        <Compile Include="..\Shared\RefusingGpuDevice.cs" Link="RefusingGpuDevice.cs" />
        <Compile Include="..\Shared\SdfTestPipelines.cs" Link="SdfTestPipelines.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- A world's music, tune, and patch rows resolve their source against the executable's own directory, where
             the game ships Assets/worlds (WorldAssetRowLoader). WorldSaveAuthoredDocumentLawTests boots the worlds that
             author them, so the suite carries the same files at the same relative paths. -->
        <None Include="..\..\src\Puck.World\Assets\worlds\music\**" LinkBase="Assets\worlds\music" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\src\Puck.World\Assets\worlds\patches\**" LinkBase="Assets\worlds\patches" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\src\Puck.World\Assets\worlds\tunes\**" LinkBase="Assets\worlds\tunes" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
