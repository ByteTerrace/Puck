<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- SharedFenceLawTests drives its Direct3D 11 writer through the device's vtable, with no interop generator. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The surface this project exercises is read directly (public members only; see AGENTS.md's
             InternalsVisibleTo ruling), never through reflection, so AOT/trim analysis holds. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- The desktop composition root, linked so WorldBootCompositionLawTests builds each boot shape's service
             collection through the public WorldBootComposition with no device created; MachineHostSeamLawTests
             also reads the assembly out of its own build output. Its closure carries the client, the server, the
             graphics backends and the Gaming Brick cores the device laws and full hosts here drive. -->
        <ProjectReference Include="../../src/Puck.World/Puck.World.csproj" />
        <!-- MachineHostSeamLawTests holds the silo's references beside the World's. -->
        <ProjectReference Include="../../src/Puck.World.Silo/Puck.World.Silo.csproj" />
        <!-- Build-only: it runs this project's shader build (build/Shaders.targets). -->
        <ProjectReference Include="../../src/Puck.Shaders.Generator/Puck.Shaders.Generator.csproj" PrivateAssets="all" Private="false" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
        <Using Include="Puck.World.Testing" />
    </ItemGroup>
    <ItemGroup>
        <!-- BakeSamplingDeviceLawTests: its probe kernel compiles through the shared shader build like any shipped
             kernel, and it samples the bake fixture BakeSamplingFixtureLawTests holds to a fresh bake. -->
        <ComputeShaderSource Include="Assets/Shaders/**/*.comp.hlsl" />
        <Content Include="../Puck.SignedDistance.Tests/Fixtures/bake-sampling.json" Link="Fixtures/bake-sampling.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- Allocation laws measure optimized code directly; JIT promotion must not require thousands of warmup ticks. -->
        <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/DirectXTestDevices.cs" Link="DirectXTestDevices.cs" />
        <Compile Include="../Shared/FakeGpuDevice.cs" Link="FakeGpuDevice.cs" />
        <Compile Include="../Shared/HeadlessVulkanDevice.cs" Link="HeadlessVulkanDevice.cs" />
        <Compile Include="../Shared/IrradianceLightFixture.cs" Link="IrradianceLightFixture.cs" />
        <Compile Include="../Shared/RefusalDeclaringProjects.cs" Link="RefusalDeclaringProjects.cs" />
        <Compile Include="../Shared/RefusingGpuDevice.cs" Link="RefusingGpuDevice.cs" />
        <Compile Include="../Shared/SdfEncodingTrades.cs" Link="SdfEncodingTrades.cs" />
        <Compile Include="../Shared/SdfTestPipelines.cs" Link="SdfTestPipelines.cs" />
        <Compile Include="../Shared/SdfTestView.cs" Link="SdfTestView.cs" />
        <Compile Include="../Shared/ShippedWorldDocuments.cs" Link="ShippedWorldDocuments.cs" />
        <Compile Include="../Shared/SpirvEdits.cs" Link="SpirvEdits.cs" />
        <Compile Include="../Shared/UploadModelGpu.cs" Link="UploadModelGpu.cs" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/World/AllocationCollection.cs" Link="World/AllocationCollection.cs" />
        <Compile Include="../Shared/World/AuthoredGameFixtures.Load.cs" Link="World/AuthoredGameFixtures.Load.cs" />
        <Compile Include="../Shared/World/AuthoredGameFixtures.cs" Link="World/AuthoredGameFixtures.cs" />
        <Compile Include="../Shared/World/ClientFixtures.cs" Link="World/ClientFixtures.cs" />
        <Compile Include="../Shared/World/CompiledWorldFixtures.Compile.cs" Link="World/CompiledWorldFixtures.Compile.cs" />
        <Compile Include="../Shared/World/CompiledWorldFixtures.cs" Link="World/CompiledWorldFixtures.cs" />
        <Compile Include="../Shared/World/ComposedSdfWorldFixture.cs" Link="World/ComposedSdfWorldFixture.cs" />
        <Compile Include="../Shared/World/CreationFixtures.Emission.cs" Link="World/CreationFixtures.Emission.cs" />
        <Compile Include="../Shared/World/CreationFixtures.cs" Link="World/CreationFixtures.cs" />
        <Compile Include="../Shared/World/DocumentCompositionCollection.cs" Link="World/DocumentCompositionCollection.cs" />
        <Compile Include="../Shared/World/EditorPlacementFixtures.cs" Link="World/EditorPlacementFixtures.cs" />
        <Compile Include="../Shared/World/FakeGraphInstances.cs" Link="World/FakeGraphInstances.cs" />
        <Compile Include="../Shared/World/Fixtures.Server.cs" Link="World/Fixtures.Server.cs" />
        <Compile Include="../Shared/World/Fixtures.cs" Link="World/Fixtures.cs" />
        <Compile Include="../Shared/World/PerUserRootScan.cs" Link="World/PerUserRootScan.cs" />
        <Compile Include="../Shared/World/FrustumFitFixtures.cs" Link="World/FrustumFitFixtures.cs" />
        <Compile Include="../Shared/World/HostRowFixture.cs" Link="World/HostRowFixture.cs" />
        <Compile Include="../Shared/World/JournalDepthFixtures.cs" Link="World/JournalDepthFixtures.cs" />
        <Compile Include="../Shared/World/MachineOperationFixtures.cs" Link="World/MachineOperationFixtures.cs" />
        <Compile Include="../Shared/World/PortalFixtures.cs" Link="World/PortalFixtures.cs" />
        <Compile Include="../Shared/World/SceneProbeCollection.cs" Link="World/SceneProbeCollection.cs" />
        <Compile Include="../Shared/World/SceneProbeScan.cs" Link="World/SceneProbeScan.cs" />
        <Compile Include="../Shared/World/StateFixtures.cs" Link="World/StateFixtures.cs" />
        <Compile Include="../Shared/World/TestMachines.Bricks.cs" Link="World/TestMachines.Bricks.cs" />
        <Compile Include="../Shared/World/TimelineLeverFixtures.cs" Link="World/TimelineLeverFixtures.cs" />
        <Compile Include="../Shared/World/ValueDomainFixtures.cs" Link="World/ValueDomainFixtures.cs" />
        <Compile Include="../Shared/World/VocabularyHooks.Client.cs" Link="World/VocabularyHooks.Client.cs" />
        <Compile Include="../Shared/World/WorldHistoryHarness.cs" Link="World/WorldHistoryHarness.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- A world's music, tune, and patch rows resolve their source against the executable's own directory, where
             the game ships Assets/worlds (WorldAssetRowLoader); the full hosts here boot worlds that author them, so the
             suite carries the same files at the same relative paths. -->
        <None Include="../../src/Puck.World/Assets/worlds/music/**" LinkBase="Assets/worlds/music" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../../src/Puck.World/Assets/worlds/patches/**" LinkBase="Assets/worlds/patches" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../../src/Puck.World/Assets/worlds/tunes/**" LinkBase="Assets/worlds/tunes" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
