<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- Constructs live CommandRegistry/InputRouter/FixedStepPump instances directly — no reflection. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.*, )" />
        <PackageReference Include="xunit.runner.visualstudio" Version="[3.*, )" />
        <PackageReference Include="xunit.v3" Version="[3.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Puck.Commands\Puck.Commands.csproj" />
        <ProjectReference Include="..\..\src\Puck.Hosting\Puck.Hosting.csproj" />
        <ProjectReference Include="..\..\src\Puck.Launcher\Puck.Launcher.csproj" />
        <!-- StubDecisionTableTests exercises the stub's pure selection policy directly — a Test-kind project may
             reference any ranked project regardless of row, and the stub's own closure stays empty. -->
        <ProjectReference Include="..\..\src\Puck.Launcher.Stub\Puck.Launcher.Stub.csproj" />
        <!-- ReleaseChainFixture mints its throwaway signing chain through AttestationTestSupport's shared
             key-minting/chain-signing helpers — a terminal-to-terminal edge between two Test-kind projects. -->
        <ProjectReference Include="..\Puck.Attestation.Tests\Puck.Attestation.Tests.csproj" />
    </ItemGroup>
</Project>
