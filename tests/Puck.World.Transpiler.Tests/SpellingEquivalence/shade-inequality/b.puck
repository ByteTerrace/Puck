// Equivalent authored shading: shade-inequality.
schema: "puck.world.definition.v1"
documentId: "shade-pair"
shade template program() { surface { roughness: material.roughness != clock } }
prototypes { prototype "p" { document {
  schema: "puck.creation.v1"
  palette [{ color: "#808080", shade: program() }]
  shape Box "box" { scale [1, 1, 1] }
} } }