// A member spelled at its default is the member omitted.
schema: "puck.world.definition.v1"
documentId: "pair"

prototypes {
  prototype "p" {
    document {
      shape Box "b" {
        blend: Union
        material: 0
        position [0, 0, 0]
        rotation [0, 0, 0, 1]
        scale [0.5, 0.5, 0.5]
      }
    }
  }
}
