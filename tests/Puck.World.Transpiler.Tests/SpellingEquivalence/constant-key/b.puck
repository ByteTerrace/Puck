schema: "puck.world.definition.v1"
documentId: "pair"

state {
  world {
    row {
      name: "cards"
      kind: "Int"
      capacity: 3
      cells: map(range(0, 3), i => { key: $"{i}", value: 0 })
    }
    slot count = 0
  }
}

rule "tick" {
  when cards[2] < 2 and cards[0] == 0
  count = cards[2] + cards[2]
  cards[2] = count
  cards[0] += 1
}
