// A quotient whose exact value is a finite decimal folds as the literal of that decimal does, inside a product and a
// comparison too.
schema: "puck.world.definition.v1"
documentId: "pair"

let fuel = 0.3
let step = fuel * (1 / 65536)
let fifth = fuel * (1 / 5)

inputModes {
  global []
  families [
    {
      name: "fuel"
      selector { kind: BodyState, name: "fuel" }
      default: "empty"
      states [
        { name: "empty", ranges [{ minimum: 0, maximum: 0 }], channels [] }
        { name: $"from-{step}", ranges [{ minimum: step, maximum: (fuel / 4) }], channels [] }
        { name: $"from-{fifth}", ranges [{ minimum: fifth, maximum: ((fifth == 0.06) ? fuel : 1) }], channels [] }
      ]
    }
  ]
}
