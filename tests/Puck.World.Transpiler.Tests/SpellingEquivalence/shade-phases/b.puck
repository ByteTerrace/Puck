// Equivalent authored shading: shade-phases.
schema: "puck.world.definition.v1"
documentId: "shade-pair"
shade template program() {
  compose {
    color: compose.radiance
  }
  surface {
    roughness: 0.5
  }
}
prototypes {
  prototype "p" {
    document {
      schema: "puck.creation.v1"
      palette [{ color: "#808080", shade: program() }]
      shape Box "box" {
        scale [1, 1, 1]
      }
    }
  }
}

state {
  world {
    table shadeCheck {
      admitted = 1
    }
  }
}
test "shade admission" {
  expect {
    shadeCheck.admitted == 1
  }
}
