// A write's call form and its sugar are one effect: a constant source is a value, a row's is a copy.
schema: "puck.world.definition.v1"
documentId: "pair"

state {
  world {
    slot level = 0
    slot moves = 0
  }
}

rule "climb" {
  setState(state: moves, expression: 4)
  addState(state: level, expression: moves)
}
