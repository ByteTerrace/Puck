// Equivalent authored shading: shade-fold.
schema: "puck.world.definition.v1"
documentId: "shade-pair"
shade template program() {
  surface {
    roughness: (0.25 + 0.25) * 0.5
  }
}
prototypes {
  prototype "p" {
    document {
      palette [{ color: "#808080", shade: program() }]
      shape Box "box" {
        scale [1, 1, 1]
      }
    }
  }
}

state {
  world {
    table shadeCheck {
      admitted = 1
    }
  }
}
test "shade admission" {
  expect {
    shadeCheck.admitted == 1
  }
}
