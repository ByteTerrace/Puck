// Equivalent authored shading: shade-for.
schema: "puck.world.definition.v1"
documentId: "shade-pair"
shade template program() {
  surface {
    let n = material.roughness
    let n = n * 0.5
    let n = n * 0.5
    let n = n * 0.5
    roughness: n
  }
}
prototypes {
  prototype "p" {
    document {
      palette [{ color: "#808080", shade: program() }]
      shape Box "box" {
        scale [1, 1, 1]
      }
    }
  }
}

state {
  world {
    table shadeCheck {
      admitted = 1
    }
  }
}
test "shade admission" {
  expect {
    shadeCheck.admitted == 1
  }
}
