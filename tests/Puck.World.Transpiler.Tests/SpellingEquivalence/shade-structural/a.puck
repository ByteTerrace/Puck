// Equivalent authored shading: shade-structural.
schema: "puck.world.definition.v1"
documentId: "shade-pair"
let amount = 0.5
shade template program() {
  surface {
    roughness: material.roughness * amount
  }
}
prototypes {
  prototype "p" {
    document {
      schema: "puck.creation.v1"
      palette [{ color: "#808080", shade: program() }]
      shape Box "box" {
        scale [1, 1, 1]
      }
    }
  }
}

state {
  world {
    table shadeCheck {
      admitted = 1
    }
  }
}
test "shade admission" {
  expect {
    shadeCheck.admitted == 1
  }
}
