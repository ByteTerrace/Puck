// A let's object spells an enum word bare, as the row does, and lands as the row written out.
schema: "puck.world.definition.v1"
documentId: "pair"

let ground = { name: "ground", bond: Surface, hold: Gravity, forward: Heading, reach: 1.2 }

kits [
  {
    name: "walker"
    bodyMotionProgram: "walk"
    collider: capsule(endpoint: [0, 1.1, 0], radius: 0.3)
    motion {
      holds [ground]
    }
  }
]
