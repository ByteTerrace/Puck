// Operators over compile-time constants fold: an effect's value, a gate's comparand and a constant conjunct are the
// values they compute, and an `if` a constant decides is the branch it chooses.
schema: "puck.world.definition.v1"
documentId: "pair"

let width = 4
let enabled = true

state {
  world {
    slot level = 0
    slot moves = 0
  }
}

rule "climb" {
  when enabled and level < (width * 5 - 1)
  moves += width * 2
  if width > 3 {
    level = level + 1
  } else {
    level = 0
  }
}
