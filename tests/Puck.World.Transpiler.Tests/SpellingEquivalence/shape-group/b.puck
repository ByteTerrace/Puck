      shape Box "wall" {
        scale [2, 1.5, 0.1]
        group: 2
      }
      shape Box "door" {
        material: 1
        position [0, -0.4, -0.1]
        scale [0.5, 1, 0.05]
        group: 3
      }
      shape Box "window" {
        blend: Subtraction
        position [0, -0.1, -0.1]
        scale [0.2, 0.2, 0.2]
        group: 3
      }
    }
  }
}
