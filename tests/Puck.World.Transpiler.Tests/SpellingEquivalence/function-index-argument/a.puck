// A function's argument standing for a key inside brackets reads as the key written there, however compound.
schema: "puck.world.definition.v1"
documentId: "pair"

state {
  world {
    slot count = 0
    slot other = 0
    table cells {
      "0" = 0
      "1" = 0
      "2" = 0
    }
  }
}

function cellAt(at) = cells[at] + 1

rule "tick" {
  when count < 3
  other = cellAt(count + 1) + cellAt(count)
}
