// A convex profile listed from another start vertex is the same profile (audit S10).
schema: "puck.world.definition.v1"
documentId: "pair"

prototypes {
  prototype "p" {
    document {
      schema: "puck.creation.v1"
      name: "p"
      shape Prism "b" {
        profile {
          kind: Convex
          vertices [[-1, -1], [-1, 1], [1, 1], [1, -1]]
        }
        scale [0.5, 0.5, 0.5]
      }
    }
  }
}
