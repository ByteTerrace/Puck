// A template call is its body written inline.
schema: "puck.world.definition.v1"
documentId: "pair"

template box(name, at) {
  shape Box name {
    position: at
    scale [0.25, 0.5, 0.25]
  }
}

prototypes {
  prototype "p" {
    document {
      box(name: "left", at: [-1, 0, 0])
      box(name: "right", at: [1, 0, 0])
    }
  }
}
