schema: "puck.world.definition.v1"
documentId: "pair"

state {
  world {
    slot stage = 0
    slot busy = 0
    slot action = 0
    slot ready = 0
    slot moves = 0
  }
}

rule "move" {
  when stage == 0 and busy == 0 and action == 3 and moves < 10
  moves += 1
}

rule "ready" {
  ready = stage == 0 and busy == 0 and action == 4
}
