<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- Most facts construct live CommandRegistry/InputRouter/binding instances directly (public members only),
             but ApiSurfaceTests/PackagingTests read the built assembly's own metadata through System.Reflection to
             hold the published surface to its shape. Reflecting over an assembly is exactly what the trim analyzer
             cannot see through, so this project opts out rather than annotating an inspection that never ships. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.*, )" />
        <PackageReference Include="xunit.runner.visualstudio" Version="[3.*, )" />
        <PackageReference Include="xunit.v3" Version="[3.*, )" />
    </ItemGroup>
    <ItemGroup>
        <!-- Puck.Commands exposes DocumentIdentifier in its public binding model; several fixtures here name
             Puck.Abstractions types directly, so the contract owner is referenced explicitly rather than relied on
             transitively through Puck.Commands. -->
        <ProjectReference Include="..\..\src\Puck.Abstractions\Puck.Abstractions.csproj" />
        <ProjectReference Include="..\..\src\Puck.Assets\Puck.Assets.csproj" />
        <ProjectReference Include="..\..\src\Puck.Commands\Puck.Commands.csproj" />
        <ProjectReference Include="..\..\src\Puck.Maths\Puck.Maths.csproj" />
    </ItemGroup>
</Project>
