<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- Exercises public contracts plus the internal HID lifecycle seam through a recorded friend grant. -->
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Shared/VirtualClock.cs" Link="VirtualClock.cs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.Input/Puck.Input.csproj" />
        <!-- OutputTests.cs exercises XInputGamepadConnection, the sole reason this otherwise platform-neutral test
             project needs a Puck.Platform.Windows reference. -->
        <ProjectReference Include="../../src/Puck.Platform.Windows/Puck.Platform.Windows.csproj" />
    </ItemGroup>
</Project>
