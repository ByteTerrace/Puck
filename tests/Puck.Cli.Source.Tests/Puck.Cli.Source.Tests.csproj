<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <RootNamespace>Puck.Cli.Source.Tests</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- The source and repository verbs. -->
        <ProjectReference Include="../../src/Puck.Cli.Source/Puck.Cli.Source.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/Cli/ConsoleCapture.cs" Link="ConsoleCapture.cs" />
        <Compile Include="../Shared/Cli/ThreadPoolFloor.cs" Link="ThreadPoolFloor.cs" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.Cli.Testing" />
    </ItemGroup>
</Project>