<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Shared/VirtualClock.cs" Link="VirtualClock.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- The layout laws read the Humble components; the hang-guard laws drive the shared battery runner. -->
        <ProjectReference Include="../../src/Puck.HumbleGamingBrick/Puck.HumbleGamingBrick.csproj" />
        <ProjectReference Include="../../src/Puck.Machines.Post/Puck.Machines.Post.csproj" />
    </ItemGroup>
</Project>
