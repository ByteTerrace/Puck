{
  "basis": "phase-fixture",
  "grants": [
    {
      "capability": "Mutate",
      "grantee": "seat1",
      "subject": "section:state"
    },
    {
      "capability": "Edit",
      "grantee": "seat1",
      "subject": "all"
    }
  ],
  "host": {
    "exitAfterSeconds": 0,
    "presentation": "None"
  },
  "rules": [
    {
      "effects": [
        {
          "$type": "if",
          "condition": {
            "$type": "compareState",
            "comparison": "Equal",
            "state": {
              "channel": "phase",
              "arguments": [
                "passPhase"
              ]
            },
            "value": 0
          },
          "else": [
            {
              "$type": "setState",
              "key": "ok",
              "state": "wrongGuardRefused",
              "value": 2
            }
          ],
          "then": [
            {
              "$type": "setState",
              "key": "ok",
              "state": "wrongGuardRefused",
              "value": 1
            }
          ]
        },
        {
          "$type": "setState",
          "fromState": {
            "channel": "phase",
            "arguments": [
              "passPhase"
            ]
          },
          "key": "generation",
          "state": "wrongGuardRefused"
        }
      ],
      "mode": "Level",
      "name": "verdict-wrong-guard-refused"
    }
  ],
  "schedule": {
    "rows": [
      {
        "command": "world.state.transform {\"$type\":\"transfer\",\"from\":\"deck\",\"to\":\"hand\",\"selector\":\"First\"}",
        "principal": "seat1",
        "tick": 3
      },
      {
        "command": "world.state.act passPhase 7 {\"$type\":\"transfer\",\"from\":\"hand\",\"to\":\"pass\",\"selector\":\"First\"}",
        "principal": "seat1",
        "tick": 6
      },
      {
        "command": "world.state.act passPhase 0 {\"$type\":\"transfer\",\"from\":\"missingHand\",\"to\":\"pass\",\"selector\":\"First\"}",
        "principal": "seat1",
        "tick": 8
      }
    ],
    "settleTicks": 6
  },
  "schema": "puck.world.definition.v1",
  "simulation": {
    "rateHz": 30
  },
  "state": {
    "world": [
      {
        "cells": [
          {
            "key": "ok",
            "value": 0
          },
          {
            "key": "generation",
            "value": 0
          }
        ],
        "kind": "Int",
        "name": "wrongGuardRefused",
        "verdict": {
          "gate": "a guarded transform naming generation 7 when passPhase stands at 0 is refused, so the generation never advances",
          "status": "ok"
        }
      }
    ]
  }
}
