// A module whose behaviour is stated inside it, and a world that uses it. The module's own test runs at that use,
// under its arguments; the test written `with` the module chooses its own and stands it up alone.

schema: "puck.world.definition.v1"
documentId: "a-module-and-its-use"

module armoury(plating) {
  grants [
    {
      capability: Mutate
      grantee: "seat1"
      subject: "section:state"
    }
    {
      capability: Edit
      grantee: "seat1"
      subject: "state:armour"
    }
  ]

  state {
    world {
      slot armour = plating
    }
  }

  test "a seat's write reaches the plating" {
    when {
      seat1: world.state.cell.set armour $value 7
      ticks 1
    }
    expect {
      armour == 7
    }
  }
}

use armoury(plating: 2)

test "the module boots at the plating it is given" with armoury(plating: 5) {
  expect {
    armour == 5
  }
}
