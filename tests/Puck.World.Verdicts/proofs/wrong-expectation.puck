// The failing half of the `test` construct's proof: the same world and the same step as
// `sources/seat-writes-a-cell.puck`, claiming a value the step never writes. `puck test` exits 1 and the line
// names the gate as written and the value it read.

schema: "puck.world.definition.v1"
documentId: "wrong-expectation"

grants [
  {
    capability: "Mutate"
    principal: "seat1"
    subject: "section:state"
  }
  {
    capability: "Edit"
    principal: "seat1"
    subject: "state:armour"
  }
]

state {
  world {
    slot armour: Int = 0
  }
}

test "a seat's write reaches the wrong row" {
  when {
    seat1: world.state.cell.set armour $value 7
    ticks 1
  }
  expect {
    armour == 9
  }
}
