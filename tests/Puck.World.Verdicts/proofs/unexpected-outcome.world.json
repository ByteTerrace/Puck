{
  "basis": "../phase-fixture.world.json",
  "grants": [
    {
      "capability": "Mutate",
      "principal": "seat1",
      "subject": "section:state"
    },
    {
      "capability": "Edit",
      "principal": "seat1",
      "subject": "all"
    }
  ],
  "host": {
    "exitAfterSeconds": 0,
    "presentation": "None"
  },
  "rules": [
    {
      "effects": [
        {
          "$type": "setState",
          "key": "ok",
          "state": "passPhaseStillZero",
          "value": 1
        },
        {
          "$type": "setState",
          "fromState": {
            "channel": "phase",
            "arguments": [
              "passPhase"
            ]
          },
          "key": "generation",
          "state": "passPhaseStillZero"
        }
      ],
      "gate": {
        "$type": "compareState",
        "comparison": "Equal",
        "state": {
          "channel": "phase",
          "arguments": [
            "passPhase"
          ]
        },
        "value": 0
      },
      "mode": "Level",
      "name": "verdict-pass-phase-still-zero"
    }
  ],
  "schedule": {
    "directory": "out",
    "rows": [
      {
        "command": "body.press nosuchchannel",
        "principal": "seat1",
        "tick": 3
      }
    ],
    "settleTicks": 6
  },
  "schema": "puck.world.definition.v1",
  "simulation": {
    "rateHz": 30
  },
  "state": {
    "world": [
      {
        "cells": [
          {
            "key": "ok",
            "value": 0
          },
          {
            "key": "generation",
            "value": 0
          }
        ],
        "kind": "Int",
        "name": "passPhaseStillZero",
        "verdict": {
          "gate": "passPhase stands at 0 — true whatever the scheduled row did, so only the row's own outcome can fail this world",
          "status": "ok"
        }
      }
    ]
  }
}
