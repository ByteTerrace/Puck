<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PuckKind>Test</PuckKind>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Facts document themselves by name; CS1591 would demand XML docs on every public test member. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Shared/ShippedWorldDocuments.cs" Link="ShippedWorldDocuments.cs" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/World/AllocationCollection.cs" Link="World/AllocationCollection.cs" />
        <Compile Include="../Shared/World/AudioAssetFixtures.cs" Link="World/AudioAssetFixtures.cs" />
        <Compile Include="../Shared/World/CensusFixtures.cs" Link="World/CensusFixtures.cs" />
        <Compile Include="../Shared/World/CreationFixtures.cs" Link="World/CreationFixtures.cs" />
        <Compile Include="../Shared/World/Fixtures.cs" Link="World/Fixtures.cs" />
        <Compile Include="../Shared/World/Laws.cs" Link="World/Laws.cs" />
        <Compile Include="../Shared/World/PortalFixtures.cs" Link="World/PortalFixtures.cs" />
        <Compile Include="../Shared/World/StateFixtures.cs" Link="World/StateFixtures.cs" />
        <Compile Include="../Shared/World/VocabularyHooks.Server.cs" Link="World/VocabularyHooks.Server.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="JsonSchema.Net" Version="[9.*, )" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Puck.World.Schema/Puck.World.Schema.csproj" />
        <!-- Shipped addon grants narrow mutation verbs through the protocol's real catalog, installed by the
             shared server vocabulary fixture without loading the client. -->
        <ProjectReference Include="../../src/Puck.World.Protocol/Puck.World.Protocol.csproj" />
        <!-- The shipped worlds are read as the game resolves them: a document with a .puck source is that source,
             compiled and composed through the transpiler's document composer. -->
        <ProjectReference Include="../../src/Puck.World.Transpiler/Puck.World.Transpiler.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Puck.State" />
        <Using Include="Puck.World.Testing" />
    </ItemGroup>
    <ItemGroup>
        <!-- Allocation laws measure optimized code directly; JIT promotion must not require thousands of warmup ticks. -->
        <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
    </ItemGroup>
</Project>
