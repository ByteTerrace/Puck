// shader-compare — generic side-by-side pipeline shader vs SDF shader comparison tool.
//
// Like hgb-compare for Game Boy cartridges, shader-compare provides a side-by-side
// comparison tool for shader authoring and verification. The left viewport slot
// renders the procedural GLSL pipeline shader, while the right viewport slot renders
// the native Puck SDF model/scene.
//
// Paired cameras keep angles, framing and field of view aligned across both views.
// Moth is the initial comparison, but this tool is generic: the pipeline shader
// can be live-reloaded or pointed to any shader source, and the basis or
// prototypes can point to any SDF model.
//
// In-game controls:
//   1 - Three-quarter comparison
//   2 - Front comparison
//   3 - Rear comparison
//   4 - Wide flight-stage comparison
//   5 - Face close-up comparison
//
// Interactive console commands:
//   pipeline.watch compare-pipeline on    - Watch and recompile shader edits automatically
//   pipeline.reload compare-pipeline      - Recompile the pipeline on demand
//   pipeline.load compare-pipeline <src>  - Dynamically load another pipeline shader

schema: "puck.world.definition.v1"
basis: "../avatars/moth"
documentId: "puck-shader-compare-v1"

let pipelineSource = "../../pipelines/moth.hlsl"
let pipelineName = "compare-pipeline"

cameras [
  {
    name: "pack-rear"
    renderHeight: 900
    renderWidth: 1280
    rig {
      name: "pack-rear"
      operations [
        anchor(subject: worldPoint(point: [0, 1.38, 2.70]))
        lookAt(subject: worldPoint(point: [0, 1.30, 0.10]))
        fieldOfView(fieldOfViewRadians: 0.54)
      ]
      version: "puck.camera.program.v1"
    }
  }
  {
    name: "pack-side"
    renderHeight: 900
    renderWidth: 1280
    rig {
      name: "pack-side"
      operations [
        anchor(subject: worldPoint(point: [-2.70, 1.38, 0.20]))
        lookAt(subject: worldPoint(point: [0, 1.30, 0.20]))
        fieldOfView(fieldOfViewRadians: 0.54)
      ]
      version: "puck.camera.program.v1"
    }
  }
  {
    name: "pack-three-quarter"
    renderHeight: 900
    renderWidth: 1280
    rig {
      name: "pack-three-quarter"
      operations [
        anchor(subject: worldPoint(point: [-1.90, 1.38, 1.90]))
        lookAt(subject: worldPoint(point: [0, 1.30, 0.15]))
        fieldOfView(fieldOfViewRadians: 0.52)
      ]
      version: "puck.camera.program.v1"
    }
  }
]

views {
  layouts [
    {
      $replace: true
    }
    {
      name: "compare"
      seatCount: 0
      slots [
        {
          height: 1
          instance: pipelineName
          width: 0.5
          x: 0
          y: 0
        }
        {
          camera: "three-quarter"
          height: 1
          width: 0.5
          x: 0.5
          y: 0
        }
      ]
      transitionRenderScale: 1
      transitionSeconds: 0
    }
    {
      name: "compare-front"
      seatCount: 0
      slots [
        {
          height: 1
          instance: "compare-pipeline-front"
          width: 0.5
          x: 0
          y: 0
        }
        {
          camera: "front"
          height: 1
          width: 0.5
          x: 0.5
          y: 0
        }
      ]
      transitionRenderScale: 1
      transitionSeconds: 0
    }
    {
      name: "compare-rear"
      seatCount: 0
      slots [
        {
          height: 1
          instance: "compare-pipeline-rear"
          width: 0.5
          x: 0
          y: 0
        }
        {
          camera: "rear"
          height: 1
          width: 0.5
          x: 0.5
