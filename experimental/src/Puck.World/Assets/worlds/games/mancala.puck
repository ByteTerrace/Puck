// 'for' in it, none of which the document carries.

export action mancalaBoard, mancalaMoveRequest, mancalaSelectedPit
export binding mancalaStatus, mancalaTurn
export read mancalaBoard, mancalaMoveApplied, mancalaPitSeeds, mancalaSelectedPit, mancalaStatus, mancalaTurn

placements {
  placement "mancalaTable" {
    prototype: "tabletop"
    board {
      move: "mancalaSelectedPit"
      occupancy: "mancalaBoard"
      topology: "mancalaBoard"
      turn: "mancalaTurn"
      verdict: "mancalaStatus"
    }
    position [-8, -0.5, -16]
  }
}

prototypes {
  prototype "tabletop" {
    document {
      name: "tabletop"
      palette [
        {
          color: "#8A6A45"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "top" {
        material: 0
        position [0, 1.25, 0]
        rotation: "state.transforms.identity"
        scale [1, 0.05, 1]
      }

      shape Cylinder "leg" {
        material: 0
        position [0, 0.6, 0]
        rotation: "state.transforms.identity"
        scale [0.08, 0.6, 0.08]
      }
    }
  }
}

rule "mancala-reject-out-of-range" {
  when mancalaMoveRequest != mancalaMoveApplied and (mancalaSelectedPit < 0 or mancalaSelectedPit > 12 or mancalaSelectedPit == 6)
  mode: Level
  mancalaMoveApplied = mancalaMoveRequest
}

rule "mancala-reject-illegal" {
  when mancalaMoveRequest != mancalaMoveApplied and mancalaSelectedPit >= 0 and mancalaSelectedPit <= 12 and mancalaSelectedPit != 6 and (mancalaStatus != 0 or (mancalaTurn == 0 and mancalaSelectedPit > 5) or (mancalaTurn == 1 and mancalaSelectedPit < 7) or mancalaBoard[mancalaSelectedPit[$value]] == 0)
  mode: Level
  mancalaMoveApplied = mancalaMoveRequest
}

rule "mancala-stage-move" {
  when mancalaMoveRequest != mancalaMoveApplied and mancalaStatus == 0 and ((mancalaTurn == 0 and mancalaSelectedPit >= 0 and mancalaSelectedPit <= 5) or (mancalaTurn == 1 and mancalaSelectedPit >= 7 and mancalaSelectedPit <= 12)) and mancalaBoard[mancalaSelectedPit[$value]] > 0
  local cStart = (mancalaSelectedPit + 7 * mancalaTurn) % 14
  local cLast = (cStart + mancalaBoard[(mancalaSelectedPit)]) % 13
  local pLast = (cLast + 7 * mancalaTurn) % 14
  local extra = cLast == 6 ? 1 : 0
  mode: Level
  setState(fromKey: mancalaSelectedPit[$value], fromState: mancalaBoard, state: mancalaPitSeeds)
  setState(expression: pLast, state: mancalaLastPit)
  setState(expression: extra, state: mancalaExtraTurn)
  mancalaMoveApplied = mancalaMoveRequest
  mancalaStage = 1
}

rule "mancala-sow-board" {
  when mancalaStage == 1
  local p = mancalaPitIndex[$each]
  local cStart = (mancalaSelectedPit + 7 * mancalaTurn) % 14
  local cp = (p + 7 * mancalaTurn) % 14
  local dRaw = (cp - cStart + 26) % 13
  local dist = dRaw == 0 ? 13 : dRaw
  local added = ((cp == 13) | (mancalaPitSeeds < dist)) ? 0 : (1 + (mancalaPitSeeds - dist) / 13)
  mode: Level
  forEach: mancalaBoard
  mancalaBoard[$each] = (p == mancalaSelectedPit ? 0 : mancalaBoard[$each]) + added
}

rule "mancala-advance-to-capture" {
  when mancalaStage == 1
  mode: Level
  mancalaStage = 2
}

rule "mancala-apply-capture" {
  when mancalaStage == 2 and canCapture == 1
  local isOwnSide = ((mancalaLastPit + 7 * mancalaTurn) % 14 <= 5) ? 1 : 0
  local isNotSelected = mancalaLastPit != mancalaSelectedPit ? 1 : 0
  local wasEmpty = mancalaBoard[(mancalaLastPit)] == (1 + (mancalaPitSeeds - 1) / 13) ? 1 : 0
  local oppositeHasSeeds = mancalaBoard[12 - mancalaLastPit] > 0 ? 1 : 0
  local canCapture = isOwnSide & isNotSelected & wasEmpty & oppositeHasSeeds
  mode: Level
  mancalaBoard[6 + 7 * mancalaTurn] = mancalaBoard[6 + 7 * mancalaTurn] + mancalaBoard[(mancalaLastPit)] + mancalaBoard[12 - mancalaLastPit]
  mancalaBoard[mancalaLastPit[$value]] = 0
  mancalaBoard[12 - mancalaLastPit] = 0
  mancalaStage = 3
}

rule "mancala-skip-capture" {
  when mancalaStage == 2
  mode: Level
  mancalaStage = 3
}

rule "mancala-update-turn" {
  when mancalaStage == 3
  mode: Level
  mancalaTurn = mancalaExtraTurn == 1 ? mancalaTurn : (1 - mancalaTurn)
  mancalaStage = 4
}

rule "mancala-check-game-over" {
  when mancalaStage == 4 and isGameOver == 1
  local p0Sum = mancalaBoard[0] + mancalaBoard[1] + mancalaBoard[2] + mancalaBoard[3] + mancalaBoard[4] + mancalaBoard[5]
  local p1Sum = mancalaBoard[7] + mancalaBoard[8] + mancalaBoard[9] + mancalaBoard[10] + mancalaBoard[11] + mancalaBoard[12]
  local isGameOver = (p0Sum == 0) | (p1Sum == 0) ? 1 : 0
  local final0 = mancalaBoard[6] + p0Sum
  local final1 = mancalaBoard[13] + p1Sum
  local winner = final0 > final1 ? 1 : (final1 > final0 ? 2 : 3)
  mode: Level
  setState(expression: final0, key: 6, state: mancalaBoard)
  setState(expression: final1, key: 13, state: mancalaBoard)
  mancalaBoard[0] = 0
  mancalaBoard[1] = 0
  mancalaBoard[2] = 0
  mancalaBoard[3] = 0
  mancalaBoard[4] = 0
  mancalaBoard[5] = 0
  mancalaBoard[7] = 0
  mancalaBoard[8] = 0
  mancalaBoard[9] = 0
  mancalaBoard[10] = 0
  mancalaBoard[11] = 0
  mancalaBoard[12] = 0
  setState(expression: winner, state: mancalaStatus)
  mancalaStage = 0
}

rule "mancala-game-continues" {
  when mancalaStage == 4
  mode: Level
  mancalaStage = 0
}

