// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

export action granarySurveyRequest, granaryIrrigationRequest, granaryPowerRequest
export binding granaryWaterCoverage, granaryPowerCoverage, granarySurveyPage, granaryIrrigationStage, granaryPowerStage
export read granaryNames, granaryResources, granaryRegions, granaryKinds, granarySkus

navigation {
  domains [
    {
      agentHeight: 0.5
      agentRadius: 0.2
      arrivalDistance: 0.9
      cellSize: 1
      depth: 32
      kind: Surface
      layers: 1
      maxExpandedNodes: 1024
      maxPathNodes: 128
      maxSlopeDegrees: 60
      maxStepHeight: 0.55
      name: "granaryYard"
      parent: granaryCourt
      origin [-30, -2, -30]
      probeDown: 3
      probeUp: 2.5
      width: 40
    }
  ]
}

rule "granary-water-coverage-cleanup" {
  when not influence(water, granaryStores)[$each] == influence(water, granaryStores)[$each]
  mode: Level
  forEach: granaryWaterCoverage
  remove granaryWaterCoverage[$each]
}

rule "granary-power-coverage-cleanup" {
  when not influence(power, granaryStores)[$each] == influence(power, granaryStores)[$each]
  mode: Level
  forEach: granaryPowerCoverage
  remove granaryPowerCoverage[$each]
}

rule "granary-water-coverage" {
  when not granaryWaterCoverage[$each] == influence(water, granaryStores)[$each]
  mode: Level
  forEach: granaryNames
  setState(state: granaryWaterCoverage, key: $each, fromState: influence(water, granaryStores), fromKey: $each)
}

rule "granary-power-coverage" {
  when not granaryPowerCoverage[$each] == influence(power, granaryStores)[$each]
  mode: Level
  forEach: granaryNames
  setState(state: granaryPowerCoverage, key: $each, fromState: influence(power, granaryStores), fromKey: $each)
}

rule "granary-survey-cycle" {
  when granarySurveyRequest > 0 and granarySurveyRequest != granarySurveyApplied
  mode: Level
  setState(state: granarySurveyApplied, expression: granarySurveyRequest)
  granarySurveyPage = (granarySurveyPage + 1) % 3
}

rule "granary-irrigation-stage" {
  when granaryIrrigationRequest != granaryIrrigationStage
  mode: Level
  transaction {
    setState(state: granaryIrrigationStage, expression: granaryIrrigationRequest)
    setState(state: granaryIrrigationSelected, fromState: granaryIrrigationChoices, fromKey: (granaryIrrigationRequest))
  }
}

rule "granary-power-stage" {
  when granaryPowerRequest != granaryPowerStage
  mode: Level
  transaction {
    setState(state: granaryPowerStage, expression: granaryPowerRequest)
    setState(state: granaryPowerSelected, fromState: granaryPowerChoices, fromKey: (granaryPowerRequest))
  }
}

hud {
  defaults {
    enabled: true
  }
  panels [
    {
      id: "granary-coverage"
      rect {
        x: 0.03
        y: 0.72
        width: 0.3
        height: 0.23
      }
      layer: Over
      style: Panel
      elements [
        {
          id: "survey"
          kind: Text
          rect {
            x: 0.06
            y: 0.08
            width: 0.88
            height: 0.2
          }
          style: Primary
          "template": "GRANARY SURVEY {state.granarySurveyPage}"
        }
        {
          id: "irrigation"
          kind: Text
          rect {
            x: 0.06
            y: 0.34
            width: 0.88
            height: 0.2
          }
          style: Positive
          "template": "WATER EXPANSION {state.granaryIrrigationStage}"
        }
        {
          id: "power"
          kind: Text
          rect {
            x: 0.06
            y: 0.6
            width: 0.88
            height: 0.2
          }
          style: Warning
          "template": "POWER EXPANSION {state.granaryPowerStage}"
        }
      ]
    }
  ]
}

placements {
  placement "granaryCourt" {
    prototype: "granaryCourt"
    position [0, 0, 0]
    solid
  }

  placement "granarySurveyTable" {
    prototype: "granarySurveyTable"
    parent: "granaryCourt"
    position [-2, 0, 2.5]
    solid
  }

  placement "granaryStores" {
    prototype: "granaryStore"
    parent: "granaryCourt"
    position [-10, 0, -15]
    spatial [
      {
        name: "store-occupation"
        role: "Occupation"
        shape {
          kind: "Box"
          center [0, 1.5, 0]
          halfExtents [1.5, 1.5, 1.5]
        }
      }
      {
        name: "store-clearance"
        role: "Clearance"
        shape {
          kind: "Box"
          center [0, 1.5, 0]
          halfExtents [1.75, 1.5, 1.75]
        }
      }
    ]
    distribution {
      fill {
        name: "none"
        offset: 0
        step: 0
      }
      region: scatter(cellSize: 1.6, depth: 16, radius: 1, seed: 7, spacing: 4, width: 16)
    }
    "deal" {
      preserve {
        "transform": true
        facets: true
      }
      reflow {
        candidateBudget: 4096
      }
      row: "granaryNames"
      variants {
        row: "granaryNames"
        map {
          bytrcstp001: "granaryAnchor"
        }
      }
    }
    solid
  }

  placement "granaryIrrigation" {
    prototype: "granaryIrrigation"
    parent: "granaryCourt"
    position [-10, 0, -15]
    spatial [
      {
        name: "irrigation-coverage"
        role: "Influence"
        channel: "water"
        shape {
          kind: "Box"
          center [0, 1.5, 0]
          halfExtents: "state.granaryIrrigationSelected"
        }
      }
    ]
  }

  placement "granaryPower" {
    prototype: "granaryPower"
    parent: "granaryCourt"
    position [-10, 0, -15]
    spatial [
      {
        name: "power-coverage"
        role: "Influence"
        channel: "power"
        shape {
          kind: "Box"
          center [0, 1.5, 0]
          halfExtents: "state.granaryPowerSelected"
        }
      }
    ]
  }
}

