// 'for' in it, none of which the document carries.

export action
export binding lap
export read lap, lapTicks

bodyMotionPrograms [
  {
    kind: Motion
    name: "kartDrive"
    operations [ResolveDriveFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
    version: "puck.body.program.v1"
  }
]

curves [
  {
    closed: true
    name: "kartTrack"
    knots [
      {
        position [7, 0, 0]
        tangentYaw: 1.570796
        curvature: 0.1428571
      }
      {
        position [4.949747, 0, 4.949747]
        tangentYaw: 2.356194
        curvature: 0.1428571
      }
      {
        position [0, 0, 7]
        tangentYaw: 3.141593
        curvature: 0.1428571
      }
      {
        position [-4.949747, 0, 4.949747]
        tangentYaw: -2.356194
        curvature: 0.1428571
      }
      {
        position [-7, 0, 0]
        tangentYaw: -1.570796
        curvature: 0.1428571
      }
      {
        position [-4.949747, 0, -4.949747]
        tangentYaw: -0.785398
        curvature: 0.1428571
      }
      {
        position [0, 0, -7]
        tangentYaw: 0
        curvature: 0.1428571
      }
      {
        position [4.949747, 0, -4.949747]
        tangentYaw: 0.785398
        curvature: 0.1428571
      }
    ]
  }
]

kits {
  rows [
    {
      bodyContact: Solid
      bodyMotionProgram: "kartDrive"
      collider: capsule(endpoint: [0, 0.5, 0], radius: 0.5)
      motion {
        holds [
          {
            bond: Surface
            cone [0, 60]
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "ground"
            reach: 1.2
          }
          {
            bond: Free
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {
              engage: 40
              release: 30
              reversalRate: 20
              backwardSpeed: 3
            }
            across {
              lateral: 40
            }
          }
        ]
        speed {
          value: 8
        }
        turn {
          rate: 1.2
        }
      }
      name: "kart"
    }
  ]
}

navigation {
  domains [
    {
      agentHeight: 1
      agentRadius: 0.5
      arrivalDistance: 0.9
      cellSize: 1
      depth: 40
      kind: Surface
      layers: 1
      maxExpandedNodes: 1600
      maxPathNodes: 64
      maxSlopeDegrees: 60
      maxStepHeight: 0.5
      name: "kartSurface"
      origin [-20, -1, -20]
      probeDown: 3
      probeUp: 2.5
      width: 40
    }
  ]
}

placements {
  placement "kartCourt" {
    prototype: "trackFloor"
    position [0, 0, 0]
    solid
  }

  placement "gate0" {
    prototype: "gateMarker"
    parent: "kartCourt"
    position [0, 0, 7]
    yawDegrees: 90deg
    region {
      radius: 3.5
    }
  }

  placement "gate1" {
    prototype: "gateMarker"
    parent: "kartCourt"
    position [-7, 0, 0]
    region {
      radius: 3.5
    }
  }

  placement "gate2" {
    prototype: "gateMarker"
    parent: "kartCourt"
    position [0, 0, -7]
    yawDegrees: 90deg
    region {
      radius: 3.5
    }
  }

  placement "kartBank0" {
    prototype: "bankWall"
    parent: "kartCourt"
    position [7.07, 0, -7.07]
    yawDegrees: 45deg
    solid
  }

  placement "kartBank1" {
    prototype: "bankWall"
    parent: "kartCourt"
    position [-7.07, 0, 7.07]
    yawDegrees: -135deg
    solid
  }

  placement "kartRamp0" {
    prototype: "ramp"
    parent: "kartCourt"
    position [10, 0, 0]
    solid
  }
}

prototypes {
  prototype "trackFloor" {
    document {
      schema: "puck.creation.v1"
      name: "trackFloor"
      palette [
        {
          color: "#5A6B57"
        }
      ]
      shape Box "floor" {
        position [0, -0.2, 0]
        scale [20, 0.2, 20]
        material: 0
      }
    }
  }

  prototype "bankWall" {
    document {
      schema: "puck.creation.v1"
      name: "bankWall"
      palette [
        {
          color: "#8A6F4C"
        }
      ]
      shape Box "wall" {
        position [0, 1, 0]
        rotation [0, 0, 0.2164396, 0.9762961]
        scale [0.15, 1, 3]
        material: 0
      }
    }
  }

  prototype "ramp" {
    document {
      schema: "puck.creation.v1"
      name: "ramp"
      palette [
        {
          color: "#79807F"
        }
      ]
      shape Box "incline" {
        position [0, 0.3, 0]
        rotation [0.1736482, 0, 0, 0.9848078]
        scale [2, 0.15, 3]
        material: 0
      }
    }
  }

  prototype "gateMarker" {
    document {
      schema: "puck.creation.v1"
      name: "gateMarker"
      palette [
        {
          color: "#D8A23E"
        }
      ]
      shape Box "post-left" {
        position [-2, 1, 0]
        scale [0.1, 1, 0.1]
        material: 0
      }

      shape Box "post-right" {
        position [2, 1, 0]
        scale [0.1, 1, 0.1]
        material: 0
      }
    }
  }
}

rule "kart-gate-0" {
  when gateStage == 0 and region(gate0) > 0
  mode: Edge
  gateStage += 1
  setState(state: lapStart, expression: $tick)
}

rule "kart-gate-1" {
  when gateStage == 1 and region(gate1) > 0
  mode: Edge
  gateStage += 1
}

rule "kart-gate-2" {
  when gateStage == 2 and region(gate2) > 0
  mode: Edge
  lapTicks = $tick - lapStart
  lap += 1
  gateStage = 0
}

spawnPoints [
  {
    id: "kart-arrival"
    position [7, 0.6, 0]
    yawDegrees: 180
  }
]

state {
  world {
    slot gateStage = 0 bounds(0..)

    slot lap = 0 bounds(0..)

    slot lapTicks = 0 bounds(0..)

    slot lapStart = 0 bounds(0..)
  }
}
