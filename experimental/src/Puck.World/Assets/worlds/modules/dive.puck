looks {
  rows [
    {
      name: "fish"
      scale: 1
      source: creation(prototypeId: fish)
      motion {
        cues []
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
      }
    }
  ]
}

rule "dive-depth-deep" {
  when region(diveDepth1) >= 1
  mode: Level
  depth = 2.4
}

rule "dive-depth-mid" {
  when region(diveDepth1) == 0 and region(diveDepth2) >= 1
  mode: Level
  depth = 1.6
}

rule "dive-depth-shallow" {
  when region(diveDepth2) == 0 and region(diveDepth3) >= 1
  mode: Level
  depth = 0.8
}

rule "dive-depth-dry" {
  when region(diveDepth3) == 0
  mode: Level
  depth = 0
}

rule "dive-dived-latch" {
  when depth >= 1.6 and dived == 0
  mode: Edge
  dived = 1
}

spawnPoints [
  {
    id: "dive-arrival"
    position [0, 0.1, -1.3]
    yawDegrees: 0
  }
]

navigation {
  domains [
    {
      name: "pool"
      kind: Medium
      origin [-4, -2.85, 1]
      cellSize: 0.5
      width: 16
      depth: 16
      layers: 3
      agentRadius: 0.24
      arrivalDistance: 0.4
      maxExpandedNodes: 768
      maxPathNodes: 64
      medium: water
      shared {
        expandedNodesPerTick: 64
        goalCapacity: 2
      }
    }
  ]
}
