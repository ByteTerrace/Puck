      name: "fishKit"
      bodyContact: Overlap
      bodyMotionProgram: "diveFishMotion"
      collider: sphere(radius: 0.1)
      autonomy {
        motionSeconds: 0.1
        steeringSeconds: 0.1
      }
      motion {
        facingSnap: true
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 1
        }
        turn {
          rate: 1.5
        }
        holds [
          {
            name: "water"
            bond: Medium
            hold: None
            medium {
              idleDrift: 0.6
              equilibriumOffset: 0.6
              settleRate: 0.8
            }
            envelope {
              riseSpeed: 1
