      motion {
        facingSnap: false
        speed {
          value: 3
        }
        turn {
          rate: 2.2
        }
        shaping [
          {
            along {}
          }
        ]
        holds [
          {
            name: "ground"
            bond: Surface
            cone [0, 60]
