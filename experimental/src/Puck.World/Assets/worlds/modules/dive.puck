}

placements {
  placement "diveCourt" {
    prototype: "diveDock"
    position [0, 0, 0]
    solid
  }

  placement "diveBasin" {
    prototype: "diveBasin"
    parent: "diveCourt"
    position [0, -2.85, 5]
    solid
  }

  placement "diveDepth1" {
    prototype: "diveMarker"
    parent: "diveCourt"
    position [0, -2.85, 5]
    region {
      radius: 0.8
    }
  }

  placement "diveDepth2" {
    prototype: "diveMarker"
    parent: "diveCourt"
    position [0, -2.85, 5]
    region {
      radius: 1.6
    }
  }

  placement "diveDepth3" {
    prototype: "diveMarker"
    parent: "diveCourt"
    position [0, -2.85, 5]
    region {
      radius: 2.4
    }
  }

  placement "diveFish" {
    prototype: "fish"
    position [1.6, -1.35, 6.2]
    inhabit {
      count: 4
      kit: "fishKit"
      look: "fish"
      source: producer(name: "diveSchool")
      distribution {
        region: disc(radius: 1)
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
      }
    }
    parent: "diveCourt"
  }
}

state {
  lattices [
    field(name: "pool", origin: [-4, -2.85, 1], cellSize: 0.5, width: 16, depth: 16, layers: 1)
  ]

  world {
    row {
      name: "water"
      kind: "Fixed"
      domain: cellsOf(topology: pool)
      field {
        initial: 2.4
        min: 0
        max: 3
        heightScale: 1
        color: "#2E76AF"
        medium {}
        paint [
          rect(minX: -4, minZ: 1, maxX: 4, maxZ: 9, value: 2.4)
        ]
      }
    }

    slot depth = 0.0 bounds(0.0..3.0)

    slot dived = 0 bounds(0..1)
  }
}

bodyMotionPrograms [
  {
    name: "diveDiverMotion"
    version: "puck.body.program.v1"
    kind: Motion
    operations [ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
  }
  {
    name: "diveFishMotion"
    version: "puck.body.program.v1"
    kind: Motion
    operations [ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
  }
  {
    name: "diveSchool"
    version: "puck.body.program.v1"
    kind: Producer
    operations [ProduceFlockIntent]
  }
]

