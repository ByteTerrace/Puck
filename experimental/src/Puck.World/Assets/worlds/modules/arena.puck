// Bootstrapped from a Puck world document. The '.puck' source is canonical: edit it and
// compile, never the '.world.json' beside it.
//
// Decompiling again would OVERWRITE this file and discard every 'let', 'template' and
// 'for' in it, none of which the document carries.

export action
export binding hp, targeted
export read hp, targeted, dead, elementLabel

bodyMotionPrograms [
  {
    kind: Motion
    name: "grounded"
    operations [ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
    version: "puck.body.program.v1"
  }
]

channels [
  {
    composition: true
    name: "attack"
    shape: Binary
  }
  {
    composition: true
    name: "target"
    shape: Binary
  }
  {
    composition: true
    name: "element"
    shape: Binary
  }
]

interactions {
  interactions [
    {
      coOccurrence: Region
      effects [
        scheduleState(delaySeconds: 3, key: $left, state: burning)
      ]
      left: flammable
      mode: Edge
      name: "pit-ignites"
      range: 0
      right: firePit
    }
    {
      coOccurrence: Region
      effects [
        setState(key: $left, state: frozen, value: 1)
        scheduleState(delaySeconds: 3, key: $left, state: frozenUntil)
      ]
      left: freezable
      mode: Edge
      name: "pool-chills"
      range: 0
      right: icePool
    }
  ]
}

kits {
  rows [
    {
      bodyContact: Solid
      bodyMotionProgram: "grounded"
      collider: capsule(endpoint: [0, 1.6, 0], radius: 0.35)
      motion {
        facingSnap: true
        holds [
          {
            bond: Surface
            cone [0, 60]
            envelope {
              sinkSpeed: 20
            }
            gravity {
              fall: 23
              rise: 14
            }
            hold: Gravity
            name: "ground"
            reach: 1.2
          }
          {
            bond: Free
            envelope {
              sinkSpeed: 20
            }
            gravity {
              fall: 23
              rise: 14
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 0.01
        }
        turn {
          rate: 0.01
        }
      }
      name: "dummyKit"
    }
  ]
}

navigation {
  domains [
    {
      agentHeight: 1.8
      agentRadius: 0.35
      arrivalDistance: 0.5
      cellSize: 1
      depth: 20
      kind: Surface
      layers: 1
      maxExpandedNodes: 400
      maxPathNodes: 64
      maxSlopeDegrees: 60
      maxStepHeight: 0.55
      name: "yard"
      origin [-10, -2, -10]
      probeDown: 3
      probeUp: 2.5
      width: 20
    }
  ]
}

placements {
  placement "arenaCourt" {
    prototype: "arenaYard"
    position [0, 0, 0]
    solid
  }

  placement "firePit" {
    prototype: "firePit"
    parent: "arenaCourt"
    position [6, 0, -6]
    region {
      radius: 1.5
    }
  }

  placement "icePool" {
    prototype: "icePool"
    parent: "arenaCourt"
    position [-6, 0, -6]
    region {
      radius: 1.5
    }
  }

  placement "dummyA" {
    prototype: "trainingDummy"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.1
        }
        region: disc(radius: 0.01)
      }
      kit: "dummyKit"
      look: null
      source: "Idle"
    }
    parent: "arenaCourt"
    position [3, 0, 4]
    yawDegrees: 180deg
  }

  placement "dummyB" {
    prototype: "trainingDummy"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.1
        }
        region: disc(radius: 0.01)
      }
      kit: "dummyKit"
      look: null
      source: "Idle"
    }
    parent: "arenaCourt"
    position [-3, 0, 4]
    yawDegrees: 180deg
  }
}

prototypes {
  prototype "arenaYard" {
    document {
      name: "arenaYard"
      palette [
        {
          color: "#8C8C77"
        }
        {
          color: "#6B6B5E"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "floor" {
        material: 0
        position [0, -0.05, 0]
        scale [10, 0.05, 10]
      }

      shape Box "wall-north" {
        material: 1
        position [0, 1, 10]
        scale [10.3, 1, 0.15]
      }

      shape Box "wall-south" {
        material: 1
        position [0, 1, -10]
        scale [10.3, 1, 0.15]
      }

      shape Box "wall-east" {
        material: 1
        position [10, 1, 0]
        scale [0.15, 1, 10.3]
      }

      shape Box "wall-west" {
        material: 1
        position [-10, 1, 0]
        scale [0.15, 1, 10.3]
      }
    }
  }

  prototype "trainingDummy" {
    document {
      name: "trainingDummy"
      palette [
        {
          color: "#8A5A34"
        }
        {
          color: "#C2A05A"
        }
      ]
      schema: "puck.creation.v1"
      shape Cylinder "base" {
        material: 0
        position [0, 0.1, 0]
        scale [0.3, 0.1, 0.3]
      }

      shape Cylinder "post" {
        material: 0
        position [0, 0.9, 0]
        scale [0.08, 0.8, 0.08]
