rule "handheld-pickup" {
  when handheldHeld == 0 and region(handheldStand) >= 1 and channel(1, jump) >= 1
  mode: Edge
  handheldHeld[0] = 1
  upsertPlacement(placement: {
    attach {
      bodyIndex: 0
      localOffset [0.22, 1.02, 0.34]
      localYawDegrees: 0
    }
    id: "handheld"
    parent: handheldStand
    position [0, 0, 0]
    prototypeId: handheld
    scale: 1
    yawDegrees: 0
  }
  )
}

rule "handheld-release" {
  when handheldHeld == 1 and region(handheldStand) < 1
  mode: Edge
  handheldHeld[0] = 0
  upsertPlacement(placement: {
    id: "handheld"
    parent: handheldStand
    position [0, 1.08, 0.03]
    prototypeId: handheld
    scale: 1
    yawDegrees: 0
  }
  )
}

machines [
  {
    name: "cgb-screen"
    engine: "gaming-brick"
    configuration {
      schema: "puck.gaming-brick.configuration.v1"
      model: "cgb"
      content {
        path: "../../cartridges/hgb-mirror.cgb.cartridge.json"
      }
    }
  }
  {
    name: "agb-screen"
    engine: "advanced-gaming-brick"
