bodyMotionPrograms [
  {
    kind: Motion
    name: "arcadePad"
    operations [ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
    version: "puck.body.program.v1"
  }
]

kits {
  rows [
    {
      name: "arcadePad"
      bodyMotionProgram: "arcadePad"
      motion {
        holds [
          {
            bond: Free
            envelope {
              sinkSpeed: 20
            }
            gravity {
              fall: 23
              rise: 14
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 4
        }
        turn {
          rate: 2.5
        }
      }
      pad {
        forward: "LeftStickY"
        strafe: "LeftStickX"
        turn: "RightStickX"
        jump: "South"
        rise: "East"
      }
    }
  ]
}

