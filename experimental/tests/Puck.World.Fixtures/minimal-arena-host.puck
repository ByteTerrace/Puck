schema: "puck.world.definition.v1"
basis: "../../src/Puck.World/Assets/worlds/standard"

import "../../src/Puck.World/Assets/worlds/games/arena"

bodies {
  capacity: 4
  localSeats: 2
}

bodyMotionPrograms [
  {
    kind: Motion
    name: "walk"
    operations [ResolveYawAttitudeAndPlanarFrame, ResolveHold, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, RunActionTriggers, ApplyHold, IntegratePlanarAndVerticalVelocity, CommitPose]
    version: "puck.body.program.v1"
  }
]

channels [
  {
    frame: Heading
    name: "forward"
    role: MoveAdvance
    shape: Bipolar
  }
  {
    frame: Heading
    name: "strafe"
    role: MoveStrafe
    shape: Bipolar
  }
  {
    name: "turn"
    role: Turn
    shape: Bipolar
  }
  {
    composition: true
    name: "attack"
    shape: Binary
  }
]

collision {
  contactSkin: 0.02
  gradientProbe: 0
  maxIterations: 4
  maxSlopeDegrees: 60
  requirements [SmoothUnionContact]
}

defaultSeatKit: "seat"

gravity {
  attractors []
  gravitationalConstant: 0
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, 0, 0]
}

kits {
  rows [
    {
      bodyContact: Overlap
      bodyMotionProgram: "walk"
      collider: capsule(endpoint: [0, 1, 0], radius: 0.35)
      motion {
        facingSnap: false
        holds [
          {
            bond: Free
            hold: None
            name: "floating"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 4
        }
        turn {
          rate: 2.5
        }
      }
      name: "seat"
    }
  ]
}

looks {
  rows [
    {
      motion {
        cues []
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
      }
      name: "arenaItem"
      scale: 1
      source: creation(prototypeId: arenaItem)
    }
  ]
}

simulation {
  rateHz: 30
}

state {}

views {
  layout "action" {
    seatCount: 0
    slots [
      {
        camera: null
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 0.5
    transitionSeconds: 0.4
  }

  seatControl {
    maxPitch: 1.2
    minPitch: -0.35
    yawReference: World
  }

  seatRig "seatChase" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 5.4626001, pitch: 0.4145069, yaw: 0)
      lookAt(subject: reference(), targetOffset: [0, 1, 0], worldAxes: false)
      fieldOfView(fieldOfViewRadians: 0.9599311)
    ]
  }
}
