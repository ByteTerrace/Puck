{
  "id": "go-capture",
  "title": "A Go stone filling a group's last liberty captures it, and the CPU answers through its search",
  "binding": "Boots the Go world and plays both colours through the move door: black surrounds white's centre stone on three sides and its fourth stone takes it, one prisoner to black. The CPU then plays white: its UCT search lands a move within each tick's work allowance and the move enters through the same door, so the game counts eight moves and black is to play. The run is recorded and replays to the same state. The discriminating leg plays black's fourth stone one point off the last liberty, so nothing is captured and, with no CPU side named, the game still waits on white after seven moves.",
  "bootShape": "headless",
  "requirements": [],
  "timeoutSeconds": 60,
  "fixtures": [],
  "positive": {
    "expect": [
      { "name": "one-stone-captured", "present": true, "match": "contains", "text": "'captured'.'$value' value=1", "stream": "stdout", "type": "line" },
      { "name": "black-holds-the-prisoner", "present": true, "match": "contains", "text": "'prisoners'.'1' value=1", "stream": "stdout", "type": "line" },
      { "name": "the-cpu-moved", "present": true, "match": "contains", "text": "'moves'.'$value' value=8", "stream": "stdout", "type": "line" },
      { "name": "black-to-play", "present": true, "match": "contains", "text": "'turn'.'$value' value=1", "stream": "stdout", "type": "line" },
      { "name": "replay-match", "present": true, "match": "contains", "text": "[replay.verify: 'go-capture' | MATCH", "stream": "stdout", "type": "line" },
      { "name": "no-rule-refusal", "present": false, "match": "contains", "text": "effect refused", "stream": "stderr", "type": "line" },
      { "name": "clean-wire", "present": true, "match": "contains", "text": "[wire.errors: 0 rejected]", "stream": "stdout", "type": "line" }
