{
  "id": "rulepush-undo",
  "title": "Rulepush turns taken back restore the recorded state hash, thirty-two deep",
  "binding": "Boots the Hedges level of the rulepush package and drives the seat's own puzzle presses. Eight turns are taken and the world-scope state hash is read; eight more turns are taken and all eight are taken back with the undo press, and the hash agrees with the one read eight turns earlier. The imp then walks on to thirty-two turns and every one is taken back, leaving the move counter at zero. The run is recorded and replays exactly. The discriminating leg takes only seven of the eight turns back, so the two hashes disagree and the final undo stops one turn short.",
  "bootShape": "headless",
  "requirements": [],
  "timeoutSeconds": 60,
  "fixtures": [],
  "positive": {
    "expect": [
      {
        "type": "response",
        "name": "hash-at-eight",
        "stream": "stdout",
        "verb": "world.state.hash",
        "occurrence": 1,
        "count": 2,
        "extract": [
          {
            "name": "before",
            "field": "hash"
          }
        ]
      },
      {
        "type": "response",
        "name": "hash-after-undo",
        "stream": "stdout",
        "verb": "world.state.hash",
        "occurrence": 2,
        "count": 2,
        "extract": [
          {
            "name": "after",
            "field": "hash"
          }
        ]
      },
      {
        "type": "relation",
        "name": "undo-restores-the-hash",
        "operator": "equal",
        "left": {
          "value": "before"
        },
        "right": {
          "value": "after"
        }
      },
      {
        "name": "eight-turns-then-back",
        "present": true,
        "match": "contains",
        "text": "'moves'.'$value' value=8",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "thirty-two-turns",
        "present": true,
        "match": "contains",
        "text": "'moves'.'$value' value=32",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "every-turn-taken-back",
        "present": true,
        "match": "contains",
        "text": "'moves'.'$value' value=0",
        "stream": "stdout",
        "type": "line"
      },
      {
        "name": "no-rule-refusal",
        "present": false,
        "match": "contains",
        "text": "effect refused",
        "stream": "stderr",
        "type": "line"
      },
      {
        "name": "replay-match",
        "present": true,
        "match": "contains",
        "text": "[replay.verify: 'rulepush-undo' | MATCH",
        "stream": "stdout",
        "type": "line"
