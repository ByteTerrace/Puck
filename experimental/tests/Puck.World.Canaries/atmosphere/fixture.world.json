{
  "host": {
    "authority": null,
    "backend": "auto",
    "exitAfterSeconds": 0,
    "fullscreen": false,
    "genlock": null,
    "height": 128,
    "journalDepth": 2000,
    "listen": null,
    "presentMode": "Immediate",
    "presentation": "offscreen",
    "surfaceFormat": "r8g8b8a8",
    "targetHertz": 0,
    "width": 128
  },
  "render": {
    "sky": {
      "layers": [
        {
          "$type": "gradient",
          "stops": [
            {
              "elevation": -1,
              "color": "#000000"
            },
            {
              "elevation": 1,
              "color": "#000000"
            }
          ]
        }
      ]
    },
    "atmosphere": {
      "haze": {
        "amount": 0.5,
        "anisotropy": 0.6
      }
    },
    "lighting": {
      "lights": [
        {
          "$type": "directional",
          "direction": [
            0,
            0.1,
            -1
          ],
          "color": "#FFFFFF",
          "weight": 1
        }
      ]
    },
    "renderScale": 1
  },
  "schema": "puck.world.definition.v1",
  "views": {
    "layouts": [
      {
        "name": "world",
        "seatCount": 0,
        "slots": [
          {
            "camera": "haze-cam",
            "height": 1,
            "width": 1,
            "x": 0,
            "y": 0
          }
        ],
        "transitionRenderScale": 1,
        "transitionSeconds": 0.25
      }
    ],
    "seatControl": {
      "maxPitch": 0.01,
      "minPitch": -0.01,
      "yawReference": "World"
    },
    "seatRig": {
      "name": "world",
      "operations": [
        {
          "$type": "orbit",
          "distance": 0.01,
          "pitch": 0.45,
          "yaw": 0
        },
        {
          "$type": "fieldOfView",
          "fieldOfViewRadians": 1.4
        }
      ],
      "version": "puck.camera.program.v1"
    }
  },
  "cameras": [
    {
      "name": "haze-cam",
      "renderWidth": 128,
      "renderHeight": 128,
      "rig": {
        "name": "haze-cam",
        "version": "puck.camera.program.v1",
        "operations": [
          {
            "$type": "anchor",
            "subject": {
              "$type": "worldPoint",
              "point": [
                0,
                0,
                0
              ]
            }
          },
          {
            "$type": "lookAt",
            "subject": {
              "$type": "worldPoint",
              "point": [
                0,
                0.4,
                -4
              ]
            }
          },
          {
            "$type": "fieldOfView",
            "fieldOfViewRadians": 0.6
          }
        ]
      }
    }
  ]
}
