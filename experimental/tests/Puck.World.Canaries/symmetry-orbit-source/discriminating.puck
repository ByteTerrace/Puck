schema: "puck.world.definition.v1"
documentId: "symmetry-orbit-source-canary"

simulation {
  rateHz: 240
}

generators [
  {
    name: "ringTwo"
    generator {
      source: UniformRange
      rangeMin: 0
      rangeMax: 239
    }
  }
]

state {
  world {
    row {
      name: "pick"
      kind: "Int"
      value: -1
      "draw" {
        source: "ringTwo"
        timing: "Event"
      }
    }

    slot pickRing = -1

    row {
      name: "tiles"
      kind: "Fixed"
      field {
        initial: 0
        min: 0
        max: 239
        heightScale: 0
        paint [
          draw(generator: {
            source: UniformRange
            rangeMin: 0
            rangeMax: 15663104
          }
          )
        ]
      }
      domain: cellsOf(topology: grid)
    }
  }

  lattices [
    field(name: "grid", origin: [0, 0, 0], cellSize: 1, width: 12, depth: 1, layers: 1, stepEveryTicks: 1, reactions: [])
  ]
}

rule "ring-of-pick" {
  when pick >= 0
  mode: Level
  pickRing = symmetry(ring, pick)
}
