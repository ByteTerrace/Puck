// The bake-switch canary's world: one static block, which bakes, in front of a fixed camera.

schema: "puck.world.definition.v1"
documentId: "sdf-bake-switch"

cameras [
  {
    anchor: null
    name: "bake-cam"
    renderHeight: 144
    renderWidth: 256
    rig {
      name: "bake-cam"
      operations [
        anchor(subject: worldPoint(point: [0, 2, 5]))
        lookAt(subject: worldPoint(point: [0, 0.6, 0]))
        fieldOfView(fieldOfViewRadians: 0.9)
      ]
      version: "puck.camera.program.v1"
    }
  }
]

host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 144
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: offscreen
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 256
}

placements {
  placement "block" {
    prototype: "block"
    position [0, 0, 0]
  }
}

prototypes {
  prototype "block" {
    document {
      name: "block"
      palette [
        {
          color: "#8C7A5D"
          roughness: 0.55
          sheen: 0
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Box "base" {
        chamfer: 0.2
        material: 0
        position [0, 0.6, 0]
        scale [0.6, 0.6, 0.6]
      }
    }
  }
}

simulation {
  rateHz: 30
}

views {
  layout "bake" {
    seatCount: 0
    slots [
      {
        camera: "bake-cam"
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  seatControl {
    maxPitch: 1.2
    minPitch: -0.35
    yawReference: "World"
  }

  seatRig "bake-seat" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 5, pitch: 0.3, yaw: 0)
      lookAt(subject: reference())
      fieldOfView(fieldOfViewRadians: 0.9)
    ]
  }
}
