schema: "puck.world.definition.v1"
documentId: "symmetry-channel-canary"

simulation {
  rateHz: 240
}

state {
  world {
    slot node = 5

    slot mirror = 17

    slot ringOf = -2

    slot antipodeOf = -2

    slot canonicalOf = -2

    slot walked = -2

    slot reflected = -2

    slot orthogonalFlag = -2

    slot pairing = -3

    slot projX = 0.0
  }
}

rule "probe" {
  when $tick >= 1
  mode: Edge
  ringOf = symmetry(ring, node)
  antipodeOf = symmetry(antipode, node)
  canonicalOf = symmetry(canonicalRay, node)
  walked = symmetry(cycle, 7, node)
  reflected = symmetry(reflect, cell, mirror, node)
  orthogonalFlag = symmetry(orthogonal, 17, node)
  pairing = symmetry(innerProduct, 17, node)
  projX = symmetry(projectionX, node)
}
