schema: "puck.world.definition.v1"
documentId: "lattice-draw-fill-canary"

simulation {
  rateHz: 240
}

state {
  world {
    row {
      name: "tiles"
      kind: "Fixed"
      field {
        initial: 0
        min: 0
        max: 4
        heightScale: 0
      }
      domain: cellsOf(topology: grid)
    }
  }

  lattices [
    field(name: "grid", origin: [0, 0, 0], cellSize: 1, width: 4, depth: 1, layers: 1, stepEveryTicks: 1, reactions: [])
  ]
}
