schema: "puck.world.definition.v1"
documentId: "dive-medium-canary"

import "../../../src/Puck.World/Assets/worlds/modules/dive" as dive

bodies {
  localSeats: 1
  capacity: 16
}

simulation {
  rateHz: 240
}

spawnPoints [
  {
    id: "origin"
    position [0, 6, 0]
  }
]

channels [
  {
    name: "forward"
    shape: Bipolar
    role: MoveAdvance
  }
  {
    name: "strafe"
    shape: Bipolar
    role: MoveStrafe
  }
  {
    name: "turn"
    shape: Bipolar
    role: Turn
  }
  {
    name: "up"
    shape: Bipolar
    role: MoveUp
  }
]

collision {
  requirements []
  contactSkin: 0.02
  maxIterations: 4
  maxSlopeDegrees: 60
  gradientProbe: 0
}

views {
  seatControl {
    yawReference: World
    minPitch: -0.35
    maxPitch: 1.2
  }

  seatRig "seatChase" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 5.4626001, yaw: 0, pitch: 0.4145069, pivotOffset: [0, 0, 0])
      lookAt(subject: reference(), targetOffset: [0, 1, 0], worldAxes: false)
      fieldOfView(fieldOfViewRadians: 0.9599311)
    ]
  }
}

defaultSeatKit: "diver"
