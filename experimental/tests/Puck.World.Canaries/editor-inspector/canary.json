{
  "id": "editor-inspector",
  "title": "The shared inspector text names a GPU surface and toggles the existing editor overlay",
  "binding": "A fixed camera looks at a single box. The presentation-only pointer stays at its front face. Enabling the inspector demands the shared asynchronous visibility pixel with the captured normal and material address, and changes the composed root image. Disabling returns to the same pixels. The discriminating leg keeps the inspector off, so neither its panel nor its surface readback exists. Both legs query the live placement cost and top list; these counts come from the rendered program. The normal assertion is geometric, and the panel proof reads actual composed pixels.",
  "bootShape": "windowed",
  "backends": [
    "vulkan",
    "directx"
  ],
  "requirements": [
    "gpu"
  ],
  "timeoutSeconds": 60,
