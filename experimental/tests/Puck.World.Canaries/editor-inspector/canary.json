    "expect": [
      {
        "type": "framesAgree",
        "name": "panel-toggle-changes-composed-pixels",
        "before": "before.png",
        "after": "panel.png",
        "agree": false
      },
      {
        "type": "framesAgree",
        "name": "off-restores-composed-pixels",
        "before": "before.png",
        "after": "after.png",
        "agree": true
      },
      {
        "type": "line",
        "name": "surface-has-captured-material",
        "stream": "stdout",
        "match": "contains",
        "text": "material=cube.palette[0] index=",
        "present": true
      },
      {
        "type": "line",
        "name": "surface-has-exact-normal",
        "stream": "stdout",
        "match": "contains",
        "text": "normal=0,0,1 distance=",
        "present": true
      },
      {
        "type": "line",
        "name": "live-cost-names-one-instance",
        "stream": "stdout",
        "match": "contains",
        "text": "inspected: prototype=cube shapes=1 owned-words=",
        "present": true
      },
      {
        "type": "line",
        "name": "cost-reports-scope-and-count",
        "stream": "stdout",
        "match": "contains",
        "text": "instances=1 scope-clamps=0",
        "present": true
      },
      {
        "type": "line",
        "name": "pointer-override-clears",
        "stream": "stdout",
        "match": "contains",
        "text": "[world.view.pointer: override cleared]",
        "present": true
      }
    ]
  },
