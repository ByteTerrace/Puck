schema: "puck.world.definition.v1"
documentId: "thin-wall-sweep-canary"

bodies {
  localSeats: 1
}

simulation {
  rateHz: 60
}

channels [
  {
    name: "forward"
    shape: Bipolar
    role: MoveAdvance
  }
  {
    name: "strafe"
    shape: Bipolar
    role: MoveStrafe
  }
  {
    name: "turn"
    shape: Bipolar
    role: Turn
  }
]

collision {
  requirements [SmoothUnionContact]
  contactSkin: 0.02
  maxIterations: 4
  maxSlopeDegrees: 60
  gradientProbe: 0
}

dynamics [
  {
    name: "chase"
    f: 0.9549
    zeta: 1
    r: 1
  }
]

views {
  seatControl {
    yawReference: World
    minPitch: -0.35
    maxPitch: 1.2
  }

  seatRig "seatChase" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 5.4626001, yaw: 0, pitch: 0.4145069, pivotOffset: [0, 0, 0])
      lookAt(subject: reference(), targetOffset: [0, 1, 0], worldAxes: false)
      fieldOfView(fieldOfViewRadians: 0.9599311)
      dynamics(row: chase)
    ]
  }
}

bodyMotionPrograms [
  {
    name: "traverse"
    version: "puck.body.program.v1"
    kind: Motion
    operations [ResolveYawAttitudeAndPlanarFrame, ComputePlanarTargetVelocity, ShapeVelocity, SnapYawToPlanarIntent, IntegratePlanarAndVerticalVelocity, CommitPose]
  }
]

kits {
  rows [
    {
      name: "bolt"
      bodyMotionProgram: "traverse"
      motion {
        speed {
          value: 3000
        }
        turn {
          rate: 2.5
        }
        holds [
          {
            name: "air"
            bond: Free
            hold: None
          }
        ]
        shaping [
          {
            along {}
          }
        ]
      }
      collider: sphere(radius: 0.5)
      bodyContact: Solid
    }
  ]
}

defaultSeatKit: "bolt"

prototypes {
  prototype "thinWall" {
    document {
      schema: "puck.creation.v1"
      name: "thinWall"
      palette [
        {
          color: "#4E5C55"
        }
      ]
      shape Box "panel" {
        position [0, 0, 0]
        scale [8, 8, 0.01]
        material: 0
      }
    }
  }
}

placements {
  placement "wall" {
    prototype: "thinWall"
    position [0, 0, -100]
    solid
  }
}
