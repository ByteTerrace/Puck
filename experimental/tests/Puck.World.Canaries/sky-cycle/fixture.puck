schema: "puck.world.definition.v1"

host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 256
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: offscreen
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 256
}

render {
  atmosphere {
    fog {
      density {
        clock: skyMode
        keys [{ at: 0, value: 0 }, { at: 0.5, value: 0.004 }]
      }
    }
  }
  farDistance: 100
  sky {
    clock: skyMode
    keys [
      {
        at: 0
        layers {
          air: gradient(stops: [
            {
              color: "#B6B2BA"
              elevation: -1
            }
            {
              color: "#B6B2BA"
              elevation: -0.05
            }
            {
              color: "#B6B2BA"
              elevation: 0.35
            }
            {
              color: "#B6B2BA"
              elevation: 1
            }
          ]
          )
          sun: sunDisc(intensity: 0)
        }
      }
      {
        at: 0.5
        layers {
          air: gradient(stops: [
            {
              color: "#9AABB7"
              elevation: -1
            }
            {
              color: "#D5DCE0"
              elevation: -0.05
            }
            {
              color: "#7CA7C6"
              elevation: 0.35
            }
            {
              color: "#3C658F"
              elevation: 1
            }
          ]
          )
          sun: sunDisc(intensity: 1.5)
        }
      }
    ]
    layers [
      gradient(name: "air", stops: [
        {
          color: "#9AABB7"
          elevation: -1
        }
        {
          color: "#D5DCE0"
          elevation: -0.05
        }
        {
          color: "#7CA7C6"
          elevation: 0.35
        }
        {
          color: "#3C658F"
          elevation: 1
        }
      ]
      )
      sunDisc(intensity: 1.5, light: 0, name: "sun", radius: 0.018)
    ]
  }
}

views {
  layout "world" {
    seatCount: 0
    slots [
      {
        camera: "sky-cam"
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0.25
  }

  seatControl {
    maxPitch: 0.01
    minPitch: -0.01
    yawReference: World
  }

  seatRig "world" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 0.01, pitch: 0.45, yaw: 0)
      fieldOfView(fieldOfViewRadians: 1.4)
    ]
  }
}

state {
  world {
    slot skyMode = 0.5
  }
}

timeline {
  clocks [
    {
      name: "skyMode"
      state: skyMode
    }
  ]
}

cameras [
  {
    name: "sky-cam"
    renderWidth: 256
    renderHeight: 256
    rig {
      name: "sky-cam"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 0, 0]))
        lookAt(subject: worldPoint(point: [0, 0.5, -1]))
        fieldOfView(fieldOfViewRadians: 1.4)
      ]
    }
  }
]
