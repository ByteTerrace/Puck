schema: "puck.world.definition.v1"
basis: "../../../src/Puck.World/Assets/worlds/standard"
documentId: "front-door-canary"

import "../../../src/Puck.World/Assets/worlds/modules/jump" as jump
import "../../../src/Puck.World/Assets/worlds/modules/studio" as studio

simulation {
  rateHz: 30
}

bodies {
  capacity: 4
  localSeats: 1
  seatSpawns [
    "studio-arrival"
  ]
  networkPlayers: 0
  defaultPeerSource: "Idle"
}

spawnPoints [
  {
    id: "studio-arrival"
    position [0, 0, 3]
    yawDegrees: 0
  }
  {
    id: "plaza-1"
    position [10, 0, 10]
    yawDegrees: 0
  }
]

channels [
  {
    frame: Heading
    name: "forward"
    role: MoveAdvance
    shape: Bipolar
  }
  {
    frame: Heading
    name: "strafe"
    role: MoveStrafe
    shape: Bipolar
  }
  {
    name: "turn"
    role: Turn
    shape: Bipolar
  }
  {
    name: "faceX"
    role: FaceX
    shape: Bipolar
  }
  {
    name: "faceZ"
    role: FaceZ
    shape: Bipolar
  }
  {
    name: "faceY"
    role: FaceY
    shape: Bipolar
  }
  {
    composition: true
    name: "jump"
    shape: Binary
  }
  {
    name: "rise"
    role: MoveUp
    shape: Bipolar
  }
]

placements {
  policy {
    authoringHeadroomScreens: 0
    authoringHeadroomPlacements: 0
    minPlacementScale: 1
    maxPlacementScale: 1
    candidateRadius: 1
    candidateCap: 1
    previewDeadlineFrames: 1
    derivedFaceScreens: 1
  }
}

defaultSeatKit: "vaulter"

host {
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 800
  listen: null
  presentMode: Immediate
  presentation: Windowed
  surfaceFormat: r8g8b8a8
  targetHertz: 60
  width: 1280
}

collision {
  contactSkin: 0.02
  gradientProbe: 0
  gridCellSize: 0.5
  maxIterations: 4
  maxSlopeDegrees: 60
  requirements [SmoothUnionContact]
}

gravity {
  attractors []
  gravitationalConstant: 0
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, -46, 0]
}

state {
  world {
    table identity capacity(32)
  }
}

rule "seat1-returning-identity-wakes-at-plaza" {
  when identity(body, 0, awakened) >= 1
  mode: Edge
  pose(key: 0, spawnPoint: "plaza-1")
}

views {
  layout "action" {
    transitionSeconds: 0.4
    transitionRenderScale: 0.5
    seatCount: 0
    slots [
      {
        camera: null
        x: 0
        y: 0
        width: 1
        height: 1
      }
    ]
  }

  seatControl {
    maxPitch: 1.2
    minPitch: -0.35
    yawReference: World
  }

  seatRig "studio-chase" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 6, pitch: 0.35, yaw: 0)
      lookAt(subject: reference(), targetOffset: [0, 1, 0], worldAxes: false)
      fieldOfView(fieldOfViewRadians: 0.95)
    ]
  }
}
