schema: "puck.world.definition.v1"
documentId: "portal-window-beyond"

admission [
  {
    algorithm: ""
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
    publicKey: ""
    subject: null
  }
]

placements {
  placement "arch" {
    prototype: "arch"
    position [0, 1.5, 0]
  }

  placement "occluder" {
    prototype: "occluder"
    position [0, 1.5, 4]
  }

  placement "marker" {
    prototype: "marker"
    position [0, 1.5, -6]
  }

  placement "backdrop" {
    prototype: "backdrop"
    position [0, 1.5, -12]
  }
}

prototypes {
  prototype "arch" {
    document {
      behavior {
        faces [
          {
            defaultSource: null
            name: "glass"
            shapeId: 0
          }
        ]
      }
      name: "arch"
      palette [
        {
          color: "#303030"
          roughness: 0.8
          sheen: 0
          specular: 0
        }
      ]
      schema: "puck.creation.v1"
      shape Box "rim" {
        material: 0
        position [0, 0, 0]
        scale [1.2, 1, 0.05]
      }

      shape Box "opening" {
        blend: "Subtraction"
        material: 0
        position [0, 0, 0]
        scale [1.15, 0.95, 0.3]
      }
    }
  }

  prototype "marker" {
    document {
      name: "marker"
      palette [
        {
          color: "#20FF40"
          emissive: 0.5
          roughness: 0.6
          sheen: 0
          specular: 0
        }
      ]
      schema: "puck.creation.v1"
      shape Sphere "ball" {
        material: 0
        position [0, 0, 0]
        scale [0.5, 0.5, 0.5]
      }
    }
  }

  prototype "occluder" {
    document {
      name: "occluder"
      palette [
        {
          color: "#FF20FF"
          emissive: 0.5
          roughness: 0.8
          sheen: 0
          specular: 0
        }
      ]
      schema: "puck.creation.v1"
      shape Box "slab" {
        material: 0
        position [0, 0, 0]
        scale [1.2, 0.7, 0.05]
      }
    }
  }

  prototype "backdrop" {
    document {
      name: "backdrop"
      palette [
        {
          color: "#2040FF"
          emissive: 0.5
          roughness: 0.8
          sheen: 0
          specular: 0
        }
      ]
      schema: "puck.creation.v1"
      shape Box "wall" {
        material: 0
        position [0, 0, 0]
        scale [12, 8, 0.1]
      }
    }
  }
}

simulation {
  rateHz: 30
}
