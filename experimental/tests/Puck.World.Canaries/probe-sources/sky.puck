schema: "puck.world.definition.v1"
documentId: "probe-sources"

cameras [
  {
    anchor: null
    name: "main-cam"
    renderHeight: 72
    renderWidth: 128
    rig {
      name: "main-cam"
      operations [
        anchor(subject: worldPoint(point: [0, 2.5, 7]))
        lookAt(subject: worldPoint(point: [0, 1.2, 0]))
        fieldOfView(fieldOfViewRadians: 0.9)
      ]
      version: "puck.camera.program.v1"
    }
  }
  {
    anchor: null
    name: "eye"
    renderHeight: 36
    renderWidth: 64
    rig {
      name: "eye"
      operations [
        anchor(subject: worldPoint(point: [0, 1, -9]))
        lookAt(subject: worldPoint(point: [0, 1, -12]))
        fieldOfView(fieldOfViewRadians: 0.9)
      ]
      version: "puck.camera.program.v1"
    }
  }
  {
    anchor: null
    name: "sky"
    renderHeight: 36
    renderWidth: 64
    rig {
      name: "sky"
      operations [
        anchor(subject: worldPoint(point: [0, 1, -8]))
        lookAt(subject: worldPoint(point: [0, 30, -8.5]))
        fieldOfView(fieldOfViewRadians: 0.9)
      ]
      version: "puck.camera.program.v1"
    }
  }
]

host {
  authority: null
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  genlock: null
  height: 72
  journalDepth: 2000
  listen: null
  presentMode: Immediate
  presentation: offscreen
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 128
}

placements {
  policy {
    authoringHeadroomPlacements: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    derivedFaceScreens: 1
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  placement "meter-screen" {
    prototype: "screen"
    faceSources [
      {
        face: "display"
        source: probe(id: "meter")
      }
    ]
    position [0, 1.2, 0]
    yawDegrees: 180deg
  }

  placement "subject" {
    prototype: "ball"
    position [0, 0, -12]
  }
}

probes [
  {
    id: "meter"
    inputs {
      frame: view(cameraName: "sky")
    }
    kind: "average"
    rateHz: 240
  }
]

prototypes {
  prototype "screen" {
    document {
      behavior {
        faces [
          {
            defaultSource: null
            name: "display"
            shapeId: 0
          }
        ]
      }
      frames [
        {
          name: "idle"
          transforms []
        }
      ]
      name: "screen"
      palette [
        {
          color: "#DDE8EA"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "panel" {
        material: 0
        position [0, 0, 0]
        scale [0.9, 0.6, 0.05]
      }
    }
  }

  prototype "ball" {
    document {
      frames [
        {
          name: "idle"
          transforms []
        }
      ]
      name: "ball"
      palette [
        {
          color: "#D03020"
          roughness: 0.6
          sheen: 0
          specular: 0.1
        }
      ]
      schema: "puck.creation.v1"
      shape Sphere "ball" {
        material: 0
        position [0, 1, 0]
        scale [2, 2, 2]
      }
    }
  }
}

simulation {
  rateHz: 30
}

views {
  layout "room" {
    seatCount: 0
    slots [
      {
        camera: "main-cam"
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  seatControl {
    maxPitch: 1.2
    minPitch: -0.35
    yawReference: World
  }

  seatRig "room-seat" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 5, pitch: 0.3, yaw: 0)
      lookAt(subject: reference())
      fieldOfView(fieldOfViewRadians: 0.9)
    ]
  }
}
