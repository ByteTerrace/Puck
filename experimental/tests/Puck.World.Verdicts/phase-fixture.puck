schema: "puck.world.definition.v1"

host {
  exitAfterSeconds: 0
  fullscreen: false
  height: 64
  presentMode: Immediate
  presentation: None
  surfaceFormat: r8g8b8a8
  targetHertz: 0
  width: 64
}

simulation {
  rateHz: 30
}

state {
  world {
    table items {
      "0" = 0
      "1" = 1
    }

    pile deck of items capacity(2) {
      "0"
      "1"
    }

    pile hand of items capacity(2)

    row {
      capacity: 2
      cells []
      domain: keysOf(ordered: true, row: items)
      kind: "Bool"
      name: "pass"
      phaseOf: "passPhase"
    }

    row {
      kind: "Int"
      name: "passPhase"
      phase {
        sequence: 0
      }
    }

    row {
      kind: "Int"
      name: "idlePhase"
      phase {
        sequence: 0
      }
    }
  }
}
