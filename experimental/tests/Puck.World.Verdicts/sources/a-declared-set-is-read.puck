// A declared cell set read by its name: `boardCombine` paints the set onto an empty board, and `writeSet` writes
// into the members of a board that already holds values, leaving every other cell as it was. The stones hold 1 at
// cells 1, 3, 6 and 7, so those four cells are the set.

schema: "puck.world.definition.v1"
documentId: "a-declared-set-is-read"

let seed = [0, 1, 2, 1, 0, 2, 1, 1, 0]

state {
  lattices [
    grid(name: "grid", origin: [0, 0, 0], cellSize: 1, width: 3, depth: 3, wrap: None)
  ]

  world {
    row {
      name: "stones"
      kind: "Int"
      capacity: 9
      min: 0
      max: 2
      domain: cellsOf(topology: grid)
      cells: map(range(0, 9), i => {
        key: $"{i}",
        value: seed[i]
      }
      )
    }

    row {
      name: "marked"
      kind: "Int"
      capacity: 9
      min: 0
      max: 1
      domain: cellsOf(topology: grid)
      cells: map(range(0, 9), i => {
        key: $"{i}",
        value: 0
      }
      )
    }

    row {
      name: "canvas"
      kind: "Int"
      capacity: 9
      min: 0
      max: 9
      domain: cellsOf(topology: grid)
      cells: map(range(0, 9), i => {
        key: $"{i}",
        value: 5
      }
      )
    }
  }
}

set contested: board(stones, 1..2) & ~board(stones, 2..2)

rule "paint" {
  mode: Level
  transform boardCombine(row: marked, operation: Copy, left: contested)
  transform writeSet(row: canvas, set: contested, value: 7)
}

test "a rule's transforms read a declared set by its name" {
  expect {
    sum(marked) == 4
    marked[3] == 1
    marked[2] == 0
    sum(canvas) == 53
    canvas[7] == 7
    canvas[8] == 5
  }
}
