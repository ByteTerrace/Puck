    material: 2
  }
  shape Box "back-rosette-tr" {
    position [0.24, 0.42, 0.024]
    scale [0.06, 0.06, 0.002]
    rotation [0, 0, 0.38268343, 0.92387953]
    material: 2
  }
  shape Box "back-rosette-bl" {
    position [-0.24, -0.42, 0.024]
    scale [0.06, 0.06, 0.002]
    rotation [0, 0, 0.38268343, 0.92387953]
    material: 2
  }
  shape Box "back-rosette-br" {
    position [0.24, -0.42, 0.024]
    scale [0.06, 0.06, 0.002]
    rotation [0, 0, 0.38268343, 0.92387953]
    material: 2
  }
}

// A suit mark is a gold rim under a raised suit-coloured core, the reference shader's rim/core construction.
// Every rim is the same world width, suitRimWidth, whatever the mark's size: paths are rimmed by a stroke of their
// own outline, and the club's disc lobes by the same discs grown by that width. Clubs and spades are composed
// (lobes or a crown, plus a stem) rather than drawn as one path, so each can carry its own flared stem.
let suitMarkDepth = 0.003
let suitRimWidth = 0.006

// The club's character: a bow, a horizontal offset of offset + y * (linear + quadratic * y) in suit units, the
// curve the original club path carried.
let clubBend = { offset: -0.04, linear: -0.02, quadratic: 0.16 }

// The club in suit units (the same frame the suit paths use: about -0.55..0.55 tall). Each lobe is a disc, shifted
// by the bow at its height; the heart disc closes the gap between the three lobes.
let clubLobes = map([
  { tag: "top", cx: 0, cy: 0.33, r: 0.19 }
  { tag: "left", cx: -0.18, cy: 0.02, r: 0.19 }
  { tag: "right", cx: 0.18, cy: 0.02, r: 0.19 }
  { tag: "heart", cx: 0, cy: 0.12, r: 0.12 }
], lobe => {
  tag: lobe["tag"]
  cx: lobe["cx"] + clubBend["offset"] + lobe["cy"] * (clubBend["linear"] + clubBend["quadratic"] * lobe["cy"])
  cy: lobe["cy"]
  r: lobe["r"]
}
)

// The club's stem runs from a neck hidden inside the lobes down to a wide, flat foot. Its flanks flare concavely by sag
// and follow the bow. Each flank's x is quadratic along its length (straight flank + bow + sag), so it is exactly a
// quadratic Bezier whose control point is 2 * mid - (start + end) / 2. Stem paths are suit units / clubStemFrame.
let clubStemFrame = 0.65
let clubStemSpecs = [
  { top: 0.08, bottom: -0.48, neck: 0.03, foot: 0.13, sag: 0.025 }
]
// Per stem: the bow at the neck, the middle, and the foot.
let clubStemBows = map(clubStemSpecs, s => {
  top: clubBend["offset"] + s["top"] * (clubBend["linear"] + clubBend["quadratic"] * s["top"])
  mid: clubBend["offset"] + (s["top"] + s["bottom"]) / 2 * (clubBend["linear"] + clubBend["quadratic"] * ((s["top"] + s["bottom"]) / 2))
  bottom: clubBend["offset"] + s["bottom"] * (clubBend["linear"] + clubBend["quadratic"] * s["bottom"])
}
)
let clubStems = map(clubStemSpecs, (s, i) => {
  start [(clubStemBows[i]["top"] - s["neck"]) / clubStemFrame, s["top"] / clubStemFrame]
  segments [
    { end [(clubStemBows[i]["top"] + s["neck"]) / clubStemFrame, s["top"] / clubStemFrame] }
    {
      end [(clubStemBows[i]["bottom"] + s["foot"]) / clubStemFrame, s["bottom"] / clubStemFrame]
      control [(2 * (clubStemBows[i]["mid"] + (s["neck"] + s["foot"]) / 2 - s["sag"]) - (clubStemBows[i]["top"] + s["neck"] + clubStemBows[i]["bottom"] + s["foot"]) / 2) / clubStemFrame, (s["top"] + s["bottom"]) / 2 / clubStemFrame]
    }
    { end [(clubStemBows[i]["bottom"] - s["foot"]) / clubStemFrame, s["bottom"] / clubStemFrame] }
    {
      end [(clubStemBows[i]["top"] - s["neck"]) / clubStemFrame, s["top"] / clubStemFrame]
      control [(2 * (clubStemBows[i]["mid"] - (s["neck"] + s["foot"]) / 2 + s["sag"]) - (clubStemBows[i]["top"] - s["neck"] + clubStemBows[i]["bottom"] - s["foot"]) / 2) / clubStemFrame, (s["top"] + s["bottom"]) / 2 / clubStemFrame]
    }
  ]
}
)
let clubStemContour = clubStems[0]

// The spade is its own drawing, in suit units. Its crown is a slender flame: the point leans a little off centre and
// the flanks are ogees, concave under the tip and swelling into full shoulders, before the two lobes round down into a
// cleft. Its stem is unbowed, a slim stalk that trumpets out into a bell foot with an arched underside.
let spadeTipLean = 0.035
let spadeBodyContour = {
  start [spadeTipLean, 0.56]
  segments [
    { end [0.47, -0.05], control [spadeTipLean + 0.07, 0.42], control2 [0.52, 0.18] }
    { end [0.2, -0.3], control [0.43, -0.22], control2 [0.33, -0.3] }
    { end [0, -0.16], control [0.09, -0.3], control2 [0.03, -0.23] }
    { end [-0.2, -0.3], control [-0.03, -0.23], control2 [-0.09, -0.3] }
    { end [-0.47, -0.05], control [-0.33, -0.3], control2 [-0.43, -0.22] }
    { end [spadeTipLean, 0.56], control [-0.52, 0.18], control2 [spadeTipLean - 0.07, 0.42] }
  ]
}
let spadeStemContour = {
  start [-0.028, -0.08]
  segments [
    { end [0.028, -0.08] }
    { end [0.17, -0.55], control [0.035, -0.46] }
    { end [-0.17, -0.55], control [0, -0.48] }
    { end [-0.028, -0.08], control [-0.035, -0.46] }
  ]
}

// The rim of a mark drawn from a closed path: its outline stroked by the rim width, whose inner half the core covers.
template pathRim(name, contour, x, y, frame, flipped, z, depth, material) {
  shape Prism name {
    position [x, y, z]
    scale [frame, frame, depth]
    rotation: flipped ? [1, 0, 0, 0] : [0, 1, 0, 0]
    material: material
    profile {
      kind: "Path"
      cornerRadius: 0
      path {
        tolerance: 0.001
        stroke {
          radiusStart: suitRimWidth / frame
          radiusEnd: suitRimWidth / frame
        }
        contours [
          {
            start: contour["start"]
            segments: contour["segments"]
            closed: true
          }
        ]
      }
    }
  }
}

template pathCore(name, contour, x, y, frame, flipped, z, depth, material) {
  shape Prism name {
    position [x, y, z]
    scale [frame, frame, depth]
    rotation: flipped ? [1, 0, 0, 0] : [0, 1, 0, 0]
    material: material
    profile {
      kind: "Path"
      cornerRadius: 0
      path {
        tolerance: 0.001
        contours [contour]
      }
    }
  }
}

// A pip is drawn mirrored across x when upright (the path suits' [0, 1, 0, 0] turn) and turned half-way when
// flipped, so the bow keeps the same hand in both orientations.
template clubMark(name, x, y, size, flipped, rimZ, coreZ, rimDepth, coreDepth, rimMat, coreMat) {
  let facing = flipped ? -1 : 1
  let side = -facing
  for (layer, l) in [
    { tag: "rim", z: rimZ, depth: rimDepth, grow: suitRimWidth / size, material: rimMat }
    { tag: "core", z: coreZ, depth: coreDepth, grow: 0, material: coreMat }
  ] {
    for (lobe, i) in clubLobes {
      shape Cylinder $"""{name}-{layer["tag"]}-{lobe["tag"]}""" {
        position [x + side * size * lobe["cx"], y + facing * size * lobe["cy"], layer["z"]]
        scale [size * (lobe["r"] + layer["grow"]), layer["depth"], size * (lobe["r"] + layer["grow"])]
        rotation [0.70710678, 0, 0, 0.70710678]
        material: layer["material"]
      }
    }
  }
  pathRim(name: $"{name}-rim-stem", contour: clubStemContour, x: x, y: y, frame: size * clubStemFrame, flipped: flipped, z: rimZ, depth: rimDepth, material: rimMat)
  pathCore(name: $"{name}-core-stem", contour: clubStemContour, x: x, y: y, frame: size * clubStemFrame, flipped: flipped, z: coreZ, depth: coreDepth, material: coreMat)
}

template spadeMark(name, x, y, size, flipped, rimZ, coreZ, rimDepth, coreDepth, rimMat, coreMat) {
  pathRim(name: $"{name}-rim-body", contour: spadeBodyContour, x: x, y: y, frame: size, flipped: flipped, z: rimZ, depth: rimDepth, material: rimMat)
  pathRim(name: $"{name}-rim-stem", contour: spadeStemContour, x: x, y: y, frame: size, flipped: flipped, z: rimZ, depth: rimDepth, material: rimMat)
  pathCore(name: $"{name}-core-body", contour: spadeBodyContour, x: x, y: y, frame: size, flipped: flipped, z: coreZ, depth: coreDepth, material: coreMat)
  pathCore(name: $"{name}-core-stem", contour: spadeStemContour, x: x, y: y, frame: size, flipped: flipped, z: coreZ, depth: coreDepth, material: coreMat)
}

// Hearts and diamonds are one closed path each, with their aspect baked into the outline.
template pathMark(name, suit, x, y, size, flipped, rimZ, coreZ, rimDepth, coreDepth, rimMat) {
  pathRim(name: $"{name}-rim", contour: suit["path"]["contours"][0], x: x, y: y, frame: size, flipped: flipped, z: rimZ, depth: rimDepth, material: rimMat)
  pathCore(name: $"{name}-core", contour: suit["path"]["contours"][0], x: x, y: y, frame: size, flipped: flipped, z: coreZ, depth: coreDepth, material: suit["mat"])
}

template suitMark(name, suit, x, y, size, flipped = 0, rimZ = -0.024, coreZ = -0.028, rimDepth = suitMarkDepth, coreDepth = suitMarkDepth, rimMat = 2) {
  for (club, i) in filter([suit], s => s["motif"] == 1) {
    clubMark(name: name, x: x, y: y, size: size, flipped: flipped, rimZ: rimZ, coreZ: coreZ, rimDepth: rimDepth, coreDepth: coreDepth, rimMat: rimMat, coreMat: suit["mat"])
  }
  for (spade, i) in filter([suit], s => s["motif"] == 2) {
    spadeMark(name: name, x: x, y: y, size: size, flipped: flipped, rimZ: rimZ, coreZ: coreZ, rimDepth: rimDepth, coreDepth: coreDepth, rimMat: rimMat, coreMat: suit["mat"])
  }
  for (other, i) in filter([suit], s => s["motif"] == 0) {
    pathMark(name: name, suit: suit, x: x, y: y, size: size, flipped: flipped, rimZ: rimZ, coreZ: coreZ, rimDepth: rimDepth, coreDepth: coreDepth, rimMat: rimMat)
  }
}

template cardIndices(rankPath, suit) {
  shape Prism "rank-tl" {
    position [0.69, 1.05, -0.024]
    scale [0.10, 0.075, 0.003]
    rotation [0, 1, 0, 0]
    material: 2
    profile {
      kind: "Path"
      cornerRadius: 0
      path: rankPath
    }
  }
  shape Prism "rank-br" {
    position [-0.69, -1.05, -0.024]
    scale [0.10, 0.075, 0.003]
    rotation [1, 0, 0, 0]
    material: 2
    profile {
      kind: "Path"
      cornerRadius: 0
      path: rankPath
    }
  }
  suitMark(name: "suit-tl", suit: suit, x: 0.69, y: 0.84, size: suit["indexSize"])
  suitMark(name: "suit-br", suit: suit, x: -0.69, y: -0.84, size: suit["indexSize"], flipped: 1)
}

