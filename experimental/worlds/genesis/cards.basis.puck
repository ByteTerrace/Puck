// motif selects how suitMark draws the suit: 0 its single closed path, 1 the club composition, 2 the spade's.
let suits = [
  { code: "c", key: "clubs", motif: 1, mat: 10, indexSize: 0.11 }
  { code: "d", key: "diamonds", motif: 0, path: suitDiamonds, mat: 4, indexSize: 0.085 }
  { code: "h", key: "hearts", motif: 0, path: suitHearts, mat: 4, indexSize: 0.11 }
  { code: "s", key: "spades", motif: 2, mat: 10, indexSize: 0.085 }
]

