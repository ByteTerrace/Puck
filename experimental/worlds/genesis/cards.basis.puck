schema: "puck.world.definition.v1"
documentId: "cards-basis-v1"

// Playing card dimensions (standard 2.5" x 3.5" proportion)
let cardHalfWidth = 0.88
let cardHalfHeight = 1.24
let cardHalfThickness = 0.02
let heartAspect = 0.74074074

state {
  world {
    // Deck theme - authors can override any slot in their world definition
    table cardTheme {
      face = "#272A34"
      back = "#B31B2C"
      backAccent = "#FFE06B"
      border = "#FFD65C"
      courtField = "#1E1D28"
      suitRed = "#B51B26"
      suitBlack = "#030304"
    }
  }
}

