let suitDiamonds = {
  tolerance: 0.001
  contours [
    {
      start [0.0, -0.55]
      segments [
        { end [0.38, 0.0] }
        { end [0.0, 0.55] }
        { end [-0.38, 0.0] }
      ]
    }
  ]
}
// The heart: two semicircular lobes over a point, with its authored bow (offset + y * (linear + quadratic * y),
// y clamped to the heart's height) and width aspect baked into the contour. Baking them keeps the path free of a
// shear, which a stroked outline cannot carry, so the heart takes the same uniform rim as every other suit.
let heartBow = { offset: -0.0693, linear: 0.028, quadratic: 0.28, from: -0.55, to: 0.45 }
let heartLobeRadius = 0.35355339
let heartArcSteps = 16
let heartOutline = concat(
  [[0, -0.55], [0.5, -0.05]],
  map(range(1, heartArcSteps - 1), k => [0.25 + heartLobeRadius * cosine(-0.78539816 + 3.14159265 * k / heartArcSteps), 0.2 + heartLobeRadius * sine(-0.78539816 + 3.14159265 * k / heartArcSteps)]),
  [[0, 0.45]],
  map(range(1, heartArcSteps - 1), k => [-0.25 + heartLobeRadius * cosine(0.78539816 + 3.14159265 * k / heartArcSteps), 0.2 + heartLobeRadius * sine(0.78539816 + 3.14159265 * k / heartArcSteps)]),
  [[-0.5, -0.05]]
)
let heartPoints = map(heartOutline, p => [(p[0] + heartBow["offset"] + clamp(p[1], heartBow["from"], heartBow["to"]) * (heartBow["linear"] + heartBow["quadratic"] * clamp(p[1], heartBow["from"], heartBow["to"]))) * heartAspect, p[1]])
let suitHearts = {
  tolerance: 0.001
  contours [
    {
      start: heartPoints[0]
      segments: map(filter(heartPoints, (p, i) => i), p => { end: p })
    }
  ]
}

