  { color: "state.cardTheme.face", metal: 0.04, roughness: 0.40, specular: 0.04 }
  { color: "state.cardTheme.border", emissive: 0.15, metal: 0.98, roughness: 0.12, specular: 0.8 }
  { color: "state.cardTheme.backAccent", emissive: 0.20, metal: 0.96, roughness: 0.10, specular: 0.8 }
