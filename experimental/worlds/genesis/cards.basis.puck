template makeAce(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphA, suit: suit)
      suitMark(name: "center-ace-pip", suit: suit, x: 0, y: 0, size: 0.44)
    }
  }
}

template makePipCard(id, pal, backMat, rankGlyph, suit, pips) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: rankGlyph, suit: suit)
      for (p, i) in pips {
        suitMark(name: $"cpip-{i + 1}", suit: suit, x: p[0], y: p[1], size: 0.13, flipped: p[2])
      }
    }
  }
}

template makeJack(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphJ, suit: suit)
      shape Prism "court-field" {
        position [0, 0, -0.022]
        scale [0.59, 0.925, 0.002]
        material: 3
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.057
        }
      }
      courtFaceBorder()
      courtJack()
    }
  }
}

template makeQueen(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphQ, suit: suit)
      shape Prism "court-field" {
        position [0, 0, -0.022]
        scale [0.59, 0.925, 0.002]
        material: 3
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.057
        }
      }
      courtFaceBorder()
      courtQueen(suit: suit)
    }
  }
}

template makeKing(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphK, suit: suit)
      shape Prism "court-field" {
        position [0, 0, -0.022]
        scale [0.59, 0.925, 0.002]
        material: 3
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.057
        }
      }
      courtFaceBorder()
      courtKing()
    }
  }
}

template makeBack(id, pal, backMat) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
    }
  }
}

// One entry per deck to generate. Every deck is a full 52-card set plus its back, differing only in palette, so a
// second themed deck is one more entry here (with its own theme table and palette).
let decks = [
  { prefix: "card", back: "card-back", palette: deckPalette }
]

prototypes {
  for (deck, d) in decks {
    for (suit, s) in suits {
      makeAce(id: $"""{deck["prefix"]}-{suit["code"]}-a""", pal: deck["palette"], backMat: 11, suit: suit)
      for (rank, r) in pipRanks {
        makePipCard(id: $"""{deck["prefix"]}-{suit["code"]}-{rank["code"]}""", pal: deck["palette"], backMat: 11, rankGlyph: rank["glyph"], suit: suit, pips: rank["pips"])
      }
      makeJack(id: $"""{deck["prefix"]}-{suit["code"]}-j""", pal: deck["palette"], backMat: 11, suit: suit)
      makeQueen(id: $"""{deck["prefix"]}-{suit["code"]}-q""", pal: deck["palette"], backMat: 11, suit: suit)
      makeKing(id: $"""{deck["prefix"]}-{suit["code"]}-k""", pal: deck["palette"], backMat: 11, suit: suit)
    }
    makeBack(id: deck["back"], pal: deck["palette"], backMat: 11)
  }
}
