// A gilded frame ring: the band between two rounded-rectangle contours, each given by its corner-arc centre
// (ax, ay) and half-extents (w, h) in frame units (x frameScale). The ring is emitted as four straight strips
// plus four corner pieces rather than one closed path: a whole-ring path's bound covers the entire card face, so
// every march sample over the face paid for every edge, while the pieces' bounds stay local. The strips and
// corners overlap by a quarter of the band so their union is exactly the original band, with no internal seam.
let frameScale = 1.3
let goldBandOuter = { ax: 0.60923077, ay: 0.88615385, w: 0.66461538, h: 0.94153846 }
let goldBandInner = { ax: 0.60153846, ay: 0.87846154, w: 0.64769231, h: 0.92461538 }
// The hairline and pinstripe are 0.006 world units wide (w - inner w, x frameScale), about two pixels at hero
// framing: narrower, a single-sample render breaks them into tile-periodic dashes.
let hairlineOuter = { ax: 0.59692308, ay: 0.87384615, w: 0.64076923, h: 0.91769231 }
let hairlineInner = { ax: 0.59692308, ay: 0.87384615, w: 0.63615384, h: 0.91307692 }
let pinstripeOuter = { ax: 0.58615385, ay: 0.86307692, w: 0.62076923, h: 0.89769231 }
let pinstripeInner = { ax: 0.58615385, ay: 0.86307692, w: 0.61615385, h: 0.89307692 }
let courtMouldingOuter = { ax: 0.42769231, ay: 0.68538462, w: 0.45384615, h: 0.71153846 }
let courtMouldingInner = { ax: 0.42153846, ay: 0.67923077, w: 0.44153846, h: 0.69923077 }
let courtLipOuter = { ax: 0.42, ay: 0.67769231, w: 0.43538462, h: 0.69307692 }
let courtLipInner = { ax: 0.41692308, ay: 0.67461538, w: 0.42769231, h: 0.68538462 }

template frameRing(name, outer, inner, z, depth, material) {
  let x0 = minimum(outer["ax"], inner["ax"])
  let y0 = minimum(outer["ay"], inner["ay"])
  let overlap = minimum(outer["h"] - inner["h"], outer["w"] - inner["w"]) * 0.25
  let xa = x0 - overlap
  let ya = y0 - overlap
  let cx = (xa + outer["w"]) / 2
  let cy = (ya + outer["h"]) / 2
  let half = maximum(outer["w"] - xa, outer["h"] - ya) * 0.51
  for (strip, i) in [
    { tag: "top", x: 0, y: (outer["h"] + inner["h"]) / 2, hw: x0, hh: (outer["h"] - inner["h"]) / 2 }
    { tag: "bottom", x: 0, y: -(outer["h"] + inner["h"]) / 2, hw: x0, hh: (outer["h"] - inner["h"]) / 2 }
    { tag: "left", x: -(outer["w"] + inner["w"]) / 2, y: 0, hw: (outer["w"] - inner["w"]) / 2, hh: y0 }
    { tag: "right", x: (outer["w"] + inner["w"]) / 2, y: 0, hw: (outer["w"] - inner["w"]) / 2, hh: y0 }
  ] {
    shape Prism $"""{name}-{strip["tag"]}""" {
      position [strip["x"] * frameScale, strip["y"] * frameScale, z]
      scale [strip["hw"] * frameScale, strip["hh"] * frameScale, depth]
      material: material
      profile {
        kind: "RoundedRectangle"
        cornerRadius: 0
      }
    }
  }
  // Each corner is authored in the top-right quadrant and mirrored by (qx, qy); a single-axis mirror reverses the
  // contour's winding, so the arcs' clockwise flags flip with it.
  for (corner, i) in [
    { tag: "tr", qx: 1, qy: 1, outerClockwise: true, innerClockwise: false }
    { tag: "tl", qx: -1, qy: 1, outerClockwise: false, innerClockwise: true }
    { tag: "br", qx: 1, qy: -1, outerClockwise: false, innerClockwise: true }
    { tag: "bl", qx: -1, qy: -1, outerClockwise: true, innerClockwise: false }
  ] {
    shape Prism $"""{name}-{corner["tag"]}""" {
      position [corner["qx"] * cx * frameScale, corner["qy"] * cy * frameScale, z]
      scale [half * frameScale, half * frameScale, depth]
      material: material
      profile {
        kind: "Path"
        cornerRadius: 0
        path {
          // The whole ring flattened its arcs at 0.0005 frame units; the same tolerance in local units keeps the
          // identical subdivision, so the corner polygons are the original ring's own vertices.
          tolerance: 0.0005 / half
          contours [
            {
              start [corner["qx"] * (xa - cx) / half, corner["qy"] * (inner["h"] - cy) / half]
              segments [
                { end [corner["qx"] * (xa - cx) / half, corner["qy"] * (outer["h"] - cy) / half] }
                { end [corner["qx"] * (outer["ax"] - cx) / half, corner["qy"] * (outer["h"] - cy) / half] }
                { end [corner["qx"] * (outer["w"] - cx) / half, corner["qy"] * (outer["ay"] - cy) / half], arcCenter [corner["qx"] * (outer["ax"] - cx) / half, corner["qy"] * (outer["ay"] - cy) / half], clockwise: corner["outerClockwise"] }
                { end [corner["qx"] * (outer["w"] - cx) / half, corner["qy"] * (ya - cy) / half] }
                { end [corner["qx"] * (inner["w"] - cx) / half, corner["qy"] * (ya - cy) / half] }
                { end [corner["qx"] * (inner["w"] - cx) / half, corner["qy"] * (inner["ay"] - cy) / half] }
                { end [corner["qx"] * (inner["ax"] - cx) / half, corner["qy"] * (inner["h"] - cy) / half], arcCenter [corner["qx"] * (inner["ax"] - cx) / half, corner["qy"] * (inner["ay"] - cy) / half], clockwise: corner["innerClockwise"] }
              ]
            }
          ]
        }
      }
    }
  }
}

template cardFaceBorder() {
  frameRing(name: "front-outer-gilded-band", outer: goldBandOuter, inner: goldBandInner, z: -0.024, depth: 0.0035, material: 1)
  frameRing(name: "front-perimeter-hairline", outer: hairlineOuter, inner: hairlineInner, z: -0.0222, depth: 0.0016, material: 2)
  frameRing(name: "front-inner-pinstripe", outer: pinstripeOuter, inner: pinstripeInner, z: -0.0228, depth: 0.002, material: 1)
}

// The reference frame's bead rail (card.hlsl): small flat beads between the hairline and the pinstripe. Each rail
// is one shape folded into every copy: it repeats along its edge and mirrors across the card.
let ornamentBead = { radius: 0.0048, spacing: 0.048, inset: 0.063, z: -0.0232, depth: 0.0022 }

template cardFaceOrnaments() {
  shape Cylinder "front-bead-rail-horizontal" {
    position [0, cardHalfHeight - ornamentBead["inset"], ornamentBead["z"]]
    scale [ornamentBead["radius"], ornamentBead["depth"], ornamentBead["radius"]]
    rotation [0.70710678, 0, 0, 0.70710678]
    material: 2
    domain [
      symmetry(normal: [0, 1, 0])
      repeat(spacing: [ornamentBead["spacing"], 1, 1], limit: [15, 0, 0])
    ]
  }
  shape Cylinder "front-bead-rail-vertical" {
    position [cardHalfWidth - ornamentBead["inset"], 0, ornamentBead["z"]]
    scale [ornamentBead["radius"], ornamentBead["depth"], ornamentBead["radius"]]
    rotation [0.70710678, 0, 0, 0.70710678]
    material: 2
    domain [
      symmetry(normal: [1, 0, 0])
      repeat(spacing: [1, ornamentBead["spacing"], 1], limit: [0, 23, 0])
    ]
  }
}

template courtFaceBorder() {
  frameRing(name: "court-outer-moulding", outer: courtMouldingOuter, inner: courtMouldingInner, z: -0.0252, depth: 0.0035, material: 1)
  frameRing(name: "court-inner-lip", outer: courtLipOuter, inner: courtLipInner, z: -0.0242, depth: 0.0025, material: 2)
}

