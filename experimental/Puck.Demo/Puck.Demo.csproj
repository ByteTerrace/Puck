<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Arc 3 Beat B (docs/demo-to-world-port-plan.md) retired the demo's composition root, so the project is no
             longer a runnable program (deleting Program.cs from an Exe is CS5001). It stays a compiling Library until
             Arc 12 does `git rm -r src/Puck.Demo`. The plan anticipated a teardown-window <NoWarn> for orphaned-island
             analyzer diagnostics; none fire against the surviving islands under this repo's analyzer set, so none is
             added. -->
        <OutputType>Library</OutputType>
        <!-- Opts out of the repo-wide AOT/trim default; 28 findings, and the only entry on the backlog that should
             never be paid. Arc 12 of docs/demo-to-world-port-plan.md deletes this project outright, so its
             reflection-JSON findings die with it. Anything ported out of here into Puck.World arrives as that
             project's debt. -->
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <!-- The DirectX Shader Compiler (ships with the Vulkan SDK and the Windows SDK) compiles the demo's
             cursor-overlay HLSL to both SPIR-V (Vulkan) and DXIL (DirectX). Override with /p:DxcCommand="path\to\dxc". -->
        <DxcCommand>dxc</DxcCommand>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Puck.Assets\Puck.Assets.csproj" />
        <ProjectReference Include="..\Puck.Authoring\Puck.Authoring.csproj" />
        <ProjectReference Include="..\Puck.Launcher\Puck.Launcher.csproj" />
        <ProjectReference Include="..\Puck.Capture\Puck.Capture.csproj" />
        <ProjectReference Include="..\Puck.Input\Puck.Input.csproj" />
        <ProjectReference Include="..\Puck.Maths\Puck.Maths.csproj" />
        <ProjectReference Include="..\Puck.Platform\Puck.Platform.csproj" />
        <ProjectReference Include="..\Puck.DirectX.Presentation\Puck.DirectX.Presentation.csproj" />
        <ProjectReference Include="..\Puck.Scene\Puck.Scene.csproj" />
        <!-- The engine benchmark harness (puck.bench): the demo is its FIRST content provider — it registers the
             standard suite's scenes and the feature-switch roster against the harness's neutral attach surface. -->
        <ProjectReference Include="..\Puck.Bench\Puck.Bench.csproj" />
        <ProjectReference Include="..\Puck.SdfVm\Puck.SdfVm.csproj" />
        <ProjectReference Include="..\Puck.Text\Puck.Text.csproj" />
        <ProjectReference Include="..\Puck.AdvancedGamingBrick\Puck.AdvancedGamingBrick.csproj" />
        <ProjectReference Include="..\Puck.HumbleGamingBrick\Puck.HumbleGamingBrick.csproj" />
        <ProjectReference Include="..\Puck.Storage\Puck.Storage.csproj" />
        <ProjectReference Include="..\Puck.Vulkan.Presentation\Puck.Vulkan.Presentation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.*, )" />
        <!-- Rasterizes the on-screen developer console's monospace glyph atlas via GDI+ (Windows only; the console
             overlay degrades to the terminal console elsewhere). Mirrors the reference terminal's SystemDrawing font
             generator. -->
        <PackageReference Include="System.Drawing.Common" Version="[10.*, )" />
    </ItemGroup>

    <ItemGroup>
        <!-- Ship the compiled overlay bytecode alongside the demo (the fullscreen vertex stage comes from
             Puck.SdfVm's content). -->
        <Content Include="Assets\Shaders\**\*.spv" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\Shaders\**\*.dxil" CopyToOutputDirectory="PreserveNewest" />
        <!-- Ship the committed creation-review SCENARIOS next to the demo so the scenario flag resolves
             scenarios/name.json from the output directory (see ScenarioCliSeams). -->
        <Content Include="scenarios\**\*.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- Ship the pre-baked MTSDF font atlas (one combined PNG + a layout/kerning JSON per face) -
             see tools/font-atlas/README.md for the bake pipeline that produces these. -->
        <Content Include="Assets\Fonts\**\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\Fonts\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <FragmentShaderSource Include="Assets\Shaders\**\*.frag.hlsl" />
        <ComputeShaderSource Include="Assets\Shaders\**\*.comp.hlsl" />
    </ItemGroup>

    <!-- Compile each *.frag.hlsl to BOTH SPIR-V (Vulkan; entry renamed to "main") and DXIL (DirectX), mirroring
         Puck.SdfVm. The vk:: attributes are SPIR-V-only, so the DXIL pass suppresses the "attribute ignored" warnings. -->
    <Target BeforeTargets="PrepareForBuild" Inputs="@(FragmentShaderSource);@(ComputeShaderSource);$(MSBuildProjectFullPath)" Name="CompileShaders" Outputs="@(FragmentShaderSource -> '%(RootDir)%(Directory)%(Filename).spv');@(FragmentShaderSource -> '%(RootDir)%(Directory)%(Filename).dxil');@(ComputeShaderSource -> '%(RootDir)%(Directory)%(Filename).spv')">
        <Exec Command="&quot;$(DxcCommand)&quot; --version" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="High" StandardOutputImportance="Low">
            <Output PropertyName="DxcProbeExitCode" TaskParameter="ExitCode" />
        </Exec>
        <Error Condition="'$(DxcProbeExitCode)' != '0'" Text="Puck.Demo shader compilation requires '$(DxcCommand)' (the DirectX Shader Compiler) to run. Install the Vulkan SDK or Windows SDK, or pass /p:DxcCommand=&quot;path\to\dxc&quot;." />
        <Exec Condition="'$(DxcProbeExitCode)' == '0' and '%(FragmentShaderSource.FullPath)' != ''" Command="&quot;$(DxcCommand)&quot; -spirv -fspv-target-env=vulkan1.3 -fspv-entrypoint-name=main -enable-16bit-types -O3 -T ps_6_6 -E PSMain -Fo &quot;%(FragmentShaderSource.RootDir)%(FragmentShaderSource.Directory)%(FragmentShaderSource.Filename).spv&quot; &quot;%(FragmentShaderSource.FullPath)&quot;" />
        <Exec Condition="'$(DxcProbeExitCode)' == '0' and '%(FragmentShaderSource.FullPath)' != ''" Command="&quot;$(DxcCommand)&quot; -Wno-ignored-attributes -enable-16bit-types -O3 -T ps_6_6 -E PSMain -Fo &quot;%(FragmentShaderSource.RootDir)%(FragmentShaderSource.Directory)%(FragmentShaderSource.Filename).dxil&quot; &quot;%(FragmentShaderSource.FullPath)&quot;" />
        <!-- Compute kernels: SPIR-V only for now (the Vulkan compute path); entry CSMain renamed to "main". Same
             vulkan1.3 / SM 6.6 / -O3 / -enable-16bit-types capability floor as every other DXC invocation. -->
        <Exec Condition="'$(DxcProbeExitCode)' == '0' and '%(ComputeShaderSource.FullPath)' != ''" Command="&quot;$(DxcCommand)&quot; -spirv -fspv-target-env=vulkan1.3 -fspv-entrypoint-name=main -enable-16bit-types -O3 -T cs_6_6 -E CSMain -Fo &quot;%(ComputeShaderSource.RootDir)%(ComputeShaderSource.Directory)%(ComputeShaderSource.Filename).spv&quot; &quot;%(ComputeShaderSource.FullPath)&quot;" />
    </Target>
</Project>
