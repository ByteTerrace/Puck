schema: "puck.world.definition.v1"

// The card's half extents, as card.glsl models it; the shader is the reference the native card is built against.
let cardHalfWidth = 0.88
let cardHalfHeight = 1.24
let cardHalfThickness = 0.02

host {
  exitAfterSeconds: 0
  fullscreen: false
  height: 900
  presentMode: Immediate
  presentation: Windowed
  rayQuery: true
  surfaceFormat: r8g8b8a8
  targetHertz: 60
  timing: false
  title: "Genesis card"
  width: 1440
}

cameras [
  {
    name: "front"
    renderHeight: 900
    renderWidth: 720
    rig {
      name: "front"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 0, 4.8]))
        lookAt(subject: worldPoint(point: [0, 0, 0]))
        fieldOfView(fieldOfViewRadians: 0.5419)
      ]
    }
  }
]

prototypes {
  prototype "card" {
    document {
      schema: "puck.creation.v1"
      name: "card"
      // Linear albedos under the authored studio lighting below.
      palette [
        {
          color: "#141721"
          metal: 0.04
          roughness: 0.4
          specular: 0.04
        }
        {
          color: "#FFD65C"
          emissive: 0.15
          metal: 0.98
          roughness: 0.12
          specular: 0.8
        }
        {
          color: "#FFE06B"
          emissive: 0.2
          metal: 0.96
          roughness: 0.1
          specular: 0.8
        }
        {
          color: "#12172E"
          metal: 0.1
          roughness: 0.3
          specular: 0.04
        }
        {
          color: "#D91726"
          emissive: 0.2
          metal: 0.2
          roughness: 0.16
          specular: 0.3
        }
      ]
      // Positions negate engine X/Z. Asymmetric profiles also undo the creation's 180-degree yaw.
      shape Prism "body" {
        position [0,0,0]
        scale [cardHalfWidth, cardHalfHeight, cardHalfThickness]
        material: 0
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.09090909090909091
        }
      }
      shape Prism "court-recess" {
        position [0,0,-0.032]
