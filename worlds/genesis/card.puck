render {
  lighting {
    lights [
      directional(direction: [-0.4, 0.7, 1], color: "#FFF3DC", weight: 1.1, angularRadius: 0.15)
      hemisphere(color: "#E5E9FF", base: 0.6, gradient: 0.05)
    ]
  }
  environment {
    softboxes [
      { direction [0.1, 0.25, 1], size [0.45, 0.5], color: "#FFF4DE", weight: 0.8, blur: 0.2 }
    ]
    horizon { low: "#282C38", high: "#9AA1B8" }
  }
  tonemap: Filmic
}

placements {
  placement "queen" {
    prototype: "queen"
    position [0, 0, 0]
  }
  placement "card" {
    prototype: "card"
    position [0, 0, 0]
  }
}

views {
  pipeline "card" {
    camera: "front"
    source: "card.glsl"
  }

  // The shader on the left and the native card on the right, through one camera.
  layout "compare" {
    slots [
      { pipeline: "card", width: 0.5 }
      { camera: "front", x: 0.5, width: 0.5 }
    ]
  }

  layout "shader" {
    slots [{ pipeline: "card" }]
  }
}
