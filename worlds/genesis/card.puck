  prototype "queen" {
    document {
      schema: "puck.creation.v1"
      name: "queen"
      // Shader-derived relief. GLSL rot2D(a) rotates points clockwise; the shape pose uses the inverse.
      // The hood uses a rounded prism; the shoulders still omit the reference's waist-only drape.
      palette [
        {
          color: "#141721"
          metal: 0.04
          roughness: 0.4
          specular: 0.04
        }
        {
          color: "#FFD65C"
          emissive: 0.15
