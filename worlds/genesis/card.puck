schema: "puck.world.definition.v1"
basis: "cards.basis"
documentId: "card-hero-shots"

// The reference matrix: one row per suit, one column per rank. cardIndex (0..51) walks it row-major, and the
// hero camera orbits whichever card it selects.
let heroSuits = [
  { code: "h", y: 6.80 }
  { code: "d", y: 4.00 }
  { code: "c", y: 1.20 }
  { code: "s", y: -1.60 }
]
let heroRanks = ["a", "2", "3", "4", "5", "6", "7", "8", "9", "10", "j", "q", "k"]
let heroColumns = [-12.90, -10.75, -8.60, -6.45, -4.30, -2.15, 0.00, 2.15, 4.30, 6.45, 8.60, 10.75, 12.90]
let heroCards = reduce(heroSuits, [], (running, suit) => concat(running, map(heroRanks, (rank, r) => {
  code: $"""{suit["code"]}-{rank}"""
  camera: $"""cam-{suit["code"]}-{rank}"""
  x: heroColumns[r]
  y: suit["y"]
}
)
)
)
// One orbit camera per matrix card; the hero camera selects among them by cardIndex.
let heroCameras = map(heroCards, card => {
  name: card["camera"]
  renderHeight: 900
  renderWidth: 1440
  rig {
    name: card["camera"]
    version: "puck.camera.program.v1"
    operations [
      anchor(subject: worldPoint(point: [card["x"], card["y"], -9.0]))
      orbit(distance: 4.8, yaw: state.camAngle.yaw, pitch: state.camAngle.pitch)
      fieldOfView(fieldOfViewRadians: state.camAngle.fov)
    ]
  }
}
)
let heroCases = map(heroCards, (card, i) => { value: i, program: card["camera"] })

host {
  exitAfterSeconds: 0
  fullscreen: false
  height: 900
  presentMode: Immediate
  presentation: Windowed
  surfaceFormat: r8g8b8a8
  targetHertz: 60
  title: "Puck - Playing Card Hero Shots"
  width: 1440
}

grants [
  {
    capability: Mutate
    grantee: "seat1"
    subject: "section:state"
  }
  {
    capability: Edit
    grantee: "seat1"
    subject: "all"
  }
  {
    capability: Control
    grantee: "seat1"
    subject: "all"
  }
  {
    capability: Drive
    grantee: "seat1"
    subject: "all"
  }
]

bindingOverlays [
  {
    id: "showcase-bindings"
    document {
      version: "puck.input.bindings.v1"
      modifiers []
      chords [
        {
          chord []
          group: "play"
          page {
            id: "showcase-controls"
            entries [
              // 1-4: Hero, raw-shader compare, raw shader alone, full-deck matrix
              { command: "view.override", id: "view-1", sources ["keyboard.1"], value { kind: "Axis1D", raw [1, 0, 0, 0] } }
              { command: "view.override", id: "view-2", sources ["keyboard.2"], value { kind: "Axis1D", raw [2, 0, 0, 0] } }
              { command: "view.override", id: "view-3", sources ["keyboard.3"], value { kind: "Axis1D", raw [3, 0, 0, 0] } }
              { command: "view.override", id: "view-4", sources ["keyboard.4"], value { kind: "Axis1D", raw [4, 0, 0, 0] } }

              // Tab: Cycle sequentially through layouts
              { command: "view.override", id: "view-tab", sources ["keyboard.tab"], value { kind: "Axis1D", raw [-2, 0, 0, 0] } }

              // Card Cycle Stepping (Right Arrow / D = Next Card, Left Arrow / A = Prev Card)
              { command: "world.state.cell.set", id: "card-step-next", sources ["keyboard.arrowRight", "keyboard.d"], text: "cardIndex val 1 add" }
              { command: "world.state.cell.set", id: "card-step-prev", sources ["keyboard.arrowLeft", "keyboard.a"], text: "cardIndex val -1 add" }

              // Key Angle Presets: Front (0), 3D Oblique (1), Back (2), Macro Detail (3)
              // Up / Down / W / S / E / Q: Step through preset key angles instantly
              { command: "world.state.cell.set", id: "angle-step-next", sources ["keyboard.arrowUp", "keyboard.w", "keyboard.e"], text: "angleMode val 1 add" }
              { command: "world.state.cell.set", id: "angle-step-prev", sources ["keyboard.arrowDown", "keyboard.s", "keyboard.q"], text: "angleMode val -1 add" }
            ]
          }
        }
      ]
    }
  }
]

dynamics [
  {
    name: "camTransition"
    f: 12.0
    zeta: 0.95
    r: 0.0
  }
]

views {
  layout "hero" {
    slots [{ camera: "hero", height: 1, width: 1, x: 0, y: 0 }]
  }
  pipeline "card-reference" {
    camera: "compare-native"
    source: "card.hlsl"
    timeScale: 0
  }
  layout "compare" {
    slots [
      { pipeline: "card-reference", height: 1, width: 0.5, x: 0, y: 0 }
      { camera: "compare-native", height: 1, width: 0.5, x: 0.5, y: 0 }
    ]
  }
  layout "shader" {
    slots [{ pipeline: "card-reference", height: 1, width: 1, x: 0, y: 0 }]
  }
  layout "matrix" {
    slots [{ camera: "matrix", height: 1, width: 1, x: 0, y: 0 }]
  }
}

cameras: concat([
  // Isolated native reference paired with card.hlsl in the compare and shader views.
  {
    name: "compare-native"
    renderHeight: 900
    renderWidth: 720
    rig {
      name: "compare-native"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 12, 4.86]))
        lookAt(subject: worldPoint(point: [0, 12, 0]))
        fieldOfView(fieldOfViewRadians: 0.5419)
      ]
    }
  }

  // Full 52-card reference matrix overview
  {
    name: "matrix"
    renderHeight: 900
    renderWidth: 1440
    rig {
      name: "matrix"
      version: "puck.camera.program.v1"
      operations [
        anchor(subject: worldPoint(point: [0, 2.6, -1.8]))
        lookAt(subject: worldPoint(point: [0, 2.6, -9.0]))
        fieldOfView(fieldOfViewRadians: 0.95)
      ]
    }
  }

  // Hero camera: frames the selected card (cardIndex) at the preset angle (angleMode)
  {
    name: "hero"
    renderHeight: 900
    renderWidth: 1440
    rig {
      name: "hero"
      version: "puck.camera.program.v1"
      operations [
        dynamics(row: camTransition)
        selectProgram(key: "state.cardIndex.val", default: "cam-h-a", cases: heroCases)
      ]
    }
  }
], heroCameras
)

state {
  world {
    table cardIndex bounds(0..51, overflow: Saturate) {
      val = 0
    }
    table angleMode bounds(0..3, overflow: Saturate) {
      val = 0
    }
    table camAngle {
      yaw = 0.0
      pitch = 0.0
      fov = 0.50
    }
  }
}

rule "angle-front" {
  when angleMode[val] == 0
  camAngle[yaw] = 0.0
  camAngle[pitch] = 0.0
  camAngle[fov] = 0.50
}

rule "angle-oblique" {
  when angleMode[val] == 1
  camAngle[yaw] = 0.52
  camAngle[pitch] = 0.30
  camAngle[fov] = 0.52
}

rule "angle-back" {
  when angleMode[val] == 2
  camAngle[yaw] = 3.14159
  camAngle[pitch] = 0.0
  camAngle[fov] = 0.50
}

rule "angle-macro" {
  when angleMode[val] == 3
  camAngle[yaw] = 0.12
  camAngle[pitch] = 0.15
  camAngle[fov] = 0.35
}

render {
  lighting {
    lights [
      directional(direction: [-0.4, 0.7, 1], color: "#FFF3DC", weight: 1.1, angularRadius: 0.15)
      hemisphere(color: "#E5E9FF", base: 0.6, gradient: 0.05)
    ]
  }
  environment {
    softboxes [
      { direction [0.1, 0.25, 1], size [0.45, 0.5], color: "#FFF4DE", weight: 0.8, blur: 0.2 }
    ]
    horizon {
      low: "#282C38"
      high: "#9AA1B8"
    }
  }
  tonemap: Filmic
}

placements {
  // Isolated from the matrix so the raw-shader comparison frames one card alone.
  placement "compare-card" {
    prototype: "card-c-q"
    position [0, 12.015, 0]
  }

  for (card, i) in heroCards {
    placement $"""ref-card-{card["code"]}""" {
      prototype: $"""card-{card["code"]}"""
      position [card["x"], card["y"], -9.0]
    }
  }
}
