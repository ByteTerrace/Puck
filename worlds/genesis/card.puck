          roughness: 0.1
          specular: 0.8
        }
        {
          color: "#12172E"
          metal: 0.1
          roughness: 0.3
          specular: 0.04
        }
        {
          color: "#D91726"
          emissive: 0.2
          metal: 0.2
          roughness: 0.16
          specular: 0.3
        }
        {
          color: "#F2CFA8"
          roughness: 0.5
          metal: 0
          specular: 0.04
        }
        {
          color: "#F5F0E6"
