// The physical room every rulepush world stands in: a floor, an arrival spot, a walking body for the seat, a camera
// behind it, and the walking controls: WASD and the left stick. A room opens a window unless its world is presented
// another way, as a canary booting a level offscreen presents it.

module room(centre: Point, size, presentation = "Windowed") {
  host {
    presentation: presentation
    backend: auto
    width: 1280
    height: 960
    surfaceFormat: r8g8b8a8
    fullscreen: false
    presentMode: Immediate
    targetHertz: 60
    exitAfterSeconds: 0
  }

  grants [
    {
      capability: Mutate
      grantee: "seat1"
      subject: "section:state"
    }
    {
      capability: Edit
      grantee: "seat1"
      subject: "all"
    }
    {
      capability: Control
      grantee: "seat1"
      subject: "all"
    }
    {
      capability: Drive
      grantee: "seat1"
      subject: "all"
    }
  ]

  ground floor {
    center: centre
    size: size
  }

  spawn arrival {
    at: centre + [0m, 1m, 0m]
    yaw: 0deg
  }

  channels [
    { name: "forward", role: MoveAdvance, shape: Bipolar, frame: Heading }
    { name: "strafe", role: MoveStrafe, shape: Bipolar, frame: Heading }
    { name: "turn", role: Turn, shape: Bipolar }
  ]

  bindingOverlays [
    {
      id: "walk"
      document {
        version: "puck.input.bindings.v1"
        modifiers []
        chords [
          {
            chord []
            group: "play"
            page {
              id: "base"
              entries [
                { channel: "forward", scale: 1, sources ["keyboard.w"] }
                { channel: "forward", scale: -1, sources ["keyboard.s"] }
                { channel: "strafe", scale: -1, sources ["keyboard.a"] }
                { channel: "strafe", scale: 1, sources ["keyboard.d"] }
                { command: "player.move.strafe", sources ["gamepad.leftStick"] }
              ]
            }
          }
        ]
      }
    }
  ]

  views {
    seatControl {
      maxPitch: 1.2
      minPitch: -0.35
      yawReference: "World"
    }

    seatRig "seatChase" {
      version: "puck.camera.program.v1"
      operations [
        orbit(distance: 9, pitch: 0.9, yaw: 0)
        lookAt(subject: reference(), targetOffset: [0, 1, 0], worldAxes: false)
        fieldOfView(fieldOfViewRadians: 0.9599)
      ]
    }
  }

  bodyMotionPrograms [
    {
      kind: Motion
      name: "walk"
      operations [
        ResolveYawAttitudeAndPlanarFrame
        ResolveHold
        ComputePlanarTargetVelocity
        ShapeVelocity
        SnapYawToPlanarIntent
        RunActionTriggers
        ApplyHold
        IntegratePlanarAndVerticalVelocity
        CommitPose
      ]
      version: "puck.body.program.v1"
    }
  ]

  collision {
    contactSkin: 0.02
    gradientProbe: 0
    maxIterations: 4
    maxSlopeDegrees: 60
    requirements [
      SmoothUnionContact
    ]
  }

  gravity {
    attractors []
    gravitationalConstant: 0
    softeningLength: 0.5
    solver: Pairwise
    uniform [0, -46, 0]
  }

  bodies {
    capacity: 2
    localSeats: 1
    seatSpawns [
      "arrival"
    ]
    sleepAfterSeconds: 0
  }

  defaultSeatKit: "walker"

  kits {
    rows [
      {
        bodyContact: Solid
        bodyMotionProgram: "walk"
        collider: capsule(endpoint: [0, 1, 0], radius: 0.35)
        motion {
          facingSnap: false
          holds [
            {
              bond: Surface
              cone [0, 60]
              envelope {
                sinkSpeed: 40
              }
              gravity {
                fall: 46
                rise: 28
              }
              hold: Gravity
              name: "ground"
              reach: 1.2
            }
            {
              bond: Free
              envelope {
                sinkSpeed: 40
              }
              gravity {
                fall: 46
                rise: 28
              }
              hold: Gravity
              name: "air"
            }
          ]
          shaping [
            {
              along {}
            }
          ]
          speed {
            value: 4
          }
          turn {
            rate: 2.5
          }
        }
        name: "walker"
      }
    ]
  }
}
