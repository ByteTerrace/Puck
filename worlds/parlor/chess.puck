// Physical chess: validate each settled observation against the last legal board.
// This source is canonical; compile it to regenerate the world document.

schema: "puck.world.definition.v1"
basis: "parlor.basis.puck"
documentId: "chess"

bodies {
  capacity: 40
}

let pieceTypes = ["pawn", "knight", "bishop", "rook", "queen", "king"]
let pieceLooks = concat(
  map(pieceTypes, kind => $"piece_white_{kind}"),
  map(pieceTypes, kind => $"piece_black_{kind}")
)

looks {
  rows: map(pieceLooks, name => {
    motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
    name: name
    scale: 1
    source: creation(prototypeId: name)
  }
  )
}

let boardCoords = [-0.7, -0.5, -0.3, -0.1, 0.1, 0.3, 0.5, 0.7]
let backRankTypes = ["rook", "knight", "bishop", "queen", "king", "bishop", "knight", "rook"]
let squareTypes = ["boardSquareDark", "boardSquareLight"]
let backRankCodes = [4, 2, 3, 5, 6, 3, 2, 4]
let initialBoard = concat(backRankCodes, map(range(0, 8), i => 1), map(range(0, 32), i => 0), map(range(0, 8), i => -1), map(backRankCodes, code => -code))
let initialPieceCodes = concat(backRankCodes, map(range(0, 8), i => 1), map(range(0, 8), i => -1), map(backRankCodes, code => -code))

template piecePlacement(name, prototypeName, x, z) {
  placement name {
    prototype: prototypeName
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "piece"
      look: prototypeName
      source: "Idle"
    }
    parent: "tabletop"
    position [x, 1.8, z]
  }
}

template pieceProto(color, name, sx, sy, sz) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        rotation: "state.transforms.identity"
        scale [sx, sy, sz]
      }
    }
  }
}

template crownedPieceProto(color, name, sx, sy, sz, csx, csy, csz, crownY) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        rotation: "state.transforms.identity"
        scale [sx, sy, sz]
      }
      shape Sphere "crown" {
        blend: "SmoothUnion"
        material: 0
        position [0, crownY, 0]
        rotation: "state.transforms.identity"
        scale [csx, csy, csz]
        smooth: 0.01
      }
    }
  }
}

template squareProto(name, colorKey) {
  prototype name {
    document {
      name: name
      palette [
        {
          color: $"state.boardColors.{colorKey}"
          roughness: 0.846
          specular: 0.05
        }
      ]
      schema: "puck.creation.v1"
      shape Box "square" {
        material: 0
        position [0, 0, 0]
        rotation: "state.transforms.identity"
        scale [0.095, 0.004, 0.095]
      }
    }
  }
}

kits {
  rows [
    {
      bodyContact: Solid
      bodyMotionProgram: "walk"
      collider: box(halfExtents: [0.045, 0.12, 0.045], rotation: [0, 0, 0, 1])
      motion {
        facingSnap: true
        holds [
          {
            bond: Free
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 0.001
        }
        turn {
          rate: 0.001
        }
      }
      name: "piece"
      rigid {
        angularDamping: 0.05
        friction: 0.5
        linearDamping: 0.05
        mass: 0.12
        restitution: 0.1
        rollingFriction: 0.15
      }
    }
  ]
}

pattern chessRayEmpty: Int {
  symbols {
    vacant = 0
  }
  match: vacant*
}

placements {
  placement "tabletop" {
    prototype: "tabletop"
    board {
      move: "move"
      occupancy: "board"
      plan: "plan"
      topology: "chessBoard"
      turn: "turn"
      verdict: "verdict"
    }
    position [-8, -0.5, 12]
    solid
  }

  for i in range(0, 8) {
    piecePlacement($"piece{i}", $"piece_white_{backRankTypes[i]}", boardCoords[i], -0.7)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{8 + i}", "piece_white_pawn", boardCoords[i], -0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{16 + i}", "piece_black_pawn", boardCoords[i], 0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{24 + i}", $"piece_black_{backRankTypes[i]}", boardCoords[i], 0.7)
  }

  for r in range(0, 8) {
    for c in range(0, 8) {
      placement $"boardSquare-{r * 8 + c}" {
        prototype: squareTypes[(r + c) % 2]
        parent: "tabletop"
        position [boardCoords[c], 1.305, boardCoords[r]]
      }
    }
  }
}

prototypes {
  prototype "tabletop" {
    document {
      name: "tabletop"
      palette [
        {
          color: "#8A6A45"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "top" {
        material: 0
        position [0, 1.25, 0]
        rotation: "state.transforms.identity"
        scale [1, 0.05, 1]
      }

      shape Cylinder "leg" {
        material: 0
        position [0, 0.6, 0]
        rotation: "state.transforms.identity"
        scale [0.08, 0.6, 0.08]
      }
    }
  }

  for color in ["white", "black"] {
    pieceProto(color, "pawn", 0.035, 0.09, 0.035)
    pieceProto(color, "knight", 0.04, 0.12, 0.04)
    pieceProto(color, "bishop", 0.04, 0.15, 0.04)
    pieceProto(color, "rook", 0.05, 0.11, 0.05)
    crownedPieceProto(color, "queen", 0.045, 0.17, 0.045, 0.055, 0.055, 0.055, 0.203)
    crownedPieceProto(color, "king", 0.045, 0.19, 0.045, 0.06, 0.06, 0.06, 0.226)
  }

  squareProto("boardSquareLight", "light")
  squareProto("boardSquareDark", "dark")
}

rule "tabletop-settle-hold-advance" {
  when physics(quiescent) == 1 and settleHold < 60
  mode: Level
  settleHold += 1
}

rule "tabletop-settle-hold-reset" {
  when physics(quiescent) != 1
  mode: Level
  settleHold = 0
}

// Keep the established rule names while sharing the settled-board gate and edge mode.
rules "" when settleHold == 60 {
  mode: "Edge"
  rule "tabletop-derive-cell-upright" {
    when upright(placement, $each) >= 0.5
    forEach: pieceCode
    pieceCell[$each] = board(cellOf, board, placement, $each)
  }

  rule "tabletop-derive-cell-tilted" {
    when not upright(placement, $each) >= 0.5
    forEach: pieceCode
    pieceCell[$each] = -1
  }

  rule "tabletop-board-collisions" {
    boardCollisions = count(pieceCell, atLeast: 0, atMost: 63) + setBitCount(board(mask, board, 0, 0)) - 64
  }

  rule "tabletop-game-start-snapshot" {
    when gameStarted == 0 and boardCollisions == 0
    transform boardCombine(left: board, operation: Copy, row: lastLegal)
  }

  rule "tabletop-candidate-cells" {
    local ownBefore = turn == 0 ? board(mask, lastLegal, 1, 6) : board(mask, lastLegal, -6, -1)
    local ownAfter = turn == 0 ? board(mask, board, 1, 6) : board(mask, board, -6, -1)
    local sources = ownBefore & ~(board(mask, board, 1, 6) | board(mask, board, -6, -1))
    local destinations = ownAfter & ~ownBefore
    local kingBefore = turn == 0 ? board(mask, lastLegal, 6, 6) : board(mask, lastLegal, -6, -6)
    local kingAfter = turn == 0 ? board(mask, board, 6, 6) : board(mask, board, -6, -6)
    local target = (sources & kingBefore) != 0 ? destinations & kingAfter : destinations
    move[from] = sources == 0 ? -1 : trailingZeroCount((sources & kingBefore) != 0 ? sources & kingBefore : sources)
    move[to] = target == 0 ? -1 : trailingZeroCount(target)
  }

  rule "tabletop-candidate-move" {
    local mover = lastLegal[move[from]]
    local kind = (move[from] < 0) | (move[to] < 0) | (move[to] > 63) ? MoveKind.Illegal : (absolute(mover) == PieceKind.King) & (absolute(move[to] - move[from]) == 2) ? MoveKind.Castle : (absolute(mover) == PieceKind.Pawn) & (((move[from] ^ move[to]) & 7) != 0) & (lastLegal[move[to]] == 0) ? MoveKind.EnPassant : lastLegal[move[to]] != 0 ? MoveKind.Capture : MoveKind.Quiet
    move[mover] = mover
    move[kind] = kind
    move[captured] = kind == MoveKind.EnPassant ? lastLegal[(move[to] - 8 * (1 - 2 * turn))] : lastLegal[move[to]]
  }

  // Search relocates the primary token; these hypothetical-only rules complete
  // the compound move before the same validator used for physical play judges it.
  rule "tabletop-search-en-passant" {
    when (((search(ply) > 0) & (move[kind] == MoveKind.EnPassant) & (move[to] == enPassantTarget) & (pieceCell[$each] == move[to] - 8 * (1 - 2 * turn))) == 1 : Int)
    forEach: pieceCode
    pieceCell[$each] = -1
  }

  rule "tabletop-search-castle" {
    when (((search(ply) > 0) & (move[kind] == MoveKind.Castle) & (pieceCell[$each] == (move[from] & 56) + (move[to] > move[from] ? 7 : 0)) & (pieceCode[$each] == 4 * (1 - 2 * turn))) == 1 : Int)
    forEach: pieceCode
    pieceCell[$each] = (move[from] + move[to]) >> 1
  }

  rule "tabletop-search-promotion" {
    when (((search(ply) > 0) & (absolute(move[mover]) == PieceKind.Pawn) & (pieceCell[$each] == move[to]) & (move[to] / 8 == (turn == TurnColor.White ? 7 : 0))) == 1 : Int)
    forEach: pieceCode
    pieceCode[$each] = PieceKind.Queen * (1 - 2 * turn)
  }

  rule "tabletop-candidate-match" {
    local changed = ((board(mask, board, -3, -2) | board(mask, board, 1, 2) | board(mask, board, 5, 6)) ^ (board(mask, lastLegal, -3, -2) | board(mask, lastLegal, 1, 2) | board(mask, lastLegal, 5, 6))) | ((board(mask, board, -5, -3) | board(mask, board, 2, 5)) ^ (board(mask, lastLegal, -5, -3) | board(mask, lastLegal, 2, 5))) | ((board(mask, board, -4, 3)) ^ (board(mask, lastLegal, -4, 3))) | ((board(mask, board, 0, 7)) ^ (board(mask, lastLegal, 0, 7)))
    local from = move[from]
    local to = move[to]
    local sign = 1 - 2 * turn
    local clear = move[kind] == MoveKind.Castle ? (from & 56) + (to > from ? 7 : 0) : move[kind] == MoveKind.EnPassant ? to - 8 * local(sign) : -1
    local rook = move[kind] == MoveKind.Castle ? ((from + to) >> 1) : -1
    local clearUnique = (clear >= 0) & (clear < 64) & (clear != from) & (clear != to)
    local rookUnique = (rook >= 0) & (rook < 64) & (rook != from) & (rook != to) & (rook != clear)
    local footprint = ((from >= 0) * (1 << maximum(from, 0))) | ((to >= 0) * (1 << maximum(to, 0))) | (clearUnique * (1 << clamp(clear, 0, 63))) | (rookUnique * (1 << clamp(rook, 0, 63)))
    local landed = (absolute(move[mover]) == PieceKind.Pawn) & (to / 8 == (turn == TurnColor.White ? 7 : 0)) ? board[move[to]] : move[mover]
    boardMismatch = setBitCount(changed & ~footprint) + (from >= 0) * (board[move[from]] != 0) + (to >= 0) * (board[move[to]] != landed) + clearUnique * (board[(clear)] != 0) + rookUnique * (board[(rook)] != 4 * local(sign))
    boardChanged = setBitCount(changed)
  }

  rule "tabletop-castle-transit-attacked" {
    when move[kind] == MoveKind.Castle
    castleTransitAttacked[wk] = 0
    castleTransitAttacked[wq] = 0
    castleTransitAttacked[bk] = 0
    castleTransitAttacked[bq] = 0
    if turn == TurnColor.White and move[to] > move[from] {
      castleTransitAttacked[wk] = ((board(mask, lastLegal, -1, -1) & 0x5000) != 0) | ((board(mask, lastLegal, -2, -2) & 0x508800) != 0) | ((board(mask, lastLegal, -6, -6) & 0x7050) != 0) | board(attacks, lastLegal, -5, -4, "N,S,E,W")[5] | board(attacks, lastLegal, -3, -3, "NE,SE,SW,NW")[5] | board(attacks, lastLegal, -5, -5, "NE,SE,SW,NW")[5]
    } else if turn == TurnColor.White {
      castleTransitAttacked[wq] = ((board(mask, lastLegal, -1, -1) & 0x1400) != 0) | ((board(mask, lastLegal, -2, -2) & 0x142200) != 0) | ((board(mask, lastLegal, -6, -6) & 0x1C14) != 0) | board(attacks, lastLegal, -5, -4, "N,S,E,W")[3] | board(attacks, lastLegal, -3, -3, "NE,SE,SW,NW")[3] | board(attacks, lastLegal, -5, -5, "NE,SE,SW,NW")[3]
    } else if move[to] > move[from] {
      castleTransitAttacked[bk] = ((board(mask, lastLegal, 1, 1) & byteSwap(0x5000)) != 0) | ((board(mask, lastLegal, 2, 2) & byteSwap(0x508800)) != 0) | ((board(mask, lastLegal, 6, 6) & byteSwap(0x7050)) != 0) | board(attacks, lastLegal, 4, 5, "N,S,E,W")[61] | board(attacks, lastLegal, 3, 3, "NE,SE,SW,NW")[61] | board(attacks, lastLegal, 5, 5, "NE,SE,SW,NW")[61]
    } else {
      castleTransitAttacked[bq] = ((board(mask, lastLegal, 1, 1) & byteSwap(0x1400)) != 0) | ((board(mask, lastLegal, 2, 2) & byteSwap(0x142200)) != 0) | ((board(mask, lastLegal, 6, 6) & byteSwap(0x1C14)) != 0) | board(attacks, lastLegal, 4, 5, "N,S,E,W")[59] | board(attacks, lastLegal, 3, 3, "NE,SE,SW,NW")[59] | board(attacks, lastLegal, 5, 5, "NE,SE,SW,NW")[59]
    }
  }

  rule "tabletop-castle-legal" {
    local sign = 1 - 2 * turn
    local home = 4 + 56 * turn
    local direction = move[to] > move[from] ? 1 : -1
    local rook = home + (direction == 1 ? 3 : -4)
    local right = (direction == 1 ? 2 : 1) << (2 * turn)
    local attacked = turn == TurnColor.White ? (direction == 1 ? castleTransitAttacked[wk] : castleTransitAttacked[wq]) : (direction == 1 ? castleTransitAttacked[bk] : castleTransitAttacked[bq])
    castleLegal = 0
    if move[kind] == MoveKind.Castle {
      castleLegal = (move[kind] == MoveKind.Castle) & (move[from] == home) & (move[to] == home + 2 * direction) & ((castleRights & right) == 0) & (lastLegal[(rook)] == PieceKind.Rook * local(sign)) & ((direction == 1 ? match(chessRayEmpty, lastLegal, E, cell)[move[from]] : match(chessRayEmpty, lastLegal, W, cell)[move[from]]) == rook) & (previousInCheck[turn[$value]] == 0) & (attacked == 0)
    }
  }

  rule "tabletop-shape-final" {
    local piece = absolute(move[mover])
    local dx = absolute(move[to] % 8 - move[from] % 8)
    local dy = (move[to] / 8 - move[from] / 8) * (1 - 2 * turn)
    local middle = move[from] + 8 * (1 - 2 * turn)
    shapeLegal = 0
    if piece == PieceKind.Pawn {
      shapeLegal = (dx == 0) & (lastLegal[move[to]] == 0) & maximum(dy == 1, (dy == 2) & (move[from] / 8 == (turn == TurnColor.White ? 1 : 6)) & (lastLegal[(middle)] == 0)) | (dx == 1) & (dy == 1) & maximum(move[kind] == MoveKind.Capture, (move[kind] == MoveKind.EnPassant) & (move[to] == enPassantTarget) & (move[captured] == 2 * turn - 1))
    } else if piece == PieceKind.Knight {
      shapeLegal = dx * absolute(dy) == 2
    } else if piece == PieceKind.King {
      shapeLegal = maximum((maximum(dx, absolute(dy)) == 1) & (move[kind] != MoveKind.Castle), castleLegal)
    } else {
      if piece == PieceKind.Rook or piece == PieceKind.Queen {
        shapeLegal = maximum(maximum(maximum(match(chessRayEmpty, lastLegal, N, cell)[move[to]] == move[from], match(chessRayEmpty, lastLegal, S, cell)[move[to]] == move[from]), match(chessRayEmpty, lastLegal, E, cell)[move[to]] == move[from]), match(chessRayEmpty, lastLegal, W, cell)[move[to]] == move[from])
      }
      if piece == PieceKind.Bishop or piece == PieceKind.Queen {
        shapeLegal = shapeLegal | (maximum(maximum(maximum(match(chessRayEmpty, lastLegal, NE, cell)[move[to]] == move[from], match(chessRayEmpty, lastLegal, SE, cell)[move[to]] == move[from]), match(chessRayEmpty, lastLegal, SW, cell)[move[to]] == move[from]), match(chessRayEmpty, lastLegal, NW, cell)[move[to]] == move[from]))
      }
    }
  }

  rule "tabletop-check-white" {
    local kingMask = lowestSetBit(board(mask, board, 6, 6))
    local kingSquare = kingMask == 0 ? -1 : trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    local closeHit = ((boardShift(nearFiles, chessBoard, S) & board(mask, board, -1, -1)) | ((kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) & board(mask, board, -6, -6))) != 0
    local knightHit = ((boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) | boardShift(farFiles, chessBoard, S) | boardShift(farFiles, chessBoard, N)) & board(mask, board, -2, -2)) != 0
    local slideHit = (kingMask != 0) & (board(attacks, board, -5, -4, "N,S,E,W")[(kingSquare)] | board(attacks, board, -3, -3, "NE,SE,SW,NW")[(kingSquare)] | board(attacks, board, -5, -5, "NE,SE,SW,NW")[(kingSquare)])
    inCheck[0] = closeHit | knightHit | slideHit
  }

  rule "tabletop-check-black" {
    local kingMask = lowestSetBit(board(mask, board, -6, -6))
    local kingSquare = kingMask == 0 ? -1 : trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    local closeHit = ((boardShift(nearFiles, chessBoard, N) & board(mask, board, 1, 1)) | ((kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) & board(mask, board, 6, 6))) != 0
    local knightHit = ((boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) | boardShift(farFiles, chessBoard, S) | boardShift(farFiles, chessBoard, N)) & board(mask, board, 2, 2)) != 0
    local slideHit = (kingMask != 0) & (board(attacks, board, 4, 5, "N,S,E,W")[(kingSquare)] | board(attacks, board, 3, 3, "NE,SE,SW,NW")[(kingSquare)] | board(attacks, board, 5, 5, "NE,SE,SW,NW")[(kingSquare)])
    inCheck[1] = closeHit | knightHit | slideHit
  }

  rule "tabletop-game-start-check" {
    when gameStarted == 0 and boardCollisions == 0
    previousInCheck[0] = inCheck[0]
    previousInCheck[1] = inCheck[1]
    gameStarted = 1
    historyPending = 1
    historyReset = 1
  }

  rule "tabletop-verdict" {
    local sign = 1 - 2 * turn
    local promotes = (absolute(move[mover]) == PieceKind.Pawn) & (move[to] / 8 == (turn == TurnColor.White ? 7 : 0))
    local replacement = promotes ? (board[move[to]] * local(sign) >= PieceKind.Knight) & (board[move[to]] * local(sign) <= PieceKind.Queen) : board[move[to]] == move[mover]
    local kings = (setBitCount(board(mask, board, 6, 6)) == 1) & (setBitCount(board(mask, board, -6, -6)) == 1)
    verdict = (halfmoveClock < 150) & (move[kind] >= MoveKind.Quiet) & (move[kind] <= MoveKind.Castle) & (boardMismatch == 0) & (boardCollisions == 0) & shapeLegal & replacement & (move[mover] * local(sign) > 0) & (move[captured] * local(sign) <= 0) & (inCheck[turn[$value]] == 0) & kings
    promotionPending[0] = boardChanged == 0 ? -1 : promotionPending[0]
    promotionPending[1] = boardChanged == 0 ? -1 : promotionPending[1]
  }

  rule "tabletop-promotion-pending" {
    when verdict == 0 and (((absolute(move[mover]) == PieceKind.Pawn) & (move[to] / 8 == (turn == TurnColor.White ? 7 : 0)) & (board[move[to]] == move[mover]) & shapeLegal & (boardMismatch == 0) & (boardCollisions == 0) & (inCheck[turn[$value]] == 0) & (setBitCount(board(mask, board, 6, 6)) == 1) & (setBitCount(board(mask, board, -6, -6)) == 1)) == 1 : Int)
    promotionPending[turn[$value]] = move[to]
  }

  rule "tabletop-advance-turn" {
    when verdict == 1 and move[kind] != MoveKind.Illegal
    local lostRooks = ((board(mask, lastLegal, 4, 4) & ~board(mask, board, 4, 4)) & 0x81) | ((board(mask, lastLegal, -4, -4) & ~board(mask, board, -4, -4)) & (0x81 << 56))
    local lostKings = ((board(mask, lastLegal, 6, 6) & ~board(mask, board, 6, 6)) & (1 << 4)) | ((board(mask, lastLegal, -6, -6) & ~board(mask, board, -6, -6)) & (1 << 60))
    local lostRights = parallelBitExtract(lostRooks, 0x81 | (0x81 << 56)) | (parallelBitDeposit(parallelBitExtract(lostKings, (1 << 4) | (1 << 60)), 5) * 3)
    transaction {
      // A pawn move, capture or lost castling right makes every earlier position unreachable.
      historyReset = (absolute(move[mover]) == PieceKind.Pawn) | (move[captured] != 0) | ((lostRights & ~castleRights) != 0)
      halfmoveClock = (absolute(move[mover]) == PieceKind.Pawn) | (move[captured] != 0) ? 0 : halfmoveClock + 1
      historyPending = 1
      castleRights = castleRights | lostRights
      transform boardCombine(left: board, operation: Copy, row: lastLegal)
      previousInCheck[0] = inCheck[0]
      previousInCheck[1] = inCheck[1]
      enPassantTarget = (absolute(move[mover]) == PieceKind.Pawn) & (absolute(move[to] - move[from]) == 16) ? ((move[from] + move[to]) >> 1) : -1
      turn = 1 - turn
      promotionPending[0] = -1
      promotionPending[1] = -1
    }
  }

  // Exact position identity: four injective piece-code bitplanes, plus side to
  // move, castling rights, and an en-passant target only when a legal capture exists.
  // The 75-move limit ends play after 150 reversible plies, so 151 positions
  // include the initial position and every possible repetition without eviction.
  rule "tabletop-history-prepare" {
    when historyPending == 1
    repetitionEnPassant = -1
    if historyReset == 1 {
      historyLength = 0
    }
  }

  rule "tabletop-history-en-passant-west" {
    when historyPending == 1 and enPassantTarget >= 0
    local sign = 1 - 2 * turn
    local source = enPassantTarget - 8 * local(sign) + (-1)
    local victim = enPassantTarget - 8 * local(sign)
    local kingMask = turn == TurnColor.White ? board(mask, board, 6, 6) : board(mask, board, -6, -6)
    local kingSquare = trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    if (((source >= 0) & (source < 64) & (source / 8 == victim / 8) & (enPassantTarget / 8 == (turn == TurnColor.White ? 5 : 2)) & (board[(source)] == local(sign)) & (board[(victim)] == -local(sign)) & (board[enPassantTarget[$value]] == 0) & (setBitCount(kingMask) == 1)) == 1 : Int) {
      transform boardCombine(left: board, operation: Copy, row: enPassantProbe)
      enPassantProbe[(source)] = 0
      enPassantProbe[(victim)] = 0
      enPassantProbe[enPassantTarget[$value]] = local(sign)
      if turn == TurnColor.White {
        enPassantProbeCheck = ((boardShift(nearFiles, chessBoard, S) & board(mask, enPassantProbe, -1, -1)) | ((kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) & board(mask, enPassantProbe, -6, -6))) != 0
        enPassantProbeCheck = enPassantProbeCheck | (((boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) | boardShift(farFiles, chessBoard, S) | boardShift(farFiles, chessBoard, N)) & board(mask, enPassantProbe, -2, -2)) != 0)
        enPassantProbeCheck = enPassantProbeCheck | board(attacks, enPassantProbe, -5, -4, "N,S,E,W")[(kingSquare)] | board(attacks, enPassantProbe, -3, -3, "NE,SE,SW,NW")[(kingSquare)] | board(attacks, enPassantProbe, -5, -5, "NE,SE,SW,NW")[(kingSquare)]
      } else {
        enPassantProbeCheck = ((boardShift(nearFiles, chessBoard, N) & board(mask, enPassantProbe, 1, 1)) | ((kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) & board(mask, enPassantProbe, 6, 6))) != 0
        enPassantProbeCheck = enPassantProbeCheck | (((boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) | boardShift(farFiles, chessBoard, S) | boardShift(farFiles, chessBoard, N)) & board(mask, enPassantProbe, 2, 2)) != 0)
        enPassantProbeCheck = enPassantProbeCheck | board(attacks, enPassantProbe, 4, 5, "N,S,E,W")[(kingSquare)] | board(attacks, enPassantProbe, 3, 3, "NE,SE,SW,NW")[(kingSquare)] | board(attacks, enPassantProbe, 5, 5, "NE,SE,SW,NW")[(kingSquare)]
      }
      if enPassantProbeCheck == 0 {
        repetitionEnPassant = enPassantTarget
      }
    }
  }

  rule "tabletop-history-en-passant-east" {
    when historyPending == 1 and enPassantTarget >= 0
    local sign = 1 - 2 * turn
    local source = enPassantTarget - 8 * local(sign) + (1)
    local victim = enPassantTarget - 8 * local(sign)
    local kingMask = turn == TurnColor.White ? board(mask, board, 6, 6) : board(mask, board, -6, -6)
    local kingSquare = trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    if (((source >= 0) & (source < 64) & (source / 8 == victim / 8) & (enPassantTarget / 8 == (turn == TurnColor.White ? 5 : 2)) & (board[(source)] == local(sign)) & (board[(victim)] == -local(sign)) & (board[enPassantTarget[$value]] == 0) & (setBitCount(kingMask) == 1)) == 1 : Int) {
      transform boardCombine(left: board, operation: Copy, row: enPassantProbe)
      enPassantProbe[(source)] = 0
      enPassantProbe[(victim)] = 0
      enPassantProbe[enPassantTarget[$value]] = local(sign)
      if turn == TurnColor.White {
        enPassantProbeCheck = ((boardShift(nearFiles, chessBoard, S) & board(mask, enPassantProbe, -1, -1)) | ((kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) & board(mask, enPassantProbe, -6, -6))) != 0
        enPassantProbeCheck = enPassantProbeCheck | (((boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) | boardShift(farFiles, chessBoard, S) | boardShift(farFiles, chessBoard, N)) & board(mask, enPassantProbe, -2, -2)) != 0)
        enPassantProbeCheck = enPassantProbeCheck | board(attacks, enPassantProbe, -5, -4, "N,S,E,W")[(kingSquare)] | board(attacks, enPassantProbe, -3, -3, "NE,SE,SW,NW")[(kingSquare)] | board(attacks, enPassantProbe, -5, -5, "NE,SE,SW,NW")[(kingSquare)]
      } else {
        enPassantProbeCheck = ((boardShift(nearFiles, chessBoard, N) & board(mask, enPassantProbe, 1, 1)) | ((kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) & board(mask, enPassantProbe, 6, 6))) != 0
        enPassantProbeCheck = enPassantProbeCheck | (((boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) | boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) | boardShift(farFiles, chessBoard, S) | boardShift(farFiles, chessBoard, N)) & board(mask, enPassantProbe, 2, 2)) != 0)
        enPassantProbeCheck = enPassantProbeCheck | board(attacks, enPassantProbe, 4, 5, "N,S,E,W")[(kingSquare)] | board(attacks, enPassantProbe, 3, 3, "NE,SE,SW,NW")[(kingSquare)] | board(attacks, enPassantProbe, 5, 5, "NE,SE,SW,NW")[(kingSquare)]
      }
      if enPassantProbeCheck == 0 {
        repetitionEnPassant = enPassantTarget
      }
    }
  }

  rule "tabletop-board-history" {
    when historyPending == 1
    push boardHistory0 = board(mask, board, -3, -2) | board(mask, board, 1, 2) | board(mask, board, 5, 6)
    push boardHistory1 = board(mask, board, -5, -3) | board(mask, board, 2, 5)
    push boardHistory2 = board(mask, board, -4, 3)
    push boardHistory3 = board(mask, board, 0, 6)
    push boardHistoryRights = turn | (castleRights << 1) | ((repetitionEnPassant + 1) << 5)
    historyLength += 1
    repetitionCount = 1
  }

  rule "tabletop-history-count" {
    when historyPending == 1 and historyAges[$each] < historyLength
    forEach: historyAges
    if (history(boardHistoryRights, 0) == history(boardHistoryRights, historyAges[$each]) : Int) and (history(boardHistory0, 0) == history(boardHistory0, historyAges[$each]) : Int) and (history(boardHistory1, 0) == history(boardHistory1, historyAges[$each]) : Int) and (history(boardHistory2, 0) == history(boardHistory2, historyAges[$each]) : Int) and (history(boardHistory3, 0) == history(boardHistory3, historyAges[$each]) : Int) {
      repetitionCount += 1
    }
  }

  rule "tabletop-history-finish" {
    when historyPending == 1
    historyPending = 0
  }

  rule "tabletop-apply-illegal" {
    when verdict == 0 and move[kind] != MoveKind.Illegal and boardMismatch == 0 and promotionPending[0] == -1 and promotionPending[1] == -1
    illegalCount += 1
  }
}

rule "chess-ai-evaluate" {
  when search(ply) > 0
  mode: Level
  ai[evaluation] = 100 * (setBitCount(board(mask, board, 1, 1)) - setBitCount(board(mask, board, -1, -1)))
  ai[evaluation] += 320 * (setBitCount(board(mask, board, 2, 2)) - setBitCount(board(mask, board, -2, -2)))
  ai[evaluation] += 330 * (setBitCount(board(mask, board, 3, 3)) - setBitCount(board(mask, board, -3, -3)))
  ai[evaluation] += 500 * (setBitCount(board(mask, board, 4, 4)) - setBitCount(board(mask, board, -4, -4)))
  ai[evaluation] += 900 * (setBitCount(board(mask, board, 5, 5)) - setBitCount(board(mask, board, -5, -5)))
  ai[evaluation] += 12 * (setBitCount(board(mask, board, 1, 3) & 0x00003C3C3C3C0000) - setBitCount(board(mask, board, -3, -1) & 0x00003C3C3C3C0000))
  ai[evaluation] += 8 * (setBitCount(board(mask, board, 1, 1) & 0x00FFFFFF00000000) - setBitCount(board(mask, board, -1, -1) & 0x00000000FFFFFF00))
}

// Optional opponent: aiSide = -1 disables it, 0 plays White, 1 plays Black.
// A completed answer belongs to exactly one settled physical position. Search
// never moves bodies; the live apply path acts once, then lets physics settle
// and the ordinary validator accept the resulting board.
rule "chess-ai-revision" {
  // Keep identity as well as geometry: exchanging two same-kind pieces still
  // invalidates a token-indexed answer. A saved piece packs square + 1 in
  // seven bits and code + 6 above it; metadata also fits in one exact Int.
  local metadata = turn | (castleRights << 1) | ((enPassantTarget + 1) << 5) | (halfmoveClock << 12) | (repetitionCount << 20) | (previousInCheck[0] << 27) | (previousInCheck[1] << 28)
  local pieceState = (pieceCell[$each] + 1) | ((pieceCode[$each] + 6) << 7)
  when settleHold == 60 and physics(quiescent) == 1 and (pieceState != aiBefore[$each] or metadata != ai[metadata])
  mode: Level
  forEach: pieceCode
  aiBefore[$each] = pieceState
  ai[metadata] = metadata
  aiRevision += 1
}

rule "chess-ai-enable" {
  mode: Level
  aiEnabled = (aiSide == turn) & (physics(quiescent) == 1) & (settleHold == 60) & (gameStarted == 1) & (boardCollisions == 0) & ((verdict == 1) | (boardChanged == 0)) & (halfmoveClock < 150) & (repetitionCount < 5)
}

rule "chess-ai-request" {
  when (((aiEnabled == 1) & (aiBest[revision] == aiRevision) & (aiBest[token] == pieceOrdinal[$each]) & (aiBest[to] >= 0) & (aiBest[to] < 64) & (physics(quiescent) == 1)) == 1 : Int)
  mode: Level
  forEach: pieceCode
  ai[from] = pieceCell[$each]
  ai[to] = aiBest[to]
  ai[mover] = pieceCode[$each]
  ai[pending] = 1
}

rule "chess-ai-relocate" {
  when (((ai[pending] == 1)) == 1 : Int)
  mode: Level
  forEach: pieceCode
  if (((pieceCell[$each] == ai[to])) == 1 : Int) {
    pieceCell[$each] = -1
  } else if (((pieceCell[$each] == ai[from])) == 1 : Int) {
    pieceCell[$each] = ai[to]
    if (((absolute(ai[mover]) == PieceKind.Pawn) & (ai[to] / 8 == (turn == TurnColor.White ? 7 : 0))) == 1 : Int) {
      pieceCode[$each] = PieceKind.Queen * (1 - 2 * turn)
    }
  } else if (((absolute(ai[mover]) == PieceKind.Pawn) & (ai[to] == enPassantTarget) & ((ai[from] & 7) != (ai[to] & 7)) & (pieceCell[$each] == ai[to] - 8 * (1 - 2 * turn))) == 1 : Int) {
    pieceCell[$each] = -1
  } else if (((absolute(ai[mover]) == PieceKind.King) & (absolute(ai[to] - ai[from]) == 2) & (pieceCell[$each] == (ai[from] & 56) + (ai[to] > ai[from] ? 7 : 0))) == 1 : Int) {
    pieceCell[$each] = (ai[from] + ai[to]) >> 1
  }
}

for i in range(0, 32) {
  rule $"chess-ai-place-{i}" {
    gate: compareValue(kind: Int, comparison: Equal, left: (ai[pending] == 1) & (pieceCell[$"piece{i}"] != ((aiBefore[$"piece{i}"] & 127) - 1)) & (pieceCell[$"piece{i}"] >= 0), right: 1)
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: pieceCell[$"piece{i}"], offset: [0, 0.3, 0])
  }
  rule $"chess-ai-capture-{i}" {
    gate: compareValue(kind: Int, comparison: Equal, left: (ai[pending] == 1) & (pieceCell[$"piece{i}"] != ((aiBefore[$"piece{i}"] & 127) - 1)) & (pieceCell[$"piece{i}"] < 0), right: 1)
    mode: Level
    // Each captured piece gets its own place beside the board.
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: 0, offset: [-0.4 - 0.15 * (i % 4), 0.3, 0.18 * (i / 4)])
  }
}

rule "chess-ai-finish" {
  when (((ai[pending] == 1)) == 1 : Int)
  mode: Level
  aiBest[token] = -1
  ai[pending] = 0
  aiEnabled = 0
  settleHold = 0
}

search {
  jobs [
    {
      name: "chessAI"
      tokens: pieceCell
      board: board
      turn: turn
      verdict: verdict
      enabled: aiEnabled
      revision: aiRevision
      depth: 1
      best: aiBest
      // The score is from the side that just moved. One ply, automatic queen
      // promotion, material first, then central occupation and pawn progress.
      "score": (2 * turn - 1) * ai[evaluation]
    }
  ]
}

state {
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }

  lattices [
    grid(band: 0.3, cellSize: 0.2, depth: 8, directions: [
      {
        name: "N"
        x: 0
        y: -1
        z: 0
      }
      {
        name: "NE"
        x: 1
        y: -1
        z: 0
      }
      {
        name: "E"
        x: 1
        y: 0
        z: 0
      }
      {
        name: "SE"
        x: 1
        y: 1
        z: 0
      }
      {
        name: "S"
        x: 0
        y: 1
        z: 0
      }
      {
        name: "SW"
        x: -1
        y: 1
        z: 0
      }
      {
        name: "W"
        x: -1
        y: 0
        z: 0
      }
      {
        name: "NW"
        x: -1
        y: -1
        z: 0
      }
    ], name: "chessBoard", origin: [-0.8, 1.25, -0.8], width: 8, wrap: None
    )
  ]

  world {
    row {
      capacity: 64
      domain: cellsOf(topology: chessBoard)
      kind: "Int"
      max: 6
      min: -6
      name: "board"
      inverse {
        tokens: "pieceCell"
        codes: "pieceCode"
      }
    }

    row {
      capacity: 64
      cells: map(initialBoard, (code, i) => { key: $"{i}", value: code })
      domain: cellsOf(topology: chessBoard)
      kind: "Int"
      max: 6
      min: -6
      name: "lastLegal"
    }

    row {
      capacity: 64
      domain: cellsOf(topology: chessBoard)
      kind: "Int"
      name: "plan"
    }

    table ai {
      evaluation = 0
      metadata = -1
      pending = 0
      from = -1
      to = -1
      mover = 0
    }
    slot aiSide = -1 bounds(-1..1)
    slot aiEnabled = 0 bounds(0..1)
    slot aiRevision = 0
    table aiBest {
      token = -1
      to = -1
      score = 0
      revision = -1
    }
    row {
      name: "pieceOrdinal"
      kind: "Int"
      cells: map(range(0, 32), i => { key: $"piece{i}", value: i })
    }
    row {
      name: "aiBefore"
      kind: "Int"
      capacity: 32
      cells: map(range(0, 32), i => { key: $"piece{i}", value: -1 })
    }

    slot turn = 0 bounds(0..1)

    slot verdict = 1 bounds(0..1)

    slot illegalCount = 0 bounds(0..50400)

    slot settleHold = 0 bounds(0..60)

    slot gameStarted = 0 bounds(0..1)

    table pieceSetColors {
      white = "#F2E9D8"
      black = "#2B2420"
    }

    table move capacity(5) bounds(-6..63) {
      captured = 0
      from = -1
      kind = 0
      mover = 0
      to = -1
    }

    row {
      name: "pieceCode"
      kind: "Int"
      capacity: 32
      min: -6
      max: 6
      cells: map(initialPieceCodes, (code, i) => { key: $"piece{i}", value: code })
    }

    row {
      name: "pieceCell"
      kind: "Int"
      capacity: 32
      min: -1
      max: 63
      cells: map(range(0, 32), i => { key: $"piece{i}", value: -1 })
    }

    table promotionPending capacity(2) bounds(-1..63) {
      "0" = -1
      "1" = -1
    }

    slot enPassantTarget = -1 bounds(-1..63)

    table inCheck capacity(2) bounds(0..1) {
      "0" = 0
      "1" = 0
    }

    for name in ["boardHistory0", "boardHistory1", "boardHistory2", "boardHistory3", "boardHistoryRights"] {
      row {
        name: name
        kind: "Int"
        domain: ring(capacity: 151, empty: 0)
      }
    }

    row {
      name: "historyAges"
      kind: "Int"
      cells: map(range(0, 75), i => { key: $"{i}", value: 2 * (i + 1) })
    }

    row {
      name: "enPassantProbe"
      kind: "Int"
      capacity: 64
      min: -6
      max: 6
      domain: cellsOf(topology: chessBoard)
    }

    slot enPassantProbeCheck = 0 bounds(0..1)
    slot repetitionEnPassant = -1 bounds(-1..63)
    slot historyPending = 0 bounds(0..1)
    slot historyReset = 0 bounds(0..1)
    slot historyLength = 0 bounds(0..151)
    slot halfmoveClock = 0 bounds(0..150)
    slot repetitionCount = 0 bounds(0..76)

    slot shapeLegal = 0 bounds(0..1)

    slot castleLegal = 0 bounds(0..1)

    table boardColors {
      light = "#F0D9B5"
      dark = "#8B5A2B"
    }

    slot castleRights = 0 bounds(0..15)

    table previousInCheck capacity(2) bounds(0..1) {
      "0" = 0
      "1" = 0
    }

    table castleTransitAttacked capacity(4) bounds(0..1) {
      wk = 0
      wq = 0
      bk = 0
      bq = 0
    }

    slot boardMismatch = 0 bounds(0..64)

    slot boardChanged = 0 bounds(0..64)

    slot boardCollisions = 0 bounds(0..64)
  }
}

test "pieces settle and derive initial board cells" {
  when {
    ticks 400
  }
  expect {
    pieceCell[piece12] == 12
    pieceCode[piece12] == PieceKind.Pawn
  }
}

test "e2e4 records legal" {
  when {
    ticks 400
    seat1: body.pose -7.9 1.3 11.9 0 0 0 27
    ticks 400
  }
  expect {
    verdict == 1
    pieceCell[piece12] == 28
    turn == TurnColor.Black
  }
}

test "illegal knight move records illegal then legal succeeds" {
  when {
    ticks 400
    seat1: body.pose -7.5 1.3 11.7 0 0 0 33
    ticks 400
    seat1: body.pose -7.7 1.3 11.7 0 0 0 33
    ticks 400
  }
  expect {
    verdict == 1
    illegalCount == 1
    pieceCell[piece6] == 21
    turn == TurnColor.Black
  }
}

test "king step records legal and multi step refused" {
  when {
    seat1: body.pose -7.1 1.3 11.7 0 0 0 27
    ticks 400
    seat1: body.pose -7.9 1.3 11.7 0 0 0 35
    ticks 400
    seat1: body.pose -7.9 1.3 11.5 0 0 0 35
    ticks 400
  }
  expect {
    verdict == 1
    illegalCount == 1
    move[kind] == MoveKind.Quiet
    move[mover] == PieceKind.King
    pieceCell[piece4] == 12
    turn == TurnColor.Black
  }
}

test "knight capture records move kind two" {
  when {
    seat1: body.pose -8.3 1.3 11.7 0 0 0 23
    ticks 400
    seat1: body.pose -7.1 1.3 11.7 0 0 0 23
    seat1: body.pose -8.3 1.3 11.7 0 0 0 38
    ticks 400
  }
  expect {
    verdict == 1
    move[kind] == MoveKind.Capture
    move[captured] == -1
    pieceCell[piece1] == 18
    pieceCell[piece16] == -1
    turn == TurnColor.Black
  }
}

test "pawn diagonal capture records legal" {
  when {
    seat1: body.pose -8.1 1.3 11.7 0 0 0 20
    ticks 400
    seat1: body.pose -7.1 1.3 11.7 0 0 0 20
    seat1: body.pose -8.1 1.3 11.7 0 0 0 27
    ticks 400
  }
  expect {
    verdict == 1
    move[kind] == MoveKind.Capture
    move[captured] == -1
    move[mover] == PieceKind.Pawn
    pieceCell[piece12] == 19
    pieceCell[piece19] == -1
    turn == TurnColor.Black
  }
}

test "queen diagonal slide records legal" {
  when {
    seat1: body.pose -7.1 1.3 11.7 0 0 0 27
    ticks 400
    seat1: body.pose -7.3 1.3 12.1 0 0 0 36
    ticks 400
  }
  expect {
    verdict == 1
    move[kind] == MoveKind.Quiet
    move[mover] == PieceKind.Queen
    pieceCell[piece3] == 39
    turn == TurnColor.Black
  }
}

test "white kingside castle records legal" {
  when {
    seat1: body.pose -7.1 1.3 11.3 0 0 0 34
    seat1: body.pose -7.1 1.3 11.5 0 0 0 33
    ticks 400
    seat1: body.pose -7.1 1.3 11.7 0 0 0 32
    ticks 400
    seat1: body.pose -7.3 1.3 11.3 0 0 0 32
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 35
    seat1: body.pose -7.7 1.3 11.3 0 0 0 32
    ticks 400
  }
  expect {
    verdict == 1
    move[kind] == MoveKind.Castle
    move[mover] == PieceKind.King
    move[from] == 4
    move[to] == 6
    pieceCell[piece4] == 6
    pieceCell[piece7] == 5
    castleRights == 3
    turn == TurnColor.Black
  }
}

test "castle cannot cross knight attack" {
  when {
    seat1: body.pose -7.1 1.3 11.3 0 0 0 34
    seat1: body.pose -7.1 1.3 11.5 0 0 0 33
    seat1: body.pose -7.5 1.3 11.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 35
    seat1: body.pose -7.7 1.3 11.3 0 0 0 32
    ticks 400
  }
  expect {
    castleTransitAttacked[wk] == 1
    verdict == 0
    turn == TurnColor.White
    castleRights == 0
  }
}

test "castle safe when knight does not attack transit" {
  when {
    seat1: body.pose -7.1 1.3 11.3 0 0 0 34
    seat1: body.pose -7.1 1.3 11.5 0 0 0 33
    seat1: body.pose -8.5 1.3 11.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 35
    seat1: body.pose -7.7 1.3 11.3 0 0 0 32
    ticks 400
  }
  expect {
    castleTransitAttacked[wk] == 0
    verdict == 1
    turn == TurnColor.Black
    castleRights == 3
  }
}

test "move leaving king in check is refused" {
  when {
    ticks 400
    seat1: body.pose -7.7 1.3 11.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.9 1.3 11.9 0 0 0 27
    ticks 400
  }
  expect {
    inCheck[0] == 1
    verdict == 0
    turn == TurnColor.White
  }
}

test "en passant capture records move kind en passant" {
  when {
    ticks 400
    seat1: body.pose -7.9 1.3 11.9 0 0 0 27
    ticks 400
    seat1: body.pose -8.7 1.3 12.3 0 0 0 23
    ticks 400
    seat1: body.pose -7.9 1.3 12.1 0 0 0 27
    ticks 400
    seat1: body.pose -8.1 1.3 12.1 0 0 0 20
    ticks 400
    seat1: body.pose -7.1 1.3 11.7 0 0 0 20
    seat1: body.pose -8.1 1.3 12.3 0 0 0 27
    ticks 400
  }
  expect {
    verdict == 1
    move[kind] == MoveKind.EnPassant
    move[captured] == -1
    pieceCell[piece12] == 43
    pieceCell[piece19] == -1
    turn == TurnColor.Black
  }
}

test "initial position counts in threefold repetition" {
  when {
    ticks 400
    seat1: body.pose -7.7 1.3 11.7 0 0 0 33
    ticks 400
    seat1: body.pose -7.7 1.3 12.3 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 33
    ticks 400
    seat1: body.pose -7.5 1.3 12.7 0 0 0 9
    ticks 400
    seat1: body.pose -7.7 1.3 11.7 0 0 0 33
    ticks 400
    seat1: body.pose -7.7 1.3 12.3 0 0 0 9
    ticks 400
    seat1: body.pose -7.5 1.3 11.3 0 0 0 33
    ticks 400
    seat1: body.pose -7.5 1.3 12.7 0 0 0 9
    ticks 400
  }
  expect {
    verdict == 1
    turn == TurnColor.White
    repetitionCount == 3
    historyLength == 9
    halfmoveClock == 8
  }
}

test "AI White makes one legal opening move and waits for Black" {
  given {
    aiSide = 0
  }
  when {
    ticks 900
  }
  expect {
    turn == TurnColor.Black
    verdict == 1
    ai[pending] == 0
    aiEnabled == 0
    aiBest[token] == -1
    boardCollisions == 0
  }
}

test "AI Black replies after a human opening" {
  given {
    aiSide = 1
  }
  when {
    ticks 400
    seat1: body.pose -7.9 1.3 11.9 0 0 0 27
    ticks 900
  }
  expect {
    turn == TurnColor.White
    ai[pending] == 0
    aiEnabled == 0
    aiBest[token] == -1
    boardCollisions == 0
  }
}

test "a stale AI answer cannot move a piece" {
  given {
    aiSide = 0
    aiBest[token] = 12
    aiBest[to] = 63
    aiBest[revision] = 0
  }
  when {
    ticks 900
  }
  expect {
    turn == TurnColor.Black
    pieceCell[piece12] != 63
    boardCollisions == 0
    ai[pending] == 0
  }
}
