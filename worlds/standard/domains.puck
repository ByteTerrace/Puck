// Navigation domains for a walking body: a surface domain sized for the body that walks it. A module library: it hands
// its importers functions and emits no document.
//
// A surface domain samples one ground per column, the first surface under its probe's start (origin height plus
// `probeUp`) and no deeper than `probeDown` under it. `walker` is the envelope the domain proves cells for: its
// `height` and `radius` in metres, the `step` it climbs and the steepest `slope` in degrees it walks. Every cell is
// searchable in one route (the expansion budget is the cell count), a route keeps up to `maxPathNodes` cells, and a
// body arrives within one cell.

// The standard walker's envelope: its 1.7 m capsule of 0.3 m radius (walker.puck), routed over 0.3 m steps and 50 degree
// slopes, under the standard's 60 so a route never leans on the limit.
let standardWalker = { height: 1.7, radius: 0.3, step: 0.3, slope: 50 }

// The area types a town's navigation marks (`navigation.areaTypes`): `road` where vehicles drive, `crossing` where a
// road is crossed on foot, `pavement` for the walkable ground beside them. A town lists them, marks its road strips and
// crossings as `navigation.areas` (a crossing after the road it crosses, since the last area holding a cell decides
// it), gives its pavement domains `area: "pavement"` and its road domains `area: "road"`, and lists the profiles of the
// bodies that walk or drive them (citizen.puck's `citizenProfile`, vehicle.puck's `vehicleProfile`). The engine gives
// no type a meaning: each costs what a profile says.
let townAreaTypes = ["road", "crossing", "pavement"]

// A town's area volume over the world-space box x0..x1, z0..z1, 2 m above and below its ground.
function townArea(type, x0, x1, z0, z1) = {
  type: type
  region {
    center [((x0 + x1) / 2), 0, ((z0 + z1) / 2)]
    halfExtents [((x1 - x0) / 2), 2, ((z1 - z0) / 2)]
  }
}

function surfaceDomain(name, origin, cellSize, width, depth, probeUp, probeDown, maxPathNodes, walker = standardWalker) = {
  name: name
  kind: Surface
  origin: origin
  cellSize: cellSize
  width: width
  depth: depth
  layers: 1
  probeUp: probeUp
  probeDown: probeDown
  agentHeight: walker.height
  agentRadius: walker.radius
  maxStepHeight: walker.step
  maxSlopeDegrees: walker.slope
  arrivalDistance: cellSize
  maxExpandedNodes: (width * depth)
  maxPathNodes: maxPathNodes
}
