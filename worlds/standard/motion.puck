// The standard's body motion programs, which an avatar's kits name by `bodyMotionProgram`. `walk` turns the body toward
// its planar intent, moves it at the kit's speed (backing at 0.7 of it and sidestepping at 0.85), runs its kit actions
// and holds it to the ground or lets it fall. Every avatar that walks imports it (the standard walker, walker.puck, and
// the debug world's, ../debug/avatars/moth/); a world refines a program by declaring a row of the same name in its
// own body, and an avatar's speeds, holds and turn stay in its own kit.

//
// A walker faces where its intent asks, unless a rule turns it to face a point: while `faceAt` reads 1 it faces the
// world point (`faceAtX`, `faceAtZ`) whatever it is pushed toward, so it can sidestep and backpedal about that point (a
// lock-on's target, lockon.puck; a speaker it is talking to). The rule writes the three body counters with
// `setBodyState`; the program only reads them.
template walkMotion() {
  state {
    body [
      { name: "faceAt", kind: "Counter", initial: 0, envelope { $type: "set", values [0, 1] } }
      { name: "faceAtX", kind: "Counter", initial: 0 }
      { name: "faceAtZ", kind: "Counter", initial: 0 }
    ]
  }

  bodyMotionPrograms [
    {
      kind: Motion
      name: "walk"
      operations [
        ResolveYawAttitudeAndPlanarFrame
        ResolveHold
        ComputePlanarTargetVelocity
        ShapeVelocity
        SnapYawToPlanarIntent
        RunActionTriggers
        ApplyHold
        IntegratePlanarAndVerticalVelocity
        CommitPose
      ]
      planarTarget {
        backward: 0.7
        strafe: 0.85
      }
      face {
        active: "faceAt"
        x: "faceAtX"
        z: "faceAtZ"
      }
      version: "puck.body.program.v1"
    }
  ]
}

// A kit action can use this in an effects list to ease the travel and turn in and out.
function easedTimedMove(duration, right = 0, forward = 0, yawDegrees = 0) = timedMove(
  right: right,
  forward: forward,
  yawDegrees: yawDegrees,
  durationSeconds: duration,
  curve: Smoothstep
)
