// The standard's rhythm judge, a library. `rhythmJudge(...)` grades a seat's presses against its world's beat and tracks the
// phrase they play, with no instrument and no dance in it: a phrase is a list of steps, each a note (any whole number)
// on a beat, and a press is a channel that means one note when it lands. A bard's vents, a dancer's moves and any other
// expression's buttons are the same call with different `presses` and `phrase`, so every one is judged by one set of rules
// against one clock.
//
// A press is graded by how far it fell from the nearest beat of the world's score, at the time the host captured it
// (sub-tick, plus the seat's calibration), and by which beat that was. The presses a step admitted are judged oldest
// first, so presses that share a step each count, up to `pressesPerStep` of them (the work sheet prices the rule at that
// many firings). The first press after a phrase ends starts a new
// one and is its first step's beat; each later step is due that many beats after the first (`beat` in the phrase). A
// press that lands on the awaited step's beat with the awaited note inside a window is a hit worth the window's grade
// (`perfect` 3, `good` 2, `ok` 1). Any other press on the beat, or the right note outside every window, is a miss. A press
// before its step's beat is a stray miss and leaves the step awaited. A beat that passes with no press at all is a miss
// for its step. A hit adds its grade to the phrase's strength and clears the run of misses. A miss lowers the strength by
// one (never below zero) and the phrase continues, and `missLimit` misses in a row end it. The last step judged
// completes it.
//
// The state is one keyed Int row named `judge`, with these cells for each seat `<s>` (1-based):
//
//   status<s>      0 playing or not started, 1 complete, 2 ended by misses
//   step<s>        the index of the awaited step, or the phrase's length once it ends
//   start<s>       the beat of the phrase's first press
//   strength<s>    the grades added so far, less one for each miss
//   misses<s>      the misses in a row
//
// `judgeGrade<s>` is seat s's grade for each step, keyed by step index (0 for a miss; the last phrase's, until a new one
// reaches the step). `judgePhrase` and `judgePhraseBeat` are the authored phrase as rows keyed by step index, and
// `judgeError` is the signed error in seconds of each seat's latest press (negative is early).
//
//   import "../standard/rhythm"
//   rhythmJudge(music: score, presses: [{ channel: "vent1", note: 1 }], phrase: [{ note: 1, beat: 0 }, { note: 1, beat: 1 }])

// The standard's windows, in seconds either side of a beat. They are exact Q48.16 values, so a press measured against a
// window never rounds across it. A world passes its own.
let rhythmWindows = { perfect: 0.03125, good: 0.0625, ok: 0.125 }

// The standard's phrase of four notes, one a beat.
let rhythmPhrase = [{ note: 1, beat: 0 }, { note: 2, beat: 1 }, { note: 3, beat: 2 }, { note: 4, beat: 3 }]

// What a judged step does to seat `s`'s cells, from the locals of the rule that splices it: `at` the step judged, `advance`
// whether the step is consumed (a stray press ahead of its beat is not), `got` the grade it earned (0 for a miss),
// `carried` and `missed` the strength and run of misses it began with, and `begin` the phrase's first beat.
rule template judgeResult(s, length, limit) {
  if advance == 1 {
    $"judgeGrade{s}"[at] = got
  }
  judge[$"strength{s}"] = (got > 0) ? (carried + got) : maximum(carried - 1, 0)
  judge[$"misses{s}"] = (got > 0) ? 0 : (missed + 1)
  judge[$"step{s}"] = at + advance
  judge[$"start{s}"] = begin
  judge[$"status{s}"] = ((got == 0) and (missed + 1 >= limit)) ? 2 : ((at + advance >= length) ? 1 : 0)
}

template rhythmJudge(music, presses, phrase, seats = 1, windows = rhythmWindows, missLimit = 2, pressesPerStep = 4, extraWorldRows = []) {
  let steps = length(phrase)

  state {
    world {
      row {
        name: "judgePhrase"
        kind: Int
        capacity: steps
        cells: map(range(0, steps), i => { key: $"{i}", value: phrase[i].note })
      }
      row {
        name: "judgePhraseBeat"
        kind: Int
        capacity: steps
        cells: map(range(0, steps), i => { key: $"{i}", value: phrase[i].beat - phrase[0].beat })
      }
      row {
        name: "judgeError"
        kind: Fixed
        capacity: seats
        cells: map(range(1, seats), s => { key: $"{s}", value: "0" })
      }
      row {
        name: "judge"
        kind: Int
        capacity: seats * 5
        cells: flatMap(range(1, seats), s => [
          { key: $"status{s}", value: 0 }
          { key: $"step{s}", value: 0 }
          { key: $"start{s}", value: 0 }
          { key: $"strength{s}", value: 0 }
          { key: $"misses{s}", value: 0 }
        ])
      }
      for s in range(1, seats) {
        row {
          name: $"judgeGrade{s}"
          kind: Int
          capacity: steps
          cells: map(range(0, steps), i => { key: $"{i}", value: 0 })
        }
      }
      for extra in extraWorldRows {
        row {
          name: extra.name
          kind: extra.kind
          capacity: extra.capacity
          cells: extra.cells
        }
      }
    }
  }

  for s in range(1, seats) {
    // One sweep over the seat's events in this step, oldest first, so two presses inside one step are each judged in the
    // order they happened, and the second reads what the first wrote. Each local chain below folds the presses' channels
    // into the one value the event at hand carries: whether it is a press, the note it means, and where it fell.
    rule $"judge-{s}" {
      forEach: $"$inputEvents:{s}"
      maxFirings: pressesPerStep
      local pressed0 = 0
      local note0 = 0
      local error0 = 0.0
      local beat0 = 0
      for (press, i) in presses {
        local $"pressed{i + 1}" = inputEdge(s, press.channel, Press, each) ? 1 : $"pressed{i}"
        local $"note{i + 1}" = inputEdge(s, press.channel, Press, each) ? press.note : $"note{i}"
        local $"error{i + 1}" = clock(music, phaseErrorAt, s, press.channel, Press, each) ?? $"error{i}"
        local $"beat{i + 1}" = clock(music, beatAt, s, press.channel, Press, each) ?? $"beat{i}"
      }
      local pressed = $"pressed{length(presses)}"
      local note = $"note{length(presses)}"
      local error = $"error{length(presses)}"
      local pressBeat = $"beat{length(presses)}"
      local distance = absolute(error)
      local window = (
        (distance <= windows.perfect) ? 3 : ((distance <= windows.good) ? 2 : ((distance <= windows.ok) ? 1 : 0))
      )
      local live = judge[$"status{s}"] == 0
      local at = live ? judge[$"step{s}"] : 0
      local carried = live ? judge[$"strength{s}"] : 0
      local missed = live ? judge[$"misses{s}"] : 0
      local begin = (at > 0) ? judge[$"start{s}"] : pressBeat
      local due = begin + judgePhraseBeat[at]
      local got = ((judgePhrase[at] == note) and (pressBeat == due)) ? window : 0
      local advance = (pressBeat < due) ? 0 : 1
      when pressed
      mode: Level
      judgeResult(s, steps, missLimit)
      judgeError[$"{s}"] = error
    }

    // A step whose beat has passed with no press is a miss, so a phrase the player stops playing ends on its own.
    rule $"judge-lapse-{s}" {
      local live = judge[$"status{s}"] == 0
      local at = live ? judge[$"step{s}"] : 0
      local carried = judge[$"strength{s}"]
      local missed = judge[$"misses{s}"]
      local begin = judge[$"start{s}"]
      local got = 0
      local advance = 1
      when live and at > 0 and clock(music, beat) >= (begin + judgePhraseBeat[at] + 1)
      mode: Level
      judgeResult(s, steps, missLimit)
    }
  }
}
