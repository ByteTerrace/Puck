// Standard controls: the default control sets of a world built on the standard, composed by context, and what they
// share (the cursor, the icon and badge tables, the binding bar, the play wheel and the trigger pages).
//
// A context is where a seat is and what it is doing: on foot, piloting a craft, swimming, sitting at a tabletop, using
// a terminal. Each has a document of its own under contexts/ that authors its controls as a binding group, and the
// seat's bindings switch group as its context changes (a binding overlay's `contexts` rows). This document lists the
// sets every world gets without declaring anything: on foot (the resting page), piloting and the tabletop. A world
// opts into the others where it has them (contexts/swimming.puck's `swimPlay`, contexts/terminal.puck's
// `terminalPlay`, typing.puck, instrument.puck, editor.puck, free-camera.puck).
//
// Import ../standard/standard, then refine rows by id in the importing document, list more sets after these, or author
// a `bindingOverlays` list of your own from the context libraries.

import "pad-kit"
import "contexts/on-foot"
import "contexts/piloting"
import "contexts/tabletop"

// Export the label and icon rows so a world's wheel refinement can read them.
exports {
  bindings [wheelLabels, wheelIcons]
}

let mono = "jetbrains-mono-regular"

// The cursor and the bar stay up while the seat is playing and fade a second after six seconds without input. Both
// step aside while the seat's view frames an engaged screen, so the framed screen shows its picture alone (the held view
// of a carried screen shows the bar, whose Frame control switches to the picture), and the bar steps aside
// while a wheel is open, whose hold page is no page of the bar's.
let shownWhilePlaying = {
  $type: "all"
  predicates [
    {
      $type: "recently"
      fact: SeatInput
      windowSeconds: 6
      fadeSeconds: 1
    }
    { $type: "not", predicate { $type: "now", fact: ScreenFramed } }
    { $type: "not", predicate { $type: "now", fact: WheelOpen } }
  ]
}

hud {
  defaults {
    enabled: true
    // A small ring drawn at the pointer for three seconds after it moves, lit in the accent while it hovers something
    // within 48 m. It shows on a framed screen too: an engaged console is where a pointer is wanted most, and a hidden
    // cursor casts no pointer, so a console's taps would never land.
    cursor {
      hoverRadius: 48
      sizePx: 7
      role: TextPrimary
      visible {
        $type: "recently"
        fact: PointerMotion
        windowSeconds: 3
        fadeSeconds: 0.5
      }
    }
  }
  // The standard draws no HUD panels; a world adds its own by id.
  panels []
}

icons {
  rows [
    { name: "bar.wings", label: "WG" }
    { name: "bar.wings.full", label: "W+" }
    { name: "bar.sides", label: "||" }
    { name: "bar.sides.full", label: "|+" }
    { name: "bar.compact", label: "S" }
    { name: "bar.full", label: "L" }
    // Key caps.
    { name: "key.w", label: "W" }
    { name: "key.a", label: "A" }
    { name: "key.s", label: "S" }
    { name: "key.d", label: "D" }
    { name: "key.e", label: "E" }
    { name: "key.f", label: "F" }
    { name: "key.g", label: "G" }
    { name: "key.q", label: "Q" }
    { name: "key.v", label: "V" }
    { name: "key.b", label: "B" }
    { name: "key.equals", label: "=" }
    { name: "key.minus", label: "-" }
    { name: "key.1", label: "1" }
    { name: "key.2", label: "2" }
    { name: "key.3", label: "3" }
    { name: "key.4", label: "4" }
    { name: "key.5", label: "5" }
    { name: "key.f2", label: "F2" }
    { name: "key.f3", label: "F3" }
    { name: "key.f4", label: "F4" }
    { name: "key.f6", label: "F6" }
    { name: "key.z", label: "Z" }
    { name: "key.x", label: "X" }
    { name: "key.space", glyph { font: mono, glyph: "U+2423" } }
    { name: "key.ctrl", glyph { font: mono, glyph: "U+2303" } }
    { name: "key.tab", glyph { font: mono, glyph: "U+21E5" } }
    { name: "mouse.left", label: "LM" }
    { name: "mouse.right", label: "RM" }

    // Pad buttons: the Xbox letters by default, with the PlayStation shapes and the Switch's swapped letters.
    { name: "pad.a", label: "A" }
    { name: "pad.b", label: "B" }
    { name: "pad.x", label: "X" }
    { name: "pad.y", label: "Y" }
    { name: "pad.cross", glyph { font: mono, glyph: "U+2715" } }
    { name: "pad.circle", glyph { font: mono, glyph: "U+25CB" } }
    { name: "pad.square", glyph { font: mono, glyph: "U+25A1" } }
    { name: "pad.triangle", glyph { font: mono, glyph: "U+25B3" } }
    { name: "pad.lb", label: "LB" }
    { name: "pad.l1", label: "L1" }
    { name: "pad.l", label: "L" }
    { name: "pad.rb", label: "RB" }
    { name: "pad.r1", label: "R1" }
    { name: "pad.r", label: "R" }
    { name: "pad.l3", label: "L3" }
    { name: "pad.r3", label: "R3" }
    { name: "pad.back", label: "BK" }
    { name: "pad.minus", label: "-" }
    { name: "pad.lt", label: "LT" }
    { name: "pad.l2", label: "L2" }
    { name: "pad.zl", label: "ZL" }
    { name: "pad.rt", label: "RT" }
    { name: "pad.r2", label: "R2" }
    { name: "pad.zr", label: "ZR" }

    // Arrows, for the d-pad and for movement.
    { name: "arrow.up", glyph { font: mono, glyph: "U+2191" } }
    { name: "arrow.down", glyph { font: mono, glyph: "U+2193" } }
    { name: "arrow.left", glyph { font: mono, glyph: "U+2190" } }
    { name: "arrow.right", glyph { font: mono, glyph: "U+2192" } }

    // Actions.
    { name: "act.turnLeft", glyph { font: mono, glyph: "U+21A9" } }
    { name: "act.turnRight", glyph { font: mono, glyph: "U+21AA" } }
    { name: "act.move", glyph { font: mono, glyph: "U+2295" } }
    { name: "act.look", glyph { font: mono, glyph: "U+25CE" } }
    { name: "act.recenter", glyph { font: mono, glyph: "U+2302" } }
    { name: "act.orbit", glyph { font: mono, glyph: "U+25CC" } }
    { name: "act.steer", glyph { font: mono, glyph: "U+279C" } }
    { name: "act.flight", glyph { font: mono, glyph: "U+26A1" } }
    { name: "act.rise", glyph { font: mono, glyph: "U+25B2" } }
    { name: "act.descend", glyph { font: mono, glyph: "U+25BC" } }
    { name: "act.jump", glyph { font: mono, glyph: "U+21A5" } }
    { name: "act.annotate", glyph { font: mono, glyph: "U+22A1" } }
    { name: "act.build", glyph { font: mono, glyph: "U+229E" } }
    { name: "act.console", label: ">_" }
    { name: "act.where", glyph { font: mono, glyph: "U+25C8" } }
    { name: "act.channels", glyph { font: mono, glyph: "U+2261" } }
    { name: "act.interact", glyph { font: mono, glyph: "U+25C7" } }
    { name: "act.confirm", label: "OK" }
    { name: "act.cancel", glyph { font: mono, glyph: "U+2715" } }
    { name: "act.tap", label: "TP" }
    { name: "act.wheel", label: "WH" }
    { name: "act.run", glyph { font: mono, glyph: "U+00BB" } }
    { name: "act.dash", label: "DS" }
    { name: "act.autorun", label: "AR" }
    { name: "act.fly", glyph { font: mono, glyph: "U+21D1" } }
    { name: "act.autofly", label: "AF" }
    { name: "act.frame", label: "FM" }
    // The chase camera's sector of the play wheel.
    { name: "view.auto", label: "AU" }
    // The Debug page: the frame comparison, stopping, the capture and the history.
    { name: "dbg.hold", label: "HO" }
    { name: "dbg.split", label: "SP" }
    { name: "dbg.clear", label: "CL" }
    { name: "dbg.stop", label: "ST" }
    { name: "dbg.capture", label: "CP" }
    { name: "dbg.history", label: "HI" }
  ]

  // Which cap each physical control wears on the bar, its modifier row and the build bar.
  badges [
    { source: "keyboard.w", icon: "key.w" }
    { source: "keyboard.a", icon: "key.a" }
    { source: "keyboard.s", icon: "key.s" }
    { source: "keyboard.d", icon: "key.d" }
    { source: "keyboard.e", icon: "key.e" }
    { source: "keyboard.f", icon: "key.f" }
    { source: "keyboard.g", icon: "key.g" }
    { source: "keyboard.q", icon: "key.q" }
    { source: "keyboard.v", icon: "key.v" }
    { source: "keyboard.b", icon: "key.b" }
    { source: "keyboard.equals", icon: "key.equals" }
    { source: "keyboard.minus", icon: "key.minus" }
    { source: "keyboard.1", icon: "key.1" }
    { source: "keyboard.2", icon: "key.2" }
    { source: "keyboard.3", icon: "key.3" }
    { source: "keyboard.4", icon: "key.4" }
    { source: "keyboard.5", icon: "key.5" }
    { source: "keyboard.f2", icon: "key.f2" }
    { source: "keyboard.f3", icon: "key.f3" }
    { source: "keyboard.f4", icon: "key.f4" }
    { source: "keyboard.f6", icon: "key.f6" }
    { source: "keyboard.space", icon: "key.space" }
    { source: "keyboard.controlLeft", icon: "key.ctrl" }
    { source: "keyboard.tab", icon: "key.tab" }
    { source: "keyboard.z", icon: "key.z" }
    { source: "keyboard.x", icon: "key.x" }
    {
      source: "gamepad.leftTrigger"
      icon: "pad.lt"
      overrides [{ family: "PlayStation5", icon: "pad.l2" }, { family: "SwitchPro", icon: "pad.zl" }]
    }
    {
      source: "gamepad.rightTrigger"
      icon: "pad.rt"
      overrides [{ family: "PlayStation5", icon: "pad.r2" }, { family: "SwitchPro", icon: "pad.zr" }]
    }
    { source: "mouse.button1", icon: "mouse.left" }
    { source: "mouse.button2", icon: "mouse.right" }
    {
      source: "gamepad.buttonSouth"
      icon: "pad.a"
      overrides [{ family: "PlayStation5", icon: "pad.cross" }, { family: "SwitchPro", icon: "pad.b" }]
    }
    {
      source: "gamepad.buttonEast"
      icon: "pad.b"
      overrides [{ family: "PlayStation5", icon: "pad.circle" }, { family: "SwitchPro", icon: "pad.a" }]
    }
    {
      source: "gamepad.buttonWest"
      icon: "pad.x"
      overrides [{ family: "PlayStation5", icon: "pad.square" }, { family: "SwitchPro", icon: "pad.y" }]
    }
    {
      source: "gamepad.buttonNorth"
      icon: "pad.y"
      overrides [{ family: "PlayStation5", icon: "pad.triangle" }, { family: "SwitchPro", icon: "pad.x" }]
    }
    {
      source: "gamepad.leftShoulder"
      icon: "pad.lb"
      overrides [{ family: "PlayStation5", icon: "pad.l1" }, { family: "SwitchPro", icon: "pad.l" }]
    }
    {
      source: "gamepad.rightShoulder"
      icon: "pad.rb"
      overrides [{ family: "PlayStation5", icon: "pad.r1" }, { family: "SwitchPro", icon: "pad.r" }]
    }
    { source: "gamepad.leftStickPress", icon: "pad.l3" }
    { source: "gamepad.rightStickPress", icon: "pad.r3" }
    {
      source: "gamepad.back"
      icon: "pad.back"
      overrides [{ family: "SwitchPro", icon: "pad.minus" }]
    }
    { source: "gamepad.dpadUp", icon: "arrow.up" }
    { source: "gamepad.dpadDown", icon: "arrow.down" }
    { source: "gamepad.dpadLeft", icon: "arrow.left" }
    { source: "gamepad.dpadRight", icon: "arrow.right" }
  ]
}

state {
  world {
    // The icon each control's plate shows, by its binding entry's id. The ids are the standard's action names, so a
    // context's entry that names one (the pilot's `rise`, the tabletop's `confirm`) wears its icon.
    table barIcons {
      forward = "arrow.up"
      back = "arrow.down"
      left = "arrow.left"
      right = "arrow.right"
      turnLeft = "act.turnLeft"
      turnRight = "act.turnRight"
      move = "act.move"
      look = "act.look"
      recenter = "act.recenter"
      orbit = "act.orbit"
      steer = "act.steer"
      flight = "act.flight"
      rise = "act.rise"
      run = "act.run"
      runToggle = "act.run"
      dash = "act.dash"
      fly = "act.fly"
      frame = "act.frame"
      descend = "act.descend"
      jump = "act.jump"
      interact = "act.interact"
      confirm = "act.confirm"
      cancel = "act.cancel"
      tap = "act.tap"
      annotate = "act.annotate"
      build = "act.build"

      // A wheel's opener, keyed by the page it opens: a plate whose hold opens that page wears the icon (LB opens the play
      // wheel).
      "wheel-pad" = "act.wheel"

      // The View page.
      autorun = "act.autorun"
      viewRecenter = "act.recenter"
      viewFrame = "act.frame"
      viewFreeLook = "act.look"
      autofly = "act.autofly"

      // The Debug page.
      dbgWhere = "act.where"
      dbgConsole = "act.console"
      dbgCapture = "dbg.capture"
      dbgHistory = "dbg.history"
      dbgHold = "dbg.hold"
      dbgSplit = "dbg.split"
      dbgClear = "dbg.clear"
      dbgStop = "dbg.stop"
    }

    // The bar draws one bar that swaps its page in place as a trigger is held, rather than every page's bank at once.
    table barModel {
      model = "single"
    }

    // The play wheel's sector labels and icons, by sector id; `cancel` is the hub's label while nothing is hovered.
    table wheelLabels {
      console = "Console"
      build = "Build"
      where = "Where"
      channels = "Channels"
      annotate = "Annotate"
      stop = "Stop"
      autoCamera = "Chase camera"
      barWings = "Wings"
      barWingsFull = "Full wings"
      barSidebars = "Sidebars"
      barSidebarsFull = "Full sidebars"
      barCompact = "Compact"
      barFull = "Full size"
      cancel = "Cancel"
    }

    table wheelIcons {
      console = "act.console"
      build = "act.build"
      where = "act.where"
      channels = "act.channels"
      annotate = "act.annotate"
      stop = "dbg.stop"
      autoCamera = "view.auto"
      barWings = "bar.wings"
      barWingsFull = "bar.wings.full"
      barSidebars = "bar.sides"
      barSidebarsFull = "bar.sides.full"
      barCompact = "bar.compact"
      barFull = "bar.full"
    }
  }
}

bindingOverlays [
  // The bar: the plates every page shows on, whichever context's page is active. It is the first row, which is where
  // a world's bar is read from, and binds nothing itself. One bank a page: Move (the resting page, and whichever
  // context's page takes its place), View on the left trigger, Debug on the right trigger.
  {
    id: "bar"
    document {
      version: "puck.input.bindings.v1"
      modifiers []
      chords []
    }
    bindingBar {
      slotSet: barSlots
      banks [
        { id: "move", pageId: "base", alpha: 0.5, activeAlpha: 1 }
        { id: "view", pageId: "pad-lt", alpha: 0.5, activeAlpha: 1 }
        { id: "debug", pageId: "pad-rt", alpha: 0.5, activeAlpha: 1 }
      ]
      iconRow: "state.barIcons"
      // The modifier row on the anchor line lights the page-holding triggers (the two the pad-pages row declares) held, and
      // the page's name sits under it; the wheel's openers and the mouse chord stay off it.
      modifiers: true
      declaredModifiersOnly: true
      pageLabel: true
      modelCell: "state.barModel.model"
      layout: "wings"
      visible: shownWhilePlaying
      layouts {
        // The addon's mirrored modulo diamonds: 45/600 plates, 60/45 central gap, 24/45 badges.
        wings {
          buttonSize: 0.04
          glyphOffsetRatio: 0.4375
          glyphSizeRatio: 0.5333333
          anchor { edge: Bottom, inset: 4.8888889 }
          tables {
            left [
              { source: "gamepad.dpadUp", x: -4.333333, y: 1, badge [0, 1] }
              { source: "gamepad.dpadRight", x: -3.333333, y: 0, badge [1, 0] }
              { source: "gamepad.dpadDown", x: -4.333333, y: -1, badge [0, -1] }
              { source: "gamepad.dpadLeft", x: -5.333333, y: 0, badge [-1, 0] }
              { source: "gamepad.leftShoulder", x: -5.333333, y: 1, badge [-1, 1] }
              { source: "gamepad.leftStickPress", x: -4.333333, y: 0, badge [-1, 1] }
            ]
            right [
              { source: "gamepad.buttonNorth", x: 4.333333, y: 1, badge [0, 1] }
              { source: "gamepad.buttonWest", x: 3.333333, y: 0, badge [-1, 0] }
              { source: "gamepad.buttonSouth", x: 4.333333, y: -1, badge [0, -1] }
              { source: "gamepad.buttonEast", x: 5.333333, y: 0, badge [1, 0] }
              { source: "gamepad.rightShoulder", x: 5.333333, y: 1, badge [1, 1] }
              { source: "gamepad.rightStickPress", x: 4.333333, y: 0, badge [1, 1] }
            ]
          }
          // The three-bank union bottoms at -2.5 pitches: inset + half + 2.5 = 220/45.
          banks {
            move {
              pieces [{ table: "left", at [0, 0] }, { table: "right", at [0, 0] }]
              anchor { edge: Bottom, inset: 1.8888889 }
            }
            view {
              pieces [{ table: "left", at [1, 2] }, { table: "right", at [-1, 2] }]
              anchor { edge: Bottom, inset: 1.8888889 }
            }
            debug {
              pieces [{ table: "left", at [-2, 2] }, { table: "right", at [2, 2] }]
              anchor { edge: Bottom, inset: 1.8888889 }
            }
          }
        }
        // A bottom action strip flanked by page columns on independent viewport anchors.
        sidebars {
          buttonSize: 0.04
          // The modifier row and the page name stand clear above the strip and its badges.
          anchor { edge: Bottom, inset: 3.35 }
          tables {
            strip [
              { source: "gamepad.dpadUp", x: -5.5, y: 0 }
              { source: "gamepad.dpadRight", x: -4.5, y: 0 }
              { source: "gamepad.dpadDown", x: -3.5, y: 0 }
              { source: "gamepad.dpadLeft", x: -2.5, y: 0 }
              { source: "gamepad.leftShoulder", x: -1.5, y: 0 }
              { source: "gamepad.leftStickPress", x: -0.5, y: 0 }
              { source: "gamepad.buttonNorth", x: 0.5, y: 0 }
              { source: "gamepad.buttonWest", x: 1.5, y: 0 }
              { source: "gamepad.buttonSouth", x: 2.5, y: 0 }
              { source: "gamepad.buttonEast", x: 3.5, y: 0 }
              { source: "gamepad.rightShoulder", x: 4.5, y: 0 }
              { source: "gamepad.rightStickPress", x: 5.5, y: 0 }
            ]
            column [
              { source: "gamepad.dpadUp", x: 0, y: 5.5 }
              { source: "gamepad.dpadRight", x: 0, y: 4.5 }
              { source: "gamepad.dpadDown", x: 0, y: 3.5 }
              { source: "gamepad.dpadLeft", x: 0, y: 2.5 }
              { source: "gamepad.leftShoulder", x: 0, y: 1.5 }
              { source: "gamepad.leftStickPress", x: 0, y: 0.5 }
              { source: "gamepad.buttonNorth", x: 0, y: -0.5 }
              { source: "gamepad.buttonWest", x: 0, y: -1.5 }
              { source: "gamepad.buttonSouth", x: 0, y: -2.5 }
              { source: "gamepad.buttonEast", x: 0, y: -3.5 }
              { source: "gamepad.rightShoulder", x: 0, y: -4.5 }
              { source: "gamepad.rightStickPress", x: 0, y: -5.5 }
            ]
          }
          banks {
            move { pieces [{ table: "strip" }], anchor { edge: Bottom, inset: 0.75 } }
            view { pieces [{ table: "column" }], anchor { edge: Left, inset: 0.75 } }
            debug { pieces [{ table: "column" }], anchor { edge: Right, inset: 0.75 } }
          }
        }

      }
    }
  }

  // The context sets every world gets: on foot is the resting page, and a seat that boards a craft or sits at a table
  // takes that context's group until it leaves.
  onFootControls()
  pilotControls()
  tabletopControls()

  // The play wheel, held open on Tab or LB over the seat's resting page so the seat keeps walking while it aims. The
  // build toggle is the editor's (editor.puck's `build` toggle), and the wheel's Build sector is another door to it.
  // While it is open the arrow keys (Tab) or the d-pad (LB) step its ring, Up to the next and Down to the previous, and
  // the mouse wheel steps it too, in place of the resting page's zoom.
  {
    id: "play-wheel"
    document {
      version: "puck.input.bindings.v1"
      modifiers []
      chords [
        {
          chord ["keyboard.tab"]
          group: "play"
          page {
            id: "wheel-keys"
            inherits: "base"
            label: "Wheel"
            entries [
              { command: "player.wheel.scroll", sources ["mouse.wheel"] }
              {
                command: "player.wheel.select"
                sources ["mouse.motion"]
              }
              {
                command: "player.wheel.commit"
                activateOn: Completed
                sources ["keyboard.tab"]
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Next ring"
                sources ["keyboard.arrowUp"]
                value { kind: "Axis1D", raw [1, 0, 0, 0] }
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Previous ring"
                sources ["keyboard.arrowDown"]
                value { kind: "Axis1D", raw [-1, 0, 0, 0] }
              }
            ]
          }
        }
        {
          chord ["gamepad.leftShoulder"]
          group: "play"
          page {
            id: "wheel-pad"
            inherits: "base"
            label: "Wheel"
            entries [
              { command: "player.wheel.scroll", sources ["mouse.wheel"] }
              {
                command: "player.wheel.select"
                sources ["gamepad.rightStick"]
              }
              {
                command: "player.wheel.commit"
                activateOn: Completed
                sources ["gamepad.leftShoulder"]
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Next ring"
                sources ["gamepad.dpadUp"]
                value { kind: "Axis1D", raw [1, 0, 0, 0] }
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Previous ring"
                sources ["gamepad.dpadDown"]
                value { kind: "Axis1D", raw [-1, 0, 0, 0] }
              }
            ]
          }
        }
      ]
      wheels [playWheel()]
    }
  }

  // The shared trigger pages: the left trigger (or Z) holds View, the right trigger (or X) holds Debug. A page inherits
  // `base`, so the sticks and the keyboard's movement keep working while it is held. Their free plates are a
  // refinement's: a world that authors layouts binds them on View and a world's own toggles join Debug (the debug
  // world set's are ../debug/set-controls.puck), and the chase camera and annotation are the play wheel's.
  {
    id: "pad-pages"
    document {
      version: "puck.input.bindings.v1"
      modifiers: padModifiers
      chords [
        {
          chord ["lt"]
          group: "play"
          page {
            id: "pad-lt"
            inherits: "base"
            label: "View"
            entries [
              // Autorun and autofly: each press switches the seat walking forward, or flying (flight mode on and climbing),
              // on or off, and the latch outlives the page, so it keeps going with the trigger released.
              { channel: "forward", id: "autorun", label: "Autorun", mode: Toggle, scale: 1, sources: padLeftStick }
              { command: "player.look.recenter", id: "viewRecenter", label: "Recenter", sources: padNorth }
              { command: "player.frame", id: "viewFrame", label: "Frame", sources: padEast }
              { command: "player.look.free", id: "viewFreeLook", label: "Free look", sources: padRightShoulder }
              { channel: "rise", id: "autofly", label: "Autofly", mode: Toggle, scale: 1, sources: padRightStick }
            ]
          }
        }
        {
          chord ["rt"]
          group: "play"
          page {
            id: "pad-rt"
            inherits: "base"
            label: "Debug"
            entries [
              { command: "body.where", id: "dbgWhere", label: "Where", sources: padUp }
              { command: "world.history", id: "dbgHistory", label: "History on", text: "on", sources: padRight }
              { command: "console", id: "dbgConsole", label: "Console", sources: padDown }
              { command: "world.screenshot", id: "dbgCapture", label: "Capture", sources: padLeft }
              {
                command: "world.compare"
                id: "dbgHold"
                label: "Hold frame"
                text: "hold"
                value: neverRead
                sources: padWest
              }
              {
                command: "world.compare"
                id: "dbgSplit"
                label: "Compare"
                text: "split"
                value: neverRead
                sources: padEast
              }
              {
                command: "world.compare"
                id: "dbgClear"
                label: "Clear hold"
                text: "off"
                value: neverRead
                sources: padRightShoulder
              }
              { command: "body.stop", id: "dbgStop", label: "Stop", sources: padRightStick }
            ]
          }
        }

      ]
    }
  }
]

// These are designs expressed through the generic per-seat preference mechanism.
commands [
  {
    name: "controls.bar"
    help: "Selects this seat's bar layout and model (single or stacked); preferences save with identity.bindings.save."
    parameters [
      { name: "layout", kind: Choice, values ["wings", "sidebars"] }
      { name: "model", kind: Choice, values ["single", "stacked"], default: "single" }
    ]
    lines ["player.binding-bar layout {layout}", "player.binding-bar model {model}"]
  }
  { name: "controls.bar.compact", help: "Uses compact plates for this seat.", lines ["player.binding-bar scale 0.72"] }
  { name: "controls.bar.full", help: "Uses full size plates for this seat.", lines ["player.binding-bar scale 1"] }
]
