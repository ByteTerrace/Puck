schema: "puck.world.definition.v1"
import "skin"
import "controls"
import "camera"

// A companion is welcome as it is: an arriving companion runs its own pinned driver, verified from the content store,
// under this world's fuel. A world refines the row by name to dress it (kit, look), or names a driver of its own
// instead.
roles [
  {
    name: "companion"
    accept: true
  }
]
