// Presentation programs. The measurement lever selects these beside the earlier layers.
function shadeFade(rate) = 1 - smoothstep(0.35, 0.9, rate)
// The whole cycles a motion `seconds` long makes in the shading clock's period (4096 seconds, SdfFlow.ClockPeriodSeconds),
// at least one: `clock * clockCycles(s)` turns once about every `s` seconds and joins without a seam where the clock wraps.
function clockCycles(seconds) = maximum(1, floor(4096 / seconds + 0.5))
// A soft threshold: 0 below `threshold`, 1 above it, rising over `width` centred on it (a hair's width at least).
function shadeStep(value, threshold, width) = smoothstep(
  threshold - max(width * 0.5, 0.0005),
  threshold + max(width * 0.5, 0.0005),
  value
)
// A soft range: 1 from `lo` to `hi`, falling to 0 over `width` centred on each edge.
function shadeRange(value, lo, hi, width) = shadeStep(value, lo, width) * (1 - shadeStep(value, hi, width))
function shadeLane(index) = index == 0 ? lanes.slot0 : index == 1 ? lanes.slot1 : index == 2 ? lanes.slot2 :
  index == 3 ? lanes.slot3 :
  index == 4 ? lanes.world0 :
  index == 5 ? lanes.world1 :
  index == 6 ? lanes.world2 :
  index == 7 ? lanes.world3 :
  1

// The pattern library: the building blocks a material's look composes, each one formula, with the ergonomic forms
// lowering to the same program as a hand-unrolled one. Points are in pattern units: one lattice or cell per unit.
//
// Band limiting: an octave whose features fall under about two pixels cannot be sampled, so it aliases into shimmer. A
// lattice octave at `lacunarity^i` times the base frequency spans `pixel * lacunarity^i` cells a pixel, `pixel` being the
// footprint in the pattern's own units (the contract of `shadeBevel` below: the default, `surface.footprint`, is right for
// a point in metres, and a point scaled by `scale` passes `surface.footprint * scale`). Each octave fades by `shadeFade` of
// that rate, as the flow, foliage and terrain programs fade their own noise, so the noise loses its fine octaves as it
// recedes and converges on its mean. `filterScale` scales the rate: 1 fades at the pixel's own sampling limit, more blurs
// sooner, and 0 keeps every octave at any distance. A sum is not renormalised, since a signed octave averages to zero.
function shadeOctaveFade(pixel, filterScale, octave, lacunarity) = shadeFade(pixel * filterScale * pow(lacunarity, octave))
// A faded octave of a noise whose mean is not zero fades to that mean, not to zero.
function shadeBandLimited(value, mean, fade) = mean + fade * (value - mean)
// Fractal noise: `octaves` (a whole number fixed when the document compiles) of the lattice, each at `lacunarity` times
// the frequency and `gain` times the amplitude of the one before, normalised to about [-1, 1] and faded by its footprint.
function shadeFbm(q, seed, octaves = 4, gain = 0.5, lacunarity = 2, pixel = surface.footprint, filterScale = 1) = reduce(
  range(0, octaves),
  0,
  (sum, i) => sum + pow(gain, i) * shadeOctaveFade(pixel, filterScale, i, lacunarity) *
    lattice(q * pow(lacunarity, i) + 17 * i, seed + uint(i))
) / reduce(range(0, octaves), 0, (sum, i) => sum + pow(gain, i))
// Ridged noise in [0, 1]: sharp crests where the lattice crosses zero, the look of veins, ridges and creases. A faded
// octave takes the mean of the ridge term, about 0.54, so the pattern flattens to its average level.
function shadeRidged(q, seed, octaves = 4, gain = 0.5, lacunarity = 2, pixel = surface.footprint, filterScale = 1) = reduce(
  range(0, octaves),
  0,
  (sum, i) => sum + pow(gain, i) * shadeBandLimited(
    pow(1 - abs(lattice(q * pow(lacunarity, i) + 17 * i, seed + uint(i))), 2),
    0.54,
    shadeOctaveFade(pixel, filterScale, i, lacunarity)
  )
) / reduce(range(0, octaves), 0, (sum, i) => sum + pow(gain, i))
// Turbulence in [0, 1]: the summed magnitude of the octaves, billowing like smoke or marble's swirl. A faded octave takes
// the mean magnitude of the lattice, about 0.31.
function shadeTurbulence(q, seed, octaves = 4, gain = 0.5, lacunarity = 2, pixel = surface.footprint, filterScale = 1) = reduce(
  range(0, octaves),
  0,
  (sum, i) => sum + pow(gain, i) * shadeBandLimited(
    abs(lattice(q * pow(lacunarity, i) + 17 * i, seed + uint(i))),
    0.31,
    shadeOctaveFade(pixel, filterScale, i, lacunarity)
  )
) / reduce(range(0, octaves), 0, (sum, i) => sum + pow(gain, i))
// Domain warp: `q` pushed by `amount` along three decorrelated lattices, so any pattern read at the result flows and
// swirls (feed it to fBm, cells or a ramp).
function shadeWarp(q, seed, amount) = q + amount * [
  lattice(q, seed),
  lattice(q + [5.2, 1.3, 2.8], seed + uint(1)),
  lattice(q + [1.7, 9.2, 3.4], seed + uint(2))
]
// The edge helpers below (cell borders, brick mortar) ramp from one side of their edge to the other over a bevel, so
// the edge has a slope: a relief over them carves a groove, which a hard step would not (it is flat on both sides). The
// ramp is never narrower than two display pixels' footprint, `pixel` being the footprint in the pattern's own units:
// the default, `surface.footprint`, is right for a point in metres, and a point scaled by `scale` passes
// `surface.footprint * scale`. So an edge neither aliases in colour nor shimmers in relief, however far it is seen.
function shadeBevel(bevel, pixel) = max(bevel, 2 * pixel)
// Cellular pattern pieces over `cells(q, seed)`, which returns [F1, F2 - F1, id]: the distance to the nearest
// feature, the gap to the second nearest (0 on the borders between cells), and the cell's id in [0, 1); and over
// `cellBorder(q, seed)`, the true distance to the cell's border, where F2 - F1 only reads zero.
// A border line `width` units wide between cells, 1 on the line: cracks, grout, scales' rims, leaf veins. It reads the
// border distance, so the line is one width all along every border, `width` / 2 to each side. Its edge ramps over
// `bevel` times its width (0.5 by default), at least the pixel floor above.
function shadeCellBorder(q, seed, width, bevel = 0.5, pixel = surface.footprint) = 1 -
  shadeStep(cellBorder(q, seed), width * 0.5, shadeBevel(width * bevel * 0.5, pixel))
// A per-cell value in [0, 1), constant over each cell: tile, cobble and scale colours. It has no slope anywhere.
function shadeCellId(q, seed) = cells(q, seed).z
// A colour ramp: `stops` is a list of { at, color } in rising `at`, and `t` picks the colour between the two stops
// around it, held at the ends.
function shadeRamp(t, stops) = reduce(
  range(1, length(stops)),
  stops[0].color,
  (color, i) => mix(color, stops[i].color, saturate((t - stops[i - 1].at) / max(stops[i].at - stops[i - 1].at, 0.000001)))
)
// Running-bond bricks on the plane of `p`'s x and y: `size` is a brick [width, height] and `mortar` the joint width,
// all in the same units as `p`. Returns [mortar coverage (1 in a joint), brick value in [0, 1)], the value the same
// everywhere on one brick; every other course is offset by half a brick. The brick's edge ramps into the joint over
// `bevel` times the mortar width (0.5 by default), at least the pixel floor above.
function shadeBrick(p, size, mortar, seed, bevel = 0.5, pixel = surface.footprint) = shadeBrickAt(
  [p.x / size.x + fraction(floor(p.y / size.y) * 0.5), p.y / size.y],
  [mortar / size.x, mortar / size.y],
  seed,
  shadeBevel(bevel, pixel / max(mortar, 0.000001))
)
// The bricks in brick units: `joint` is the mortar's width in each axis's units and `ramp` the edge's width as a share
// of the mortar's.
function shadeBrickAt(q, joint, seed, ramp = 0.5) = [
  1 - shadeStep(min(min(fraction(q.x), 1 - fraction(q.x)) / joint.x, min(fraction(q.y), 1 - fraction(q.y)) / joint.y), 0.5, ramp),
  0.5 + 0.5 * lattice([floor(q.x) + 0.5, floor(q.y) + 0.5, 0.5], seed)
]

shade template plain() {
  surface {
    albedo: material.albedo
  }
}
shade template paint(color) {
  surface {
    albedo: mix(material.albedo, color, paint.coverage)
  }
}

// Relief: the surface lit as if `height` (a function of a point, in metres) raised it along its normal, by `amount`
// times. The compiler differentiates the height exactly, so any pattern makes relief with no slope written by hand:
// `relief(q => -0.004 * shadeCellBorder(q * 3, uint(5), 0.06, pixel: surface.footprint * 3), 1)` carves cracks, and
// `relief(q => 0.01 * shadeFbm(q * 4, uint(7), pixel: surface.footprint * 4), 1)` roughens a face, its octaves fading
// with distance. Only slope makes relief: a hard step (floor, step, a cell's id) is flat on both sides of its jump and
// gives none, so an edge carves a groove only where it ramps (the bevel of shadeCellBorder and shadeBrick). The height stands in the world (`world` 1) or, with `world` 0, in the
// draw's own frame (`surface.objectPosition`), so every copy of a creation carries the same relief; that frame's slope is
// turned to the world without its scale, which a uniformly scaled copy's relief keeps. The normal tilts at most
// `steepest` radians, which bounds the shadow cascades it can ask for. It writes the normal only: placed after a row's
// own program in its `shade` list (`row with { shade [row.shade, relief(q => ..., 1)] }`), it tilts that program's
// normal.
shade template relief(height, amount = 1, structural steepest = 1.2, structural world = 1) {
  surface {
    let slope = world ? gradient(surface.position, height) : gradient(surface.objectPosition, height)
    let turned = drawDirection(slope)
    let slope = world ? slope : turned * (length(slope) / max(length(turned), 0.000001))
    normal: tilt(surface.normal, slope * -amount, steepest)
  }
}

// The colour a cell-crack relief or a brick relief carries, so the pattern reads in any light rather than only as the
// tilt `relief` gives a lit face. `crackFace` darkens the material in the borders of `shadeCellBorder` at `scale` cells
// a metre, a line `width` cells wide; `brickFace` shades each brick of `shadeBrick` its own share of the material and
// greys its mortar. `filterScale` scales the footprint the edge ramp widens by, as the noises' does: 1 at the pixel's own
// sampling limit, 0 keeping the authored bevel at any distance.
shade template crackFace(scale, seed, width, filterScale = 1) {
  surface {
    albedo: material.albedo *
      (1 - 0.7 * shadeCellBorder(surface.position * scale, seed, width, pixel: surface.footprint * scale * filterScale))
  }
}
shade template brickFace(size, mortar, seed, filterScale = 1, mortarColor = [0.55, 0.55, 0.52]) {
  surface {
    let brick = shadeBrick(surface.position, size, mortar, seed, pixel: surface.footprint * filterScale)
    albedo: mix(material.albedo * (0.75 + 0.5 * brick.y), mortarColor, brick.x)
  }
}

function celBand(cosine, visibility, threshold, softness, combined) = mix(
  shadeStep(saturate(cosine), threshold, softness) * saturate(visibility),
  shadeStep(saturate(cosine) * saturate(visibility), threshold, softness),
  combined
)
// The cel response, the one implementation of banding. Each light's cosine (wrapped by the material) steps at
// `threshold` over `softness`, its visibility multiplying after the band; `combined` (0 to 1) blends toward banding the
// cosine and the visibility together, the harder look in which a penumbra snaps to the band. The lit paint is flat
// (metals included) less `form` (0 to 1), the share of the cosine's falloff it keeps so a lit mass still reads round, and
// the highlight is a bounded disc of `specularSize`.
// The shade is a painted colour rather than whatever light happens to fill it: `restore` (0 to 1) gives a light's shade
// side that share of the light back, over the half-cosine so a face turned away still reads its form, as far as the light
// reaches the surface's surroundings (`light.probeShare`, the share of the probes about it that see the light), so a
// closed room's walls take back none of the sun outside them; and `bleed` (0 to 1)
// is how much of the bounce's own hue the sky and bounce keep, the rest their luminance alone; both then take
// `shadowTint`. So a lawn's green bounce does not turn every shade olive, and a sunlit scene's shade holds a value near
// `restore × shadowTint` of its lit side. The result is scene light: the view's display pass tones it, so a cel pixel
// passes one tone curve.
shade template cel(threshold, softness, shadowTint, specularSize, combined = 0, restore = 0, bleed = 1, form = 0) {
  light {
    // Kinds (SdfLightKind): 0 a directional, 2 a point or spot, 4 a line (tube), 5 a screen's or an emitter face's area
    // light, which glows without a band.
    let direct = (light.kind == uint(0)) + (light.kind == uint(2)) + (light.kind == uint(4))
    let cosine = max((light.cosine + surface.wrap) / (1 + surface.wrap), 0)
    let band = celBand(cosine, light.visibility, threshold, softness, combined)
    let shadeSide = shadowTint * ((1 - band) * restore * (0.5 + 0.5 * light.cosine) * light.probeShare)
    let lit = band * mix(1, cosine, form)
    diffuse: direct ? light.color * (light.weight * light.reach) * (shadeSide + [lit, lit, lit]) : (light.kind ==
      uint(5) ? light.color * (light.weight * light.reach * max(light.cosine, 0) * light.visibility) : [0, 0, 0])
    let halfway = light.direction - surface.rayDirection
    let halfway = halfway / sqrt(max(dot(halfway, halfway), 0.00000001))
    let size = specularSize * mix(0.5, 1.5, surface.roughness)
    let highlight = smoothstep(1 - size, 1 - size + min(size * 0.15, 0.003), dot(surface.normal, halfway))
    let reflectance = mix([surface.specular, surface.specular, surface.specular], surface.albedo, surface.metal)
    specular: direct ? light.color *
      reflectance *
      (highlight *
        (1 - 0.75 * surface.roughness) *
        2 *
        light.weight *
        light.reach *
        celBand(light.cosine, light.visibility, threshold, softness, combined)) : [0, 0, 0]
  }
  compose {
    let level = dot(compose.indirect, [0.2126, 0.7152, 0.0722])
    let fill = mix([level, level, level], compose.indirect, bleed) * shadowTint
    color: max(
      (surface.albedo * (compose.radiance + fill) + compose.environment + compose.rim + compose.specular) *
        compose.attenuation *
        compose.adaptation,
      0
    ) + surface.albedo * surface.emissive
  }
}

shade template inset(origin, rotation, depth, ior, softness, amplitude, frequency, phase, color0, color1, color2, color3, radius0, radius1, radius2, radius3) {
  surface {
    let p = inverseRotate(surface.layerPosition - origin, rotation)
    let n = inverseRotate(toLayer(surface.normal), rotation)
    let ray = inverseRotate(toLayer(surface.rayDirection), rotation)
    let n = dot(n, ray) > 0 ? -n : n
    let d = refract(ray, n, 1 / ior)
    let t = (-depth - p.z) / d.z
    let hit = p + t * d
    let radius = length([hit.x, hit.y]) * (1 + amplitude * sin(atan2(hit.y, hit.x) * frequency + phase))
    let c = mix(color0, color1, smoothstep(radius1 - max((radius1 - radius0) * softness, 0.000001), radius1, radius))
    let c = mix(c, color2, smoothstep(radius2 - max((radius2 - radius1) * softness, 0.000001), radius2, radius))
    let c = mix(c, color3, smoothstep(radius3 - max((radius3 - radius2) * softness, 0.000001), radius3, radius))
    albedo: (dot(d, d) < 0.000000000001) ? material.albedo : (abs(d.z) < 0.000001 ? material.albedo :
      (t < 0 ? material.albedo : c))
  }
}

// The flow's pattern at `q` (pattern units): the cycle's two phases of the lattice, each shifted back along the motion by
// its phase and squeezed along it by `squeeze`, blended by their weights at constant variance. The slope `flow` tilts
// its normal by is this pattern's gradient, the shifts and weights held at the point's values.
function flowSqueeze(q, along, squeeze) = q - along * (dot(q, along) * squeeze)
function flowPattern(q, shift0, shift1, along, squeeze, w0, w1, seed) = (
  w0 * lattice(flowSqueeze(q - shift0, along, squeeze), seed) + w1 * lattice(flowSqueeze(q - shift1, along, squeeze), seed)
) / sqrt(max(w0 * w0 + w1 * w1, 0.000001))
shade template flow(velocity, scale, stretch, cycles, tiltAmount, coverage, softness, color, roughness, metal, seed, structural world = 1, structural velocityLane = -1, structural coverageLane = -1, structural glass = 0) {
  surface {
    let point = world ? surface.position : surface.layerPosition
    let normal = world ? surface.normal : toLayer(surface.normal)
    let authoredVelocity = world ? velocity : drawDirection(velocity)
    let rateLane = shadeLane(velocityLane)
    let coverLane = shadeLane(coverageLane)
    let moving = authoredVelocity * rateLane
    let cover = saturate(coverage * saturate(coverLane) + surface.contact)
    let tangent = moving - normal * dot(normal, moving)
    let speed = length(tangent)
    let along = tangent / max(speed, 0.000001)
    let squeeze = 1 - 1 / max(stretch, 1)
    let offset = 0.5 + 0.5 * lattice(point * (0.125 * scale), xor(seed, uint(1759714724)))
    let c0 = fraction(clock * cycles + offset)
    let c1 = fraction(c0 + 0.5)
    let w0 = 1 - abs(2 * c0 - 1)
    let w1 = 1 - w0
    let travel = tangent * (4096 / cycles)
    let shift0 = travel * ((c0 - 0.5) * scale)
    let shift1 = travel * ((c1 - 0.5) * scale) - [5.3, 2.9, 7.1]
    let at = point * scale
    let value = flowPattern(at, shift0, shift1, along, squeeze, w0, w1, seed)
    let fade = shadeFade(surface.footprint * scale)
    let threshold = 1 - cover
    let soft = max(softness, 0.001)
    let revealed = mix(
      cover,
      smoothstep(threshold - soft, threshold + soft, 0.5 + 0.5 * clamp(value, -1, 1)),
      fade
    )
    let revealed = cover > 0 ? revealed : 0
    albedo: mix(material.albedo, color, revealed)
    roughness: glass ? material.roughness : mix(material.roughness, roughness, revealed)
    metal: glass ? material.metal : mix(material.metal, metal, revealed)
    coat: glass ? material.coat : material.coat * (1 - revealed)
    reveal: revealed
    let slope = gradient(at, q => flowPattern(q, shift0, shift1, along, squeeze, w0, w1, seed)) * fade
    let slope = slope - normal * dot(normal, slope)
    let share = saturate(speed / max(length(authoredVelocity), 0.000001))
    let tilted = normalize(normal - slope * (tiltAmount * share))
    normal: world ? tilted : toWorld(tilted)
  }
}

function flowed(base, layer, world = 1, velocityLane = -1, coverageLane = -1, glass = 0) = base with {
  flow: layer
  shade: flow(
    layer.velocity,
    layer.scale,
    layer.stretch,
    clockCycles(layer.cycle),
    layer.tilt,
    layer.coverage,
    layer.softness,
    layer.surface.color,
    layer.surface.roughness,
    layer.surface.metal,
    layer.seed,
    world: world,
    velocityLane: velocityLane,
    coverageLane: coverageLane,
    glass: glass
  )
}

// The deposit settles on up-facing surfaces: its cover is the surface's upward cosine broken by the noise, scaled by
// `settle`. With `settleWidth` 0 the deposit follows that cover linearly; a positive width steps it at
// `settleThreshold` over that width instead, so a crisp line (snow on ledges, dust on tops) is authored as a threshold
// and a narrow width. With `settleOwn` 1 the deposit's cover reads a noise channel of its own, at `settleScale` times
// the pattern's frequency, instead of the one the revealed `under` colour reads, so a surface shows the deposit's
// patches (dry ground) and the under colour's (lush ground) in different places; with 0 both read one noise and cost
// one lattice less.
// With `grain` 1 the pattern stands in a frame of its own instead of the layer's axes: the point is taken about
// `origin` (layer units, which for a static placement are the world's), turned by the inverse of `frame` so the frame's
// local +X becomes the pattern's x axis, and swirled about that axis by `twist` radians a unit along it. A `patternScale`
// that is fine across and long along x then draws grain that runs along whatever `frame` names (a limb's axis, a trunk
// twisting as it climbs) on any orientation of surface, where the layer's axes would draw streaks along world y only.
// Soft volume shading: the shading normal turned `soft` of the way (0 keeps the surface's own, 1 takes the envelope's
// alone) toward the outward normal of an ellipsoid of radii `radii` about the draw's own origin, so a mass built of small
// parts (a clump of leaves, a tuft, a fleece) is lit as the one round form it stands for: light on its side that faces
// the light, dark on the other, whichever way each part turns, while the parts keep the silhouette. The ellipsoid stands
// in the draw's own frame (`surface.objectPosition`) and its normal follows the radii's ratios alone, so every copy of a
// creation, of any size and turn, takes it. It writes the normal only: an element after it in a row's `shade` list
// reads the softened normal as `surface.normal` (softVolume).
shade template envelopeNormal(radii, soft) {
  surface {
    normal: normalize(mix(surface.normal, normalize(drawDirection(surface.objectPosition / (radii * radii))), soft))
  }
}
// A row shaded as a soft volume: envelopeNormal first, then the row's own program, which colours and lights by it.
function softVolume(base, radii, soft) = base with {
  shade [envelopeNormal(radii, soft), base.shade]
}

// Painterly variation over a large surface: the colour's value drifts by `amount` (a share of it, either way) over soft
// patches about `scale` metres across with a finer stroke inside them, and leans toward `lean` where it drifts up, as a
// brush loaded twice lays a wall. The patches stand in the world, so every copy of a stamped piece takes its own. The
// row's paints are under it, and a style named after it lights what it wrote.
shade template brushed(amount, scale, lean, seed) {
  surface {
    let p = surface.position / scale
    let rate = surface.footprint / scale
    let broad = lattice(p, seed) * shadeFade(rate)
    let stroke = lattice(p * [3.7, 1.3, 3.7] + 17, xor(seed, uint(2654435769))) * shadeFade(rate * 3.7)
    let drift = clamp((broad + 0.6 * stroke) / 1.166, -1, 1)
    albedo: mix(material.albedo, lean, saturate(drift) * amount) * (1 + amount * drift)
  }
}
shade template weathered(under, deposit, seed, scale, linesAmount, settle, edgeAmount, reach, threshold, noiseAmount, patternScale, softness, octaveRatio, octaveGain, turn, settleThreshold = 0.5, settleWidth = 0, settleScale = 1, frame = [0, 0, 0, 1], origin = [0, 0, 0], twist = 0, structural octaves = 2, structural settleOwn = 0, structural grain = 0) {
  surface {
    let frequency = scale * patternScale
    let local = grain > 0 ? inverseRotate(surface.layerPosition - origin, frame) : surface.layerPosition
    let swirl = local.x * twist
    let local = grain > 0 ? [local.x, local.y * cos(swirl) - local.z * sin(swirl), local.y * sin(swirl) + local.z * cos(swirl)] : local
    let p = local * frequency
    let rate = surface.footprint * max(frequency.x, max(frequency.y, frequency.z))
    let q = rotate(p, turn)
    let coarse = lattice(q, seed) * shadeFade(rate)
    let fine = lattice(q * octaveRatio + 17, xor(seed, uint(2654435769))) * shadeFade(rate * octaveRatio)
    let noise = octaves > 1 ? 0.5 +
      0.5 * clamp((coarse + octaveGain * fine) / sqrt(1 + octaveGain * octaveGain), -1, 1) : 0.5 + 0.5 * coarse
    let edge = saturate(max(surface.curvature, 0) * reach) * noise
    let n = grain > 0 ? inverseRotate(toLayer(surface.normal), frame) : toLayer(surface.normal)
    let weights = pow(abs(n), 4)
    let weights = weights / max(dot(weights, [1, 1, 1]), 0.000001)
    let line = dot(weights, [lines([p.y, p.z], seed, surface.footprint * max(frequency.y, frequency.z)),
      lines([p.x, p.z], seed + uint(1), surface.footprint * max(frequency.x, frequency.z)),
      lines([p.x, p.y], seed + uint(2), surface.footprint * max(frequency.x, frequency.y))
    ])
    let coverage = saturate(max(max(edgeAmount * edge, linesAmount * line), noiseAmount * noise))
    let aa = max(softness, max(min(rate, 0.25), 0.001))
    let reveal = smoothstep(max(threshold - aa, 0), threshold, coverage)
    let settleNoise = settleOwn > 0 ? 0.5 +
      0.5 * lattice(q * settleScale + 53, xor(seed, uint(1640531527))) * shadeFade(rate * settleScale) : noise
    let cover = saturate(surface.normal.y) * settleNoise
    let deposition = settle * (settleWidth > 0 ? shadeStep(cover, settleThreshold, settleWidth) : cover)
    albedo: mix(mix(material.albedo, under, reveal), deposit, deposition)
    roughness: mix(mix(material.roughness, 0.98, reveal), 0.98, deposition)
    metal: material.metal * (1 - reveal) * (1 - deposition)
    coat: material.coat * (1 - reveal) * (1 - deposition)
  }
}

// The magic film: the glow an enchanted pane, a barrier or a portal's surface shows over the light it passes, for a glass
// row. It cycles through a palette, shimmers, and brightens where the surface turns from the eye. Its brightness is the
// row's own emissive (nits), so the row's `emissiveLane` switches it as it would any glow. Its colour is a cosine palette,
// `low + swing × cos(2π (rate × h + offset))` a channel, at a hue h that turns `cycles` whole times each shading clock
// period (clockCycles), `rings` turns a metre outward from `centre` (a point in the draw's own frame, so every copy of a
// creation rings about the same place on it) and `swirl` turns with a lattice noise `scale` waves a metre across, from
// `phase` on. `rim` more of the glow (a share of it) shows where the surface turns edge-on, as the edge's cosine to the
// power `power`, and the noise twinkles a `shimmer` share of it `twinkles` whole times each period. The surface's
// reflections and highlights stay; the film composes no medium, so on a clear glass it reads as light over what lies
// behind, tinted by the glass as every layer before it is.
shade template magicFilm(low, swing, rate, offset, cycles, rings, centre, swirl, scale, rim, power, shimmer, twinkles, seed, phase = 0) {
  compose {
    let turn = 2 * pi
    let facing = saturate(0 - dot(surface.normal, surface.rayDirection))
    let edge = pow(1 - facing, power)
    let wobble = lattice(surface.objectPosition * scale, seed)
    let h = clock * cycles + length(surface.objectPosition - centre) * rings + wobble * swirl + phase
    let hue = max(low + swing * cos((rate * h + offset) * turn), [0, 0, 0])
    let sparkle = 0.5 + 0.5 * sin((clock * twinkles + wobble) * turn)
    let glow = surface.emissive * (1 + rim * edge) * mix(1, sparkle, shimmer)
    color: (compose.environment + compose.specular + compose.rim) * compose.attenuation * compose.adaptation + hue * glow
  }
}
// A glass row with the magic film `film` (a film value: its palette `low`, `swing`, `rate` and `offset`, the `cycle` and
// `twinkle` periods in seconds, and `rings`, `swirl`, `scale`, `rim`, `power`, `shimmer` and `seed`) about `centre`,
// its hue `phase` of a cycle on.
function magicFilmed(base, film, centre, phase = 0) = base with {
  shade: magicFilm(
    film.low,
    film.swing,
    film.rate,
    film.offset,
    clockCycles(film.cycle),
    film.rings,
    centre,
    film.swirl,
    film.scale,
    film.rim,
    film.power,
    film.shimmer,
    clockCycles(film.twinkle),
    film.seed,
    phase: phase
  )
}
// A rainbow magic film: the full hue circle at even brightness, turning once a quarter minute and rippling out in rings
// about a metre and a half apart, with a soft twinkle and a bright rim.
let rainbowFilm = {
  low [0.55, 0.55, 0.55]
  swing [0.45, 0.45, 0.45]
  rate [1, 1, 1]
  offset [0, 0.33, 0.67]
  cycle: 15
  twinkle: 2.5
  rings: 0.7
  swirl: 0.3
  scale: 1.2
  rim: 2.5
  power: 3
  shimmer: 0.3
  seed: 6427
}
