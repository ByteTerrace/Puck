// A control panel: a console on a pedestal whose glass lists a set of entries, one of them chosen, the way a display
// station's console browses its catalog (architecture.puck's console language: the ochre elbow and bar, cream and teal
// buttons, the chosen row lit amber). A library: it hands its importers the panel's creations, placements, state, rules,
// cameras, spawn points and terminals as templates and functions, and emits no document. What a panel's choice does is
// its importer's: a portal routes by it (portal.puck), a lift calls its car by it.
//
// A panel is `{ id, title, entries, choice, site, x, y, z, yaw, parent }`: `id` names its placements (`<id>-panel`, the
// stand, and `<id>-panel-screen`, its glass) and keys its cells; `entries` is its list, each `{ title, note }`; `choice`
// the entry it boots on; `[x, y, z]` its foot in the frame of `parent` (a placement id, or null for the world), which
// stands in the world where the frame `site` puts it (frame.puck: the parent's position, yaw and scale); and `yaw` turns
// its glass's front the way a placement's yaw turns it (0 faces -z, 180 faces +z). Its glass's points are given facing
// +Z, as architecture.puck's pieces are, and placed with `facingWorld`; its glass's paints stand in the world's frame,
// so they take the site's turn and scale too.
//
// A player uses a panel as a terminal (contexts/terminal.puck): within its reach the context button engages it, the
// seat's camera eases to the panel's desk view, and a tap on a row of its list chooses that entry. PREV and NEXT turn
// the list a page when it holds more entries than a page shows; each page is a screen creation of its own that the glass
// responds with, so a page's titles are paints and only the inks follow state. A world gathers every panel's terminals
// with its other terminals into its one `terminalPlay` (`panelTerminals`), since that template is a world's singleton.
//
// A world's panels are one set (`panelSet`), which every template here takes whole: the set numbers every panel's
// entries in one run, so one rule over all the panels writes any panel's cells, and a panel costs the world its glass's
// own contact sweep and nothing more a tick. A world declares the set's state once (`panelState`) and its rules once
// (`panelRules`).
//
// The state, keyed by panel:
//
//   panelChoice   the chosen entry's index: the lit row, and what an importer reads (a door's routes read it whole)
//   panelPick     the last entry a tap chose, plus one: a mailbox an importer that acts on every tap clears to 0
//   panelPage     the page the list shows
//   panelTitle    the chosen entry's title and note, which the glass's detail shows
//   panelNote
//   panelShownAt  the choice the title, note and inks were last written for
//   panelTap      the glass's last lift, as its contact sweep posts it: a row plus one, -1 for NEXT, -2 for PREV
//   panelBase     where the panel's entries start in the set's run, panelCount how many it has and panelLast its last
//                 page
//
// and, keyed by an entry's place in the set's run, `panelInk` (each row's ink, the chosen one lit) and `panelTitles` and
// `panelNotes`, each entry's copy, which the detail is written from. A rule or a console write to `panelChoice` moves the
// glass as a tap does.
import "architecture"
import "contexts/terminal"
import "frame"

// The console's tilt back from vertical, degrees, and the glass's half extents across and up its face, metres.
let panelTilt = 30
let panelGlassHalf = [0.5, 0.3]
// The glass's centre over the foot, facing +Z: its height and how far forward of the stand's middle it stands.
let panelGlassAt = [0, 1.12, 0.12]
let panelGlassDepth = 0.008
// How many rows a page of the list shows.
let panelRows = 8

// The glass's rectangles, `x0..x1` across and `y0..y1` up from its centre: the elbow's column and bar, the page buttons
// down the column, the page reading at its foot, the list, and the chosen entry's detail beside it.
let panelColumn = { x0: -0.48, x1: -0.39 }
let panelBar = { y0: 0.235, y1: 0.285 }
let panelPrev = { x0: panelColumn.x0, x1: panelColumn.x1, y0: 0.03, y1: 0.12 }
let panelNext = { x0: panelColumn.x0, x1: panelColumn.x1, y0: -0.07, y1: 0.02 }
let panelFoot = { x0: panelColumn.x0, x1: panelColumn.x1, y0: -0.285, y1: -0.15 }
let panelList = { x0: -0.355, x1: 0.115, y0: -0.265, y1: 0.205 }
let panelDetail = { x0: 0.165, x1: 0.48 }
let panelRowPitch = ((panelList.y1 - panelList.y0) / panelRows)
let panelListEm = 0.03

// The glass's outward normal and up, facing +Z.
let panelNormal = [0, sine((panelTilt * 0.017453293)), cosine((panelTilt * 0.017453293))]
let panelUp = [0, cosine((panelTilt * 0.017453293)), (0 - sine((panelTilt * 0.017453293)))]

// How many pages a panel's list takes.
function panelPages(panel) = floor((((length(panel.entries) + panelRows) - 1) / panelRows))
// A point given facing +Z (x to the right of a player before the thing, y up, z toward that player), in the parent frame
// and in the world of any row standing at `[x, y, z]` turned `yaw` in the frame `site` (a panel, a portal): a creation
// faces its front (-Z), so the row's yaw turns a facing-+Z point a half turn more.
function facingPoint(row, p) = ([row.x, row.y, row.z] + rotatePoint(rotate([0, 1, 0], (row.yaw + 180)), p))
function facingWorld(row, p) = frameAt(row.site, facingPoint(row, p))
// The row's heading in the world: its yaw in the site's frame, turned by the site.
function facingYaw(row) = frameYaw(row.site, row.yaw)
// A point on the glass, `across` and `up` its face and `out` along its normal, facing +Z.
function panelOnGlass(across, up, out = 0) = (panelGlassAt + ([across, 0, 0] + (panelUp * up) + (panelNormal * out)))
// The turn that carries a paint's +X across the glass to a player's right, its +Y up the face and its +Z out of it, in
// the world (architecture.puck's faceFill and faceText take it).
function panelFaceTurn(panel) = compose(rotate([0, 1, 0], (facingYaw(panel) + 180)), rotate([1, 0, 0], (0 - panelTilt)))

// A filled rectangle and a run of lettering on a panel's glass, in the world's frame, as a static creation's paints stand.
function panelFill(panel, rect, color, round = 0) = faceFill(
  facingWorld(panel, panelOnGlass(faceMid(rect)[0], faceMid(rect)[1], panelGlassDepth)),
  panelFaceTurn(panel),
  frameLength(panel.site, faceHalf(rect)),
  color,
  frameLength(panel.site, round),
  frameLength(panel.site, 0.06)
)
function panelText(panel, rect, template, ink, em, align, wrap = false, markup = false, spacing = 1) = faceText(
  facingWorld(panel, panelOnGlass(faceMid(rect)[0], faceMid(rect)[1], panelGlassDepth)),
  panelFaceTurn(panel),
  frameLength(panel.site, faceHalf(rect)),
  template,
  ink,
  frameLength(panel.site, em),
  align,
  wrap,
  markup,
  spacing,
  frameLength(panel.site, 0.06)
)
// A button's face less a margin, the box its label fits.
function panelInset(rect) = { x0: (rect.x0 + 0.01), x1: (rect.x1 - 0.01), y0: (rect.y0 + 0.008), y1: (rect.y1 - 0.008) }

// The rows of page `page`: each entry's title in its ink, read from the entry's cell of the set's ink row.
function panelPageEntries(panel, page) = filter(
  map(panel.entries, (entry, i) => { index: i, title: entry.title }),
  entry => ((entry.index >= (page * panelRows)) and (entry.index < ((page + 1) * panelRows)))
)
function panelLines(panel, page) = reduce(
  panelPageEntries(panel, page),
  "",
  (text, entry) => ((text == "") ? panelLine(panel, entry) : $"{text}\n{panelLine(panel, entry)}")
)
function panelLine(panel, entry) = $"[color={{state.panelInk.{panel.base + entry.index}}}]{entry.title}[/color]"

// What page `page` of a panel's glass shows: the elbow and bar with the panel's title in its cap, PREV and NEXT down the
// column and the page at its foot, the page's rows, a divider, and the chosen entry's title and note.
function panelPaints(panel, page) = [
  panelFill(panel, { x0: panelColumn.x0, x1: panelColumn.x1, y0: 0.15, y1: panelBar.y1 }, consoleLook.frame, 0.04)
  panelFill(panel, { x0: (panelColumn.x0 + 0.04), x1: 0.1, y0: panelBar.y0, y1: panelBar.y1 }, consoleLook.frame)
  panelFill(panel, { x0: panelColumn.x1, x1: (panelColumn.x1 + 0.04), y0: (panelBar.y0 - 0.04), y1: panelBar.y0 }, consoleLook.frame)
  panelFill(panel, { x0: panelColumn.x1, x1: (panelColumn.x1 + 0.16), y0: (panelBar.y0 - 0.16), y1: panelBar.y0 }, consoleLook.field, 0.04)
  panelFill(panel, { x0: 0.13, x1: 0.48, y0: panelBar.y0, y1: panelBar.y1 }, consoleLook.frame, 0.025)
  panelText(panel, { x0: 0.15, x1: 0.46, y0: panelBar.y0, y1: panelBar.y1 }, panel.title, consoleLook.ink, 0.03, "right")
  panelFill(panel, panelPrev, consoleLook.cream, 0.016)
  panelFill(panel, panelNext, consoleLook.teal, 0.016)
  panelText(panel, panelInset(panelPrev), "PREV", consoleLook.ink, 0.022, "right")
  panelText(panel, panelInset(panelNext), "NEXT", consoleLook.ink, 0.022, "right")
  panelFill(panel, panelFoot, consoleLook.terracotta, 0.03)
  panelText(panel, panelInset(panelFoot), $"{page + 1}/{panelPages(panel)}", consoleLook.ink, 0.024, "right")
  panelText(
    panel,
    panelList,
    panelLines(panel, page),
    consoleLook.dim,
    panelListEm,
    "left",
    markup: true,
    spacing: (panelRowPitch / (panelListEm * faceFontLine))
  )
  panelFill(panel, { x0: 0.135, x1: 0.145, y0: panelList.y0, y1: panelList.y1 }, consoleLook.frame, 0.005)
  panelText(panel, { x0: panelDetail.x0, x1: panelDetail.x1, y0: 0.175, y1: 0.205 }, "CHOSEN", consoleLook.quiet, 0.02, "left")
  panelText(panel, { x0: panelDetail.x0, x1: panelDetail.x1, y0: 0.095, y1: 0.17 }, $"{{state.panelTitle.{panel.id}}}", consoleLook.lit, 0.042, "left")
  panelText(
    panel,
    { x0: panelDetail.x0, x1: panelDetail.x1, y0: -0.265, y1: 0.085 },
    $"{{state.panelNote.{panel.id}}}",
    consoleLook.dim,
    0.022,
    "left",
    wrap: true
  )
  panelFill(panel, { x0: (panelColumn.x1 + 0.03), x1: 0.48, y0: -0.29, y1: -0.278 }, consoleLook.frame, 0.006)
]

// The pointer surface a panel's glass carries, in its placement's frame (the creation's: x and z turned from the facing-+Z
// points), with the list and the page buttons as its regions.
let panelPointer = {
  origin: (panelOnGlass(0, 0, panelGlassDepth) * [-1, 1, -1])
  right [-1, 0, 0]
  up: (panelUp * [-1, 1, -1])
  halfWidth: panelGlassHalf[0]
  halfHeight: panelGlassHalf[1]
  regions [
    faceRegion("list", panelList, panelGlassHalf, panelRows)
    faceRegion("prev", panelPrev, panelGlassHalf)
    faceRegion("next", panelNext, panelGlassHalf)
  ]
}

// The stand every panel shares, facing its front (-Z): a deep-teal foot, an ochre column, and a thick cream bezel tilted
// back round the glass, with a brass lip along its foot. Its points are given facing +Z and carried in with `* [-1, 1, -1]`.
template panelStand() {
  name: "panel-stand"
  schema: "puck.creation.v2"
  palette: plinthPalette
  shape Box "foot" {
    material: plinthTeal
    position: ([0, 0.05, 0] * [-1, 1, -1])
    scale [0.34, 0.05, 0.26]
    chamfer: 0.02
  }
  shape Box "column" {
    material: plinthOchre
    position: ([0, 0.52, -0.04] * [-1, 1, -1])
    scale [0.13, 0.46, 0.09]
    rounding: 0.02
  }
  shape Box "bezel" {
    material: plinthCream
    position: (panelOnGlass(0, 0, -0.035) * [-1, 1, -1])
    rotation: compose(rotate([0, 1, 0], 180), rotate([1, 0, 0], (0 - panelTilt)))
    scale [(panelGlassHalf[0] + 0.05), (panelGlassHalf[1] + 0.05), 0.035]
    rounding: 0.025
  }
  shape Box "lip" {
    material: plinthBrass
    position: (panelOnGlass(0, (0 - (panelGlassHalf[1] + 0.05)), -0.01) * [-1, 1, -1])
    rotation: compose(rotate([0, 1, 0], 180), rotate([1, 0, 0], (0 - panelTilt)))
    scale [(panelGlassHalf[0] + 0.03), 0.012, 0.03]
    rounding: 0.008
  }
}

// The creations every panel of `panels` needs: the shared stand, and a glass for each page of each panel's list, its paints
// placed at the panel in the world.
template panelPrototypes(panels) {
  if length(panels) > 0 {
    prototype "panel-stand" {
      document {
        panelStand()
      }
    }
  }
  for panel in panels {
    for page in range(0, panelPages(panel)) {
      prototype $"{panel.id}-panel-{page}" {
        document {
          name: $"{panel.id}-panel-{page}"
          schema: "puck.creation.v2"
          palette [consoleGlass with { paints: panelPaints(panel, page) }]
          shape Box "glass" {
            material: 0
            position: (panelOnGlass(0, 0, 0) * [-1, 1, -1])
            rotation: compose(rotate([0, 1, 0], 180), rotate([1, 0, 0], (0 - panelTilt)))
            scale [panelGlassHalf[0], panelGlassHalf[1], panelGlassDepth]
            rounding: 0.006
            lightsAs: Face
          }
        }
      }
    }
  }
}

// Each panel's stand, solid, and its glass, which carries the pointer surface and shows the page its `panelPage` cell names.
template panelPlacements(panels) {
  for panel in panels {
    placement $"{panel.id}-panel" {
      prototype: "panel-stand"
      if panel.parent != null {
        parent: panel.parent
      }
      position: facingPoint(panel, [0, 0, 0])
      yawDegrees: panel.yaw
      solid
    }
    placement $"{panel.id}-panel-screen" {
      prototype: $"{panel.id}-panel-0"
      if panel.parent != null {
        parent: panel.parent
      }
      position: facingPoint(panel, [0, 0, 0])
      yawDegrees: panel.yaw
      pointer: panelPointer
      if panelPages(panel) > 1 {
        respond: map(range(1, panelPages(panel)), page => {
          when: state(state: panelPage, key: panel.id, comparison: Equal, value: page)
          prototypeId: $"{panel.id}-panel-{page}"
        })
      }
    }
  }
}

// A world's panels as one set: each panel with `base`, where its entries start in the run of every panel's entries.
function panelSet(panels) = map(range(0, length(panels)), n => (panels[n] with {
  base: reduce(range(0, n), 0, (sum, k) => (sum + length(panels[k].entries)))
}))
// Every entry of a set, in the set's run.
function panelRun(panels) = flatMap(panels, panel => panel.entries)

// One cell per panel of `panels`, keyed by its id and seeded from `values` (a value a panel, in `panels`' order), and one
// Text cell per entry of the set's run, keyed by its place in it and seeded from `values` (a value an entry).
template panelCells(panels, name, values, kind = "Int") {
  row {
    name: name
    kind: kind
    capacity: length(panels)
    cells: map(range(0, length(panels)), index => { key: panels[index].id, value: values[index] })
  }
}
template panelRunCells(name, values) {
  row {
    name: name
    kind: Text
    capacity: length(values)
    cells: map(range(0, length(values)), g => { key: $"{g}", value: values[g] })
  }
}

// A set's state, for a world's `state.world`: the cells above, seeded so each glass boots on its panel's choice. An empty
// set declares nothing.
template panelState(panels) {
  if length(panels) > 0 {
    panelStateRows(panels: panels)
  }
}
template panelStateRows(panels) {
  panelCells(panels: panels, name: "panelChoice", values: map(panels, panel => panel.choice))
  panelCells(panels: panels, name: "panelShownAt", values: map(panels, panel => panel.choice))
  panelCells(panels: panels, name: "panelPick", values: map(panels, panel => 0))
  panelCells(panels: panels, name: "panelTap", values: map(panels, panel => 0))
  panelCells(panels: panels, name: "panelPage", values: map(panels, panel => floor((panel.choice / panelRows))))
  panelCells(panels: panels, name: "panelBase", values: map(panels, panel => panel.base))
  panelCells(panels: panels, name: "panelCount", values: map(panels, panel => length(panel.entries)))
  panelCells(panels: panels, name: "panelLast", values: map(panels, panel => (panelPages(panel) - 1)))
  panelCells(panels: panels, name: "panelTitle", kind: "Text", values: map(panels, panel => panel.entries[panel.choice].title))
  panelCells(panels: panels, name: "panelNote", kind: "Text", values: map(panels, panel => panel.entries[panel.choice].note))
  panelRunCells(
    name: "panelInk",
    values: flatMap(panels, panel => map(range(0, length(panel.entries)), i => ((i == panel.choice) ? consoleLook.lit : consoleLook.dim)))
  )
  panelRunCells(name: "panelTitles", values: map(panelRun(panels), entry => entry.title))
  panelRunCells(name: "panelNotes", values: map(panelRun(panels), entry => entry.note))
  row {
    name: "panelInks"
    kind: Text
    capacity: 2
    cells [{ key: "lit", value: consoleLook.lit }, { key: "dim", value: consoleLook.dim }]
  }
}

// A set's rules. Each glass's own sweep reads the contacts on it (a finger, a pen, a click: one door each) and posts a
// lift to its panel's `panelTap`: the row it landed on, or a page button. Two rules over every panel do the rest: a tap
// on a row chooses that row's entry and posts it to the mailbox, a page button turns the list a page, and however the
// choice moved (a tap, a rule, a console write) the detail and the inks follow it, written once a change by the choice's
// own place in the set's run (the row it was on dimmed, the row it is on lit), the write of `panelShownAt` closing the
// rule's gate. A choice that names no entry (a door closed by its cell) moves nothing on the glass until it names one.
template panelRules(panels) {
  if length(panels) > 0 {
    panelRuleSet(panels: panels)
  }
}
template panelRuleSet(panels) {
  for panel in panels {
    rule $"panel-{panel.id}-touch" {
      forEach: contacts($"{panel.id}-panel-screen")
      when contact(each, phase) == 3
      mode: Level
      panelTap[$"{panel.id}"] = (contact(each, region, list) == 1) ? (contact(each, row, list) + 1) : (0 - (contact(each, region, next) + 2 * contact(each, region, prev)))
    }
  }
  rule "panel-tap" {
    forEach: panelTap
    local tap = panelTap[$each]
    local chosen = panelPage[$each] * panelRows + tap - 1
    when panelTap[$each] != 0
    mode: Level
    if tap > 0 and chosen < panelCount[$each] {
      panelChoice[$each] = chosen
      panelPick[$each] = chosen + 1
    }
    if tap == -1 {
      panelPage[$each] = minimum(panelPage[$each] + 1, panelLast[$each])
    }
    if tap == -2 {
      panelPage[$each] = maximum(panelPage[$each] - 1, 0)
    }
    panelTap[$each] = 0
  }
  rule "panel-shown" {
    forEach: panelChoice
    local was = panelBase[$each] + panelShownAt[$each]
    local now = panelBase[$each] + panelChoice[$each]
    when panelShownAt[$each] != panelChoice[$each] and panelChoice[$each] >= 0 and panelChoice[$each] < panelCount[$each]
    mode: Level
    setState(state: panelInk, key: (was + 0), fromState: panelInks, fromKey: dim)
    setState(state: panelInk, key: (now + 0), fromState: panelInks, fromKey: lit)
    setState(state: panelTitle, key: $each, fromState: panelTitles, fromKey: (now + 0))
    setState(state: panelNote, key: $each, fromState: panelNotes, fromKey: (now + 0))
    // The page that holds the choice: its whole part of choice / rows, divided exactly.
    panelPage[$each] = (panelChoice[$each] - (panelChoice[$each] % panelRows)) / panelRows
    panelShownAt[$each] = panelChoice[$each]
  }
}

// Where a body stands while it works a panel: a step before its glass, facing it.
let panelStandAt = [0, 0, 0.9]
// The desk view of each panel, anchored on its glass's placement: the glass framed from far enough back that a terminal's
// near plane (the world's `terminalPlay` `near`, up to 2.6 m) cuts away the body standing before it, from an eye raised
// along the glass's normal. A spawn point at each panel's stand, and each panel's terminal, which a world passes to its
// one `terminalPlay`.
let panelView = { halfHeight: 0.45, fill: 0.55, fov: 30 }
function panelCameras(panels) = map(panels, panel => terminalCamera(
  name: $"{panel.id}-panel-view",
  anchor: { $type: "placement", placementId: $"{panel.id}-panel-screen" },
  centre: (panelGlassAt * [-1, 1, -1]),
  halfHeight: panelView.halfHeight,
  fill: panelView.fill,
  tilt: panelTilt,
  fieldOfView: panelView.fov
))
function panelSpawns(panels) = map(panels, panel => {
  id: $"{panel.id}-panel"
  position: facingWorld(panel, panelStandAt)
  yawDegrees: (facingYaw(panel) + 180)
})
function panelTerminals(panels) = map(panels, panel => {
  at: facingWorld(panel, [0, 0, 0.7])
  camera: $"{panel.id}-panel-view"
  spawn: $"{panel.id}-panel"
})
