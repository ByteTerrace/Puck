// A reach: the floor before a plate, a button or a door, where a press of the context button acts. It is a region
// (place.puck's `place` carries it), so the rule a press fires is one rule over whoever stands there,
// `forEach: region(id)`, and costs the bodies in reach rather than one copy of the rule for every seat and visitor.
// A module library: it hands its importers a template and functions and emits no document; an importer composes
// place.puck for the carrier.
//
// A press rule over a reach writes rows (keyed by `$each` where it is the body's), never a body effect such as
// `setBodyState`: a region binds whatever body stands in it, so a body effect there could reach any body, and a scoped
// replay refuses to isolate it. A body register changes through a mailbox row that a rule sweeping `$players` carries
// to the body.
//
//   placements {
//     reach(id: "lamp-reach", box: { x0: 1, x1: 2, y0: -0.5, y1: 1, z0: 3, z1: 4 })
//   }
//   rule "lamp" {
//     when pressing()
//     mode: Edge
//     forEach: region("lamp-reach")
//     lamp = 1 - lamp
//   }

import "bounds"

// The bodies the work sheet prices a reach's press rule at: two players reaching for one plate at once.
let reachCapacity = 2

// The reach `id` over a box given its bounds in the frame of `parent` (a placement id, or null for the world's own): a
// reach under a group stands, turns and scales with the group's root as its region does.
template reach(id, box, capacity = reachCapacity, parent = null) {
  placement id {
    prototype: "place"
    if parent != null {
      parent: parent
    }
    position: boundsCentre(box)
    region {
      halfExtents: boundsHalf(box)
      capacity: capacity
    }
  }
}

// Whether the body a reach's sweep binds presses the context button; a body no player holds reads no channel.
function pressing() = channel(each, interact) >= 1

// Whether a point (px, py, pz) stands within `r` of the world point `at` on the ground plane and within `h` of it up or
// down: the round reach of a thing a body walks up to and uses in place (a terminal, a speaker), which its rules read at
// one radius to enter and a wider one to leave. `reachedAt` takes the point's coordinates apart, so a rule can read them
// from cells (a reach whose place is state).
function reachedFrom(at, px, py, pz, r, h) = reachedAt(at[0], at[1], at[2], px, py, pz, r, h)
function reachedAt(x, y, z, px, py, pz, r, h) = ((((px - x) * (px - x)) + ((pz - z) * (pz - z)) <= (r * r)) and
  (absolute(py - y) <= h))
