// Reusable foliage and scenery. These templates emit rows only when expanded by a world.
// World positions in scatter tables are translated by origin; creation shapes keep the author frame.
import "shading"
import "rig"
import "paths"
let landscapeExponent = 2.05
let meadowSpacing = 0.075
let meadowHeight = 0.55
let meadowWidth = 0.019
let meadowTiles = [
  [4.15, 5.35], [5.05, 5.35], [5.95, 5.35], [6.85, 5.35]
  [4.15, 6.25], [5.05, 6.25], [5.95, 6.25], [6.85, 6.25]
  [4.15, 7.15], [5.05, 7.15], [5.95, 7.15], [6.85, 7.15]
  [4.15, 8.05], [5.05, 8.05], [5.95, 8.05], [6.85, 8.05]
]
let meadowBlades = map(range(0, 144), i => {
  id: i
  x: (i % 12 - 5.5) * meadowSpacing + 0.026 * sine(i * 73.17)
  z: ((i - i % 12) / 12 - 5.5) * meadowSpacing + 0.026 * sine(i * 39.71 + 1)
  h: meadowHeight * (0.72 + 0.28 * sine(i * 13.31) + 0.16 * cosine(i * 0.43))
  yaw: i * 2.39996323
})


// Surface colour belongs to shading, not silhouette relief. Static scenery has zero render lanes,
// so floor: 1 explicitly activates these authored masks. Under thresholds stay below the mask strength.
// A thresholded single octave aligned to the world axes reveals its lattice as squares, so the standard pattern
// sums two octaves (the second at 2.03x the frequency and 0.534 the weight, normalised to keep one octave's spread) read
// through a turn off every axis: a unit quaternion about the axis (1, -2, -2) / 3 by acos(0.28) = 73.7 degrees.
let landscapeTurn = [0.2, -0.4, -0.4, 0.8]
function landscapeSurface(base, under, deposit, seed, scale = 1.5, lines = 0, settle = 0.3, edge = 0, reach = 0.35, threshold = 0.16, noise = 0, patternScale = [
  1, 1, 1
], softness = 0, octaves = 2, octaveRatio = 2.03, octaveGain = 0.534, turn = landscapeTurn, settleThreshold = 0.5, settleWidth = 0, settleScale = 1, settleOwn = 0, grain = 0, frame = [
  0, 0, 0, 1
], origin = [0, 0, 0], twist = 0) = base with {
  shade: weathered(
    under,
    deposit,
    seed,
    scale,
    lines,
    settle,
    edge,
    reach,
    threshold,
    noise,
    patternScale,
    softness,
    octaveRatio,
    octaveGain,
    turn,
    settleThreshold: settleThreshold,
    settleWidth: settleWidth,
    settleScale: settleScale,
    settleOwn: settleOwn,
    octaves: octaves,
    grain: grain,
    frame: frame,
    origin: origin,
    twist: twist
  )
  // The weathering block draws its reveal in the layer's axes on top of the shade's, and has no grain frame, so a
  // grained surface keeps the block inert (no noise reveal, no deposit) and lets the shade draw both.
  weathering {
    floor: 1
    noise: ((grain > 0) ? 0 : noise)
    softness: softness
    patternScale: patternScale
    octaves: octaves
    octaveRatio: octaveRatio
    octaveGain: octaveGain
    turn: turn
    seed: seed
    scale: scale
    lines: lines
    settle: ((grain > 0) ? 0 : settle)
    edge: edge
    reach: reach
    under [{ threshold: threshold, surface { color: under, roughness: 0.98, metal: 0 } }]
    deposit { color: deposit, roughness: 0.98, metal: 0 }
  }
}

// Flat turf and relieved patches share one world-space material, including the noise phase at their seam. The pattern
// is broad (features of several metres): drier, yellower drifts settle soft-edged over the turf, and darker, lusher
// patches show through it elsewhere. The drifts read a noise channel of their own (settleOwn), a little broader than
// the lush patches', so the two lie beside each other rather than on the same spots.
function groundSurface(color) = landscapeSurface(
  { color: color, roughness: 0.99, specular: 0.015 },
  under: "#3F5F25",
  deposit: "#A3A651",
  seed: 4187,
  scale: 0.11,
  noise: 1,
  threshold: 0.68,
  softness: 0.12,
  settle: 0.6,
  settleThreshold: 0.52,
  settleWidth: 0.3,
  settleScale: 0.8,
  settleOwn: 1
)

// Stone palettes for mossyRock: the stone, the paler tone its chamfered edges and mottling reveal, and the moss that
// settles on its upward faces.
let limestoneRock = ["#888778", "#A7A28B", "#657044"]
let canyonRock = ["#9A4A2E", "#B8653F", "#5E6E36"]

// The planes that bevel mossyRock's block: each removes a half-space whose normal is turned off +Y (`z` about the
// author Z axis, `x` about X, `y` a vertical edge cut by yaw) at distance `d` from the block's centre.
let rockCuts = [
  { axis: "z", angle: -0.8, d: 0.84 }
  { axis: "z", angle: 0.95, d: 0.88 }
  { axis: "x", angle: 0.7, d: 0.72 }
  { axis: "x", angle: -1.1, d: 0.76 }
  { axis: "y", angle: 0.7853982, d: 0.95 }
  { axis: "y", angle: -2.3561945, d: 1.0 }
]
let rockCutHalf = 2
let rockCentre = 0.36
function rockCutNormal(c) = c.axis == "z" ? [0 - sine(c.angle), cosine(c.angle), 0] : (c.axis == "x" ? [
  0, cosine(c.angle), sine(c.angle)
] : [cosine(c.angle), 0, sine(c.angle)])
function rockCutRotation(c) = c.axis == "z" ? [0, 0, sine(c.angle / 2), cosine(c.angle / 2)] : (c.axis == "x" ? [
  sine(c.angle / 2), 0, 0, cosine(c.angle / 2)
] : [0, sine(0 - c.angle / 2), 0, cosine(0 - c.angle / 2)])

// A stylized boulder: a chunky block and a lower shoulder bevelled by flat cuts into broad planes and chamfers, seated
// about a quarter of its height into the ground. One weathered material reads it as rock: a paler tone along the
// chamfered edges, soft mottling, and moss settling on the faces that look up, so no colour patch has a hard edge.
template mossyRock(id, colors = limestoneRock) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "weathered-limestone"
      palette [
        landscapeSurface(
          { color: colors[0], roughness: 0.96, specular: 0.025 },
          under: colors[1],
          deposit: colors[2],
          seed: 7341,
          scale: 1.6,
          edge: 0.9,
          reach: 0.7,
          noise: 0.55,
          threshold: 0.62,
          softness: 0.3,
          settle: 1,
          settleThreshold: 0.36,
          settleWidth: 0.22
        )
      ]
      noise {
        frequency: 1.4
        amplitude: 0.025
        octaves: 2
        gain: 0.4
        seed: 7341
      }
      shape Box "stone" {
        position [0, rockCentre, 0]
        scale [0.9, 0.6, 0.7]
        rounding: 0.05
        material: 0
      }
      shape Box "shoulder" {
        position [0.66, 0.16, 0.24]
        scale [0.52, 0.4, 0.5]
        rotation [0, 0.258819, 0.0436194, 0.965]
        rounding: 0.04
        material: 0
        blend: SmoothUnion
        smooth: 0.07
      }
      for (cut, i) in rockCuts {
        shape Box $"cut-{i}" {
          position [
            rockCutNormal(cut)[0] * (cut.d + rockCutHalf),
            rockCentre + rockCutNormal(cut)[1] * (cut.d + rockCutHalf),
            rockCutNormal(cut)[2] * (cut.d + rockCutHalf),
          ]
          scale [rockCutHalf, rockCutHalf, rockCutHalf]
          rotation: rockCutRotation(cut)
          material: 0
          blend: SmoothSubtraction
          smooth: 0.035
        }
      }
    }
  }
}

// The canopy colours a whole crown as one mass, never one value per lobe: the lit middle value darkens toward `low` on
// faces turned down and in the creases where lobes meet, and lightens toward `high` on faces turned up, broken by soft
// world-space patches about 1 / `scale` metres across so neighbouring trees never band alike.
shade template canopy(low, high, seed, scale, turn, crease, drift) {
  surface {
    let p = rotate(surface.layerPosition * scale, turn)
    let patch = lattice(p, seed) * shadeFade(surface.footprint * scale)
    let t = saturate(0.5 + 0.42 * surface.normal.y + drift * patch)
    let lit = mix(mix(low, material.albedo, saturate(t * 2)), high, saturate(t * 2 - 1))
    albedo: mix(lit, low, saturate(max(0 - surface.curvature, 0) * crease))
  }
}
function canopySurface(leaves, seed) = {
  color: leaves[1]
  roughness: 0.97
  specular: 0.012
  wrap: 0.4
  shade: canopy(leaves[0], leaves[2], seed, 0.9, landscapeTurn, 0.35, 0.22)
}

// An author-frame point tipped by `lean` (radians about author Z, through the foot) and carried into a sweep's local
// frame, which rides the shape's converted pose: author +X and +Z are local -X and -Z.
function leanTurn(lean) = rotate([0, 0, 1], lean * 1rad)
function leanLocal(p, lean) = rotatePoint(leanTurn(lean), p) * [-1, 1, -1]

// A crown of separate leaf clusters rather than one blob: `count` lobes on a dome `radius` metres across and `height`
// metres tall over `centre`, laid in a sunflower spiral (each the golden angle round from the last, at a radius that
// grows with the square root of its index), so they cover the dome evenly with sky between them. Each lobe is `size`
// metres (x, y, z radii), shrinking toward the rim and wandering in size and height by a weylShare sequence that does not
// line up with the spiral, and blends into the
// lobes it touches by `smooth`, so touching lobes clump and the rest stand apart.
// leafClusterAt is where lobe `i` stands, for limbs that reach into it.
function leafClusterShare(count, i) = squareRoot(((i + 0.5) / count))
function leafClusterAt(centre, radius, height, count, i, turn = 0) = (centre + polarPoint(
  (radius * leafClusterShare(count, i)),
  ((i * 137.50776) + turn),
  ((height * (1 - (leafClusterShare(count, i) * leafClusterShare(count, i)))) + ((weylShare((i + 1), 0.7548776662) - 0.5) * 0.7))
))
template leafClusters(label, centre, radius, height, count, size, material, smooth = 0.3, turn = 0) {
  for i in range(0, count) {
    let t = leafClusterShare(count, i)
    let wander = weylShare((i + 1), 0.7548776662)
    shape Superellipsoid $"{label}-{i}" {
      exponent: landscapeExponent
      position: leafClusterAt(centre, radius, height, count, i, turn)
      scale: (size * ((1.15 - (0.4 * t)) * (0.8 + (0.4 * wander))))
      material: material
      blend: SmoothUnion
      smooth: smooth
    }
  }
}

// A spray of leaves at a twig's end, not a ball on a stick: three flattened lobes strung along the twig's level heading
// `ahead` (a unit vector) past its tip, the outer ones smaller and dipping, `size` the middle lobe's radii.
template leafSpray(label, tip, ahead, size, material, smooth = 0.25) {
  for (lobe, i) in [{ along: -0.35, rise: 0.15, share: 0.8 }, { along: 0.45, rise: 0.3, share: 1 }, { along: 1.25, rise: 0.05, share: 0.7 }] {
    shape Superellipsoid $"{label}-{i}" {
      exponent: landscapeExponent
      position: ((tip + (ahead * (lobe.along * size[0]))) + [0, (lobe.rise * size[1]), 0])
      scale: (size * lobe.share)
      material: material
      blend: SmoothUnion
      smooth: smooth
    }
  }
}

// The turn that lays a flat Prism leaf (long along local +Y, thin along local Z) out along yaw `phi` at `a` radians off
// vertical, its face looking up and its width horizontal: yaw(-phi) * roll about Z(-a) * yaw(pi/2).
function leafTurn(phi, a) = compose(rotate([0, 1, 0], -phi * 1rad), rotate([0, 0, 1], -a * 1rad), rotate([0, 1, 0], 90))
// The direction such a leaf runs.
function leafRun(phi, a) = [sine(a) * cosine(phi), cosine(a), sine(a) * sine(phi)]

// A leaf's outline, a convex profile from its tip clockwise in units of its half width and half length: widest below its
// middle and drawn to a point at the tip.
let leafOutline = [[0, 1], [0.5, 0.5], [0.85, -0.05], [0.7, -0.6], [0.3, -0.95], [-0.3, -0.95], [-0.7, -0.6], [-0.85, -0.05], [-0.5, 0.5]]
// Where leaf `i` of `count` springs from a clump: its angle from straight up, in radians, on a spiral that covers the
// clump evenly from its top down to height `low` (1 the top, -1 the underside's middle), and its bearing, each a golden
// angle round from the last.
function leafPolar(count, i, low) = arcCosine(1 - ((1 - low) * ((i + 0.5) / count)))
function leafBearing(i) = i * 2.39996323
function leafRoot(radii, polar, bearing) = [radii[0] * sine(polar) * cosine(bearing), radii[1] * cosine(polar), radii[2] * sine(polar) * sine(bearing)]

// The radii of the ellipsoid a leafy clump's leaves stand off, in the clump's own units.
let leafyRadii = [1.2, 0.8, 1.15]
// A leafy clump's palette row: a canopy triple (dark, middle, light) shaded as one soft volume over the clump's radii
// (softVolume, `soft` of the way), so the clump's leaves read by their outline and their colour while the light falls
// across the clump as across one round mass.
function leafySurface(leaves, seed, radii = leafyRadii, soft = 0.85) = softVolume(canopySurface(leaves, seed), radii, soft)

// A clump of foliage as a creation of its own, to be placed many times (leafyClumps): an inner mass and `count` flat
// leaves standing off an ellipsoid of `radii` about the creation's origin, each springing from the ellipsoid and running
// outward and down over it like the leaves of a spray, so the clump's outline is leaf tips rather than a ball's. Every
// leaf is whole, a flat prism of `leaf` (half width, half length, half thickness) grown by up to a quarter either way,
// turned `lift` radians (from, to) down from the outward direction and `spin` radians (peak to peak) about it, sprung
// up to `wander` of the spacing between leaves off its place on the spiral, and coloured by one of the rows `tones` at
// random. Every `fringeEvery`-th leaf stands out instead, `fringe` radians (from, to) off the outward direction, so
// the leaves that lie over the mass cover it and the ones that stand out make its outline. The row `inner` colours the
// mass, `core` its share of the radii, held clear of the leaves. The rows are finished palette rows (leafySurface,
// under whatever style the world lights by).
//
// A placement of any uniform scale and yaw keeps the clump's shading, and every copy draws the one baked mesh, so a
// canopy of hundreds of clumps bakes one. A leaf costs about the same triangles whatever its size, at every level of
// detail, and a view draws every copy's, so `count` is the clump's cost.
template leafyClump(id, tones, inner, radii = leafyRadii, count = 120, leaf = [0.12, 0.21, 0.012], low = -0.97, lift = [0.95, 1.45], fringe = [0.5, 0.9], fringeEvery = 4, spin = 1.0, wander = 0.6, core = 0.88) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "leafy-clump"
      palette: concat(tones, [inner])
      shape Superellipsoid "core" {
        exponent: landscapeExponent
        position [0, 0, 0]
        scale: (radii * core)
        material: length(tones)
      }
      for i in range(0, count) {
        // The spacing between leaves on a unit sphere, as an angle: the spiral gives each an equal share of its area.
        let pitch = squareRoot((4 * pi) / count)
        let polar = (leafPolar(count, i, low) + ((weylShare((i + 1), 0.4142135624) - 0.5) * wander * pitch))
        let place = (leafBearing(i) + ((weylShare((i + 1), 0.7320508076) - 0.5) * wander * pitch))
        let bearing = (place + ((weylShare((i + 1), 0.7548776662) - 0.5) * spin))
        let tilt = (((i % fringeEvery) == 0) ? fringe : lift)
        let droop = (polar + tilt[0] + ((tilt[1] - tilt[0]) * weylShare((i + 1), 0.5698402910)))
        let grow = (0.75 + (0.5 * weylShare((i + 1), 0.3819660113)))
        shape Prism $"leaf-{i}" {
          profile {
            kind: "Convex"
            vertices: leafOutline
          }
          position: (leafRoot(radii, polar, place) + (leafRun(bearing, droop) * (leaf[1] * grow * 0.55)))
          scale: (leaf * grow)
          rotation: leafTurn(bearing, droop)
          material: floor((weylShare((i + 1), 0.2360679775) * length(tones)))
        }
      }
    }
  }
}

// The placements that clothe a crown in leafy clumps, one where each of leafClusters' lobes would stand (leafClusterAt)
// and as large: `prototype` is a leafyClump whose radii are `unit`, and each copy is scaled so its first radius is its
// lobe's, turned to a bearing of its own. `centre` and the lobes are author-frame points of a creation placed at
// `origin` under `parent`, a half turn about up from the placement's frame, so a lobe at author (x, y, z) stands at
// origin + (-x, y, -z).
template leafyClumps(label, prototype, origin, centre, radius, height, count, size, parent = null, turn = 0, unit = leafyRadii[0]) {
  for i in range(0, count) {
    let at = leafClusterAt(centre, radius, height, count, i, turn)
    let t = leafClusterShare(count, i)
    placement $"{label}-{i}" {
      prototype: prototype
      parent: parent
      position [(origin[0] - at[0]), (origin[1] + at[1]), (origin[2] - at[2])]
      scale: ((size[0] / unit) * ((1.15 - (0.4 * t)) * (0.8 + (0.4 * weylShare((i + 1), 0.7548776662)))))
      yawDegrees: (360 * weylShare((i + 1), 0.4142135624))
    }
  }
}

// One grouped-shape tree: a tapered, gently bowed trunk flaring into a few buttress roots, tapering limbs whose ends are
// buried inside the canopy, and overlapping crown masses blended wide into one canopy and coloured as one mass. Rows
// are authored upright; `lean` tips the trunk, limbs and crowns, never the roots.
// trunk { base, top, height, bow }: radii at the foot and the top, the height of its buried top, and its sideways bow
// in author X. roots [{ yaw, reach, r }]: each a sweep from inside the trunk out and down into the ground. branches
// [{ a, c, r }]: each a sweep from a inside the trunk to c inside a crown, tapering from r. crowns [{ position, r }].
// `clump` is the leaf-mass relief in metres and `clumpFrequency` its features per metre, `smooth` the crowns' blend radius.
template groupedTree(id, name, bark, branchBark, leaves, trunk, roots, branches, crowns, lean = 0, smooth = 0.42, clump = 0.16, clumpFrequency = 1.1, barkUnder = [
  "#4E3D2B", "#735537"
]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: name
      palette: concat(
        map([bark, branchBark], (surface, i) => landscapeSurface(
          surface,
          under: barkUnder[i],
          deposit: "#657043",
          seed: 5123 + i,
          scale: 1,
          lines: 0,
          settle: 0.08,
          noise: 1,
          patternScale: [16, 0.6, 16],
          threshold: 0.65,
          softness: 0.25
        )),
        [canopySurface(leaves, 1731)]
      )
      // The leaf-mass breakup is one relief over the composed tree, so the crowns stay one bake group and blend as one
      // mass; a per-crown relief opens a scope per crown, and each scope bakes as its own group with a crease between.
      noise {
        frequency: clumpFrequency
        amplitude: clump
        octaves: 1
        gain: 0.4
        seed: 1731
      }
      shape Sweep "trunk" {
        position [0, 0, 0]
        material: 0
        curve {
          a: leanLocal([0, -0.15, 0], lean)
          b: leanLocal([trunk.bow, trunk.height * 0.45, 0.4 * trunk.bow], lean)
          c: leanLocal([0.3 * trunk.bow, trunk.height, 0], lean)
          radiusStart: trunk.base
          radiusEnd: trunk.top
        }
      }
      for (root, i) in roots {
        shape Sweep $"root-{i}" {
          position [0, 0, 0]
          material: 0
          blend: SmoothUnion
          smooth: 0.3
          curve {
            a [0, root.reach * 0.5, 0]
            b: polarPoint(-0.55 * root.reach, root.yaw * 1rad, 0.12)
            c: polarPoint(0 - root.reach, root.yaw * 1rad, -0.24)
            radiusStart: root.r
            radiusEnd: root.r * 0.5
          }
        }
      }
      for (branch, i) in branches {
        shape Sweep $"branch-{i}" {
          position [0, 0, 0]
          material: 1
          blend: SmoothUnion
          smooth: 0.2
          curve {
            a: leanLocal(branch.a, lean)
            b: leanLocal((branch.a + branch.c) / 2 + [0, 0.25 * (branch.c[1] - branch.a[1]), 0], lean)
            c: leanLocal(branch.c, lean)
            radiusStart: branch.r
            radiusEnd: branch.r * 0.45
          }
        }
      }
      for (crown, i) in crowns {
        shape Superellipsoid $"crown-{i}" {
          exponent: landscapeExponent
          position: rotatePoint(leanTurn(lean), crown.position)
          scale: crown.r
          material: 2
          blend: SmoothUnion
          smooth: smooth
        }
      }
    }
  }
}

// The tree families. Each scales its rows by `height` (vertical) and `spread` (crown and branch reach), so one family
// placed with a few arguments never reads as one tree cloned; `leaves` takes three values, dark, middle and light,
// which the canopy spreads over one crown from its underside to its top.
let broadleafLeaves = ["#2E5034", "#4F7340", "#7E9A4C"]
let flatCrownLeaves = ["#47622A", "#6E8A36", "#97AE4E"]
let columnLeaves = ["#253F2E", "#3B5F41", "#5A8350"]
let weepingLeaves = ["#4E6B36", "#7A984D", "#A6BD6C"]

// Scale an upright row's points by `height` (vertical) and `spread` (reach).
function treeBranches(rows, height, spread) = map(rows, b => {
  a: b.a * [spread, height, spread]
  c: b.c * [spread, height, spread]
  r: b.r
})
function treeCrowns(rows, height, spread) = map(rows, c => {
  position: c.position * [spread, height, spread]
  r: c.r * [spread, height, spread]
})
function treeRoots(count, reach, r, turn = 0) = map(range(0, count), i => {
  yaw: i * 2 * pi / count + turn
  reach: reach
  r: r
})

// A rounded courtyard oak: a stout flared trunk, four buttresses, a three-way fork and seven crown masses.
template broadleafTree(id, height = 1, spread = 1, lean = 0, leaves = broadleafLeaves) {
  groupedTree(
    id: id,
    name: "courtyard-oak",
    lean: lean,
    leaves: leaves,
    bark: {
      color: "#624A33",
      roughness: 0.96,
      specular: 0.025,
    },
    branchBark: { color: "#735738", roughness: 0.94, specular: 0.03 },
    trunk: { base: 0.5, top: 0.3, height: 3.9 * height, bow: 0.18 * spread },
    roots: treeRoots(4, 1.15, 0.34, 0.4),
    branches: treeBranches(
      [
        { a [0.1, 2.3, 0], c [1.3, 4.1, 0.1], r: 0.2 }
        { a [-0.1, 2.45, 0.08], c [-1.25, 4.3, 0.35], r: 0.18 }
        { a [0.05, 2.6, -0.1], c [0.25, 4.15, -1.05], r: 0.16 }
      ],
      height,
      spread
    ),
    crowns: treeCrowns(
      [
        { position [0, 4.5, 0], r [1.8, 1.2, 1.55] }
        { position [1.4, 4.05, 0.15], r [1.25, 0.95, 1.15] }
        { position [-1.4, 4.3, 0.35], r [1.3, 1.05, 1.1] }
        { position [0.25, 4.1, -1.25], r [1.3, 0.9, 1.1] }
        { position [-0.45, 4.55, 1.1], r [1.25, 1, 1.1] }
        { position [0.4, 5.2, 0.25], r [1.3, 0.85, 1.2] }
        { position [-1, 5, -0.65], r [1.15, 0.9, 1] }
      ],
      height,
      spread
    )
  )
}

// A flat spreading crown on a slender trunk: wide, thin masses, wider than tall, held up by three limbs.
template flatCrownTree(id, height = 1, spread = 1, lean = 0, leaves = flatCrownLeaves) {
  groupedTree(
    id: id,
    name: "flat-crown",
    lean: lean,
    leaves: leaves,
    smooth: 0.5,
    clump: 0.08,
    barkUnder: ["#534131", "#654F3B"],
    bark: { color: "#5A4634", roughness: 0.96, specular: 0.025 },
    branchBark: { color: "#634D39", roughness: 0.95, specular: 0.025 },
    trunk: { base: 0.24, top: 0.13, height: 3.6 * height, bow: 0.12 * spread },
    roots: treeRoots(3, 0.65, 0.17),
    branches: map(range(0, 3), i => {
      a [0, 2.3 * height, 0]
      c [1.45 * spread * cosine(i * 2.0943951 + 0.4), 3.72 * height, 1.45 * spread * sine(i * 2.0943951 + 0.4)]
      r: 0.12
    }),
    crowns: treeCrowns(
      [
        { position [0, 3.9, 0], r [2.3, 0.55, 2.1] }
        { position [1.6, 3.65, 0.5], r [1.5, 0.48, 1.3] }
        { position [-1.5, 3.72, -0.4], r [1.6, 0.5, 1.4] }
        { position [0.3, 3.68, -1.6], r [1.4, 0.45, 1.2] }
        { position [-0.4, 3.75, 1.5], r [1.4, 0.47, 1.25] }
        { position [0.5, 4.3, 0.2], r [1.4, 0.45, 1.25] }
      ],
      height,
      spread
    )
  )
}

// A tall narrow column, poplar-like: one tall tapering mass with a few swelling lobes on a short trunk, a vertical
// accent among rounded crowns. The lobes overlap deeply so the silhouette runs clean to its tip.
template columnTree(id, height = 1, spread = 1, lean = 0, leaves = columnLeaves) {
  groupedTree(
    id: id,
    name: "column-tree",
    lean: lean,
    leaves: leaves,
    smooth: 0.7,
    clump: 0.1,
    barkUnder: ["#49392C", "#49392C"],
    bark: { color: "#4E3D2E", roughness: 0.96, specular: 0.025 },
    branchBark: { color: "#4E3D2E", roughness: 0.96, specular: 0.025 },
    trunk: { base: 0.2, top: 0.11, height: 2.6 * height, bow: 0.06 * spread },
    roots: treeRoots(3, 0.45, 0.13, 0.7),
    branches: [],
    crowns: treeCrowns(
      [
        { position [0, 3.2, 0], r [0.95, 2.2, 0.95] }
        { position [0.08, 5.1, -0.05], r [0.72, 1.9, 0.72] }
        { position [0.35, 3.0, 0.3], r [0.62, 1.2, 0.58] }
        { position [-0.3, 3.9, -0.28], r [0.58, 1.3, 0.55] }
      ],
      height,
      spread
    )
  )
}

// A weeping tree: a domed crown over a ring of long hanging masses that fall to about a metre above the ground.
template weepingTree(id, height = 1, spread = 1, lean = 0, leaves = weepingLeaves, drops = 7) {
  groupedTree(
    id: id,
    name: "weeping-tree",
    lean: lean,
    leaves: leaves,
    smooth: 0.5,
    clump: 0.1,
    barkUnder: ["#625440", "#71614C"],
    bark: { color: "#6A5A46", roughness: 0.96, specular: 0.025 },
    branchBark: { color: "#746350", roughness: 0.95, specular: 0.025 },
    trunk: { base: 0.32, top: 0.18, height: 3.7 * height, bow: 0.15 * spread },
    roots: treeRoots(3, 0.85, 0.24, 0.5),
    branches: map(range(0, 3), i => {
      a [0, 2.5 * height, 0]
      c [1.15 * spread * cosine(i * 2.0943951), 3.9 * height, 1.15 * spread * sine(i * 2.0943951)]
      r: 0.14
    }),
    crowns: concat(
      [{ position [0, 4 * height, 0], r [1.75 * spread, 1 * height, 1.75 * spread] }],
      map(range(0, drops), k => {
        position [
          1.55 * spread * cosine(k * 2 * pi / drops),
          (2.5 + 0.25 * (k % 2)) * height,
          1.55 * spread * sine(k * 2 * pi / drops),
        ]
        r [0.6 * spread, 1.45 * height, 0.6 * spread]
      })
    )
  )
}

// A low shrub: two to four rounded crowns at ground level and no trunk, in dark blue-green values.
let scrubCrowns = [
  { position [0, 0.38, 0], r [0.85, 0.62, 0.8] }
  { position [0.75, 0.28, 0.3], r [0.6, 0.48, 0.58] }
  { position [-0.6, 0.3, -0.35], r [0.62, 0.5, 0.6] }
  { position [0.1, 0.25, -0.75], r [0.5, 0.4, 0.5] }
]
template scrubClump(id, size = 1, crowns = 3, colors = ["#2D4A3B", "#3A5D47", "#4B7050"]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "scrub-clump"
      palette: map(colors, (color, i) => landscapeSurface(
        { color: color, roughness: 0.95, specular: 0.02, wrap: 0.3 },
        under: color,
        deposit: "#71865A",
        seed: 2419 + i,
        scale: 2.2,
        settle: 0.55
      ))
      for (crown, i) in map(range(0, crowns), i => scrubCrowns[i]) {
        shape Superellipsoid $"crown-{i}" {
          exponent: landscapeExponent
          position [crown.position[0] * size, crown.position[1] * size, crown.position[2] * size]
          scale [crown.r[0] * size, crown.r[1] * size, crown.r[2] * size]
          material: i % length(colors)
          blend: SmoothUnion
          smooth: 0.15 * size
        }
      }
    }
  }
}

// A clump of flowers as painted masses: a low leafy mound carrying grouped round heads in two colours. It has no thin
// stems or blades, whose millimetre depth would set the bake's cell for the whole clump.
template flowerCluster(id, head = "#F0CF45", accent = "#E8A93A", stem = "#5A7A35", count = 6) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "flower-cluster"
      palette [
        { color: stem, roughness: 0.97, specular: 0.01, wrap: 0.3 }
        { color: head, roughness: 0.9, specular: 0.02, wrap: 0.4 }
        { color: accent, roughness: 0.9, specular: 0.02, wrap: 0.4 }
      ]
      shape Superellipsoid "mound" {
        exponent: landscapeExponent
        position [0, 0.02, 0]
        scale [0.2, 0.11, 0.18]
        material: 0
      }
      shape Superellipsoid "mound-side" {
        exponent: landscapeExponent
        position [0.12, 0.01, 0.06]
        scale [0.12, 0.08, 0.11]
        material: 0
        blend: SmoothUnion
        smooth: 0.04
      }
      for k in range(0, count) {
        shape Superellipsoid $"head-{k}" {
          exponent: landscapeExponent
          position [
            (0.03 + 0.025 * k) * cosine(k * 2.39996323),
            0.12 + 0.03 * (k % 3),
            (0.03 + 0.025 * k) * sine(k * 2.39996323),
          ]
          scale [0.055, 0.035, 0.055]
          material: 1 + floor(k % 3 / 2)
        }
      }
    }
  }
}

template grassTuft(id) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [
        {
          color: "#526F35",
          roughness: 0.97,
          specular: 0.01
        }
        {
          color: "#8CA454",
          roughness: 0.96,
          specular: 0.01
        }
      ]
      for i in range(0, 7) {
        shape Prism $"blade-{i}" {
          position [0.08 * cosine(i * 2.39996323), 0.12 + i % 3 * 0.03, 0.08 * sine(i * 2.39996323)]
          scale [0.024, 0.14 + i % 3 * 0.035, 0.009]
          taper: 0
          rotation [
            cosine(i * 2.39996323 / 2) * sine((0.15 + i % 3 * 0.12) / 2),
            sine(i * 2.39996323 / 2) * cosine((0.15 + i % 3 * 0.12) / 2),
            -sine(i * 2.39996323 / 2) * sine((0.15 + i % 3 * 0.12) / 2),
            cosine(i * 2.39996323 / 2) * cosine((0.15 + i % 3 * 0.12) / 2),
          ]
          material: i % 2
        }
      }
    }
  }
}

// The meadow's wind as a world-space flow layer: paler gust patches run across every tile and blade together, along the
// way the gust swings travel. Features are about eight metres; one cycle's travel stays under a third of one along the flow.
let meadowWind = {
  tilt: 0
  velocity [-2.5, 0, -1.6]
  scale: 0.12
  stretch: 2
  cycle: 2
  coverage: 0.3
  softness: 0.2
  surface { color: "#C2D47F", roughness: 0.8, metal: 0 }
  frame: World
  seed: 3
}

// The fringe uses tile-local coordinates; gusts use the placed world X/Z, continuous across tiles.
// fringe [x, z, rx², rz²] is the patch's ellipse and clearing [x, z, r²] the circle it leaves bare, both in tile
// coordinates; the defaults are the courtyard meadow's patch and its northern boulder. A tile small on screen sways at
// the update-rate lever's reduced tiers unless the importer passes reducedRateAtDistance: false. `feather` thins the
// patch toward its rim: a blade at ellipse value e stands only where e < 1 - feather * h, h its well-spread hash in
// [0, 1), so density falls linearly over the outer band instead of stopping at a line or the tile's square edge.
template windMeadowTile(id, tile, origin = [0, 0, 0], fringe = [5.5, 6.7, 3.2, 3.2], feather = 0.6, clearing = [
  6.5, 9.8, 2.1
], reducedRateAtDistance = true, wind = meadowWind) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: $"{id}"
      behavior {
        reducedRateAtDistance: reducedRateAtDistance
      }
      palette: map(
        [
          { color: "#698B3E", roughness: 0.9, specular: 0.025, wrap: 0.45 }
          { color: "#79964A", roughness: 0.9, specular: 0.025, wrap: 0.45 }
          { color: "#849C4F", roughness: 0.9, specular: 0.025, wrap: 0.45 }
          { color: "#9EB75C", roughness: 0.85, specular: 0.035, wrap: 0.55 }
          { color: "#A5BA63", roughness: 0.85, specular: 0.035, wrap: 0.55 }
          { color: "#91AB50", roughness: 0.85, specular: 0.035, wrap: 0.55 }
        ],
        base => flowed(base, wind)
      )
      drivers [
        {
          name: "gust",
          signal: "time",
          cadence: "state.meadowWindSpeed",
          blendInSeconds: 0
        }
        {
          name: "flutter",
          signal: "time",
          cadence: "state.meadowFlutterSpeed",
          blendInSeconds: 0
        }
        {
          name: "pose",
          signal: "state.meadowWindPose",
          cadence: 1,
          blendInSeconds: 0
        }
      ]
      for blade in filter(
        filter(meadowBlades, b => (tile[0] + b["x"] - fringe[0]) * (tile[0] + b["x"] - fringe[0]) / fringe[2] +
          (tile[1] + b["z"] - fringe[1]) * (tile[1] + b["z"] - fringe[1]) / fringe[3] < 1 - feather * weylShare(
          b["id"] * 7 + tile[0] * 13 + tile[1] * 29
        )),
        b => (tile[0] + b["x"] - clearing[0]) * (tile[0] + b["x"] - clearing[0]) +
          (tile[1] + b["z"] - clearing[1]) * (tile[1] + b["z"] - clearing[1]) >
          clearing[2]
      ) {
        shape Prism $"""stem-{blade["id"]}""" {
          position [-blade["x"], -0.1 + blade["h"] * 0.3, -blade["z"]]
          scale [meadowWidth, blade["h"] * 0.3, 0.002]
          rotation: rotate([0, 1, 0], blade["yaw"] * 1rad)
          taper: 0.55
          material: blade["id"] % 3
          swings [
            swing("pose", [0.94, 0, 0.342], 0.3, [-blade["x"], -0.1, -blade["z"]]) with { wave: "linear" }
            swing("pose", [cosine(blade["yaw"]), 0, sine(blade["yaw"])], 0.16, [-blade["x"], -0.1, -blade["z"]]) with {
              wave: "constant"
            }
            swing("gust", [0.94, 0, 0.342], 0.32, [-blade["x"], -0.1, -blade["z"]]) with {
              wave: "sine"
              phase: (origin[0] + tile[0] + blade["x"]) * 0.7 + (origin[2] + tile[1] + blade["z"]) * 0.45
            }
          ]
        }
        shape Prism $"""tip-{blade["id"]}""" {
          parent: $"""stem-{blade["id"]}"""
          position [-blade["x"], -0.1 + blade["h"] * 0.8, -blade["z"]]
          scale [meadowWidth * 0.55, blade["h"] * 0.2, 0.0015]
          rotation: rotate([0, 1, 0], blade["yaw"] * 1rad)
          taper: 0
          material: 3 + blade["id"] % 3
          swings [
            swing(
              "pose",
              [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              0.28,
              [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]]
            ) with { wave: "constant" }
            swing("pose", [0.94, 0, 0.342], 0.2, [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]]) with {
              wave: "linear"
            }
            swing("gust", [0.94, 0, 0.342], 0.18, [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]]) with {
              wave: "sine"
              phase: (origin[0] + tile[0] + blade["x"]) * 0.7 + (origin[2] + tile[1] + blade["z"]) * 0.45 - 0.4
            }
            swing(
              "flutter",
              [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              0.07,
              [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]]
            ) with { wave: "sine", phase: blade["yaw"] }
          ]
        }
      }
    }
  }
}

// A relieved near-elliptical mass, separately bounded and baked: a bank, sand cap or lawn patch.
template sceneryPatch(id, radii, color, seed = 2461, amplitude = 0.01, frequency = 2.4, surface = null) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [surface ?? { color: color, roughness: 0.97, specular: 0.025 }]
      noise {
        frequency: frequency
        amplitude: amplitude
        octaves: 2
        gain: 0.35
        seed: seed
      }
      shape Superellipsoid "mass" {
        exponent: landscapeExponent
        position [0, 0, 0]
        scale: radii
        material: 0
      }
    }
  }
}

// A table scatter: each row carries position, scale and yaw. Pass { margin: 0 } for solid scenery.
template sceneryScatter(id, prototype, rows, origin = [0, 0, 0], contact = null) {
  for (row, i) in rows {
    placement $"{id}-{i}" {
      prototype: prototype
      position [origin[0] + row.position[0], origin[1] + row.position[1], origin[2] + row.position[2]]
      scale: row.scale
      yawDegrees: row.yaw
      solid: contact
    }
  }
}

// A ground disc of flat turf whose paths are paints: colour drawn at the hit, never relief, so a path costs no draw,
// bake or contact and keeps the art direction's sharp edge. Each path is { a [x, z], b [x, z], c [x, z] }, a quadratic
// Bezier of `pathWidth` in world X/Z, at most eight (a palette slot's paint limit). A paint on a static placement is in
// world space, so the ground is placed at the origin.
//
// `holes` opens the ground where something sunk into it stands (a pool's basin): each is [minX, minZ, maxX, maxZ] in
// world X/Z, disjoint and axis-aligned, and the ground is then the square of the same half-width as boxes tiled around
// them (groundSlabs), so the ground stays a union of boxes and collides as analytic primitives, never as a field
// solve over a 740 m disc. A cut that is not axis-aligned (a river's channel) is a patch of its own (`riverChannel`,
// water.puck) filling a hole. With no holes the ground is the one disc.
function groundEdges(extent, holes) = sort(distinct(concat([0 - extent, extent], flatMap(holes, h => [h[0], h[2]]))))
// The holes spanning the strip between two edges, nearest the south first, and the slabs and cursor left by cutting the
// strip's full depth at each.
function groundCuts(x0, x1, extent, holes) = reduce(
  sort(filter(holes, h => h[0] <= x0 and h[2] >= x1), h => h[1]),
  { z: 0 - extent, slabs [] },
  (run, h) => { z: h[3], slabs: concat(run.slabs, [{ x0: x0, x1: x1, z0: run.z, z1: h[1] }]) }
)
function groundStripSlabs(x0, x1, extent, holes) = concat(
  groundCuts(x0, x1, extent, holes).slabs,
  [{ x0: x0, x1: x1, z0: groundCuts(x0, x1, extent, holes).z, z1: extent }]
)
function groundSlabs(extent, holes) = filter(
  flatMap(
    range(0, length(groundEdges(extent, holes)) - 1),
    i => groundStripSlabs(groundEdges(extent, holes)[i], groundEdges(extent, holes)[i + 1], extent, holes)
  ),
  s => s.z1 > s.z0
)
template paintedGround(id, radius, turf, paving, paths = [], pathWidth = 2.4, depth = 0.2, holes = [], pathSoftness = 0) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [
        groundSurface(turf) with {
          paints: map(paths, p => {
            type: "Sweep"
            color: paving
            softness: pathSoftness
            curve {
              a [p.a[0], 0, p.a[1]]
              b [p.b[0], 0, p.b[1]]
              c [p.c[0], 0, p.c[1]]
              radiusStart: pathWidth / 2
              radiusEnd: pathWidth / 2
            }
          })
        }
      ]
      if length(holes) == 0 {
        shape Cylinder "ground" {
          material: 0
          position [0, -depth, 0]
          scale [radius, depth, radius]
        }
      }
      // Author +X and +Z are world -X and -Z (the author frame), so each slab is placed at its negated centre.
      for (slab, i) in (length(holes) == 0 ? [] : groundSlabs(radius, holes)) {
        shape Box $"ground-{i}" {
          material: 0
          position [0 - (slab.x0 + slab.x1) / 2, -depth, 0 - (slab.z0 + slab.z1) / 2]
          scale [(slab.x1 - slab.x0) / 2, depth, (slab.z1 - slab.z0) / 2]
        }
      }
    }
  }
}

// Fronds arching out from a centre: each is a flat, tapered leaf rising from the crown and a second, longer one that
// arches over and droops toward its tip.
template fernClump(id, size = 1, colors = ["#365C43", "#547647", "#779153"]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "woodland-fern"
      palette: map(colors, (color, i) => landscapeSurface(
        { color: color, roughness: 0.96, specular: 0.015, wrap: 0.3 },
        under: color,
        deposit: "#7C9158",
        seed: 3851 + i,
        scale: 3,
        settle: 0.35
      ))
      for f in map(range(0, 8), i => {
        i: i
        phi: i * 2.39996323
        rise: 0.42 + 0.1 * (i % 3)
        arch: 1.62 + 0.18 * (i % 2)
        inner: (0.17 + 0.03 * (i % 2)) * size
        outer: (0.21 + 0.03 * (i % 3)) * size
      }) {
        shape Prism $"frond-{f.i}" {
          profile {
            kind: "Ellipse"
          }
          position [
            leafRun(f.phi, f.rise)[0] * f.inner,
            0.03 * size + leafRun(f.phi, f.rise)[1] * f.inner,
            leafRun(f.phi, f.rise)[2] * f.inner,
          ]
          scale [0.032 * size, f.inner, 0.008 * size]
          rotation: leafTurn(f.phi, f.rise)
          material: f.i % 3
        }
        shape Prism $"frond-tip-{f.i}" {
          profile {
            kind: "Ellipse"
          }
          position [
            leafRun(f.phi, f.rise)[0] * f.inner * 1.8 + leafRun(f.phi, f.arch)[0] * f.outer * 0.95,
            0.03 * size + leafRun(f.phi, f.rise)[1] * f.inner * 1.8 + leafRun(f.phi, f.arch)[1] * f.outer * 0.95,
            leafRun(f.phi, f.rise)[2] * f.inner * 1.8 + leafRun(f.phi, f.arch)[2] * f.outer * 0.95,
          ]
          scale [0.05 * size, f.outer, 0.008 * size]
          rotation: leafTurn(f.phi, f.arch)
          material: (f.i + 1) % 3
        }
      }
    }
  }
}

// Fallen wood with pale cut ends, a broken branch and one restrained moss mass.
template fallenLog(id, length = 3.8, radius = 0.25) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "fallen-mossy-log"
      palette [
        landscapeSurface(
          { color: "#594631", roughness: 0.98, specular: 0.015 },
          under: "#53422F",
          deposit: "#687447",
          seed: 7019,
          scale: 14,
          lines: 0.26,
          settle: 0.2,
          edge: 0.1
        )
        { color: "#AA8C58", roughness: 0.97, specular: 0.015 }
        { color: "#506B3B", roughness: 0.98, specular: 0.01 }
      ]
      shape Cylinder "wood" {
        position [0, radius, 0]
        scale [radius, length / 2, radius]
        rotation [0, 0, 0.70710678, 0.70710678]
        material: 0
      }
      for end in [-1, 1] {
        shape Cylinder $"end-{end}" {
          position [end * length / 2, radius, 0]
          scale [radius * 0.88, 0.025, radius * 0.88]
          rotation [0, 0, 0.70710678, 0.70710678]
          material: 1
        }
      }
      shape Capsule "broken-branch" {
        position [length * 0.18, radius * 1.5, 0]
        scale [radius * 0.3, radius * 1.2, radius * 0.3]
        rotation [0, 0, -0.258819, 0.965926]
        material: 0
      }
      shape Superellipsoid "moss" {
        exponent: landscapeExponent
        position [0.12, radius * 1.95, -0.035]
        scale [length * 0.32, radius * 0.24, radius * 0.72]
        material: 2
      }
    }
  }
}

// Small warm leaf shapes break up the woodland floor without a continuous raised mat.
template leafLitter(id, colors = ["#796341", "#8D7749", "#5E6840"]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "fallen-leaves"
      palette: map(colors, color => { color: color, roughness: 0.98, specular: 0.01 })
      for i in range(0, 16) {
        shape Superellipsoid $"leaf-{i}" {
          exponent: 2.2
          position [1.7 * squareRoot((i + 0.5) / 16) * cosine(i * 2.39996323),
            0.025 + i % 3 * 0.006, 1.15 * squareRoot((i + 0.5) / 16) * sine(i * 2.39996323)
          ]
          scale [0.13 + i % 3 * 0.025, 0.035, 0.24 + i % 4 * 0.025]
          rotation [0, sine(i * 1.73 / 2), 0, cosine(i * 1.73 / 2)]
          material: i % 3
        }
      }
    }
  }
}
