// Reusable foliage and scenery. These templates emit rows only when expanded by a world.
// World positions in scatter tables are translated by origin; creation shapes keep the author frame.
let landscapeExponent = 2.05
let meadowSpacing = 0.075
let meadowHeight = 0.55
let meadowWidth = 0.019
let meadowTiles = [
  [4.15, 5.35], [5.05, 5.35], [5.95, 5.35], [6.85, 5.35]
  [4.15, 6.25], [5.05, 6.25], [5.95, 6.25], [6.85, 6.25]
  [4.15, 7.15], [5.05, 7.15], [5.95, 7.15], [6.85, 7.15]
  [4.15, 8.05], [5.05, 8.05], [5.95, 8.05], [6.85, 8.05]
]
let meadowBlades = map(range(0, 144), i => {
  id: i
  x: (i % 12 - 5.5) * meadowSpacing + 0.026 * sine(i * 73.17)
  z: ((i - i % 12) / 12 - 5.5) * meadowSpacing + 0.026 * sine(i * 39.71 + 1)
  h: meadowHeight * (0.72 + 0.28 * sine(i * 13.31) + 0.16 * cosine(i * 0.43))
  yaw: i * 2.39996323
})


template mossyRock(id) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "weathered-limestone"
      palette [
        {
          color: "#888778",
          roughness: 0.93,
          specular: 0.06
        }
        {
          color: "#A7A28B",
          roughness: 0.94,
          specular: 0.04
        }
        {
          color: "#657044",
          roughness: 0.98,
          specular: 0.01
        }
      ]
      noise {
        frequency: 1.8
        amplitude: 0.04
        octaves: 2
        gain: 0.4
        seed: 7341
      }
      shape Superellipsoid "stone" {
        position [0, 0.43, 0]
        scale [0.95, 0.75, 0.7]
        exponent: 2.7
        rotation [0.08, 0.16, -0.06, 0.982]
        material: 0
      }
      shape Superellipsoid "shoulder" {
        position [0.59, 0.25, 0.17]
        scale [0.62, 0.46, 0.56]
        exponent: 2.5
        material: 1
        blend: SmoothUnion
        smooth: 0.16
      }
      shape Superellipsoid "moss" {
        exponent: landscapeExponent
        position [-0.18, 0.95, -0.15]
        scale [0.65, 0.2, 0.46]
        material: 2
        blend: SmoothUnion
        smooth: 0.1
      }
    }
  }
}

template broadleafTree(id) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "courtyard-oak"
      palette [
        {
          color: "#624A33",
          roughness: 0.96,
          specular: 0.025,
          weathering {
            lines: 0.35,
            scale: 5,
            seed: 5123
            under [
              {
                threshold: 0.2,
                surface {
                  color: "#977451",
                  roughness: 0.97,
                  metal: 0
                }

              }
            ]
          }
        }
        {
          color: "#826344",
          roughness: 0.94,
          specular: 0.03
        }
        {
          color: "#365C37",
          roughness: 0.94,
          specular: 0.03,
          wrap: 0.3
        }
        {
          color: "#537640",
          roughness: 0.93,
          specular: 0.03,
          wrap: 0.3
        }
        {
          color: "#73904A",
          roughness: 0.92,
          specular: 0.03,
          wrap: 0.3
        }
      ]
      noise {
        frequency: 1.6
        amplitude: 0.025
        octaves: 2
        gain: 0.4
        seed: 5123
      }
      shape Cylinder "trunk" {
        position [0, 1.45, 0]
        scale [0.36, 1.5, 0.36]
        material: 0
      }
      for i in range(0, 5) {
        shape Superellipsoid $"root-{i}" {
          exponent: landscapeExponent
          position [0.48 * cosine(i * 1.2566370614), 0.14, 0.48 * sine(i * 1.2566370614)]
          scale [0.75, 0.24, 0.2]
          rotation [0, sine(-(i * 1.2566370614) / 2), 0, cosine(-(i * 1.2566370614) / 2)]
          material: 0
          blend: SmoothUnion
          smooth: 0.16
        }
      }
      // The branch endpoints penetrate the crown, leaving a readable fork below.
      for (branch, i) in [
        {
          position [0.62, 2.75, 0],
          tilt: -0.65,
          r: 0.23,
          h: 1.8
        }
        {
          position [-0.62, 2.9, 0.25],
          tilt: 0.75,
          r: 0.2,
          h: 1.7
        }
        {
          position [0.18, 3.2, -0.55],
          tilt: -0.25,
          r: 0.18,
          h: 1.6
        }
      ] {
        shape Capsule $"branch-{i}" {
          position: branch["position"]
          scale [branch["r"], branch["h"], branch["r"]]
          rotation [0, 0, sine(branch["tilt"] / 2), cosine(branch["tilt"] / 2)]
          material: 1
          blend: SmoothUnion
          smooth: 0.18
        }
      }
      for (crown, i) in [
        {
          position [0, 4.5, 0],
          r [1.8, 1.2, 1.55]
        }
        {
          position [1.4, 4.05, 0.15],
          r [1.25, 0.95, 1.15]
        }
        {
          position [-1.4, 4.3, 0.35],
          r [1.3, 1.05, 1.1]
        }
        {
          position [0.25, 4.1, -1.25],
          r [1.3, 0.9, 1.1]
        }
        {
          position [-0.45, 4.55, 1.1],
          r [1.25, 1, 1.1]
        }
        {
          position [0.4, 5.2, 0.25],
          r [1.3, 0.85, 1.2]
        }
        {
          position [-1, 5, -0.65],
          r [1.15, 0.9, 1]
        }
      ] {
        shape Superellipsoid $"crown-{i}" {
          exponent: landscapeExponent
          position: crown["position"]
          scale: crown["r"]
          material: 2 + i % 3
          blend: SmoothUnion
          smooth: 0.25
        }
      }
    }
  }
}

template grassTuft(id) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "meadow-tuft"
      palette [
        {
          color: "#526F35",
          roughness: 0.97,
          specular: 0.01
        }
        {
          color: "#8CA454",
          roughness: 0.96,
          specular: 0.01
        }
      ]
      for i in range(0, 7) {
        shape Prism $"blade-{i}" {
          position [0.08 * cosine(i * 2.39996323), 0.12 + i % 3 * 0.03, 0.08 * sine(i * 2.39996323)]
          scale [0.024, 0.14 + i % 3 * 0.035, 0.009]
          taper: 0
          rotation [
            cosine(i * 2.39996323 / 2) * sine((0.15 + i % 3 * 0.12) / 2),
            sine(i * 2.39996323 / 2) * cosine((0.15 + i % 3 * 0.12) / 2),
            -sine(i * 2.39996323 / 2) * sine((0.15 + i % 3 * 0.12) / 2),
            cosine(i * 2.39996323 / 2) * cosine((0.15 + i % 3 * 0.12) / 2),
          ]
          material: i % 2
        }
      }
    }
  }
}

// The fringe uses tile-local coordinates; gusts use the placed world X/Z, continuous across tiles.
template windMeadowTile(id, tile, origin = [0, 0, 0]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: $"{id}"
      palette [
        {
          color: "#698B3E",
          roughness: 0.9,
          specular: 0.025,
          wrap: 0.45
        }
        {
          color: "#79964A",
          roughness: 0.9,
          specular: 0.025,
          wrap: 0.45
        }
        {
          color: "#849C4F",
          roughness: 0.9,
          specular: 0.025,
          wrap: 0.45
        }
        {
          color: "#9EB75C",
          roughness: 0.85,
          specular: 0.035,
          wrap: 0.55
        }
        {
          color: "#A5BA63",
          roughness: 0.85,
          specular: 0.035,
          wrap: 0.55
        }
        {
          color: "#91AB50",
          roughness: 0.85,
          specular: 0.035,
          wrap: 0.55
        }
      ]
      drivers [
        {
          name: "gust",
          signal: "time",
          cadence: "state.meadowWindSpeed",
          blendInSeconds: 0
        }
        {
          name: "flutter",
          signal: "time",
          cadence: "state.meadowFlutterSpeed",
          blendInSeconds: 0
        }
        {
          name: "pose",
          signal: "state.meadowWindPose",
          cadence: 1,
          blendInSeconds: 0
        }
      ]
      // Elliptical fringe and a clearing around the northern boulder.
      for blade in filter(filter(meadowBlades, b => (tile[0] + b["x"] - 5.5) * (tile[0] + b["x"] - 5.5) / 3.9 +
        (tile[1] + b["z"] - 6.7) * (tile[1] + b["z"] - 6.7) / 3.65 < 1 + 0.09 * sine(b["id"] * 7.1)), b => (tile[0] +
        b["x"] - 6.5) * (tile[0] + b["x"] - 6.5) + (tile[1] + b["z"] - 9.8) * (tile[1] + b["z"] - 9.8) > 2.1) {
        shape Prism $"""stem-{blade["id"]}""" {
          position [-blade["x"], -0.1 + blade["h"] * 0.3, -blade["z"]]
          scale [meadowWidth, blade["h"] * 0.3, 0.002]
          rotation [0, sine(blade["yaw"] / 2), 0, cosine(blade["yaw"] / 2)]
          taper: 0.55
          material: blade["id"] % 3
          swings [
            {
              driver: "pose",
              pivot [-blade["x"], -0.1, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.3,
              wave: "linear"
            }
            {
              driver: "pose",
              pivot [-blade["x"], -0.1, -blade["z"]],
              axis [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              amplitude: 0.16,
              wave: "constant"
            }
            {
              driver: "gust",
              pivot [-blade["x"], -0.1, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.32,
              phase: (origin[0] + tile[0] + blade["x"]) * 0.7 + (origin[2] + tile[1] + blade["z"]) * 0.45,
              wave: "sine"
            }
          ]
        }
        shape Prism $"""tip-{blade["id"]}""" {
          parent: $"""stem-{blade["id"]}"""
          position [-blade["x"], -0.1 + blade["h"] * 0.8, -blade["z"]]
          scale [meadowWidth * 0.55, blade["h"] * 0.2, 0.0015]
          rotation [0, sine(blade["yaw"] / 2), 0, cosine(blade["yaw"] / 2)]
          taper: 0
          material: 3 + blade["id"] % 3
          swings [
            {
              driver: "pose",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              amplitude: 0.28,
              wave: "constant"
            }
            {
              driver: "pose",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.2,
              wave: "linear"
            }
            {
              driver: "gust",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.18,
              phase: (origin[0] + tile[0] + blade["x"]) * 0.7 + (origin[2] + tile[1] + blade["z"]) * 0.45 - 0.4,
              wave: "sine"
            }
            {
              driver: "flutter",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              amplitude: 0.07,
              phase: blade["yaw"],
              wave: "sine"
            }
          ]
        }
      }
    }
  }
}

// A relieved near-elliptical mass, separately bounded and baked: a bank, sand cap or lawn patch.
template sceneryPatch(id, radii, color, seed = 2461, amplitude = 0.01, frequency = 2.4) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [{ color: color, roughness: 0.97, specular: 0.025 }]
      noise {
        frequency: frequency
        amplitude: amplitude
        octaves: 2
        gain: 0.35
        seed: seed
      }
      shape Superellipsoid "mass" {
        exponent: landscapeExponent
        position [0, 0, 0]
        scale: radii
        material: 0
      }
    }
  }
}

// A table scatter: each row carries position, scale and yaw. Pass { margin: 0 } for solid scenery.
template sceneryScatter(id, prototype, rows, origin = [0, 0, 0], contact = null) {
  for (row, i) in rows {
    placement $"{id}-{i}" {
      prototype: prototype
      position [origin[0] + row.position[0], origin[1] + row.position[1], origin[2] + row.position[2]]
      scale: row.scale
      yawDegrees: row.yaw
      solid: contact
    }
  }
}
