// Reusable foliage and scenery. These templates emit rows only when expanded by a world.
// World positions in scatter tables are translated by origin; creation shapes keep the author frame.
let landscapeExponent = 2.05
let meadowSpacing = 0.075
let meadowHeight = 0.55
let meadowWidth = 0.019
let meadowTiles = [
  [4.15, 5.35], [5.05, 5.35], [5.95, 5.35], [6.85, 5.35]
  [4.15, 6.25], [5.05, 6.25], [5.95, 6.25], [6.85, 6.25]
  [4.15, 7.15], [5.05, 7.15], [5.95, 7.15], [6.85, 7.15]
  [4.15, 8.05], [5.05, 8.05], [5.95, 8.05], [6.85, 8.05]
]
let meadowBlades = map(range(0, 144), i => {
  id: i
  x: (i % 12 - 5.5) * meadowSpacing + 0.026 * sine(i * 73.17)
  z: ((i - i % 12) / 12 - 5.5) * meadowSpacing + 0.026 * sine(i * 39.71 + 1)
  h: meadowHeight * (0.72 + 0.28 * sine(i * 13.31) + 0.16 * cosine(i * 0.43))
  yaw: i * 2.39996323
})


// Surface colour belongs to shading, not silhouette relief. Static scenery has zero render lanes,
// so floor: 1 explicitly activates these authored masks. Under thresholds stay below the mask strength.
// A thresholded single octave aligned to the world axes reveals its lattice as squares, so the standard pattern
// sums two octaves (the second at 2.03x the frequency and 0.534 the weight, normalised to keep one octave's spread) read
// through a turn off every axis: a unit quaternion about the axis (1, -2, -2) / 3 by acos(0.28) = 73.7 degrees.
let landscapeTurn = [0.2, -0.4, -0.4, 0.8]
function landscapeSurface(base, under, deposit, seed, scale = 1.5, lines = 0, settle = 0.3, edge = 0, reach = 0.35, threshold = 0.16, noise = 0, patternScale = [
  1, 1, 1
], softness = 0, octaves = 2, octaveRatio = 2.03, octaveGain = 0.534, turn = landscapeTurn) = base with {
  weathering {
    floor: 1
    noise: noise
    softness: softness
    patternScale: patternScale
    octaves: octaves
    octaveRatio: octaveRatio
    octaveGain: octaveGain
    turn: turn
    seed: seed
    scale: scale
    lines: lines
    settle: settle
    edge: edge
    reach: reach
    under [{ threshold: threshold, surface { color: under, roughness: 0.98, metal: 0 } }]
    deposit { color: deposit, roughness: 0.98, metal: 0 }
  }
}

// Flat turf and relieved patches share one world-space material, including the noise phase at their seam.
function groundSurface(color) = landscapeSurface(
  { color: color, roughness: 0.99, specular: 0.015 },
  under: "#6A6D42",
  deposit: "#91A459",
  seed: 4187,
  scale: 2.4,
  noise: 0.7,
  threshold: 0.65,
  softness: 0.45,
  settle: 0.25
)

// Stone palettes for mossyRock: the stone, its shoulder and the moss cap.
let limestoneRock = ["#888778", "#A7A28B", "#657044"]
let canyonRock = ["#9A4A2E", "#B8653F", "#5E6E36"]

template mossyRock(id, colors = limestoneRock) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "weathered-limestone"
      palette: map(colors, (color, i) => landscapeSurface(
        { color: color, roughness: 0.96, specular: 0.025 },
        under: color,
        deposit: i == 2 ? "#7F8B55" : "#B0A080",
        seed: 7341 + i,
        scale: 3,
        settle: 0.45
      ))
      noise {
        frequency: 1.8
        amplitude: 0.04
        octaves: 2
        gain: 0.4
        seed: 7341
      }
      shape Superellipsoid "stone" {
        position [0, 0.43, 0]
        scale [0.95, 0.75, 0.7]
        exponent: 2.7
        rotation [0.08, 0.16, -0.06, 0.982]
        material: 0
      }
      shape Superellipsoid "shoulder" {
        position [0.59, 0.25, 0.17]
        scale [0.62, 0.46, 0.56]
        exponent: 2.5
        material: 1
        blend: SmoothUnion
        smooth: 0.16
      }
      shape Superellipsoid "moss" {
        exponent: landscapeExponent
        position [-0.18, 0.95, -0.15]
        scale [0.65, 0.2, 0.46]
        material: 2
        blend: SmoothUnion
        smooth: 0.1
      }
    }
  }
}

// One grouped-shape tree: a trunk, roots and branches in bark, and a handful of overlapping rounded crown masses in
// flat leaf values. Rows are authored upright; `lean` (radians about the author Z axis, through the trunk's foot) tips
// the trunk, branches and crowns, never the roots.
// trunk { radius, center, half }; roots [{ position, r, yaw }]; branches [{ position, yaw, tilt, r, h }], each a
// Capsule rising from its position; crowns [{ position, r }], material cycling through the leaves.
template groupedTree(id, name, bark, branchBark, leaves, trunk, roots, branches, crowns, lean = 0, smooth = 0.25, barkUnder = [
  "#4E3D2B", "#735537"
]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: name
      palette: concat(
        map([bark, branchBark], (surface, i) => landscapeSurface(
          surface,
          under: barkUnder[i],
          deposit: "#657043",
          seed: 5123 + i,
          scale: 1,
          lines: 0,
          settle: 0.08,
          noise: 1,
          patternScale: [16, 0.6, 16],
          threshold: 0.65,
          softness: 0.25
        )),
        map(leaves, (color, i) => landscapeSurface(
          { color: color, roughness: 0.97, specular: 0.012, wrap: 0.4 },
          under: i == 0 ? "#2F4C37" : leaves[i - 1],
          deposit: "#859653",
          seed: 1731 + i,
          scale: 2.4,
          settle: 0.3,
          noise: 0.72,
          threshold: 0.6,
          softness: 0.4
        ))
      )
      shape Cylinder "trunk" {
        position [-trunk.center * sine(lean), trunk.center * cosine(lean), 0]
        scale [trunk.radius, trunk.half, trunk.radius]
        rotation [0, 0, sine(lean / 2), cosine(lean / 2)]
        material: 0
      }
      for (root, i) in roots {
        shape Superellipsoid $"root-{i}" {
          exponent: landscapeExponent
          position: root.position
          scale: root.r
          rotation [0, sine(-root.yaw / 2), 0, cosine(-root.yaw / 2)]
          material: 0
          blend: SmoothUnion
          smooth: 0.16
        }
      }
      for (branch, i) in branches {
        shape Capsule $"branch-{i}" {
          position [
            branch.position[0] * cosine(lean) - branch.position[1] * sine(lean),
            branch.position[0] * sine(lean) + branch.position[1] * cosine(lean),
            branch.position[2],
          ]
          scale [branch.r, branch.h, branch.r]
          rotation [
            cosine(lean / 2) * sine(branch.yaw / 2) * sine(branch.tilt / 2) -
              sine(lean / 2) * sine(branch.yaw / 2) * cosine(branch.tilt / 2),
            cosine(lean / 2) * sine(branch.yaw / 2) * cosine(branch.tilt / 2) +
              sine(lean / 2) * sine(branch.yaw / 2) * sine(branch.tilt / 2),
            cosine(lean / 2) * cosine(branch.yaw / 2) * sine(branch.tilt / 2) +
              sine(lean / 2) * cosine(branch.yaw / 2) * cosine(branch.tilt / 2),
            cosine(lean / 2) * cosine(branch.yaw / 2) * cosine(branch.tilt / 2) - sine(lean / 2) * cosine(
              branch.yaw / 2
            ) * sine(branch.tilt / 2),
          ]
          material: 1
          blend: SmoothUnion
          smooth: 0.18
        }
      }
      for (crown, i) in crowns {
        shape Superellipsoid $"crown-{i}" {
          exponent: landscapeExponent
          position [
            crown.position[0] * cosine(lean) - crown.position[1] * sine(lean),
            crown.position[0] * sine(lean) + crown.position[1] * cosine(lean),
            crown.position[2],
          ]
          scale: crown.r
          material: 2 + i % length(leaves)
          blend: SmoothUnion
          smooth: smooth
        }
      }
    }
  }
}

// The tree families. Each scales its rows by `height` (vertical) and `spread` (crown and branch reach), so one family
// placed with a few arguments never reads as one tree cloned; `leaves` takes three flat values.
let broadleafLeaves = ["#365C37", "#537640", "#73904A"]
let flatCrownLeaves = ["#55702E", "#6E8A36", "#8CA546"]
let columnLeaves = ["#2C4A35", "#3B5F41", "#4F784B"]
let weepingLeaves = ["#5D7A3F", "#7A984D", "#9CB465"]

// A rounded courtyard oak: a stout trunk, five roots, a three-way fork and seven crown masses.
template broadleafTree(id, height = 1, spread = 1, lean = 0, leaves = broadleafLeaves) {
  groupedTree(
    id: id,
    name: "courtyard-oak",
    lean: lean,
    leaves: leaves,
    bark: {
      color: "#624A33",
      roughness: 0.96,
      specular: 0.025,
    },
    branchBark: { color: "#826344", roughness: 0.94, specular: 0.03 },
    trunk: { radius: 0.36, center: 1.45 * height, half: 1.5 * height },
    roots: map(range(0, 5), i => {
      position [0.48 * cosine(i * 1.2566370614), 0.14, 0.48 * sine(i * 1.2566370614)]
      r [0.75, 0.24, 0.2]
      yaw: i * 1.2566370614
    }),
    branches: map(
      [
        { position [0.62, 2.75, 0], tilt: -0.65, r: 0.23, h: 1.8 }
        { position [-0.62, 2.9, 0.25], tilt: 0.75, r: 0.2, h: 1.7 }
        { position [0.18, 3.2, -0.55], tilt: -0.25, r: 0.18, h: 1.6 }
      ],
      b => {
        position [b.position[0] * spread, b.position[1] * height, b.position[2] * spread]
        yaw: 0
        tilt: b.tilt
        r: b.r
        h: b.h * height
      }
    ),
    crowns: map(
      [
        { position [0, 4.5, 0], r [1.8, 1.2, 1.55] }
        { position [1.4, 4.05, 0.15], r [1.25, 0.95, 1.15] }
        { position [-1.4, 4.3, 0.35], r [1.3, 1.05, 1.1] }
        { position [0.25, 4.1, -1.25], r [1.3, 0.9, 1.1] }
        { position [-0.45, 4.55, 1.1], r [1.25, 1, 1.1] }
        { position [0.4, 5.2, 0.25], r [1.3, 0.85, 1.2] }
        { position [-1, 5, -0.65], r [1.15, 0.9, 1] }
      ],
      c => {
        position [c.position[0] * spread, c.position[1] * height, c.position[2] * spread]
        r [c.r[0] * spread, c.r[1] * height, c.r[2] * spread]
      }
    )
  )
}

// A flat spreading crown on a slender forked trunk: two tiers of wide, thin masses, wider than tall.
template flatCrownTree(id, height = 1, spread = 1, lean = 0, leaves = flatCrownLeaves) {
  groupedTree(
    id: id,
    name: "flat-crown",
    lean: lean,
    leaves: leaves,
    smooth: 0.3,
    barkUnder: ["#534131", "#654F3B"],
    bark: { color: "#5A4634", roughness: 0.96, specular: 0.025 },
    branchBark: { color: "#6E5640", roughness: 0.95, specular: 0.025 },
    trunk: { radius: 0.2, center: 1.5 * height, half: 1.55 * height },
    roots: map(range(0, 3), i => {
      position [0.3 * cosine(i * 2.0943951), 0.1, 0.3 * sine(i * 2.0943951)]
      r [0.45, 0.16, 0.14]
      yaw: i * 2.0943951
    }),
    branches: map(range(0, 3), i => {
      position [0, 2.3 * height, 0]
      yaw: i * 2.0943951 + 0.4
      tilt: 0.72 + 0.08 * (i % 2)
      r: 0.13 - 0.01 * (i % 2)
      h: 2.1 * spread
    }),
    crowns: map(
      [
        { position [0, 3.9, 0], r [2.3, 0.55, 2.1] }
        { position [1.6, 3.6, 0.5], r [1.5, 0.45, 1.3] }
        { position [-1.5, 3.7, -0.4], r [1.6, 0.5, 1.4] }
        { position [0.3, 3.65, -1.6], r [1.4, 0.42, 1.2] }
        { position [-0.4, 3.75, 1.5], r [1.4, 0.45, 1.25] }
        { position [0.5, 4.35, 0.2], r [1.3, 0.38, 1.2] }
      ],
      c => {
        position [c.position[0] * spread, c.position[1] * height, c.position[2] * spread]
        r [c.r[0] * spread, c.r[1] * height, c.r[2] * spread]
      }
    )
  )
}

// A tall narrow column of stacked masses on a short trunk, poplar-like: a vertical accent among rounded crowns.
template columnTree(id, height = 1, spread = 1, lean = 0, leaves = columnLeaves) {
  groupedTree(
    id: id,
    name: "column-tree",
    lean: lean,
    leaves: leaves,
    smooth: 0.35,
    barkUnder: ["#49392C", "#49392C"],
    bark: { color: "#4E3D2E", roughness: 0.96, specular: 0.025 },
    branchBark: { color: "#4E3D2E", roughness: 0.96, specular: 0.025 },
    trunk: { radius: 0.17, center: 0.8 * height, half: 0.85 * height },
    roots: [],
    branches: [],
    crowns: map(
      [
        { position [0, 2.4, 0], r [0.95, 1.5, 0.95] }
        { position [0.15, 4.1, -0.1], r [0.8, 1.5, 0.8] }
        { position [0.45, 3.1, 0.35], r [0.6, 1, 0.55] }
        { position [-0.1, 5.6, 0.1], r [0.6, 1.2, 0.6] }
        { position [-0.35, 3.6, -0.3], r [0.55, 1.1, 0.5] }
        { position [0.05, 6.7, 0], r [0.35, 0.7, 0.35] }
      ],
      c => {
        position [c.position[0] * spread, c.position[1] * height, c.position[2] * spread]
        r [c.r[0] * spread, c.r[1] * height, c.r[2] * spread]
      }
    )
  )
}

// A weeping tree: a domed crown over a ring of long hanging masses that fall to about a metre above the ground.
template weepingTree(id, height = 1, spread = 1, lean = 0, leaves = weepingLeaves, drops = 7) {
  groupedTree(
    id: id,
    name: "weeping-tree",
    lean: lean,
    leaves: leaves,
    smooth: 0.3,
    barkUnder: ["#625440", "#71614C"],
    bark: { color: "#6A5A46", roughness: 0.96, specular: 0.025 },
    branchBark: { color: "#7A6852", roughness: 0.95, specular: 0.025 },
    trunk: { radius: 0.28, center: 1.4 * height, half: 1.45 * height },
    roots: map(range(0, 3), i => {
      position [0.4 * cosine(i * 2.0943951 + 0.5), 0.12, 0.4 * sine(i * 2.0943951 + 0.5)]
      r [0.6, 0.2, 0.18]
      yaw: i * 2.0943951 + 0.5
    }),
    branches: map(range(0, 3), i => {
      position [0, 2.5 * height, 0]
      yaw: i * 2.0943951
      tilt: 0.6
      r: 0.14
      h: 1.6 * spread
    }),
    crowns: concat(
      [{ position [0, 4 * height, 0], r [1.75 * spread, 1 * height, 1.75 * spread] }],
      map(range(0, drops), k => {
        position [
          1.55 * spread * cosine(k * 6.2831853 / drops),
          (2.5 + 0.25 * (k % 2)) * height,
          1.55 * spread * sine(k * 6.2831853 / drops),
        ]
        r [0.6 * spread, 1.45 * height, 0.6 * spread]
      })
    )
  )
}

// A low shrub: two to four rounded crowns at ground level and no trunk, in dark blue-green values.
let scrubCrowns = [
  { position [0, 0.38, 0], r [0.85, 0.62, 0.8] }
  { position [0.75, 0.28, 0.3], r [0.6, 0.48, 0.58] }
  { position [-0.6, 0.3, -0.35], r [0.62, 0.5, 0.6] }
  { position [0.1, 0.25, -0.75], r [0.5, 0.4, 0.5] }
]
template scrubClump(id, size = 1, crowns = 3, colors = ["#2D4A3B", "#3A5D47", "#4B7050"]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "scrub-clump"
      palette: map(colors, (color, i) => landscapeSurface(
        { color: color, roughness: 0.95, specular: 0.02, wrap: 0.3 },
        under: color,
        deposit: "#71865A",
        seed: 2419 + i,
        scale: 2.2,
        settle: 0.55
      ))
      for (crown, i) in map(range(0, crowns), i => scrubCrowns[i]) {
        shape Superellipsoid $"crown-{i}" {
          exponent: landscapeExponent
          position [crown.position[0] * size, crown.position[1] * size, crown.position[2] * size]
          scale [crown.r[0] * size, crown.r[1] * size, crown.r[2] * size]
          material: i % length(colors)
          blend: SmoothUnion
          smooth: 0.15 * size
        }
      }
    }
  }
}

// A clump of flowers as painted masses: a low leafy mound carrying grouped round heads in two colours. It has no thin
// stems or blades, whose millimetre depth would set the bake's cell for the whole clump.
template flowerCluster(id, head = "#F0CF45", accent = "#E8A93A", stem = "#5A7A35", count = 6) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "flower-cluster"
      palette [
        { color: stem, roughness: 0.97, specular: 0.01, wrap: 0.3 }
        { color: head, roughness: 0.9, specular: 0.02, wrap: 0.4 }
        { color: accent, roughness: 0.9, specular: 0.02, wrap: 0.4 }
      ]
      shape Superellipsoid "mound" {
        exponent: landscapeExponent
        position [0, 0.02, 0]
        scale [0.2, 0.11, 0.18]
        material: 0
      }
      shape Superellipsoid "mound-side" {
        exponent: landscapeExponent
        position [0.12, 0.01, 0.06]
        scale [0.12, 0.08, 0.11]
        material: 0
        blend: SmoothUnion
        smooth: 0.04
      }
      for k in range(0, count) {
        shape Superellipsoid $"head-{k}" {
          exponent: landscapeExponent
          position [
            (0.03 + 0.025 * k) * cosine(k * 2.39996323),
            0.12 + 0.03 * (k % 3),
            (0.03 + 0.025 * k) * sine(k * 2.39996323),
          ]
          scale [0.055, 0.035, 0.055]
          material: 1 + floor(k % 3 / 2)
        }
      }
    }
  }
}

template grassTuft(id) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [
        {
          color: "#526F35",
          roughness: 0.97,
          specular: 0.01
        }
        {
          color: "#8CA454",
          roughness: 0.96,
          specular: 0.01
        }
      ]
      for i in range(0, 7) {
        shape Prism $"blade-{i}" {
          position [0.08 * cosine(i * 2.39996323), 0.12 + i % 3 * 0.03, 0.08 * sine(i * 2.39996323)]
          scale [0.024, 0.14 + i % 3 * 0.035, 0.009]
          taper: 0
          rotation [
            cosine(i * 2.39996323 / 2) * sine((0.15 + i % 3 * 0.12) / 2),
            sine(i * 2.39996323 / 2) * cosine((0.15 + i % 3 * 0.12) / 2),
            -sine(i * 2.39996323 / 2) * sine((0.15 + i % 3 * 0.12) / 2),
            cosine(i * 2.39996323 / 2) * cosine((0.15 + i % 3 * 0.12) / 2),
          ]
          material: i % 2
        }
      }
    }
  }
}

// The meadow's wind as a world-space flow layer: paler gust patches run across every tile and blade together, along the
// way the gust swings travel. Features are about eight metres; one cycle's travel stays under a third of one along the flow.
let meadowWind = {
  velocity [-2.5, 0, -1.6]
  scale: 0.12
  stretch: 2
  cycle: 2
  coverage: 0.3
  softness: 0.2
  surface { color: "#C2D47F", roughness: 0.8, metal: 0 }
  frame: World
  seed: 3
}

// The fringe uses tile-local coordinates; gusts use the placed world X/Z, continuous across tiles.
// fringe [x, z, rx², rz²] is the patch's ellipse and clearing [x, z, r²] the circle it leaves bare, both in tile
// coordinates; the defaults are the courtyard meadow's patch and its northern boulder. A tile small on screen sways at
// the update-rate lever's reduced tiers unless the importer passes reducedRateAtDistance: false.
template windMeadowTile(id, tile, origin = [0, 0, 0], fringe = [5.5, 6.7, 3.9, 3.65], clearing = [6.5, 9.8, 2.1], reducedRateAtDistance = true, wind = meadowWind) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: $"{id}"
      behavior {
        reducedRateAtDistance: reducedRateAtDistance
      }
      palette [
        {
          color: "#698B3E",
          roughness: 0.9,
          specular: 0.025,
          wrap: 0.45,
          flow: wind
        }
        {
          color: "#79964A",
          roughness: 0.9,
          specular: 0.025,
          wrap: 0.45,
          flow: wind
        }
        {
          color: "#849C4F",
          roughness: 0.9,
          specular: 0.025,
          wrap: 0.45,
          flow: wind
        }
        {
          color: "#9EB75C",
          roughness: 0.85,
          specular: 0.035,
          wrap: 0.55,
          flow: wind
        }
        {
          color: "#A5BA63",
          roughness: 0.85,
          specular: 0.035,
          wrap: 0.55,
          flow: wind
        }
        {
          color: "#91AB50",
          roughness: 0.85,
          specular: 0.035,
          wrap: 0.55,
          flow: wind
        }
      ]
      drivers [
        {
          name: "gust",
          signal: "time",
          cadence: "state.meadowWindSpeed",
          blendInSeconds: 0
        }
        {
          name: "flutter",
          signal: "time",
          cadence: "state.meadowFlutterSpeed",
          blendInSeconds: 0
        }
        {
          name: "pose",
          signal: "state.meadowWindPose",
          cadence: 1,
          blendInSeconds: 0
        }
      ]
      for blade in filter(
        filter(meadowBlades, b => (tile[0] + b["x"] - fringe[0]) * (tile[0] + b["x"] - fringe[0]) / fringe[2] +
          (tile[1] + b["z"] - fringe[1]) * (tile[1] + b["z"] - fringe[1]) / fringe[3] < 1 + 0.09 * sine(
          b["id"] * 7.1
        )),
        b => (tile[0] + b["x"] - clearing[0]) * (tile[0] + b["x"] - clearing[0]) +
          (tile[1] + b["z"] - clearing[1]) * (tile[1] + b["z"] - clearing[1]) >
          clearing[2]
      ) {
        shape Prism $"""stem-{blade["id"]}""" {
          position [-blade["x"], -0.1 + blade["h"] * 0.3, -blade["z"]]
          scale [meadowWidth, blade["h"] * 0.3, 0.002]
          rotation [0, sine(blade["yaw"] / 2), 0, cosine(blade["yaw"] / 2)]
          taper: 0.55
          material: blade["id"] % 3
          swings [
            {
              driver: "pose",
              pivot [-blade["x"], -0.1, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.3,
              wave: "linear"
            }
            {
              driver: "pose",
              pivot [-blade["x"], -0.1, -blade["z"]],
              axis [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              amplitude: 0.16,
              wave: "constant"
            }
            {
              driver: "gust",
              pivot [-blade["x"], -0.1, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.32,
              phase: (origin[0] + tile[0] + blade["x"]) * 0.7 + (origin[2] + tile[1] + blade["z"]) * 0.45,
              wave: "sine"
            }
          ]
        }
        shape Prism $"""tip-{blade["id"]}""" {
          parent: $"""stem-{blade["id"]}"""
          position [-blade["x"], -0.1 + blade["h"] * 0.8, -blade["z"]]
          scale [meadowWidth * 0.55, blade["h"] * 0.2, 0.0015]
          rotation [0, sine(blade["yaw"] / 2), 0, cosine(blade["yaw"] / 2)]
          taper: 0
          material: 3 + blade["id"] % 3
          swings [
            {
              driver: "pose",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              amplitude: 0.28,
              wave: "constant"
            }
            {
              driver: "pose",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.2,
              wave: "linear"
            }
            {
              driver: "gust",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [0.94, 0, 0.342],
              amplitude: 0.18,
              phase: (origin[0] + tile[0] + blade["x"]) * 0.7 + (origin[2] + tile[1] + blade["z"]) * 0.45 - 0.4,
              wave: "sine"
            }
            {
              driver: "flutter",
              pivot [-blade["x"], -0.1 + blade["h"] * 0.6, -blade["z"]],
              axis [cosine(blade["yaw"]), 0, sine(blade["yaw"])],
              amplitude: 0.07,
              phase: blade["yaw"],
              wave: "sine"
            }
          ]
        }
      }
    }
  }
}

// A relieved near-elliptical mass, separately bounded and baked: a bank, sand cap or lawn patch.
template sceneryPatch(id, radii, color, seed = 2461, amplitude = 0.01, frequency = 2.4, surface = null) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [surface ?? { color: color, roughness: 0.97, specular: 0.025 }]
      noise {
        frequency: frequency
        amplitude: amplitude
        octaves: 2
        gain: 0.35
        seed: seed
      }
      shape Superellipsoid "mass" {
        exponent: landscapeExponent
        position [0, 0, 0]
        scale: radii
        material: 0
      }
    }
  }
}

// A table scatter: each row carries position, scale and yaw. Pass { margin: 0 } for solid scenery.
template sceneryScatter(id, prototype, rows, origin = [0, 0, 0], contact = null) {
  for (row, i) in rows {
    placement $"{id}-{i}" {
      prototype: prototype
      position [origin[0] + row.position[0], origin[1] + row.position[1], origin[2] + row.position[2]]
      scale: row.scale
      yawDegrees: row.yaw
      solid: contact
    }
  }
}

// A ground disc of flat turf whose paths are paints: colour drawn at the hit, never relief, so a path costs no draw,
// bake or contact and keeps the art direction's sharp edge. Each path is { a [x, z], b [x, z], c [x, z] }, a quadratic
// Bezier of `pathWidth` in world X/Z, at most eight (a palette slot's paint limit). A paint on a static placement is in
// world space, so the ground is placed at the origin.
//
// `holes` opens the ground where something sunk into it stands (a pool's basin): each is [minX, minZ, maxX, maxZ] in
// world X/Z, disjoint and axis-aligned, and the ground is then the square of the same half-width as boxes tiled around
// them (groundSlabs), since the analytic contact an unrelieved creation gets has no carve and a body would stand on
// the uncarved disc over the opening. With no holes the ground is the one disc.
function groundEdges(extent, holes) = sort(distinct(concat([0 - extent, extent], flatMap(holes, h => [h[0], h[2]]))))
// The holes spanning the strip between two edges, nearest the south first, and the slabs and cursor left by cutting the
// strip's full depth at each.
function groundCuts(x0, x1, extent, holes) = reduce(
  sort(filter(holes, h => h[0] <= x0 and h[2] >= x1), h => h[1]),
  { z: 0 - extent, slabs [] },
  (run, h) => { z: h[3], slabs: concat(run.slabs, [{ x0: x0, x1: x1, z0: run.z, z1: h[1] }]) }
)
function groundStripSlabs(x0, x1, extent, holes) = concat(
  groundCuts(x0, x1, extent, holes).slabs,
  [{ x0: x0, x1: x1, z0: groundCuts(x0, x1, extent, holes).z, z1: extent }]
)
function groundSlabs(extent, holes) = filter(
  flatMap(
    range(0, length(groundEdges(extent, holes)) - 1),
    i => groundStripSlabs(groundEdges(extent, holes)[i], groundEdges(extent, holes)[i + 1], extent, holes)
  ),
  s => s.z1 > s.z0
)
template paintedGround(id, radius, turf, paving, paths = [], pathWidth = 2.4, depth = 0.2, holes = []) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [
        groundSurface(turf) with {
          paints: map(paths, p => {
            type: "Sweep"
            color: paving
            curve {
              a [p.a[0], 0, p.a[1]]
              b [p.b[0], 0, p.b[1]]
              c [p.c[0], 0, p.c[1]]
              radiusStart: pathWidth / 2
              radiusEnd: pathWidth / 2
            }
          })
        }
      ]
      for open in filter([0], k => length(holes) == 0) {
        shape Cylinder "ground" {
          material: 0
          position [0, -depth, 0]
          scale [radius, depth, radius]
        }
      }
      // Author +X and +Z are world -X and -Z (the author frame), so each slab is placed at its negated centre.
      for (slab, i) in (length(holes) == 0 ? [] : groundSlabs(radius, holes)) {
        shape Box $"ground-{i}" {
          material: 0
          position [0 - (slab.x0 + slab.x1) / 2, -depth, 0 - (slab.z0 + slab.z1) / 2]
          scale [(slab.x1 - slab.x0) / 2, depth, (slab.z1 - slab.z0) / 2]
        }
      }
    }
  }
}

// Broad, readable fronds rather than fine leaflets: a low woodland layer that holds its silhouette in motion.
template fernClump(id, size = 1, colors = ["#365C43", "#547647", "#779153"]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "woodland-fern"
      palette: map(colors, (color, i) => landscapeSurface(
        { color: color, roughness: 0.96, specular: 0.015, wrap: 0.3 },
        under: color,
        deposit: "#7C9158",
        seed: 3851 + i,
        scale: 3,
        settle: 0.35
      ))
      for i in range(0, 7) {
        shape Superellipsoid $"frond-{i}" {
          exponent: 2.2
          position [0.23 * size * cosine(i * 2.39996323), 0.27 * size,
            0.23 * size * sine(i * 2.39996323)
          ]
          scale [0.11 * size, 0.43 * size, 0.065 * size]
          rotation [sine(i * 2.39996323 / 2) * sine(0.48),
            sine(i * 2.39996323 / 2) * cosine(0.48),
            cosine(i * 2.39996323 / 2) * sine(0.48),
            cosine(i * 2.39996323 / 2) * cosine(0.48)
          ]
          material: i % 3
        }
      }
    }
  }
}

// Fallen wood with pale cut ends, a broken branch and one restrained moss mass.
template fallenLog(id, length = 3.8, radius = 0.25) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "fallen-mossy-log"
      palette [
        landscapeSurface(
          { color: "#594631", roughness: 0.98, specular: 0.015 },
          under: "#53422F",
          deposit: "#687447",
          seed: 7019,
          scale: 14,
          lines: 0.26,
          settle: 0.2,
          edge: 0.1
        )
        { color: "#AA8C58", roughness: 0.97, specular: 0.015 }
        { color: "#506B3B", roughness: 0.98, specular: 0.01 }
      ]
      shape Cylinder "wood" {
        position [0, radius, 0]
        scale [radius, length / 2, radius]
        rotation [0, 0, 0.70710678, 0.70710678]
        material: 0
      }
      for end in [-1, 1] {
        shape Cylinder $"end-{end}" {
          position [end * length / 2, radius, 0]
          scale [radius * 0.88, 0.025, radius * 0.88]
          rotation [0, 0, 0.70710678, 0.70710678]
          material: 1
        }
      }
      shape Capsule "broken-branch" {
        position [length * 0.18, radius * 1.5, 0]
        scale [radius * 0.3, radius * 1.2, radius * 0.3]
        rotation [0, 0, -0.258819, 0.965926]
        material: 0
      }
      shape Superellipsoid "moss" {
        exponent: landscapeExponent
        position [0.12, radius * 1.95, -0.035]
        scale [length * 0.32, radius * 0.24, radius * 0.72]
        material: 2
      }
    }
  }
}

// Small warm leaf shapes break up the woodland floor without a continuous raised mat.
template leafLitter(id, colors = ["#796341", "#8D7749", "#5E6840"]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: "fallen-leaves"
      palette: map(colors, color => { color: color, roughness: 0.98, specular: 0.01 })
      for i in range(0, 16) {
        shape Superellipsoid $"leaf-{i}" {
          exponent: 2.2
          position [1.7 * squareRoot((i + 0.5) / 16) * cosine(i * 2.39996323),
            0.025 + i % 3 * 0.006, 1.15 * squareRoot((i + 0.5) / 16) * sine(i * 2.39996323)
          ]
          scale [0.13 + i % 3 * 0.025, 0.035, 0.24 + i % 4 * 0.025]
          rotation [0, sine(i * 1.73 / 2), 0, cosine(i * 1.73 / 2)]
          material: i % 3
        }
      }
    }
  }
}
