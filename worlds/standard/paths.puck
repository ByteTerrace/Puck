// Compile-time paths: a quadratic Bezier's point, closed polylines (their segments, the rounded curve a sweep follows,
// where they cross a height, and their stretches), open polylines walked by distance, and the path masks authored
// paving and scenery placement share.
// A quadratic Bezier's point at t in [0, 1], for controls of any dimension (arrays add element-wise).
function quadraticPoint(a, b, c, t) = ((a * ((1 - t) * (1 - t))) + (b * ((2 * t) * (1 - t))) + (c * (t * t)))
// The item of a list at index i read round the list as a loop, so -1 is the last and the length is the first.
function loopItem(items, i) = items[floorModulo(i, length(items))]
// A list's items, each with its place in the list as `index`.
function indexed(items) = map(range(0, length(items)), k => (items[k] with { index: k }))
// Vectors of any dimension: the length and the unit vector (the zero vector stays zero).
function vectorLength(v) = squareRoot(dot(v, v))
function vectorUnit(v) = (v * (1 / maximum(vectorLength(v), 0.000000001)))
// A share in [0, 1) for item `i` of a scatter that never repeats: the fractional part of `i * ratio + salt`, a Weyl
// sequence. The golden ratio's conjugate (the default) spreads the first items most evenly; the plastic number's
// reciprocal, 0.7548776662, gives a second sequence that does not line up with the first or with a golden-angle spiral.
function weylShare(i, ratio = 0.6180339887, salt = 0) = fraction((i * ratio) + salt)

// A closed polyline: its corners `points` read round as a loop. Segment i runs from corner i to corner i + 1; the
// distance along the loop is measured from corner 0.
function loopSegment(points, i) = (loopItem(points, (i + 1)) - loopItem(points, i))
function loopSegmentLength(points, i) = vectorLength(loopSegment(points, i))
function loopDistance(points, i) = sum(map(range(0, i), k => loopSegmentLength(points, k)))
function loopLength(points) = loopDistance(points, length(points))
// An open polyline over the same corners, without the closing segment: its length, the segment that holds the distance
// `s` along it (the last for any `s` past its end, which carries the last segment on), and the point and the unit
// direction at `s`.
function polylineLength(points) = loopDistance(points, (length(points) - 1))
function polylineSegment(points, s) = minimum(
  (length(points) - 2),
  count(range(1, (length(points) - 1)), k => (loopDistance(points, k) <= s))
)
function polylineDirection(points, s) = vectorUnit(loopSegment(points, polylineSegment(points, s)))
function polylineAt(points, s) = (points[polylineSegment(points, s)] +
  (polylineDirection(points, s) * (s - loopDistance(points, polylineSegment(points, s)))))

// The polyline with each corner rounded to a circular arc of `radius`, as quadratic Bezier pieces a sweep follows, each
// { a, b, c, at, index }: `at` is the fraction of the loop's length at the piece's middle. A corner's arc meets its two
// segments `radius tan(turn / 2)` from the corner, held to half of each segment's length so neighbouring arcs never
// overlap (a corner held so is rounded tighter). An arc is the rational quadratic with weight cos(turn / 2), halved
// exactly at its middle, and each half is drawn as the plain quadratic with the same ends and end tangents, whose radius
// stays within 1 / cos^3(turn / 4) of the arc's (within 27% at a right angle). Between the arcs each straight is cut
// into pieces no longer than `longest`. A corner that turns back on itself has no arc.
function cornerIn(points, i) = vectorUnit(loopSegment(points, (i - 1)))
function cornerOut(points, i) = vectorUnit(loopSegment(points, i))
function cornerCosine(points, i) = maximum(-0.999, minimum(1, dot(cornerIn(points, i), cornerOut(points, i))))
function cornerReach(points, i, radius) = minimum(
  (radius * squareRoot(((1 - cornerCosine(points, i)) / (1 + cornerCosine(points, i))))),
  (0.5 * minimum(loopSegmentLength(points, (i - 1)), loopSegmentLength(points, i)))
)
function cornerStart(points, i, radius) = (loopItem(points, i) - (cornerIn(points, i) * cornerReach(points, i, radius)))
function cornerEnd(points, i, radius) = (loopItem(points, i) + (cornerOut(points, i) * cornerReach(points, i, radius)))
function cornerWeight(points, i) = squareRoot(((1 + cornerCosine(points, i)) / 2))
function cornerMiddle(points, i, radius) = ((cornerStart(points, i, radius) + (loopItem(points, i) * (2 * cornerWeight(points, i))) +
  cornerEnd(points, i, radius)) * (1 / (2 + (2 * cornerWeight(points, i)))))
function cornerArc(points, i, radius) = (((cornerReach(points, i, radius) < 0.0001) or (cornerCosine(points, i) < -0.99)) ? [] : [
  {
    a: cornerStart(points, i, radius)
    b: ((cornerStart(points, i, radius) + (loopItem(points, i) * cornerWeight(points, i))) * (1 / (1 + cornerWeight(points, i))))
    c: cornerMiddle(points, i, radius)
    at: ((loopDistance(points, i) - (0.5 * cornerReach(points, i, radius))) / loopLength(points))
  }
  {
    a: cornerMiddle(points, i, radius)
    b: (((loopItem(points, i) * cornerWeight(points, i)) + cornerEnd(points, i, radius)) * (1 / (1 + cornerWeight(points, i))))
    c: cornerEnd(points, i, radius)
    at: ((loopDistance(points, i) + (0.5 * cornerReach(points, i, radius))) / loopLength(points))
  }
])
function straightFrom(points, i, radius) = cornerEnd(points, i, radius)
function straightTo(points, i, radius) = cornerStart(points, (i + 1), radius)
function straightCount(points, i, radius, longest) = maximum(1, ceiling((vectorLength((straightTo(points, i, radius) -
  straightFrom(points, i, radius))) / longest)))
function straightPoint(points, i, radius, longest, j) = (straightFrom(points, i, radius) + ((straightTo(points, i, radius) -
  straightFrom(points, i, radius)) * (j / straightCount(points, i, radius, longest))))
function straightPieces(points, i, radius, longest) = map(range(0, straightCount(points, i, radius, longest)), j => {
  a: straightPoint(points, i, radius, longest, j)
  b: ((straightPoint(points, i, radius, longest, j) + straightPoint(points, i, radius, longest, (j + 1))) * 0.5)
  c: straightPoint(points, i, radius, longest, (j + 1))
  at: ((loopDistance(points, i) + cornerReach(points, i, radius) + ((loopSegmentLength(points, i) - cornerReach(points, i, radius) -
    cornerReach(points, (i + 1), radius)) * ((j + 0.5) / straightCount(points, i, radius, longest)))) / loopLength(points))
})
function closedRoundedPolyline(points, radius, longest) = indexed(flatMap(
  range(0, length(points)),
  i => concat(cornerArc(points, i, radius), straightPieces(points, i, radius, longest))
))

// Where the polyline crosses each height of `heights` (ascending or not), each { point, height, segment }: the height's
// index, and the segment whose ends stand either side of it.
function loopCrossingsOf(points, heights, i) = map(
  filter(range(0, length(heights)), h => (((loopItem(points, i)[1] - heights[h]) * (loopItem(points, (i + 1))[1] - heights[h])) < 0)),
  h => {
    point: (loopItem(points, i) + (loopSegment(points, i) * ((heights[h] - loopItem(points, i)[1]) / loopSegment(points, i)[1])))
    height: h
    segment: i
  }
)
function loopCrossings(points, heights) = flatMap(range(0, length(points)), i => loopCrossingsOf(points, heights, i))
// The polyline's straight stretches, each segment cut where it crosses a height of `heights` and its parts cut again into
// stretches no longer than `longest`, each { from, to, at }: `at` is the fraction of the loop's length at its middle.
function loopCutsOf(points, heights, i) = sort(concat([0, 1], map(loopCrossingsOf(points, heights, i), x => ((x.point[1] -
  loopItem(points, i)[1]) / loopSegment(points, i)[1]))))
function loopPartsOf(points, i, t0, t1, longest) = maximum(1, ceiling(((loopSegmentLength(points, i) * (t1 - t0)) / longest)))
function loopStretchesOf(points, heights, longest, i, t0, t1) = map(range(0, loopPartsOf(points, i, t0, t1, longest)), j => {
  from: (loopItem(points, i) + (loopSegment(points, i) * (t0 + (((t1 - t0) * j) / loopPartsOf(points, i, t0, t1, longest)))))
  to: (loopItem(points, i) + (loopSegment(points, i) * (t0 + (((t1 - t0) * (j + 1)) / loopPartsOf(points, i, t0, t1, longest)))))
  at: ((loopDistance(points, i) + (loopSegmentLength(points, i) * (t0 + (((t1 - t0) * (j + 0.5)) / loopPartsOf(points, i, t0, t1,
    longest))))) / loopLength(points))
})
function loopStretches(points, heights, longest) = indexed(flatMap(range(0, length(points)), i => flatMap(
  range(0, (length(loopCutsOf(points, heights, i)) - 1)),
  k => loopStretchesOf(points, heights, longest, i, loopCutsOf(points, heights, i)[k], loopCutsOf(points, heights, i)[(k + 1)])
)))
// A path has a/b/c [x, z] controls. Segment distance plus the chord-error bound conservatively excludes its corridor.
function quadraticPathPoint(path, t) = {
  x: quadraticPoint(path.a, path.b, path.c, t)[0]
  z: quadraticPoint(path.a, path.b, path.c, t)[1]
}
function quadraticPathSegments(paths, steps = 40) = flatMap(paths, path => map(
  range(0, steps),
  i => { a: quadraticPathPoint(path, i / steps), b: quadraticPathPoint(path, (i + 1) / steps) }
))
function pathPointDistanceSquared(x, z, point) = (x - point.x) * (x - point.x) + (z - point.z) * (z - point.z)
function pathSegmentFraction(x, z, segment) = maximum(0, minimum(
  1,
  ((x - segment.a.x) * (segment.b.x - segment.a.x) + (z - segment.a.z) * (segment.b.z - segment.a.z)) / maximum(
    0.000000000001,
    pathPointDistanceSquared(segment.b.x, segment.b.z, segment.a)
  )
))
// A quadratic's maximum deviation from a chord over 1/steps is |a - 2b + c| / (4 steps^2).
function quadraticPathChordError(path, steps = 40) = squareRoot(
  (path.a[0] - 2 * path.b[0] + path.c[0]) * (path.a[0] - 2 * path.b[0] + path.c[0]) +
    (path.a[1] - 2 * path.b[1] + path.c[1]) * (path.a[1] - 2 * path.b[1] + path.c[1])
) / (4 * steps * steps)

// Precomputed bounds reject distant corridors and segments before evaluating their distance.
function quadraticPathCorridors(paths, steps = 16) = map(paths, path => {
  minX: minimum(path.a[0], minimum(path.b[0], path.c[0]))
  maxX: maximum(path.a[0], maximum(path.b[0], path.c[0]))
  minZ: minimum(path.a[1], minimum(path.b[1], path.c[1]))
  maxZ: maximum(path.a[1], maximum(path.b[1], path.c[1]))
  error: quadraticPathChordError(path, steps)
  segments: quadraticPathSegments([path], steps)
})
function pathBoundsClear(x, z, radius, bounds) = (x < bounds.minX - radius or
  x > bounds.maxX + radius or
  z < bounds.minZ - radius or
  z > bounds.maxZ + radius)
function pathSegmentProjectionDistanceSquared(x, z, segment, fraction) = pathPointDistanceSquared(x, z, {
  x: segment.a.x + fraction * (segment.b.x - segment.a.x)
  z: segment.a.z + fraction * (segment.b.z - segment.a.z)
})
function pathSegmentClear(x, z, radius, segment) = (x < minimum(segment.a.x, segment.b.x) - radius or x > maximum(
  segment.a.x,
  segment.b.x
) + radius or z < minimum(segment.a.z, segment.b.z) - radius or z > maximum(segment.a.z, segment.b.z) + radius or pathSegmentProjectionDistanceSquared(
  x,
  z,
  segment,
  pathSegmentFraction(x, z, segment)
) >
  radius * radius)
function pathCorridorClear(x, z, radius, corridor) = (pathBoundsClear(x, z, radius + corridor.error, corridor) or
  all(corridor.segments, segment => pathSegmentClear(x, z, radius + corridor.error, segment)))
function pathCorridorsClear(x, z, radius, corridors) = all(corridors, corridor => pathCorridorClear(x, z, radius, corridor))
