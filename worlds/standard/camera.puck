// The standard camera, a library. `cameraFeel()` authors the shared input feel, the `camera-boom` response and the
// interactive zoom bounds and step; `standard.puck` expands it, so every world importing the standard has them.
// `chaseCamera(...)` authors a seated body's third-person chase camera: the seat control (pitch limits, automatic first
// person, the boom), the rig, and the player's clearance preference. The player module (player/player.puck) expands it
// with the worn form's body offsets; an author seating a body without the module expands it directly:
//
//   import "../../standard/camera"
//   chaseCamera(rig: "my-camera", pivotOffset: [0, 0.9, 0], fadeCloseTarget: [0, 1.5, 0], cutawayCloseTarget: [0, 1.35, 0], eyePoint: [0, 1.6, 0.2])
//
// How the eye meets a room narrower than its boom is the `clearance` camera-program operation, and the feel is
// authored here as two cases of the rig: `<rig>-fade` keeps the room and fades the body, `<rig>-cutaway` keeps the
// body solid and cuts the walls away. The seat rig selects between them by the `cameraClearance` state row, the
// player's preference (Fade or Cutaway): `camera.clearance Cutaway` switches it live, and `clearance: 1` starts a world
// on cutaway. The defaults are the chase-camera decision's values (docs/decisions/play.md, "The chase camera"): a 4.2 m
// boom at 0.3 rad, the waist-to-head target shift, automatic first person off. Distances are full-size metres, angles
// radians. Each case has its own rise ceiling above the rig's elevation (`fadeMaxRise`, `cutawayMaxRise`) and close
// target (`fadeCloseTarget`, `cutawayCloseTarget`): the boom rises only when no level pull-in keeps the eye out past
// the fade's minimum boom, or past the body in cutaway. `eyeRadius` is the sphere the eye keeps clear of geometry (and
// the body, in cutaway), `surfaceSkin` the nearest the eased eye's centre comes to geometry along the boom,
// `nearMargin` how far short of the body cutaway's near plane stops, `retractionSkin` how far short of a hit the probe
// reports the room, and `obstructedTargetSkin` how far out cutaway's sweep starts when the target is inside geometry
// (a portal frame round the pivot).
//
// `wall` adds a second framing for a body that holds a face it cannot stand on (a climber): `wallFraming(...)` pulls
// the eye back and looks up the face. Each case then blends its ground framing with its wall framing by the
// `cameraOnWall` row, which a rule sets to 1 while the body's `HoldingUnwalkable` fact holds and which eases on the
// `camera-wall` response, so the camera drifts out as she takes a wall and back as she lets go or pulls up over the top.
// A player's zoom keeps both framings in proportion. `faceFrame: Body` makes movement on a face the body's own: forward
// climbs and sideways traverses wherever the camera orbits.

// The interactive boom's zoom: the nearest and farthest requested distance and the distance one input unit moves.
let cameraBoom = { minimum: 1.5, maximum: 12, step: 0.6 }

// A fixed camera row for a `cameras` section: `eye` looking at `target`, `fov` radians wide, focused `focusDistance`
// metres out and rendered `width` by `height` pixels.
function lookCamera(name, eye, target, fov, focusDistance = 6, width = 1280, height = 900) = {
  name: name
  renderHeight: height
  renderWidth: width
  rig {
    name: name
    operations [
      anchor(opcode: "anchor", subject: worldPoint(point: eye))
      lookAt(focusDistance: focusDistance, opcode: "lookAt", subject: worldPoint(point: target), worldAxes: false)
      fieldOfView(fieldOfViewRadians: fov, opcode: "fov")
    ]
    version: "puck.camera.program.v1"
  }
}

// A `views` layout that shows one fixed camera of a `cameras` section across the whole window, for inspecting a creation
// or framing a place from the same eye every time: `name` is the layout's, `camera` the camera's (the same by default).
template cameraLayout(name, camera = name) {
  layout name {
    seatCount: 0
    slots [
      {
        camera: camera
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
  }
}

// A chase camera's framing of a body on a face it cannot stand on, for `chaseCamera(wall:)`: `distance` metres of boom
// at `pitch` radians of elevation (negative looks up from below the pivot) about `pivotOffset` in the body's frame, and
// the response the blend eases on: `frequency` hertz, `damping` ratio (1 never overshoots).
function wallFraming(distance = 5.4, pitch = -0.12, pivotOffset = [0, 1.8, 0], frequency = 1, damping = 1) = {
  distance: distance
  pitch: pitch
  pivotOffset: pivotOffset
  frequency: frequency
  damping: damping
}

// A chase camera's framing of something a body holds before it to read (a panel on its wrist, a map in its hands), for
// `chaseCamera(focus:)`: `distance` metres of boom at `pitch` radians of elevation about `pivotOffset` in the body's
// frame, whose x leans toward the body's left; the same framing mirrored leans toward its right. The camera eases toward
// the left framing by the `left` row and toward the right one by the `right` row (keyed by body: 0 the ordinary
// framing, 1 the focus), each eased by its row's own dynamics; a body holds one thing at a time, so one of them is 0
// (the journal's `journalRaiseLeft` and `journalRaiseRight`).
function focusFraming(left, right, distance = 1.9, pitch = 0.45, pivotOffset = [0.3, 1.35, 0.1]) = {
  left: left
  right: right
  distance: distance
  pitch: pitch
  pivotOffset: pivotOffset
}

// The shared look feel and the `camera-boom` response a chase rig eases on.
template cameraResponse() {
  export binding `camera-boom`

  seatDefaults {
    seatCameraFeel {
      invertPitch: false
      invertYaw: false
      pitchSensitivity: 0.001
      stickLookRate: 3.5
      yawSensitivity: 0.001
      // A pad's gyro: its pitch drives look pitch, and its yaw and roll both drive look yaw, past a 0.02 rad/s dead
      // zone on each axis.
      gyro {
        scale: 1
        deadZone [0.02, 0.02, 0.02]
        yaw [0, -1, -1]
        pitch [1, 0, 0]
      }
    }
  }

  dynamics [
    { name: "camera-boom", f: 4, r: 0, zeta: 1 }
  ]
}

// The shared feel and the zoom the interactive boom answers. A world or avatar may refine these rows by id.
template cameraFeel() {
  cameraResponse()

  views {
    // The ease into or out of the seat ladder no authored layout selects; an authored layout brings its own envelope.
    builtinTransition {
      renderScale: 0.5
      seconds: 0.6
    }

    seatControl {
      boom: cameraBoom
    }
  }
}

// A seated body's chase camera. `pivotOffset` is the rest look target at full boom length, `fadeCloseTarget` and
// `cutawayCloseTarget` the targets the look migrates to, in each case, as geometry shortens the boom from
// `closeTargetStart` to `closeTargetFull` of its length, and `eyePoint` the first-person eye, each in the body's frame.
// The fade case dissolves the body from `fadeStart` to `fadeEnd` metres of boom and keeps at least `minimumBoom` where
// the room allows it; first person hides the body inside `hideRadius` and eases in over `transitionSeconds`. Automatic
// first person, when enabled, enters after the room behind the head stays under `autoEntryDistance` for
// `autoEntrySeconds` and leaves once it stays over `autoExitDistance` for `autoExitSeconds`. `clearance` is the
// preference row's starting value: 0 fade, 1 cutaway. `focus` (`focusFraming(...)`) adds a framing the camera eases
// toward while the body reads something it holds, leaning to that thing's side.
template chaseCamera(rig, pivotOffset = [0, 1, 0], fadeCloseTarget = [0, 1.74, 0], cutawayCloseTarget = [0, 1.55, 0], eyePoint = [
  0, 1.75, 0.22
], distance = 4.2, pitch = 0.3, fieldOfView = 0.96, minPitch = -0.5, maxPitch = 1.2, yawReference = "World", clearance = 0, fadeMaxRise = 0.35, cutawayMaxRise = 1.1, eyeRadius = 0.3, surfaceSkin = 0.1, closeTargetStart = 0.6, closeTargetFull = 0.2, fadeStart = 1.25, fadeEnd = 0.45, minimumBoom = 0.35, nearMargin = 0.05, retractionSkin = 0.05, obstructedTargetSkin = 1.1, hideRadius = 0.45, transitionSeconds = 0.5, autoFirstPerson = false, autoEntryDistance = 0.85, autoEntrySeconds = 0.2, autoExitDistance = 1.35, autoExitSeconds = 0.15, wall = null, focus = null, faceFrame = "Body", seats = 4, capacity = 16) {
  cameraResponse()

  // The framings each clearance case resolves: the ground framing alone, or the ground and the wall framing a blend
  // mixes, and with a focus its framing leaning to either side.
  let plain = ((wall == null) ? (focus == null) : false)
  let focusSides = ((focus == null) ? [] : [{ suffix: "-focus-left", lean: 1 }, { suffix: "-focus-right", lean: -1 }])
  let framings = concat(
    [{ suffix: (plain ? "" : "-ground"), distance: distance, pitch: pitch, pivotOffset: pivotOffset }],
    ((wall == null) ? [] : [{ suffix: "-wall", distance: wall.distance, pitch: wall.pitch, pivotOffset: wall.pivotOffset }]),
    map(focusSides, side => {
      suffix: side.suffix
      distance: focus.distance
      pitch: focus.pitch
      pivotOffset [(focus.pivotOffset[0] * side.lean), focus.pivotOffset[1], focus.pivotOffset[2]]
    })
  )
  let cases = [
    {
      suffix: "fade"
      closeTarget: fadeCloseTarget
      cutaway: 0
      maxRise: fadeMaxRise
      minimumBoom: minimumBoom
      fadeStart: fadeStart
      fadeEnd: fadeEnd
      obstructedTargetSkin: 0
    }
    {
      suffix: "cutaway"
      closeTarget: cutawayCloseTarget
      cutaway: 1
      maxRise: cutawayMaxRise
      minimumBoom: 0
      fadeStart: 0
      fadeEnd: 0
      obstructedTargetSkin: obstructedTargetSkin
    }
  ]

  if wall != null {
    export binding cameraOnWall

    dynamics [
      { name: "camera-wall", f: wall.frequency, r: 0, zeta: wall.damping }
    ]

    state {
      world {
        // 1 while a body holds a face it cannot stand on, by body index; the rig reads its eased value.
        row {
          name: "cameraOnWall"
          kind: "Fixed"
          capacity: capacity
          dynamics { row: "camera-wall" }
          cells: map(range(0, seats), seat => { key: $"{seat}", value: "0" })
        }
      }
    }

    rule "camera-on-wall" {
      forEach: $players
      local onWall = fact(each, HoldingUnwalkable)
      when (onWall == 1 and cameraOnWall[$each] < 0.5) or (onWall == 0 and cameraOnWall[$each] > 0.5)
      mode: Level
      if onWall == 1 {
        cameraOnWall[$each] = 1
      } else {
        cameraOnWall[$each] = 0
      }
    }
  }

  export binding cameraClearance

  state {
    enum CameraClearance {
      Fade
      Cutaway
    }

    world {
      // The player's tight-space preference: the seat rig selects its fade or cutaway case by it.
      slot cameraClearance: CameraClearance = clearance
    }
  }

  commands [
    {
      name: "camera.clearance"
      help: "Chooses how the chase camera meets a room narrower than its boom: Fade keeps the room ahead and fades the body as the eye nears it, Cutaway keeps the body solid, rising over it and cutting away the walls between. Writes the cameraClearance preference row, which the seat rig selects its case by; world.view.camera reads the parameters the case resolves."
      parameters [
        { name: "mode", kind: Choice, values ["Fade", "Cutaway"] }
      ]
      lines [
        "world.state.cell.set cameraClearance $value {mode}"
      ]
    }
  ]

  views {
    seatControl {
      boom: cameraBoom
      autoFirstPerson {
        enabled: autoFirstPerson
        entryDistance: autoEntryDistance
        entrySeconds: autoEntrySeconds
        exitDistance: autoExitDistance
        exitSeconds: autoExitSeconds
      }
      maxPitch: maxPitch
      minPitch: minPitch
      yawReference: yawReference
      faceFrame: faceFrame
    }

    seatRig {
      name: rig
      version: "puck.camera.program.v1"
      operations [
        selectProgram(
          key: "state.cameraClearance",
          cases: [
            { value: 0, program: $"{rig}-fade" }
            { value: 1, program: $"{rig}-cutaway" }
          ],
          default: $"{rig}-fade"
        )
      ]
    }

    // The two cases the seat rig selects between: one orbit, look, lens, ease and first-person eye per framing, and
    // the clearance each trades the room by. With a wall framing a case stands on the blend of its ground and wall
    // framings, and with a focus it blends what it stands on toward its left focus and that toward its right focus.
    programs: concat(
      flatMap(cases, case => map(framings, framing => {
        name: $"{rig}-{case.suffix}{framing.suffix}"
        version: "puck.camera.program.v1"
        operations [
          orbit(distance: framing.distance, pitch: framing.pitch, pivotOffset: framing.pivotOffset, yaw: 0)
          lookAt(focusDistance: framing.distance, subject: reference(), targetOffset: framing.pivotOffset, worldAxes: true)
          clearance(
            cutaway: case.cutaway,
            eyeRadius: eyeRadius,
            surfaceSkin: surfaceSkin,
            maxRise: case.maxRise,
            minimumBoom: case.minimumBoom,
            fadeStart: case.fadeStart,
            fadeEnd: case.fadeEnd,
            closeTargetOffset: case.closeTarget,
            closeTargetStartFraction: closeTargetStart,
            closeTargetFullFraction: closeTargetFull,
            nearMargin: nearMargin,
            retractionSkin: retractionSkin,
            obstructedTargetSkin: case.obstructedTargetSkin
          )
          fieldOfView(fieldOfViewRadians: fieldOfView)
          dynamics(row: `camera-boom`)
          firstPerson(eyePoint: eyePoint, active: 0, transitionSeconds: transitionSeconds, hideRadius: hideRadius)
        ]
      })),
      ((wall == null)
        ? []
        : map(cases, case => {
          name: ((focus == null) ? $"{rig}-{case.suffix}" : $"{rig}-{case.suffix}-stand")
          version: "puck.camera.program.v1"
          operations [
            blend(a: $"{rig}-{case.suffix}-ground", b: $"{rig}-{case.suffix}-wall", weight: "state.cameraOnWall.$body")
          ]
        })),
      ((focus == null)
        ? []
        : flatMap(cases, case => [
          {
            name: $"{rig}-{case.suffix}-lean"
            version: "puck.camera.program.v1"
            operations [
              blend(
                a: ((wall == null) ? $"{rig}-{case.suffix}-ground" : $"{rig}-{case.suffix}-stand"),
                b: $"{rig}-{case.suffix}-focus-left",
                weight: $"state.{focus.left}.$body"
              )
            ]
          }
          {
            name: $"{rig}-{case.suffix}"
            version: "puck.camera.program.v1"
            operations [
              blend(a: $"{rig}-{case.suffix}-lean", b: $"{rig}-{case.suffix}-focus-right", weight: $"state.{focus.right}.$body")
            ]
          }
        ]))
    )
  }
}
