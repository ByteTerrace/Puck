// The standard's cel styles, a library. A style is one `toon` value: a palette row names one for its own material, and a
// world names one as the default every material without a style of its own inherits, which `world.toon on|off` then
// switches live:
//
//   import "../standard/styles"
//   palette [{ color: "#C9A27E", wrap: 0.35, toon: celStyle }]   // this material bands; its neighbours keep theirs
//   render { toon: celStyle }                                     // every material without a style of its own bands
//
// A style is on unless it says `enabled: false`: `continuousStyle` keeps a material continuous under a banded world. Every
// field is the engine's `render.toon` field, and a world overrides one by writing its own style beside these.
//
// `celStyle` bands each light's cosine and multiplies the shadow after the band, so the cascades' soft penumbra and its
// colour survive under the band's edge; `celHardStyle` bands the cosine and the shadow together, the harder look in
// which a penumbra snaps to the band. Both keep the rim lights, the environment reflection and ambient occlusion.

import "shading"
function celMaterial(base, style, combined = 0) = base with {
  toon: style
  shade: cel(style.threshold, style.softness, style.shadowTint, style.specularSize, style.exposure, style.shoulder, combined)
}
let celStyle = {
  threshold: 0.45
  softness: 0.08
  shadowTint [0.38, 0.48, 0.65]
  outlineWidth: 1.5
  outlineDistance: 12
  outlineNormal: 0.65
  outlineTint [0.08, 0.1, 0.16]
  specularSize: 0.025
  exposure: 0.5
  shoulder: 0.65
  band: Visibility
}

let celHardStyle = {
  threshold: 0.5
  softness: 0.02
  shadowTint [0.32, 0.4, 0.58]
  outlineWidth: 2
  outlineDistance: 12
  outlineNormal: 0.65
  outlineTint [0.06, 0.07, 0.12]
  specularSize: 0.02
  exposure: 0.5
  shoulder: 0.65
  band: Combined
}

let continuousStyle = { enabled: false }
