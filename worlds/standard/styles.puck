// The standard's cel styles, a library. A style is the `cel` shade program's values (shading.puck) and an ink (ink.puck)
// laid over the band. `celMaterial` writes both onto a palette row, so the row bands and inks while its neighbours keep
// theirs:
//
//   import "../standard/styles"
//   palette [celMaterial({ color: "#C9A27E", wrap: 0.35 }, celStyle)]
//
// `celHatched` is the same with the ink's strokes in the shade, for the rows a place wants hatched, and `celPaint` the
// band alone, for a row a painter would leave unlined (a cliff, a glacier). Each marks its row styled, which is all the
// engine keeps of a style: the live `world.toon off` shades every styled row continuously and uninked.
//
// `celLook` is `celMaterial` as a case of a palette row's `toonSelect`, which swaps a slot's look live by a state
// cell; `plainLook` is the continuous case. A world that wants every material styled names the program as its
// `render.shade` and turns its `render.toon` on.
//
// `celStyle` bands each light's cosine and multiplies the shadow after the band, so the cascades' soft penumbra and its
// colour survive under the band's edge; `celHardStyle` bands the cosine and the shadow together (`combined`), the
// harder look in which a penumbra snaps to the band. Both keep the rim lights, the environment reflection and ambient
// occlusion. Both paint their shade: `restore` gives each light's shade side a share of it back and `bleed` keeps only
// some of the bounce's hue, so a shade reads as a held mauve a step below the lit paint rather than whatever the lawn
// bounces. Neither tones its light: the view's display pass (`render.tone`) does, once.

import "shading"
import "ink"
// The row's own program, if it has one, runs first and cel lights what it wrote: a weathered or terrain row keeps its
// surface under the band.
function celPaint(base, style) = base with {
  toon: styledMark
  shade [base.shade, cel(
      style.threshold,
      style.softness,
      style.shadowTint,
      style.specularSize,
      combined: style.combined,
      restore: style.restore,
      bleed: style.bleed,
      form: style.form
    )
  ]
}
function celMaterial(base, style) = inked(celPaint(base, style), style.ink)
function celHatched(base, style) = hatched(celPaint(base, style), style.ink)
function celLook(style) = celMaterial({}, style)

let styledMark = { enabled: true }

let celStyle = {
  threshold: 0.2
  softness: 0.08
  shadowTint [0.72, 0.6, 0.8]
  specularSize: 0.025
  combined: 0
  restore: 0.6
  bleed: 0.3
  form: 0.35
  ink: standardInk
}

let celHardStyle = {
  threshold: 0.3
  softness: 0.02
  shadowTint [0.6, 0.5, 0.72]
  specularSize: 0.02
  combined: 1
  restore: 0.5
  bleed: 0.2
  form: 0
  ink: boldInk
}

let continuousStyle = { enabled: false }
let plainLook = { toon: continuousStyle }
