// Reusable water scenery, a library: it emits no document, and a world places what its templates expand to. The look is
// the caller's: every colour, size and rate is a parameter, and the defaults are a plain turquoise and white. What moves
// is bound to the gauges `hydrology.puck` writes, or to the clock, so the scenery shows the cycle and carries none of it.
//
// A creation is authored in its own frame, whose +Z is the way the placement's yaw points the other way round: a
// placement of yaw (bearing + 180) points the author +Z at compass `bearing` (0 is world +Z, 90 is world +X), as the
// terrain library's sectors do. A stream segment's +Z is its flow, and a falls or glacier shares its wall's sector frame,
// where +Z points out from the ring's centre and a wall faces -Z.

// The standard's water is glass with a medium: its colour is the tint the light behind takes on through `depth`, its
// `scatter` the turquoise a deep body shows under the light arriving at its surface, filling 1 - exp(-scattering * d) of
// what a depth d shows, so a shallow margin stays clear and the deep water turns turquoise; its `contact` gathers foam,
// in its flow's pattern and colour, where the bed or a wall comes within `reach` of the surface along the view. The pool,
// the basins and the lake hold metres of water; the stream and the falls are thin sheets and scatter more per metre.
let waterGlass = {
  depth: 4
  ior: 1.333
  scatter: "#1A8A94"
  scattering: 0.35
  contact { reach: 0.4, coverage: 0.6 }
}
// The white the water's foam and streaks reveal.
let waterFoam = { color: "#F4F8F6", roughness: 0.55, metal: 0 }
// Still water's flow: a slow world-space drift that ripples the surface faintly and carries the contact's foam; it adds no
// foam of its own.
let stillFlowLayer = {
  frame: World
  velocity [0.15, 0, 0.1]
  scale: 1.2
  stretch: 1.5
  cycle: 3
  tilt: 0.06
  softness: 0.1
  surface: waterFoam
  seed: 9
}
// The standard's surface material, shared with field rows through the ordinary palette vocabulary.
let waterMaterial = {
  color: "#3FB8C4"
  roughness: 0.16
  specular: 0.5
  coat: 0.3
  glass: waterGlass
  flow: stillFlowLayer
}

// A spatial view of a scalar store. The authoritative store remains the caller's row; these cells supply the
// ordinary surface and medium queries at the place where visitors meet it. The drawn surface follows the full value as
// it drifts with the cycle, with no rebake, and bodies float on it. A view's `material` is its surface's look
// (`waterMaterial`, or a stream's `streamMaterial`).
template waterViews(views) {
  state {
    lattices: map(views, view => field(
      name: view.name,
      origin: [view.hole[0], view.floorY, view.hole[1]],
      cellSize: view.cell,
      width: floor((view.hole[2] - view.hole[0]) / view.cell),
      depth: floor((view.hole[3] - view.hole[1]) / view.cell),
      layers: 1,
      stepEveryTicks: 8,
      reactions: [
        transform(
          when: [{ field: view.rowName, comparison: GreaterOrEqual, value: 0 }],
          then: [{ field: view.rowName, op: Set, value { row: view.gauge } }]
        )
      ]
    ))
    world {
      for view in views {
        row {
          name: view.rowName
          kind: "Fixed"
          domain: cellsOf(topology: view.name)
          field {
            initial: view.initial
            min: 0
            max: view.maximumDepth
            heightScale: view.heightScale
            material: view.material
            medium {}
          }
        }
      }
    }
  }
}

// A turn about X by the angle whose cosine is `c` is the quaternion [±halfTurnSine(c), 0, 0, halfTurnCosine(c)], the sign
// that of the angle's sine: half-angle identities, since the expression vocabulary has no inverse trigonometry.
function halfTurnSine(c) = squareRoot((1 - c) / 2)
function halfTurnCosine(c) = squareRoot((1 + c) / 2)
// The cosine of the slope of a falls profile's j'th piece, the angle its length makes with the +Z axis.
function fallsSlope(profile, j) = (profile[j][0] - profile[j + 1][0]) / squareRoot(
  (profile[j + 1][1] - profile[j][1]) * (profile[j + 1][1] - profile[j][1]) +
    (profile[j + 1][0] - profile[j][0]) * (profile[j + 1][0] - profile[j][0])
)

// The standard turquoise of a falls and a lake, as a palette row. The water is glass, its medium the template's (`glass`).
let waterPalette = [
  { color: "#2FB5C0", roughness: 0.18, specular: 0.55, glass: waterGlass }
]
// The standard's flows, as palette `flow` layers: the water's shading moves while its geometry stands still. One cycle's
// travel stays under a third of a pattern feature along the flow (stretch / scale). A stream's `velocity` is the caller's,
// in world space for a surface that is not a creation's own.
let streamFlowLayer = {
  frame: World
  velocity [0, 0, -1.2]
  scale: 0.6
  stretch: 4
  cycle: 2
  tilt: 0.25
  coverage: 0.2
  softness: 0.08
  surface: waterFoam
  seed: 7
}
// A stream runs under a metre deep over its bed: its water scatters more per metre than a pool's, so a shallow reach stays
// clear over the stones and the deep turns turquoise, and its contact reaches less than its depth, so foam gathers along the
// banks and round the stones, not over the whole bed.
let streamGlass = waterGlass with { scattering: 0.9, contact { reach: 0.25, coverage: 0.7 } }
// The stream's surface material: the standard's water wearing the stream's glass and flow.
let streamMaterial = waterMaterial with { glass: streamGlass, flow: streamFlowLayer }
// A falls runs down every sheet at the sheet's own slope: only the velocity's part along a surface moves it. Its velocity
// and pattern are in world space, so the flow runs down a sheet however the sheet turns. A world that binds a render lane
// to its discharge thins the foam with it (`coverageLane`, a world lane from 4 to 7: `fallsFlowLayer with { coverageLane:
// 4 }` under `render { lanes ["state.fallsFlow"] }`).
let fallsFlowLayer = {
  frame: World
  velocity [0, -4, 0]
  scale: 0.5
  stretch: 6
  cycle: 1
  tilt: 0.3
  coverage: 0.35
  softness: 0.12
  surface { color: "#FFFFFF", roughness: 0.6, metal: 0 }
  seed: 11
}
// A falls sheet is thin and stands off its wall, so the rock shows through its turquoise core; foam gathers where it meets
// the basin.
let fallsGlass = waterGlass with { scattering: 0.8 }
// A lake's breeze: world-space ripples, a slow drift and no foam of its own; its contact's foam takes the breeze's
// pattern along the bank.
let lakeFlowLayer = {
  velocity [0.3, 0, 0.2]
  scale: 0.8
  stretch: 1.5
  cycle: 3
  tilt: 0.12
  frame: World
  surface: waterFoam
  seed: 5
}
// A lake disc is a slab over its bowl, so it scatters more per metre, and its contact reaches less than its thickness.
let lakeGlass = waterGlass with { scattering: 3, contact { reach: 0.2, coverage: 0.7 } }
// Glacier ice: a pale blue body and a whiter weathered face.
let icePalette = [
  { color: "#CFE8F2", roughness: 0.3, specular: 0.4, wrap: 0.3 }
  { color: "#EEF6FA", roughness: 0.5, specular: 0.2, wrap: 0.4 }
]
// Stone for a bridge and its banks.
let stonePalette = [
  { color: "#CDBF9F", roughness: 0.92, specular: 0.02 }
  { color: "#B3A482", roughness: 0.92, specular: 0.02 }
]

// The length of a line from `a` to `b`, points [x, z].
function channelLength(a, b) = squareRoot((b[0] - a[0]) * (b[0] - a[0]) + (b[1] - a[1]) * (b[1] - a[1]))
// The cosine of the bearing of the line from `a` to `b`, taken eastward (the line is the same either way): the bearing
// in [0, 180] whose half-turn about +Y orients a shape's +Z along the line.
function channelCosine(a, b) = ((b[0] < a[0]) ? -1 : 1) * (b[1] - a[1]) / channelLength(a, b)

// The half width of a channel's cutter at its top, `reach` over the ground's top: the profile widens from `bedHalf` at the
// bed to `bankHalf` at the ground, and the cutter runs on past the ground at the same slope.
function channelTopHalf(top, bed, reach, bedHalf, bankHalf) = bedHalf +
  (bankHalf - bedHalf) * (top + reach - bed) / (top - bed)

// A patch of ground with a river's channel cut in it: the ground between `region` ([minX, minZ, maxX, maxZ] in world X/Z,
// the floor opening that holds it), `depth` thick under its top at `top`, and one authored channel profile cut along the
// course `points` (world X/Z vertices): a flat bed `bedHalf` out from the course at `bed`, banks rising to `bankHalf` at the
// ground's top (a trapezoid, so a bank is a slope and the profile never changes along the course). Each leg is one cutter, and
// its ends run on by `join` so adjacent legs meet at a bend with no notch. `stones` are rows { position [x, y, z], radii,
// yaw (degrees) } on the bed and banks. The ground wears `ground` (a palette row), the cut surface the bed and bank
// material, the stones theirs. Every shape is a union or a subtraction of admitted primitives, so the channel collides as it
// is drawn, and the author frame's half turn makes each world position the negated one. The water is the caller's: a
// `waterViews` field over the region, its datum the bed.
template riverChannel(id, region, points, ground, top = 0, bed = -0.9, bedHalf = 1.8, bankHalf = 3, depth = 1.5, reach = 0.4, join = 0.5, stones = [], palette = stonePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: concat([ground], palette)
      shape Box "ground" {
        material: 0
        position [0 - (region[0] + region[2]) / 2, top - depth, 0 - (region[1] + region[3]) / 2]
        scale [(region[2] - region[0]) / 2, depth, (region[3] - region[1]) / 2]
      }
      for i in range(0, length(points) - 1) {
        shape Prism $"cut-{i}" {
          blend: Subtraction
          material: 2
          position [
            0 - (points[i][0] + points[i + 1][0]) / 2,
            (bed + top + reach) / 2,
            0 - (points[i][1] + points[i + 1][1]) / 2
          ]
          scale [
            channelTopHalf(top, bed, reach, bedHalf, bankHalf),
            (top + reach - bed) / 2,
            channelLength(points[i], points[i + 1]) / 2 + join
          ]
          taper: bedHalf / channelTopHalf(top, bed, reach, bedHalf, bankHalf)
          rotation [
            halfTurnSine(channelCosine(points[i], points[i + 1]))
            0
            halfTurnCosine(channelCosine(points[i], points[i + 1]))
            0
          ]
        }
      }
      for (stone, i) in stones {
        shape Ellipsoid $"stone-{i}" {
          material: 1
          position [0 - stone.position[0], stone.position[1], 0 - stone.position[2]]
          scale: stone.radii
          rotation [0, sine(stone.yaw * 0.008726646259971648), 0, cosine(stone.yaw * 0.008726646259971648)]
        }
      }
    }
  }
}
// A falls is a ribbon of sheets down the wall's profile, its shading falling down each sheet (`flow`). Each sheet turns
// about its own flow axis as the discharge `state.<gauge>` falls from one to zero, edge-on to the valley at zero, so the
// falls narrows as it ebbs; the flow's foam thins with it where the world binds the flow's coverage to a lane. The
// endpoint visibility `state.<visible>` (one or zero) parks the edge-on ribbon when the falls runs dry; both gauges are the
// chain's own, never the clock. The sheets are glass (`glass`):
// the rock shows through them, and as glass they cast no shadow. A sheet's `thickness` is what a view along the wall
// crosses many times over, so a thick sheet's medium covers the rock behind it.
template fallsRibbon(id, profile, width = 8, standoff = 5, thickness = 0.2, gauge = "fallsFlow", visible = "fallsVisible", palette = waterPalette, flow = fallsFlowLayer, glass = fallsGlass) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [palette[0] with { flow: flow, glass: glass }]
      sizeBy: "visible"
      drivers [
        { name: "fold", signal: $"state.{gauge}", cadence: -1, blendInSeconds: 0, blendOutSeconds: 0 }
        { name: "visible", signal: $"state.{visible}", cadence: 1, blendInSeconds: 0, blendOutSeconds: 0 }
      ]
      for j in range(0, length(profile) - 1) {
        shape Box $"sheet-{j}" {
          material: 0
          position [0, (profile[j][1] + profile[j + 1][1]) / 2, (profile[j][0] + profile[j + 1][0]) / 2 - standoff]
          scale [width / 2, thickness / 2, squareRoot(
              (profile[j + 1][1] - profile[j][1]) * (profile[j + 1][1] - profile[j][1]) +
                (profile[j + 1][0] - profile[j][0]) * (profile[j + 1][0] - profile[j][0])
            ) / 2
          ]
          rotation [0 - halfTurnSine(fallsSlope(profile, j)), 0, 0, halfTurnCosine(fallsSlope(profile, j))]
          swings [
            {
              driver: "fold"
              pivot [0, (profile[j][1] + profile[j + 1][1]) / 2, (profile[j][0] + profile[j + 1][0]) / 2 - standoff]
              axis [0, profile[j][1] - profile[j + 1][1], profile[j][0] - profile[j + 1][0]]
              amplitude: 1.5707963267948966
              phase: 1
              wave: "linear"
            }
          ]
        }
      }
    }
  }
}
// Ice shrinks uniformly about the authored origin; its driver reads the same linear fraction that sets melt volume.
// Zero parks the creation through the ordinary presentation path, leaving no crowns above the cradle.
template glacierMass(id, lumps, gauge = "glacierLength", origin = [0, 0, 0], palette = icePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      sizeBy: "melt"
      drivers [
        { name: "melt", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0, blendOutSeconds: 0 }
      ]
      for (lump, i) in lumps {
        shape Superellipsoid $"ice-{i}" {
          material: i % 2
          exponent: 2.4
          position [lump.position[0] - origin[0], lump.position[1] - origin[1], lump.position[2] - origin[2]]
          scale: lump.radii
          group: 1
        }
      }
    }
  }
}

// A lake's surface: a flat turquoise disc of `radius` that rises and falls with the gauge `state.<gauge>` by `rise` metres
// a unit above `rest`, the gauge's value at the lake's outlet, its shading rippled by `flow`.
template lakeSurface(id, radius, gauge = "lakeLevel", rest = 0.4, rise = 4, palette = waterPalette, flow = lakeFlowLayer, glass = lakeGlass) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [palette[0] with { flow: flow, glass: glass }]
      drivers [
        { name: "level", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0 }
      ]
      shape Cylinder "surface" {
        material: 0
        position [0, 0, 0]
        scale [radius, 0.12, radius]
        slides [
          { driver: "level", axis [0, 1, 0], amplitude: rise, phase: 0 - rest, wave: "linear" }
        ]
      }
    }
  }
}

// A float gauge for a store that the gauge `state.<gauge>` reads from zero to one: a teal guide post `height` tall with a
// pale tick every `tick` metres up its face, and an orange float that rides the post from its foot to its top as the gauge
// rises, so the store's fill is read off the bank. `height` is at most 4, the longest a slide runs.
template floatGauge(id, height = 3, tick = 0.5, gauge = "aquiferFill", palette = gaugePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      drivers [
        { name: "fill", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0 }
      ]
      shape Box "post" {
        material: 0
        position [0, height / 2, 0]
        scale [0.09, height / 2, 0.09]
      }
      for k in range(0, floor(height / tick) + 1) {
        shape Box $"tick-{k}" {
          material: 1
          position [0, k * tick + 0.04, -0.1]
          scale [0.2, 0.04, 0.015]
        }
      }
      shape Box "float" {
        material: 2
        position [0, 0.12, -0.16]
        scale [0.2, 0.12, 0.07]
        slides [
          { driver: "fill", axis [0, 1, 0], amplitude: height, phase: 0, wave: "linear" }
        ]
      }
    }
  }
}
// The gauge's teal post, pale ticks and orange float.
let gaugePalette = [
  { color: "#2E6F73", roughness: 0.6, specular: 0.1 }
  { color: "#EAE3CF", roughness: 0.8, specular: 0.02 }
  { color: "#E8832A", roughness: 0.5, specular: 0.15 }
]

// Spray is an ordinary cloud volume. The same state driver scales its support and hides it when discharge is zero.
template impactSpray(id, gauge = "fallsFlow", extent = [7, 4, 5]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      sizeBy: "discharge"
      drivers [
        { name: "discharge", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0, blendOutSeconds: 0 }
      ]
      volumes [
        {
          kind: "cloud"
          position [0, 0, 0]
          rotation [0, 0, 0, 1]
          halfExtent: extent
          width: 1.2
          speed: 0.8
          intensity: 300
          scatter: 0.9
          extinction: 0.55
          coverage: 0.55
          softness: 0.45
          ramp [
            { density: 0, color: "#FFFFFF" }
            { density: 1, color: "#D9EEF0" }
          ]
        }
      ]
    }
  }
}

// An open observation pavilion: a cream canopy, teal frame and orange shade over a reservoir cutaway.
// The chamber stays enclosed beneath a glazed inspection window in the dry terrace.
template reservoirPavilion(id, half = [5, 6], palette = gaugePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: concat(palette, [{ color: "#E9F5F4", roughness: 0.04, specular: 0.5, glass { depth: 8, ior: 1.5 } }])
      shape Box "observation-window" {
        material: length(palette)
        position [0, -0.15, 0]
        scale [half[0] - 1, 0.15, half[1] - 1]
      }
      for side in [-1, 1] {
        shape Box $"chamber-roof-side-{side}" {
          material: 1
          position [side * (half[0] - 0.5), -0.15, 0]
          scale [0.5, 0.15, half[1]]
        }
        shape Box $"chamber-roof-end-{side}" {
          material: 1
          position [0, -0.15, side * (half[1] - 0.5)]
          scale [half[0], 0.15, 0.5]
        }
      }
      for side in [-1, 1] {
        shape Box $"terrace-{side}" {
          material: 1
          position [side * (half[0] + 1), 0.1, 0]
          scale [1, 0.3, half[1] + 2]
        }
        for end in [-1, 1] {
          shape Box $"column-{side}-{end}" {
            material: 0
            position [side * (half[0] + 1), 2.2, end * (half[1] + 0.8)]
            scale [0.22, 2.2, 0.22]
          }
        }
        shape Box $"rail-{side}" {
          material: 0
          position [side * (half[0] + 1.8), 1.1, 0]
          scale [0.12, 0.12, half[1]]
        }
      }
      shape Box "canopy" {
        material: 1
        position [0, 4.5, 0]
        scale [half[0] + 2, 0.3, half[1] + 2]
        rounding: 0.25
      }
      shape Box "orange-awning" {
        material: 2
        position [0, 4.1, half[1] + 2]
        scale [half[0] + 1.5, 0.25, 0.7]
      }
      for i in range(0, 3) {
        shape Box $"entry-step-{i}" {
          material: 1
          position [half[0] + 1, 0.05 * i, half[1] + 2.5 - i * 0.5]
          scale [1, 0.05 * (i + 1), 0.6]
        }
      }
    }
  }
}

// A stone footbridge `length` long and `width` across over a stream, its deck `rise` above the ground on two ramps and
// two piers, with a low parapet each side. Its +Z runs along the bridge. Every shape is a union of boxes, so it collides as
// it is drawn.
template stoneBridge(id, length = 9, width = 3, rise = 1.1, ramp = 3, palette = stonePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      shape Box "deck" {
        material: 0
        position [0, rise - 0.2, 0]
        scale [width / 2, 0.2, length / 2]
      }
      for end in [-1, 1] {
        shape Box $"pier-{end}" {
          material: 1
          position [0, rise / 2 - 0.2, end * (length / 2 - 0.6)]
          scale [width / 2 - 0.2, rise / 2, 0.6]
        }
        shape Box $"ramp-{end}" {
          material: 0
          position [0, rise / 2 - 0.1, end * (length / 2 + ramp / 2 - 0.05)]
          scale [width / 2, 0.15, squareRoot(ramp * ramp + rise * rise) / 2]
          rotation [
            end * halfTurnSine(ramp / squareRoot(ramp * ramp + rise * rise)),
            0,
            0,
            halfTurnCosine(ramp / squareRoot(ramp * ramp + rise * rise))
          ]
        }
      }
      for side in [-1, 1] {
        shape Box $"parapet-{side}" {
          material: 1
          position [side * (width / 2 - 0.15), rise + 0.25, 0]
          scale [0.15, 0.25, length / 2]
        }
      }
    }
  }
}
template waterBasin(id, half, floorY = -2.4, rimY = -0.4, stepTops = [-1.2, -0.9, -0.6, -0.3], openings = []) {
  prototype $"{id}" {
    document {
      name: id
      schema: "puck.creation.v1"
      palette [
        { color: "#B9A78A", roughness: 0.92, specular: 0.02 }
        { color: "#A39075", roughness: 0.92, specular: 0.02 }
      ]
      shape Box "bed" {
        material: 0
        position [0, floorY - 0.15, 0]
        scale [half[0] + 0.15 * 2, 0.15, half[1] + 0.15 * 2]
      }
      shape Box "wall-east" {
        material: 1
        position [0 - (half[0] + 0.15), ((floorY - 0.3 + rimY) / 2), 0]
        scale [0.15, ((rimY - floorY + 0.3) / 2), half[1] + 0.15 * 2]
      }
      shape Box "wall-west" {
        material: 1
        position [half[0] + 0.15, ((floorY - 0.3 + rimY) / 2), 0]
        scale [0.15, ((rimY - floorY + 0.3) / 2), half[1] + 0.15 * 2]
      }
      shape Box "wall-south" {
        material: 1
        position [0, ((floorY - 0.3 + rimY) / 2), half[1] + 0.15]
        scale [half[0] + 0.15 * 2, ((rimY - floorY + 0.3) / 2), 0.15]
      }
      shape Box "wall-north" {
        material: 1
        position [0, ((floorY - 0.3 + rimY) / 2), 0 - (half[1] + 0.15)]
        scale [half[0] + 0.15 * 2, ((rimY - floorY + 0.3) / 2), 0.15]
      }
      for (opening, i) in openings {
        shape Box $"passage-{i}" {
          material: 1
          blend: "Subtraction"
          position: opening.position
          scale: opening.half
        }
      }
      for (top, i) in stepTops {
        shape Box $"step-{i}" {
          material: 0
          position [
            0 - (half[0] - (0.8 * (length(stepTops) - i)) / 2),
            (top + floorY) / 2,
            0
          ]
          scale [(0.8 * (length(stepTops) - i)) / 2, (top - floorY) / 2, 2]
        }
      }
    }
  }
}
