// Reusable water scenery, a library: it emits no document, and a world places what its templates expand to. The look is
// the caller's: every colour, size and rate is a parameter, and the defaults are a plain turquoise and white. What moves
// is bound to the gauges `hydrology.puck` writes, or to the clock, so the scenery shows the cycle and carries none of it.
//
// A creation is authored in its own frame, whose +Z is the way the placement's yaw points the other way round: a
// placement of yaw (bearing + 180) points the author +Z at compass `bearing` (0 is world +Z, 90 is world +X), as the
// terrain library's sectors do. A stream segment's +Z is its flow, and a falls or glacier shares its wall's sector frame,
// where +Z points out from the ring's centre and a wall faces -Z.

// The standard's surface material, shared with field rows through the ordinary palette vocabulary.
let waterMaterial = {
  color: "#3FB8C4"
  roughness: 0.16
  specular: 0.5
  coat: 0.3
  glass { depth: 2, ior: 1.333 }
}

// A spatial view of a scalar store. The authoritative store remains the caller's row; these cells supply the
// ordinary surface and medium queries at the place where visitors meet it. The drawn surface moves in steps of
// `surfaceStep` metres, so a level that drifts with the cycle rebakes its surface once a step; bodies float on the full
// value.
template waterViews(views, surfaceStep = 0.02) {
  state {
    lattices: map(views, view => field(
        name: view.name, origin: [view.hole[0], view.floorY, view.hole[1]], cellSize: view.cell,
        width: floor((view.hole[2] - view.hole[0]) / view.cell), depth: floor((view.hole[3] - view.hole[1]) / view.cell),
        layers: 1, stepEveryTicks: 8,
        reactions: [
          transform(
            when: [{ field: view.rowName, comparison: GreaterOrEqual, value: 0 }],
            then: [{ field: view.rowName, op: Set, value { row: view.gauge } }]
          )
        ]
      ))
    world {
      for view in views { row {
        name: view.rowName
        kind: "Fixed"
        domain: cellsOf(topology: view.name)
        field {
          initial: view.initial
          min: 0
          max: view.maximumDepth
          heightScale: view.heightScale
          surfaceStep: surfaceStep
          material: waterMaterial
          medium {}
        }
      } }
    }
  }
}

// A turn about X by the angle whose cosine is `c` is the quaternion [±halfTurnSine(c), 0, 0, halfTurnCosine(c)], the sign
// that of the angle's sine: half-angle identities, since the expression vocabulary has no inverse trigonometry.
function halfTurnSine(c) = squareRoot((1 - c) / 2)
function halfTurnCosine(c) = squareRoot((1 + c) / 2)
// The cosine of the slope of a falls profile's j'th piece, the angle its length makes with the +Z axis.
function fallsSlope(profile, j) = (profile[j][0] - profile[j + 1][0]) / squareRoot(
  (profile[j + 1][1] - profile[j][1]) * (profile[j + 1][1] - profile[j][1]) +
    (profile[j + 1][0] - profile[j][0]) * (profile[j + 1][0] - profile[j][0])
)

// The standard turquoise and white of a stream, a lake and a falls, as palette rows: the water, its brush edge and its foam.
let waterPalette = [
  { color: "#2FB5C0", roughness: 0.18, specular: 0.55, wrap: 0.2 }
  { color: "#F4F8F6", roughness: 0.55, specular: 0.1, wrap: 0.45 }
  { color: "#FFFFFF", roughness: 0.6, specular: 0.05, wrap: 0.5 }
]
// The standard's flows, as palette `flow` layers: the water's shading moves while its geometry stands still. A velocity is
// in the creation's engine frame (the author frame's x and z negated), so a stream whose author +Z is its flow runs
// along -Z. One cycle's travel stays under a third of a pattern feature along the flow (stretch / scale).
let streamFlowLayer = {
  velocity [0, 0, -1.2]
  scale: 0.6
  stretch: 4
  cycle: 2
  tilt: 0.25
  coverage: 0.2
  softness: 0.08
  surface { color: "#F4F8F6", roughness: 0.55, metal: 0 }
  seed: 7
}
// A falls runs down every sheet at the sheet's own slope: only the velocity's part along a surface moves it.
let fallsFlowLayer = {
  velocity [0, -4, 0]
  scale: 0.5
  stretch: 6
  cycle: 1
  tilt: 0.3
  coverage: 0.55
  softness: 0.12
  surface { color: "#FFFFFF", roughness: 0.6, metal: 0 }
  seed: 11
}
// A lake's breeze: world-space ripples, a slow drift and no foam.
let lakeFlowLayer = {
  velocity [0.3, 0, 0.2]
  scale: 0.8
  stretch: 1.5
  cycle: 3
  tilt: 0.12
  frame: World
  seed: 5
}
// Glacier ice: a pale blue body and a whiter weathered face.
let icePalette = [
  { color: "#CFE8F2", roughness: 0.3, specular: 0.4, wrap: 0.3 }
  { color: "#EEF6FA", roughness: 0.5, specular: 0.2, wrap: 0.4 }
]
// Stone for a bridge and its banks.
let stonePalette = [
  { color: "#CDBF9F", roughness: 0.92, specular: 0.02 }
  { color: "#B3A482", roughness: 0.92, specular: 0.02 }
]

// A stream segment is one still sheet `length` long whose shading flows along its author +Z (`flow`, a palette flow
// layer): the geometry never moves, so every segment of a stream is a placement of one prototype sharing one baked
// mesh. `overlap` extends each end past the segment's length so adjacent segments meet at a bend; a stream raises
// alternate segments by two centimetres so overlapping ends never share a plane.
template streamSegment(id, length, width = 4.5, overlap = 0.5, palette = waterPalette, flow = streamFlowLayer, top = 0.1) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [palette[0] with { flow: flow }]
      shape Box "sheet" {
        material: 0
        position [0, top - 0.3, 0]
        scale [width / 2, 0.3, length / 2 + overlap]
      }
    }
  }
}
// A falls is a ribbon of still sheets down the wall's profile, its shading falling down each sheet (`flow`). The caller
// supplies the endpoint visibility, which parks the ribbon when the falls runs dry.
template fallsRibbon(id, profile, width = 8, standoff = 5, visible = "meltVisible", palette = waterPalette, flow = fallsFlowLayer) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [palette[0] with { flow: flow }]
      sizeBy: "visible"
      drivers [
        { name: "visible", signal: $"state.{visible}", cadence: 1, blendInSeconds: 0, blendOutSeconds: 0 }
      ]
      for j in range(0, length(profile) - 1) {
        shape Box $"sheet-{j}" {
          material: 0
          position [0, (profile[j][1] + profile[j + 1][1]) / 2, (profile[j][0] + profile[j + 1][0]) / 2 - standoff]
          scale [width / 2, 0.3, squareRoot(
            (profile[j + 1][1] - profile[j][1]) * (profile[j + 1][1] - profile[j][1]) +
            (profile[j + 1][0] - profile[j][0]) * (profile[j + 1][0] - profile[j][0])) / 2]
          rotation [0 - halfTurnSine(fallsSlope(profile, j)), 0, 0, halfTurnCosine(fallsSlope(profile, j))]
        }
      }
    }
  }
}
// Ice shrinks uniformly about the authored origin; its driver reads the same linear fraction that sets melt volume.
// Zero parks the creation through the ordinary presentation path, leaving no crowns above the cradle.
template glacierMass(id, lumps, gauge = "glacierLength", origin = [0, 0, 0], palette = icePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      sizeBy: "melt"
      drivers [
        { name: "melt", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0, blendOutSeconds: 0 }
      ]
      for (lump, i) in lumps {
        shape Superellipsoid $"ice-{i}" {
          material: i % 2
          exponent: 2.4
          position [lump.position[0] - origin[0], lump.position[1] - origin[1], lump.position[2] - origin[2]]
          scale: lump.radii
          group: 1
        }
      }
    }
  }
}

// A lake's surface: a flat turquoise disc of `radius` that rises and falls with the gauge `state.<gauge>` by `rise` metres
// a unit above `rest`, the gauge's value at the lake's outlet, its shading rippled by `flow`.
template lakeSurface(id, radius, gauge = "lakeLevel", rest = 0.4, rise = 4, palette = waterPalette, flow = lakeFlowLayer) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette [palette[0] with { flow: flow }]
      drivers [
        { name: "level", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0 }
      ]
      shape Cylinder "surface" {
        material: 0
        position [0, 0, 0]
        scale [radius, 0.12, radius]
        slides [
          { driver: "level", axis [0, 1, 0], amplitude: rise, phase: 0 - rest, wave: "linear" }
        ]
      }
    }
  }
}

// A float gauge for a store that the gauge `state.<gauge>` reads from zero to one: a teal guide post `height` tall with a
// pale tick every `tick` metres up its face, and an orange float that rides the post from its foot to its top as the gauge
// rises, so the store's fill is read off the bank. `height` is at most 4, the longest a slide runs.
template floatGauge(id, height = 3, tick = 0.5, gauge = "aquiferFill", palette = gaugePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      drivers [
        { name: "fill", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0 }
      ]
      shape Box "post" {
        material: 0
        position [0, height / 2, 0]
        scale [0.09, height / 2, 0.09]
      }
      for k in range(0, floor(height / tick) + 1) {
        shape Box $"tick-{k}" {
          material: 1
          position [0, k * tick + 0.04, -0.1]
          scale [0.2, 0.04, 0.015]
        }
      }
      shape Box "float" {
        material: 2
        position [0, 0.12, -0.16]
        scale [0.2, 0.12, 0.07]
        slides [
          { driver: "fill", axis [0, 1, 0], amplitude: height, phase: 0, wave: "linear" }
        ]
      }
    }
  }
}
// The gauge's teal post, pale ticks and orange float.
let gaugePalette = [
  { color: "#2E6F73", roughness: 0.6, specular: 0.1 }
  { color: "#EAE3CF", roughness: 0.8, specular: 0.02 }
  { color: "#E8832A", roughness: 0.5, specular: 0.15 }
]

// Spray is an ordinary cloud volume. The same state driver scales its support and hides it when discharge is zero.
template impactSpray(id, gauge = "meltStrength", extent = [7, 4, 5]) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      sizeBy: "discharge"
      drivers [
        { name: "discharge", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0, blendOutSeconds: 0 }
      ]
      volumes [
        {
          kind: "cloud"
          position [0, 0, 0]
          rotation [0, 0, 0, 1]
          halfExtent: extent
          width: 1.2
          speed: 0.8
          intensity: 300
          scatter: 0.9
          extinction: 0.55
          coverage: 0.55
          softness: 0.45
          ramp [
            { density: 0, color: "#FFFFFF" }
            { density: 1, color: "#D9EEF0" }
          ]
        }
      ]
    }
  }
}

// An open observation pavilion: a cream canopy, teal frame and orange shade over a reservoir cutaway.
// The chamber stays enclosed beneath a glazed inspection window in the dry terrace.
template reservoirPavilion(id, half = [5, 6], palette = gaugePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: concat(palette, [{ color: "#E9F5F4", roughness: 0.04, specular: 0.5, glass { depth: 8, ior: 1.5 } }])
      shape Box "observation-window" {
        material: length(palette)
        position [0, -0.15, 0]
        scale [half[0] - 1, 0.15, half[1] - 1]
      }
      for side in [-1, 1] {
        shape Box $"chamber-roof-side-{side}" {
          material: 1
          position [side * (half[0] - 0.5), -0.15, 0]
          scale [0.5, 0.15, half[1]]
        }
        shape Box $"chamber-roof-end-{side}" {
          material: 1
          position [0, -0.15, side * (half[1] - 0.5)]
          scale [half[0], 0.15, 0.5]
        }
      }
      for side in [-1, 1] {
        shape Box $"terrace-{side}" {
          material: 1
          position [side * (half[0] + 1), 0.1, 0]
          scale [1, 0.3, half[1] + 2]
        }
        for end in [-1, 1] {
          shape Box $"column-{side}-{end}" {
            material: 0
            position [side * (half[0] + 1), 2.2, end * (half[1] + 0.8)]
            scale [0.22, 2.2, 0.22]
          }
        }
        shape Box $"rail-{side}" {
          material: 0
          position [side * (half[0] + 1.8), 1.1, 0]
          scale [0.12, 0.12, half[1]]
        }
      }
      shape Box "canopy" {
        material: 1
        position [0, 4.5, 0]
        scale [half[0] + 2, 0.3, half[1] + 2]
        rounding: 0.25
      }
      shape Box "orange-awning" {
        material: 2
        position [0, 4.1, half[1] + 2]
        scale [half[0] + 1.5, 0.25, 0.7]
      }
      for i in range(0, 3) {
        shape Box $"entry-step-{i}" {
          material: 1
          position [half[0] + 1, 0.05 * i, half[1] + 2.5 - i * 0.5]
          scale [1, 0.05 * (i + 1), 0.6]
        }
      }
    }
  }
}

// A stone footbridge `length` long and `width` across over a stream, its deck `rise` above the ground on two ramps and
// two piers, with a low parapet each side. Its +Z runs along the bridge. Every shape is a union of boxes, so it collides as
// it is drawn.
template stoneBridge(id, length = 9, width = 3, rise = 1.1, ramp = 3, palette = stonePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      shape Box "deck" {
        material: 0
        position [0, rise - 0.2, 0]
        scale [width / 2, 0.2, length / 2]
      }
      for end in [-1, 1] {
        shape Box $"pier-{end}" {
          material: 1
          position [0, rise / 2 - 0.2, end * (length / 2 - 0.6)]
          scale [width / 2 - 0.2, rise / 2, 0.6]
        }
        shape Box $"ramp-{end}" {
          material: 0
          position [0, rise / 2 - 0.1, end * (length / 2 + ramp / 2 - 0.05)]
          scale [width / 2, 0.15, squareRoot(ramp * ramp + rise * rise) / 2]
          rotation [
            end * halfTurnSine(ramp / squareRoot(ramp * ramp + rise * rise)),
            0,
            0,
            halfTurnCosine(ramp / squareRoot(ramp * ramp + rise * rise))
          ]
        }
      }
      for side in [-1, 1] {
        shape Box $"parapet-{side}" {
          material: 1
          position [side * (width / 2 - 0.15), rise + 0.25, 0]
          scale [0.15, 0.25, length / 2]
        }
      }
    }
  }
}
template waterBasin(id, half, floorY = -2.4, rimY = -0.4, stepTops = [-1.2, -0.9, -0.6, -0.3], openings = []) {
  prototype $"{id}" {
    document {
      name: id
      schema: "puck.creation.v1"
      palette [
        { color: "#B9A78A", roughness: 0.92, specular: 0.02 }
        { color: "#A39075", roughness: 0.92, specular: 0.02 }
      ]
      shape Box "bed" {
        material: 0
        position [0, floorY - 0.15, 0]
        scale [half[0] + 0.15 * 2, 0.15, half[1] + 0.15 * 2]
      }
      shape Box "wall-east" {
        material: 1
        position [0 - (half[0] + 0.15), ((floorY - 0.3 + rimY) / 2), 0]
        scale [0.15, ((rimY - floorY + 0.3) / 2), half[1] + 0.15 * 2]
      }
      shape Box "wall-west" {
        material: 1
        position [half[0] + 0.15, ((floorY - 0.3 + rimY) / 2), 0]
        scale [0.15, ((rimY - floorY + 0.3) / 2), half[1] + 0.15 * 2]
      }
      shape Box "wall-south" {
        material: 1
        position [0, ((floorY - 0.3 + rimY) / 2), half[1] + 0.15]
        scale [half[0] + 0.15 * 2, ((rimY - floorY + 0.3) / 2), 0.15]
      }
      shape Box "wall-north" {
        material: 1
        position [0, ((floorY - 0.3 + rimY) / 2), 0 - (half[1] + 0.15)]
        scale [half[0] + 0.15 * 2, ((rimY - floorY + 0.3) / 2), 0.15]
      }
      for (opening, i) in openings {
        shape Box $"passage-{i}" {
          material: 1
          blend: "Subtraction"
          position: opening.position
          scale: opening.half
        }
      }
      for (top, i) in stepTops {
        shape Box $"step-{i}" {
          material: 0
          position [
            0 - (half[0] - (0.8 * (length(stepTops) - i)) / 2),
            (top + floorY) / 2,
            0
          ]
          scale [(0.8 * (length(stepTops) - i)) / 2, (top - floorY) / 2, 2]
        }
      }
    }
  }
}
