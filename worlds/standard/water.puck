// Reusable water scenery, a library: it emits no document, and a world places what its templates expand to. The look is
// the caller's: every colour, size and rate is a parameter, and the defaults are a plain turquoise and white. What moves
// is bound to the gauges `hydrology.puck` writes, or to the clock, so the scenery shows the cycle and carries none of it.
//
// A creation is authored in its own frame, whose +Z is the way the placement's yaw points the other way round: a
// placement of yaw (bearing + 180) points the author +Z at compass `bearing` (0 is world +Z, 90 is world +X), as the
// terrain library's sectors do. A stream segment's +Z is its flow, and a falls or glacier shares its wall's sector frame,
// where +Z points out from the ring's centre and a wall faces -Z.

// The standard's surface material, shared with field rows through the ordinary palette vocabulary.
let waterMaterial = {
  color: "#3FB8C4"
  roughness: 0.16
  specular: 0.5
  coat: 0.3
  glass { depth: 2, ior: 1.333 }
}

// A turn about X by the angle whose cosine is `c` is the quaternion [±halfTurnSine(c), 0, 0, halfTurnCosine(c)], the sign
// that of the angle's sine: half-angle identities, since the expression vocabulary has no inverse trigonometry.
function halfTurnSine(c) = squareRoot((1 - c) / 2)
function halfTurnCosine(c) = squareRoot((1 + c) / 2)
// The cosine of the slope of a falls profile's j'th piece, the angle its length makes with the +Z axis.
function fallsSlope(profile, j) = (profile[j][0] - profile[j + 1][0]) / squareRoot(
  (profile[j + 1][1] - profile[j][1]) * (profile[j + 1][1] - profile[j][1]) +
    (profile[j + 1][0] - profile[j][0]) * (profile[j + 1][0] - profile[j][0])
)

// The standard turquoise and white of a stream, a lake and a falls, as palette rows: the water, its brush edge and its foam.
let waterPalette = [
  { color: "#2FB5C0", roughness: 0.18, specular: 0.55, wrap: 0.2 }
  { color: "#F4F8F6", roughness: 0.55, specular: 0.1, wrap: 0.45 }
  { color: "#FFFFFF", roughness: 0.6, specular: 0.05, wrap: 0.5 }
]
// Glacier ice: a pale blue body and a whiter weathered face.
let icePalette = [
  { color: "#CFE8F2", roughness: 0.3, specular: 0.4, wrap: 0.3 }
  { color: "#EEF6FA", roughness: 0.5, specular: 0.2, wrap: 0.4 }
]
// Stone for a bridge and its banks.
let stonePalette = [
  { color: "#CDBF9F", roughness: 0.92, specular: 0.02 }
  { color: "#B3A482", roughness: 0.92, specular: 0.02 }
]

// A stretch of stream, `length` metres long (a whole number of ripple spacings) and `width` wide, flowing toward the
// creation's +Z. A flat turquoise sheet with a white brush edge each side and bars of foam that pulse downstream: each
// bar is a half sine of the clock, and its phase is its distance along the whole stream (`arc` is where this stretch
// starts, in metres), so the pulses run on unbroken across stretches that are separate creations.
template streamSegment(id, length, width = 4.5, arc = 0, spacing = 2, cadence = 0.4, palette = waterPalette, top = 0.1) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      drivers [
        { name: "flow", signal: "time", cadence: cadence, blendInSeconds: 0 }
      ]
      shape Box "sheet" {
        material: 0
        position [0, top - 0.045, 0]
        scale [width / 2, 0.045, length / 2]
      }
      for side in [-1, 1] {
        shape Box $"brush-{side}" {
          material: 1
          position [side * (width / 2 - 0.2), top - 0.01, 0]
          scale [0.2, 0.05, length / 2]
        }
      }
      for k in range(0, floor(length / spacing)) {
        shape Box $"pulse-{k}" {
          material: 2
          position [0, top + 0.012, (k + 0.5) * spacing - length / 2]
          scale [width / 2 - 0.6, 0.014, 0.07]
          slides [
            {
              driver: "flow"
              axis [0, 0, 1]
              amplitude: spacing * 0.9
              phase: 0 - (arc + k * spacing) * 6.283185307179586 / (spacing * 4)
              wave: "halfSine"
            }
          ]
        }
      }
    }
  }
}

// A falls: a ribbon of `width` laid along a wall's profile, a list of [r, y] points from its top to its foot in the
// wall's sector frame (the ribbon stands `standoff` metres in front of the wall so the relief never buries it), with
// streaks of foam sliding down it. It is the child of an anchor at its top that swings it into the wall as the flow
// `state.<gauge>` falls from `flowFull` to zero, so a dry falls is a ribbon folded back into the rock.
template fallsRibbon(id, profile, width = 8, standoff = 5, gauge = "fallsFlow", flowFull = 0.6, foldRadians = 0.12, streaks = 3, palette = waterPalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      drivers [
        { name: "flow", signal: "time", cadence: 0.5, blendInSeconds: 0 }
        { name: "fold", signal: $"state.{gauge}", cadence: 0 - 1 / flowFull, blendInSeconds: 0 }
      ]
      shape Sphere "anchor" {
        material: 1
        position [0, profile[0][1], profile[0][0] - standoff]
        scale [0.3, 0.3, 0.3]
        swings [
          {
            driver: "fold"
            pivot [0, profile[0][1], profile[0][0] - standoff]
            axis [1, 0, 0]
            amplitude: foldRadians
            phase: 1
            wave: "linear"
          }
        ]
      }
      for j in range(0, length(profile) - 1) {
        shape Box $"sheet-{j}" {
          parent: "anchor"
          material: j % 2 == 0 ? 1 : 2
          position [
            0,
            (profile[j][1] + profile[j + 1][1]) / 2,
            (profile[j][0] + profile[j + 1][0]) / 2 - standoff
          ]
          scale [
            width / 2,
            0.3,
            squareRoot(
              (profile[j + 1][1] - profile[j][1]) * (profile[j + 1][1] - profile[j][1]) +
                (profile[j + 1][0] - profile[j][0]) * (profile[j + 1][0] - profile[j][0])
            ) / 2
          ]
          rotation [
            0 - halfTurnSine(fallsSlope(profile, j)),
            0,
            0,
            halfTurnCosine(fallsSlope(profile, j))
          ]
        }
      }
    }
  }
}

// Ice shrinks uniformly about the authored origin; its driver reads the same linear fraction that sets melt volume.
// Zero parks the creation through the ordinary presentation path, leaving no crowns above the cradle.
template glacierMass(id, lumps, gauge = "glacierLength", origin = [0, 0, 0], palette = icePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      sizeBy: "melt"
      drivers [
        { name: "melt", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0, blendOutSeconds: 0 }
      ]
      for (lump, i) in lumps {
        shape Superellipsoid $"ice-{i}" {
          material: i % 2
          exponent: 2.4
          position [lump.position[0] - origin[0], lump.position[1] - origin[1], lump.position[2] - origin[2]]
          scale: lump.radii
          group: 1
        }
      }
    }
  }
}

// A lake's surface: a flat turquoise disc of `radius` that rises and falls with the gauge `state.<gauge>` by `rise` metres
// a unit above `rest`, the gauge's value at the lake's outlet.
template lakeSurface(id, radius, gauge = "lakeLevel", rest = 0.4, rise = 4, palette = waterPalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      drivers [
        { name: "level", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0 }
      ]
      shape Cylinder "surface" {
        material: 0
        position [0, 0, 0]
        scale [radius, 0.12, radius]
        slides [
          { driver: "level", axis [0, 1, 0], amplitude: rise, phase: 0 - rest, wave: "linear" }
        ]
      }
    }
  }
}

// A float gauge for a store that the gauge `state.<gauge>` reads from zero to one: a teal guide post `height` tall with a
// pale tick every `tick` metres up its face, and an orange float that rides the post from its foot to its top as the gauge
// rises, so the store's fill is read off the bank. `height` is at most 4, the longest a slide runs.
template floatGauge(id, height = 3, tick = 0.5, gauge = "aquiferFill", palette = gaugePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      drivers [
        { name: "fill", signal: $"state.{gauge}", cadence: 1, blendInSeconds: 0 }
      ]
      shape Box "post" {
        material: 0
        position [0, height / 2, 0]
        scale [0.09, height / 2, 0.09]
      }
      for k in range(0, floor(height / tick) + 1) {
        shape Box $"tick-{k}" {
          material: 1
          position [0, k * tick + 0.04, -0.1]
          scale [0.2, 0.04, 0.015]
        }
      }
      shape Box "float" {
        material: 2
        position [0, 0.15, -0.16]
        scale [0.2, 0.12, 0.07]
        slides [
          { driver: "fill", axis [0, 1, 0], amplitude: height - 0.3, phase: 0, wave: "linear" }
        ]
      }
    }
  }
}
// The gauge's teal post, pale ticks and orange float.
let gaugePalette = [
  { color: "#2E6F73", roughness: 0.6, specular: 0.1 }
  { color: "#EAE3CF", roughness: 0.8, specular: 0.02 }
  { color: "#E8832A", roughness: 0.5, specular: 0.15 }
]

// A stone footbridge `length` long and `width` across over a stream, its deck `rise` above the ground on two ramps and
// two piers, with a low parapet each side. Its +Z runs along the bridge. Every shape is a union of boxes, so it collides as
// it is drawn.
template stoneBridge(id, length = 9, width = 3, rise = 1.1, ramp = 3, palette = stonePalette) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: palette
      shape Box "deck" {
        material: 0
        position [0, rise - 0.2, 0]
        scale [width / 2, 0.2, length / 2]
      }
      for end in [-1, 1] {
        shape Box $"pier-{end}" {
          material: 1
          position [0, rise / 2 - 0.2, end * (length / 2 - 0.6)]
          scale [width / 2 - 0.2, rise / 2, 0.6]
        }
        shape Box $"ramp-{end}" {
          material: 0
          position [0, rise / 2 - 0.1, end * (length / 2 + ramp / 2 - 0.05)]
          scale [width / 2, 0.15, squareRoot(ramp * ramp + rise * rise) / 2]
          rotation [
            end * halfTurnSine(ramp / squareRoot(ramp * ramp + rise * rise)),
            0,
            0,
            halfTurnCosine(ramp / squareRoot(ramp * ramp + rise * rise))
          ]
        }
      }
      for side in [-1, 1] {
        shape Box $"parapet-{side}" {
          material: 1
          position [side * (width / 2 - 0.15), rise + 0.25, 0]
          scale [0.15, 0.25, length / 2]
        }
      }
    }
  }
}
