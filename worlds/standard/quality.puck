// The standard's graphics presets: `world.quality low|medium|high` applies one, each writing its shadow tier and slot
// policy, its ambient-occlusion switch, its temporal-reconstruction switch, its dynamic-resolution switch (off in every
// preset), its scalar render ceiling, its render-scale floor and its sky tier (`world.sky-quality`) into the live render
// levers. The independently counted sky field stays Full at every tier; Half remains an authored option. Indirect light
// is off at Low, Medium at Medium and High at High.
// A world boots on its own render levers and nothing here changes them until a tier is chosen. Until initial development
// is done every machine runs `high`, the fullest render, and no machine drops to a lower tier to meet its frame-rate bar;
// `low` and `medium` are what they are only until the tiers below the highest are worked out on the machines that need
// them. `standard.puck` imports this table, so every world importing the standard answers each tier, and a world
// without the standard imports it by name.
render {
  low {
    bloom: Off
    indirect: Off
    sky: low
    skyFieldScale: 1
    shadows: Off
    shadowLights: 0
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: false
    temporal: false
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 0.70980394
  }
  medium {
    bloom: Low
    indirect: Medium
    sky: medium
    skyFieldScale: 1
    shadows: Medium
    shadowLights: 1
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: true
    temporal: true
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 0.8666667
  }
  high {
    bloom: High
    indirect: High
    sky: high
    skyFieldScale: 1
    shadows: High
    shadowLights: 2
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: true
    temporal: true
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 1
  }
}
