// The standard's graphics presets: `world.quality low|medium|high` applies one, each writing its shadow tier and slot
// policy, its distant shadow map, its ambient-occlusion switch, its temporal-reconstruction switch, its dynamic-resolution switch (off in every
// preset), its scalar render ceiling, its render-scale floor and its sky tier (`world.sky-quality`) into the live render
// levers. The independently counted sky field stays Full at every tier; Half remains an authored option. The irradiance
// volume is Medium at Low and Medium and High at High: its probes occlude the traced lights, the reflected sky and, in a
// view with no cascade, the sun, so no tier goes without it. Every tier lets the volume's background rays take the ray
// hardware where the device has it (`world.rays`): the software walk answers the same hits, so the row changes cost, not
// looks, and a device without ray queries ignores it.
// A world boots on its own render levers until its device opens; a device a profile below matches then runs that
// profile's table from its first frames, and a lever command after it overrides it. Until initial development is done
// every device runs the `high` look, the fullest render, along the path its own table chooses, and no machine drops to a
// lower tier to meet its frame-rate bar; `low` and `medium` are what they are only until the tiers below the highest are
// worked out on the machines that need them. `standard.puck` imports this table, so every world importing the standard
// answers each tier, and a world without the standard imports it by name.
render {
  // The irradiance volume's budget: each presented frame relights at most `relightPerFrame` probes from their cached hits
  // (a light or sky change) and traces at most `tracePerFrame` probes' hits (a scene change or a window move), and a
  // relight cycle whose oldest lighting is older than `age` seconds prints `[sdf.mesh-gi] behind`. The grant is a count a
  // frame, never a rate of wall time, so a frame that runs long owes no more probe work than a short one: a device that
  // holds fewer frames a second does less lighting work a second, which is the direction that lets it catch up. This is
  // the world's own budget, what a tier or device row that authors none runs; each quality table below carries its own
  // `indirectBudget`, which replaces it, because what a frame may spend on lighting is the device's cost. The GPU time the
  // work costs comes from the one background share, which follows what the frame leaves free, so a higher count lowers
  // the lighting's age only while the frame has time to spare. The standard's day turns the sun a quarter of a degree a
  // second, so an eight-second age lags it two degrees; a world with a faster day or more probes in view raises
  // `relightPerFrame` and reads the lighting's age move in `world.budget`.
  indirect {
    lightingGrid {
      directionDegrees: 0.5
      radiance: 0.015625
    }
    budget {
      relightPerFrame: 2048
      tracePerFrame: 2048
      age: 8
    }
  }
  // The device profiles: for each graphics device the standard ships for, the quality table it runs and the memory it may
  // use. The engine selects a profile by the adapter's name (`match`, a case-insensitive part of it) once the device
  // opens, or by name (`world.device-profile <name>`), applies its table as `world.quality` does and admits memory
  // against its bars: the device pool's limit is the lower of `deviceMemoryMiB` and the adapter's own budget less a
  // tenth. On a discrete GPU the host and device have separate bars. The Steam Deck shares one host bar between the
  // process and GPU. A device runs its tier's preset unless it authors a `table` of its own, the highest quality that device
  // reaches its bar by.
  //
  // The RTX 2060's table is the `high` look along the 2060's own path, at 1920 by 1080: its views shade three quarters
  // of the display's width and height and reconstruct the rest over time (the jittered temporal resolve the high preset
  // already runs), so the views, surface and probe-gather passes shade a little over half the pixels; its irradiance
  // volume is the medium tier's, whose finest level is 2 m cells over a 64 m window, two thirds of the high tier's probes,
  // and the hit cache and the published and feedback tables are sized by it; its distant shadow map draws 1024 texels a
  // side (a texel about 2.3 m across the 1200 m reach) and holds through a fifth of a degree of the sun's turn, so the
  // standard's day redraws it a little over once a second, each step about one of its texels, and spreads each redraw
  // over four frames, so no frame pays a whole one; its far cascade refreshes 15 times a second, the medium tier's rate,
  // so three of every four 60 Hz frames stand where the high tier's stand every other frame. It relights and traces half
  // the probes a frame the high tier does, over the medium volume's two thirds of the probes, so a frame it fills
  // takes less of the one background share for lighting and the lighting's age grows before the frame does. Its bloom scatters from the
  // low pyramid and its sky field shades at half the grid, each a soft term whose full grid the 2060 cannot afford. It
  // keeps the second shadow slot: that cascade draws only while a second shadowed light (a hearth, a lantern) is in reach,
  // and dropping it would drop that light's shadow. Every nested view takes the 2060's render scale as its ceiling, and
  // its own nested table gives up more than the world's: a view up to half the display's height draws half-size
  // cascades, one up to a third quarter-size cascades, and one smaller than a postcard draws none and renders at half
  // its size, where the fixed cost of a view dominates its pixels.
  devices [
    { name: "rtx4070", match: "RTX 4070", quality: high, deviceMemoryMiB: 8192, hostMemoryMiB: 8192 }
    {
      name: "rtx2060"
      match: "RTX 2060"
      quality: high
      deviceMemoryMiB: 4608
      hostMemoryMiB: 6144
      table {
        viewsRate { maxRate: 2, tileSize: 4 }
        distantShadows { reach: 1200, texels: 1024, turnDegrees: 0.2, frames: 4 }
        farShadows { hertz: 15, turnDegrees: 0.1 }
        indirectBudget { relightPerFrame: 1024, tracePerFrame: 1024, age: 8 }
        bloom: Low
        indirect: Medium
        sky: high
        skyFieldScale: 0.5
        shadows: High
        shadowLights: 2
        shadowFadeSlots: 0
        shadowFadeTicks: 0
        shadowOverflow: instant
        ambientOcclusion: true
        temporal: true
        dynamicResolution: false
        renderScaleFloor: Quarter
        renderScale: 0.75
        rayQueries: true
        nested [
          { share: 0.125, shadows: Off, ambientOcclusion: false, indirectLevels: 1, renderScale: 0.5 }
          { share: 0.33, shadows: Low, indirectLevels: 2 }
          { share: 0.5, shadows: Medium, indirectLevels: 2 }
        ]
      }
    }
    { name: "steamdeck", match: "VANGOGH", quality: high, hostMemoryMiB: 10240 }
  ]
  // What a nested view (a window, a portal, a filmed camera's screen, a session's screen) gives up at each share of the
  // display's height it is presented at, at every tier and on every device whose table (`nested`) chooses none. A view
  // holds its row until its share leaves the row's bound by a tenth, so one presented near a bound does not rebuild its
  // cascades as its size wavers. A view the
  // size of a postcard on screen keeps every term but draws its cascades at half resolution; one smaller than that
  // drops its cascades and ambient occlusion, and its lights take the probes' answer, as a point past every cascade does.
  // The world behind a view up to half the display's height measures only the irradiance volume's storey and far levels
  // (`indirectLevels: 2`), and behind a view smaller than a postcard only the far level, so a painting's world lights
  // itself at a fraction of the probes the world the player stands in traces. A view filling half the display or more
  // gives up nothing, so a portal walked up to is lit as the room behind it.
  nested [
    { share: 0.125, shadows: Off, ambientOcclusion: false, indirectLevels: 1 }
    { share: 0.33, shadows: Medium, indirectLevels: 2 }
    { share: 0.5, indirectLevels: 2 }
  ]
  low {
    indirectBudget { relightPerFrame: 1024, tracePerFrame: 1024, age: 8 }
    bloom: Off
    indirect: Medium
    sky: low
    skyFieldScale: 1
    shadows: Off
    shadowLights: 0
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: false
    temporal: false
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 0.70980394
    rayQueries: true
  }
  // The distant shadow map each tier draws past the far cascade: static casters only, within `reach` metres of the eye,
  // at `texels` a side, held until the sun turns `turnDegrees` (or the eye crosses an eighth of the reach, or a static
  // draw changes). 1200 m reaches across a caldera of the debug valley's size from its rim; 2048 texels make a texel
  // about 1.3 m there, and a tenth of a degree moves a shadow cast from a kilometre about a texel, so under the standard's
  // quarter-degree-a-second day the map is drawn a few times a second and each step is a texel. Low draws no shadows.
  // The far cascade (`farShadows`) is drawn again `hertz` times a second, which a moving caster's shadow lags it by, and
  // at once when the sun turns `turnDegrees`. Between those turns its static casters stand in a layer of their own, which
  // each refresh copies and draws the moving casters over, so the tolerance is how long that layer lives under a turning
  // sun: a tenth of a degree is 0.4 s of the standard's quarter-degree-a-second day, six refreshes at 15 Hz, and moves the
  // shadow of a 20 m caster about 3.5 cm, under a texel of a 2048-texel cascade reaching 120 m. High refreshes 30 times a
  // second, so a 60 Hz view draws both of the cascade's layers on every other frame, and holds its layer through a twentieth
  // of a degree, six of its refreshes; medium refreshes 15 times, so three of every four 60 Hz frames stand.
  medium {
    distantShadows {
      reach: 1200
      texels: 1024
      turnDegrees: 0.2
    }
    farShadows {
      hertz: 15
      turnDegrees: 0.1
    }
    indirectBudget { relightPerFrame: 1536, tracePerFrame: 1536, age: 8 }
    bloom: Low
    indirect: Medium
    sky: medium
    skyFieldScale: 1
    shadows: Medium
    shadowLights: 1
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: true
    temporal: true
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 0.8666667
    rayQueries: true
  }
  high {
    viewsRate {
      maxRate: 1
      tileSize: 4
    }
    distantShadows {
      reach: 1200
      texels: 2048
      turnDegrees: 0.1
      frames: 4
    }
    farShadows {
      hertz: 30
      turnDegrees: 0.05
    }
    indirectBudget { relightPerFrame: 2048, tracePerFrame: 2048, age: 8 }
    bloom: High
    indirect: High
    sky: high
    skyFieldScale: 1
    shadows: High
    shadowLights: 2
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: true
    temporal: true
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 1
    rayQueries: true
  }
}
