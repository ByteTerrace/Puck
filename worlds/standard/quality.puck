// The standard's graphics presets: `world.quality low|medium|high` applies one, each writing its shadow tier and slot
// policy, its distant shadow map, its ambient-occlusion switch, its temporal-reconstruction switch, its dynamic-resolution switch (off in every
// preset), its scalar render ceiling, its render-scale floor and its sky tier (`world.sky-quality`) into the live render
// levers. The independently counted sky field stays Full at every tier; Half remains an authored option. The irradiance
// volume is Medium at Low and Medium and High at High: its probes occlude the traced lights, the reflected sky and, in a
// view with no cascade, the sun, so no tier goes without it. Every tier lets the volume's background rays take the ray
// hardware where the device has it (`world.rays`): the software walk answers the same hits, so the row changes cost, not
// looks, and a device without ray queries ignores it.
// A world boots on its own render levers and nothing here changes them until a tier is chosen. Until initial development
// is done every machine runs `high`, the fullest render, and no machine drops to a lower tier to meet its frame-rate bar;
// `low` and `medium` are what they are only until the tiers below the highest are worked out on the machines that need
// them. `standard.puck` imports this table, so every world importing the standard answers each tier, and a world
// without the standard imports it by name.
render {
  // The irradiance volume's budget, the same at every tier: each rendered frame relights at most `relight` probes from
  // their cached hits (a light or sky change) and traces at most `trace` probes' hits (a scene change or a window
  // move), and a relight cycle whose oldest lighting is older than `age` seconds prints `[sdf.mesh-gi] behind`. The
  // standard's day turns the sun a quarter of a degree a second, so an eight-second age lags it two degrees; a world
  // with a faster day or more probes in view raises `relight` and reads the frame time move in `host.frames`.
  indirect {
    lightingGrid {
      directionDegrees: 0.5
      radiance: 0.015625
    }
    budget {
      relight: 2048
      trace: 2048
      age: 8
    }
  }
  // The device profiles: for each graphics device the standard ships for, the quality table it runs and the memory it may
  // use. The engine selects a profile by the adapter's name (`match`, a case-insensitive part of it) or by name
  // (`world.device-profile <name>`), applies its table as `world.quality` does and admits memory against its bars: the
  // device pool's limit is the lower of `deviceMemoryMiB` and the adapter's own budget less a tenth, and
  // `hostMemoryMiB` bounds the host pool the same way. The RTX 4070 keeps 8 GiB of its 12 for the system and other
  // programs, the RTX 2060 4.5 GiB of its 6, and the Steam Deck's one pool of 10 GiB holds the process and its GPU
  // together. Until initial development is done every device runs `high`.
  devices [
    { name: "rtx4070", match: "RTX 4070", quality: high, deviceMemoryMiB: 8192 }
    { name: "rtx2060", match: "RTX 2060", quality: high, deviceMemoryMiB: 4608 }
    { name: "steamdeck", match: "VANGOGH", quality: high, hostMemoryMiB: 10240 }
  ]
  // What a nested view (a window, a portal, a filmed camera's screen, a session's screen) gives up at each share of the
  // display's height it is presented at, the same at every tier until a device table chooses per device. A view the
  // size of a postcard on screen keeps every term but draws its cascades at half resolution; one smaller than that
  // drops its cascades and ambient occlusion, and its lights take the probes' answer, as a point past every cascade does.
  // A view filling a third of the display or more gives up nothing, so a portal walked up to is lit as the room behind it.
  nested [
    { share: 0.125, shadows: Off, ambientOcclusion: false }
    { share: 0.33, shadows: Medium }
  ]
  low {
    bloom: Off
    indirect: Medium
    sky: low
    skyFieldScale: 1
    shadows: Off
    shadowLights: 0
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: false
    temporal: false
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 0.70980394
    rayQueries: true
  }
  // The distant shadow map each tier draws past the far cascade: static casters only, within `reach` metres of the eye,
  // at `texels` a side, held until the sun turns `turnDegrees` (or the eye crosses an eighth of the reach, or a static
  // draw changes). 1200 m reaches across a caldera of the debug valley's size from its rim; 2048 texels make a texel
  // about 1.3 m there, and a tenth of a degree moves a shadow cast from a kilometre about a texel, so under the standard's
  // quarter-degree-a-second day the map is drawn a few times a second and each step is a texel. Low draws no shadows.
  medium {
    distantShadows {
      reach: 1200
      texels: 1024
      turnDegrees: 0.2
    }
    bloom: Low
    indirect: Medium
    sky: medium
    skyFieldScale: 1
    shadows: Medium
    shadowLights: 1
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: true
    temporal: true
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 0.8666667
    rayQueries: true
  }
  high {
    distantShadows {
      reach: 1200
      texels: 2048
      turnDegrees: 0.1
    }
    bloom: High
    indirect: High
    sky: high
    skyFieldScale: 1
    shadows: High
    shadowLights: 2
    shadowFadeSlots: 0
    shadowFadeTicks: 0
    shadowOverflow: instant
    ambientOcclusion: true
    temporal: true
    dynamicResolution: false
    renderScaleFloor: Quarter
    renderScale: 1
    rayQueries: true
  }
}
