// The standard semantic input vocabulary. Modules consume names; each shared action is declared here once, and the
// standard's controls bind them. A world declares its own actions beside these in its own documents (the debug
// world's noclip channel is its noclip.puck's).
schema: "puck.world.definition.v1"

// Each owner's retained input, sized for a pad played as a player plays it: both sticks moving every tick are four axis
// samples a tick, which at 60 ticks a second over the two seconds an event stays retained is 480 events, beside the
// buttons and typed text. An owner whose ring is full admits nothing more until retained events expire, so a ring sized
// below the rate a seat sends at holds a remote seat's input back further every second it plays.
inputHistory {
  eventCapacity: 1024
}

channels [
  { composition: true, name: "dash", shape: Binary }
  // The keys the player module's climb and mantle actions author their programs under (player/actions.puck): both fire
  // on the body's state, so nothing binds them.
  { composition: true, name: "climb", shape: Binary }
  { composition: true, name: "mantle", shape: Binary }
  // Pressed, it switches a lock on and off (player/actions.puck's `lockAction`), which a targeting context fills.
  { composition: true, name: "lock", shape: Binary }
  // Pressed, it steps a player to the next suit their avatar owns (player/player.puck).
  { composition: true, name: "suit", shape: Binary }
  {
    composition: false
    frame: Heading
    name: "forward"
    role: MoveAdvance
    shape: Bipolar
  }
  {
    composition: false
    frame: Heading
    name: "strafe"
    role: MoveStrafe
    shape: Bipolar
  }
  {
    composition: false
    name: "turn"
    role: Turn
    shape: Bipolar
  }
  {
    composition: false
    name: "faceX"
    role: FaceX
    shape: Bipolar
  }
  {
    composition: false
    name: "faceZ"
    role: FaceZ
    shape: Bipolar
  }
  {
    composition: false
    name: "faceY"
    role: FaceY
    shape: Bipolar
  }
  {
    composition: true
    name: "jump"
    shape: Binary
  }
  {
    composition: true
    name: "flight"
    shape: Binary
  }
  // Held, it multiplies the body's speed (the kits' `speed.held`).
  {
    composition: true
    name: "run"
    shape: Binary
  }
  {
    composition: false
    name: "rise"
    role: MoveUp
    shape: Bipolar
  }
  // The pad's start button, which an avatar may ignore: an engaged machine reads it as its own start.
  {
    composition: true
    name: "start"
    shape: Binary
  }
  // The pad's select button, which an avatar may ignore: an engaged machine reads it as its own select.
  {
    composition: true
    name: "select"
    shape: Binary
  }
  // The context button: beside an engageable screen naming it as its engage channel, a press engages that screen and
  // the next press leaves it.
  {
    composition: true
    name: "interact"
    shape: Binary
  }
  {
    composition: true
    name: "confirm"
    shape: Binary
  }
  { composition: true, name: "cancel", shape: Binary }
  // A tap or a click on a pointer surface (a placement's pointer facet, a Simulation screen): the press a surface's rules
  // read beside where the pointer lands, pointer(<seat>|any, <surface>, press, tap). A touchscreen's contact presses it.
  { composition: true, name: "tap", shape: Binary }
  // The wheel over a pointer surface: wheel notches, positive away from the player, which a surface's rules read as
  // channel(<seat>, scroll) to scroll what the surface shows (pointer capture binds it while the pointer rests there).
  {
    composition: true
    name: "scroll"
    shape: Relative
    relative { unit: "notches", sensitivity: 1, maximumPerStep: 8 }
  }
]
