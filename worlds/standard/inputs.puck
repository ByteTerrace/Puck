// The standard semantic input vocabulary. Modules consume names; each shared action is declared here once, and the
// standard's controls bind them. A world declares its own actions beside these in its own documents (the debug
// world's suit and noclip channels are its suit.puck's and noclip.puck's).
schema: "puck.world.definition.v1"

channels [
  { composition: true, name: "dash", shape: Binary }
  {
    composition: false
    frame: Heading
    name: "forward"
    role: MoveAdvance
    shape: Bipolar
  }
  {
    composition: false
    frame: Heading
    name: "strafe"
    role: MoveStrafe
    shape: Bipolar
  }
  {
    composition: false
    name: "turn"
    role: Turn
    shape: Bipolar
  }
  {
    composition: false
    name: "faceX"
    role: FaceX
    shape: Bipolar
  }
  {
    composition: false
    name: "faceZ"
    role: FaceZ
    shape: Bipolar
  }
  {
    composition: false
    name: "faceY"
    role: FaceY
    shape: Bipolar
  }
  {
    composition: true
    name: "jump"
    shape: Binary
  }
  {
    composition: true
    name: "flight"
    shape: Binary
  }
  // Held, it multiplies the body's speed (the kits' `speed.held`).
  {
    composition: true
    name: "run"
    shape: Binary
  }
  {
    composition: false
    name: "rise"
    role: MoveUp
    shape: Bipolar
  }
  // The pad's start button, which an avatar may ignore: an engaged machine reads it as its own start.
  {
    composition: true
    name: "start"
    shape: Binary
  }
  // The pad's select button, which an avatar may ignore: an engaged machine reads it as its own select.
  {
    composition: true
    name: "select"
    shape: Binary
  }
  // The context button: beside an engageable screen naming it as its engage channel, a press engages that screen and
  // the next press leaves it.
  {
    composition: true
    name: "interact"
    shape: Binary
  }
  {
    composition: true
    name: "confirm"
    shape: Binary
  }
  { composition: true, name: "cancel", shape: Binary }
]
