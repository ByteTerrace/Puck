// A vehicle: a body that drives a loop of road stops at its own pace, drawn as a small cart. A module library: it hands
// its importers templates, functions and lets and emits no document. A world declares its roads as navigation domains
// of one shared network, expands `vehicleDesign` once over them, `vehicleLooks` once, `vehicleRoutes` with every
// vehicle's stops and `vehicleCrossings` with the crossings they yield at, then places the vehicles with `inhabit` rows
// naming the kit and a look. A seat that possesses a vehicle (`body.engage body:<n>` with Drive over it) drives it in
// its producer's place; released, the vehicle drives on from where it stands.
//
// A vehicle runs the engine's own systems: its producer routes it over the road network toward its `route` register
// (`navigated`, reading the stop's shared goal field), its body drives the standard `walk` motion program (motion.puck),
// and the routes' rules move the register to the next stop as the vehicle arrives. Vehicles use `overlap` body contact.
//
// A road can also be a curve. `roadLoop` declares a loop's `curves` row and `vehicleRoute` a program that follows it
// (the curve-follow target, which joins the curve at the station nearest the vehicle, so vehicles placed along a road
// keep their spacing); `vehicleDesign`'s `routes` adds such programs to the kit's producers, and a placement selects one
// by name. `vehicleGripShaping` is a shaping row that grips the road across the vehicle's heading, as a wheeled body
// does: the vehicle turns toward its target and its velocity follows the way it faces.

import "kits"

// The road domains' envelope for a vehicle (domains.puck's `surfaceDomain`): a 2 m tall body of 0.9 m radius that
// climbs no more than a kerb and keeps to gentle grades.
let vehicleWalker = { height: 2, radius: 0.9, step: 0.3, slope: 30 }

// A vehicle producer's steering: straight at the next step of its route, turning as it goes, coasting once within
// `standoffRadius` of it. An empty route holds the vehicle still.
let vehicleSteering = {
  channels {}
  scalars {
    approach: 1
    approachAltitudeGain: 0
    standoffRadius: 0.8
    orbit: 0
    inwardGain: 3
    turnScale: 2
  }
}

// A curve route's steering: as `vehicleSteering`, trailing the point that travels the road by 3 m rather than catching
// it.
let vehicleRouteSteering = vehicleSteering with { scalars: vehicleSteering.scalars with { standoffRadius: 3 } }

// Lateral slip dies at 16 metres a second squared, so a vehicle's velocity follows its turn.
let vehicleGripShaping = [
  {
    along {
      engage: 5
      release: 6
    }
    across {
      lateral: 16
    }
  }
]

let roadQuarterTurn = 1.5707963267948966

// A road loop's curve: a closed rounded rectangle on the centreline x0..x1 by z0..z1 (z0 < z1), its corners circular
// arcs of `radius`, each two 45 degree segments, joined by straights. It is driven along z0 toward +X, up x1 toward +Z,
// along z1 toward -X and down x0 toward -Z. Each corner's end knots author the arc's curvature on the arc side and
// zero on the straight side, so the curvature jumps where an arc meets a straight and the heading carries through.
function roadLoop(name, x0, x1, z0, z1, radius) = {
  name: name
  closed: true
  knots: flatMap(range(0, 4), corner => map(range(0, 3), step => roadLoopKnot(
    centre: [[x1 - radius, z0 + radius], [x1 - radius, z1 - radius], [x0 + radius, z1 - radius], [x0 + radius, z0 + radius]][corner],
    radius: radius,
    corner: corner,
    step: step
  )))
}

// One knot of a road loop's corner: `step` 0 where the arc leaves the straight before it, 1 at its middle and 2 where
// it meets the straight after it, about the corner's centre. The heading is reduced to [-pi, pi].
function roadLoopKnot(centre, radius, corner, step) = {
  position [centre[0] + radius * cosine((corner - 1 + step / 2) * roadQuarterTurn), 0, centre[1] + radius * sine((corner - 1 + step / 2) * roadQuarterTurn)]
  tangentYaw: ((corner + step / 2) * roadQuarterTurn > 3.1416) ? (corner + step / 2) * roadQuarterTurn - 4 * roadQuarterTurn : (corner + step / 2) * roadQuarterTurn
  curvature: (step == 2) ? 0 : 1 / radius
  incomingCurvature: (step == 0) ? 0 : 1 / radius
}

// A route program `name` that travels a point round the `road` curve at nine tenths of the vehicle's `speed`, so the
// vehicle, at full speed, closes on it. The kit steers it with `vehicleRouteSteering`.
function vehicleRoute(name, road, speed = 8) = {
  kind: Producer
  name: name
  operations [SenseNearestInCone, ProduceSteeringIntent, FaceSensorTarget]
  target: curve(curve: road, rate: speed * 0.9)
  version: "puck.body.program.v1"
}

// A vehicle's navigation profile over a town's area types (domains.puck's `townAreaTypes`): it never drives onto the
// pavement, and pays a road's and a crossing's length alike.
let vehicleProfile = { name: "vehicle", exclude ["pavement"] }

// The `route` target register, the `vehicle` producer that routes over `domain` (any domain of the road network) under
// the navigation `profile` (a world lists `vehicleProfile` to name "vehicle"; none pays one everywhere) and the
// `vehicle` kit that drives at `speed` metres a second under `shaping`. `routes` adds curve route programs to its
// producers, each name mapped to `vehicleRouteSteering`.
template vehicleDesign(domain, speed = 8, shaping = walkerMotion.shaping, routes = {}, profile = null) {
  targetRegisters [
    { name: "route", maximumRange: 1000, maximumHalfAngleDegrees: 180, requiresLineOfSight: false }
  ]

  bodyMotionPrograms [
    {
      kind: Producer
      name: "vehicle"
      operations [SenseNearestInCone, ProduceSteeringIntent, FaceSensorTarget]
      target: navigated(domain: domain, register: "route", profile: profile)
      version: "puck.body.program.v1"
    }
  ]

  kits [
    {
      name: "vehicle"
      bodyContact: Overlap
      bodyMotionProgram: "walk"
      collider: capsule(endpoint: [0, 0.4, 0], radius: 0.9)
      motion: walkerMotion with { shaping: shaping, speed { value: speed } }
      producers: ({ vehicle: vehicleSteering } with routes)
    }
  ]
}

// A cart in each body colour: a prototype and look `vehicle-<i>`, a 1.8 by 3.4 m body on four wheels under a canopy.
template vehicleLooks(colors, trim = "#2F2A26", canopy = "#EBDDBF") {
  prototypes {
    for (color, i) in colors {
      prototype $"vehicle-{i}" {
        document {
          name: $"vehicle-{i}"
          schema: "puck.creation.v1"
          palette [
            { color: color, roughness: 0.55, specular: 0.2 }
            { color: trim, roughness: 0.8 }
            { color: canopy, roughness: 0.85 }
          ]
          shape Box "body" {
            material: 0
            position [0, 0.75, 0]
            scale [0.9, 0.4, 1.7]
            rounding: 0.15
          }
          shape Box "canopy" {
            material: 2
            position [0, 1.55, -0.3]
            scale [0.85, 0.06, 1.0]
          }
          shape Box "post-left" {
            material: 1
            position [-0.8, 1.3, -0.3]
            scale [0.05, 0.25, 0.05]
          }
          shape Box "post-right" {
            material: 1
            position [0.8, 1.3, -0.3]
            scale [0.05, 0.25, 0.05]
          }
          for wheel in [[-0.9, 1.1], [0.9, 1.1], [-0.9, -1.1], [0.9, -1.1]] {
            shape Cylinder $"wheel-{wheel[0]}-{wheel[1]}" {
              material: 1
              position [wheel[0], 0.35, wheel[1]]
              rotation [0, 0, 0.707107, 0.707107]
              scale [0.35, 0.12, 0.35]
            }
          }
        }
      }
    }
  }

  looks: map(range(0, length(colors)), i => {
    name: $"vehicle-{i}"
    scale: 1
    source: creation(prototypeId: $"vehicle-{i}")
    motion {
      gaitAmplitude: 0
      replayFrames: false
      secondsPerFrame: 0
    }
  })
}

// Every navigated vehicle's loop. `vehicles` lists each as `{ key, stops, first }`: `key` its body number, `stops` the
// four `[x, z]` points of its loop in driving order, `first` the stop it drives to first. From the second tick each
// vehicle is sent to its first stop; once it arrives, the next stop round the loop becomes its route, so it laps
// forever. A vehicle has arrived once it stands within 3 m of its stop, read from its own position, so a stop it has
// just left can never advance it twice in one tick. `vehicleStop` holds the stop each vehicle drives to. A vehicle a
// seat possesses keeps the stop it was driving to, however near another it is driven, and drives on to it once
// released (its producer routes again from where it stands).
template vehicleRoutes(vehicles) {
  state {
    world: concat(
      flatMap(range(0, 4), s => [
        vehicleStopRow(name: $"vehicleStop{s}X", vehicles: vehicles, values: map(vehicles, v => v.stops[s][0]))
        vehicleStopRow(name: $"vehicleStop{s}Z", vehicles: vehicles, values: map(vehicles, v => v.stops[s][1]))
      ]),
      [
        {
          name: "vehicleStop"
          kind: "Int"
          capacity: length(vehicles)
          cells: map(vehicles, v => { key: $"{v.key}", value: v.first })
        }
      ]
    )
  }

  rule "vehicle-start-0" {
    when $tick >= 2 and vehicleStop[$each] == 0
    mode: Edge
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop0X[$each], pointY: 0, pointZ: vehicleStop0Z[$each])
  }
  rule "vehicle-start-1" {
    when $tick >= 2 and vehicleStop[$each] == 1
    mode: Edge
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop1X[$each], pointY: 0, pointZ: vehicleStop1Z[$each])
  }
  rule "vehicle-start-2" {
    when $tick >= 2 and vehicleStop[$each] == 2
    mode: Edge
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop2X[$each], pointY: 0, pointZ: vehicleStop2Z[$each])
  }
  rule "vehicle-start-3" {
    when $tick >= 2 and vehicleStop[$each] == 3
    mode: Edge
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop3X[$each], pointY: 0, pointZ: vehicleStop3Z[$each])
  }
  rule "vehicle-next-1" {
    when vehicleStop[$each] == 0 and producer(each, possessed) == 0 and ((bodyPosition(each, x) - vehicleStop0X[$each]) * (bodyPosition(each, x) - vehicleStop0X[$each]) + (bodyPosition(each, z) - vehicleStop0Z[$each]) * (bodyPosition(each, z) - vehicleStop0Z[$each])) < 9
    mode: Level
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop1X[$each], pointY: 0, pointZ: vehicleStop1Z[$each])
    vehicleStop[$each] = 1
  }
  rule "vehicle-next-2" {
    when vehicleStop[$each] == 1 and producer(each, possessed) == 0 and ((bodyPosition(each, x) - vehicleStop1X[$each]) * (bodyPosition(each, x) - vehicleStop1X[$each]) + (bodyPosition(each, z) - vehicleStop1Z[$each]) * (bodyPosition(each, z) - vehicleStop1Z[$each])) < 9
    mode: Level
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop2X[$each], pointY: 0, pointZ: vehicleStop2Z[$each])
    vehicleStop[$each] = 2
  }
  rule "vehicle-next-3" {
    when vehicleStop[$each] == 2 and producer(each, possessed) == 0 and ((bodyPosition(each, x) - vehicleStop2X[$each]) * (bodyPosition(each, x) - vehicleStop2X[$each]) + (bodyPosition(each, z) - vehicleStop2Z[$each]) * (bodyPosition(each, z) - vehicleStop2Z[$each])) < 9
    mode: Level
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop3X[$each], pointY: 0, pointZ: vehicleStop3Z[$each])
    vehicleStop[$each] = 3
  }
  rule "vehicle-next-0" {
    when vehicleStop[$each] == 3 and producer(each, possessed) == 0 and ((bodyPosition(each, x) - vehicleStop3X[$each]) * (bodyPosition(each, x) - vehicleStop3X[$each]) + (bodyPosition(each, z) - vehicleStop3Z[$each]) * (bodyPosition(each, z) - vehicleStop3Z[$each])) < 9
    mode: Level
    forEach: vehicleStop
    designate(key: $each, kind: Point, register: "route", pointX: vehicleStop0X[$each], pointY: 0, pointZ: vehicleStop0Z[$each])
    vehicleStop[$each] = 0
  }
}

// The crossings vehicles yield at, for a vehicle on any route (a navigated loop of stops or a curve). `vehicles` lists
// each as `{ key, group }`: `key` its body number, `group` the name of the loop it drives (a row `vehicleGroup-<group>`
// keys its vehicles). `crossings` lists each as `{ region, approach, group, cx0, cx1, cz0, cz1 }`: the id of a
// placement whose region covers the crossing, the id of a placement whose region covers the approach before it on the
// vehicles' side of travel, the group of vehicles that pass it and the crossing's own box (world x and z bounds). A
// vehicle in a crossing's approach while any body stands in the crossing's region is held: its producer stands down
// (`holdProducer`), it coasts to rest, and `vehicleHeld` names the crossing (its number plus one). Once the region is
// empty, or the vehicle has already rolled into the crossing, it is released (`releaseProducer`) and its producer
// starts again from where it stands: a curve follower at its curve's nearest station, a navigated vehicle routing
// again to the stop it was driving to.
//
// The hold rule sweeps the approach's occupants (`forEach: region(...)`), so a crossing costs the vehicles approaching
// it, never every vehicle of its loop. An approach region's `capacity` is the vehicles the work sheet prices that
// sweep at; a world sizes it to the queue it expects there.
template vehicleCrossings(vehicles, crossings) {
  state {
    world: concat(
      [
        {
          name: "vehicleHeld"
          kind: "Int"
          capacity: length(vehicles)
          cells: map(vehicles, v => { key: $"{v.key}", value: 0 })
        }
      ],
      map(distinct(map(vehicles, v => v.group)), g => {
        name: $"vehicleGroup-{g}"
        kind: "Int"
        capacity: length(filter(vehicles, v => v.group == g))
        cells: map(filter(vehicles, v => v.group == g), v => { key: $"{v.key}", value: 1 })
      })
    )
  }

  for (crossing, i) in crossings {
    rule $"vehicle-crossing-{crossing.region}" {
      when vehicleHeld[$each] == 0 and region(crossing.region) >= 1 and $"vehicleGroup-{crossing.group}"[$each] == 1
      mode: Level
      forEach: region(crossing.approach)
      holdProducer(key: $each)
      vehicleHeld[$each] = i + 1
    }
    rule $"vehicle-crossing-clear-{crossing.region}" {
      when (vehicleHeld[$each] == i + 1 and (region(crossing.region) == 0 or
        (bodyPosition(each, x) > crossing.cx0 and bodyPosition(each, x) < crossing.cx1 and
        bodyPosition(each, z) > crossing.cz0 and bodyPosition(each, z) < crossing.cz1)))
      mode: Level
      forEach: $"vehicleGroup-{crossing.group}"
      releaseProducer(key: $each)
      vehicleHeld[$each] = 0
    }
  }
}

// One stop coordinate of every vehicle as a Fixed row keyed by body number, each value on a 1/1024 m step.
function vehicleStopRow(name, vehicles, values) = {
  name: name
  kind: "Fixed"
  capacity: length(vehicles)
  cells: map(range(0, length(vehicles)), i => { key: $"{vehicles[i].key}", value: $"{round(values[i] * 1024) / 1024}" })
}
