// A vehicle: a body that laps a road loop at its own pace, drawn as a small cart. A module library: it hands its
// importers templates, functions and lets and emits no document. A world declares each road as a `curves` row
// (`roadLoop`) and a route program following it (`vehicleRoute`), expands `vehicleDesign` once with those routes as
// the kit's producers and `vehicleLooks` once, then places the vehicles with `inhabit` rows naming the kit, a look and
// the route the vehicle drives.
//
// A vehicle runs the engine's own systems: its route program travels a point round the road's curve and steers at
// it (the curve-follow target, which joins the curve at the station nearest the vehicle, so vehicles placed along a
// road keep their spacing), and its body drives the standard `walk` motion program (motion.puck) under a kit whose
// shaping row grips the road across the vehicle's heading, as a wheeled body does: it turns toward the point and its
// velocity follows the way it faces. Vehicles use `overlap` body contact.

import "kits"

// A route program's steering: straight at the point travelling the road, turning toward it, and coasting once within
// `standoffRadius` of it, so a vehicle trails the point rather than catching it.
let vehicleSteering = {
  channels {}
  scalars {
    approach: 1
    approachAltitudeGain: 0
    standoffRadius: 3
    orbit: 0
    inwardGain: 3
    turnScale: 2
  }
}

let roadQuarterTurn = 1.5707963267948966

// A road loop's curve: a closed rounded rectangle on the centreline x0..x1 by z0..z1 (z0 < z1), its corners circular
// arcs of `radius`, each two 45 degree segments, joined by straights. It is driven along z0 toward +X, up x1 toward +Z,
// along z1 toward -X and down x0 toward -Z. Each corner's end knots author the arc's curvature on the arc side and
// zero on the straight side, so the curvature jumps where an arc meets a straight and the heading carries through.
function roadLoop(name, x0, x1, z0, z1, radius) = {
  name: name
  closed: true
  knots: flatMap(range(0, 4), corner => map(range(0, 3), step => roadLoopKnot(
    centre: [[x1 - radius, z0 + radius], [x1 - radius, z1 - radius], [x0 + radius, z1 - radius], [x0 + radius, z0 + radius]][corner],
    radius: radius,
    corner: corner,
    step: step
  )))
}

// One knot of a road loop's corner: `step` 0 where the arc leaves the straight before it, 1 at its middle and 2 where
// it meets the straight after it, about the corner's centre. The heading is reduced to [-pi, pi].
function roadLoopKnot(centre, radius, corner, step) = {
  position [centre[0] + radius * cosine((corner - 1 + step / 2) * roadQuarterTurn), 0, centre[1] + radius * sine((corner - 1 + step / 2) * roadQuarterTurn)]
  tangentYaw: ((corner + step / 2) * roadQuarterTurn > 3.1416) ? (corner + step / 2) * roadQuarterTurn - 4 * roadQuarterTurn : (corner + step / 2) * roadQuarterTurn
  curvature: (step == 2) ? 0 : 1 / radius
  incomingCurvature: (step == 0) ? 0 : 1 / radius
}

// A route program `name` that travels a point round the `road` curve at nine tenths of the vehicle's `speed`, so the
// vehicle, at full speed, closes on it.
function vehicleRoute(name, road, speed = 8) = {
  kind: Producer
  name: name
  operations [SenseNearestInCone, ProduceSteeringIntent, FaceSensorTarget]
  target: curve(curve: road, rate: speed * 0.9)
  version: "puck.body.program.v1"
}

// The `vehicle` kit: driven at `speed` metres a second by whichever of its `producers` (route program names, each
// `vehicleSteering`) the placement selects. Its one shaping row grips across the heading: lateral slip dies at
// `grip` metres a second squared, so the vehicle's velocity follows its turn.
template vehicleDesign(producers, speed = 8, grip = 16) {
  kits [
    {
      name: "vehicle"
      bodyContact: Overlap
      bodyMotionProgram: "walk"
      collider: capsule(endpoint: [0, 0.4, 0], radius: 0.9)
      motion: walkerMotion with {
        shaping [
          {
            along {
              engage: 5
              release: 6
            }
            across {
              lateral: grip
            }
          }
        ]
        speed {
          value: speed
        }
        turn {
          falloff: 1
          maxPitch: 1.2
          pitchRate: 0
          rate: 1.6
        }
      }
      producers: producers
    }
  ]
}

// A cart in each body colour: a prototype and look `vehicle-<i>`, a 1.8 by 3.4 m body on four wheels under a canopy.
template vehicleLooks(colors, trim = "#2F2A26", canopy = "#EBDDBF") {
  prototypes {
    for (color, i) in colors {
      prototype $"vehicle-{i}" {
        document {
          name: $"vehicle-{i}"
          schema: "puck.creation.v1"
          palette [
            { color: color, roughness: 0.55, specular: 0.2 }
            { color: trim, roughness: 0.8 }
            { color: canopy, roughness: 0.85 }
          ]
          shape Box "body" {
            material: 0
            position [0, 0.75, 0]
            scale [0.9, 0.4, 1.7]
            rounding: 0.15
          }
          shape Box "canopy" {
            material: 2
            position [0, 1.55, -0.3]
            scale [0.85, 0.06, 1.0]
          }
          shape Box "post-left" {
            material: 1
            position [-0.8, 1.3, -0.3]
            scale [0.05, 0.25, 0.05]
          }
          shape Box "post-right" {
            material: 1
            position [0.8, 1.3, -0.3]
            scale [0.05, 0.25, 0.05]
          }
          for wheel in [[-0.9, 1.1], [0.9, 1.1], [-0.9, -1.1], [0.9, -1.1]] {
            shape Cylinder $"wheel-{wheel[0]}-{wheel[1]}" {
              material: 1
              position [wheel[0], 0.35, wheel[1]]
              rotation [0, 0, 0.707107, 0.707107]
              scale [0.35, 0.12, 0.35]
            }
          }
        }
      }
    }
  }

  looks: map(range(0, length(colors)), i => {
    name: $"vehicle-{i}"
    scale: 1
    source: creation(prototypeId: $"vehicle-{i}")
    motion {
      gaitAmplitude: 0
      replayFrames: false
      secondsPerFrame: 0
    }
  })
}
