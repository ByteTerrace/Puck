// The standard deck: 52 playing-card faces and a back as signed-distance creations, one prototype each
// (`card-<suit>-<rank>`, suit c d h s, rank a 2 .. 10 j q k, and `card-back`). It is a library: import it
//
//   import "../standard/cards"
//
// and expand `cardDeckPrototypes(variant: "light")` inside the world's `prototypes` block, so the prototypes belong to
// the importing document and its rows name them freely. Give each card body the look of its prototype: the faces bake
// once per mesh store and variant, so every table that wears them shares one bake. The deck lies in the shape's XY
// plane, its index and face toward -Z of the author frame and its back toward +Z, the card 1.76 wide and 2.48 tall (2.5
// by 3.5 proportion) and 0.04 thick; a table scales it to size with the look's `scale` and lays it flat by posing it with
// a pitch of 90 degrees.
//
// The deck ships two variants an author chooses (`cardVariants`): "light", an ivory ground with red hearts and diamonds
// and black spades and clubs, and "dark", a near-black ground with bright pips. Both keep the gold rim and the court
// figures, and the rank and suit index share the suit's colour. `prefix` renames the prototypes (`card` by default), so
// a world can carry both variants under two prefixes.

// Playing card dimensions (standard 2.5" x 3.5" proportion)
let cardHalfWidth = 0.88
let cardHalfHeight = 1.24
let cardHalfThickness = 0.02
let heartAspect = 0.74074074

// The court figures are modelled as a deep relief, a bust standing 0.18 off the face and 0.07 through the back of a 0.04
// card: cards lie a few millimetres apart in a fan and a stack, so a figure that deep pokes through the card laid over
// it, and squashing it flat lost the features (a face's eyes stand a hair off its curved surface). Each court shape is
// instead a cut-out layer standing on the court field: centred on the field's plate (courtZ) and standing courtRelief
// off it plus courtStep for each depth its model put it in front of the shapes behind (the cranium, shoulders and chest
// at the back; the eyes, mouth and nose in front). A layer is a column from the plate, so no piece floats clear of the
// card, and it keeps the shape's full outline, so the features read as coloured shapes in order, about 1.7 mm off the
// card at a table's scale at the most.
let courtZ = -0.0215
let courtRelief = 0.0035
let courtStep = 0.0008

// The scale some figure measures are written against: a measure is its unit-frame value times this.
let courtFigureScale = 0.62

// A figure layer's edge rounding: 0.9 of the layer's depth (courtRelief plus courtStep for each depth it stands in front
// of the shapes behind), never past `cap`, the most the layer's own outline can round.
function courtRound(depth, cap) = minimum(0.9 * (courtRelief + depth * courtStep), cap)

// The corner radius shared by the court figures' hair and collar bars: three sevenths.
let courtBarCornerRadius = 3 / 7

// A variant's theme: the card ground and the court field behind its figure, the gold of the rim and the back, the suit
// colours and the back's red.
let lightTheme = {
  face: "#F4EEDC"
  back: "#B31B2C"
  backAccent: "#FFE06B"
  border: "#E0A82E"
  courtField: "#44506E"
  suitRed: "#C8101E"
  suitBlack: "#14141A"
}
let darkTheme = {
  face: "#272A34"
  back: "#B31B2C"
  backAccent: "#FFE06B"
  border: "#FFD65C"
  courtField: "#1E1D28"
  suitRed: "#FF5A66"
  suitBlack: "#E6EAF4"
}

// Slots 0 to 4 and 10 to 11 follow the theme; 5 to 9 are the court figures' own colours.
let backSlot = 11
let cardVariants = map([{ name: "light", theme: lightTheme }, { name: "dark", theme: darkTheme }], variant => {
  name: variant["name"]
  palette [
    { color: variant["theme"]["face"], metal: 0.04, roughness: 0.40, specular: 0.04 }
    { color: variant["theme"]["border"], metal: 0.8, roughness: 0.38, specular: 0.3 }
    { color: variant["theme"]["backAccent"], metal: 0.8, roughness: 0.38, specular: 0.3 }
    { color: variant["theme"]["courtField"], metal: 0.10, roughness: 0.55, specular: 0.04 }
    { color: variant["theme"]["suitRed"], metal: 0, roughness: 0.6, specular: 0.04 }
    { color: "#F2CFA8", roughness: 0.5, metal: 0, specular: 0.04 }
    { color: "#F5F0E6", roughness: 0.22, metal: 0.08, specular: 0.04 }
    { color: "#9E66C7", roughness: 0.22, metal: 0.15, specular: 0.04 }
    { color: "#7A421F", roughness: 0.45, metal: 0.05, specular: 0.04 }
    { color: "#2ED6ED", roughness: 0.04, metal: 0.5, specular: 0.04, emissive: 1.5 }
    { color: variant["theme"]["suitBlack"], metal: 0, roughness: 0.6, specular: 0.04 }
    { color: variant["theme"]["back"], metal: 0.05, roughness: 0.28, specular: 0.12 }
  ]
})

let suitDiamonds = {
  tolerance: 0.001
  contours [
    {
      start [0.0, -0.55]
      segments [
        { end [0.38, 0.0] }
        { end [0.0, 0.55] }
        { end [-0.38, 0.0] }
      ]
    }
  ]
}
// The heart: two semicircular lobes over a point, with its authored bow (offset + y * (linear + quadratic * y),
// y clamped to the heart's height) and width aspect baked into the contour. Baking them keeps the path free of a
// shear, which a stroked outline cannot carry, so the heart takes the same uniform rim as every other suit.
let heartBow = { offset: -0.0693, linear: 0.028, quadratic: 0.28, from: -0.55, to: 0.45 }
let heartLobeRadius = 0.35355339
let heartArcSteps = 16
let heartOutline = concat(
  [[0, -0.55], [0.5, -0.05]],
  map(
    range(1, heartArcSteps - 1),
    k => [
      0.25 + heartLobeRadius * cosine(-0.78539816 + 3.14159265 * k / heartArcSteps)
      0.2 + heartLobeRadius * sine(-0.78539816 + 3.14159265 * k / heartArcSteps)
    ]
  ),
  [[0, 0.45]],
  map(
    range(1, heartArcSteps - 1),
    k => [
      -0.25 + heartLobeRadius * cosine(0.78539816 + 3.14159265 * k / heartArcSteps)
      0.2 + heartLobeRadius * sine(0.78539816 + 3.14159265 * k / heartArcSteps)
    ]
  ),
  [[-0.5, -0.05]]
)
let heartPoints = map(
  heartOutline,
  p => [
    (p[0] + heartBow["offset"] + clamp(p[1], heartBow["from"], heartBow["to"]) * (heartBow["linear"] +
      heartBow["quadratic"] * clamp(p[1], heartBow["from"], heartBow["to"]))) * heartAspect
    p[1]
  ]
)
let suitHearts = {
  tolerance: 0.001
  contours [
    {
      start: heartPoints[0]
      segments: map(filter(heartPoints, (p, i) => i), p => { end: p })
    }
  ]
}

