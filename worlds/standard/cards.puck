template makeAce(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphA, suit: suit)
      suitMark(name: "center-ace-pip", suit: suit, x: 0, y: 0, size: 0.70)
    }
  }
}

template makePipCard(id, pal, backMat, rankGlyph, suit, pips) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: rankGlyph, suit: suit)
      for (p, i) in pips {
        suitMark(name: $"cpip-{i + 1}", suit: suit, x: p[0], y: p[1], size: 0.30, flipped: p[2])
      }
    }
  }
}

template makeJack(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphJ, suit: suit)
      courtField()
      courtFaceBorder()
      courtJack()
    }
  }
}

template makeQueen(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphQ, suit: suit)
      courtField()
      courtFaceBorder()
      courtQueen(suit: suit)
    }
  }
}

template makeKing(id, pal, backMat, suit) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
      cardIndices(rankPath: glyphK, suit: suit)
      courtField()
      courtFaceBorder()
      courtKing()
    }
  }
}

template makeBack(id, pal, backMat) {
  prototype id {
    document {
      schema: "puck.creation.v1"
      name: id
      palette: pal
      cardBase(backMat: backMat)
    }
  }
}

// Expands the 52 faces and the back of one variant ("light" or "dark") as prototypes named `<prefix>-<suit>-<rank>` and
// `<prefix>-back`.
template cardDeckPrototypes(variant, prefix = "card") {
  for (deck, d) in filter(cardVariants, v => v["name"] == variant) {
    for (suit, s) in suits {
      makeAce(id: $"""{prefix}-{suit["code"]}-a""", pal: deck["palette"], backMat: backSlot, suit: suit)
      for (rank, r) in pipRanks {
        makePipCard(
          id: $"""{prefix}-{suit["code"]}-{rank["code"]}""",
          pal: deck["palette"],
          backMat: backSlot,
          rankGlyph: rank["glyph"],
          suit: suit,
          pips: rank["pips"]
        )
      }
      makeJack(id: $"""{prefix}-{suit["code"]}-j""", pal: deck["palette"], backMat: backSlot, suit: suit)
      makeQueen(id: $"""{prefix}-{suit["code"]}-q""", pal: deck["palette"], backMat: backSlot, suit: suit)
      makeKing(id: $"""{prefix}-{suit["code"]}-k""", pal: deck["palette"], backMat: backSlot, suit: suit)
    }
    makeBack(id: $"{prefix}-back", pal: deck["palette"], backMat: backSlot)
  }
}
