  shape Prism "body" {
    position [0, 0, 0]
    scale [cardHalfWidth, cardHalfHeight, cardHalfThickness]
    material: 0
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.08
    }
  }
  cardFaceBorder()
  cardFaceOrnaments()
  shape Prism "back-plate" {
    position [0, 0, 0.021]
    scale [0.79, 1.15, 0.002]
    material: backMat
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.06
    }
  }
  shape Prism "back-hairline" {
    position [0, 0, 0.022]
    scale [0.73, 1.09, 0.002]
    material: 2
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.04
    }
  }
  shape Prism "back-inner-field" {
    position [0, 0, 0.023]
    scale [0.71, 1.07, 0.002]
    material: backMat
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.035
    }
  }
  shape Prism "back-medallion" {
    position [0, 0, 0.024]
    scale [0.24, 0.32, 0.002]
    material: 2
    profile {
      kind: "RoundedRectangle"
