// Each pip is [x, y, flipped]. Pips are drawn at cardPipSize, large enough to read from a seat across a table: two
// columns of cardPipColumn either side of the card's centre line, rows from the top to the bottom of the field, and a
// flipped lower half as on a printed card.
let cardPipColumn = 0.36
