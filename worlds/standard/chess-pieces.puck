// A chess set in miniature: the six pieces of the Staunton pattern, each turned from a few primitives on a two-step
// foot, sized to stand on a 10 cm square. A module library: it hands its importers the pieces' kinds and a template
// that expands their prototypes, and emits no document. A game station's holodeck stands them on its board as rigid
// bodies while it shows chess (../games/chess-station.puck).
//
//   import "../standard/chess-pieces"
//   prototypes { chessPiecePrototypes(prefix: "piece", sides [{ name: "white", body: {...}, trim: {...} }, ...]) }
//
// expands `piece-white-pawn` to `piece-black-king`. A side's `body` and `trim` are palette entries: the turned body, and
// the foot's rim, the collars and the finials, which pick each piece out against a square of either colour. A piece
// stands on its origin; the knight's muzzle points toward +X, so a player at the -Z side sees it in profile.

// The kinds in the order of the chess vocabulary's piece codes (PieceKind 1 to 6, ../games/chess.puck): a piece of kind
// k is code k + 1 for the side that plays up the board and -(k + 1) for the other.
let chessPieceKinds = ["pawn", "knight", "bishop", "rook", "queen", "king"]

// The foot every piece stands on: a rim in the trim, and a step in the body over it.
template chessPieceFoot() {
  shape Cylinder "foot" {
    material: 1
    position [0, 0.004, 0]
    scale [0.032, 0.004, 0.032]
    chamfer: 0.002
  }
  shape Cylinder "step" {
    material: 0
    position [0, 0.0125, 0]
    scale [0.027, 0.0045, 0.027]
    chamfer: 0.002
  }
}

// A collar in the trim at `y`, `r` across.
template chessPieceCollar(name, y, r) {
  shape Cylinder name {
    material: 1
    position [0, y, 0]
    scale [r, 0.0025, r]
  }
}

template chessPieceShapes(kind) {
  chessPieceFoot()
  if kind == "pawn" {
    shape Cone "body" {
      material: 0
      position [0, 0.036, 0]
      scale [0.019, 0.019, 0.019]
    }
    chessPieceCollar(name: "collar", y: 0.044, r: 0.0145)
    shape Sphere "head" {
      material: 0
      position [0, 0.058, 0]
      scale [0.013, 0.013, 0.013]
    }
  } else if kind == "rook" {
    shape Cylinder "body" {
      material: 0
      position [0, 0.04, 0]
      scale [0.0185, 0.023, 0.0185]
    }
    chessPieceCollar(name: "collar", y: 0.06, r: 0.021)
    shape Cylinder "tower" {
      material: 0
      position [0, 0.069, 0]
      scale [0.023, 0.007, 0.023]
      chamfer: 0.002
    }
    for (turn, k) in [0, 90] {
      shape Box $"crenel-{k}" {
        blend: "Subtraction"
        material: 0
        position [0, 0.076, 0]
        rotation: rotate([0, 1, 0], turn)
        scale [0.03, 0.005, 0.0045]
      }
    }
  } else if kind == "bishop" {
    shape Cone "body" {
      material: 0
      position [0, 0.04, 0]
      scale [0.018, 0.023, 0.018]
    }
    chessPieceCollar(name: "collar", y: 0.055, r: 0.015)
    shape Ellipsoid "mitre" {
      material: 0
      position [0, 0.071, 0]
      scale [0.012, 0.017, 0.012]
    }
    shape Box "slit" {
      blend: "Subtraction"
      material: 0
      position [0.005, 0.076, 0]
      rotation: rotate([0, 0, 1], 35)
      scale [0.0016, 0.009, 0.02]
    }
    shape Sphere "finial" {
      material: 1
      position [0, 0.091, 0]
      scale [0.0045, 0.0045, 0.0045]
    }
  } else if kind == "knight" {
    // The horse's head is carved from a slab, as a Staunton knight is: its neck and its head as two convex outlines in
    // the XY plane, extruded 2.2 cm along Z, so a player across the board sees its profile, the muzzle toward +X.
    shape Cylinder "body" {
      material: 0
      position [0, 0.03, 0]
      scale [0.018, 0.013, 0.018]
    }
    shape Prism "neck" {
      material: 0
      position [-0.002, 0.0475, 0]
      scale [0.016, 0.0305, 0.011]
      profile {
        kind: "Convex"
        vertices [[-1, 0.082], [-0.625, 1], [0.375, 0.803], [0.875, 0.082], [1, -1], [-0.875, -1]]
      }
      rounding: 0.002
    }
    shape Prism "head" {
      material: 0
      position [0.0065, 0.072, 0]
      scale [0.0185, 0.016, 0.0095]
      profile {
        kind: "Convex"
        vertices [[-1, 1], [-0.027, 0.75], [1, -0.375], [1, -0.875], [0.081, -1], [-0.892, -0.5]]
      }
      rounding: 0.002
    }
    shape Box "mane" {
      material: 1
      position [-0.0165, 0.063, 0]
      rotation: rotate([0, 0, 1], -12)
      scale [0.003, 0.016, 0.0115]
      rounding: 0.0015
    }
    shape Cone "ear" {
      material: 1
      position [-0.008, 0.091, 0]
      scale [0.004, 0.005, 0.004]
    }
    for z in [-0.0098, 0.0098] {
      shape Sphere $"eye-{z}" {
        material: 1
        position [0.007, 0.077, z]
        scale [0.0022, 0.0022, 0.0022]
      }
    }
  } else if kind == "queen" {
    shape Cone "body" {
      material: 0
      position [0, 0.045, 0]
      scale [0.02, 0.028, 0.02]
    }
    chessPieceCollar(name: "collar", y: 0.066, r: 0.016)
    shape Cone "crown" {
      material: 0
      position [0, 0.077, 0]
      rotation: rotate([1, 0, 0], 180)
      scale [0.018, 0.009, 0.018]
    }
    for k in range(0, 8) {
      shape Sphere $"point-{k}" {
        material: 1
        position: polarPoint(0.0165, (45 * k), 0.086)
        scale [0.003, 0.003, 0.003]
      }
    }
    shape Sphere "orb" {
      material: 1
      position [0, 0.09, 0]
      scale [0.006, 0.006, 0.006]
    }
  } else {
    shape Cone "body" {
      material: 0
      position [0, 0.046, 0]
      scale [0.021, 0.03, 0.021]
    }
    chessPieceCollar(name: "collar", y: 0.068, r: 0.017)
    shape Cone "crown" {
      material: 0
      position [0, 0.079, 0]
      rotation: rotate([1, 0, 0], 180)
      scale [0.017, 0.009, 0.017]
    }
    shape Cylinder "cap" {
      material: 0
      position [0, 0.089, 0]
      scale [0.012, 0.002, 0.012]
    }
    shape Box "cross" {
      material: 1
      position [0, 0.1, 0]
      scale [0.0028, 0.01, 0.0028]
    }
    shape Box "bar" {
      material: 1
      position [0, 0.103, 0]
      scale [0.008, 0.0028, 0.0028]
    }
  }
}

template chessPiecePrototypes(prefix, sides) {
  for side in sides {
    for kind in chessPieceKinds {
      prototype $"{prefix}-{side.name}-{kind}" {
        document {
          name: $"{prefix}-{side.name}-{kind}"
          schema: "puck.creation.v2"
          palette [side.body, side.trim]
          chessPieceShapes(kind: kind)
        }
      }
    }
  }
}
