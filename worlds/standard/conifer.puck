// Conifers: a fir built from tiers of cones, each with a puffed hem, over a short trunk, cartoony and chunky like the
// broadleaf families in foliage.puck. The same tree stands plain, strung with bulbs, or as a fibre-optic tree whose
// bough tips glow in colours that cycle. Every look value is an argument with a default; a world overrides it.
let firNeedles = ["#2E6B45", "#3B7D4E", "#4C9058"]
// The classic multicolour string: red, green, blue, orange and yellow.
let firBulbs = ["#FF1E1E", "#18C83C", "#1E50FF", "#FF7A0A", "#FFC81E"]
// Fibre tips in three groups; each group's glow follows its own world lane, so the tree's colour wheels around.
let firFibers = ["#FF2EC8", "#22D8FF", "#FFB21E"]

// A tier's shape, by its index t of `tiers`, in the tree's unscaled frame: the cone stands on `firBase`, is
// 2 * `firHalf` tall and `firRim` wide at its foot, and its hem's equator sits at `firHem`.
function firBase(t, tiers) = 0.55 + t * 3.3 / tiers
function firHalf(t, tiers) = 0.95 - t * 0.3 / tiers
function firRim(t, tiers) = 1.55 - t * 1.2 / tiers
function firHem(t, tiers) = 0.6 + t * 3.3 / tiers

// The k-th point of the R2 low-discrepancy sequence (the plastic number's inverse powers): points that look random but
// never clump or leave holes, which a seeded hash cannot promise.
function firSpreadU(k) = fraction(0.5 + k * 0.7548776662)
function firSpreadV(k) = fraction(0.5 + k * 0.5698402910)
// The share of the tree's height a point lands at: 1 - sqrt(1 - v) puts more points on the wider lower tiers, about
// in proportion to their area, so the spacing stays even from top to bottom.
function firLift(k) = 1 - squareRoot(1 - firSpreadV(k))
function firTier(k, tiers) = floor(firLift(k) * tiers)
function firSlope(k, tiers) = 0.12 + 0.38 * fraction(firLift(k) * tiers)

// One world lane's value for fibre group `g` of `groups`: a soft hump that rises and falls once per turn of `clock`,
// each group a share of the turn behind the last. Bind three of these in `render.lanes` and point `fiberLanes` at them.
function firFiberLane(clock, g, groups = 3, span = 60, steps = 24) = {
  clock: clock
  keys: map(range(0, steps + 1), i => {
    at: i * span / steps
    value: 0.15 + 0.85 * maximum(0, cosine(6.283185307 * (i / steps - g / groups)))
  })
}

template firTree(id, height = 1, spread = 1, tiers = 5, needles = firNeedles, bark = "#4A3424", lights = false, bulbs = firBulbs, bulbCount = 46, bulbGlow = 70, fiber = false, fibers = firFibers, fiberLanes = [
  5, 6, 7
], fiberCount = 150, fiberGlow = 90) {
  prototype $"{id}" {
    document {
      schema: "puck.creation.v1"
      name: fiber ? "fir-tree-fiber" : (lights ? "fir-tree-lit" : "fir-tree")
      palette: concat(
        [{ color: bark, roughness: 0.95, specular: 0.02 }],
        map(needles, c => { color: c, roughness: 0.92, specular: 0.02, wrap: 0.45 }),
        lights ? map(bulbs, c => { color: c, roughness: 0.25, specular: 0.3, emissive: bulbGlow }) : [],
        fiber ? map(range(0, length(fibers)), g => {
          color: fibers[g]
          roughness: 0.3
          emissive: fiberGlow
          emissiveLane: fiberLanes[g]
        }) : []
      )
      shape Cylinder "trunk" {
        position [0, 0.55 * height, 0]
        scale [0.16 * spread, 0.55 * height, 0.16 * spread]
        material: 0
      }
      shape Cylinder "flare" {
        position [0, 0.08 * height, 0]
        scale [0.26 * spread, 0.08 * height, 0.26 * spread]
        rounding: 0.05
        material: 0
        blend: SmoothUnion
        smooth: 0.12
      }
      // The next tier's skirt hides this one's apex, so the silhouette steps the way a cartoon fir does.
      for t in range(0, tiers) {
        shape Cone $"tier-{t}" {
          position [0, (firBase(t, tiers) + firHalf(t, tiers)) * height, 0]
          scale [firRim(t, tiers) * spread, firHalf(t, tiers) * height, firRim(t, tiers) * spread]
          material: 1 + t % length(needles)
          blend: SmoothUnion
          smooth: 0.14
        }
      }
      // A puffed lip under each tier rounds its hem, so the tiers read as soft boughs rather than paper cones.
      for t in range(0, tiers) {
        shape Superellipsoid $"hem-{t}" {
          exponent: 2.6
          position [0, firHem(t, tiers) * height, 0]
          scale [(firRim(t, tiers) - 0.05) * spread, 0.16 * height, (firRim(t, tiers) - 0.05) * spread]
          material: 1 + t % length(needles)
          blend: SmoothUnion
          smooth: 0.18
        }
      }
      // A bulb rides its tier's skirt a share s up the slope, where the cone's radius is rim * (1 - s), and hangs a
      // little proud of it. It is a C9's teardrop: taller than wide.
      if lights {
        for k in range(0, bulbCount) {
          let t = firTier(k, tiers)
          let s = firSlope(k, tiers)
          shape Superellipsoid $"bulb-{k}" {
            exponent: 2
            position: polarPoint(
              firRim(t, tiers) * spread * (1 - s) + 0.07,
              360 * firSpreadU(k),
              (firBase(t, tiers) + 2 * firHalf(t, tiers) * s) * height
            )
            scale [0.055, 0.085, 0.055]
            material: 1 + length(needles) + k % length(bulbs)
          }
        }
      }
      // Fibre tips stud the boughs' hems and skirts: tiny points in three colour groups spread by the same sequence.
      if fiber {
        for k in range(0, fiberCount) {
          let t = firTier(k, tiers)
          let s = firSlope(k, tiers) - 0.12
          shape Sphere $"fiber-{k}" {
            position: polarPoint(
              (firRim(t, tiers) - 0.04) * spread * (1 - 0.6 * s) + 0.02,
              360 * firSpreadU(k),
              (firHem(t, tiers) + 2.2 * firHalf(t, tiers) * s) * height
            )
            scale [0.03, 0.03, 0.03]
            material: 1 + length(needles) + (lights ? length(bulbs) : 0) + k % length(fibers)
          }
        }
      }
    }
  }
}
