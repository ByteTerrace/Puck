// The standard's sky presets, a library: each template lowers to the ordinary `render.sky` or `render.atmosphere` rows
// it spells, so a look needs no runtime concept and a world overrides any field after applying one. Import the module
// and expand a sky preset inside a world's `sky` block, which then holds the preset's layers, and its air inside the
// `atmosphere` block:
//
//   import "../standard/skies"
//   render {
//     sky { clearDay(cloudiness: 0.4) }
//     atmosphere { clearDayAir() }
//   }
//
// A layer the presets name can be keyed by the section's keys like any authored layer. A world that authors no sky renders
// the engine's default look (`SdfSky`), the two-stop gradient, and one that authors no atmosphere the default fog every
// unauthored world shares (`SdfAtmosphere`).
//
// A layer's colours are in units of its `luminance`, in nits. A day preset takes the default, a clear day's 10,000 nits,
// so its pale horizon shows about 7,000 and its sky stands beside a 100,000-lux sun as the real one does; a night preset
// passes its own, a dark sky's few nits, for a world whose exposure adapts down to night.

// A clear day: a pale horizon under a deep zenith, a sun disc about the first shadowed light, and a cloud layer whose
// coverage is the cloudiness, drawn from `cloudTier` up. Its air is `clearDayAir`.
template clearDay(cloudiness = 0.25, sunLight = 0, cloudTier = low) {
  layers [
    gradient(name: "air", stops: [
      { elevation: -1, color: dayStops[0] }
      { elevation: 0, color: dayStops[1] }
      { elevation: 0.4, color: dayStops[2] }
      { elevation: 1, color: dayStops[3] }
    ])
    sunDisc(name: "sun", light: sunLight, radius: 0.53deg, intensity: 12, color: "#FFF1D6")
    clouds(name: "cumulus", coverage: cloudiness, scale: 2, softness: 0.3, drift: [0.02, 0.005], tier: cloudTier)
  ]
}

// A starry night: a near-black gradient and a share of twinkling stars, at a night sky's luminance.
template starryNight(density = 48, brightness = 1.2, luminance = 2) {
  layers [
    gradient(name: "air", luminance: luminance, stops: [
      { elevation: -1, color: "#020306" }
      { elevation: 1, color: "#070B16" }
    ])
    stars(
      name: "stars",
      luminance: luminance,
      density: density,
      brightness: brightness,
      seed: 7,
      twinkle: { share: 0.3, depth: 0.5, rate: 1 }
    )
  ]
}

// A polar night: the starry night under aurora curtains, lit and turned by the given clock.
template polarNight(clock, intensity = 1.5, density = 48, luminance = 2) {
  layers [
    gradient(name: "air", luminance: luminance, stops: [
      { elevation: -1, color: "#020306" }
      { elevation: 1, color: "#060C18" }
    ])
    stars(name: "stars", luminance: luminance, density: density, brightness: 1, seed: 11)
    aurora(
      name: "curtains",
      luminance: luminance,
      intensity: intensity,
      color: "#3DFFB0",
      top: "#7A4CFF",
      base: 15deg,
      height: 25deg,
      clock: clock,
      tier: medium
    )
  ]
}

// An overcast day: a grey gradient under a thick, slow cloud deck, a tenth of a clear day's luminance. Its air is
// `overcastAir`.
template overcast(cover = 0.85, luminance = 3200) {
  layers [
    gradient(name: "air", luminance: luminance, stops: [
      { elevation: -1, color: "#4A4F55" }
      { elevation: 1, color: "#9AA3AB" }
    ])
    clouds(
      name: "deck",
      luminance: luminance,
      coverage: cover,
      scale: 3,
      softness: 0.6,
      color: "#C9CED3",
      drift: [0.006, 0.002]
    )
  ]
}

// The day cycle's sky through the day: at each hour, the stops of `clearDay`'s gradient (at the elevations it gives
// them), the luminance the gradient and the clouds show at, whether the hour is night (whose luminance is `dayCycle`'s
// `nightLuminance`), and the stars' opacity. Midnight to dawn is night, a blue twilight about sunrise and sunset, and the
// clear day between nine and fifteen.
let dayStops = ["#5E6A72", "#CFDCE6", "#7FAED4", "#2F5C8C"]
let morningStops = ["#5A6670", "#E6D6C4", "#86B0D4", "#2F5C8C"]
let sunriseStops = ["#4E4650", "#F0A070", "#8EA6CC", "#33588A"]
let twilightStops = ["#141626", "#3C3A58", "#2A3866", "#121C3A"]
let nightStops = ["#020306", "#04060C", "#060A16", "#070B16"]
let daySkyHours = [
  { hour: 0, stops: nightStops, luminance: 0, night: 1, stars: 1 }
  { hour: 4.5, stops: nightStops, luminance: 0, night: 1, stars: 1 }
  { hour: 5.25, stops: twilightStops, luminance: 60, night: 0, stars: 0.3 }
  { hour: 6, stops: sunriseStops, luminance: 2500, night: 0, stars: 0 }
  { hour: 7, stops: morningStops, luminance: 7000, night: 0, stars: 0 }
  { hour: 9, stops: dayStops, luminance: 10000, night: 0, stars: 0 }
  { hour: 15, stops: dayStops, luminance: 10000, night: 0, stars: 0 }
  { hour: 17, stops: morningStops, luminance: 7000, night: 0, stars: 0 }
  { hour: 18, stops: sunriseStops, luminance: 2500, night: 0, stars: 0 }
  { hour: 18.75, stops: twilightStops, luminance: 60, night: 0, stars: 0.3 }
  { hour: 19.5, stops: nightStops, luminance: 0, night: 1, stars: 1 }
]

// One degree in radians, pi / 180.
let sunRadiansPerDegree = 3.141592653589793 / 180
// Fifteen degrees in radians, one hour of the sun's turn (pi / 12).
let sunRadiansPerHour = 3.141592653589793 / 12

// The sun's hour angle at clock hour `h`: zero at noon, a quarter turn at six.
function sunHourAngle(h) = (h - 12) * sunRadiansPerHour

// The direction the sun's light travels at clock hour `h`: due east of `heading` degrees at six, `noonElevation` degrees
// up at noon.
function sunDirection(h, heading, noonElevation) = [
  (((0 - sine(sunHourAngle(h))) * cosine(heading * sunRadiansPerDegree)) + (cosine(sunHourAngle(h)) * cosine(
    noonElevation * sunRadiansPerDegree
  ) * sine(heading * sunRadiansPerDegree))),
  (cosine(sunHourAngle(h)) * sine(noonElevation * sunRadiansPerDegree)),
  (((0 - sine(sunHourAngle(h))) * sine(heading * sunRadiansPerDegree)) - (cosine(sunHourAngle(h)) * cosine(
    noonElevation * sunRadiansPerDegree
  ) * cosine(heading * sunRadiansPerDegree)))
]

// The time of day as one clock: the sun's direction, colour and illuminance on the light named `key`, and the sky about
// it (`clearDay`'s gradient, disc and clouds, and stars that come out at night), all keyed on a state clock whose row of
// the same name holds the day's phase, advancing one day every `daySeconds`. Expand it in a document fragment of its own
// that the world imports, beside the document authoring the `key` directional's other fields, since one source's second
// `render` block replaces the first's members. The sun rises due east of `heading` at six, culminates at
// `noonElevation` degrees at noon and sets at eighteen, at `peak` lux times the cosine of its hour angle, and casts no
// light below the horizon; it is `horizonColor` until seven and from seventeen, and `noonColor` between. The day starts
// at `start` hours. The template authors the moon, a directional named `moon` whose `shadow: auto` lets it take a shadow
// slot once the sun has set; a world restyles it with `moonPeak` and `moonColor`, or overrides the row by its name. It
// stands opposite the sun, at `moonPeak` lux times the cosine of its hour angle, in `moonColor`. The clear day's sky shows
// at `dayLuminance` nits, a real clear sky's beside a 100,000-lux sun, and the morning and evening skies in
// proportion; the night sky's gradient shows at `nightLuminance` nits and its stars at `starLuminance`. Writing the
// row moves the time (`world.state.cell.set <clock> $value 0.5` is noon), and its
// advance holds the sun (`world.row.set state <clock> advance {"perSecondNumerator":0,"perSecondDenominator":1}`) and
// runs it again (the numerator back to one over `daySeconds`). The exposure is the world's to key on the same clock
// (`render.exposure`'s `minimum`, `maximum`, `compensation` and `ev100` take `{ clock, keys }`).
template dayCycle(clock = "day", daySeconds = 1440, start = 10, noonElevation = 60, heading = 0, peak = 100000, noonColor = "#FFF0DC", horizonColor = "#FFB278", cloudiness = 0.25, cloudTier = low, sunLight = 0, moonPeak = 0.25, moonColor = "#C8D4FF", nightLuminance = 2, starLuminance = 2, dayLuminance = 18000) {
  timeline {
    clocks [{ name: clock, state: clock, spanSeconds: 24h }]
  }
  state {
    world [
      {
        name: clock
        kind: "Fixed"
        value: $"{start / 24}"
        advance { perSecondNumerator: 1, perSecondDenominator: daySeconds }
      }
    ]
  }
  render {
    lighting {
      lights [
        directional(name: "moon", direction: [0, 1, 0], color: moonColor, illuminance: 0lx, shadow: auto)
      ]
      clock: clock
      keys: map(range(0, 24), h => {
        at: h * 3600
        lights {
          key: directional(
            direction: sunDirection(h, heading, noonElevation),
            color: ((h <= 7) or (h >= 17)) ? horizonColor : noonColor,
            illuminance: peak * maximum(0, cosine(sunHourAngle(h)))
          )
          moon: directional(
            direction: map(sunDirection(h, heading, noonElevation), component => component * (0 - 1)),
            color: moonColor,
            illuminance: moonPeak * maximum(0, 0 - cosine(sunHourAngle(h)))
          )
        }
      })
    }
    sky {
      layers [
        gradient(name: "air", stops: [
          { elevation: -1, color: dayStops[0] }
          { elevation: 0, color: dayStops[1] }
          { elevation: 0.4, color: dayStops[2] }
          { elevation: 1, color: dayStops[3] }
        ])
        sunDisc(name: "sun", light: sunLight, radius: 0.53deg, intensity: 12, color: "#FFF1D6")
        clouds(name: "cumulus", coverage: cloudiness, scale: 2, softness: 0.3, drift: [0.02, 0.005], tier: cloudTier)
        stars(name: "stars", luminance: starLuminance, density: 48, brightness: 1.2, seed: 7, opacity: 0)
      ]
      clock: clock
      keys: map(daySkyHours, k => {
        at: k["hour"] * 3600
        layers {
          air: gradient(
            luminance: (k["luminance"] * dayLuminance / 10000) + (k["night"] * nightLuminance),
            stops: map(k["stops"], color => { color: color })
          )
          cumulus: clouds(luminance: (k["luminance"] * dayLuminance / 10000) + (k["night"] * nightLuminance))
          stars: stars(opacity: k["stars"])
        }
      })
    }
  }
}

// A clear day's air: a light fog in-scattering the sky, thin enough that terrain 500 to 750 m out keeps about two thirds
// of its light and a 6 km draw distance fades to sky.
template clearDayAir() {
  fog {
    density: 0.0006
  }
}

// An overcast day's air: a denser fog in-scattering the sky.
template overcastAir() {
  fog {
    density: 0.01
  }
}
