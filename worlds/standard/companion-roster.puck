// The companion roster: the companions a character keeps, one of them active at a time (docs/decisions/play.md,
// "Companions live on the menu's companions page"). A library: it hands its importers a template and emits no document,
// and it names no kind of companion: which kinds a world set offers, what each looks like and which a character starts
// with are the importing world's.
//
// A kind is { kind, id, name, prototype }: `kind` its number, 1 or more (0 is no kind: the companion wears its world's
// own look); `id` a name for rows and looks; `name` what the menu calls it; `prototype` the creation a companion of
// that kind wears.
//
// What a character keeps is its body's registers, which cross into every world the body enters:
//
//   rosterKeeps<kind>   1 while the body keeps a companion of that kind
//   companionActive     the kind of the active companion, 0 for none
//
// The character's own list is the identity's `companionRoster` record pool (identity.puck), a crossing pool the account
// carries across worlds. Nothing writes it yet: keeping a kind's record once, and reading the pool back with `record(…)`
// as the standard's marks do (marks.puck), waits for a way to meet and befriend a companion; until then a character
// starts each session with the granted kinds. Saving through identity facts was tried and set aside: in the debug world
// it priced the rules past the tick's work budget.
//
// A companion's body wears its kind's look while its own `companionKind` register names the kind: the look
// assignment's `companion` selector reads it (companion.puck's `companion(roster: true)` keeps it in step with its
// owner's `companionActive`). Swapping the active companion is one write of `companionActive` (the menu's companions
// page does it), and the companion changes what it wears on the next tick.
//
//   import "../standard/companion-roster"
//   companionRoster(kinds: [{ kind: 1, id: "wisp", name: "Wisp", prototype: "wisp" }], granted: [1])

// The most kinds a roster offers: the active register's range.
let rosterLimit = 255

// The roster of `kinds`. `granted` lists the kinds every player's character starts with: a body that does not keep
// one is given it, and the first granted kind becomes its active companion while it has none.
template companionRoster(kinds, granted = []) {
  let first = (length(granted) > 0) ? granted[0] : 0

  state {
    body: concat(
      [
        // The kind a companion's body wears, 0 for its world's own look.
        {
          name: "companionKind"
          kind: "Counter"
          initial: 0
          envelope { $type: "range", minimum: 0, maximum: rosterLimit }
        }
        {
          name: "companionActive"
          kind: "Counter"
          initial: 0
          envelope { $type: "range", minimum: 0, maximum: rosterLimit }
        }
      ],
      map(
        kinds,
        k => { name: $"rosterKeeps{k.kind}", kind: "Counter", initial: 0, envelope { $type: "set", values [0, 1] } }
      )
    )
  }

  // A companion's body wears its kind's look while its register names the kind.
  looks {
    assignment {
      select [
        {
          name: "companion"
          bodyState: "companionKind"
          cases: map(kinds, k => { value: k.kind, row: $"companion-{k.id}" })
        }
      ]
    }
    rows: map(kinds, k => {
      name: $"companion-{k.id}"
      scale: 1
      source: creation(prototypeId: k.prototype)
      motion {
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
      }
    })
  }

  // Every player's body is given the granted kinds it does not keep, and the first of them while nothing is active.
  for kindNumber in granted {
    rule $"roster-grant-{kindNumber}" {
      forEach: $players
      when bodyState(each, $"rosterKeeps{kindNumber}") == 0
      mode: Level
      setBodyState(key: $each, state: $"rosterKeeps{kindNumber}", expression: 1)
    }
  }
  if first != 0 {
    rule "roster-first" {
      forEach: $players
      when bodyState(each, companionActive) == 0 and bodyState(each, $"rosterKeeps{first}") == 1
      mode: Level
      setBodyState(key: $each, state: "companionActive", expression: first)
    }
  }
}
