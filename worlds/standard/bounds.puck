// Boxes given their bounds, for shells, furniture and frames built from boxes, and for regions. A module library: it
// hands its importers functions and templates and emits no document.

// The centre and the half-extents of a box given its bounds `{ x0, x1, y0, y1, z0, z1 }`, as a region's placement
// position and its `halfExtents` spell it.
function boundsCentre(box) = [((box.x0 + box.x1) / 2), ((box.y0 + box.y1) / 2), ((box.z0 + box.z1) / 2)]
function boundsHalf(box) = [((box.x1 - box.x0) / 2), ((box.y1 - box.y0) / 2), ((box.z1 - box.z0) / 2)]

// One box given its world bounds, for a creation standing at the origin with no yaw: the author frame is turned 180
// degrees about up from the world's, so the row negates x and z. `bevel` chamfers it (0 leaves the box's own fillet).
template boundsBox(label, x0, x1, y0, y1, z0, z1, slot, bevel = 0) {
  shape Box $"{label}" {
    material: slot
    position [(0 - ((x0 + x1) / 2)), ((y0 + y1) / 2), (0 - ((z0 + z1) / 2))]
    scale [((x1 - x0) / 2), ((y1 - y0) / 2), ((z1 - z0) / 2)]
    chamfer: bevel
  }
}

// The same box with its edges rounded by `rounding`, for a thick shell's soft corners.
template boundsRound(label, x0, x1, y0, y1, z0, z1, slot, rounding) {
  shape Box $"{label}" {
    material: slot
    position [(0 - ((x0 + x1) / 2)), ((y0 + y1) / 2), (0 - ((z0 + z1) / 2))]
    scale [((x1 - x0) / 2), ((y1 - y0) / 2), ((z1 - z0) / 2)]
    rounding: rounding
  }
}

// One storey of wall running along x between `z0` and `z1`, from `x0` to `x1` and `y0` to `y1`, as the union of boxes
// round its openings: each opening `{ a0, a1, y0, y1 }` spans `a0 .. a1` along the wall from `y0` to `y1` above the
// storey's base, the openings in ascending order and clear of one another. A pier stands between neighbours, a sill
// under each opening that starts above the base and a head over each that stops short of the top.
function wallEdges(start, openings) = concat([{ a1: start }], openings)
template wallAlongX(label, x0, x1, y0, y1, z0, z1, openings, slot) {
  for (open, i) in openings {
    for from in (((open.a0 - wallEdges(x0, openings)[i].a1) > 0.001) ? [wallEdges(x0, openings)[i].a1] : []) {
      boundsBox(label: $"{label}-pier-{i}", x0: from, x1: open.a0, y0: y0, y1: y1, z0: z0, z1: z1, slot: slot)
    }
    for sill in ((open.y0 > 0.001) ? [open.y0] : []) {
      boundsBox(label: $"{label}-sill-{i}", x0: open.a0, x1: open.a1, y0: y0, y1: (y0 + sill), z0: z0, z1: z1, slot: slot)
    }
    for head in (((y0 + open.y1) < (y1 - 0.001)) ? [open.y1] : []) {
      boundsBox(label: $"{label}-head-{i}", x0: open.a0, x1: open.a1, y0: (y0 + head), y1: y1, z0: z0, z1: z1, slot: slot)
    }
  }
  for from in (((x1 - wallEdges(x0, openings)[length(openings)].a1) > 0.001) ? [wallEdges(x0, openings)[length(openings)].a1] : []) {
    boundsBox(label: $"{label}-end", x0: from, x1: x1, y0: y0, y1: y1, z0: z0, z1: z1, slot: slot)
  }
}
// The same wall running along z between `x0` and `x1`, its openings spanning `a0 .. a1` along z.
template wallAlongZ(label, x0, x1, y0, y1, z0, z1, openings, slot) {
  for (open, i) in openings {
    for from in (((open.a0 - wallEdges(z0, openings)[i].a1) > 0.001) ? [wallEdges(z0, openings)[i].a1] : []) {
      boundsBox(label: $"{label}-pier-{i}", x0: x0, x1: x1, y0: y0, y1: y1, z0: from, z1: open.a0, slot: slot)
    }
    for sill in ((open.y0 > 0.001) ? [open.y0] : []) {
      boundsBox(label: $"{label}-sill-{i}", x0: x0, x1: x1, y0: y0, y1: (y0 + sill), z0: open.a0, z1: open.a1, slot: slot)
    }
    for head in (((y0 + open.y1) < (y1 - 0.001)) ? [open.y1] : []) {
      boundsBox(label: $"{label}-head-{i}", x0: x0, x1: x1, y0: (y0 + head), y1: y1, z0: open.a0, z1: open.a1, slot: slot)
    }
  }
  for from in (((z1 - wallEdges(z0, openings)[length(openings)].a1) > 0.001) ? [wallEdges(z0, openings)[length(openings)].a1] : []) {
    boundsBox(label: $"{label}-end", x0: x0, x1: x1, y0: y0, y1: y1, z0: from, z1: z1, slot: slot)
  }
}

// One box given its bounds in the creation's own frame, with no conversion: a painting's, whose x runs across the canvas,
// y up and z out of the wall.
template localBox(label, x0, x1, y0, y1, z0, z1, slot) {
  shape Box $"{label}" {
    material: slot
    position [((x0 + x1) / 2), ((y0 + y1) / 2), ((z0 + z1) / 2)]
    scale [((x1 - x0) / 2), ((y1 - y0) / 2), ((z1 - z0) / 2)]
  }
}

// Three bars (left, right and top) round a canvas of half-width `ix` in the creation's own frame, from `y0` up to `y1`
// and out by `w`, standing `depth` proud of the wall; the floor closes the fourth side.
template barRing(label, ix, y0, y1, w, depth, slot) {
  localBox(label: $"{label}-left", x0: (0 - (ix + w)), x1: (0 - ix), y0: y0, y1: (y1 + w), z0: 0, z1: depth, slot: slot)
  localBox(label: $"{label}-right", x0: ix, x1: (ix + w), y0: y0, y1: (y1 + w), z0: 0, z1: depth, slot: slot)
  localBox(label: $"{label}-top", x0: (0 - ix), x1: ix, y0: y1, y1: (y1 + w), z0: 0, z1: depth, slot: slot)
}

// Four bars lying flat round a square canvas of half-extent `ix`, `w` wide, from height `y0` to `y1`.
template flatRing(label, ix, w, y0, y1, slot) {
  localBox(label: $"{label}-north", x0: (0 - (ix + w)), x1: (ix + w), y0: y0, y1: y1, z0: ix, z1: (ix + w), slot: slot)
  localBox(
    label: $"{label}-south",
    x0: (0 - (ix + w)),
    x1: (ix + w),
    y0: y0,
    y1: y1,
    z0: (0 - (ix + w)),
    z1: (0 - ix),
    slot: slot
  )
  localBox(label: $"{label}-east", x0: ix, x1: (ix + w), y0: y0, y1: y1, z0: (0 - ix), z1: ix, slot: slot)
  localBox(label: $"{label}-west", x0: (0 - (ix + w)), x1: (0 - ix), y0: y0, y1: y1, z0: (0 - ix), z1: ix, slot: slot)
}
