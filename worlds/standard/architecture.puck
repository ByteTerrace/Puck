// Architectural pieces in the canyon-workshop building language (docs/game/art/canyon-workshop-pack): thick cream and
// ochre shells with rounded corners over darker teal recesses, brass trim and small functional lights. A module library:
// it hands its importers palettes and templates and emits no document. Each template takes `base`, the palette slot of
// its palette's first entry, so a creation appends the palette after its own slots and passes where it starts.
import "rig"

// The display plinth's materials, in slot order from `base`: cream shell, ochre body, teal recess, dark screen glass,
// brass, and the warm light of the turntable ring.
let plinthCream = 0
let plinthOchre = 1
let plinthTeal = 2
let plinthScreen = 3
let plinthBrass = 4
let plinthGlow = 5
let plinthPalette = [
  { color: "#EFE3C8", roughness: 0.55, specular: 0.25 }
  { color: "#E0A13A", roughness: 0.45, specular: 0.3 }
  { color: "#2C5A63", roughness: 0.6, specular: 0.2 }
  { color: "#0F5866", roughness: 0.15, specular: 0.5, emissive: 900 }
  { color: "#C8902E", roughness: 0.3, metal: 1 }
  { color: "#FFC46A", roughness: 0.4, emissive: 2.5 }
]

// The console's tilt back from vertical, as its sine and cosine and the quaternion that carries a box's +Z onto the
// face's outward normal.
let plinthTiltSin = 0.4226
let plinthTiltCos = 0.9063
let plinthFace = [-0.2164, 0, 0, 0.9763]

// A point on the console's face: `across` along x, `up` along the face, `out` along its normal, from the face's centre.
let plinthConsole = [0, 0.46, 0.7]
let plinthConsoleDepth = 0.09
let plinthConsoleHalf = [0.79, 0.22]
function plinthOnFace(across, up, out) = [
  across,
  ((plinthConsole[1] + (up * plinthTiltCos)) + ((plinthConsoleDepth + out) * plinthTiltSin)),
  ((plinthConsole[2] - (up * plinthTiltSin)) + ((plinthConsoleDepth + out) * plinthTiltCos))
]
// The console's one glass screen, its half-extents across and up the face: it fills the cream bezel but for a rim.
let plinthGlassHalf = [0.74, 0.18]
let plinthGlassDepth = 0.012

// The console screen's look: a near-black glass the interface glows on at a desktop monitor's brightness, and the
// interface's colours in the kit's own palette (ochre frame, cream, teal and terracotta controls), the ink lettering
// takes on a lit control and the two inks of a list, its chosen row lit amber.
let consoleGlass = { color: "#081315", roughness: 0.12, specular: 0.45, emissive: 260 }
let consoleLook = {
  frame: "#E0A13A"
  cream: "#EFE3C8"
  teal: "#6FB0B4"
  terracotta: "#C46A47"
  ink: "#20160A"
  lit: "#FFC46A"
  dim: "#C9B79A"
  quiet: "#7FB2B6"
  field: "#081315"
}

// A display plinth that faces +Z (docs/game/art/gallery-kit-pack/display-plinth.png): a deep-teal foot, an ochre body
// clad in panels with dark joints between them, a thick bevelled cream cap whose top stands 0.75 m up with a glowing
// turntable ring set in it, and a cream console tilted back across the whole front, its face one glass screen in a cream
// bezel (a display's interface glows on it, gallery shapes.puck). About 1.8 m wide and 1.6 m deep with its console; an
// exhibit stands on the cap from y 0.75. Every shape is a union, so a creation that holds it keeps panels and trims.
let plinthCapTop = 0.75
// The cap's half-extents across (x) and front to back (z), the plinth's widest.
let plinthCapHalf = [0.9, 0.68]
template exhibitPlinth(base) {
  shape Box "plinth-foot" {
    material: (base + plinthTeal)
    position [0, 0.11, 0]
    scale [0.8, 0.11, 0.58]
    chamfer: 0.03
  }
  shape Box "plinth-core" {
    material: (base + plinthScreen)
    position [0, 0.42, 0]
    scale [0.82, 0.2, 0.6]
  }
  for x in [-0.56, 0, 0.56] {
    for z in [-1, 1] {
      shape Box $"plinth-panel-{x}-{z}" {
        material: (base + plinthOchre)
        position [x, 0.42, (z * 0.615)]
        scale [0.265, 0.2, 0.03]
        chamfer: 0.012
      }
    }
  }
  for z in [-0.3, 0.3] {
    for x in [-1, 1] {
      shape Box $"plinth-side-{z}-{x}" {
        material: (base + plinthOchre)
        position [(x * 0.835), 0.42, z]
        scale [0.03, 0.2, 0.285]
        chamfer: 0.012
      }
    }
  }
  shape Box "plinth-cap" {
    material: (base + plinthCream)
    position [0, 0.685, 0]
    scale [plinthCapHalf[0], 0.065, plinthCapHalf[1]]
    chamfer: 0.045
  }
  shape Cylinder "plinth-ring" {
    material: (base + plinthGlow)
    position [0, 0.752, 0]
    scale [0.56, 0.006, 0.56]
  }
  shape Cylinder "plinth-turntable" {
    material: (base + plinthCream)
    position [0, 0.755, 0]
    scale [0.5, 0.01, 0.5]
  }
  shape Box "plinth-console" {
    material: (base + plinthCream)
    position: plinthConsole
    rotation: plinthFace
    scale [plinthConsoleHalf[0], plinthConsoleHalf[1], plinthConsoleDepth]
    chamfer: 0.03
  }
  shape Box "plinth-glass" {
    material: (base + plinthScreen)
    position: plinthOnFace(0, 0, 0)
    rotation: plinthFace
    scale [plinthGlassHalf[0], plinthGlassHalf[1], plinthGlassDepth]
    rounding: 0.01
  }
  // The brass lip under the glass, where a hand rests on the console.
  shape Box "plinth-lip" {
    material: (base + plinthBrass)
    position: plinthOnFace(0, (0.02 - plinthConsoleHalf[1]), 0.006)
    rotation: plinthFace
    scale [(plinthGlassHalf[0] - 0.04), 0.01, 0.01]
    rounding: 0.008
  }
}

// The structure's materials, in slot order from `base`: deep teal steel and its brass inlay.
let structureTeal = 0
let structureBrass = 1
let structurePalette = [
  { color: "#2F6E7A", roughness: 0.6, specular: 0.04 }
  { color: "#C8902E", roughness: 0.3, metal: 1 }
]
let structureAcross = [0.7071, 0, 0, 0.7071]

// A teal branched pier that faces +Z (docs/game/art/gallery-kit-pack/branched-pier-and-arcade.png): a splayed foot that
// narrows to a chamfered shaft, which splits into two arches springing toward ±X, cut by two circles so the haunch above
// the shaft curves out to a band along the ceiling, with three brass inlay strips on the shaft's face where it branches.
// It stands from the floor (y 0) to `height`; each arch reaches `span` metres out from the shaft's centre, where the next
// pier's arch meets it, so piers `2 × span` apart join into an arcade. The foot and the shaft are what a body meets: the
// haunch, the arches and the inlays are `detail`, so a pier collides as its two boxes. `foot`, when given, is the foot's
// exact half width and half depth where it meets the floor, unchamfered so its edge meets the floor there, and the foot
// tapers on all four sides toward the shaft;
// by default it splays from the shaft, tapering on its sides only.
template branchedPier(base, height, span, depth = 0.4, shaft = 0.42, foot = null) {
  shape Prism "pier-foot" {
    material: (base + structureTeal)
    position [0, 0.6, 0]
    scale: ((foot != null) ? [foot[0], 0.6, foot[1]] : [(shaft * 1.5), 0.6, (depth * 1.18)])
    taper: 0.7
    chamfer: ((foot != null) ? 0 : 0.05)
  }
  // A prism tapers along its width only, so a square foot is the meet of two, one turned a quarter about Y.
  if foot != null {
    shape Prism "pier-foot-across" {
      blend: Intersection
      material: (base + structureTeal)
      position [0, 0.6, 0]
      rotation [0, 0.7071, 0, 0.7071]
      scale [foot[1], 0.6, foot[0]]
      taper: 0.7
    }
  }
  shape Box "pier-shaft" {
    material: (base + structureTeal)
    position [0, (height / 2), 0]
    scale [shaft, (height / 2), depth]
    chamfer: 0.06
  }
  shape Box "pier-haunch" {
    material: (base + structureTeal)
    position [0, (height - ((span - shaft) + 0.3) / 2), 0]
    scale [span, (((span - shaft) + 0.3) / 2), (depth * 0.82)]
    chamfer: 0.04
    detail: true
  }
  for side in [-1, 1] {
    shape Cylinder $"pier-arch-{side}" {
      blend: SmoothSubtraction
      smooth: 0.05
      material: (base + structureTeal)
      position [(side * span), ((height - 0.3) - (span - shaft)), 0]
      rotation: structureAcross
      scale [(span - shaft), depth, (span - shaft)]
      detail: true
    }
  }
  for strip in [{ x: 0, half: 0.46 }, { x: -0.13, half: 0.3 }, { x: 0.13, half: 0.3 }] {
    shape Box $"pier-inlay-{strip.x}" {
      material: (base + structureBrass)
      position [strip.x, ((height * 0.6) + (0.46 - strip.half)), (depth + 0.006)]
      scale [0.03, strip.half, 0.014]
      detail: true
    }
  }
}

// The building kit's materials, in slot order from `base`: the cream shell, the ochre cladding, the deep teal frames,
// terracotta, brass, window glass, the fan shades' two oranges and their dark hub, a planter's soil and its three
// greens, and the warm timber of a seat.
let kitCream = 0
let kitOchre = 1
let kitTeal = 2
let kitTerracotta = 3
let kitBrass = 4
let kitGlass = 5
let kitShade = 6
let kitShadeDeep = 7
let kitHub = 8
let kitSoil = 9
let kitLeaf = 10
let kitLeafPale = 11
let kitLeafDeep = 12
let kitTimber = 13
// Every row but the brass is a plain dielectric: a specular above a few hundredths reflects the room over the paint and
// greys it. The glass is nearly clear, so what lies beyond a window keeps its colour.
let kitPalette = [
  { color: "#EFE3C8", roughness: 0.6, specular: 0.04 }
  { color: "#E0A13A", roughness: 0.55, specular: 0.04 }
  { color: "#2F6E7A", roughness: 0.6, specular: 0.04 }
  { color: "#B85A3C", roughness: 0.5, specular: 0.04 }
  { color: "#C8902E", roughness: 0.3, metal: 1 }
  { color: "#EEF8F6", roughness: 0.03, glass { depth: 0.012, ior: 1.5 } }
  { color: "#EE7F2D", roughness: 0.7, specular: 0.04 }
  { color: "#D9661F", roughness: 0.7, specular: 0.04 }
  { color: "#1F3A42", roughness: 0.45, specular: 0.05 }
  { color: "#4A3426", roughness: 0.95, specular: 0.02 }
  { color: "#3F7A3A", roughness: 0.7, specular: 0.04 }
  { color: "#8FB03E", roughness: 0.7, specular: 0.04 }
  { color: "#2F5E38", roughness: 0.7, specular: 0.04 }
  { color: "#B8623A", roughness: 0.55, specular: 0.04 }
]
// A quarter turn that lays a shape's +Y along +X, for a bar or a rail that runs across a piece.
let kitAlong = [0, 0, -0.7071, 0.7071]

// A window bay that faces +Z, the outside (docs/game/art/gallery-kit-pack/window-bay.png): a thick cream head and sill
// with rounded edges and ochre jambs between them, standing proud of a wall `wall` thick whose centre plane is z 0; a
// teal frame set in the opening with a centre mullion, two transoms and two short lower mullions; one pane of glass;
// and the short bracket a fan shade's hub stands on, at the low transom's crossing. The opening is `width` by `height`
// and starts `sill` above the bay's origin on the floor. Every shape is a box joined by union, so the bay collides as
// drawn and glass holds a body in.
function windowHubHeight(height, sill) = (sill + (height * 0.36))
template windowBay(base, width = 3.2, height = 3.3, sill = 0.55, wall = 0.3) {
  shape Box "bay-head" {
    material: (base + kitCream)
    position [0, ((sill + height) + 0.3), 0.03]
    scale [((width / 2) + 0.48), 0.3, ((wall / 2) + 0.13)]
    rounding: 0.09
  }
  shape Box "bay-sill" {
    material: (base + kitCream)
    position [0, (sill - 0.24), 0.05]
    scale [((width / 2) + 0.48), 0.24, ((wall / 2) + 0.19)]
    rounding: 0.07
  }
  for side in [-1, 1] {
    shape Box $"bay-jamb-{side}" {
      material: (base + kitOchre)
      position [(side * ((width / 2) + 0.22)), (sill + (height / 2)), 0.01]
      scale [0.22, (height / 2), ((wall / 2) + 0.06)]
      chamfer: 0.03
    }
    shape Box $"bay-frame-{side}" {
      material: (base + kitTeal)
      position [(side * ((width / 2) - 0.05)), (sill + (height / 2)), 0]
      scale [0.05, (height / 2), 0.055]
    }
    shape Box $"bay-mullion-{side}" {
      material: (base + kitTeal)
      position [(side * (width / 4)), (sill + (height * 0.18)), 0]
      scale [0.028, (height * 0.18), 0.045]
    }
  }
  for bar in [{ y: 0.05, half: 0.05 }, { y: (height - 0.05), half: 0.05 }, { y: (height * 0.36), half: 0.04 }, { y: (height * 0.87), half: 0.028 }] {
    shape Box $"bay-bar-{bar.y}" {
      material: (base + kitTeal)
      position [0, (sill + bar.y), 0]
      scale [(width / 2), bar.half, 0.05]
    }
  }
  shape Box "bay-mullion" {
    material: (base + kitTeal)
    position [0, (sill + (height / 2)), 0]
    scale [0.06, (height / 2), 0.058]
  }
  shape Box "bay-glass" {
    material: (base + kitGlass)
    position [0, (sill + (height / 2)), 0]
    scale [((width / 2) - 0.02), ((height / 2) - 0.02), 0.012]
  }
  shape Box "bay-bracket" {
    material: (base + kitTeal)
    position [0, windowHubHeight(height, sill), 0.14]
    scale [0.06, 0.06, 0.1]
  }
}

// A fan shade (the sheet's orange leaves on a dark hub), facing +Z with its hub at the origin: `leaves` thin tapered
// leaves that stack upright over the hub while `signal` reads 0 and spread into a fan of `spread` degrees as it rises to
// 1, each a little proud of the last so the stack's edges show. The leaves ride one driver, named for the state cell the
// shade follows (`state.<row>.<key>`), through the `dynamics` row the importing world declares under the name it
// passes, so a shade eases open and settles. A leaf is `leaf` of the radius wide at its tip. A creation that holds it is
// animated.
template fanShade(base, signal, dynamics, radius = 1.9, leaves = 6, spread = 150, leaf = 0.42) {
  drivers [
    { name: "spread", signal: signal, cadence: 1, dynamics: dynamics }
  ]
  shape Cylinder "shade-hub" {
    material: (base + kitHub)
    position [0, 0, 0.03]
    rotation: structureAcross
    scale [0.3, 0.045, 0.3]
    rounding: 0.02
  }
  shape Cylinder "shade-rim" {
    material: (base + kitBrass)
    position [0, 0, 0.05]
    rotation: structureAcross
    scale [0.33, 0.018, 0.33]
  }
  shape Cylinder "shade-boss" {
    material: (base + kitBrass)
    position [0, 0, 0.1]
    rotation: structureAcross
    scale [0.09, 0.03, 0.09]
    rounding: 0.015
  }
  for i in range(0, leaves) {
    shape Prism $"shade-leaf-{i}" {
      material: (base + (((i % 2) == 0) ? kitShade : kitShadeDeep))
      position [0, ((radius / 2) + 0.16), (0.1 + (0.02 * i))]
      rotation [0, 0, 1, 0]
      scale [((radius * leaf) / 2), (radius / 2), 0.008]
      taper: 0.16
      swings [
        swing("spread", [0, 0, 1], (((i - ((leaves - 1) / 2)) * (spread / leaves)) * 0.017453293), [0, 0, 0]) with { wave: "linear" }
      ]
    }
  }
}

// A length of balcony edge that runs along X with the drop on its +Z side (the sheet's balcony-and-stair-rail.png):
// teal posts on foot brackets, one pane of glass between the slab and the rail, and a brass handrail `height` above the
// slab the piece stands on. `posts` posts stand evenly inside the length, half a bay in from each end, so lengths laid
// end to end keep one rhythm. Boxes joined by union, so it collides as drawn.
template balustrade(base, length = 4, posts = 3, height = 1.1) {
  for i in range(0, posts) {
    shape Box $"rail-post-{i}" {
      material: (base + kitTeal)
      position [((((i + 0.5) / posts) - 0.5) * length), ((height - 0.06) / 2), 0]
      scale [0.03, ((height - 0.06) / 2), 0.045]
    }
    shape Box $"rail-foot-{i}" {
      material: (base + kitTeal)
      position [((((i + 0.5) / posts) - 0.5) * length), 0.05, 0]
      scale [0.07, 0.05, 0.075]
      chamfer: 0.012
    }
  }
  shape Box "rail-glass" {
    material: (base + kitGlass)
    position [0, ((height / 2) + 0.02), 0]
    scale [(length / 2), ((height / 2) - 0.1), 0.012]
  }
  shape Box "rail-hand" {
    material: (base + kitBrass)
    position [0, height, 0]
    scale [(length / 2), 0.04, 0.05]
    rounding: 0.035
  }
}

// A stair's riser schedule for a body whose size changes along it. A size field (size-field.puck) sizes a body on a
// flight by its height on the standard's geometric curve, `size0 * power(size1 / size0, t)` at the fraction t of the
// flight's rise, and a body's step height is its size times its kit's. A flight of `risers` even risers is built for a
// body of size 1; the schedule keeps each riser the same share of the smaller size its two ends give a body, so the
// flight costs a shrinking or growing body the same effort at every step and reads to an observer as an ordinary
// flight that grows finer toward its small end. With the size's reciprocal stepped evenly over the steps (1 / s at
// step n runs in a straight line from 1 / size0 to 1 / size1), a riser rises a constant share of the size at it, so
// the step boundaries' sizes and heights are closed forms: the riser count, `stairRiserCount`, and the fraction of the
// rise at the top of step n of `count`, `stairStepHeight`. The count rounds up past the share a size-1 body takes, by
// the growth over one step (`size1 / size0`'s larger over its smaller, less one), so a riser never exceeds the share
// at its smaller end. Equal sizes give `risers / size0` even risers: the plain flight at size 1.
function stairRiserCount(risers, size0, size1) = (
  (size0 == size1) ? ceiling((risers / size0)) : ceiling((
      ((risers * absolute(((1 / size1) - (1 / size0)))) / absolute(logarithm((size1 / size0), 2.718281828459045))) +
        ((maximum(size0, size1) / minimum(size0, size1)) - 1)
    ))
)
function stairStepSize(n, count, size0, size1) = (1 / ((1 / size0) + ((((1 / size1) - (1 / size0)) * n) / count)))
function stairStepHeight(n, count, size0, size1) = (
  (size0 == size1) ? (n / count) : logarithm((stairStepSize(n, count, size0, size1) / size0), (size1 / size0))
)

// One straight flight of stairs between `x0` and `x1`, from its foot at z `foot` to its head at z `head` (either way
// along Z), climbing `rise` from `y0`: a tread box for each riser but the last, which steps onto whatever stands at the
// head (a landing, a floor). Each tread is solid down to the flight's foot when `soffit` is 0, or a slab `soffit` thick
// under its top, so a flight can stand over the one a storey below. `risers` is the count a body of size 1 climbs;
// `size0` and `size1` are the sizes a body takes at the flight's foot and head (the stair's riser schedule, above), so
// a flight into a small place grows finer toward it, each tread as deep as its riser is high times the flight's run
// over its rise. Its shape follows from its own rise, run, riser count and sizes alone, so a stair can reshape one
// flight without the others.
template stairFlight(label, material, x0, x1, foot, head, y0, rise, risers, soffit = 0, size0 = 1, size1 = 1) {
  let count = stairRiserCount(risers, size0, size1)
  let run = stairStepHeight((count - 1), count, size0, size1)
  for n in range(1, count) {
    let top = (y0 + (rise * stairStepHeight(n, count, size0, size1)))
    let bottom = ((soffit == 0) ? y0 : (top - soffit))
    let near = (stairStepHeight((n - 1), count, size0, size1) / run)
    let far = (stairStepHeight(n, count, size0, size1) / run)
    shape Box $"{label}-{n}" {
      material: material
      position [((x0 + x1) / 2), ((top + bottom) / 2), (foot + (((head - foot) * (near + far)) / 2))]
      scale [((x1 - x0) / 2), ((top - bottom) / 2), ((absolute((head - foot)) * (far - near)) / 2)]
    }
  }
}

// One storey of a switchback stair that faces +Z (the sheet's balcony-and-stair-rail.png): its footprint `width` by
// `depth` about the origin, the first flight climbing -Z up the +X half from the front edge to a half landing
// `landing` deep across the back, and the second climbing +Z up the -X half back to the front edge, where it arrives on
// the next floor `rise` up; a teal spine between the flights and a glass wall in a teal post along the outside of the
// first flight. Copies stacked a storey apart make one stair, each storey's first flight solid to its foot under the
// next storey's and its second a slab over the one below. `guard` 1 is the top storey's piece, whose next floor has no
// flight to start: it carries the spine and the glass up into a guard round the well, with a rail across the first
// flight's head. `size0` and `size1` are the sizes a body takes at the storey's foot and head on the standard's size
// curve (the stair's riser schedule), the half landing taking the curve's middle, so each flight grows finer toward
// the smaller. Boxes joined by union, so it collides as drawn.
template switchbackStair(base, width = 5, depth = 6.25, landing = 2.5, rise = 4.5, risers = 18, spine = 0.2, guard = 0, rail = 1.1, size0 = 1, size1 = 1) {
  let front = (depth / 2)
  let back = (0 - (depth / 2))
  let half = (rise / 2)
  let flight = (risers / 2)
  let guardTop = ((guard == 1) ? (rise + rail) : rise)
  let sizeHalf = (size0 * power((size1 / size0), 0.5))
  stairFlight(
    label: "stair-up",
    material: (base + kitTerracotta),
    x0: (spine / 2),
    x1: (width / 2),
    foot: front,
    head: (back + landing),
    y0: 0,
    rise: half,
    risers: flight,
    size0: size0,
    size1: sizeHalf
  )
  stairFlight(
    label: "stair-back",
    material: (base + kitTerracotta),
    x0: (0 - (width / 2)),
    x1: (0 - (spine / 2)),
    foot: (back + landing),
    head: front,
    y0: half,
    rise: half,
    risers: flight,
    soffit: 0.45,
    size0: sizeHalf,
    size1: size1
  )
  shape Box "stair-landing" {
    material: (base + kitTerracotta)
    position [0, (half - 0.15), (back + (landing / 2))]
    scale [(width / 2), 0.15, (landing / 2)]
  }
  shape Box "stair-spine" {
    material: (base + kitTeal)
    position [0, (guardTop / 2), (back + ((landing + depth) / 2))]
    scale [(spine / 2), (guardTop / 2), ((depth - landing) / 2)]
  }
  shape Box "stair-glass" {
    material: (base + kitGlass)
    position [((width / 2) + 0.03), (guardTop / 2), (0 - 0.06)]
    scale [0.012, (guardTop / 2), ((depth / 2) - 0.06)]
  }
  shape Box "stair-post" {
    material: (base + kitTeal)
    position [((width / 2) + 0.03), (guardTop / 2), (front - 0.06)]
    scale [0.05, (guardTop / 2), 0.06]
  }
  if (guard == 1) {
    shape Box "stair-guard-glass" {
      material: (base + kitGlass)
      position [((spine + (width / 2)) / 2), (rise + (rail / 2)), (front + 0.05)]
      scale [(((width / 2) - (spine / 2)) / 2), (rail / 2), 0.012]
    }
    shape Box "stair-guard-hand" {
      material: (base + kitBrass)
      position [((spine + (width / 2)) / 2), (rise + rail), (front + 0.05)]
      scale [(((width / 2) - (spine / 2)) / 2), 0.04, 0.05]
      rounding: 0.035
    }
  }
}

// One storey of a spiral stair round a teal newel at the origin: `risers` treads climbing `rise` in a turn of `turn`
// degrees (positive turns from +X toward +Z), starting `start` degrees round (90 is +Z, the front) from the floor the
// stair stands on. Each tread is a terracotta slab `thickness` deep from the newel out to `radius`, wide enough at its
// rim to meet the next, so each riser is closed; the last is the next floor's landing step, reaching `reach` past the
// rim so it meets that floor's edge. Glass panes stand at the rim of every tread but the two either side of that
// landing step under a brass handrail that climbs with them, so a body steps off only onto the next floor. With a turn
// of 360 copies stacked a storey apart make one stair, each storey's landing step under the next storey's start.
// `size0` and `size1` are the sizes a body takes at the storey's foot and head (the stair's riser schedule): the treads
// then grow finer toward the smaller, each turning as far as it rises, so every tread's centre stays on the one helix
// and the panes and handrail keep their even steps along it, each pane reaching half a step below its tread's top so
// the finer treads under it meet its foot. The treads, newel and panes are boxes and a cylinder joined by union and
// collide as drawn; the handrail is drawn only.
template spiralStair(base, radius = 2.5, newel = 0.5, rise = 4.5, risers = 18, turn = 360, start = 90, thickness = 0.3, reach = 0.6, rail = 0.95, size0 = 1, size1 = 1) {
  let step = (turn / risers)
  let halfStep = ((absolute(step) * pi) / 360)
  let rim = (((radius * sine(halfStep)) / cosine(halfStep)) + 0.02)
  let count = stairRiserCount(risers, size0, size1)
  shape Cylinder "spiral-newel" {
    material: (base + kitTeal)
    position [0, (rise / 2), 0]
    scale [newel, (rise / 2), newel]
  }
  for n in range(1, (count + 1)) {
    let height = stairStepHeight(n, count, size0, size1)
    let before = stairStepHeight((n - 1), count, size0, size1)
    // The step past the last mirrors the one before it, so the landing step spans as far beyond its centre as before.
    let after = ((n == count) ? (2 - before) : stairStepHeight((n + 1), count, size0, size1))
    let angle = (start + (turn * ((before + (2 * height) + after) / 4)))
    let half = (((absolute(turn) * (after - before)) * 3.14159265) / 720)
    let outer = ((n == count) ? (radius + reach) : radius)
    let inner = (newel / 2)
    shape Box $"spiral-tread-{n}" {
      material: (base + kitTerracotta)
      position: polarPoint(((inner + outer) / 2), angle, ((rise * height) - (thickness / 2)))
      rotation: rotate([0, 1, 0], (90 - angle))
      scale [(((radius * sine(half)) / cosine(half)) + 0.02), (thickness / 2), ((outer - inner) / 2)]
    }
  }
  for n in range(2, risers - 1) {
    let angle = (start + (step * n))
    let top = ((rise * n) / risers)
    let foot = (rise / (2 * risers))
    shape Box $"spiral-pane-{n}" {
      material: (base + kitGlass)
      position: polarPoint((radius - 0.05), angle, (top + ((rail - foot) / 2)))
      rotation: rotate([0, 1, 0], (90 - angle))
      scale [rim, ((rail + foot) / 2), 0.012]
    }
  }
  for n in range(2, risers - 2) {
    let angle = (start + (step * n))
    let top = ((rise * n) / risers)
    shape Sweep $"spiral-rail-{n}" {
      position [0, 0, 0]
      material: (base + kitBrass)
      curve {
        a: polarPoint((radius - 0.05), angle, (top + rail))
        b: polarPoint(((radius - 0.05) / cosine(halfStep)), (angle + (step / 2)), ((top + rail) + ((rise / risers) / 2)))
        c: polarPoint((radius - 0.05), (angle + step), ((top + rail) + (rise / risers)))
        radiusStart: 0.03
        radiusEnd: 0.03
      }
    }
  }
}

// A planter that faces +Z (the sheet's furniture-and-planting.png): a terracotta trough under a thick cream lip, its
// soil just below the lip, and three groups of planting: a spiky crown of upright blades, broad leaves on stems, and a
// low mound of pale growth. `length` runs along X; the trough is 0.7 m deep and its lip stands 0.62 m up.
template planter(base, length = 1.7) {
  shape Box "planter-trough" {
    material: (base + kitTerracotta)
    position [0, 0.2, 0]
    scale [((length / 2) - 0.05), 0.2, 0.3]
    chamfer: 0.02
  }
  shape Box "planter-lip" {
    material: (base + kitCream)
    position [0, 0.5, 0]
    scale [(length / 2), 0.12, 0.36]
    rounding: 0.05
  }
  shape Box "planter-soil" {
    material: (base + kitSoil)
    position [0, 0.61, 0]
    scale [((length / 2) - 0.07), 0.02, 0.29]
    detail: true
  }
  for (blade, i) in [
    { lean: -34, turn: 20, tall: 0.5 }, { lean: -16, turn: -35, tall: 0.64 }, { lean: -3, turn: 60, tall: 0.74 }
    { lean: 12, turn: -10, tall: 0.66 }, { lean: 27, turn: 40, tall: 0.54 }, { lean: 41, turn: -50, tall: 0.42 }
  ] {
    shape Prism $"planter-blade-{i}" {
      material: (base + (((i % 2) == 0) ? kitLeafDeep : kitLeaf))
      position [
        ((0 - (length * 0.27)) - ((sine((blade.lean * 0.017453293)) * blade.tall) / 2)),
        (0.6 + ((cosine((blade.lean * 0.017453293)) * blade.tall) / 2)),
        (0.02 * (i - 2.5))
      ]
      rotation: turnAfter(turnAbout([0, 0, 1], blade.lean), turnAbout([0, 1, 0], blade.turn))
      scale [0.07, (blade.tall / 2), 0.014]
      taper: 0.1
      detail: true
    }
  }
  for (leaf, i) in [
    { x: 0.02, y: 0.98, tilt: -35, size: 0.2 }, { x: 0.2, y: 1.08, tilt: 30, size: 0.22 }, { x: 0.1, y: 0.86, tilt: 55, size: 0.18 }
    { x: -0.04, y: 1.16, tilt: -8, size: 0.19 }
  ] {
    shape Ellipsoid $"planter-leaf-{i}" {
      material: (base + (((i % 2) == 0) ? kitLeaf : kitLeafDeep))
      position [(leaf.x + (length * 0.04)), leaf.y, (0.04 - (0.05 * (i % 2)))]
      rotation: turnAbout([0, 0, 1], leaf.tilt)
      scale [leaf.size, (leaf.size * 0.62), 0.03]
      detail: true
    }
    shape Box $"planter-stem-{i}" {
      material: (base + kitLeafDeep)
      position [(leaf.x * 0.5 + (length * 0.04)), (0.62 + ((leaf.y - 0.62) / 2)), 0]
      rotation: turnAbout([0, 0, 1], (0 - (leaf.x * 40)))
      scale [0.012, ((leaf.y - 0.62) / 2), 0.012]
      detail: true
    }
  }
  for (tuft, i) in [[0.42, 0.7, 0.1], [0.55, 0.74, -0.08], [0.66, 0.69, 0.06], [0.5, 0.78, 0.02], [0.36, 0.69, -0.1], [0.61, 0.8, -0.02]] {
    shape Sphere $"planter-tuft-{i}" {
      material: (base + kitLeafPale)
      position [((tuft[0] / 0.85) * ((length / 2) - 0.12)), tuft[1], tuft[2]]
      scale [0.1, 0.1, 0.1]
      detail: true
    }
  }
}

// A bench that runs along X (the same sheet): three warm timber slats on two teal trestles, its seat 0.48 m up.
template bench(base, length = 2) {
  for (z, i) in [-0.16, 0, 0.16] {
    shape Box $"bench-slat-{i}" {
      material: (base + kitTimber)
      position [0, 0.44, z]
      scale [(length / 2), 0.04, 0.072]
      rounding: 0.02
    }
  }
  for side in [-1, 1] {
    shape Box $"bench-trestle-{side}" {
      material: (base + kitTeal)
      position [(side * ((length / 2) - 0.28)), 0.3, 0]
      scale [0.1, 0.1, 0.22]
      chamfer: 0.03
    }
    for foot in [-1, 1] {
      shape Box $"bench-foot-{side}-{foot}" {
        material: (base + kitTeal)
        position [(side * ((length / 2) - 0.28)), 0.11, (foot * 0.16)]
        scale [0.1, 0.11, 0.06]
        chamfer: 0.025
      }
    }
  }
}

// A wall banner that faces +Z, hung from the origin at its rod (the same sheet): a brass rod on two teal brackets,
// three loops and an orange cloth `drop` long carrying a pale diamond over an upward arrow. The motif is geometry a few
// millimetres proud of the cloth: a static placement's paints are drawn in the world's frame, so a paint cannot follow
// each copy of a piece stamped many times.
template banner(base, width = 0.9, drop = 2.3) {
  shape Box "banner-rod" {
    material: (base + kitBrass)
    position [0, 0, 0.12]
    scale [((width / 2) + 0.14), 0.022, 0.022]
    rounding: 0.02
  }
  for side in [-1, 1] {
    shape Box $"banner-bracket-{side}" {
      material: (base + kitTeal)
      position [(side * ((width / 2) + 0.05)), 0, 0.06]
      scale [0.035, 0.07, 0.07]
      chamfer: 0.015
    }
  }
  for x in [-0.32, 0, 0.32] {
    shape Box $"banner-loop-{x}" {
      material: (base + kitShadeDeep)
      position [(x * (width / 0.9)), -0.07, 0.12]
      scale [0.045, 0.09, 0.03]
    }
  }
  shape Box "banner-cloth" {
    material: (base + kitShade)
    position [0, (-0.14 - (drop / 2)), 0.12]
    scale [(width / 2), (drop / 2), 0.008]
  }
  shape Prism "banner-diamond" {
    material: (base + kitCream)
    position [0, (-0.14 - (drop * 0.34)), 0.12]
    scale [(width * 0.2), (width * 0.3), 0.013]
    profile { kind: "Polygon", sides: 4 }
  }
  shape Prism "banner-arrow" {
    material: (base + kitCream)
    position [0, (-0.14 - (drop * 0.68)), 0.12]
    scale [(width * 0.3), (width * 0.22), 0.013]
    taper: 0
  }
  shape Box "banner-stem" {
    material: (base + kitCream)
    position [0, (-0.14 - (drop * 0.84)), 0.12]
    scale [(width * 0.07), (drop * 0.09), 0.013]
  }
}

// A toy arcade cabinet's materials, in slot order from `base`: its body, the cheeks, kick and marquee housing, the dark
// bezel round the picture (and the stick's shaft), the control shelf and the players' marks, the stick's ball and the
// first button, the second button, the marquee's glowing panel and the marquee's lettering.
let cabinetBody = 0
let cabinetTrim = 1
let cabinetBezel = 2
let cabinetShelf = 3
let cabinetButton = 4
let cabinetButtonAlt = 5
let cabinetGlow = 6
let cabinetInk = 7
// The largest half-extents of a picture of `aspect` (its width over its height) that fits inside the half-extents
// `half`: every frame round a screen row (a cabinet's bezel, a television's) fits its picture with it.
function pictureHalvesIn(half, aspect) = (((half[1] * aspect) > half[0])
  ? [half[0], (half[0] / aspect)]
  : [(half[1] * aspect), half[1]])
// The picture a cabinet frames is a screen row of the world's, not a shape: `cabinetPicture` is the centre of the
// screen's front face in the cabinet's frame, 3 mm proud of the bezel, and `cabinetPictureHalf` the largest half-extents
// the bezel frames. `cabinetPictureHalves` fits a picture of an aspect inside them.
let cabinetPicture = [0, 1.62, 0.183]
let cabinetPictureHalf = [0.7, 0.48]
function cabinetPictureHalves(aspect) = pictureHalvesIn(cabinetPictureHalf, aspect)
// A cabinet's half-width: a one-player cabinet's, or the wider two-player one whose shelf carries a control panel for
// each player side by side.
function cabinetHalfWidth(players) = ((players == 2) ? 1.2 : 0.8)

// A toy arcade cabinet that faces +Z, a toy built big: a chunky rounded body on a kick, cheeks standing proud of either
// side, an upright picture in a dark bezel, a flat control shelf, and on top a marquee whose glowing panel carries
// `title`. Each of its `players` (one or two) has a control panel on the shelf: a ball-topped stick on the left and two
// big buttons on the right; a two-player cabinet is wider, its panels side by side under one picture, each marked 1P or
// 2P on the body below it. A one-player cabinet is about 1.9 m wide, a two-player one 2.7 m; both are 0.95 m deep and
// 2.85 m tall, the shelf 1.06 m up, at a standing player's hands. The marquee's panel stands 3 cm proud of its housing,
// so the glow stays its own surface however coarsely the bake meshes the cabinet. Every shape is a rounded box,
// cylinder or sphere joined by union, so the analytic contact collides it as drawn.
template arcadeCabinet(base, title, em = 0.13, players = 1) {
  let w = cabinetHalfWidth(players)
  let panels = ((players == 2) ? [(0 - (w / 2)), (w / 2)] : [0])
  shape Box "cabinet-kick" {
    material: (base + cabinetTrim)
    position [0, 0.08, -0.04]
    scale [(w + 0.04), 0.08, 0.42]
    rounding: 0.04
  }
  shape Box "cabinet-body" {
    material: (base + cabinetBody)
    position [0, 0.57, -0.04]
    scale [w, 0.41, 0.4]
    rounding: 0.09
  }
  shape Box "cabinet-shelf" {
    material: (base + cabinetShelf)
    position [0, 1.01, 0.1]
    scale [(w + 0.04), 0.05, 0.34]
    rounding: 0.04
  }
  shape Box "cabinet-head" {
    material: (base + cabinetBody)
    position [0, 1.76, -0.16]
    scale [w, 0.72, 0.29]
    rounding: 0.09
  }
  shape Box "cabinet-bezel" {
    material: (base + cabinetBezel)
    position [0, cabinetPicture[1], 0.15]
    scale [(cabinetPictureHalf[0] + 0.06), (cabinetPictureHalf[1] + 0.08), 0.03]
    rounding: 0.025
  }
  for side in [-1, 1] {
    shape Box $"cabinet-cheek-{side}" {
      material: (base + cabinetTrim)
      position [(side * (w + 0.07)), 1.31, -0.04]
      scale [0.07, 1.31, 0.45]
      rounding: 0.06
    }
  }
  shape Box "cabinet-marquee" {
    material: (base + cabinetTrim)
    position [0, 2.66, -0.06]
    scale [(w + 0.14), 0.18, 0.4]
    rounding: 0.08
  }
  shape Box "cabinet-marquee-panel" {
    material: (base + cabinetGlow)
    position [0, 2.66, 0.35]
    scale [w, 0.12, 0.02]
    // The glowing panel, its lettering included, lights what stands before the cabinet.
    lightsAs: Face
  }
  for (c, p) in panels {
    shape Cylinder $"cabinet-stick-base-{p}" {
      material: (base + cabinetBezel)
      position [(c - 0.42), 1.07, 0.22]
      scale [0.09, 0.012, 0.09]
    }
    shape Cylinder $"cabinet-stick-{p}" {
      material: (base + cabinetBezel)
      position [(c - 0.42), 1.15, 0.22]
      scale [0.025, 0.08, 0.025]
    }
    shape Sphere $"cabinet-stick-ball-{p}" {
      material: (base + cabinetButton)
      position [(c - 0.42), 1.25, 0.22]
      scale [0.075, 0.075, 0.075]
    }
    shape Cylinder $"cabinet-button-a-{p}" {
      material: (base + cabinetButton)
      position [(c + 0.18), 1.08, 0.24]
      scale [0.075, 0.025, 0.075]
      rounding: 0.01
    }
    shape Cylinder $"cabinet-button-b-{p}" {
      material: (base + cabinetButtonAlt)
      position [(c + 0.42), 1.08, 0.18]
      scale [0.075, 0.025, 0.075]
      rounding: 0.01
    }
  }
  textRuns [
    {
      text: title
      position [0, 2.66, 0.372]
      rotation [0, 0, 0, 1]
      emHeight: em
      depth: 0.008
      mode: "emboss"
      material: (base + cabinetInk)
      align: "center"
      maxWidth: (2 * (w - 0.05))
    }
    for (c, p) in ((players == 2) ? panels : []) {
      {
        text: $"{p + 1}P"
        position [c, 0.78, 0.36]
        rotation [0, 0, 0, 1]
        emHeight: 0.11
        depth: 0.008
        mode: "emboss"
        material: (base + cabinetShelf)
        align: "center"
        maxWidth: 0.4
      }
    }
  ]
}

// A living-room television set's materials, in slot order from `base`: the television's toy-plastic case, its trim
// (knobs, the antenna's tips, the console's cartridge and buttons), the dark parts (the bezel round the picture, the
// antenna's rods, the console's slot and ports, the pads' cables, d-pads and small keys), the low stand's boards, the
// console's shell, the pads' shells, the pads' buttons and the power lamps.
let setCase = 0
let setTrim = 1
let setDark = 2
let setStand = 3
let setConsole = 4
let setPad = 5
let setButton = 6
let setLamp = 7

// A toy television that faces +Z, its foot's centre at `at`: a chunky rounded case 1.6 m wide and 1.56 m tall with a
// tube's hump behind it, a picture in a dark bezel, two knobs and a power lamp on its chin, and rabbit-ear antennas on
// a dome on top. The picture is a screen row of the world's: `televisionPicture` is its front face's centre in the
// television's frame, 3 mm proud of the bezel, and `televisionPictureHalf` the largest half-extents the bezel frames.
let televisionPicture = [0, 0.9, 0.433]
let televisionPictureHalf = [0.6, 0.48]
function televisionPictureHalves(aspect) = pictureHalvesIn(televisionPictureHalf, aspect)
template television(base, at) {
  shape Box "television-case" {
    material: (base + setCase)
    position: (at + [0, 0.78, 0])
    scale [0.8, 0.78, 0.42]
    rounding: 0.12
  }
  shape Box "television-tube" {
    material: (base + setCase)
    position: (at + [0, 0.78, -0.5])
    scale [0.58, 0.52, 0.2]
    rounding: 0.12
  }
  shape Box "television-bezel" {
    material: (base + setDark)
    position: (at + [0, televisionPicture[1], 0.4])
    scale [(televisionPictureHalf[0] + 0.06), (televisionPictureHalf[1] + 0.06), 0.03]
    rounding: 0.025
  }
  for (x, i) in [0.45, 0.63] {
    shape Cylinder $"television-knob-{i}" {
      material: (base + setTrim)
      position: (at + [x, 0.2, 0.43])
      rotation: rotate([1, 0, 0], 90)
      scale [0.055, 0.03, 0.055]
      rounding: 0.01
      detail: true
    }
  }
  shape Sphere "television-lamp" {
    material: (base + setLamp)
    position: (at + [-0.62, 0.2, 0.42])
    scale [0.025, 0.025, 0.025]
    detail: true
  }
  shape Sphere "television-dome" {
    material: (base + setDark)
    position: (at + [0, 1.56, -0.12])
    scale [0.13, 0.1, 0.13]
  }
  for side in [-1, 1] {
    let ear = rotate([0, 0, 1], (side * -28))
    shape Cylinder $"television-ear-{side}" {
      material: (base + setDark)
      position: (at + [0, 1.6, -0.12] + rotatePoint(ear, [0, 0.42, 0]))
      rotation: ear
      scale [0.014, 0.42, 0.014]
      detail: true
    }
    shape Sphere $"television-ear-tip-{side}" {
      material: (base + setTrim)
      position: (at + [0, 1.6, -0.12] + rotatePoint(ear, [0, 0.86, 0]))
      scale [0.04, 0.04, 0.04]
      detail: true
    }
  }
}

// A low open stand that faces +Z, its foot's centre at `at`: a top board `height` up, two side boards and a bottom
// shelf 8 cm up for the console.
template lowStand(base, at, width = 0.95, height = 0.42, depth = 0.45) {
  shape Box "stand-top" {
    material: (base + setStand)
    position: (at + [0, (height - 0.025), 0])
    scale [width, 0.025, depth]
    rounding: 0.02
  }
  for side in [-1, 1] {
    shape Box $"stand-side-{side}" {
      material: (base + setStand)
      position: (at + [(side * (width - 0.05)), ((height - 0.05) / 2), 0])
      scale [0.05, ((height - 0.05) / 2), (depth - 0.02)]
      rounding: 0.02
    }
  }
  shape Box "stand-shelf" {
    material: (base + setStand)
    position: (at + [0, 0.06, 0])
    scale [(width - 0.1), 0.02, (depth - 0.03)]
  }
}

// A toy top-loading console that faces +Z, its foot's centre at `at`: a 0.64 m shell with a slot on top holding a
// cartridge, a power and a reset key, a power lamp, and two controller ports in its face (`consolePort`, in the
// console's frame), which a pad's cable plugs into.
function consolePort(p) = [((p == 0) ? -0.12 : 0.12), 0.06, 0.249]
template deckConsole(base, at) {
  shape Box "console-shell" {
    material: (base + setConsole)
    position: (at + [0, 0.07, 0])
    scale [0.32, 0.07, 0.24]
    rounding: 0.03
  }
  shape Box "console-slot" {
    material: (base + setDark)
    position: (at + [0, 0.14, -0.05])
    scale [0.16, 0.006, 0.05]
  }
  shape Box "console-cartridge" {
    material: (base + setTrim)
    position: (at + [0, 0.2, -0.05])
    scale [0.14, 0.065, 0.03]
    rounding: 0.01
  }
  for (x, i) in [0.17, 0.25] {
    shape Box $"console-key-{i}" {
      material: (base + setTrim)
      position: (at + [x, 0.142, 0.14])
      scale [0.03, 0.008, 0.02]
      rounding: 0.004
      detail: true
    }
  }
  shape Sphere "console-lamp" {
    material: (base + setLamp)
    position: (at + [-0.25, 0.1, 0.235])
    scale [0.013, 0.013, 0.013]
    detail: true
  }
  for p in [0, 1] {
    shape Box $"console-port-{p}" {
      material: (base + setDark)
      position: (at + consolePort(p) + [0, 0, -0.006])
      scale [0.035, 0.022, 0.006]
      detail: true
    }
  }
}

// A toy pad lying flat at `at` (its foot's centre), its cable leaving its edge toward -Z (`padCableEnd`, in the pad's
// frame): a rounded shell 0.32 m long, a d-pad on +X and two buttons on -X, so a player sitting on its +Z side facing -Z
// holds the d-pad in the left hand, and start and select keys between them. Visual only: a body walks over it.
let padCableEnd = [0, 0.022, -0.07]
template gamePad(base, at, label) {
  shape Box $"{label}-shell" {
    material: (base + setPad)
    position: (at + [0, 0.022, 0])
    scale [0.16, 0.022, 0.07]
    rounding: 0.02
    detail: true
  }
  for (s, i) in [[0.035, 0.012], [0.012, 0.035]] {
    shape Box $"{label}-dpad-{i}" {
      material: (base + setDark)
      position: (at + [0.09, 0.046, 0])
      scale [s[0], 0.005, s[1]]
      detail: true
    }
  }
  for (b, i) in [[-0.07, 0.016], [-0.115, -0.014]] {
    shape Cylinder $"{label}-button-{i}" {
      material: (base + setButton)
      position: (at + [b[0], 0.046, b[1]])
      scale [0.018, 0.005, 0.018]
      detail: true
    }
  }
  for (x, i) in [-0.02, 0.02] {
    shape Box $"{label}-key-{i}" {
      material: (base + setDark)
      position: (at + [x, 0.045, 0.02])
      scale [0.012, 0.004, 0.006]
      detail: true
    }
  }
}

// A pad's cable from `from` (a console's port, leaving it toward +Z) to `to` (the pad's cable end): it drops to lie
// `lie` up (on the floor, or on a rug over it) a third of the way out and runs straight along it to the pad. Visual
// only: a body steps over it.
template padCable(base, label, from, to, lie = 0.024, radius = 0.012) {
  let drop = [(from[0] + ((to[0] - from[0]) * 0.3)), lie, (from[2] + ((to[2] - from[2]) * 0.35))]
  shape Sweep $"{label}-drop" {
    material: (base + setDark)
    position: from
    curve {
      a [0, 0, 0]
      b: ([from[0], lie, (from[2] + 0.15)] - from)
      c: (drop - from)
      radiusStart: radius
      radiusEnd: radius
    }
    detail: true
  }
  shape Sweep $"{label}-run" {
    material: (base + setDark)
    position: drop
    curve {
      a [0, 0, 0]
      b: (((to - drop) * 0.5))
      c: (to - drop)
      radiusStart: radius
      radiusEnd: radius
    }
    detail: true
  }
}

// A living-room television set that faces +Z, its stand's foot at the origin: the television on a low stand, the
// console on the stand's shelf, and a pad for each of its `players` lying on the floor before it at `setPads`, each
// cabled to its own port. `televisionSetPicture` is the picture's centre in the set's frame.
let setStandHeight = 0.42
let setTelevisionAt = [0, setStandHeight, -0.05]
let setConsoleAt = [0, 0.08, 0.05]
let televisionSetPicture = (setTelevisionAt + televisionPicture)
let setPads = [[0.45, 0.012, 1.25], [-0.45, 0.012, 1.25]]
template televisionSet(base, players = 2) {
  lowStand(base: base, at: [0, 0, 0], height: setStandHeight)
  television(base: base, at: setTelevisionAt)
  deckConsole(base: base, at: setConsoleAt)
  for p in range(0, players) {
    gamePad(base: base, at: setPads[p], label: $"pad-{p}")
    padCable(base: base, label: $"cable-{p}", from: (setConsoleAt + consolePort(p)), to: (setPads[p] + padCableEnd))
  }
}

// A lounge's materials, in slot order from `base`: a rug's field and its border, and two beanbags' covers.
let loungeRug = 0
let loungeRugBorder = 1
let loungeBeanbag = 2
let loungeBeanbagAlt = 3

// A rug lying on the floor at `at`, `half` its half-extents along X and Z: a border band round a field, 12 mm thick.
template rug(base, at, half) {
  shape Box "rug-border" {
    material: (base + loungeRugBorder)
    position: (at + [0, 0.005, 0])
    scale [half[0], 0.005, half[1]]
    rounding: 0.004
  }
  shape Box "rug-field" {
    material: (base + loungeRug)
    position: (at + [0, 0.006, 0])
    scale [(half[0] - 0.14), 0.006, (half[1] - 0.14)]
    rounding: 0.005
  }
}

// A beanbag at `at` facing +Z turned by `yaw` degrees: a slumped seat and a soft back rising behind it, a metre across.
template beanbag(base, label, at, yaw = 0, slot = 0) {
  let turn = rotate([0, 1, 0], yaw)
  shape Superellipsoid $"{label}-seat" {
    material: (base + slot)
    position: (at + [0, 0.22, 0])
    rotation: turn
    scale [0.5, 0.22, 0.5]
    exponent: 2.4
  }
  shape Superellipsoid $"{label}-back" {
    material: (base + slot)
    position: (at + rotatePoint(turn, [0, 0.45, -0.3]))
    rotation: compose(turn, rotate([1, 0, 0], -18))
    scale [0.44, 0.3, 0.2]
    exponent: 2.4
  }
}

// A lounge before a television set that faces +Z: a rug from 0.65 m to 2.85 m before the stand and two beanbags on it
// facing the set, behind the pads.
template lounge(base) {
  rug(base: base, at: [0, 0, 1.75], half: [1.5, 1.1])
  beanbag(base: base, label: "beanbag-0", at: [0.75, 0.012, 2.25], yaw: 180, slot: loungeBeanbag)
  beanbag(base: base, label: "beanbag-1", at: [-0.75, 0.012, 2.25], yaw: 180, slot: loungeBeanbagAlt)
}

// A construction lattice that runs along X, a toy building set's panel: a frame of square members `frame` thick round a
// panel `cells × pitch` long and `height` tall standing on y 0, an upright bar `bar` square every `pitch` between its two
// posts, and crossbars `rail` square that divide its height into `rails` equal courses. Its palette slots from `base`
// are the frame, the uprights and the crossbars (`latticePalette` gives three plain ones from their colours). The
// uprights are one bar folded by a repeat and the crossbars another, so `cells` and `rails` are even (an odd number of
// copies centres a fold) and `cells` is at most 64, the copies a solid's fold expands to for contact. Every shape is a
// box joined by union, so the panel collides as drawn: no body wider than the gap between two uprights, `pitch - bar`,
// passes it, while the gaps leave most of the panel open to the eye. `upright: 0` leaves the uprights out and `sill: 0`
// the frame's bottom member: an open panel whose courses pass only what fits between its crossbars.
let latticeFrame = 0
let latticeBar = 1
let latticeRail = 2
let latticeGlass = 3
function latticePalette(frame, bar, rail) = [
  { color: frame, roughness: 0.4, specular: 0.05 }
  { color: bar, roughness: 0.4, specular: 0.05 }
  { color: rail, roughness: 0.4, specular: 0.05 }
  { color: "#EEF6F8", roughness: 0.03, glass { depth: 0.008, ior: 1.5 } }
]
// `net`, when set, fills the frame with a net instead of bars and rails: a thin panel `net.thickness` thick whose
// Worley F2-minus-F1 cell relief (`net.frequency` cells a metre, `net.depth` deep, `net.randomness`, `net.seed`)
// hollows each cell's centre through the panel and leaves its walls as the strands, so it reads as an organic net while
// its contact stays the flat panel (a cell relief keeps the base shape for contact), blocking every body.
template lattice(base, cells, pitch, height, bar = 0.025, frame = 0.09, rail = 0.05, rails = 6, upright = 1, sill = 1, net = null) {
  let length = (cells * pitch)
  for side in [-1, 1] {
    shape Box $"lattice-post-{side}" {
      material: (base + latticeFrame)
      position [((side * length) / 2), (height / 2), 0]
      scale [(frame / 2), (height / 2), (frame / 2)]
      rounding: (frame / 6)
    }
  }
  shape Box "lattice-head" {
    material: (base + latticeFrame)
    position [0, (height - (frame / 2)), 0]
    scale [(length / 2), (frame / 2), (frame / 2)]
    rounding: (frame / 6)
  }
  if sill == 1 {
    shape Box "lattice-sill" {
      material: (base + latticeFrame)
      position [0, (frame / 2), 0]
      scale [(length / 2), (frame / 2), (frame / 2)]
      rounding: (frame / 6)
    }
  }
  if (net != null) and (upright == 1) {
    // A clear pane holds every body; the net's strands in front of it are drawn only.
    shape Box "lattice-pane" {
      material: (base + latticeGlass)
      position [0, (height / 2), 0]
      scale [(length / 2), (height / 2), 0.004]
    }
    for (turn, i) in ((net.strand > 0) ? [45, -45] : []) {
      shape Box $"lattice-strands-{i}" {
        material: (base + ((i == 0) ? latticeBar : latticeRail))
        position [0, (height / 2), ((i == 0) ? 0.02 : 0.035)]
        rotation: rotate([0, 0, 1], (turn * 1deg))
        scale [((length + height) / 1.4), (net.strand / 2), (net.strand / 2)]
        rounding: (net.strand / 2.5)
        domain [repeat(spacing: [(4 * (length + height)), (net.pitch * 1.4142), (4 * (length + height))], limit: [0, ceiling((((length + height) / net.pitch) / 2.8)), 0])]
        detail: true
      }
    }
    if net.strand > 0 {
    shape Box "lattice-net-clip" {
      blend: Intersection
      material: (base + latticeBar)
      position [0, (height / 2), 0]
      scale [((length / 2) + frame), (height / 2), frame]
      detail: true
    }
    }
  }
  if (net == null) and (upright == 1) {
    shape Box "lattice-upright" {
      material: (base + latticeBar)
      position [0, (height / 2), 0]
      scale [(bar / 2), (height / 2), (bar / 2)]
      domain [repeat(spacing: [pitch, 1, 1], limit: [((cells / 2) - 1), 0, 0])]
    }
  }
  if net == null {
    shape Box "lattice-rail" {
      material: (base + latticeRail)
      position [0, (height / 2), 0]
      scale [(length / 2), (rail / 2), (rail / 2)]
      rounding: (rail / 4)
      domain [repeat(spacing: [1, (height / rails), 1], limit: [0, ((rails / 2) - 1), 0], origin: [0, (height / 2), 0])]
    }
  }

}

// A pendant lamp hung from a ceiling at `at` (the ceiling point, +Y up): a rose against the ceiling, a cord down to a
// drum shade `shade` in radius and `pendantShadeHeight` tall whose foot is `drop` metres under the ceiling, and across
// the drum's foot a frosted diffuser `glow` in radius, the emitter, whose face's centre is `pendantGlowAt(at, drop)`:
// that is where the lamp's light stands. Its palette slots from `base` are the shade (and the rose), the cord and the
// diffuser.
let pendantShade = 0
let pendantCord = 1
let pendantGlow = 2
let pendantShadeHeight = 0.22
function pendantGlowAt(at, drop) = (at + [0, (0 - (drop + 0.02)), 0])
function pendantGlowArea(glow = 0.17) = (pi * glow * glow)
// The light a downward glowing face of `luminance` nits and `area` square metres gives as a spot opening to a
// hemisphere (angle 90deg), in lumens: such a spot's intensity is its power over 2 pi, and the face's own along its axis
// is its luminance times its area, so the two agree straight below it and the light reads as the face it stands at.
// Rounded to whole lumens, since a state cell carrying it is an integer.
function glowSpotPower(luminance, area) = round(6.283185307179586 * luminance * area)
template pendantLamp(base, at, drop, shade = 0.2, glow = 0.17) {
  let cord = ((drop - pendantShadeHeight) - 0.03)
  shape Cylinder "pendant-rose" {
    material: (base + pendantShade)
    position: (at + [0, -0.015, 0])
    scale [0.07, 0.015, 0.07]
    rounding: 0.005
    detail: true
  }
  shape Cylinder "pendant-cord" {
    material: (base + pendantCord)
    position: (at + [0, (0 - (0.03 + (cord / 2))), 0])
    scale [0.006, (cord / 2), 0.006]
    detail: true
  }
  shape Cylinder "pendant-shade" {
    material: (base + pendantShade)
    position: (at + [0, (0 - (drop - (pendantShadeHeight / 2))), 0])
    scale [shade, (pendantShadeHeight / 2), shade]
    rounding: 0.02
    detail: true
  }
  shape Cylinder "pendant-glow" {
    material: (base + pendantGlow)
    position: (at + [0, (0 - (drop + 0.008)), 0])
    scale [glow, 0.008, glow]
    rounding: 0.004
    detail: true
  }
}

// A doorway where a walkway meets a balcony's edge (the kit's palette): two teal posts `width` apart in X with brass
// caps and a brass inlay down each face, a lintel over the opening with a shallow arched soffit, and a brass threshold
// plate across the floor, all standing on y 0 and facing ±Z. Posts and lintel collide; the inlays, caps and the plate's
// bevel are drawn only. `height` is the opening's clear height under the lintel's crown.
template edgeDoorway(base, width = 1.6, height = 2.7, post = 0.22, lintel = 0.32, depth = 0.3) {
  for side in [-1, 1] {
    shape Box $"door-post-{side}" {
      material: (base + kitTeal)
      position [(side * ((width / 2) + (post / 2))), ((height + lintel) / 2), 0]
      scale [(post / 2), ((height + lintel) / 2), (depth / 2)]
      rounding: (post / 6)
    }
    shape Box $"door-inlay-{side}" {
      detail: true
      material: (base + kitBrass)
      position [(side * ((width / 2) + (post / 2))), (height * 0.55), 0]
      scale [0.018, (height * 0.38), ((depth / 2) + 0.006)]
    }
    shape Box $"door-cap-{side}" {
      detail: true
      material: (base + kitBrass)
      position [(side * ((width / 2) + (post / 2))), ((height + lintel) + 0.04), 0]
      scale [((post / 2) + 0.03), 0.04, ((depth / 2) + 0.03)]
      rounding: 0.02
    }
  }
  shape Box "door-lintel" {
    material: (base + kitTeal)
    position [0, (height + (lintel / 2)), 0]
    scale [((width / 2) + post), (lintel / 2), (depth / 2)]
    rounding: 0.03
  }
  // The soffit's arch: a wide cylinder across the opening cut out of the lintel's underside.
  shape Cylinder "door-arch" {
    blend: Subtraction
    material: (base + kitTeal)
    position [0, (height - (width * 0.9)), 0]
    rotation: rotate([1, 0, 0], 90deg)
    scale [(width * 0.98), ((depth / 2) + 0.05), (width * 0.98)]
  }
  shape Box "door-threshold" {
    material: (base + kitBrass)
    position [0, 0.012, 0]
    scale [((width / 2) + post), 0.012, ((depth / 2) + 0.05)]
    rounding: 0.008
  }
}
