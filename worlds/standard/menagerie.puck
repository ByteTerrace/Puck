// The menagerie: the companions a character keeps, one of them active at a time (docs/decisions/play.md, "Companions
// live in the journal's menagerie"). A library: it hands its importers a template and emits no document, and it names
// no kind of companion: which kinds a world set offers, what each looks like and which a character starts with are the
// importing world's.
//
// A kind is { kind, id, name, prototype }: `kind` its number, 1 or more (0 is no kind: the companion wears its world's
// own look); `id` a name for rows and looks; `name` what the journal calls it; `prototype` the creation a companion of
// that kind wears.
//
// What a character keeps is the body's while it plays and the character's between sessions:
//
//   menagerieKeeps<kind>   a body register, 1 while the body keeps a companion of that kind; it crosses into every
//                          world the body enters, as body registers do
//   companionActive        a body register, the kind of the active companion, 0 for none
//   the identity's facts   the same values under the same names (`identity(each, menagerieKeeps1)`), written as they
//                          change, so the next session starts from them
//   menagerie              the identity's record pool (identity.puck): one Companion record a kept kind, claimed once,
//                          when the kind is first kept, which the account carries across worlds
//
// A world's rule writes an identity's facts and records but reads no record yet (docs/reference/state/worlds.md,
// "Limitations"), and writes no identity register, so the registers are what the journal and the companions read and
// the facts carry them between sessions. On a body's first tick the menagerie adopts what its character's facts hold
// (`menagerieAdopted`); only then does it grant and save. A seat playing under no identity keeps its menagerie for the
// session: the save refuses for it by name, once, and nothing else does.
//
// A companion's body wears its kind's look while its own `companionKind` register names the kind: the look
// assignment's `companion` selector reads it (companion.puck's `companion(menagerie: true)` keeps it in step with its
// owner's `companionActive`). Swapping the active companion is one write of `companionActive` (the journal's
// menagerie page does it), and the companion changes what it wears on the next tick.
//
//   import "../standard/menagerie"
//   menagerie(kinds: [{ kind: 1, id: "wisp", name: "Wisp", prototype: "wisp" }], granted: [1])

// The most kinds a menagerie offers: the active register's range.
let menagerieLimit = 255

// The menagerie of `kinds`. `granted` lists the kinds every player's character starts with: a character that does not
// keep one is given it, and the first granted kind becomes its active companion while it has none. `seats` and
// `capacity` size the adoption cells as journal.puck's do.
template menagerie(kinds, granted = [], seats = 4, capacity = 16) {
  let first = (length(granted) > 0) ? granted[0] : 0

  state {
    body: concat(
      [
        // The kind a companion's body wears, 0 for its world's own look.
        {
          name: "companionKind"
          kind: "Counter"
          initial: 0
          envelope { $type: "range", minimum: 0, maximum: menagerieLimit }
        }
        {
          name: "companionActive"
          kind: "Counter"
          initial: 0
          envelope { $type: "range", minimum: 0, maximum: menagerieLimit }
        }
      ],
      map(
        kinds,
        k => { name: $"menagerieKeeps{k.kind}", kind: "Counter", initial: 0, envelope { $type: "set", values [0, 1] } }
      )
    )
    world {
      // 1 once the body has adopted its character's menagerie.
      row {
        name: "menagerieAdopted"
        kind: Int
        capacity: capacity
        cells: map(range(0, seats), body => { key: $"{body}", value: 0 })
      }
    }
  }

  // A companion's body wears its kind's look while its register names the kind.
  looks {
    assignment {
      select [
        {
          name: "companion"
          bodyState: "companionKind"
          cases: map(kinds, k => { value: k.kind, row: $"companion-{k.id}" })
        }
      ]
    }
    rows: map(kinds, k => {
      name: $"companion-{k.id}"
      scale: 1
      source: creation(prototypeId: k.prototype)
      motion {
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
      }
    })
  }

  // A body's first tick adopts what its character's facts hold.
  rule "menagerie-adopt" {
    forEach: $players
    when (menagerieAdopted[$each] ?? 0) == 0
    mode: Level
    menagerieAdopted[$each] = 1
    for k in kinds {
      if identity(each, $"menagerieKeeps{k.kind}") == 1 {
        setBodyState(key: $each, state: $"menagerieKeeps{k.kind}", expression: 1)
      }
    }
    if identity(each, companionActive) > 0 {
      setBodyState(key: $each, state: "companionActive", expression: identity(each, companionActive))
    }
  }

  // Every player's character is given the granted kinds it does not keep, and the first of them while nothing is active.
  for kindNumber in granted {
    rule $"menagerie-grant-{kindNumber}" {
      forEach: $players
      when (menagerieAdopted[$each] ?? 0) == 1 and bodyState(each, $"menagerieKeeps{kindNumber}") == 0
      mode: Level
      setBodyState(key: $each, state: $"menagerieKeeps{kindNumber}", expression: 1)
    }
  }
  if first != 0 {
    rule "menagerie-first" {
      forEach: $players
      when (menagerieAdopted[$each] ?? 0) == 1 and bodyState(each, companionActive) == 0 and bodyState(
          each,
          $"menagerieKeeps{first}"
        ) == 1
      mode: Level
      setBodyState(key: $each, state: "companionActive", expression: first)
    }
  }

  // A kind newly kept is saved on the character: its fact, and its record claimed into the pool, together or neither.
  // The active companion is saved as it changes.
  for k in kinds {
    rule $"menagerie-save-{k.id}" {
      forEach: $players
      when (menagerieAdopted[$each] ?? 0) == 1 and bodyState(each, $"menagerieKeeps{k.kind}") == 1 and identity(
          each,
          $"menagerieKeeps{k.kind}"
        ) == 0
      mode: Edge
      setIdentityFact(key: $each, fact: $"menagerieKeeps{k.kind}", expression: 1)
      claimIdentityRecord(
        key: $each,
        pool: "menagerie",
        fields: [{ field: "kind", value: k.kind }, { field: "name", text: $"{k.name}" }]
      )
    }
  }
  rule "menagerie-save-active" {
    forEach: $players
    when (menagerieAdopted[$each] ?? 0) == 1 and bodyState(each, companionActive) != identity(each, companionActive)
    mode: Edge
    setIdentityFact(key: $each, fact: "companionActive", expression: toInt(bodyState(each, companionActive)))
  }
}
