// The standard's plain walker: the smallest avatar a world needs to seat a player. A capsule body that walks, runs
// while `run` is held, jumps once from the ground and falls, drawn as a grey capsule with a darker visor so its facing
// reads, seated through the standard player module (player/player.puck), which reads it as one form with no suits. It
// imports the standard and refines it, so a world imports it in the standard's place and declares its bodies and spawn
// points (../minimal/minimal.puck); an author's own avatar replaces it with a contract of its own (the debug world's
// Moth is ../debug/avatars/moth/):
//
//   import "../standard/walker"
//
// Distances are full-size metres: the capsule stands 1.7 m, its eye at 1.6 m.
import "standard"
import "occlusion"
import "camera"
import "kits"
import "player/player"
import "player/actions"

// One form: the 1.7 m capsule on 0.3 m spheres, a 4 m/s walk doubled while the run channel is held, and one jump from
// the ground, cut short by letting go while still rising.
let walkerBody = playerForm(
  name: "body",
  kit: "walker",
  look: "walker",
  height: 1.7,
  radius: 0.3,
  speed: 4,
  camera: { pivot [0, 0.9, 0], fadeClose [0, 1.5, 0], cutawayClose [0, 1.35, 0], eye [0, 1.6, 0.2] },
  actions: [sprintAction(), jumpAction(speed: 5)]
)

player(avatar: playerAvatar(name: "walker", body: walkerBody), rig: "walker-camera", wall: null)

// The standard's screen material, re-exported so a world importing the walker names it.
export binding crt

// How bodies meet the world: a 2 cm contact skin, slopes walkable to 60 degrees.
collision {
  contactSkin: 0.02
  defaultHold: false
  gradientProbe: 0
  gridCellSize: 0
  maxIterations: 4
  maxSlopeDegrees: 60
  requirements []
}

looks [
  {
    name: "walker"
    scale: 1
    source: creation(prototypeId: walker)
    // A rigid capsule: no gait swing and no timeline.
    motion {
      gaitAmplitude: 0
      replayFrames: false
      secondsPerFrame: 0
    }
  }
]

prototypes {
  prototype "walker" {
    occlusion: bodyOcclusion
    document {
      name: "walker"
      schema: "puck.creation.v2"
      palette [
        { color: "#9AA0A8", roughness: 0.6, specular: 0.04, emissive: 0 }
        { color: "#22262C", roughness: 0.3, specular: 0.04, emissive: 0 }
      ]
      // The body: a 0.3 m capsule round the segment from 0.3 m to 1.4 m (half its y scale above its position), so it
      // spans the ground to 1.7 m, as its collider does.
      shape Capsule "body" {
        material: 0
        position [0, 0.3, 0]
        scale [0.3, 2.2, 0.3]
      }
      // The visor across its face, on the +Z side it faces.
      shape Box "visor" {
        material: 1
        position [0, 1.5, -0.27]
        scale [0.2, 0.06, 0.05]
      }
    }
  }
}
