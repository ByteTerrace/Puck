// A game station: a table whose top is one glass display that plays a catalog of games, one at a time, the way a display
// station's turntable shows a catalog of shapes. A module library: it hands its importers the station's creation, its
// placement, its state, its rules and its console command as templates, and emits no document. Where a station stands,
// which games its catalog holds and how each game's board is drawn are the importing world's.
//
// A station is `{ id, at, yaw }`: `id` names it in every cell keyed by station, `at` is the world point of its placement,
// whose creation's floor lies `gameStationFloor` under it, so a station placed at a floor's height minus that stands on
// the floor, and `yaw` (degrees, 0 when absent) turns the whole station about its placement: its table, glass and
// lettering, its chairs, its pick grid and every board and body its games stand on it. Everything below is written in
// the station's own frame: its near chair is at its -Z edge facing +Z, so +Z runs away from that player and +X to their
// left, and its far chair at its +Z edge faces back across the glass; at a yaw of 180 the near chair stands at the
// world's +Z side. A catalog is a list of `{ id, title }`, one row a game; a game's place in the list is its index,
// which the station's selection cell holds.
//
// The glass carries, along the near edge, the menu (GAMES, a button a game and NEW GAME) and above it the status line;
// along the far edge the same status line reads for the far chair; between them lies the board area, the whole width
// of the glass, which each game's own presentation draws centred on it (the paints the world passes in, and the bodies a
// game's holodeck stands on it, ../standard/holodeck.puck). Everything on the glass is a paint over one of the glass's
// panels, so the glass follows the games' state without a bake, and a paint changes only when the cell it reads does.
//
// Every station of a world plays one set of rules (`gameStationRules`): each rule sweeps the stations
// (`forEach: gameStationOf`, `$member` a station's place in the list), and each station's state is a cell under its
// place or the member at its place of a family of rows, so a change at one station wakes and costs that station's binding
// alone, and one rule set serves one station or twelve:
//
//   import "../standard/game-station"
//   let stations = [{ id: "station", at [0, -0.5, 0] }]
//   let catalog = [{ id: "chess", title: "CHESS" }, { id: "klondike", title: "KLONDIKE" }]
//   prototypes { gameStationPrototype(station: stations[0], index: 0, catalog: catalog, boardPanels: []) }
//   placements { gameStationPlacement(station: stations[0], index: 0) }
//   state { world { gameStationState(stations: stations, catalog: catalog) } }
//   commands: gameStationCommands(stations: stations, catalog: catalog)
//   gameStationRules(catalog: catalog)
//
// What a station's paints and the console read, one row for every station keyed by its place (`0` for the first):
//
//   gameStationGame      the index of the game the glass shows (the selection), which the menu's taps write
//   gameStationStatus    the status line's text; a game's rules write it while their game is shown
//   gameStationPickOf    the mailbox `station.game` writes to, a member a station keyed by game: 1 asks for that game
//   gameStationRowInkOf  each menu button's ink, a member a station keyed by button: the game shown lit, the rest dim
//   gameStationCells     the station's pick grid, a member a station over its own topology of the same name
//
// Each chair's, a member a station keyed `near` and `far`:
//
//   gameStationChairOf    the seat (1 to 4) sitting in the chair, 0 while it stands empty
//   gameStationDownOf     the chair's buttons held this tick, one bit each (gameStationBits)
//   gameStationEdgesOf    the buttons pressed this tick, one bit each, with the menu's taps apart from the board's
//   gameStationPointerOf  the pick cell the chair's seat points at, -1 off the glass
//
// A game's rules read a chair's presses as `(gameStationEdgesOf[$member].near & gameStationBits.pick) != 0` and so on,
// and its pointer as `gameStationPointerOf[$member].near`, a cell of the station's pick grid (`gameStationCellX`,
// `gameStationCellZ`).
import "architecture"
import "contexts/tabletop"

// The station's frame, in metres from its placement: the floor, the glass's height (0.95 m over the floor, a standing
// player's hip) and the table's half extents.
let gameStationFloor = 0.5
let gameStationSurface = 1.45
let gameStationHalf = [0.94, 0.88]

// The glass: its extent across (x) and away (z). Along the near edge the menu, a row of buttons the near player reads
// left to right (from +X), with GAMES at its left; above it the status line; along the far edge the status line again,
// read from the far chair; and between them the board area, the glass's whole width, which every game centres on.
let gameStationGlass = { x0: -0.86, x1: 0.86, z0: -0.8, z1: 0.8 }
let gameStationMenu = { x0: -0.84, x1: 0.84, z0: -0.785, z1: -0.695 }
let gameStationMenuLabel = 0.24
let gameStationGap = 0.02
let gameStationMenuEm = 0.042
let gameStationStatusLine = { x0: -0.84, x1: 0.84, z0: -0.68, z1: -0.615 }
let gameStationFarLine = { x0: -0.84, x1: 0.84, z0: 0.695, z1: 0.78 }
let gameStationStatusEm = 0.046
let gameStationBoard = { x0: -0.84, x1: 0.84, z0: -0.6, z1: 0.68 }
// The board area's middle, which a game's layout centres on.
let gameStationBoardMid = [
  ((gameStationBoard.x0 + gameStationBoard.x1) / 2),
  ((gameStationBoard.z0 + gameStationBoard.z1) / 2)
]

// The pick grid: 2.7 cm cells over the whole glass (a topology holds at most 4096 cells) from its near right corner, its columns running +X (column 0 at the
// near player's right) and its rows +Z (row 0 nearest the near chair). A cell's centre in the station's frame is
// `gameStationCellX` across and `gameStationCellZ` away.
let gameStationCell = 0.027
let gameStationColumns = 64
let gameStationRows = 60
function gameStationColumn(cell) = (cell % gameStationColumns)
function gameStationRow(cell) = ((cell - (cell % gameStationColumns)) / gameStationColumns)
function gameStationCellX(cell) = (gameStationGlass.x0 + (gameStationCell * (gameStationColumn(cell) + 0.5)))
function gameStationCellZ(cell) = (gameStationGlass.z0 + (gameStationCell * (gameStationRow(cell) + 0.5)))

// The menu's buttons, one a game and NEW GAME last, from the near player's left: `count` buttons share the row's width
// right of the GAMES label, `gameStationGap` apart. A button's index from a point across is `gameStationButtonsX1`
// less the point over the pitch.
let gameStationButtonsX1 = ((gameStationMenu.x1 - gameStationMenuLabel) - gameStationGap)
function gameStationButtonPitch(count) = ((((gameStationButtonsX1 - gameStationMenu.x0) -
  (gameStationGap * (count - 1))) /
  count) +
  gameStationGap)
function gameStationButtonRect(button, count) = {
  x0: ((gameStationButtonsX1 - (gameStationButtonPitch(count) * button)) -
    (gameStationButtonPitch(count) - gameStationGap))
  x1: (gameStationButtonsX1 - (gameStationButtonPitch(count) * button))
  z0: gameStationMenu.z0
  z1: gameStationMenu.z1
}

// A chair's buttons, one bit each, and the menu's two taps, which a pick on the menu makes in place of the board's pick:
// on a game's button (`list`, with the button in `gameStationButton`), or on NEW GAME (`action`), which the game shown
// answers by starting afresh.
let gameStationBits = { pick: 1, cancel: 2, ahead: 4, behind: 8, right: 16, left: 32, list: 64, action: 128 }

// The chairs: the near one at the -Z edge (board side 0) and the far one at +Z (side 2). The local seats a chair may
// hold are 1 to the world's local seat count (its `bodies.localSeats`), which a world passes as
// `gameStationRules(seats: …)`; `gameStationSeats` is the count when it passes none.
let gameStationChairs = [{ name: "near", side: 0 }, { name: "far", side: 2 }]
let gameStationSeats = 4

// The station's look, in the display stations' family (architecture.puck): the console's glass and its interface's
// colours, the plinth's cream, ochre, teal, brass and glowing ring for the table. `light` and `dark` are a board's two
// square inks, `last`, `picked`, `cursor` and `rival` the rings a board's rules light (the far chair's cursor in
// `rival`), and `off` the bare glass.
let gameStationLook = {
  glass: consoleGlass
  table: plinthPalette
  rowLit: consoleLook.lit
  rowDim: consoleLook.teal
  action: consoleLook.cream
  label: consoleLook.ink
  status: consoleLook.lit
  title: consoleLook.frame
  light: consoleLook.cream
  dark: "#2C5A63"
  last: consoleLook.terracotta
  picked: consoleLook.lit
  cursor: "#9FE6F0"
  rival: "#F2A0C8"
  off: consoleLook.field
}

// The station's yaw, in degrees, and the rotation it turns its frame into the world's by.
function gameStationYaw(station) = ((station.yaw == null) ? 0 : station.yaw)
function gameStationTurn(station) = rotate([0, 1, 0], gameStationYaw(station))
// A point of the station's frame, `local` from its placement, in the world.
function gameStationPoint(station, local) = (station.at + rotatePoint(gameStationTurn(station), local))
// A point of the station's frame on its glass, in the world: `x` across and `z` away.
function gameStationWorld(station, x, z) = gameStationPoint(station, [x, gameStationSurface, z])
function gameStationMid(rect) = [((rect.x0 + rect.x1) / 2), ((rect.z0 + rect.z1) / 2)]
function gameStationHalfOf(rect) = [((rect.x1 - rect.x0) / 2), ((rect.z1 - rect.z0) / 2)]

// A chair's place on the floor, in the world: 1.5 m out from the station's centre at its edge, inside the engage radius;
// and the yaw a body sitting in it faces, across the glass.
function gameStationChairAt(station, chair) = gameStationPoint(station, [0, gameStationFloor, ((chair == "far") ? 1.5 : -1.5)])
function gameStationChairYaw(station, chair) = (gameStationYaw(station) + ((chair == "far") ? 0 : 180))

// The rotation that lays a paint flat on a level glass, read from its -Z edge: the paint's +X runs to that reader's right
// (the glass's -X), its +Y away from the reader (the glass's +Z) and its +Z up through the glass. `displayReadingFar`
// reads it from the +Z edge. Both are in the glass's own frame; a station's paints lie in the world, so they read through
// `gameStationReading`, which turns them with the station.
let displayReading = [0, 0.7071068, 0.7071068, 0]
let displayReadingFar = compose(rotate([0, 1, 0], 180), displayReading)
function gameStationReading(station, reading = displayReading) = compose(gameStationTurn(station), reading)
// A filled rectangle on a level glass, centred at the world point `at`, `half` its half extents across and away, laid by
// `rotation` (a glass's reading).
function displayFill(at, half, color, round = 0, rotation = displayReading) = faceFill(at, rotation, half, color, round)
// A rounded rectangle's outline on a level glass, `stroke` wide, its corners rounded by `round` of its smaller half
// extent: a cell's frame that lights without hiding what is drawn inside it.
function displayRing(at, half, color, stroke, round = 0.25, rotation = displayReading) = {
  type: "Prism"
  position: at
  rotation: rotation
  scale [half[0], half[1], 0.03]
  profile { kind: "RoundedRectangle", cornerRadius: round }
  stroke: stroke
  color: color
}
// Lettering on a level glass, read from its -Z edge (or `rotation`'s): `half` is the box it fits, across and away, and a
// line of capitals stands centred on the box's middle.
function displayText(at, half, template, ink, em, align = "center", rotation = displayReading) = faceText(
  at,
  rotation,
  half,
  template,
  ink,
  em,
  align,
  false,
  false,
  1,
  0.03,
  "capMiddle"
)
// A rectangle of the station's frame filled on its glass, and lettering on one, read from the near chair or `reading`'s.
function gameStationFill(station, rect, color, round = 0) = displayFill(
  gameStationWorld(station, gameStationMid(rect)[0], gameStationMid(rect)[1]),
  gameStationHalfOf(rect),
  color,
  round,
  gameStationReading(station)
)
function gameStationText(station, rect, template, ink, em, align = "center", reading = displayReading) = displayText(
  gameStationWorld(station, gameStationMid(rect)[0], gameStationMid(rect)[1]),
  gameStationHalfOf(rect),
  template,
  ink,
  em,
  align,
  gameStationReading(station, reading)
)

// The near strip's paints: each game's button filled in its ink (the game shown lit), NEW GAME's, and the status line
// above them. The buttons' lettering never changes, so it is the table's own (gameStationLabels), not a paint. A
// station's cells are read at its place in the world's list, `index`.
function gameStationMenuPaints(station, index, catalog, look) = concat(
  map(
    catalog,
    (game, button) => gameStationFill(
      station,
      gameStationButtonRect(button, (length(catalog) + 1)),
      $"state.gameStationRowInkOf{index}.{button}",
      0.012
    )
  ),
  [
    gameStationFill(station, gameStationButtonRect(length(catalog), (length(catalog) + 1)), look.action, 0.012)
    gameStationText(
      station,
      gameStationStatusLine,
      $"{{state.gameStationStatus.{index}}}",
      look.status,
      gameStationStatusEm
    )
  ]
)

// The menu's fixed lettering, in the table's own frame: GAMES at the menu's left in `titleSlot`, and each button's title
// and NEW GAME in `labelSlot`, embossed a millimetre and a half proud of the glass and read from the near chair, each
// line of capitals centred on its box (`capMiddle`).
function gameStationLabels(catalog, labelSlot, titleSlot) = concat(
  [
    {
      text: "GAMES"
      position [
        (gameStationMenu.x1 - (gameStationMenuLabel / 2))
        gameStationSurface
        gameStationMid(gameStationMenu)[1]
      ]
      rotation: displayReading
      emHeight: 0.05
      depth: 0.0015
      mode: "emboss"
      material: titleSlot
      align: "center"
      anchor: "capMiddle"
      maxWidth: (gameStationMenuLabel - 0.02)
    }
  ],
  map(concat(map(catalog, game => game.title), ["NEW GAME"]), (title, button) => {
    text: title
    position [
      gameStationMid(gameStationButtonRect(button, (length(catalog) + 1)))[0],
      gameStationSurface,
      gameStationMid(gameStationMenu)[1]
    ]
    rotation: displayReading
    emHeight: gameStationMenuEm
    depth: 0.0015
    mode: "emboss"
    material: labelSlot
    align: "center"
    anchor: "capMiddle"
    maxWidth: (gameStationButtonPitch((length(catalog) + 1)) - (2 * gameStationGap))
  })
)

// The table: a thick cream cap bevelled at its rim with the glass set in it, a glowing line in the shadow under the
// cap's lip, an ochre apron with a teal seam, a brass rail along each chair's edge where a hand rests, and a cream column
// on a teal foot, as the display plinth is built. `panels` are the glass's panels, each `{ x0, x1, z0, z1 }` in the
// station's frame, each wearing its own palette slot from `base + 6` (the plinth's six slots come first), so each
// carries its own paints; the menu's lettering (`catalog`'s titles) wears the two slots after them. A creation is
// authored in the station's own frame, so a panel stands where its extent says.
template gameStationTable(panels, catalog, base = 0) {
  let capTop = (gameStationSurface - 0.004)
  let capHalf = 0.03
  let apronHalf = 0.04
  let apronAt = ((capTop - (2 * capHalf)) - apronHalf)
  let footTop = (gameStationFloor + 0.1)
  let columnTop = (apronAt - apronHalf)
  shape Box "cap" {
    material: (base + plinthCream)
    position [0, (capTop - capHalf), 0]
    scale [gameStationHalf[0], capHalf, gameStationHalf[1]]
    chamfer: 0.022
  }
  for (panel, i) in panels {
    shape Box $"glass-{i}" {
      material: (base + 6 + i)
      position [((panel.x0 + panel.x1) / 2), (gameStationSurface - 0.006), ((panel.z0 + panel.z1) / 2)]
      scale [((panel.x1 - panel.x0) / 2), 0.006, ((panel.z1 - panel.z0) / 2)]
    }
  }
  shape Box "glow" {
    material: (base + plinthGlow)
    position [0, ((capTop - (2 * capHalf)) - 0.005), 0]
    scale [(gameStationHalf[0] - 0.03), 0.005, (gameStationHalf[1] - 0.03)]
    rounding: 0.004
  }
  shape Box "apron" {
    material: (base + plinthOchre)
    position [0, apronAt, 0]
    scale [(gameStationHalf[0] - 0.05), apronHalf, (gameStationHalf[1] - 0.05)]
    chamfer: 0.012
  }
  shape Box "seam" {
    material: (base + plinthTeal)
    position [0, apronAt, 0]
    scale [(gameStationHalf[0] - 0.046), 0.008, (gameStationHalf[1] - 0.046)]
  }
  for (edge, k) in [-1, 1] {
    shape Box $"rail-{k}" {
      material: (base + plinthBrass)
      position [0, (capTop - capHalf), (edge * (gameStationHalf[1] + 0.008))]
      scale [(gameStationHalf[0] - 0.12), 0.01, 0.01]
      rounding: 0.008
    }
  }
  shape Box "column" {
    material: (base + plinthCream)
    position [0, ((columnTop + footTop) / 2), 0]
    scale [0.13, ((columnTop - footTop) / 2), 0.13]
    chamfer: 0.03
  }
  shape Box "collar" {
    material: (base + plinthOchre)
    position [0, (footTop + 0.04), 0]
    scale [0.15, 0.03, 0.15]
    chamfer: 0.012
  }
  shape Box "foot" {
    material: (base + plinthTeal)
    position [0, (gameStationFloor + 0.05), 0]
    scale [0.44, 0.05, 0.44]
    chamfer: 0.03
  }
  textRuns: gameStationLabels(catalog, (base + 6 + length(panels)), (base + 7 + length(panels)))
}

// The glass's panels: the near strip (the menu and the status line), the far strip (the far chair's status line), then
// the board area split along +Z so no panel carries more paints than a palette slot draws. `boardPanels` lists that
// split, each `{ z0, z1, paints }` from the board area's near edge to its far edge, across the glass's whole width.
function gameStationPanels(station, index, catalog, look, boardPanels) = concat(
  [
    {
      x0: gameStationGlass.x0
      x1: gameStationGlass.x1
      z0: gameStationGlass.z0
      z1: gameStationBoard.z0
      paints: gameStationMenuPaints(station, index, catalog, look)
    }
    {
      x0: gameStationGlass.x0
      x1: gameStationGlass.x1
      z0: gameStationBoard.z1
      z1: gameStationGlass.z1
      paints [
        gameStationText(
          station,
          gameStationFarLine,
          $"{{state.gameStationStatus.{index}}}",
          look.status,
          gameStationStatusEm,
          "center",
          displayReadingFar
        )
      ]
    }
  ],
  map(
    boardPanels,
    panel => { x0: gameStationGlass.x0, x1: gameStationGlass.x1, z0: panel.z0, z1: panel.z1, paints: panel.paints }
  )
)

// The station's prototype, `<id>-table`: the table with its glass. `boardPanels` is the board area's split and the
// paints each panel carries (the games' boards); a station with none draws a bare board area. Its paints read the
// world's rows at the station's place in the list, `index`.
template gameStationPrototype(station, index, catalog, boardPanels = [], look = gameStationLook) {
  let panels = gameStationPanels(
    station,
    index,
    catalog,
    look,
    ((length(boardPanels) == 0) ? [{ z0: gameStationBoard.z0, z1: gameStationBoard.z1, paints [] }] : boardPanels)
  )
  prototype $"{station.id}-table" {
    document {
      name: $"{station.id}-table"
      schema: "puck.creation.v2"
      palette: concat(
        look.table,
        map(panels, panel => (look.glass with { paints: panel.paints })),
        [
          { color: look.label, roughness: 0.5, specular: 0.1 }
          { color: look.title, roughness: 0.4, specular: 0.2, emissive: 300 }
        ]
      )
      gameStationTable(panels: panels, catalog: catalog)
    }
  }
}

// The station's placement: the table, solid, carrying its pick grid (its member of `gameStationCells`, at its place in
// the list, `index`) as a board two chairs sit at. The context button within 2.5 m of its centre sits the seat down in
// the chair at the edge it faces most squarely, and the camera looks down on the glass from there; the pointer picks
// 2 cm over the glass.
template gameStationPlacement(station, index) {
  placement $"{station.id}-table" {
    prototype: $"{station.id}-table"
    board {
      occupancy: $"gameStationCells{index}"
      topology: $"gameStationCells{index}"
      engage {
        channel: "interact"
        radius: 2.5
        pitch: 62
        margin: 0.12
        surface: 0.02
        seats [{ yawDegrees: 180 }, { yawDegrees: 0 }]
      }
    }
    position: station.at
    yawDegrees: gameStationYaw(station)
    solid
  }
}

// The stations' state, inside the world's `state.world` block: what their paints, the console and their rules read,
// every row a cell a station or a family a member a station, each at the station's place in `stations`.
template gameStationState(stations, catalog, look = gameStationLook) {
  let count = length(stations)
  let games = length(catalog)

  // The stations the rules sweep: one cell a station.
  table gameStationOf[count] as s capacity(1) {
    at = s
  }
  // Each station's pick grid: a board over its own topology of the same name, which its table anchors.
  grid gameStationCells[count] dimensions(width: gameStationColumns, depth: gameStationRows) cellSize(gameStationCell) band(0.12) origin(
    gameStationGlass.x0,
    gameStationSurface,
    gameStationGlass.z0
  )
  table gameStationGame capacity(count) = map(range(0, count), s => 0)
  table gameStationStatus capacity(count) = map(range(0, count), s => catalog[0].title)
  table gameStationPickOf[count] capacity(games) {
    for game in catalog {
      [game.id] = 0
    }
  }
  table gameStationRowInkOf[count] capacity(games) = map(range(0, games), row => (row == 0) ? look.rowLit : look.rowDim)
  table gameStationInks {
    lit = look.rowLit
    dim = look.rowDim
  }
  table gameStationTitles capacity(auto) = map(catalog, game => game.title)

  // Each station's chairs, keyed `near` and `far`, the button the near chair's pick lands on in the menu, and the game the
  // menu last showed.
  table gameStationChairOf[count] capacity(2) {
    near = 0
    far = 0
  }
  table gameStationDownOf[count] capacity(2) {
    near = 0
    far = 0
  }
  table gameStationEdgesOf[count] capacity(2) {
    near = 0
    far = 0
  }
  table gameStationPointerOf[count] capacity(2) {
    near = -1
    far = -1
  }
  slot gameStationButton[count] = -1
  slot gameStationShown[count] = -1
}

// The buttons seat `seat` holds past half way this tick, one bit each.
function gameStationWord(seat) = (gameStationBits.pick * seatPastOf(seat, "confirm", 1) +
  gameStationBits.cancel * seatPastOf(seat, "cancel", 1) +
  gameStationBits.ahead * seatPastOf(seat, "forward", 1) +
  gameStationBits.behind * seatPastOf(seat, "forward", -1) +
  gameStationBits.right * seatPastOf(seat, "strafe", 1) +
  gameStationBits.left * seatPastOf(seat, "strafe", -1))
// The seat of the world's first `seats` sitting in the chair on side `side` of the board `cells`, the lowest-numbered
// if several do, or 0.
function gameStationSeatIn(cells, side, seats) = first(range(1, seats + 1), s => seatAtSide(cells, s, side), 0)
// The buttons and the pick cell of seat `seat` (1 to `seats`; 0 holds none and points nowhere).
function gameStationButtonsOf(seat, seats) = first(range(1, seats + 1), s => seat == s, s => gameStationWord(s), 0)
function gameStationPointedBy(cells, seat, seats) = first(
  range(1, seats + 1),
  s => seat == s,
  s => board(pointer, cells, s),
  -1
)

// The stations' rules, one set for every station at the world's top level: each sweeps the stations
// (`forEach: gameStationOf`), `$member` a station's place. The chairs rule reads who sits where; it reads only whether a
// seat is at the board and where, so it runs when one sits down or stands up. A chair's presses rule reads its seat's
// buttons and pointer and is idle while its chair stands empty; the near chair's pick on the menu turns into the menu's
// tap.
template gameStationRules(catalog, seats = gameStationSeats) {
  let games = length(catalog)
  let pitch = gameStationButtonPitch((games + 1))

  rule "game-station-chairs" {
    local near = gameStationSeatIn(gameStationCells[$member], 0, seats)
    local far = gameStationSeatIn(gameStationCells[$member], 2, seats)
    when gameStationChairOf[$member].near != near or gameStationChairOf[$member].far != far
    mode: Level
    forEach: gameStationOf
    gameStationChairOf[$member].near = near
    gameStationChairOf[$member].far = far
  }

  rule "game-station-near" {
    local seat = gameStationChairOf[$member].near
    local pointed = gameStationPointedBy(gameStationCells[$member], seat, seats)
    local now = gameStationButtonsOf(seat, seats)
    local rose = now & ~(gameStationDownOf[$member].near)
    local x = gameStationCellX(pointed)
    local z = gameStationCellZ(pointed)
    local onMenu = (pointed >= 0) and (z >= gameStationMenu.z0) and (z <= gameStationMenu.z1)
    local button = toInt((gameStationButtonsX1 - x) / pitch)
    local onButton = onMenu and (x <= gameStationButtonsX1) and (x >= gameStationMenu.x0) and (button <= games)
    local tap = (button == games) ? gameStationBits.action : gameStationBits.list
    local edges = (
      onMenu ? ((rose & ~(gameStationBits.pick)) | (((rose & gameStationBits.pick) != 0) * onButton * tap)) : rose
    )
    local chosen = onButton ? button : -1
    when (seat or gameStationDownOf[$member].near or gameStationPointerOf[$member].near != -1) and (gameStationDownOf[$member].near != now or
        gameStationEdgesOf[$member].near != edges or
        gameStationPointerOf[$member].near != pointed or
        gameStationButton[$member] != chosen)
    mode: Level
    forEach: gameStationOf
    gameStationDownOf[$member].near = now
    gameStationEdgesOf[$member].near = edges
    gameStationPointerOf[$member].near = pointed
    gameStationButton[$member] = chosen
  }

  rule "game-station-far" {
    local seat = gameStationChairOf[$member].far
    local pointed = gameStationPointedBy(gameStationCells[$member], seat, seats)
    local now = gameStationButtonsOf(seat, seats)
    local edges = now & ~(gameStationDownOf[$member].far)
    when (seat or gameStationDownOf[$member].far or gameStationPointerOf[$member].far != -1) and (gameStationDownOf[$member].far != now or
        gameStationEdgesOf[$member].far != edges or
        gameStationPointerOf[$member].far != pointed)
    mode: Level
    forEach: gameStationOf
    gameStationDownOf[$member].far = now
    gameStationEdgesOf[$member].far = edges
    gameStationPointerOf[$member].far = pointed
  }

  // A tap on a game's button shows that game, and `station.game` posts a game to the mailbox.
  rule "game-station-list" {
    when (gameStationEdgesOf[$member].near & gameStationBits.list) != 0 and gameStationButton[$member] >= 0 and gameStationButton[$member] < games
    mode: Level
    forEach: gameStationOf
    gameStationGame[$member] = gameStationButton[$member]
  }
  for (game, row) in catalog {
    rule $"game-station-pick-{game.id}" {
      when gameStationPickOf[$member][game.id] == 1
      mode: Level
      forEach: gameStationOf
      gameStationGame[$member] = row
      gameStationPickOf[$member][game.id] = 0
    }
  }

  // The menu follows the selection: the game shown lit and the others dim, written once each time it changes.
  rule "game-station-shown" {
    when gameStationShown[$member] != gameStationGame[$member]
    mode: Level
    forEach: gameStationOf
    for (game, row) in catalog {
      if gameStationGame[$member] == row {
        setState(state: gameStationRowInkOf[$member], key: $"{row}", fromState: gameStationInks, fromKey: lit)
      } else {
        setState(state: gameStationRowInkOf[$member], key: $"{row}", fromState: gameStationInks, fromKey: dim)
      }
    }
    setState(state: gameStationStatus, key: $member, fromState: gameStationTitles, fromKey: gameStationGame[$member])
    gameStationShown[$member] = gameStationGame[$member]
  }
}

// A creation that shows nothing: a millimetre box under its origin, inside the table's cap, for a placement a game needs
// (a board's anchor) but draws none.
template gameStationTokenBlank(id) {
  prototype id {
    document {
      name: id
      schema: "puck.creation.v2"
      palette [{ color: "#000000", roughness: 1 }]
      shape Box "blank" {
        material: 0
        position [0, -0.03, 0]
        scale [0.001, 0.001, 0.001]
      }
    }
  }
}

// `station.game <station> <game>` shows a game on a station, as a tap on its menu does: the station is its place in the
// world's list, 0 for the first, as every station command names it.
function gameStationCommands(stations, catalog) = [
  {
    name: "station.game"
    help: "Shows a game on a game station's glass, as a tap on its menu does: the station's number (0 for the world's first station) and the game's id."
    parameters [
      { name: "station", kind: Choice, values: map(range(0, length(stations)), i => $"{i}") }
      { name: "game", kind: Choice, values: map(catalog, game => game.id) }
    ]
    lines [
      "world.state.cell.set gameStationPickOf{station} {game} 1"
    ]
  }
]
