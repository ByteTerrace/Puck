// The wrist panel: the journal (journal.puck) worn on a forearm, as an avatar's or a suit's creation carries it. A
// library: it hands its importers functions and templates and emits no document. Everything about the panel is here (its
// geometry, its flap, its screen, how the arm raises it and how the camera focuses on it), so an avatar or a suit carries
// it by naming a mount and a few of its own palette slots, and a restyle changes this file alone.
//
// A mount is { part, at, shoulder, elbow }, in the creation's frame for the body's left side (the right mirrors it, as
// mirror.puck's helpers do): `part` the forearm shape the panel rides (its side's name is `<part>-<side>`), `at` the
// point on its outer face the panel's bezel stands on, a face whose outward normal is -X while the arm hangs at the
// body's side, and `shoulder` and `elbow` the points the arm's raise turns about. Which forearm wears the open panel is
// the player's: the journal's `journalHand` body register (0 left, 1 right), so a suit that carries a panel on both
// forearms opens the one the player chose and keeps the other's flap shut.
//
// Inside the creation's document, an avatar writes, for each side:
//
//   wristPanel(mount: myMount, side: side, isRight: isRight, ids: [<three free shape ids>], materials: { bezel, flap, screen })
//
// lists `wristPanelGlass(...)` as the screen's palette slot (one slot a side), splices `wristPanelSwings(...)` into
// its upper arm's and forearm's swings, and lists `wristPanelDrivers` among its drivers; its look's lane 0 lights the
// glass as an arm rises (`maximum(journalRaiseLeft[$body], journalRaiseRight[$body])`). Its chase camera takes
// `focus: wristPanelFocus()`.
import "camera"
import "mirror"
import "rig"
import "journal"

// The panel's shape, in the left side's frame about the mount's `at`: a bezel `bezel` half extents deep, along the arm
// and across it; the screen `screen` half extents across and up the glass as its reader sees it, standing `screenOut`
// out from `at`, a millimetre proud of the bezel; and a flap `flap` half extents standing `flapOut` out, over both,
// hinged on its front edge and swung `open` radians to stand open. The flap opens with its arm's raise along a quarter
// turn of sine, so it stands wide open as the arm arrives (three quarters open in the action read).
let wristPanelShape = {
  bezel { half [0.007, 0.064, 0.08], rounding: 0.004 }
  screen { half [0.07, 0.055], depth: 0.002, out: 0.006 }
  flap { half [0.004, 0.068, 0.084], rounding: 0.003, out: 0.0145, open: -1.9 }
}
// The glass's turn: a box's +Z out of the gauntlet (-X), +Y down the forearm and +X forward, so its lettering reads
// upright from the eyes once the arm is raised.
let wristPanelScreenTurn = [0.7071068, 0, -0.7071068, 0]
// How the arm raises the panel to read it, the pause read's whole pose (the action read is the same pose part way): the
// upper arm swings forward `lift` radians about the shoulder, and the forearm rolls the panel's face up toward the eyes
// (`roll`), then lifts (`bend`) and turns (`turn`) about the elbow, so the screen stands before the chest on its side,
// tipped toward the face and over the shoulder.
let wristPanelPose = { lift: 0.8, roll: -2.25, bend: 0.6, turn: -0.2 }

// The panel on one forearm: bezel, screen and flap, with shape ids `ids` (three, unique in the creation) and the
// creation's palette slots `materials` { bezel, flap, screen }: the screen's slot is this side's `wristPanelGlass`.
template wristPanel(mount, side, isRight, ids, materials, shape = wristPanelShape) {
  shape Box $"journalBezel-{side}" {
    id: ids[0]
    position: mirrorX(isRight, mount.at)
    scale: shape.bezel.half
    material: materials.bezel
    parent: $"{mount.part}-{side}"
    rounding: shape.bezel.rounding
  }

  shape Box $"journalScreen-{side}" {
    id: ids[1]
    position: mirrorX(isRight, (mount.at + [(0 - shape.screen.out), 0, 0]))
    rotation: mirrorRotation(isRight, wristPanelScreenTurn)
    scale [shape.screen.half[0], shape.screen.half[1], shape.screen.depth]
    material: materials.screen
    parent: $"{mount.part}-{side}"
  }

  shape Box $"journalFlap-{side}" {
    id: ids[2]
    position: mirrorX(isRight, (mount.at + [(0 - shape.flap.out), 0, 0]))
    scale: shape.flap.half
    material: materials.flap
    parent: $"{mount.part}-{side}"
    rounding: shape.flap.rounding
    swings [
      swing(
        $"journal-flap-{side}",
        signed(isRight, [0, 1, 0], [1, -1, -1]),
        shape.flap.open,
        mirrorX(isRight, (mount.at + [(0 - shape.flap.out), 0, (0 - shape.flap.half[2])]))
      ) with { wave: "sine" }
    ]
  }
}

// One side's screen glass, a palette slot lettered with the journal's interface (journal.puck's
// `journalScreenPaints`) and lit by lane 0 as the flap opens. `kinds` are the menagerie's.
function wristPanelGlass(side, kinds, shape = wristPanelShape) = (journalGlass with {
  paints: journalScreenPaints(parent: $"journalScreen-{side}", half: shape.screen.half, kinds: kinds)
})

// The swings the arm wearing the panel adds to raise it, `part` "upper" for its upper arm and "fore" for its forearm,
// turning about the mount's shoulder and elbow.
function wristPanelSwings(part, mount, side, isRight, pose = wristPanelPose) = ((part == "upper") ? [
  swing($"journal-{side}", [1, 0, 0], pose.lift, mirrorX(isRight, mount.shoulder)) with { wave: "linear" }
] : [
  swing($"journal-{side}", signed(isRight, [0, 1, 0], [1, -1, -1]), pose.roll, mirrorX(isRight, mount.elbow)) with {
    wave: "linear"
  }
  swing($"journal-{side}", [1, 0, 0], pose.bend, mirrorX(isRight, mount.elbow)) with { wave: "linear" }
  swing($"journal-{side}", signed(isRight, [0, 1, 0], [1, -1, -1]), pose.turn, mirrorX(isRight, mount.elbow)) with {
    wave: "linear"
  }
])

// The drivers the panel's swings ride: each arm's raise follows the journal's eased aim (journal.puck's
// `journalRaise<Side>`), 1 the pause read's whole pose, and its flap rides the same aim at a quarter turn a unit. For a
// creation's `drivers`.
let wristPanelDrivers = flatMap([["left", "Left"], ["right", "Right"]], s => [
  { name: $"journal-{s[0]}", signal: $"state.journalRaise{s[1]}.$body", cadence: 1, when ["always"] }
  { name: $"journal-flap-{s[0]}", signal: $"state.journalRaise{s[1]}.$body", cadence: 1.5707963, when ["always"] }
])

// The chase camera's focus while the journal is open (camera.puck's `focusFraming`): it eases in toward the side whose
// arm rises, as far as that arm rises (all the way in the pause read, part way in the action read).
function wristPanelFocus(distance = 1.9, pitch = 0.45, pivotOffset = [0.3, 1.35, 0.1]) = focusFraming(
  left: "journalRaiseLeft",
  right: "journalRaiseRight",
  distance: distance,
  pitch: pitch,
  pivotOffset: pivotOffset
)
