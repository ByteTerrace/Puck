// Kit parts bodies share: the gravity and holds a walking body wears and the kits of a piece that stays where it is
// put. A module library: it hands its importers lets and templates and emits no document.

// The world's feel of gravity: a body falls at 46 m/s² and rises against it at 28, and sinks no faster than 40 m/s.
let standardGravity = { fall: 46, rise: 28 }
let standardSink = { sinkSpeed: 40 }

// A walking body's holds: the ground it stands on within reach, and the fall that takes over off it.
let groundHold = {
  name: "ground"
  bond: Surface
  hold: Gravity
  cone [0, 60]
  reach: 1.2
  forward: Heading
  gravity: standardGravity
  envelope: standardSink
}
let fallHold = {
  name: "fall"
  bond: Free
  hold: Gravity
  forward: Heading
  gravity: standardGravity
  envelope: standardSink
}

// A swimming body's hold: the world's water at its cell, taken wherever a medium lattice (a `field` row carrying
// `medium {}`) has water there and never in a world with none, so it leads a list ahead of the ground and the fall. A
// body floats with its origin `equilibriumOffset` below the free surface; below that band the medium lifts it at
// `idleDrift` (negative sinks it) and the MoveUp channel thrusts it, at `thrust` of the kit's move speed. `riseSpeed`
// and `sinkSpeed` bound its vertical speed and `speed` its planar one, which rides the kit's own move speed when absent.
function swimHold(idleDrift = 0.8, equilibriumOffset = 1.2, settleRate = 2, riseSpeed = 2.5, sinkSpeed = 2.5, thrust = 1, speed = null) = {
  name: "swim"
  bond: Medium
  hold: None
  medium { idleDrift: idleDrift, equilibriumOffset: equilibriumOffset, settleRate: settleRate }
  envelope { riseSpeed: riseSpeed, sinkSpeed: sinkSpeed }
  thrust: thrust
  speed: speed
}

// A piece's hold in the air: it falls and settles under gravity wherever it is let go.
let airHold = { name: "air", bond: Free, hold: Gravity, gravity: standardGravity, envelope: standardSink }

// A body posed by the rules, held where they put it, with no gravity.
let heldHold = { name: "held", bond: Free, hold: None }

// What a still piece's motion is made of: it has no gait, so the walk program gets a speed and a turn rate too small to
// move it, and the rules and the physics place it.
let stillShaping = [{ along {} }]
let stillSpeed = { value: 0.001 }
let stillTurn = { rate: 0.001 }

// A body the rules pose: held where they put it, with no gait. A piece derives its own from it (its hold, a facing
// snap, a pitch limit).
let stillMotion = { holds [heldHold], shaping: stillShaping, speed: stillSpeed, turn: stillTurn }

// A walking body's motion: it stands on the ground and falls off it, walks at 4 m/s and runs at twice that while the run
// channel is held, steps up a kerb, and turns towards where it is driven. An avatar derives its own pace from it.
let walkerMotion = {
  facingSnap: false
  groundSnap: 0.3
  holds [groundHold, fallHold]
  moveFrame: World
  shaping [
    {
      along {
        engage: 40
        release: 50
      }
      turnScale: 1
    }
  ]
  speed {
    value: 4
    held {
      channel: "run"
      multiplier: 2
    }
  }
  stepHeight: 0.3
  turn {
    falloff: 1
    maxPitch: 1.2
    pitchRate: 0
    rate: 2.5
  }
}

// A rigid piece (a stone, a token, a chess piece): it falls under gravity and settles where it is let go, and stays.
template pieceKit(name, collider, mass, friction = 0.6, restitution = 0.05, rollingResistance = 0.002) {
  kits [
    {
      bodyContact: Solid
      bodyMotionProgram: "walk"
      collider: collider
      motion: stillMotion with { facingSnap: true, holds [airHold] }
      name: name
      rigid {
        angularDamping: 0.05
        friction: friction
        linearDamping: 0.05
        mass: mass
        restitution: restitution
        rollingResistance: rollingResistance
      }
    }
  ]
}

// A cursor: volumeless and overlapping, so it touches no piece, and posed by the rules every tick.
template heldKit(name) {
  kits [
    {
      bodyContact: Overlap
      bodyMotionProgram: "walk"
      motion: stillMotion with { facingSnap: true }
      name: name
    }
  ]
}
