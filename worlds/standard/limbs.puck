// Limbs: the parts of a tree a body walks and climbs, a library. A sweep draws a tapering limb beautifully but contact
// omits it, so every piece a body stands on is built from shapes contact admits: a limb is a chain of flattened masses
// along a curve (superellipsoids, which bake their own radii), a walkway along it is a deck of timber boards on the
// chords of its walking line, a trunk's treads are boards round its taper that climb at a riser a body steps up, and
// a guard is a low rail of living branch along an edge (capsules, whose colliders are exact). A
// creation built from them that sets `contact: Shapes` collides as those shapes' hard union, analytic primitives under
// its smooth blends, so a body walking a whole tree runs no field solve. Detail a body never touches (a fork, a knot,
// a bracket, twigs, leaves, a rail's posts) is a sweep or a detail shape, and leaf masses stay in separate, non-solid
// creations (foliage.puck's groupedTree, leafyClump and canopySurface).
//
// Every point is in the tree frame, a half turn about up from the creation's (foliage.puck's treePoint): each shape
// carries its point into the creation with `* [-1, 1, -1]`, and its turn conjugated by the half turn.

import "rig"
import "paths"

// The turn that lays a shape's local +X along the direction `d` and keeps its local +Z level: a yaw about +Y, then a
// pitch about the yawed +Z. `d` must not be vertical.
function turnAlong(d) = turnAfterLevel(d, squareRoot(((d[0] * d[0]) + (d[2] * d[2]))))
function turnAfterLevel(d, level) = compose(
  turnByCosine([0, 1, 0], clamp((d[0] / level), -1, 1), ((d[2] > 0) ? -1 : 1)),
  turnByCosine([0, 0, 1], clamp((level / vectorLength(d)), -1, 1), ((d[1] < 0) ? -1 : 1))
)

// A limb's full width or thickness a share `s` along it: `span[0]` at its root tapering to `span[1]` at its tip, swelled
// at the root by a collar that adds `collar` of the span where the limb leaves its parent and fades as (1 - s)^4.
function limbTaper(span, collar, s) = ((span[0] + ((span[1] - span[0]) * s)) *
  (1 + (collar * ((((1 - s) * (1 - s)) * (1 - s)) * (1 - s)))))
// A limb's level heading a share `t` along the quadratic Bezier `a`, `b`, `c` (a unit vector, its y zero), and the level
// direction to its left, round +Y from the heading.
function limbHeading(a, b, c, t) = vectorUnit(
  ((quadraticPoint(a, b, c, minimum((t + 0.02), 1)) - quadraticPoint(a, b, c, maximum((t - 0.02), 0))) * [1, 0, 1])
)
function limbLeft(a, b, c, t) = [limbHeading(a, b, c, t)[2], 0, (0 - limbHeading(a, b, c, t)[0])]

// A walkable limb: `segments` flattened superellipsoids whose tops follow the quadratic Bezier `a`, `b`, `c` (the line a
// foot walks), tapering from `width[0]` and `thickness[0]` (full widths, metres) at `a` to `width[1]` and `thickness[1]`
// at `c`, with `collar` swelling its root (limbTaper). Each mass reaches `overlap` times its share of the curve, so
// neighbours merge with only a shallow dip between them, and joins its neighbours by a `smooth` blend. `exponent`
// squares the cross-section: 2 is an ellipse, and above it the top flattens to walk on.
template limb(label, a, b, c, width, thickness, material, segments = 7, exponent = 2.6, overlap = 1.6, smooth = 0.25, collar = 0) {
  for i in range(0, segments) {
    let p0 = quadraticPoint(a, b, c, (i / segments))
    let p1 = quadraticPoint(a, b, c, ((i + 1) / segments))
    let s = ((i + 0.5) / segments)
    let w = limbTaper(width, collar, s)
    let th = limbTaper(thickness, collar, s)
    let turn = turnAlong((p1 - p0))
    shape Superellipsoid $"{label}-{i}" {
      exponent: exponent
      position: ((((p0 + p1) / 2) - rotatePoint(turn, [0, (th / 2), 0])) * [-1, 1, -1])
      rotation: (turn * [-1, 1, -1, 1])
      scale [((overlap * vectorLength((p1 - p0))) / 2), (th / 2), (w / 2)]
      material: material
      blend: SmoothUnion
      smooth: smooth
    }
  }
}

// Where a fork leaves limb `a`, `b`, `c`: a share `at` along it, `drop` metres under its walking line, and where it ends,
// `reach` metres out to the limb's left (`side` 1) or right (`side` -1) and `rise` metres up.
function limbForkBase(a, b, c, at, drop) = (quadraticPoint(a, b, c, at) - [0, drop, 0])
function limbForkTip(a, b, c, at, side, reach, rise, drop) = ((limbForkBase(a, b, c, at, drop) +
  (limbLeft(a, b, c, at) * (side * reach))) +
  [0, rise, 0])

// A fork off a limb: a sweep from inside the limb, under its walking line, out to one side and up, tapering from
// `radius[0]` to `radius[1]`, smooth-blended into the limb so it reads as grown from it. A sweep never collides, and the
// fork leaves the limb's flank sideways, so it stands clear of the line a foot walks. Its curve is in the shape's own
// frame, which the shape's half turn carries into the creation as treePoint carries a point.
template limbFork(label, a, b, c, at, side, reach, rise, radius, material, drop = 0.35, smooth = 0.22) {
  let base = limbForkBase(a, b, c, at, drop)
  let tip = limbForkTip(a, b, c, at, side, reach, rise, drop)
  let left = (limbLeft(a, b, c, at) * side)
  shape Sweep $"{label}" {
    rotation: rotate([0, 1, 0], 180)
    material: material
    blend: SmoothUnion
    smooth: smooth
    curve {
      a: base
      b: ((base + (left * (0.6 * reach))) + [0, (0.25 * rise), 0])
      c: tip
      radiusStart: radius[0]
      radiusEnd: radius[1]
    }
  }
}

// A knot on a limb's flank: a low swelling `size` metres across a share `at` along it, on its left (`side` 1) or right
// (`side` -1), set into the flank `depth` under the walking line so its top stays below the walking face. A detail shape:
// drawn, never collided.
template limbKnot(label, a, b, c, at, side, width, size, material, depth = 0.35) {
  shape Superellipsoid $"{label}" {
    detail: true
    exponent: 2.2
    position: (((quadraticPoint(a, b, c, at) - [0, depth, 0]) +
      (limbLeft(a, b, c, at) * (side * ((width / 2) - (0.25 * size))))) *
      [-1, 1, -1])
    scale [(0.5 * size), (0.42 * size), (0.5 * size)]
    material: material
    blend: SmoothUnion
    smooth: (0.3 * size)
  }
}

// The radius of a conical trunk `base` wide at the foot whose taper would close at `apex` metres up, at height `y`.
function trunkRadius(base, apex, y) = (base * (1 - (y / apex)))

// A conical trunk's contact core: `count` stacked cylinders from the foot to `top`, each as wide as the taper at its own
// top less `inset`, so the stack collides as analytic cylinders inside the taper (its ledges are a twentieth of a step
// at most). With `smooth` the drums blend into one another, so the stack draws as a smooth taper while it collides as
// the hard stack, a little inside what is drawn.
template trunkCore(label, base, apex, top, count, material, inset = 0.02, smooth = 0) {
  for i in range(0, count) {
    let y0 = ((top * i) / count)
    let y1 = ((top * (i + 1)) / count)
    shape Cylinder $"{label}-{i}" {
      position [0, ((y0 + y1) / 2), 0]
      scale [(trunkRadius(base, apex, y1) - inset), ((y1 - y0) / 2), (trunkRadius(base, apex, y1) - inset)]
      material: material
      blend: SmoothUnion
      smooth: smooth
    }
  }
}

// A walkway of timber treads climbing round a trunk on a helix of constant radius: tread k stands at `start + k * step`
// degrees round (polarPoint's sense, in the tree frame) with its top `rise * (k + 1)` metres up, a board `thickness`
// thick from `inset` metres inside the bark of a trunk tapering as trunkRadius(`base`, `apex`) out to `rim` metres from
// the axis, whatever the taper. A board's trailing edge is the radial line half a step behind its bearing, and it runs
// forward under the next board, wide enough to meet that board's trailing edge everywhere inside the rim, so every
// riser is radial, the top a walker sees spans the tread's whole step at every radius, and a board thicker than the
// rise closes the riser under the next. A step of 18 degrees and a rise of 0.225 m climb one 4.5 m storey a turn in
// twenty risers, under a 0.3 m step. Each board rests on a bracket of bark, `bracket`'s material, grown from the trunk
// under the middle of its step, drawn only; every `accentEvery`-th bracket (none at 0) is a shelf fungus of `accent`.
// Boxes joined by union, so the walkway collides as drawn.
template spiralTreads(label, count, start, step, rise, base, apex, rim, material, bracket, thickness = 0.32, inset = 0.35, rounding = 0.025, accent = 0, accentEvery = 0) {
  for k in range(0, count) {
    let top = treadTop(rise, k)
    let bark = trunkRadius(base, apex, top)
    let inner = (bark - inset)
    let back = (start + (step * (k - 0.5)))
    let half = (((rim * sine(((absolute(step) * pi) / 180))) / 2) + 0.02)
    let angle = (start + (step * k))
    let shelf = ((rim - bark) * 0.62)
    shape Box $"{label}-{k}" {
      material: material
      position: ((polarPoint(((inner + rim) / 2), back, (top - (thickness / 2))) +
        polarPoint(half, (back + (sign(step) * 90)), 0)) *
        [-1, 1, -1])
      rotation: rotate([0, 1, 0], (0 - back))
      scale [((rim - inner) / 2), (thickness / 2), half]
      rounding: rounding
    }
    shape Superellipsoid $"{label}-bracket-{k}" {
      detail: true
      exponent: 2.4
      material: (((accentEvery > 0) and ((k % accentEvery) == (accentEvery - 1))) ? accent : bracket)
      position: (polarPoint((bark + ((shelf - 0.25) / 2)), angle, ((top - thickness) - 0.12)) * [-1, 1, -1])
      rotation: rotate([0, 1, 0], (0 - angle))
      scale [((shelf + 0.25) / 2), 0.2, ((rim * 0.13) + 0.05)]
      blend: SmoothUnion
      smooth: 0.12
    }
  }
}

// A run of living rail from `from` to `to`, two points on the walking surface along its edge, in the tree frame: one
// round branch `height` over the surface, `radius` thick, a capsule, so runs end to end along an edge meet in one smooth
// bar that climbs with it. The rail collides: a standing body's collider spans the rail's height, so the bar holds it
// with no pane or infill, and its round face guides a body sliding along it without snagging. With `post`, a stub of
// the same branch grows up into the rail from the surface at `from`, curling out of the edge on `side` (1 the run's
// left, round +Y from its heading; -1 its right), drawn only.
template guardRun(label, from, to, side, material, height = 0.75, radius = 0.07, post = false) {
  let joint = (from + [0, height, 0])
  let d = (to - from)
  let flat = vectorUnit((d * [1, 0, 1]))
  let out = ([flat[2], 0, (0 - flat[0])] * side)
  shape Capsule $"{label}-rail" {
    material: material
    position: (joint * [-1, 1, -1])
    rotation: (compose(turnAlong(d), rotate([0, 0, 1], -90)) * [-1, 1, -1, 1])
    scale [radius, (2 * vectorLength(d)), radius]
  }
  if post {
    shape Sweep $"{label}-post" {
      rotation: rotate([0, 1, 0], 180)
      material: material
      blend: SmoothUnion
      smooth: 0.05
      curve {
        a: (from - [0, 0.06, 0])
        b: ((from + (out * 0.1)) + [0, (height * 0.45), 0])
        c: joint
        radiusStart: (radius * 1.5)
        radiusEnd: radius
      }
    }
  }
}

// A rail along a spiralTreads walkway's rim, on each tread k listed in `treads`: a guardRun `inset` inside the rim on
// the chord across the tread's step, from the riser before it to the riser after, its foot climbing from the middle of
// that riser to the middle of the next, so the rail climbs one even helix over the treads, and a post every
// `postEvery`-th tread.
template spiralGuard(label, treads, start, step, rise, rim, material, height = 0.75, inset = 0.06, postEvery = 3) {
  for k in treads {
    guardRun(
      label: $"{label}-{k}",
      from: polarPoint((rim - inset), (start + (step * (k - 0.5))), (treadTop(rise, k) - (rise / 2))),
      to: polarPoint((rim - inset), (start + (step * (k + 0.5))), (treadTop(rise, k) + (rise / 2))),
      side: sign(step),
      material: material,
      height: height,
      post: ((k % postEvery) == 0)
    )
  }
}

// A timber deck along a limb's walking line, the quadratic Bezier `a`, `b`, `c`: `segments` boards, each a box whose
// top lies on the chord between two points of the line, `thickness` thick and kept level across, its width tapering
// from `width[0]` at `a` to `width[1]` at `c`. Neighbouring boards meet at the line's points, their top edges on one
// level line there, so the deck's top is the line's chords, with a crease of the curve's turn between two boards and no
// step, and it ends square at `c` (a balcony's edge). Each board but the first may reach `overlap` back past its start,
// under the end of the board before; where the line bends over a crest that lifts the board's end above the one before
// by the overlap times the change of slope, a lip a walker meets as a riser, so a walked deck keeps none. Boxes joined
// by union, so the deck collides as drawn.
template deckedLimb(label, a, b, c, width, thickness, material, segments = 8, overlap = 0) {
  for i in range(0, segments) {
    let p0 = quadraticPoint(a, b, c, (i / segments))
    let p1 = quadraticPoint(a, b, c, ((i + 1) / segments))
    let back = ((i == 0) ? 0 : overlap)
    let along = vectorUnit((p1 - p0))
    let turn = turnAlong((p1 - p0))
    shape Box $"{label}-{i}" {
      material: material
      position: (((((p0 - (along * back)) + p1) / 2) - rotatePoint(turn, [0, (thickness / 2), 0])) * [-1, 1, -1])
      rotation: (turn * [-1, 1, -1, 1])
      scale [((vectorLength((p1 - p0)) + back) / 2), (thickness / 2), ((width[0] +
          ((width[1] - width[0]) * ((i + 0.5) / segments))) /
          2)
      ]
    }
  }
}

// A rail along one side of a deckedLimb (`side` 1 its left, -1 its right): a guardRun for each of its boards from `from`
// to `to` (board indices; -1 runs to the last board), `inset` inside the deck's edge, its ends on the line's points
// carried sideways along the line's own level left there, so the runs meet end to end round the curve, with a post at
// every `postEvery`-th board's start.
template limbGuard(label, a, b, c, width, side, material, segments = 8, from = 0, to = -1, height = 0.75, inset = 0.06, postEvery = 3) {
  let end = ((to < 0) ? segments : to)
  for i in range(from, end) {
    let t0 = (i / segments)
    let t1 = ((i + 1) / segments)
    guardRun(
      label: $"{label}-{i}",
      from: (quadraticPoint(a, b, c, t0) +
        (limbLeft(a, b, c, t0) * (side * (((width[0] + ((width[1] - width[0]) * t0)) / 2) - inset)))),
      to: (quadraticPoint(a, b, c, t1) +
        (limbLeft(a, b, c, t1) * (side * (((width[0] + ((width[1] - width[0]) * t1)) / 2) - inset)))),
      side: side,
      material: material,
      height: height,
      post: (((i - from) % postEvery) == 1)
    )
  }
}

// The top of spiralTreads' tread `k`, and the point on its middle line `out` metres from the bark, where a limb that
// leaves the trunk from that tread starts its walking line.
function treadTop(rise, k) = (rise * (k + 1))
function treadPoint(start, step, rise, base, apex, k, out) = polarPoint(
  (trunkRadius(base, apex, treadTop(rise, k)) + out),
  (start + (step * k)),
  treadTop(rise, k)
)

// Bark grain frames for foliage.puck's landscapeSurface (`grain: 1`): the turn whose local +X runs along a direction.
// A direction `d` in the tree frame is carried into the creation first, where the surface pattern of a static
// placement at yaw 0 stands; `barkUpright` is the frame of grain that climbs.
function barkAlong(d) = turnAlong((d * [-1, 1, -1]))
let barkUpright = rotate([0, 0, 1], 90)


// A braided trunk: `count` stems twisting up round a core, each a chain of `segments` sweeps, so a trunk reads as
// strands grown together rather than one turned cone. Stem k starts at bearing k / count of a turn and winds `turn`
// degrees from `foot` (its height at the base) to `top`, its axis `out[0]` metres off the core at the foot and `out[1]`
// at the top, tapering from `radius[0]` to `radius[1]`; each sweep bows `bow` metres outward at its middle so the
// strands swell between their crossings. Drawn only: whatever the trunk collides as is the author's own core.
function braidPoint(k, count, t, foot, top, out, turn) = polarPoint(
  ((out[0] * (1 - t)) + (out[1] * t)),
  (((360 * k) / count) + (turn * t)),
  ((foot * (1 - t)) + (top * t))
)
template braidedTrunk(label, count, foot, top, out, radius, material, turn = 150, segments = 3, bow = 0.25, smooth = 0.35) {
  for k in range(0, count) {
    for s in range(0, segments) {
      let t0 = (s / segments)
      let t1 = ((s + 1) / segments)
      let mid = braidPoint(k, count, ((t0 + t1) / 2), foot, top, out, turn)
      shape Sweep $"{label}-{k}-{s}" {
        rotation: rotate([0, 1, 0], 180)
        detail: true
        material: material
        blend: SmoothUnion
        smooth: smooth
        curve {
          a: braidPoint(k, count, t0, foot, top, out, turn)
          b: (mid + (vectorUnit((mid * [1, 0, 1])) * bow))
          c: braidPoint(k, count, t1, foot, top, out, turn)
          radiusStart: ((radius[0] * (1 - t0)) + (radius[1] * t0))
          radiusEnd: ((radius[0] * (1 - t1)) + (radius[1] * t1))
        }
      }
    }
  }
}
