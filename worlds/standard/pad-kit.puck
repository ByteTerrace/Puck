// What the bar's pages and the play wheel's rings share: the twelve controls of the standard bar by the pad button and the
// keyboard key that press each, and the play wheel's standard rings. A library: it emits no document, and the standard
// controls and every refinement of them import it.
//
//   import "pad-kit"
//
// The pad sources are the bar's slot set. The keyboard keys are the owner's rule made a layout: every control the bar
// shows has a keyboard equivalent, so the d-pad is the arrow keys, the face diamond is the I, J, K, L diamond (I north, J
// west, K south, L east), the shoulders are U and O and the stick presses N and M. Under a held page modifier (Z for the
// left trigger, X for the right) each key does what its plate shows. The resting page keeps N and M for the stick
// presses (run on/off and fly) and gives the face buttons their own keys (avatars/moth.puck).

let padUp = ["gamepad.dpadUp", "keyboard.arrowUp"]
let padRight = ["gamepad.dpadRight", "keyboard.arrowRight"]
let padDown = ["gamepad.dpadDown", "keyboard.arrowDown"]
let padLeft = ["gamepad.dpadLeft", "keyboard.arrowLeft"]
let padLeftShoulder = ["gamepad.leftShoulder", "keyboard.u"]
let padLeftStick = ["gamepad.leftStickPress", "keyboard.n"]
let padNorth = ["gamepad.buttonNorth", "keyboard.i"]
let padWest = ["gamepad.buttonWest", "keyboard.j"]
let padSouth = ["gamepad.buttonSouth", "keyboard.k"]
let padEast = ["gamepad.buttonEast", "keyboard.l"]
let padRightShoulder = ["gamepad.rightShoulder", "keyboard.o"]
let padRightStick = ["gamepad.rightStickPress", "keyboard.m"]

// The page modifiers: the triggers, and Z and X for the keyboard. A binding document validates its chords against its own
// modifier list, so each overlay that adds entries to a trigger page declares the pair again (they merge by id).
let padModifiers = [
  { id: "lt", label: "LT", pressThreshold: 0.55, releaseThreshold: 0.35, sources ["gamepad.leftTrigger", "keyboard.z"] }
  {
    id: "rt"
    label: "RT"
    pressThreshold: 0.55
    releaseThreshold: 0.35
    sources ["gamepad.rightTrigger", "keyboard.x"]
  }
]

// view.override takes an Axis1D from a binding; its text names the layout or camera, so the value is never read.
let neverRead = { kind: "Axis1D", raw [0, 0, 0, 0] }

// The shared play-wheel rings. A sector's id names its label and icon (`state.wheelLabels`, `state.wheelIcons`),
// and it carries no source, since the wheel commits it. Each ring names only what every world importing the standard
// has: engine verbs, and no spawn point, channel or layout of its own. A refinement builds its rings from these entry
// lists and adds its own sectors (the debug world's Moth controls add Respawn, Suit and her inspection layouts,
// ../debug/pad-kit.puck).
let actEntries = [
  { id: "console", command: "console", sources: null }
  { id: "build", command: "player.build", sources: null }
  { id: "where", command: "body.where", sources: null }
  { id: "channels", command: "body.channels", sources: null }
  { id: "stop", command: "body.stop", sources: null }
  { id: "annotate", command: "view.annotate", text: "toggle", sources: null }
]

let actRing = { id: "play-acts", label: "Act", entries: actEntries }

// The chase-camera sector: `camera auto` clears a layout or camera override back to the composer's own selection. A
// ring needs two sectors, so the standard draws no View ring of its own; a refinement that authors layouts builds one
// from these entries and its own.
let viewEntries = [
  { id: "autoCamera", command: "view.override", text: "camera auto", value: neverRead, sources: null }
]

let barRing = {
  id: "play-bars"
  label: "Bar"
  entries [
    { id: "barWings", command: "controls.bar", text: "wings single", sources: null }
    { id: "barWingsFull", command: "controls.bar", text: "wings wings", sources: null }
    { id: "barSidebars", command: "controls.bar", text: "sidebars single", sources: null }
    { id: "barSidebarsFull", command: "controls.bar", text: "sidebars wings", sources: null }
    { id: "barCompact", command: "controls.bar.compact", sources: null }
    { id: "barFull", command: "controls.bar.full", sources: null }
  ]
}

let standardRings = [actRing, barRing]
