// At a tabletop: a seat sitting at a board (a placement whose board facet carries `engage`). A module library: it hands
// its importers lets, functions and a rule template, and emits no document.
//
// `tabletopControls()` is the seat's controls while it sits: a binding overlay row whose `tabletop` group the seat's
// bindings switch to while the engine's `engagement` context family reads `tabletop`. Its Board page replaces the
// resting page: the movement keys and the stick step a cursor, confirm picks, cancel puts back, and the context button
// leaves. The rest is what a game's rules read of a seated player: which channel each button reads and which way it is
// pressed, the test for one held past half way, the press it makes, and the step across the board a press makes from
// the seat's chair.
//
//   import "../standard/contexts/tabletop"
//   bindingOverlays [tabletopControls()]

function tabletopControls() = {
  id: "tabletop"
  document {
    version: "puck.input.bindings.v1"
    modifiers []
    contexts [
      { family: "engagement", state: "tabletop", group: "tabletop" }
    ]
    chords [
      {
        chord []
        group: "tabletop"
        page {
          id: "board"
          label: "Board"
          entries [
            {
              channel: "forward"
              id: "forward"
              scale: 1
              sources ["keyboard.w", "keyboard.arrowUp", "gamepad.dpadUp"]
            }
            {
              channel: "forward"
              id: "back"
              scale: -1
              sources ["keyboard.s", "keyboard.arrowDown", "gamepad.dpadDown"]
            }
            {
              channel: "strafe"
              id: "left"
              scale: -1
              sources ["keyboard.a", "keyboard.arrowLeft", "gamepad.dpadLeft"]
            }
            {
              channel: "strafe"
              id: "right"
              scale: 1
              sources ["keyboard.d", "keyboard.arrowRight", "gamepad.dpadRight"]
            }
            { command: "player.move.strafe", id: "move", sources ["gamepad.leftStick"] }
            {
              channel: "confirm"
              id: "confirm"
              label: "Pick"
              scale: 1
              sources ["keyboard.space", "keyboard.enter", "mouse.button1", "gamepad.buttonSouth"]
            }
            {
              channel: "cancel"
              id: "cancel"
              label: "Cancel"
              scale: 1
              sources ["keyboard.escape", "keyboard.backspace", "mouse.button2", "gamepad.buttonEast"]
            }
            {
              channel: "interact"
              id: "interact"
              label: "Leave"
              scale: 1
              sources ["keyboard.e", "gamepad.rightShoulder"]
            }
          ]
        }
      }
    ]
  }
}

// The buttons a table game reads, each a channel past half way in one direction: pick and cancel, and a step each way
// across the board.
let seatSteps = [
  { name: "ahead", channel: "forward", sign: 1 }
  { name: "behind", channel: "forward", sign: -1 }
  { name: "right", channel: "strafe", sign: 1 }
  { name: "left", channel: "strafe", sign: -1 }
]
let seatButtons = concat(
  [{ name: "pick", channel: "confirm", sign: 1 }, { name: "cancel", channel: "cancel", sign: 1 }],
  seatSteps
)

// Seat `seat` holds `channelName` past half way in the direction `sign` names. The test of `sign` short-circuits, so a
// constant sign leaves only its own comparison in the gate, where a choice (`?:`) would read both.
function seatPastOf(seat, channelName, sign) = (sign > 0 and channel(seat, channelName) >= 0.5) or
  (sign <= 0 and channel(seat, channelName) <= -0.5)
function seatPast(channelName, sign) = seatPastOf(1, channelName, sign)

// Whether seat `seat` sits at `boardName` in the chair on side `chairSide` (0 -Z, 1 +X, 2 +Z, 3 -X).
function seatAtSide(boardName, seat, chairSide) = (board(engaged, boardName, seat) == 1) and
  (board(side, boardName, seat) == chairSide)

// Seat 1 is at `boardName` and holds `channelName` past half way in the direction `sign` names.
function seatHeld(boardName, channelName, sign = 1) = board(engaged, boardName, 1) == 1 and seatPast(channelName, sign)

// One button's press this tick, in the seat row's `<button>Edge` and `<button>Down` cells: the edge is 1 on the tick the
// button goes past half way, and the down cell remembers whether it was held.
rule template seatPress(seat, boardName, button) {
  if seatHeld(boardName, button.channel, button.sign) {
    seat[$"{button.name}Edge"] = seat[$"{button.name}Down"] == 0
    seat[$"{button.name}Down"] = 1
  } else {
    seat[$"{button.name}Edge"] = 0
    seat[$"{button.name}Down"] = 0
  }
}

// The value of four, one for each side of a board a chair can stand at (`board(side, …)`): 0 the -Z edge, 1 +X, 2 +Z,
// 3 -X, each in the board's own frame, which turns with the placement that anchors it.
function seatBySide(chairSide, negativeZ, positiveX, positiveZ, negativeX) = ((chairSide == 0) ? negativeZ :
  (chairSide == 1) ? positiveX :
  (chairSide == 2) ? positiveZ :
  negativeX)

// The columns (+X) and rows (+Z) a step moves across `boardName`'s grid, in its own frame, from this tick's ahead and
// right presses (`aheadStep`, `rightStep`, each -1, 0 or 1) of seat 1 in its chair. The seat looks across the board from
// its chair's side and its right is that forward crossed with up, as the board view's camera's is (WorldTabletopFrame in
// Puck.World.Schema): from the -Z side ahead is +row and right is -column, and each side round the board turns both a
// quarter.
function seatColumnStepOn(chairSide, aheadStep, rightStep) = (seatBySide(
  chairSide,
  0 - rightStep,
  0 - aheadStep,
  rightStep,
  aheadStep
))
function seatRowStepOn(chairSide, aheadStep, rightStep) = (seatBySide(
  chairSide,
  aheadStep,
  0 - rightStep,
  0 - aheadStep,
  rightStep
))

// The cell a step from a chair on side `chairSide` moves a cursor to from `fromCell` on a grid `gridColumns` wide and
// `gridRows` deep, held at its edges; `seatStepCell` steps seat 1 from whichever chair it sits in.
function seatStepCellOn(chairSide, fromCell, gridColumns, gridRows, aheadStep, rightStep) = (clamp(
  (fromCell - fromCell % gridColumns) / gridColumns + seatRowStepOn(chairSide, aheadStep, rightStep),
  0,
  gridRows - 1
) * gridColumns + clamp(fromCell % gridColumns + seatColumnStepOn(chairSide, aheadStep, rightStep), 0, gridColumns - 1))
function seatStepCell(boardName, fromCell, gridColumns, gridRows, aheadStep, rightStep) = seatStepCellOn(
  board(side, boardName, 1),
  fromCell,
  gridColumns,
  gridRows,
  aheadStep,
  rightStep
)
