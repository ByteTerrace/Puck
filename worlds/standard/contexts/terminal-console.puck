// A terminal's console: a hidden command line a desk-view terminal's own screen turns into, which runs one of the
// commands that terminal offers. A library: `terminalPlay(console: ...)` (terminal.puck) expands its template, and a
// world lists `terminalConsoleFamily()` in its `inputModes`. It names no place, command or look: what each command does
// is the importing world's rules, which terminals offer it is the world's data, and the screen that shows it is the
// world's own creation, which reads the console's rows below (`terminalConsoleScreen` writes its text templates).
//
// The console is diegetic and shared (the owner's rulings, docs/decisions/play.md "In-world consoles"): it is world
// state shown on the terminal's own screen, never a panel in one seat's view, so everyone looking at that screen sees
// the line appear as it is typed and the replies it draws, and a player learns it by watching another. Its state is
// keyed by the terminal, not by the body typing.
//
// Engaged at a terminal, the console key (the backtick, `toggleSources`) opens the terminal's console; it closes it again
// (as do any `closeSources`), and the console closes when the body that has it open steps back from the terminal.
// Escape is not among them: it is the host's, reserved for the pause menu (docs/decisions/play.md), so no page may bind
// it. While the console is open, every seat engaged at that terminal works it: its controls are the console's alone,
// every character its keyboard commits is typed into the terminal's line, Enter runs it, Backspace erases its last
// character, and nothing the seat presses moves its body or its camera. The console key itself is never typed. A letter
// is typed in lower case, so a line matches without case. The console key reaches the console rather than the host's
// developer console because the host's always-active plane answers only a source the seat's active page leaves unbound.
//
// A line runs only when it is one of the console's command lines, written in lower case, and the terminal offers it.
// Running a command posts its `action` and `value` to that terminal's mailbox (`terminalAction` and `terminalValue`),
// and the world's own rules take it from there as they take a press on the terminal's screen, through the same state;
// the console shows the command's `reply`. Any other line shows the console's `unknown` reply and changes nothing.
//
// The console is a trust boundary its rules enforce, not its look: typed text reaches the simulation only as Text events
// on `terminalText`, which the authority admits only while the seat's body works an open console (the
// `terminal-console` input family), and the only thing that reads them is the key rule below. It writes only the line of
// the terminal the body is engaged with, read from the authority's own `terminalAt` cell, and the run rule writes only
// that terminal's mailbox, never anything the text names. A line reaches no console verb, grant or other terminal.
//
// A command is { line, action, value, reply, terminals }: `line` the text that runs it, `action` a whole number the
// world's rules read (0, the default, only replies), `value` the number posted beside it, `reply` up to
// `terminalConsoleReplyLines` lines it shows, and `terminals` the numbers of the terminals that offer it (every one, when
// absent). The console itself is { commands, greeting, unknown }: `greeting` the reply shown as it opens and `unknown`
// the reply to a line no offered command matches. `terminalWrap` breaks a list of words into reply lines.
//
// The state, keyed by terminal number (a terminal's place in `terminals` from 1) unless it says otherwise:
//
//   terminalConsoleOpen  1 while the terminal's console is open: what a screen's response selects its terminal mode by
//   terminalLine         the line being typed, its letters in lower case
//   terminalLength       how many characters the line holds
//   terminalLast         the last line run, and terminalRan the number of what it ran (0 the greeting, the command's
//                        place in `commands` from 1, and one past the last for the unknown reply)
//   terminalReply        the reply the console shows, its lines joined by line breaks
//   terminalAction       the action of the last command run there, until the world's rules take it and write 0;
//                        terminalValue its value
//   terminalConsoleAt    keyed by body index: the terminal whose open console the body works, 0 for none, which the
//                        console's binding group reads and the body's `terminalConsole` register follows
//
//   import "../standard/contexts/terminal"
//   import "../standard/contexts/terminal-console"
//   inputModes { families [terminalFamily(), terminalConsoleFamily(), ...] }
//   terminalPlay(terminals: [...], console: { commands [{ line: "lamp on", action: 1, value: 1, reply ["the lamp is on"] }] })
//   // the terminal's screen creation, a second prototype its placement responds with while terminalConsoleOpen holds:
//   //   { type: "Box", ..., text { template: terminalConsoleScreen(number), ... } }

// The most characters a line holds, and the lines a reply shows.
let terminalConsoleWidth = 56
let terminalConsoleReplyLines = 10

// The family that offers the console's channels: the console key always, and the typed text, Enter and Backspace while
// the body works an open console.
function terminalConsoleFamily(suspendedBy = []) = {
  name: "terminal-console"
  selector { kind: BodyState, name: "terminalConsole" }
  default: "closed"
  states [
    { name: "closed", values ["0"], channels ["terminalConsole"] }
    { name: "open", values ["1"], channels ["terminalConsole", "terminalText", "terminalEnter", "terminalErase"] }
  ]
  suspendedBy: suspendedBy
  transitions []
}

// The text templates a terminal's screen draws its console with, for terminal `number`: the last line run over its reply,
// whose lines the reply cell holds (`terminalConsoleScreen`), and the line being typed behind a prompt
// (`terminalConsolePrompt`). A screen may colour the first line apart with markup (`echo`, a colour) and the reply with
// another (`reply`).
function terminalConsoleScreen(number, echo = null, reply = null) = $"{terminalConsoleInk(echo, terminalConsoleLastLine(number))}\n{terminalConsoleInk(reply, terminalConsoleReplyText(number))}"
function terminalConsoleLastLine(number) = $"> {{state.terminalLast.{number}}}"
function terminalConsoleReplyText(number) = $"{{state.terminalReply.{number}}}"
function terminalConsolePrompt(number, prompt = "> ", caret = "_") = $"{prompt}{{state.terminalLine.{number}}}{caret}"
function terminalConsoleInk(color, text) = ((color == null) ? text : $"[color={color}]{text}[/color]")

// The words, joined by `gap` into lines no wider than `width` characters, for a command's reply.
function terminalWrap(words, width = terminalConsoleWidth, gap = "  ") = reduce(
  words,
  [""],
  (lines, word) => terminalWrapStep(lines, word, width, gap)
)
function terminalWrapStep(lines, word, width, gap) = ((terminalLastOf(lines) == "") ? concat(
  terminalInitOf(lines),
  [word]
) : (((length(scalars(terminalLastOf(lines))) + length(scalars(gap)) + length(scalars(word))) <= width) ? concat(
  terminalInitOf(lines),
  [$"{terminalLastOf(lines)}{gap}{word}"]
) : concat(lines, [word])))
// A reply's first `terminalConsoleReplyLines` lines as one text, joined by line breaks; a screen shows no more.
function terminalJoin(lines) = reduce(
  range(0, minimum(length(lines), terminalConsoleReplyLines)),
  "",
  (text, i) => ((i == 0) ? lines[i] : $"{text}\n{lines[i]}")
)
function terminalLastOf(lines) = lines[length(lines) - 1]
function terminalInitOf(lines) = filter(lines, (line, i) => (i < (length(lines) - 1)))

// The console's binding group, a binding overlay row listed ahead of the terminal's own so it wins while the body works
// an open console (`terminalConsoleAt` names one of the `count` terminals): the console key closes it, Enter runs the
// line, Backspace erases, and nothing else is bound, so the keys the seat types reach the line and nothing else.
function terminalConsoleOverlay(count, toggleSources, closeSources, enterSources, eraseSources) = {
  id: "terminal-console"
  document {
    version: "puck.input.bindings.v1"
    modifiers []
    contexts: map(
      range(1, count + 1),
      number => { family: "state:terminalConsoleAt", state: $"{number}", group: "terminal-console" }
    )
    chords [
      {
        chord []
        group: "terminal-console"
        page {
          id: "terminal-console"
          label: "Console"
          entries [
            {
              channel: "terminalConsole"
              id: "terminalConsoleClose"
              label: "Close"
              scale: 1
              sources: concat(toggleSources, closeSources)
            }
            { channel: "terminalEnter", id: "terminalEnter", label: "Run", scale: 1, sources: enterSources }
            { channel: "terminalErase", id: "terminalErase", label: "Erase", scale: 1, sources: eraseSources }
          ]
        }
      }
    ]
  }
}

// The consoles of a terminalPlay world's `count` terminals: bodies 0 to `seats` - 1 seeded and up to `capacity` keyed,
// and the local seats 1 to `seats` typing (a step's input events are read for a literal seat). `keysPerStep` bounds the
// characters a seat's line takes in one step.
template terminalConsole(console, count, seats = 4, capacity = 16, keysPerStep = 16) {
  let shown = {
    greeting ["type help for the commands"]
    unknown ["not a command here; type help"]
  } with console
  let commands = map(shown.commands, command => ({ action: 0, value: 0, reply [], terminals: null } with command))
  let unknownNumber = length(commands) + 1
  let stride = length(commands) + 2
  let restricted = flatMap(
    range(0, length(commands)),
    c => ((commands[c].terminals == null) ? [] : map(
      commands[c].terminals,
      t => { key: $"{t * stride + c + 1}", value: 1 }
    ))
  )
  let replies = concat([shown.greeting], map(commands, command => command.reply), [shown.unknown])
  let bodies = map(range(0, seats), body => $"{body}")
  let numbers = map(range(1, count + 1), number => $"{number}")

  channels [
    { name: "terminalConsole", shape: Binary, composition: true }
    { name: "terminalText", shape: Text, composition: true }
    { name: "terminalEnter", shape: Binary, composition: true }
    { name: "terminalErase", shape: Binary, composition: true }
  ]

  state {
    body [
      {
        name: "terminalConsole"
        kind: "Counter"
        initial: 0
        envelope { $type: "set", values [0, 1] }
      }
    ]
    world {
      row {
        name: "terminalConsoleAt"
        kind: Int
        capacity: capacity
        cells: map(bodies, body => { key: body, value: 0 })
      }
      for name in [
        "terminalConsoleOpen", "terminalConsolePosed", "terminalLength", "terminalEntered", "terminalRan",
        "terminalAction", "terminalValue"
      ] {
        table $"{name}" capacity(count) {
          for number in numbers {
            [number] = 0
          }
        }
      }
      // Each terminal's own number, so a rule sweeping the terminals can do arithmetic with the one it is on.
      row {
        name: "terminalNumber"
        kind: Int
        capacity: count
        cells: map(range(1, count + 1), number => { key: $"{number}", value: number })
      }
      for name in ["terminalLine", "terminalLast", "terminalReply"] {
        table $"{name}" capacity(count) {
          for number in numbers {
            [number] = ""
          }
        }
      }
      // The command table: each line's number, and each number's action, value and whether every terminal offers it.
      row {
        name: "terminalCommandOf"
        kind: Int
        capacity: length(commands)
        cells: map(range(0, length(commands)), c => { key: commands[c].line, value: c + 1 })
      }
      row {
        name: "terminalCommandAction"
        kind: Int
        capacity: length(commands)
        cells: map(range(0, length(commands)), c => { key: $"{c + 1}", value: commands[c].action })
      }
      row {
        name: "terminalCommandValue"
        kind: Int
        capacity: length(commands)
        cells: map(range(0, length(commands)), c => { key: $"{c + 1}", value: commands[c].value })
      }
      row {
        name: "terminalCommandAll"
        kind: Int
        capacity: length(commands)
        cells: map(
          range(0, length(commands)),
          c => { key: $"{c + 1}", value: (commands[c].terminals == null) }
        )
      }
      // The terminals a restricted command is offered at, keyed `terminal * stride + command`.
      row {
        name: "terminalOffers"
        kind: Int
        capacity: maximum(1, length(restricted))
        cells: restricted
      }
      // Each reply, its lines joined by line breaks, keyed by what ran (terminalRan).
      row {
        name: "terminalReplies"
        kind: Text
        capacity: length(replies)
        cells: map(range(0, length(replies)), r => { key: $"{r}", value: terminalJoin(replies[r]) })
      }
    }
  }

  // The console key opens the console of the terminal a body is engaged with, and closes it when it is open.
  rule "terminal-console-toggle" {
    forEach: $players
    local at = terminalAt[$each] ?? 0
    local open = terminalConsoleOpen[at] ?? 0
    when channel(each, terminalConsole) >= 1 and at > 0
    mode: Edge
    terminalConsoleOpen[at] = 1 - open
  }
  // Which open console each body works: the terminal it is engaged with, while that terminal's console is open. Its
  // `terminalConsole` register follows, selecting the console's input family, and a body that steps away from a console
  // it worked, however it happens, closes that console.
  rule "terminal-console-use" {
    forEach: $players
    local at = terminalAt[$each] ?? 0
    local using = ((terminalConsoleOpen[at] ?? 0) == 1) ? at : 0
    local was = terminalConsoleAt[$each] ?? 0
    when was != using
    mode: Level
    terminalConsoleAt[$each] = using
    setBodyState(key: $each, state: "terminalConsole", expression: (using > 0) ? 1.0 : 0.0)
    if was > 0 and at != was {
      terminalConsoleOpen[was] = 0
    }
  }
  // An opening or a closing starts the terminal's console afresh: an empty line, and the greeting, which the run below
  // shows for an entry of 2.
  rule "terminal-console-reset" {
    forEach: terminalConsoleOpen
    local open = terminalConsoleOpen[$each] ?? 0
    when (terminalConsolePosed[$each] ?? 0) != open
    mode: Level
    terminalConsolePosed[$each] = open
    setState(state: terminalLine, key: $each, text: "")
    terminalLength[$each] = 0
    terminalEntered[$each] = 2
  }

  // Each event of a seat's step, oldest first, so characters and erases in one step land in the order typed, on the line
  // of the console the seat's body works: a character joins the line, Backspace erases its last character, and Enter
  // marks the line entered (`terminalEntered`), after which later events wait for the run below to take it.
  for seat in range(1, seats + 1) {
    let body = $"{seat - 1}"
    rule $"terminal-console-key-{seat}" {
      forEach: inputEvents(seat)
      maxFirings: keysPerStep
      local raw = inputValue(seat, terminalText, Text, each) ?? 0
      local typed = inputEdge(seat, terminalText, Text, each) and (raw >= 32) and (raw != 96) and (raw != 127)
      local erase = inputEdge(seat, terminalErase, Press, each)
      local enter = inputEdge(seat, terminalEnter, Press, each)
      local at = terminalConsoleAt[body] ?? 0
      local typedCount = terminalLength[at] ?? 0
      when at > 0 and (terminalEntered[at] ?? 0) == 0 and (typed or erase or enter)
      mode: Level
      if typed and typedCount < terminalConsoleWidth {
        terminalLine[at] += ((raw >= 65) and (raw <= 90)) ? (raw + 32) : raw
        terminalLength[at] = typedCount + 1
      }
      if erase and typedCount > 0 {
        terminalLine[at] -= 1
        terminalLength[at] = typedCount - 1
      }
      if enter and typedCount > 0 {
        terminalEntered[at] = 1
      }
    }
  }
  // An entered line (1) runs the command its lower-case text names when the terminal offers it, posting its action to
  // that terminal's mailbox; either way the console shows the reply of what ran (terminalRan) and starts a fresh line. A
  // fresh console (2) shows the greeting.
  rule "terminal-console-run" {
    forEach: terminalEntered
    local entered = terminalEntered[$each] ?? 0
    local at = terminalNumber[$each] ?? 0
    local found = terminalCommandOf[terminalLine[$each]] ?? 0
    local offered = (
      (entered == 1) and
      (found > 0) and
      (((terminalCommandAll[found] ?? 0) == 1) or ((terminalOffers[at * stride + found] ?? 0) == 1))
    )
    local action = offered ? (terminalCommandAction[found] ?? 0) : 0
    when entered
    mode: Level
    terminalEntered[$each] = 0
    terminalRan[$each] = (entered == 2) ? 0 : (offered ? found : unknownNumber)
    if action {
      terminalAction[$each] = action
      terminalValue[$each] = terminalCommandValue[found] ?? 0
    }
    setState(state: terminalLast, key: $each, fromState: terminalLine, fromKey: $each)
    setState(state: terminalReply, key: $each, fromState: terminalReplies, fromKey: terminalRan[$each])
    setState(state: terminalLine, key: $each, text: "")
    terminalLength[$each] = 0
  }
}
