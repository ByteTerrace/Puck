import "kits"

// Reusable wall and ceiling crawl: a Pull hold the named kit takes by driving into a face whose normal lies inside `cone`
// (degrees from gravity-up: 90 a wall, 180 a ceiling), spending its `stamina` body Counter at `spendRate` a second.
// `upLean` 0 keeps the body upright on a wall, 1 lays it on the face. Expand it in a document of its own that the kit's
// document imports: an imported row composes ahead of the kit's own rows, and a held face must outrank the floor a
// climber stands beside. The importing world declares the `stamina` Counter slot (a `resetFact: "Grounded"` refills it
// on landing) and the `release` channel, whose held read lets go.
template crawlHold(kit, name = "crawl", cone = [60, 180], speed = 2, reach = 0.8, upLean = 0, release = "jump", stamina = "stamina", spendRate = 1) {
  kits [
    {
      name: kit
      motion {
        holds [
          {
            name: name
            bond: Surface
            hold: Pull
            cone: cone
            pull: 1
            reach: reach
            speed: speed
            upLean: upLean
            forward: Heading
            onDrive: true
            driveAlignment: 0.3
            release: release
            spend {
              state: stamina
              ratePerSecond: spendRate
            }
          }
        ]
      }
    }
  ]
}

// Jetpack flight, authored into the named kit: thrust, hover and boost. The `flight` action switches it on and off from
// the ground or the air; while it is on, the rise channel lifts the body off the ground and climbs, letting go hovers
// where it is, the movement channels fly it where it faces at `speed` metres a second, and the kit's held pace (the run
// channel) boosts both its travel and its climb. Off, the body walks and falls as the kit's own holds say. The jetpack is
// fuel its two holds spend: `flightFuel` holds `capacity` while it is on and drains `spendRate` a second, so the holds are
// offered only while it is on, and an author who wants a jetpack that runs dry raises the rate and refuels by a rule.
// Expand it in a document of its own that the kit's document imports, so its holds compose ahead of the kit's own (a
// ground row and a fall row), and bind the `flight` channel (the standard's controls do).
template jetpack(kit, speed = 10, spendRate = 0.001, capacity = 1000) {
  state {
    body [
      {
        name: "flightFuel"
        kind: "Counter"
        initial: 0
        envelope { $type: "range", minimum: 0, maximum: capacity }
      }
      {
        name: "flightPress"
        kind: "Counter"
        initial: 0
      }
    ]
  }

  kits [
    {
      name: kit
      motion {
        holds [
          // On the ground the rise channel thrusts it up and away at the kit's own pace.
          groundHold with { name: "groundFlight", thrust: 1, spend { state: "flightFuel", ratePerSecond: spendRate } }
          // In the air it hovers where it is left and thrusts up and down on the rise channel.
          {
            name: "flight"
            bond: Free
            hold: Lift
            forward: Heading
            lift: 1
            speed: speed
            gravity: standardGravity
            thrust: 1
            spend { state: "flightFuel", ratePerSecond: spendRate }
          }
        ]
      }
      // A press is counted, then flipped on the next tick whether the body stands or flies: on to `capacity`, or off
      // to 0.
      actions {
        flight {
          onPress {
            latchSeconds: 0
            effects [
              setState(state: flightPress, value: 1)
            ]
          }
          onFact: concat(
            map(["Grounded", "Airborne"], fact => {
              fact: fact
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Equal, value: 0)
              ])
              effects [
                setState(state: flightFuel, value: capacity)
                setState(state: flightPress, value: 0)
              ]
            }),
            map(["Grounded", "Airborne"], fact => {
              fact: fact
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Greater, value: 0)
              ])
              effects [
                setState(state: flightFuel, value: 0)
                setState(state: flightPress, value: 0)
              ]
            })
          )
        }
      }
    }
  ]
}

// Reusable timed movement burst, authored into the named kit. The importing avatar refines the kit
// with locomotion, shape and other actions, and declares dash plus the two Timer body slots.
template dashAbility(kit, speed = 14, duration = 0.2, cooldown = 0.8) {
  kits [
    {
      name: kit
      actions {
        dash {
          onPress {
            gate: timerElapsed(state: "dashCooldown")
            latchSeconds: 0
            effects [
              planarImpulse(bodyDirection: [0, 0, -1], speed: speed, durationSeconds: duration, useMoveDirection: true)
              startTimer(state: dashCooldown, seconds: cooldown)
              startTimer(state: dashActive, seconds: duration)
            ]
          }
        }
      }
    }
  ]
}

// Climbing, authored into the named kit: she takes a wall by walking or falling into it, climbs it the way the stick
// points, hangs for free, leaps on it for a chunk of stamina, lets go on the run channel, and pulls herself up over
// the top. `cone` is the faces that are walls (degrees from gravity-up); `speed` her pace on the face. On the ground
// she takes a wall only after pushing into it for `driveSeconds`, so brushing one is not a grab; in the air she takes
// it at once. Stamina is the
// `stamina` body Counter, `staminaMax` full: `moveSpend` a second drains while she moves on the face and `restSpend`
// while she hangs still, and a jump on the face costs `jumpCost` and carries her `jumpSpeed` metres a second for
// `jumpSeconds`. Emptied, she is `winded`: she lets go, and cannot climb again until the wheel has refilled. Letting
// go starts the `climbRest` timer, `regrabSeconds` long, so the wall she dropped from does not take her straight back.
// At the top, where the face ends within `mantleHeight` of her feet, she is carried `mantleDepth` in over the edge in
// `mantleSeconds` (the `mantling` timer runs meanwhile); where a face ends with nowhere to stand she hangs at its edge.
//
// Expand it in a document of its own that the kit's document imports, so the climb row composes ahead of the kit's own
// ground and fall rows. Stamina refills under the rows she rests under, so the kit authors `restore: staminaRestore()`
// on its ground and fall rows. Which surfaces can be climbed is the world's `collision.defaultHold` and a placement's
// `grip { holdable }`.
template climbAbility(kit, speed = 2.2, cone = [60, 120], reach = 0.8, pull = 6, driveAlignment = 0.5, driveSeconds = 0.2, staminaMax = 10, moveSpend = 1, restSpend = 0, jumpCost = 2, jumpSpeed = 9, jumpSeconds = 0.2, regrabSeconds = 0.4, mantleHeight = 2.3, mantleDepth = 0.8, mantleSeconds = 0.5) {
  state {
    body [
      {
        name: "stamina"
        kind: "Counter"
        initial: staminaMax
        envelope { $type: "range", minimum: 0, maximum: staminaMax }
      }
      {
        name: "winded"
        kind: "Counter"
        initial: 0
        envelope { $type: "range", minimum: 0, maximum: 1 }
      }
      { name: "climbRest", kind: "Timer", initial: 0 }
      { name: "mantling", kind: "Timer", initial: 0 }
    ]
  }

  kits [
    {
      name: kit
      motion {
        holds [
          {
            name: "climb"
            bond: Surface
            hold: Pull
            cone: cone
            pull: pull
            reach: reach
            speed: speed
            upLean: 0
            forward: Surface
            onDrive: true
            driveAlignment: driveAlignment
            driveSeconds: driveSeconds
            when: all(predicates: [
              timerElapsed(state: "climbRest")
              compareState(state: winded, comparison: Equal, value: 0)
            ])
            spend {
              state: "stamina"
              ratePerSecond: moveSpend
              restingRatePerSecond: restSpend
            }
            mantle {
              height: mantleHeight
              depth: mantleDepth
              seconds: mantleSeconds
              state: "mantling"
            }
          }
        ]
      }
      // The ability's triggers are fact triggers, which fire on the body's state whatever channel's binding carries
      // them, and they are all carried under `run`: a kit's own binding for a channel replaces an imported one, and an
      // avatar authors its own jump. An avatar that authors a `run` action of its own lists these rows in it.
      actions {
        run {
          onFact: concat(
            [
              // A jump press on the face is a leap along it: the trigger fires on the edge of "on a face and jump
              // held", which is the press, and never off a face.
              {
                fact: "HoldingUnwalkable"
                mode: "Edge"
                gate: all(predicates: [
                  held(channel: "jump")
                  compareState(state: stamina, comparison: GreaterOrEqual, value: jumpCost)
                ])
                effects [
                  planarImpulse(bodyDirection: [0, 1, 0], speed: jumpSpeed, durationSeconds: jumpSeconds, useMoveDirection: true)
                  addState(state: stamina, value: -jumpCost)
                ]
              }
              {
                fact: "HoldingUnwalkable"
                mode: "Edge"
                gate: held(channel: "run")
                effects [
                  startTimer(state: climbRest, seconds: regrabSeconds)
                ]
              }
              {
                fact: "Grounded"
                mode: "Level"
                gate: all(predicates: [
                  compareState(state: winded, comparison: Equal, value: 1)
                  compareState(state: stamina, comparison: GreaterOrEqual, value: staminaMax)
                ])
                effects [
                  setState(state: winded, value: 0)
                ]
              }
            ],
            map(["Grounded", "Airborne"], fact => {
              fact: fact
              mode: "Level"
              gate: all(predicates: [
                compareState(state: winded, comparison: Equal, value: 0)
                compareState(state: stamina, comparison: Equal, value: 0)
              ])
              effects [
                setState(state: winded, value: 1)
              ]
            })
          )
        }
      }
    }
  ]
}

// What a row a climber rests under restores: `rate` of stamina a second, while she stands on ground.
function staminaRestore(rate = 3) = {
  state: "stamina"
  ratePerSecond: rate
  when: now(fact: Grounded)
}
