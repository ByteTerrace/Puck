// The stage: the debug world set's plain stage, the world most of its labs, fixtures and places are built on. An 18 m
// floor under a clear midday sun and a pale studio sky, light studio air, the inspection cameras round the stage and the
// hero spawn 68 m clear of everything, and the bodies, gravity, collision and pacing every debug world shares. Its
// player is the set's (player.puck: the standard player module wearing the Moth), so a world built on it seats her and
// overrides what it needs of the stage by id: its own light, air, draw distance, spawn points or floor.
schema: "puck.world.definition.v1"
import "../standard/inputs"
import "../standard/quality"
import "../standard/styles"
import "../standard/tones"
import "../standard/kits"
import "../standard/camera"
import "../standard/stars"
import "player"

documentId: "debug-stage"

bodies {
  capacity: 8
  localSeats: 1
  networkPlayers: 0
  reconnectGraceSeconds: 0
  seatSpawns [
    stage
  ]
  // The standard's idle floor (../../standard/kits.puck).
  sleepAfterSeconds: idleSleepAfter
}

// A 320 by 450 tile of a layout, 0.62 radians wide.
function tileCamera(name, eye, target) = lookCamera(name, eye, target, 0.62, 6, 320, 450)

// Eight tile cameras at 45-degree steps round `centre` ([x, z]) at height `y`, `radius` out and looking at `target`,
// from the front (-Z) turning toward -X; eyes are rounded to 0.1 mm.
let tileRingSides = ["front", "front-left", "left", "back-left", "back", "back-right", "right", "front-right"]
function tileRing(prefix, centre, y, radius, target) = map(range(0, 8), i => tileCamera(
  $"{prefix}-{tileRingSides[i]}",
  [
    round((centre[0] - radius * sine(i * 0.7853981633974483)) * 10000) / 10000,
    y,
    round((centre[1] - radius * cosine(i * 0.7853981633974483)) * 10000) / 10000
  ],
  target
))

cameras: concat(
  // Eight cameras round the jetpack alone, framed on her hovering 2 m above the hero spawn (body.pose 48 2 -48 0 0 0 in
  // flight mode, then view.isolate moth pod* nozzle*), tiled by the pods-hero layout: rear, rear-low, top, below, both
  // sides, the body-facing front and a rear three-quarter.
  [
    tileCamera("pods-rear", [48, 3.12, -45.4], [48, 3.12, -47.8])
    tileCamera("pods-rear-low", [48, 1.4229, -46.1029], [48, 3.12, -47.8])
    tileCamera("pods-top", [48, 5.4025, -47.0584], [48, 3.12, -47.8])
    tileCamera("pods-below", [48, 0.8375, -47.0584], [48, 3.12, -47.8])
    tileCamera("pods-side-left", [45.6, 3.12, -47.8], [48, 3.12, -47.8])
    tileCamera("pods-side-right", [50.4, 3.12, -47.8], [48, 3.12, -47.8])
    tileCamera("pods-front", [48, 3.12, -50.2], [48, 3.12, -47.8])
    tileCamera("pods-rear-three-quarter", [49.4901, 2.4988, -46.0241], [48, 3.12, -47.8])
  ],
  // Eight hero cameras round the shoulders at the hero spawn, at 45-degree steps from the front, tiled by the
  // shoulders-hero layout; each looks down 24 degrees so its frame shows only plain ground behind her.
  tileRing("shoulders", [48, -48], 2.4885, 2.4, [48, 1.42, -48]),
  // Eight hero cameras round the lower legs at the hero spawn, at 45-degree steps from the front, tiled by the legs-hero
  // layout. Each looks down about 20 degrees, so its frame tops out just under the horizon and shows only plain ground.
  tileRing("legs", [48, -48], 1.05, 2, [48, 0.36, -48]),
  [
    lookCamera("front", [0, 1.5, -5.3], [0, 1.13, 0], 0.65)
    lookCamera("three-quarter", [2.9, 2, -4.8], [0, 1.13, 0], 0.65)
    lookCamera("rear", [-2.7, 2, 4.6], [0, 1.15, 0], 0.65)
    lookCamera("flight-stage", [4, 4.3, -6.5], [0, 2.8, 0], 0.65)
    lookCamera("head", [0.9, 2, -2.05], [0, 1.84, 0], 0.54)
    lookCamera("face", [0, 1.9, -1.7], [0, 1.86, 0], 0.5)
    lookCamera("face-side", [1.5, 1.9, -0.9], [0, 1.86, 0], 0.5)
    lookCamera("shoulder", [1.4, 1.75, -1.5], [0.35, 1.4, 0], 0.55)
    lookCamera("back-close", [-0.8, 1.9, 2.2], [0, 1.2, 0], 0.75)
    lookCamera("shoulder-top", [0.42, 2.9, -0.35], [0.42, 1.42, 0], 0.55)
    lookCamera("boots", [0.9, 0.55, -1.7], [0, 0.35, 0], 0.6)
    lookCamera("knee", [0.75, 0.95, -0.95], [0.05, 0.7, 0], 0.42)
    lookCamera("boots-side", [1.9, 0.45, -0.4], [0.2, 0.35, 0], 0.55)
    lookCamera("boots-rear", [0.7, 0.6, 1.8], [0, 0.35, 0], 0.6)
  ]
)



collision {
  contactSkin: 0.02
  defaultHold: false
  gradientProbe: 0
  gridCellSize: 0
  maxIterations: 4
  maxSlopeDegrees: 60
  requirements []
}
gravity {
  attractors []
  gravitationalConstant: 0
  isActive: true
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, -18, 0]
}

host {
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  height: 900
  journalDepth: 2000
  presentMode: Vsync
  presentation: Windowed
  surfaceFormat: r8g8b8a8
  targetHertz: 60
  width: 1280
}
placements {
  placement "floor" {
    prototype: "floor"
    grip {
      holdable: true
    }
    position [0, 0, 0]
    solid
  }
}

prototypes {
  prototype "floor" {
    document {
      name: "floor"
      palette [
        {
          color: "#ADA69F"
          emissive: 0
          specular: 0.02
          roughness: 0.85
        }
      ]
      schema: "puck.creation.v2"
      shape Box "ground" {
        material: 0
        position [0, -0.2, 0]
        scale [18, 0.2, 18]
      }
    }
  }
}

render {
  ambientOcclusion: true
  farDistance: 80
  lighting {
    curvature {
      cavity: 0.15
      ink: 0.04
      inkColor: "#241E28"
      inkHigh: 90
      inkLow: 30
      rim: 0.02
    }
    // The sun, a clear midday's 100,000 lux. The sky fills the shadows: its luminance (each layer's, by default a
    // white surface's under this sun) reaches every surface the irradiance volume finds open to it.
    lights [
      sunlight()
    ]
  }
  // The camera adapts like an eye: it meters each view's own picture and eases there over three quarters of a second,
  // from a sunlit day (about EV 14) down to a dim room (EV 7), where a 150-nit screen shows its picture as bright as a
  // display does and a room lit only by it stays dark. The meter averages the middle four fifths of the picture's
  // brightness, leaving out its darkest corners and its light fittings and sun, weights the centre over the edges, and
  // holds while the picture stays within half a stop of what it settled on, so walking through an evenly lit room never
  // moves it. An averaging meter exposes whatever it sees as a dark grey (its reading lands near a tenth of display
  // white, about sRGB 90 after the tone curve), so snow, a white room or a pale sky reads grey; the basis keys its
  // picture a stop and a quarter brighter, the bright, open look the art direction asks for, which each view's display
  // pass then encodes for the display. It adapts halfway to each surface's own surroundings, so a room beside its sunlit
  // windows reads as the eye sees it rather than as a photograph's dark interior.
  exposure {
    mode: Auto
    minimum: 7
    maximum: 16
    compensation: 1.25
    adaptation: 0.75
    local: 0.5
    band: 0.75
    low: 0.1
    high: 0.9
    center: 0.25
  }
  renderScale: 1
  shadowLights: 1
  shadows: High
  sky {
    layers [
      gradient(visibility: camera, stops: [
        {
          color: "#8E8AA3"
          elevation: -1
        }
        {
          color: "#BDB8C9"
          elevation: -0.05
        }
        {
          color: "#E8E3EC"
          elevation: 0.35
        }
        {
          color: "#F4EFF2"
          elevation: 1
        }
      ])
      gradient(
        name: "studio",
        visibility: lighting,
        stops: [{ elevation: -1, color: "#151117" }, { elevation: 1, color: "#6E6572" }]
      )
      panel(
        name: "panel1",
        direction: [0.6, 1, -0.5],
        size: [0.25, 0.5],
        color: "#FFF1E0",
        intensity: 1.8,
        blur: 0.15,
        visibility: lighting
      )
      panel(
        name: "panel2",
        direction: [-0.6, 0.75, 0.6],
        size: [0.24, 0.6],
        color: "#EEE4FF",
        intensity: 1,
        blur: 0.18,
        visibility: lighting
      )
    ]
  }
  atmosphere {
    fog {
      density: 0.012
    }
  }
  upscaleSharpness: 0
  tone: filmicTone
  environment {
    ambient: 0.40625
    reflection: 1
  }
}
simulation {
  rateHz: 30
}

spawnPoints [
  // A clean stage for inspection shots, 68 m clear of the debug world's test room, cubes, axis markers and portal.
  {
    id: "hero"
    position [48, 0, -48]
    yawDegrees: 0
  }
  {
    id: "stage"
    position [0, 0, 0]
    yawDegrees: 0
  }
]

// The inspection layouts, each one of the cameras above alone, then three that tile eight of them at once. They follow
// the player's own play layout (player.puck), which a boot shows first.
views {
  cameraLayout("three-quarter")
  cameraLayout("front")
  cameraLayout("rear")
  cameraLayout("flight-stage")

  cameraLayout("head")
  cameraLayout("face")
  cameraLayout("face-side")
  cameraLayout("shoulder")
  cameraLayout("back-close")
  cameraLayout("shoulder-top")
  cameraLayout("boots")
  cameraLayout("knee")
  cameraLayout("boots-side")
  cameraLayout("boots-rear")

  // The legs from eight sides at once, for judging the greaves and boots against the model sheet.
  layout "legs-hero" {
    seatCount: 0
    slots [
      {
        camera: "legs-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "legs-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "legs-left"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "legs-back-left"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "legs-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "legs-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "legs-right"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "legs-front-right"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
  }

  // The shoulders from eight sides at once.
  layout "shoulders-hero" {
    seatCount: 0
    slots [
      {
        camera: "shoulders-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "shoulders-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "shoulders-left"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "shoulders-back-left"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "shoulders-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "shoulders-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "shoulders-right"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "shoulders-front-right"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
  }

  // The jetpack from eight sides at once.
  layout "pods-hero" {
    seatCount: 0
    slots [
      {
        camera: "pods-rear"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "pods-rear-low"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "pods-top"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "pods-below"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "pods-side-left"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "pods-side-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "pods-front"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "pods-rear-three-quarter"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
  }
}
