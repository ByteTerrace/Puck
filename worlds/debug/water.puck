// The debug world's water cycle: a glacier on the north-west wall melts over three hours into a lake on the rim, the lake's
// outlet falls to the floor and runs as the river to the pool (pool.puck), and the river drains into an aquifer under the
// floor that fills, gives its water back as springs and settles at one level with the river. The standard's `hydrology`
// (../standard/hydrology.puck) is the flow lattice and the rules; this document chooses its chain and its numbers.
//
// The chain lives in a lattice hidden 90 m under the floor: its cells are the stores and the links between them, not
// places, so the lake, the falls, the stream and the glacier are drawn where the valley wants them and read the gauges
// (`lakeLevel`, `fallsFlow`, `riverDepth`, `aquiferFill`, `glacier`). The pool is the one place the river is a medium a
// body swims in.
//
// Levers: `water.speed <k>` runs the whole cycle k times faster (the melt clock and the flow together; 60 is the three hours
// in three minutes), `world.state glacier` reads the glacier (1 full, 0 gone). `world.fields` prints each lattice row's
// total: hydroIce plus hydroWater is the conserved quantity. hydroClock is elapsed simulated melt ticks.
// A fresh boot returns the cycle to its start.
import "../standard/hydrology"
// The gauges the pool reads and the scenery binds.
exports {
  bindings [glacier, glacierLength, meltStrength, meltVisible, lakeLevel, fallsFlow, riverDepth, aquiferFill]
  reads [poolLevel, aquiferFill]
}

// The chain's numbers. A cell is a metre; the glacier holds 20 units of water, the aquifer ten cells at bed 0 under a river
// of four cells at bed 1 whose water above that is the pool's depth above its 1.5 m base (pool.puck).
hydrology(origin: [-60, -90, 30], meltSeconds: 10800, meltExponent: 3, poolBase: 1.5, poolLevelMax: 2.35, waterPerCell: 10, rate: 0.000625, fullHead: 1.8)

commands [
  {
    name: "water.speed"
    help: "Runs the water cycle k times faster: the glacier's melt clock and the chain's flow rate together. 1 is the cycle's own pace (the glacier gone in three hours), 60 the three hours in three minutes."
    parameters [
      { name: "k", kind: Integer, default: "1" }
    ]
    lines [
      "world.state.cell.set hydroSpeed $value {k}"
    ]
  }
]
