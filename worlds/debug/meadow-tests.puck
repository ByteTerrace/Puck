// Replay covers deterministic contact with the port's relieved scenery, including a walking continuation.
schema: "puck.world.definition.v1"
basis: "debug"
documentId: "debug"
import "stopped-machines"

test "meadow walking continues identically across the relieved lawn" {
  when {
    seat1: body.pose 119.5 0.04 -55.3 0 0 0 0
    ticks 4
    seat1: player.signal keyboard.w press
    ticks 12
    seat1: player.signal keyboard.w release
    ticks 4
  }
  expect {
    bodyPosition(body, 0, x) > 119.4
    bodyPosition(body, 0, x) < 119.6
    bodyPosition(body, 0, z) < -55.5
    bodyPosition(body, 0, z) > -59
    bodyPosition(body, 0, y) > -0.1
    bodyPosition(body, 0, y) < 0.2
  }
}

test "the meadow bank retains its relieved support through replay" {
  when {
    seat1: body.pose 101 2.05 -43 0 0 0 0
    ticks 12
  }
  expect {
    bodyPosition(body, 0, x) == 101
    bodyPosition(body, 0, z) == -43
    bodyPosition(body, 0, y) > 1.98
    bodyPosition(body, 0, y) < 2.1
  }
}
