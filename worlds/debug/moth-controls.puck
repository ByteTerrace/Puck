// The Moth's controls beyond the standard's: Backspace back to the debug world's stage, the View page's plates for her
// inspection layouts (avatars/moth.puck) and the jetpack's isolation, and the play wheel with her Respawn, Suit and
// layout sectors (pad-kit.puck). It imports the standard and refines its controls by page, wheel and table key, so every
// world she walks into (the debug world through controls.puck, the garden and the night field) imports it in the
// standard's place.
import "../standard/standard"
import "pad-kit"

// The standard's screen material, re-exported so a world importing these controls names it.
export binding crt

bindingOverlays [
  {
    id: "moth-controls"
    document {
      version: "puck.input.bindings.v1"
      modifiers: padModifiers
      chords [
        {
          chord []
          group: "play"
          page {
            id: "base"
            entries [
              {
                command: "body.pose"
                id: "respawn"
                label: "Respawn"
                text: "spawn:stage"
                sources ["keyboard.backspace"]
              }
              // Her views by their layout's place in her basis's views.layouts (1 the chase, then her inspection cameras).
              {
                command: "view.override"
                id: "camera1"
                sources [
                  "keyboard.1"
                ]
                value {
                  kind: "Axis1D"
                  raw [1, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera2"
                sources [
                  "keyboard.2"
                ]
                value {
                  kind: "Axis1D"
                  raw [2, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera3"
                sources [
                  "keyboard.3"
                ]
                value {
                  kind: "Axis1D"
                  raw [3, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera4"
                sources [
                  "keyboard.4"
                ]
                value {
                  kind: "Axis1D"
                  raw [4, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera5"
                sources [
                  "keyboard.5"
                ]
                value {
                  kind: "Axis1D"
                  raw [5, 0, 0, 0]
                }
              }
              {
                command: "view.isolate"
                id: "jetpackAlone"
                label: "Jetpack alone"
                sources [
                  "keyboard.f4"
                ]
                text: "toggle moth pod* nozzle*"
              }
            ]
          }
        }
        {
          chord ["lt"]
          group: "play"
          page {
            id: "pad-lt"
            inherits: "base"
            label: "View"
            entries [
              {
                command: "view.override"
                id: "viewPlay"
                label: "Chase"
                text: "layout play"
                value: neverRead
                sources: padUp
              }
              {
                command: "view.override"
                id: "viewQuarter"
                label: "Three-quarter"
                text: "layout three-quarter"
                value: neverRead
                sources: padRight
              }
              {
                command: "view.override"
                id: "viewFront"
                label: "Front"
                text: "layout front"
                value: neverRead
                sources: padDown
              }
              {
                command: "view.override"
                id: "viewRear"
                label: "Rear"
                text: "layout rear"
                value: neverRead
                sources: padLeft
              }
              {
                command: "view.override"
                id: "viewWide"
                label: "Wide"
                text: "layout flight-stage"
                value: neverRead
                sources: padLeftShoulder
              }
              {
                command: "view.isolate"
                id: "viewIsolate"
                label: "Jetpack alone"
                text: "toggle moth pod* nozzle*"
                sources: padWest
              }
              {
                command: "view.override"
                id: "viewFace"
                label: "Face"
                text: "layout face"
                value: neverRead
                sources: padSouth
              }
            ]
          }
        }
      ]
      // A later layer's wheel replaces the earlier one whole, so this restates the standard's with her rings.
      wheels [
        {
          id: "play-primary"
          group: "play"
          holdPages ["wheel-keys", "wheel-pad"]
          labelRow: "state.wheelLabels"
          iconRow: "state.wheelIcons"
          style {
            placement: ViewportCenter
          }
          rings: mothRings
        }
      ]
    }
  }
]

state {
  world {
    table barIcons {
      respawn = "act.respawn"
      camera1 = "act.camera1"
      camera2 = "act.camera2"
      camera3 = "act.camera3"
      camera4 = "act.camera4"
      camera5 = "act.camera5"
      jetpackAlone = "act.isolate"
      viewPlay = "view.play"
      viewQuarter = "view.quarter"
      viewFront = "view.front"
      viewRear = "view.rear"
      viewWide = "view.wide"
      viewIsolate = "act.isolate"
      viewFace = "view.face"
      // suit.puck's Debug-page plate.
      dbgSuit = "dbg.suit"
    }
    table wheelLabels {
      respawn = "Respawn"
      suit = "Suit"
      play = "Play"
      threeQuarter = "Three-quarter"
      front = "Front"
      rear = "Rear"
      wide = "Wide"
      face = "Face"
    }
    table wheelIcons {
      respawn = "act.respawn"
      suit = "dbg.suit"
      play = "act.play"
      threeQuarter = "view.quarter"
      front = "view.front"
      rear = "view.rear"
      wide = "view.wide"
      face = "view.face"
    }
  }
}
