// The bottle world's lever: a post before the globe painting in the painting wing (paintings.puck) that turns the
// gravity of another world. The debug world owns the pull's vector, three rows (`globePullX`, `globePullY`,
// `globePullZ`); the bottle world (globe.puck) follows them a second late and its one gravity area reads its vector
// from them. Each press of the context button beside the post turns the pull a quarter turn: down, west, up, east, and
// down again. Through the painting's glass the room's marbles roll to the new low wall a second after the press.
// `globe.turn <0..3>` sets the turn from the console.

import "../standard/bounds"
import "shapes"

// How hard the bottle world pulls, and the four ways the lever points it.
let globePull = 14
let globeTurns = [
  { name: "down", vector [0, (0 - globePull), 0], indicator: "#7FB8E8" }
  { name: "west", vector [(0 - globePull), 0, 0], indicator: "#E8C27F" }
  { name: "up", vector [0, globePull, 0], indicator: "#E87F9A" }
  { name: "east", vector [globePull, 0, 0], indicator: "#8FE87F" }
]

// The post stands on the wing's floor two metres out from the west fin and north of the globe painting on it (which
// hangs at z 14.4); the reach box is the floor round it.
let leverPostX = 42.4
let leverPostZ = 17
let leverReach = { x0: 41.6, x1: 43.2, z0: 16.2, z1: 17.8, y0: -0.5, y1: 1 }

state {
  world [
    // Which way the lever points (an index into the four turns), and the vector it stands for: the rows the bottle
    // world follows.
    { name: "globeTurn", kind: "Int", value: 0, min: 0, max: 3 }
    { name: "globePullX", kind: "Fixed", value: "0" }
    { name: "globePullY", kind: "Fixed", value: $"{0 - globePull}" }
    { name: "globePullZ", kind: "Fixed", value: "0" }
  ]
}

// A press of the context button inside the reach box turns the lever one step, a seat's or a visitor's; the edge
// fires once a press.
for b in range(0, (seatPopulation + visitorPopulation)) {
  let suffix = ((b == 0) ? "" : $"-{b}")
  rule $"globe-lever{suffix}" {
    when (channel(body, b, interact) >= 1 and
      bodyPosition(body, b, x) > leverReach.x0 and
      bodyPosition(body, b, x) < leverReach.x1 and
      bodyPosition(body, b, z) > leverReach.z0 and
      bodyPosition(body, b, z) < leverReach.z1 and
      bodyPosition(body, b, y) > leverReach.y0 and
      bodyPosition(body, b, y) < leverReach.y1)
    mode: Edge
    globeTurn = floorModulo(globeTurn + 1, 4)
  }
}

// The turn's vector, written when the turn changes: this world's own rule, and the only writer of the three rows.
for (turn, i) in globeTurns {
  rule $"globe-pull-{turn.name}" {
    when globeTurn == i
    mode: Edge
    globePullX = turn.vector[0]
    globePullY = turn.vector[1]
    globePullZ = turn.vector[2]
  }
}

commands [
  {
    name: "globe.turn"
    help: "Points the bottle world's gravity: 0 down, 1 west, 2 up, 3 east. Writes the globeTurn row; this world's rule writes the pull's vector, and the bottle world follows it a second later."
    parameters [
      { name: "turn", kind: Integer }
    ]
    lines [
      "world.state.cell.set globeTurn $value {turn}"
    ]
  }
]

placements {
  placement "globe-lever" {
    prototype: "globe-lever-0"
    position [0, 0.05, 0]
    respond: map(range(1, 3), i => {
      when: state(state: globeTurn, comparison: Equal, value: i)
      prototypeId: $"globe-lever-{i}"
    })
  }
}

prototypes {
  // The post, its handle and the lamp on its head, in world bounds over the wing's floor: the lamp's colour names the
  // way the lever points.
  for (turn, i) in globeTurns {
    prototype $"globe-lever-{i}" {
      document {
        name: $"globe-lever-{i}"
        schema: "puck.creation.v1"
        palette [
          { color: "#F2EEE4", roughness: 0.55, specular: 0.08 }
          { color: "#3A3F47", roughness: 0.6, specular: 0.15 }
          { color: turn.indicator, roughness: 0.4, emissive: 300 }
        ]
        boundsBox(
          label: "post",
          x0: (leverPostX - 0.09),
          x1: (leverPostX + 0.09),
          y0: 0,
          y1: 1.05,
          z0: (leverPostZ - 0.09),
          z1: (leverPostZ + 0.09),
          slot: 0
        )
        boundsBox(
          label: "handle",
          x0: (leverPostX - 0.03),
          x1: (leverPostX + 0.03),
          y0: 1.05,
          y1: 1.3,
          z0: (leverPostZ - 0.03),
          z1: (leverPostZ + 0.03),
          slot: 1
        )
        boundsBox(
          label: "lamp",
          x0: (leverPostX - 0.06),
          x1: (leverPostX + 0.06),
          y0: 1.3,
          y1: 1.4,
          z0: (leverPostZ - 0.06),
          z1: (leverPostZ + 0.06),
          slot: 2
        )
      }
    }
  }
}
