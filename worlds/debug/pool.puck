// The pool: the swimmable end of the river. A basin sunk 2.4 m into the lawn (the floor opens for it, lawn.puck) holds a
// medium lattice, one row of water whose value is the depth over the basin's floor and whose surface the Moth floats on
// (avatars/moth.puck's swim hold). The lattice is the river's last reach as the player sees it: every lattice step sets
// the pool to `poolLevel`, the depth water.puck's chain gives the river in its last cell above the pool's permanent
// depth, so the pool's surface sinks and rises with the river. Three steps in the basin's east end, beside the path, let a
// swimmer climb out. `debug.go pool` stands a body on the path's end facing the water.
import "water-site"

// The pool's cells: half a metre square, so the surface a swimmer reads steps by no more than the cell.
let poolCell = 0.5
let poolCells = [
  floor((poolHole[2] - poolHole[0]) / poolCell)
  floor((poolHole[3] - poolHole[1]) / poolCell)
]
// The depth the pool holds before the river adds to it, and the most it can: 5 cm under the lawn.
let poolDepthStart = 1.5
let poolDepthMax = 2.35

// The basin's walls and floor in the author frame, where +X and +Z are world -X and -Z: a wall at world offset (dx, dz)
// from the pool's centre stands at author (-dx, -dz). Its steps rise against the east wall, each a box from the wall
// inward, topped 0.6 m above the one below.
let basinWall = 0.15
let basinLow = poolFloor - basinWall * 2
let basinHigh = -0.4
let wallMid = (basinLow + basinHigh) / 2
let wallHalf = (basinHigh - basinLow) / 2
let basinStepTops = [-1.2, -0.9, -0.6, -0.3]
let basinStepLength = 0.8

prototypes {
  prototype "pool-basin" {
    document {
      name: "pool-basin"
      schema: "puck.creation.v1"
      palette [
        { color: "#B9A78A", roughness: 0.92, specular: 0.02 }
        { color: "#A39075", roughness: 0.92, specular: 0.02 }
      ]
      shape Box "bed" {
        material: 0
        position [0, poolFloor - basinWall, 0]
        scale [poolHalf[0] + basinWall * 2, basinWall, poolHalf[1] + basinWall * 2]
      }
      shape Box "wall-east" {
        material: 1
        position [0 - (poolHalf[0] + basinWall), wallMid, 0]
        scale [basinWall, wallHalf, poolHalf[1] + basinWall * 2]
      }
      shape Box "wall-west" {
        material: 1
        position [poolHalf[0] + basinWall, wallMid, 0]
        scale [basinWall, wallHalf, poolHalf[1] + basinWall * 2]
      }
      shape Box "wall-south" {
        material: 1
        position [0, wallMid, poolHalf[1] + basinWall]
        scale [poolHalf[0] + basinWall * 2, wallHalf, basinWall]
      }
      shape Box "wall-north" {
        material: 1
        position [0, wallMid, 0 - (poolHalf[1] + basinWall)]
        scale [poolHalf[0] + basinWall * 2, wallHalf, basinWall]
      }
      for (top, i) in basinStepTops {
        shape Box $"step-{i}" {
          material: 0
          position [
            0 - (poolHalf[0] - (basinStepLength * (4 - i)) / 2),
            (top + poolFloor) / 2,
            0
          ]
          scale [(basinStepLength * (4 - i)) / 2, (top - poolFloor) / 2, 2]
        }
      }
    }
  }
}

placements {
  placement "pool-basin" {
    prototype: "pool-basin"
    position [poolCentre[0], 0, poolCentre[1]]
    solid
  }
}

state {
  lattices [
    field(
      name: "pool",
      origin: [poolHole[0], poolFloor, poolHole[1]],
      cellSize: poolCell,
      width: poolCells[0],
      depth: poolCells[1],
      layers: 1,
      stepEveryTicks: 8,
      reactions: [
        transform(when: [
          { field: poolWater, comparison: GreaterOrEqual, value: 0 }
        ], then: [
          { field: poolWater, op: Set, value { row: "poolLevel" } }
        ])
      ]
    )
  ]
  world {
    row {
      name: "poolWater"
      kind: "Fixed"
      domain: cellsOf(topology: pool)
      field {
        initial: poolDepthStart
        min: 0
        max: poolDepthMax
        heightScale: 1
        color: "#3FB8C4"
        medium {}
      }
    }
  }
}

spawnPoints [
  { id: "pool", position [poolHole[2] + 3, 0.05, poolCentre[1]], yawDegrees: 270 }
]
