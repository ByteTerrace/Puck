// The walkthrough's route segments, each a controller program played as a player plays: stick deflections and button
// presses on exact ticks through seat 1's own bindings (`player.signal`, the path a pad's samples take), in first person,
// from a declared spawn point to an arrival box. `puck test worlds/debug/walkthrough-tests.puck --reproduce` shows each
// segment arrives and reproduces; `puck sweep --tour` plays the same program in a windowed World and captures each
// exhibit it passes (the plan's route stops, worlds/debug/sweep.json), so a world edit that moves the walker breaks one
// segment, named off course, rather than the run.
//
// The program's ticks are the route's clock: the sweep's capture offsets count from the first `when` line, so a change
// to a segment's timing moves its captures in the plan too.

schema: "puck.world.definition.v1"
basis: "debug"
documentId: "walkthrough-tests"
import "stopped-machines"

// Gallery level 1's blend row (shapes.puck's blendExhibits): from the UNION spawn point, strafe along +X past every
// blend, stopping square in front of each one for 25 ticks. Facing +Z, the stick's left strafes toward +X. A full
// deflection held 18 ticks carries her 2.51 m and 19 ticks 2.65 m on this floor, so the pattern 19, 19, 18 keeps every
// stop within 0.13 m of its exhibit's spawn point against the row's 2.6 m spacing.
test "gallery level 1 blend row" {
  when {
    seat1: body.pose spawn:shape-blend-union 0
    ticks 1
    seat1: player.camera.view first
    ticks 9
    // Recenter: the View page (left trigger) and its North face button.
    seat1: player.signal gamepad.leftTrigger 1
    seat1: player.signal gamepad.buttonNorth press
    ticks 2
    seat1: player.signal gamepad.buttonNorth release
    seat1: player.signal gamepad.leftTrigger 0
    ticks 2
    // Look down about 20 degrees, so each plinth's plaque stands in frame below its exhibit.
    seat1: player.signal gamepad.rightStick 0 -1
    ticks 3
    seat1: player.signal gamepad.rightStick 0 0
    ticks 25
    // on to subtraction
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to intersection
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to xor
    seat1: player.signal gamepad.leftStick -1 0
    ticks 18
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to smooth union
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to smooth subtraction
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to smooth intersection
    seat1: player.signal gamepad.leftStick -1 0
    ticks 18
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to chamfer union
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to chamfer subtraction
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to chamfer intersection
    seat1: player.signal gamepad.leftStick -1 0
    ticks 18
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to groove union
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to pipe union
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to groove subtraction
    seat1: player.signal gamepad.leftStick -1 0
    ticks 18
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
    // on to pipe subtraction
    seat1: player.signal gamepad.leftStick -1 0
    ticks 19
    seat1: player.signal gamepad.leftStick 0 0
    ticks 26
  }
  expect {
    // Arrival: within half a metre of PIPE SUBTRACT's spawn point (56.8, 4.55, 22.2), standing.
    bodyPosition(body, 0, x) > 56.3
    bodyPosition(body, 0, x) < 57.3
    bodyPosition(body, 0, z) > 21.7
    bodyPosition(body, 0, z) < 22.7
    bodyPosition(body, 0, y) > 4.5
    bodyPosition(body, 0, y) < 4.7
    fact(body, 0, Grounded) == 1
  }
}
