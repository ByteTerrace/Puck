// The walkthrough's route segments, each a controller program played as a player plays: stick deflections and button
// presses on exact ticks through seat 1's own bindings (`player.signal`, the path a pad's samples take), in first person,
// from a declared spawn point to an arrival box. `puck test worlds/debug/walkthrough-tests.puck --reproduce` shows each
// segment arrives and reproduces; `puck sweep --tour` plays the same program in a windowed World and captures each
// exhibit it passes (the plan's route stops, worlds/debug/sweep.json), so a world edit that moves the walker breaks one
// segment, named off course, rather than the run.
//
// The program's ticks are the route's clock: the sweep's capture offsets count from the first `when` line and fall on
// the program's rests, so a change to a segment's timing moves its captures in the plan too.

schema: "puck.world.definition.v1"
basis: "debug"
// The seam walk's painting crossing goes through the garden and comes home through its way back, which names the
// debug world's id (docs/authoring/testing-a-world.md#crossing-into-another-document).
documentId: "debug"
import "stopped-machines"

// The ticks the left stick is held at full deflection to strafe from one exhibit of a gallery row to the next. On the
// gallery's floors a held deflection carries her 2.51 m in 18 ticks and 2.65 m in 19, so the pattern 19, 19, 18 keeps
// every rest within 0.13 m of its exhibit's spawn point against a row's 2.6 m spacing. A row of n exhibits takes the
// first n - 1 holds.
let rowHolds = [19, 19, 18, 19, 19, 18, 19, 19, 18, 19, 19, 18, 19, 19, 18, 19, 19]
let blendRowHolds = filter(rowHolds, (hold, index) => (index < 13))
let primitivesRowHolds = filter(rowHolds, (hold, index) => (index < 9))

// Gallery level 1's blend row (shapes.puck's blendExhibits): from the UNION spawn point, strafe along +X past every
// blend, resting 26 ticks square in front of each one. Facing +Z, the stick's left strafes toward +X.
test "gallery level 1 blend row" {
  when {
    seat1: body.pose spawn:shape-blend-union 0
    ticks 1
    seat1: player.camera.view first
    ticks 9
    // Recenter: the View page (left trigger) and its North face button.
    seat1: player.signal gamepad.leftTrigger 1
    seat1: player.signal gamepad.buttonNorth press
    ticks 2
    seat1: player.signal gamepad.buttonNorth release
    seat1: player.signal gamepad.leftTrigger 0
    ticks 2
    // Look down, the right stick held two ticks, so each plinth's plaque stands in frame below its exhibit; three
    // ticks tilt the eye far enough to cut the exhibit off at the top of the frame.
    seat1: player.signal gamepad.rightStick 0 -1
    ticks 2
    seat1: player.signal gamepad.rightStick 0 0
    ticks 26
    for hold in blendRowHolds {
      seat1: player.signal gamepad.leftStick -1 0
      repeat hold {
        ticks 1
      }
      seat1: player.signal gamepad.leftStick 0 0
      ticks 26
    }
  }
  expect {
    // Arrival: within half a metre of PIPE SUBTRACT's spawn point (56.8, 4.55, 22.2), standing.
    bodyPosition(body, 0, x) > 56.3
    bodyPosition(body, 0, x) < 57.3
    bodyPosition(body, 0, z) > 21.7
    bodyPosition(body, 0, z) < 22.7
    bodyPosition(body, 0, y) > 4.5
    bodyPosition(body, 0, y) < 4.7
    fact(body, 0, Grounded) == 1
  }
}

// Gallery level 0's primitives row (shapes.puck's uniformRow): from the SPHERE spawn point, strafe along +X past each
// primitive at a uniform scale, resting 26 ticks square in front of each one, as the blend row does.
test "gallery level 0 primitives row" {
  when {
    seat1: body.pose spawn:shape-sphere 0
    ticks 1
    seat1: player.camera.view first
    ticks 9
    seat1: player.signal gamepad.leftTrigger 1
    seat1: player.signal gamepad.buttonNorth press
    ticks 2
    seat1: player.signal gamepad.buttonNorth release
    seat1: player.signal gamepad.leftTrigger 0
    ticks 2
    seat1: player.signal gamepad.rightStick 0 -1
    ticks 2
    seat1: player.signal gamepad.rightStick 0 0
    ticks 26
    for hold in primitivesRowHolds {
      seat1: player.signal gamepad.leftStick -1 0
      repeat hold {
        ticks 1
      }
      seat1: player.signal gamepad.leftStick 0 0
      ticks 26
    }
  }
  expect {
    // Arrival: within half a metre of PLANE's spawn point (46.4, 0.05, 13.2), standing.
    bodyPosition(body, 0, x) > 45.9
    bodyPosition(body, 0, x) < 46.9
    bodyPosition(body, 0, z) > 12.7
    bodyPosition(body, 0, z) < 13.7
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    fact(body, 0, Grounded) == 1
  }
}

// The seam walk (docs/plans/streaming-and-memory.md#the-seam-walk): the debug world's three crossings, each walked at
// three speeds by a controller program that starts before the crossing's first demand, passes it, comes back and takes
// an abrupt reversal at the threshold. `puck bench frames --plan worlds/debug/seam-walk.sweep.json --stop
// seam-<crossing>-<speed> --window` plays a block as a window over its own timeline (the stop's `opens` is the first
// tick after the approach the program idles through), and `puck test --reproduce` proves it arrives.
//
// A step is a console line and the ticks it holds (30 Hz). The three speeds are the standard package's: the Moth walks
// at 5 m/s and runs at 10 with Left Shift held (a hold, so no run toggle outlives the walk), and the fastest is the run
// with the dash (standard/abilities.puck's 14 m/s impulse, a cooldown of 0.8 s) pressed on each cooldown, which carries
// her 12 m in each 25 ticks. A forward leg re-asserts the left stick every fifteen ticks: a crossing between authorities
// resets the seat's held controls (docs/plans/streaming-and-memory.md#where-a-seam-can-show), and a player holding the
// stick re-presses it, so the walk does too. A half turn is the right stick held at full deflection for 27 ticks
// (6.68 degrees a tick). The legs' lengths are metres at the speed's measured pace; a leg's last stretch under one dash
// is run plainly.
function step(line, wait) = { line: line, wait: wait }
let stickForward = "player.signal gamepad.leftStick 0 1"
let stickBack = "player.signal gamepad.leftStick 0 -1"
let stickRest = "player.signal gamepad.leftStick 0 0"
let dashPress = "player.signal gamepad.buttonWest press"
let dashRelease = "player.signal gamepad.buttonWest release"
let seamWalking = { step: 0.1667, shift: 0, beat: 0, chunk: 15 }
let seamRunning = { step: 0.3333, shift: 1, beat: 0, chunk: 15 }
let seamFastest = { step: 0.3333, shift: 1, beat: 12, chunk: 15 }

// The View page's North button under the left trigger recenters the camera on the body's facing.
let seamRecenter = [
  step("player.signal gamepad.leftTrigger 1", 0)
  step("player.signal gamepad.buttonNorth press", 2)
  step("player.signal gamepad.buttonNorth release", 0)
  step("player.signal gamepad.leftTrigger 0", 2)
]
let seamTurn = [
  step(stickRest, 2)
  step("player.signal gamepad.rightStick 1 0", 27)
  step("player.signal gamepad.rightStick 0 0", 3)
]

// Metres walked at a speed: a dash beat (the stick, the dash and its cooldown, 25 ticks) for each whole `beat` metres
// of a speed that dashes, then the rest in chunks of `chunk` ticks of the stick (a schedule holds at most 256 rows).
function seamBeats(speed, metres) = ((speed.beat > 0) ? floor(metres / speed.beat) : 0)
function seamForward(speed, metres) = concat(
  flatMap(
    range(0, seamBeats(speed, metres)),
    beat => [step(stickForward, 1), step(dashPress, 1), step(dashRelease, 23)]
  ),
  flatMap(
    range(0, ceiling((metres - (seamBeats(speed, metres) * speed.beat)) / (speed.step * speed.chunk))),
    chunk => [step(stickForward, speed.chunk)]
  )
)
function seamStart(speed, spawn) = concat(
  [step($"body.pose spawn:{spawn} 0", 1), step("player.camera.view first", 9)],
  seamRecenter,
  ((speed.shift > 0) ? [step("player.signal keyboard.shiftLeft press", 60)] : [step(stickRest, 60)])
)
function seamEnd(speed) = [step(stickRest, 10), step("player.signal keyboard.shiftLeft release", 20)]
function seamLines(program) = map(program, s => s.line)
function seamWaits(program) = map(program, s => s.wait)

// Crossing 1: the valley floor, the entrance and the lobby (hall.puck: the entrance is in the south face at x 14 .. 18,
// z 12). From 36 m before the door to 14 m inside it and back, then in again with the stick pulled back at the threshold.
function seamValley(speed) = concat(
  seamStart(speed, "seam-valley"),
  seamForward(speed, 50),
  seamTurn,
  seamForward(speed, 50),
  seamTurn,
  seamForward(speed, 34.5),
  [step(stickBack, 15)],
  seamForward(speed, 17),
  seamEnd(speed)
)

// Crossing 2: the garden painting (paintings.puck: the glass is at z 39.2). Eleven metres to it with a pull back at its
// face, through it and eight metres into the garden, then back through the garden's arrival frame into the wing.
function seamPainting(speed) = concat(
  seamStart(speed, "seam-painting"),
  seamForward(speed, 9.7),
  [step(stickBack, 12)],
  seamForward(speed, 11),
  [step(stickRest, 2)],
  seamTurn,
  seamForward(speed, 14),
  seamEnd(speed)
)
// Crossing 3: the lift (hall.puck: the car's door faces south onto the level 0 landing at z 36, the cab z 36 .. 40).
// Into the car, up to level 3 and out onto its landing, back into the car and down.
function seamLift(speed) = concat(
  seamStart(speed, "gallery-level-0"),
  [step("world.state.cell.set liftCall $value 0", 20)],
  seamForward(speed, 4.9),
  [step(stickRest, 2), step("world.state.cell.set liftCall $value 3", 150)],
  seamTurn,
  [step(stickRest, 150)],
  seamForward(speed, 3),
  [step(stickBack, 10)],
  seamForward(speed, 2.5),
  [step(stickRest, 2)],
  seamTurn,
  [step("world.state.cell.set liftCall $value 3", 20)],
  seamForward(speed, 5.5),
  [step(stickRest, 2), step("world.state.cell.set liftCall $value 0", 150)],
  seamTurn,
  [step(stickRest, 150)],
  seamForward(speed, 5.5),
  seamEnd(speed)
)

let seamValleyWalking = seamValley(seamWalking)
test "seam walk: the valley into the gallery, walking" {
  when {
    for (line, index) in seamLines(seamValleyWalking) {
      seat1: {line}
      repeat seamWaits(seamValleyWalking)[index] {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: back inside the lobby, past the entrance (15.5, 26.9 measured), standing.
    bodyPosition(body, 0, x) > 14
    bodyPosition(body, 0, x) < 17
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    bodyPosition(body, 0, z) > 25.4
    bodyPosition(body, 0, z) < 28.4
    fact(body, 0, Grounded) == 1
  }
}

let seamValleyRunning = seamValley(seamRunning)
test "seam walk: the valley into the gallery, running" {
  when {
    for (line, index) in seamLines(seamValleyRunning) {
      seat1: {line}
      repeat seamWaits(seamValleyRunning)[index] {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: back inside the lobby, past the entrance (16.0, 26.6 measured), standing.
    bodyPosition(body, 0, x) > 14.5
    bodyPosition(body, 0, x) < 17.5
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    bodyPosition(body, 0, z) > 25.1
    bodyPosition(body, 0, z) < 28.1
    fact(body, 0, Grounded) == 1
  }
}

let seamValleyFastest = seamValley(seamFastest)
test "seam walk: the valley into the gallery, fastest" {
  when {
    for (line, index) in seamLines(seamValleyFastest) {
      seat1: {line}
      repeat seamWaits(seamValleyFastest)[index] {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: back inside the lobby, past the entrance (15.8, 31.9 measured), standing.
    bodyPosition(body, 0, x) > 14.3
    bodyPosition(body, 0, x) < 17.3
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    bodyPosition(body, 0, z) > 30.4
    bodyPosition(body, 0, z) < 33.4
    fact(body, 0, Grounded) == 1
  }
}

let seamPaintingWalking = seamPainting(seamWalking)
test "seam walk: the garden painting, walking" {
  when {
    for (line, index) in seamLines(seamPaintingWalking) {
      seat1: {line}
      repeat seamWaits(seamPaintingWalking)[index] {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: back in the wing, south of the garden painting (57.1, 34.3 measured), standing.
    bodyPosition(body, 0, x) > 55.6
    bodyPosition(body, 0, x) < 58.6
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    bodyPosition(body, 0, z) > 32.8
    bodyPosition(body, 0, z) < 35.8
    fact(body, 0, Grounded) == 1
  }
}

