// The walkthrough's route segments, each a controller program played as a player plays: stick deflections and button
// presses on exact ticks through seat 1's own bindings (`player.signal`, the path a pad's samples take), in first person,
// from a declared spawn point. `puck test worlds/debug/walkthrough-tests.puck --reproduce` shows each segment arrives and
// reproduces; `puck sweep --tour` plays the same program in a windowed World and captures each exhibit it shows (the
// plan's route stops, worlds/debug/sweep.json), so a world edit that breaks a display breaks one segment rather than the
// run.
//
// The program's ticks are the route's clock: the sweep's capture offsets count from the first `when` line and fall on
// the program's rests, so a change to a segment's timing moves its captures in the plan too.

schema: "puck.world.definition.v1"
basis: "debug"
// The debug world's own id, so a segment that steps through one of its same-world portals stays in the boot instance
// (docs/authoring/testing-a-world.md#crossing-into-another-document).
documentId: "debug"
import "stopped-machines"

// A display's step: gallery.step shows the catalog's next exhibit on the display's turntable, then a rest of 28 ticks
// while the screen follows. A display's own group of n exhibits takes n - 1 steps to show, from its first; each step's
// capture falls two ticks before the next step (sweep.json).
let displayPressTicks = 2
let displayRestTicks = 26

// Gallery level 1's blends display (shapes.puck's galleryDisplays): from its console, step through every blend of a box
// and a sphere. The spawn stands her turned for the chase camera; she is squared to the console, which faces -Z, so she
// faces +Z.
test "gallery level 1 blends display" {
  when {
    seat1: body.pose spawn:display-blends 0
    ticks 1
    seat1: body.pose - - - 180 - - 0
    ticks 1
    seat1: player.camera.view first
    ticks 9
    // Recenter: the View page (left trigger) and its North face button.
    seat1: player.signal gamepad.leftTrigger 1
    seat1: player.signal gamepad.buttonNorth press
    ticks 2
    seat1: player.signal gamepad.buttonNorth release
    seat1: player.signal gamepad.leftTrigger 0
    ticks 2
    // Look down, the right stick held two ticks, so the console's screen stands in frame below the exhibit.
    seat1: player.signal gamepad.rightStick 0 -1
    ticks 2
    seat1: player.signal gamepad.rightStick 0 0
    ticks 26
    repeat 13 {
      seat1: gallery.step blends
      repeat displayPressTicks {
        ticks 1
      }
      repeat displayRestTicks {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: the last blend (PIPE SUBTRACT, the display's fourteenth, catalog index 65) on the turntable and its copy
    // on the screen, the catalog's sixty-sixth, and the body still at the console, standing.
    gallerySelect.blends == 65
    galleryShownAt.blends == 65
    galleryPlace.blends == 66
    // Within half a metre of the display's spawn point (34, 4.55, 43.5), before its console.
    bodyPosition(body, 0, x) > 33.5
    bodyPosition(body, 0, x) < 34.5
    bodyPosition(body, 0, z) > 43
    bodyPosition(body, 0, z) < 44
    bodyPosition(body, 0, y) > 4.5
    bodyPosition(body, 0, y) < 4.7
    fact(body, 0, Grounded) == 1
  }
}

// Gallery level 0's primitives display: from its console in the nave, step through each primitive at a uniform scale,
// resting before each one as the blends display does. The console faces +Z, so she faces -Z.
test "gallery level 0 primitives display" {
  when {
    seat1: body.pose spawn:display-primitives 0
    ticks 1
    seat1: body.pose - - - 0 - - 0
    ticks 1
    seat1: player.camera.view first
    ticks 9
    seat1: player.signal gamepad.leftTrigger 1
    seat1: player.signal gamepad.buttonNorth press
    ticks 2
    seat1: player.signal gamepad.buttonNorth release
    seat1: player.signal gamepad.leftTrigger 0
    ticks 2
    seat1: player.signal gamepad.rightStick 0 -1
    ticks 2
    seat1: player.signal gamepad.rightStick 0 0
    ticks 26
    repeat 9 {
      seat1: gallery.step primitives
      repeat displayPressTicks {
        ticks 1
      }
      repeat displayRestTicks {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: PLANE CUT, the tenth primitive (catalog index 9), on the turntable and the screen.
    gallerySelect.primitives == 9
    galleryShownAt.primitives == 9
    galleryPlace.primitives == 10
    // Within half a metre of the display's spawn point (46, 0.05, 27.95), before its console.
    bodyPosition(body, 0, x) > 45.5
    bodyPosition(body, 0, x) < 46.5
    bodyPosition(body, 0, z) > 27.45
    bodyPosition(body, 0, z) < 28.45
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    fact(body, 0, Grounded) == 1
  }
}
