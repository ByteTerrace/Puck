// Shared elemental colours and glyphs for the debug world's exhibits.
// Alchemy (alchemy.puck) and the combat yard keep separate element identities and state tables; they share only these
// surface colours and two-character glyph codes.

let elementNothingColor = "#32363C"
let elementAirColor = "#B8E6FF"
let elementEarthColor = "#8B5A2B"
let elementFireColor = "#FF5224"
let elementWaterColor = "#2478FF"
let elementFrostColor = "#A8F0F8"
let elementShockColor = "#FFE033"
let elementPoisonColor = "#4E6B3A"
let elementArcaneColor = "#FF66B2"
let elementStoneColor = "#888E94"
let elementMetalColor = "#B8C2CC"
let elementWoodColor = "#A06A3B"
let elementLifeColor = "#34B84A"
let elementSteamColor = "#DCE8F2"
let elementMudColor = "#6B4C35"
let elementLavaColor = "#FF3800"
let elementDustColor = "#D2B48C"
let elementCloudColor = "#F0F4F8"
let elementRainColor = "#5CA4FF"
let elementSeaColor = "#0E4D92"
let elementSandColor = "#EED690"
let elementLightningColor = "#FFF066"
let elementTreeColor = "#268536"
let elementAshColor = "#585450"
