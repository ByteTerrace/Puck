let elementHouseColor = "#E29A5C"

let elementFamilyGlyphs = {
  air: "Ai"
  arcane: "Ar"
  earth: "Ea"
  fire: "Fi"
  frost: "Fr"
  life: "Li"
  metal: "Me"
  physical: "Ph"
  poison: "Po"
  shock: "Sh"
  stone: "Sn"
  water: "Wa"
  wood: "Wo"
}

// One style row per Alchemy element ordinal (0 Nothing, 1 Air .. 31 House): surface colour, roughness, specular and
// two-letter glyph code.
let alchemyElementStyles = [
  { color: elementNothingColor, glyph: "--", name: "Nothing", roughness: 0.75, specular: 0.08 }
  { color: elementAirColor, glyph: elementFamilyGlyphs.air, name: "Air", roughness: 0.35, specular: 0.25 }
