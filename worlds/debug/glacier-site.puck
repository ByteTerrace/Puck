// Where the debug world's glacier lies and what it is made of: a body of ice lying in a U-shaped trough that runs down a ridge
// behind the lake and ends at the lake's back shore, so its melt feeds the lake. A library: it emits no document. The ridge,
// the trough carved in it, the grooves in the trough's floor and the moraine banked along it are the north-west wall's own
// rock (valley.puck); the ice is a creation lying in the trough. Every piece is placed on the trough's ramp frame:
// `rampPoint(s, x, n)` is `s` metres up the ramp from the lake's shore, `x` along the ring and `n` off the ramp along its normal.
import "../standard/water"
import "valley-form"
import "water-site"

let degree = 0.017453292519943295
// The ramp climbs at the ridge's own mean slope, so the trough cut along it stays about as deep under the ridge's top from the
// lake to the head, and the ice lies in a cradle the whole way rather than standing proud of the ridge's crest.
let rampAngle = 30
let rampSin = sine(rampAngle * degree)
let rampCos = cosine(rampAngle * degree)
// Where the ramp's foot touches the lake's surface, out from the ring's centre.
let rampRadial = 474
function rampPoint(s, x, n) = [
  x,
  lakeSite.surface + s * rampSin + n * rampCos,
  rampRadial + s * rampCos - n * rampSin
]

// The ridge behind the lake: a mass the wall's terrain adds beyond the lake's bowl, rising from the rim's height at the bowl's back
// shore to a crest the glacier's head lies below. Its ellipsoid is the terrain library's own (`terrainMass`).
let glacierRidge = {
  sector: "north-west"
  label: "glacier-ridge"
  foot: 306.8
  peak: 389
  radial: 300
  across: 150
  offset: 0
}
let ridgeHalf = glacierRidge.peak / (1 - valleySink)
let ridgeCentre = glacierRidge.foot + glacierRidge.radial * squareRoot(1 - valleySink * valleySink)
// The height of the ridge's top at `r` out from the ring's centre and `x` along the ring.
function ridgeGround(r, x) = 0 - ridgeHalf * valleySink + ridgeHalf * squareRoot(
  1 -
    ((ridgeCentre - r) / glacierRidge.radial) * ((ridgeCentre - r) / glacierRidge.radial) -
    (x - glacierRidge.offset) / glacierRidge.across * ((x - glacierRidge.offset) / glacierRidge.across)
)
let valleyRidges = [glacierRidge]

// The wall's rock palette after its own: the trough's polished floor, and the moraine's grey and dark debris.
let wallPalette = [
  { color: "#94705A", roughness: 0.55, specular: 0.08 }
  { color: "#A8876A", roughness: 0.95, specular: 0.02 }
  { color: "#6B5242", roughness: 0.95, specular: 0.02 }
]

// The trough: the rock cut away along the ramp in a U, `troughHalf` either side of its axis and rounded at the floor by
// `troughRound`, its cut face the polished floor, from just under the lake's surface at the toe to a rounded headwall
// at `troughHeadS` that closes the cirque the ice fills; and two grooves down its floor that run on to the lake. Each is a
// `terrainCut` row { sector, label, position, half, rotation, rounding, material }, and the sector's relief stays out of
// every one (`terrainCarveMask`), so the ice lies on the floor and against the walls the cut puts there.
let troughHalf = 18
let troughRound = 14
let troughFootS = -6
let troughHeadS = 98
let valleyCuts = concat(
  [
    {
      sector: "north-west"
      label: "glacier-trough"
      position: rampPoint((troughFootS + troughHeadS) / 2, 0, 20)
      half [troughHalf, 20, (troughHeadS - troughFootS) / 2]
      rotation: onSlope(rampCos, 0)
      rounding: troughRound
      material: 1
    }
  ],
  map(range(0, 2), g => {
    sector: "north-west"
    label: $"glacier-groove-{g}"
    position: rampPoint(46, (g * 2 - 1) * 7.5, 0.6)
    half [2.4, 2.2, 44]
    rotation: onSlope(rampCos, 0)
    rounding: 1.2
    material: 1
  })
)

// The moraine banked along both lips of the trough: ridges of heaped debris lying on the ridge's top, each
// { sector, label, position, radii, rotation, material } with its length along the slope.
let valleyMounds = flatMap(
  range(0, 2),
  side => map(range(0, 6), k => {
    sector: "north-west"
    label: $"glacier-moraine-{side}-{k}"
    position [
      (side * 2 - 1) * (troughHalf + 5 + 2 * siteScatter(k + side * 7, 0.381966)),
      ridgeGround(484 + 11 * k, (side * 2 - 1) * (troughHalf + 5)) - 0.4,
      484 + 11 * k
    ]
    radii [5 + 2 * siteScatter(k + side * 7, 0.618034), 3.6, 14 + 5 * siteScatter(k + side * 7, 0.754878)]
    rotation: onSlope(
      1 / squareRoot(
        1 +
          ((ridgeGround(485 + 11 * k, (side * 2 - 1) * (troughHalf + 5)) -
            ridgeGround(483 + 11 * k, (side * 2 - 1) * (troughHalf + 5))) /
            2) *
            ((ridgeGround(485 + 11 * k, (side * 2 - 1) * (troughHalf + 5)) -
              ridgeGround(483 + 11 * k, (side * 2 - 1) * (troughHalf + 5))) /
              2)
      ),
      8 * (siteScatter(k + side * 7, 0.430159) - 0.5)
    )
    material: siteScatter(k + side * 7, 0.236068) > 0.7 ? 3 : 2
  })
)

// The ice, after the references (docs/game/art/caldera-water-pack panel 2, and the glacier references its guide names): a
// tongue of chunky, bevelled serac blocks filling the trough from wall to wall, stepped down the ramp in rows like a
// staircase, each block's top tipped back toward level so it catches the sun as a white plane and its down-glacier face
// stands as a blue cliff. Snow lies only on the tops, as a cap a little wider than its block, so its lip reads as a pale
// edge. The rows open into crevasses between them, wide where the névé bends over into the icefall and pressed shut at
// the toe, and their floor is the bed ice, the deep cobalt the slots show. The toe's front row stands in the lake, its
// foot under the water, so the ice meets the water and no gap opens under it. Up the trough the rows give way to the
// névé, broad snow-capped slabs that fill the cirque to its headwall, with a few lens-shaped crevasses opening where
// it bends.
//
// Every block bottoms out `iceBed` under the trough's floor, so the ice is held by the rock along every margin. The
// glacier's origin is its head on the bed, so the toe retreats as the ice shrinks.
let glacierHeadS = troughHeadS - 4
let glacierOrigin = rampPoint(glacierHeadS, 0, 0)
let iceBed = -3
let iceCrack = 0.7
let snowLip = 0.12
let snowDepth = 0.6
// A serac row: its centre `s` up the ramp, half depth `hz` along the flow, the height `top` of its blocks' tops over the
// ramp, how far `tilt` (degrees) their tops climb, how far `bow` its middle leads its margins down the ice, and the `cuts`
// across the trough (x) that split it into blocks; the outer cuts reach into the walls.
let seracRows = [
  { s: 1.2, hz: 3.0, top: 5.6, tilt: 8, bow: 0.6, cuts [-21, -11.5, -3, 5.5, 13, 21] }
  { s: 7.9, hz: 3.3, top: 7.4, tilt: 12, bow: 0.8, cuts [-21, -14, -6, 2, 10, 21] }
  { s: 15.2, hz: 3.4, top: 8.6, tilt: 10, bow: 1.0, cuts [-21, -10, -1.5, 7.5, 21] }
  { s: 23.4, hz: 3.5, top: 9.4, tilt: 14, bow: 1.2, cuts [-21, -13.5, -4.5, 4, 12.5, 21] }
  { s: 32.6, hz: 3.4, top: 10.0, tilt: 12, bow: 1.4, cuts [-21, -9, 0.5, 9.5, 21] }
  { s: 42.4, hz: 3.5, top: 10.5, tilt: 16, bow: 1.6, cuts [-21, -12.5, -3.5, 5, 13.5, 21] }
  { s: 52.4, hz: 3.6, top: 11.0, tilt: 14, bow: 1.6, cuts [-21, -8, 2, 21] }
]
// The névé's slabs above the icefall: the same rows, deeper, wider and tipped nearer the ramp, so they lie as a broad
// snowfield; the last meets the headwall.
let neveRows = [
  { s: 65, hz: 7.6, top: 11.6, tilt: 22, bow: 1.2, cuts [-21, -2.5, 21] }
  { s: 84, hz: 10, top: 12.2, tilt: 25, bow: 0.8, cuts [-21, 6, 21] }
]
let iceRows = concat(seracRows, neveRows)
// One block of row `i`, column `j`: its depth, place along the flow, top's height and tilt jittered so no two blocks
// match and no two tops lie in one plane, its yaw turned to follow the row's bow, and its half height reaching from its
// top to `iceBed` under its lowest corner.
function seracBlock(row, i, j) = seracPlaced(
  (row.cuts[j] + row.cuts[j + 1]) / 2,
  (row.cuts[j + 1] - row.cuts[j]) / 2 - iceCrack / 2,
  row.hz * (0.85 + 0.25 * siteScatter(i * 7 + j, 0.236068)),
  row.tilt + 8 * (siteScatter(i * 7 + j, 0.381966) - 0.5),
  row.top + 2.4 * (siteScatter(i * 7 + j, 0.618034) - 0.5),
  row.s + 1.6 * (siteScatter(i * 7 + j, 0.145898) - 0.5) -
    row.bow * (1 - ((row.cuts[j] + row.cuts[j + 1]) / 42) * ((row.cuts[j] + row.cuts[j + 1]) / 42)),
  0 - 5.5 * row.bow * (row.cuts[j] + row.cuts[j + 1]) / 42 + 14 * (siteScatter(i * 7 + j, 0.754878) - 0.5)
)
// A block's up axis leans (rampAngle - tilt) back from the ramp's normal, so in the ramp's (s, n) it is
// (sine, cosine) of that lean; `seracHalfHeight` reaches from the top to `iceBed` under the block's front lower corner.
function seracLeanSine(tilt) = sine((rampAngle - tilt) * degree)
function seracLeanCosine(tilt) = cosine((rampAngle - tilt) * degree)
function seracHalfHeight(top, hz, tilt) = (top - iceBed + hz * seracLeanSine(tilt)) / (2 * seracLeanCosine(tilt))
function seracPlaced(x, hx, hz, tilt, top, s, yaw) = {
  x: x
  hx: hx
  hz: hz
  tilt: tilt
  top: top
  s: s
  yaw: yaw
  hy: seracHalfHeight(top, hz, tilt)
}
let iceBlocks = flatMap(range(0, length(iceRows)), i => map(range(0, length(iceRows[i].cuts) - 1), j => seracBlock(iceRows[i], i, j)))
// A block as a glacierMass block: the ice itself, and its snow cap, a slab centred on the ice's top that stands
// `snowDepth` over it and is wider by `snowLip` all round.
function iceBody(b) = {
  position: rampPoint(b.s - b.hy * seracLeanSine(b.tilt), b.x, b.top - b.hy * seracLeanCosine(b.tilt))
  half [b.hx, b.hy, b.hz]
  rotation: onSlope(cosine(b.tilt * degree), b.yaw)
  rounding: 1.2
  material: 0
}
function iceCap(b) = {
  position: rampPoint(b.s, b.x, b.top)
  half [b.hx + snowLip, snowDepth, b.hz + snowLip]
  rotation: onSlope(cosine(b.tilt * degree), b.yaw)
  rounding: 0.55
  material: 1
}
// The bed ice the rows stand on: a slab filling the trough's floor between the toe's row and the headwall, its top the
// floor of every crevasse.
let iceBedSlab = {
  position: rampPoint((4 + glacierHeadS) / 2, 0, (iceBed + 3.5) / 2)
  half [troughHalf - 0.5, (3.5 - iceBed) / 2, (glacierHeadS - 4) / 2]
  rotation: onSlope(rampCos, 0)
  rounding: 0.5
  material: 2
}
let glacierBlocks = concat([iceBedSlab], map(iceBlocks, b => iceBody(b)), map(iceBlocks, b => iceCap(b)))
// The height over the ramp of the snow's top at ramp distance `s` and `x` across: the top of whichever block's cap covers
// that point (a block's yaw is a few degrees and is not followed), for laying a crevasse on it.
function capTopAt(b, s, x) = (x - b.x) * (x - b.x) < b.hx * b.hx and (s - b.s) * (s - b.s) < b.hz * b.hz ?
  b.top + snowDepth - (s - b.s) * seracLeanSine(b.tilt) / seracLeanCosine(b.tilt) :
  -100
function iceTop(s, x) = reduce(iceBlocks, -100, (top, b) => maximum(top, capTopAt(b, s, x)))
// Lens-shaped crevasses across the névé where it bends over into the icefall: each a tube from [s, x] to [s, x] centred
// `d` under the snow's top, bowed down-glacier by `bow`, that swells by `bulge` at its middle and closes at its ends, so it
// opens as a lens with the ice's blue under the snow's lip. Each lies within one slab, so its ends follow one top.
function crevasseBetween(p0, p1, d, bow, bulge) = {
  position: rampPoint(p0[0], p0[1], iceTop(p0[0], p0[1]) - d)
  b [
    (p1[1] - p0[1]) / 2,
    2 * (iceTop((p0[0] + p1[0]) / 2, (p0[1] + p1[1]) / 2) - iceTop(p0[0], p0[1])) - (iceTop(p1[0], p1[1]) - iceTop(p0[0], p0[1])) / 2,
    (p1[0] - p0[0]) / 2 - 2 * bow
  ]
  c [p1[1] - p0[1], iceTop(p1[0], p1[1]) - iceTop(p0[0], p0[1]), p1[0] - p0[0]]
  rotation: onSlope(rampCos, 0)
  radius: 0.25
  bulge: bulge
  material: 2
}
let glacierCrevasses = [
  crevasseBetween([66, -16.5], [67, -6], 0.4, 1.0, 1.7)
  crevasseBetween([60.5, -13], [61, -7], 0.3, 0.6, 1.0)
  crevasseBetween([67, 1.5], [66, 13.5], 0.4, 1.2, 2.1)
  crevasseBetween([61, 5.5], [62, 15.5], 0.3, 0.8, 1.3)
  crevasseBetween([78, -12], [79, 1.5], 0.4, 1.0, 1.6)
  crevasseBetween([86, -15], [87, -3], 0.3, 0.7, 1.1)
]
