// Where the debug world's glacier lies and what it is made of: a body of ice lying in a U-shaped trough that runs down a ridge
// behind the lake and ends at the lake's back shore, so its melt feeds the lake. A library: it emits no document. The ridge,
// the trough carved in it, the grooves in the trough's floor and the moraine banked along it are the north-west wall's own
// rock (valley.puck); the ice is a creation lying in the trough. Every piece is placed on the trough's ramp frame:
// `rampPoint(s, x, n)` is `s` metres up the ramp from the lake's shore, `x` along the ring and `n` off the ramp along its normal.
import "../standard/water"
import "valley-form"
import "water-site"

let rampAngle = 40
let rampSin = sine(rampAngle * 0.017453292519943295)
let rampCos = cosine(rampAngle * 0.017453292519943295)
// Where the ramp's foot touches the lake's surface, out from the ring's centre.
let rampRadial = 474
function rampPoint(s, x, n) = [
  x,
  lakeSite.surface + s * rampSin + n * rampCos,
  rampRadial + s * rampCos - n * rampSin
]
// A quaternion that turns a piece about the ramp's normal by `yaw` degrees and then stands it with its +Z across the ramp, its
// +Y flipped to point into the ramp: the orientation of a prism whose wide side is to stand at the surface.
function wedgeTurn(yaw) = [
  onSlope(rampCos, 90 + yaw)[1],
  0 - onSlope(rampCos, 90 + yaw)[0],
  onSlope(rampCos, 90 + yaw)[3],
  0 - onSlope(rampCos, 90 + yaw)[2]
]

// The ridge behind the lake: a mass the wall's terrain adds beyond the lake's bowl, rising from the rim's height at the bowl's back
// shore to a crest the glacier's head lies below. Its ellipsoid is the terrain library's own (`terrainMass`).
let glacierRidge = { sector: "north-west", label: "glacier-ridge", foot: 306.8, peak: 389, radial: 300, across: 150, offset: 0 }
let ridgeHalf = glacierRidge.peak / (1 - valleySink)
let ridgeCentre = glacierRidge.foot + glacierRidge.radial * squareRoot(1 - valleySink * valleySink)
// The height of the ridge's top at `r` out from the ring's centre and `x` along the ring.
function ridgeGround(r, x) = 0 - ridgeHalf * valleySink + ridgeHalf * squareRoot(
  1 -
    ((ridgeCentre - r) / glacierRidge.radial) * ((ridgeCentre - r) / glacierRidge.radial) -
    (x - glacierRidge.offset) / glacierRidge.across * ((x - glacierRidge.offset) / glacierRidge.across)
)
let valleyRidges = [glacierRidge]

// The wall's rock palette after its own: the trough's polished floor, and the moraine's grey and dark debris.
let wallPalette = [
  { color: "#A7A39A", roughness: 0.3, specular: 0.35 }
  { color: "#8C8376", roughness: 0.95, specular: 0.02 }
  { color: "#5A5249", roughness: 0.95, specular: 0.02 }
]

// The trough: the rock cut away along the ramp in a U, `troughHalf` either side of its axis and rounded at the floor by
// `troughRound`, its cut face the polished floor; and three grooves down its floor that run on to the lake, each
// { sector, label, position, half, rotation, rounding, material }.
let troughHalf = 18
let troughRound = 14
let valleyCuts = concat(
  [
    {
      sector: "north-west"
      label: "glacier-trough"
      position: rampPoint(40, 0, 20)
      half [troughHalf, 20, 56]
      rotation: onSlope(rampCos, 0)
      rounding: troughRound
      material: 1
    }
  ],
  map(range(0, 3), g => {
    sector: "north-west"
    label: $"glacier-groove-{g}"
    position: rampPoint(46, (g - 1) * 3.6, 0.3)
    half [0.8, 1.1, 46]
    rotation: onSlope(rampCos, 0)
    rounding: 0.4
    material: 3
  })
)

// The moraine banked along both lips of the trough: ridges of heaped debris lying on the ridge's top, each
// { sector, label, position, radii, rotation, material } with its length along the slope.
let valleyMounds = flatMap(
  range(0, 2),
  side => map(range(0, 6), k => {
    sector: "north-west"
    label: $"glacier-moraine-{side}-{k}"
    position [
      (side * 2 - 1) * (troughHalf + 5 + 2 * siteScatter(k + side * 7, 0.381966)),
      ridgeGround(484 + 11 * k, (side * 2 - 1) * (troughHalf + 5)) - 0.4,
      484 + 11 * k
    ]
    radii [3.4 + 1.6 * siteScatter(k + side * 7, 0.618034), 2.4, 8.5 + 3 * siteScatter(k + side * 7, 0.754878)]
    rotation: onSlope(
      1 /
        squareRoot(
          1 +
            ((ridgeGround(485 + 11 * k, (side * 2 - 1) * (troughHalf + 5)) -
              ridgeGround(483 + 11 * k, (side * 2 - 1) * (troughHalf + 5))) /
              2) *
              ((ridgeGround(485 + 11 * k, (side * 2 - 1) * (troughHalf + 5)) -
                ridgeGround(483 + 11 * k, (side * 2 - 1) * (troughHalf + 5))) /
                2)
        ),
      8 * (siteScatter(k + side * 7, 0.430159) - 0.5)
    )
    material: (k + side) % 2 + 2
  })
)

// The ice: steps of chamfered plates down the trough, each a little tilted and turned off its neighbours so it catches the
// light at its own angle. `iceStep` is the ramp distance between plates; `iceThick` each plate's half thickness and `iceHalf`
// its half width.
let iceStep = 13
let iceThick = [2.2, 3.2, 3.8, 4.2, 4.0, 3.2, 2.2]
let iceHalf = [13, 15, 16, 16, 16, 15, 12]
// The height over the ramp of the ice's top at ramp distance s.
function iceTop(s) = 2 * iceThick[minimum(6, maximum(0, floor((s - 1.5) / iceStep)))] - 0.6
let glacierOrigin = rampPoint(0, 0, 0)

let glacierBlocks = concat(
  map(range(0, 7), i => {
    position: rampPoint(8 + iceStep * i, 0.8 * (siteScatter(i, 0.618034) - 0.5), iceThick[i] - 0.6)
    half [iceHalf[i], iceThick[i], 8.8]
    cosine: rampCos + 0.08 * (siteScatter(i, 0.754878) - 0.5)
    yaw: 7 * (siteScatter(i, 0.569840) - 0.5)
    chamfer: 0.9
    material: i % 2
  }),
  map(range(0, 7), k => {
    position: rampPoint(
      18 + 9 * k,
      (k % 2 * 2 - 1) * (3 + 6 * siteScatter(k, 0.381966)),
      iceTop(18 + 9 * k) + 1.2
    )
    half [
      1.8 + 1.4 * siteScatter(k, 0.569840)
      2.6 + 1.6 * siteScatter(k, 0.754878)
      1.8 + 1.2 * siteScatter(k, 0.896491)
    ]
    cosine: rampCos + 0.3 * (siteScatter(k, 0.430159) - 0.5)
    yaw: 360 * siteScatter(k, 0.618034)
    chamfer: 0.6
    material: 1
  })
)

// Crevasses: wedges that open at the surface and close toward the floor, across the ice between its steps.
let glacierWedges = map(range(0, 7), k => {
  position: rampPoint(14 + 10 * k, 0.8 * (siteScatter(k, 0.381966) - 0.5), iceTop(14 + 10 * k) - 2.2)
  half [1.5, 3.2, 12]
  taper: 0.18
  rotation: wedgeTurn((k % 2 * 2 - 1) * (4 + 8 * siteScatter(k, 0.569840)))
  material: 2
})
// Melt channels down the ice's back, a groove in each plate, that meet the trough's grooves at the toe and run on to the lake.
let glacierCuts = flatMap(
  range(0, 2),
  c => map(range(0, 7), i => {
    position: rampPoint(8 + iceStep * i, (c * 2 - 1) * 5.5 + (i % 2), 2 * iceThick[i] - 0.75)
    half [0.5, 0.8, 7.6]
    cosine: rampCos
    yaw: ((i + c) % 2 * 2 - 1) * 4
    material: 2
  })
)
// A scalloped toe: cylinders cut into the ice's lower edge.
let glacierScallops = map(range(0, 5), j => {
  position: rampPoint(-0.5 + (j % 2) * 1.2, (j - 2) * 6, 3)
  radius: 2.6 + 0.6 * (j % 2)
  height: 9
  cosine: rampCos
  material: 2
})
// The melt: a cutter over the toe walks up the ice with the gauge, and one over the back sinks, thinning it.
let glacierRetreats = [
  {
    position: rampPoint(-60.8, 0, 8)
    half [24, 20, 60]
    cosine: rampCos
    yaw: 0
    material: 1
    axis [0, 0 - rampSin, 0 - rampCos]
    amplitude: 98
  }
  {
    position: rampPoint(45, 0, 22.4)
    half [24, 14, 60]
    cosine: rampCos
    yaw: 0
    material: 1
    axis [0, rampCos, 0 - rampSin]
    amplitude: 6
  }
]
