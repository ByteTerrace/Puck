// The gallery tree's walkway, walked as a player walks it, in the tree's lab (labs/tree.puck): seat 1 plays the
// `tree-walk` route (tree-walk.puck's treeWalkRoute) with the standard's `walker` program, which works the seat's own
// stick and camera toward each waypoint in turn, so every step the body takes is the step a player's pad would ask for,
// as a plain visitor holding no pass. Rules in this
// test world latch the walk as it goes: which waypoint the body last reached, and the waypoint after which each kind of
// failure first showed (`kinematics(body, 0, <witness>)`, what the body's own contact phase decided each step). The
// expectations at the export tick then read where the walk got to and why it stopped, if it did:
//
//   reached     each section's last waypoint reached (a failing line reads the last waypoint the body reached)
//   late        no waypoint reached after its time (its distance at a slow walk, plus a turn)
//   fell        no airborne run longer than `treeWalkAirborne` once the walk is under way
//   stuck       no run of driven steps that did not move the body longer than `treeWalkStuck`
//   refused     no step-up refused: no riser the body cleared at its step height and could not stand on; a
//               failing walk also reports the first refusal's outcome (5 no landing, 6 nothing it may stand on),
//               the edge clearance and normal of the face it met, and where the body stood (`kinematics`' refusal
//               witnesses), each line reading its value
//   deep        no step that ended a contact solve still pushing as deep as the walker's contact skin
//   flat        every climbing stretch between two tread waypoints took at least one step-up
//   landed      the body stood on each landing's balcony floor when it reached it, grounded
//
// Each "first" row reads -2 until its failure shows, then the index of the last waypoint reached (-1 before the trunk's
// foot), so a failing line names the segment. Play the same route live with `world.benchmark run tree-walk`.

schema: "puck.world.definition.v1"
basis: "labs/tree"
// The lab's own id (docs/authoring/testing-a-world.md#crossing-into-another-document).
documentId: "lab-tree"
import "gallery/layout"
import "tree-walk"

// The walker's contact skin, metres (avatars/moth.puck's collision.contactSkin): no step may end a solve pushing this
// deep. The longest airborne run and the longest run of driven steps that do not move the body, seconds, that a walk
// along the authored path may hold: well under the walker's own stall verdict (WorldSeatDriver.StallTicks).
let treeWalkSkin = 0.02
let treeWalkAirborne = 0.5
let treeWalkStuck = 0.5
// How much further, metres, than its arrival distance a waypoint's latch reaches across the plan, and how far along up:
// the walker reaches a point within its distance, so the latch, judged on the tick after, holds it.
let treeWalkMargin = 0.15
let treeWalkRise = 0.6
// The band over a landing's floor, metres, the body's foot stands in on arriving: a skin above the floor's top.
let treeWalkFloorBand = [-0.05, 0.3]
let treeWalkNone = -2

let treeWalkCount = length(treeWalk)
let treeWalkSectionEnds = map(
  range(1, (length(treeWalkSections) + 1)),
  s => (scan(map(treeWalkSections, x => length(x.points)))[s] - 1)
)
let treeWalkLandings = filter(range(0, treeWalkCount), k => (treeWalk[k].kind == "landing"))
// The waypoints the walk climbs to over treads from the one before, each of which costs at least one step-up.
let treeWalkStairs = ["foot", "tread", "junction"]
let treeWalkClimbing = filter(range(1, treeWalkCount), k => (contains(slice(treeWalkStairs, 1, 3), treeWalk[k].kind) and
  contains(treeWalkStairs, treeWalk[(k - 1)].kind) and
  (treeWalk[k].point[1] > treeWalk[(k - 1)].point[1])))
// The world height of the floor each waypoint's level stands on (level 0's for the trunk's treads).
let treeWalkFloors = map(treeWalk, w => galleryWorld(0, galleryFloor[maximum(w.level, 0)], 0)[1])

state {
  world {
    slot treeWalkReached = -1
    slot treeWalkDue = 0
    slot treeWalkLateAt = treeWalkNone
    slot treeWalkFellAt = treeWalkNone
    slot treeWalkStuckAt = treeWalkNone
    slot treeWalkRefusedAt = treeWalkNone
    slot treeWalkDeepAt = treeWalkNone
    slot treeWalkFlatAt = treeWalkNone
    slot treeWalkRefusalBase = 0
    slot treeWalkRefusalOutcome = 0
    slot treeWalkRefusalHeight = 0.0
    slot treeWalkRefusalNormalX = 0.0
    slot treeWalkRefusalNormalY = 0.0
    slot treeWalkRefusalNormalZ = 0.0
    slot treeWalkRefusalX = 0.0
    slot treeWalkRefusalY = 0.0
    slot treeWalkRefusalZ = 0.0
    slot treeWalkStepMark = 0
    table treeWalkLanded {
      for k in treeWalkLandings {
        $"{k}" = 0
      }
    }
  }
}

// One latch per waypoint, in walking order: it fires on the tick the body stands within reach of its waypoint, once the
// waypoint before it is reached, so a waypoint walked past twice (a junction, out along a branch and back) latches in
// its own turn.
for (w, k) in treeWalk {
  let climbs = (contains(treeWalkClimbing, k) ? 1 : 0)
  let lands = (contains(treeWalkLandings, k) ? 1 : 0)

  rule $"tree-walk-{k}" {
    when (treeWalkReached == (k - 1) and
      abs((bodyPosition(body, 0, x) - w.point[0])) <= (w.within + treeWalkMargin) and
      abs((bodyPosition(body, 0, z) - w.point[2])) <= (w.within + treeWalkMargin) and
      abs((bodyPosition(body, 0, y) - w.point[1])) <= treeWalkRise)
    mode: Level
    if k > 0 {
      if $tick > treeWalkDue and treeWalkLateAt == treeWalkNone {
        treeWalkLateAt = k
      }
    }
    if climbs == 1 {
      if kinematics(body, 0, stepUps) == treeWalkStepMark and treeWalkFlatAt == treeWalkNone {
        treeWalkFlatAt = k
      }
    }
    if lands == 1 {
      treeWalkLanded[$"{k}"] = (
        (fact(body, 0, Grounded) == 1) and
        (bodyPosition(body, 0, y) >= (treeWalkFloors[k] + treeWalkFloorBand[0])) and
        (bodyPosition(body, 0, y) <= (treeWalkFloors[k] + treeWalkFloorBand[1]))
      )
    }
    if k == 0 {
      treeWalkRefusalBase = kinematics(body, 0, stepRefusals)
    }
    if (k + 1) < treeWalkCount {
      schedule treeWalkDue in treeWalk[(k + 1)].seconds
    }
    treeWalkStepMark = kinematics(body, 0, stepUps)
    treeWalkReached = k
  }
}

// The first waypoint after which each failure showed, once the walk reached the trunk's foot.
rule "tree-walk-fell" {
  when treeWalkReached >= 0 and treeWalkFellAt == treeWalkNone and kinematics(body, 0, airborne) > treeWalkAirborne
  mode: Level
  treeWalkFellAt = treeWalkReached
}
rule "tree-walk-stuck" {
  when treeWalkReached >= 0 and treeWalkStuckAt == treeWalkNone and kinematics(body, 0, stuck) > treeWalkStuck
  mode: Level
  treeWalkStuckAt = treeWalkReached
}
rule "tree-walk-refused" {
  when (treeWalkReached >= 0 and
    treeWalkRefusedAt == treeWalkNone and
    kinematics(body, 0, stepRefusals) > treeWalkRefusalBase)
  mode: Level
  treeWalkRefusedAt = treeWalkReached
  treeWalkRefusalOutcome = kinematics(body, 0, refusalOutcome)
  treeWalkRefusalHeight = kinematics(body, 0, refusalHeight)
  treeWalkRefusalNormalX = kinematics(body, 0, refusalNormalX)
  treeWalkRefusalNormalY = kinematics(body, 0, refusalNormalY)
  treeWalkRefusalNormalZ = kinematics(body, 0, refusalNormalZ)
  treeWalkRefusalX = kinematics(body, 0, refusalX)
  treeWalkRefusalY = kinematics(body, 0, refusalY)
  treeWalkRefusalZ = kinematics(body, 0, refusalZ)
}
rule "tree-walk-deep" {
  when treeWalkReached >= 0 and treeWalkDeepAt == treeWalkNone and kinematics(body, 0, depth) >= treeWalkSkin
  mode: Level
  treeWalkDeepAt = treeWalkReached
}

test "the tree's walkway, foot to the last landing" {
  when {
    seat1: route.play tree-walk
    ticks 9000
  }
  expect {
    for end in treeWalkSectionEnds {
      treeWalkReached >= end
    }
    treeWalkLateAt == treeWalkNone
    treeWalkFellAt == treeWalkNone
    treeWalkStuckAt == treeWalkNone
    treeWalkRefusedAt == treeWalkNone
    treeWalkRefusalOutcome == 0
    treeWalkRefusalHeight == 0
    treeWalkRefusalNormalX == 0
    treeWalkRefusalNormalY == 0
    treeWalkRefusalNormalZ == 0
    treeWalkRefusalX == 0
    treeWalkRefusalY == 0
    treeWalkRefusalZ == 0
    treeWalkDeepAt == treeWalkNone
    treeWalkFlatAt == treeWalkNone
    for k in treeWalkLandings {
      treeWalkLanded[$"{k}"] == 1
    }
    fact(body, 0, Grounded) == 1
  }
}
