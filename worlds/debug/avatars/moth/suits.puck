    { at [-0.3665, 0.7377, -0.0744], b [0.0233905, -0.0998981, 0.00675], c [0.0230741, -0.0930397, -0.056025] }
    { at [-0.3949, 0.7324, -0.044], b [0.0215438, -0.0920114, 0.00675], c [0.0187826, -0.0857254, -0.056025] }
    { at [-0.4232, 0.727, -0.0137], b [0.0184662, -0.078867, 0.00675], c [0.01326, -0.0731534, -0.056025] }
  ] {
