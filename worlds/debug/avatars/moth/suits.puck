// One finish of the suit: the frame below as the prototype `id`, its ivory plates, lavender plates and the lavender of
// its grooves in the colours given.
template suitPrototype(id, ivoryPlate = "#F2C49A", lavenderPlate = "#744080", lavenderSeam = "#5E3468") {
prototypes {
  allow PUCK133 "her wall toes solve after her ground feet on the same legs: on a face the ground feet have let go, and at a wall's foot the toes are meant to win"
  prototype $"{id}" {
    // Her capsule darkens the floor at her feet and the wall beside her, and shadows her from a lamp onto them.
    occlusion: bodyOcclusion
    document {
      schema: "puck.creation.v2"
      name: $"{id}"
      // At rest her breath re-poses her ten times a second: a breath's few millimetres stay smooth at it, and the views
      // that show her stand between poses. A stride poses her on the frame it starts.
      behavior {
        restRate: 10
      }
      // The blink seats each closed lid over its eye and parks the open eye's pieces behind the face, at the head's scale.
      frames [mothBlinkFrame(headAt, headScale)]
      // The suit is pristine, as on the sheets: wear reaches only the tightest edges, and faintly.
      palette [
        {
          color: ivoryPlate
          toonSelect: mothStyles
          roughness: 0.36
          specular: 0.08
          emissive: 0
          coat: 0.28
          weathering {
            edge: 0.55
            lines: 0
            settle: 0.025
            reach: 0.014
            seed: 71
            scale: 75
            floor: plateWear
            under: creamUndercoat
            deposit { color: "#807568", roughness: 0.85, metal: 0 }
          }
        }
        {
          color: lavenderPlate
          toonSelect: mothStyles
          roughness: 0.3
          specular: 0.12
          emissive: 0
          coat: 0.4
          weathering {
            edge: 0.55
            lines: 0
            settle: 0.025
            reach: 0.014
            seed: 72
            scale: 75
            floor: plateWear
            under: lilacUndercoat
            deposit { color: "#807568", roughness: 0.85, metal: 0 }
          }
          // The sole grooves, and the hood's ivory trim in the helmet's frame: a horseshoe round the face opening, its
          // ellipse projected along the face's forward axis; the throat opening leaves the helmet no surface below it.
          paints [
            {
              parent: "sole-left"
              type: "Prism"
              position [0, 0.02, 0.29]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "sole-left"
              type: "Prism"
              position [0, 0.022, -0.115]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "sole-right"
              type: "Prism"
              position [0, 0.02, 0.29]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "sole-right"
              type: "Prism"
              position [0, 0.022, -0.115]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "helmet"
              type: "Prism"
              position [0, -0.0198, 0.21575]
              scale [0.24265, 0.26245, 0.2]
              profile { kind: "Ellipse" }
              stroke: 0.0227
              color: ivoryPlate
            }
          ]
        }
        {
          color: "#252630"
          toonSelect: mothStyles
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#B76B3C"
          toonSelect: mothStyles
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
          wrap: 0.35
          fill: "#8A4A2C"
          // The mouth, in the face's frame: a line where the face crosses a thin quadratic sweep laid on it.
          paints [
            {
              parent: "face"
              type: "Sweep"
              curve {
                a: map([-0.05808, -0.088389, 0.1068], v => v * headScale)
                b: map([0, -0.1141765, 0.1082], v => v * headScale)
                c: map([0.05808, -0.0862981, 0.1078], v => v * headScale)
                radiusStart: 0.0015
                radiusEnd: 0.0015
              }
              color: "#754137"
            }
          ]
        }
        {
          color: "#171210"
          toonSelect: mothStyles
          roughness: 0.32
          specular: 0.1
          emissive: 0
          coat: 0.05
          sheen: 0.3
        }
        {
          color: "#FFF8E9"
          roughness: 0.22
          specular: 0.04
          emissive: 0
          coat: 0
          paints: mothLidPaints(headScale)
        }
        {
          color: "#2ED6EC"
          roughness: 0.25
          specular: 0.04
          emissive: 2250
          coat: 0
        }
        {
          color: "#754137"
          toonSelect: mothStyles
