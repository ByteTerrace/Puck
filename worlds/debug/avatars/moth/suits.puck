// The Moth's suits: the armoured frame she wears over her body (body.puck), sculpted once and worn in two finishes.
// The mech suit is the concept pack's dusty lavender over warm ivory, with the back pods' jetpack and the heel jets'
// air jump; the scout suit is the same frame in bone and teal, which the contract (contract.puck) grants no jetpack and
// no air jump, so its pods and heel jets stay dark. Each finish is a prototype of its own, so a world bakes only the
// ones its bodies wear. Her head (head.puck) sits recessed in the hood; the suits' rig is her skeleton's own, driven by
// the look rows the avatar document (moth.puck) authors. A document of prototypes and nothing else: no kit, rule,
// light, air or floor.
schema: "puck.world.definition.v1"
import "../../../standard/styles"
import "../../../standard/mirror"
import "../../../standard/rig"
import "../../../standard/occlusion"
import "../../../standard/wrist-panel"
import "../../menagerie"
import "head"
// Her wrist panel's mount and glass slots are her contract's (`mothWristMount`, `mothWornScreen`).
import "contract"

// What an importer binds: the creations its looks wear.
exports {
  reads [moth, $"moth-scout"]
}

// Her real head, about 0.26 m from crown to chin, sits recessed in the unchanged hood with dark lining round it.
let headScale = 0.7
let headAt = [0, 1.735, -0.207]

// The suit's two plate colours, from the concept pack: dusty lavender and a warm ivory, with the darker lavender of
// a groove and the near-black of a vent slot.
let lavenderPlate = "#744080"
let ivoryPlate = "#F2C49A"
let lavenderSeam = "#5E3468"
let ventSlot = "#2B2630"

// Her look, swapped live by `moth.style` for playtesting: each painted slot (the plates, the undersuit, her skin, hair and
// fittings) shades plain or with the standard's cel look by the mothStyle row, which changes only those materials' style
// rows and programs and bakes nothing. Her eyes' whites and catchlights, the lights and the bare metals stay continuous in
// both, as the turnaround's glowing lenses and satin pistons read. She boots Cel, the debug world's treatment.
let mothStyles = {
  state: "state.mothStyle"
  cases [plainLook, celLook(celStyle)]
}

// The palette, by role. A slot number says nothing; a name says what the surface IS.
let skin = 0 // ivory: hood rim, ear mounts, cheek guards, knee guards, hip guards and boot insteps
let violet = 1 // lavender: hood shell, forearms, pelvic plate, toe caps and heel guards
let charcoal = 2 // #252630 joints, pivots, undersuit and soles
let rust = 3 // #B76B3C her skin
let ink = 4 // #171210 hair, lids and brows
let ivory = 5 // #FFF8E9 the eyes' whites
let leather = 7 // #754137
let brass = 8 // #C98F35 ochre collar and belt
let umber = 9 // #89481D
let jet = 10 // #120D13
let pearl = 11 // #FFF8EF
let violetBandLeft = 12 // lavender left shoulder stack under its ivory bands
let violetBandRight = 13 // lavender right shoulder stack under its ivory bands
let violetPodLeft = 14 // lavender of the left back pod's plates, under its vent and grey plate
let violetPodRight = 15 // lavender of the right back pod's plates, under its vent and grey plate
let chestArmor = 16 // ivory chest slab round its lavender centre
let shinCream = 17 // ivory ankle trim, shin side panels with their vents, and back-pod bands
let shinViolet = 18 // lavender greaves under their ivory arch band and side panel
let gunmetal = 19 // #43464E heel lens housing and heel block
let steel = 20 // #8B9099 the lens housing's bright ring
let thrusterGlow = 21 // #D8FDFF the back-pod thruster cores, lit by flight mode (lane 2)
let thrusterCyan = 22 // #1F9BAE the back-pod thruster lenses, lit by flight mode (lane 2)
let gauntletLeft = 23 // ivory left gauntlet, lavender on its inner half, vents on its outer face
let gauntletRight = 24 // ivory right gauntlet, lavender on its inner half, vents on its outer face
let bootCyan = 25 // #1F9BAE the heel lenses' idle pilot light
let bootGlow = 26 // #D8FDFF the heel lenses' pale cores
let pistonSteel = 27 // satin steel piston cylinders
let torsoSuit = 28 // segmented charcoal fabric between the chest and belt
let journalScreenLeft = mothMechSuit.wornScreen.screens.left // the left journal panel's glass, whose paints are the journal's interface
let journalScreenRight = mothMechSuit.wornScreen.screens.right // the right journal panel's glass
// Slot 6 (cyan) is free.

// Wear is a faint floor on a pristine suit: its coverage stays under the primer's threshold except at the tightest
// edges, where pale primer shows first, then the dark alloy.
let plateWear = 0
let lilacUndercoat = [
  { threshold: 0.2, surface { color: "#C9B4CB", roughness: 0.6, metal: 0.05 } }
  { threshold: 0.38, surface { color: "#51525C", roughness: 0.52, metal: 0.55 } }
]
let creamUndercoat = [
  { threshold: 0.2, surface { color: "#C9B9A6", roughness: 0.65, metal: 0.05 } }
  { threshold: 0.38, surface { color: "#5B5D63", roughness: 0.52, metal: 0.55 } }
]

// The reference's recessed heel jets point 55 degrees below rearward horizontal.
// The cylinder's -Y cap and the lens's -Z face share (0, -sin(55), -cos(55));
// the exhaust volume inherits the lens frame, so it leaves along the same axis.
let bootNozzleRotation = [-0.3007058, 0, 0, 0.9537170]
let bootLensRotation = [0.4617486, 0, 0, 0.8870108]
let bootPlanOutline = [[-0.82, -1], [-1, -0.3], [-0.9, 0.72], [-0.64, 1], [0.64, 1], [0.9, 0.72], [1, -0.3], [0.82, -1]]

let archBackOutline = [
  [-1, -1]
  [-1, 0]
  [-0.809, 0.588]
  [-0.309, 0.951]
  [0.309, 0.951]
  [0.809, 0.588]
  [1, 0]
  [1, -1]
]

// Values repeated across the body, named so changing one changes the moth rather than 120 shapes.
let softness = 2.1 // the superellipsoid exponent every rounded body part shares
let diagonal = 0.7071068 // sin/cos of 45 degrees, the quarter-turn quaternion component
let braidTwist = 0.247404 // sin of the braid's half-angle
let braidUntwist = 0.9689124 // cos of the same
// The shin's pentagonal side panel, in the panel prism's local XY.
let shinPanelOutline = [
  [-0.5, 1]
  [0.2692308, 1]
  [0.5384615, 0.1944444]
  [-0.1730769, -1]
  [-1, -0.4166667]
]

let braidParent = [
  "braid-root-1"
  "braid-root-1"
  "braid-root-1"
  "braid-root-1"
  "braid-root-2"
  "braid-root-2"
  "braid-root-2"
  "braid-root-2"
]

let braid0Position = [
  [0.2527, 1.53865, -0.120375]
  [0.2549, 1.50015, -0.141125]
  [0.2571, 1.46165, -0.133875]
  [0.2593, 1.42315, -0.126625]
  [0.2626, 1.3841, -0.14625]
  [0.267, 1.3445, -0.16475]
  [0.2714, 1.3049, -0.15525]
  [0.2758, 1.2653, -0.14575]
]

let braid0Rotation = [
  [0, 0, -braidTwist, braidUntwist]
  [0, 0, braidTwist, braidUntwist]
  [0, 0, -braidTwist, braidUntwist]
  [0, 0, braidTwist, braidUntwist]
  [0, 0, -braidTwist, braidUntwist]
  [0, 0, braidTwist, braidUntwist]
  [0, 0, -braidTwist, braidUntwist]
  [0, 0, braidTwist, braidUntwist]
]

let braid1Position = [
  [0.2247, 1.53865, -0.120375]
  [0.2269, 1.50015, -0.113125]
  [0.2291, 1.46165, -0.133875]
  [0.2313, 1.42315, -0.154625]
  [0.2346, 1.3841, -0.14625]
  [0.239, 1.3445, -0.13675]
  [0.2434, 1.3049, -0.15525]
  [0.2478, 1.2653, -0.17375]
]

let braid1Rotation = [
  [0, 0, braidTwist, braidUntwist]
  [0, 0, -braidTwist, braidUntwist]
  [0, 0, braidTwist, braidUntwist]
  [0, 0, -braidTwist, braidUntwist]
  [0, 0, braidTwist, braidUntwist]
  [0, 0, -braidTwist, braidUntwist]
  [0, 0, braidTwist, braidUntwist]
  [0, 0, -braidTwist, braidUntwist]
]

// One column of the plait's lobes, from where the root becomes the braid below her jaw down to the tie.
template braidChain(chainIdx, baseId, positions, rotations) {
  for i in range(0, 8) {
    shape Superellipsoid $"braid-{chainIdx}-{i}" {
      id: baseId + i
      blend: "Union"
      exponent: softness
      material: ink
      parent: braidParent[i]
      position: positions[i]
      rotation: rotations[i]
      scale [0.014, 0.026, 0.016]
      smooth: 0
    }
  }
}

// Both sides of the body: the left side is written out, and `standard/mirror` gives the right side its values from it.
// `side` is "left" or "right" and `isRight` 0 or 1.

template mothLimbs(side, isRight) {
  shape Sweep $"upperArm-{side}" {
    id: 148 + isRight * 68
    position: mirrorX(isRight, [-0.295, 1.4515, 0])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [0, 0, -0.078459, 0.996917]))
    material: charcoal
    parent: "torso"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.0363, -0.1009, 0])
      c: mirrorX(isRight, [0.0727, -0.2059, 0])
      radiusStart: 0.08
      radiusEnd: 0.08
    }
    swings [
      swing("swim", [-1, 0, 0], 0.55, mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "sine"
        phase: bySide(isRight, 0, pi)
      }
      swing("swim", [0, 0, -1], flip(isRight, -0.85), mirrorX(isRight, [-0.295, 1.4515, 0])) with { wave: "constant" }
      swing("run", [0, 0, -1], flip(isRight, -0.15), mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "constant"
        phase: 0
      }
      swing("gait", signed(isRight, [-0.987688, -0.156434, 0], [1, -1, 1]), 0.42, mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "sine"
        phase: bySide(isRight, pi, 2 * pi)
      }
      swing("flight", [0, 0, -1], flip(isRight, -0.1), mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "linear"
        phase: 0
      }
      // The arms open 0.45 rad from the sides at the peak, 0.6 on the way up and 0.3 coming down.
      swing("air", [0, 0, -1], flip(isRight, 0.03), mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "linear"
        phase: 15
      }
      // And lift forward 0.12 rad, 0.2 rising.
      swing(
        "air",
        signed(isRight, [-0.987688, -0.156434, 0], [1, -1, 1]),
        -0.015,
        mirrorX(isRight, [-0.295, 1.4515, 0])
      ) with {
        wave: "linear"
        phase: 8
      }
      // On a wall both arms reach forward and up to it; the hand effectors plant each palm in turn as she climbs.
      swing("cling", [-1, 0, 0], -2.2, mirrorX(isRight, [-0.295, 1.4515, 0])) with { wave: "constant" }
      // A mantle throws both arms up over the ledge as the pull starts, then drops them as she comes over it.
      swing("mantle", [-1, 0, 0], -2.5, mirrorX(isRight, [-0.295, 1.4515, 0])) with { wave: "linear" }
      for s in wristPanelSwings("upper", mothWristMount, side, isRight) { s }
    ]
  }

  shape Superellipsoid $"elbow-{side}" {
    id: 149 + isRight * 68
    position: mirrorX(isRight, [-0.336, 1.2201, -0.004])
    rotation: mirrorRotation(isRight, [0, 0, 0.078459, 0.996917])
    scale [0.07, 0.065, 0.072]
    material: charcoal
    parent: $"upperArm-{side}"
    exponent: softness
  }

  // The shoulder stack: two thick slabs on a round charcoal pivot, riding the upper arm. The upper slab's inner
  // edge stays outboard of the hood as the arm swings.
  shape Superellipsoid $"shoulderPivot-{side}" {
    id: 150 + isRight * 68
    position: mirrorX(isRight, [-0.3, 1.46, 0])
    scale [0.085, 0.085, 0.085]
    material: charcoal
    parent: $"upperArm-{side}"
    exponent: 3
  }

  shape Superellipsoid $"shoulderSlab-{side}" {
    id: 151 + isRight * 68
    position: mirrorX(isRight, [-0.395, 1.57, 0.005])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [0, 0, -0.1305, 0.9914]))
    scale [0.135, 0.07, 0.175]
    material: bySide(isRight, violetBandLeft, violetBandRight)
    parent: $"upperArm-{side}"
    exponent: 4
    shear {
      linear: 0
      quadratic: -1.3
      cubic: 0
      target: 1
      driver: 2
    }
  }

  shape Superellipsoid $"shoulderSlabLower-{side}" {
    id: 152 + isRight * 68
    position: mirrorX(isRight, [-0.415, 1.43, 0])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [0, 0, -0.0698, 0.9976]))
    scale [0.14, 0.085, 0.185]
    material: bySide(isRight, violetBandLeft, violetBandRight)
    parent: $"upperArm-{side}"
    exponent: 4
    shear {
      linear: 0
      quadratic: -1
      cubic: 0
      target: 1
      driver: 2
    }
  }

  // The elbow piston, inside the bend: a cylinder on the upper arm and a rod on the forearm, both aimed at the
  // hinge so they meet inside the joint at any bend.
  shape Cylinder $"elbowCylinder-{side}" {
    id: 153 + isRight * 68
    position: mirrorX(isRight, [-0.3834, 1.3086, -0.0499])
    rotation: mirrorRotation(isRight, [0.6604, 0, -0.6817, 0.3149])
    scale [0.022, 0.0594, 0.022]
    material: pistonSteel
    parent: $"upperArm-{side}"
    rounding: 0.006
  }

  shape Superellipsoid $"forearm-{side}" {
    id: 159 + isRight * 68
    position: mirrorX(isRight, [-0.3706, 1.0524, -0.0024])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.08495, 0.400689, -0.033242, 0.911661]))
    scale [0.1, 0.2, 0.105]
    material: charcoal
    parent: $"upperArm-{side}"
    exponent: 2.6
    swings [
      swing(
        "run",
        signed(isRight, [-0.660568, -0.349483, 0.664463], [1, -1, -1]),
        -0.7,
        mirrorX(isRight, [-0.336, 1.2201, -0.004])
      ) with { wave: "constant", phase: 0 }
      // Her elbows stay bent on a wall, so her hands meet it ahead of her face.
      swing(
        "cling",
        signed(isRight, [-0.660568, -0.349483, 0.664463], [1, -1, -1]),
        -0.6,
        mirrorX(isRight, [-0.336, 1.2201, -0.004])
      ) with { wave: "constant", phase: 0 }
      swing(
        "gait",
        signed(isRight, [-0.660568, -0.349483, 0.664463], [1, -1, -1]),
        0.18,
        mirrorX(isRight, [-0.336, 1.2201, -0.004])
      ) with { wave: "sine", phase: bySide(isRight, 3.6416, 0.5) }
      swing(
        "flight",
        signed(isRight, [-0.660568, -0.349483, 0.664463], [1, -1, -1]),
        -0.25,
        mirrorX(isRight, [-0.336, 1.2201, -0.004])
      ) with { wave: "linear", phase: 0 }
      // The elbows bend 0.36 rad at the peak, 0.51 rising and 0.21 falling.
      swing(
        "air",
        signed(isRight, [-0.660568, -0.349483, 0.664463], [1, -1, -1]),
        -0.03,
        mirrorX(isRight, [-0.336, 1.2201, -0.004])
      ) with { wave: "linear", phase: 12 }
      // And bend a little further as she lands.
      swing(
        "land",
        signed(isRight, [-0.660568, -0.349483, 0.664463], [1, -1, -1]),
        0.05,
        mirrorX(isRight, [-0.336, 1.2201, -0.004])
      ) with { wave: "linear" }
      for s in wristPanelSwings("fore", mothWristMount, side, isRight) { s }
    ]
  }

  // The heavy gauntlet: a squared block from the elbow to the wrist, faced square to the body rather than the
  // forearm's twist, so its outer face and its vents look straight out.
  shape Superellipsoid $"bracer-{side}" {
    id: 160 + isRight * 68
    position: mirrorX(isRight, [-0.395, 0.995, 0])
    rotation [0, 0.9958, 0.0915, 0]
    scale [0.12, 0.13, 0.135]
    material: bySide(isRight, gauntletLeft, gauntletRight)
    group: 16 + isRight * 14
    parent: $"forearm-{side}"
    exponent: 3.6
  }

  shape Box $"bracerMouth-{side}" {
    id: 161 + isRight * 68
    position: mirrorX(isRight, [-0.379697, 0.474186, -0.104559])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.08495, 0.400689, -0.033242, 0.911661]))
    scale [0.4, 0.4, 0.4]
    material: skin
    blend: "Subtraction"
    group: 16 + isRight * 14
    parent: $"forearm-{side}"
  }

  shape Cylinder $"cuff-{side}" {
    id: 164 + isRight * 68
    position: mirrorX(isRight, [-0.380726, 0.872656, -0.026507])
    rotation: mirrorRotation(isRight, [0.08495, 0.400689, 0.033242, 0.911661])
    scale [0.09, 0.006, 0.09]
    material: charcoal
    parent: $"forearm-{side}"
    rounding: 0.003
  }

  wristPanel(
    mount: mothWristMount,
    side: side,
    isRight: isRight,
    ids: [2000 + isRight * 68, 2001 + isRight * 68, 2002 + isRight * 68],
    materials: { bezel: charcoal, flap: violet, screen: bySide(isRight, journalScreenLeft, journalScreenRight) }
  )

  shape Capsule $"elbowRod-{side}" {
    id: 156 + isRight * 68
    position: mirrorX(isRight, [-0.466, 1.1236, -0.084])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.253, 0, 0.411, 0.8758]))
    scale [0.013, 0.2612, 0.013]
    material: steel
    parent: $"forearm-{side}"
  }

  shape Superellipsoid $"palm-{side}" {
    id: 165 + isRight * 68
    position: mirrorX(isRight, [-0.3775, 0.7677, -0.0504])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.08495, 0.400689, -0.033242, 0.911661]))
    scale [0.09045, 0.0729, 0.054]
    material: charcoal
    parent: $"forearm-{side}"
    exponent: 2.8
  }

  shape Sweep $"wrist-{side}" {
    id: 166 + isRight * 68
    position: mirrorX(isRight, [-0.376562, 0.887196, -0.028315])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.130367, 0.388295, -0.137633, 0.901825]))
    material: charcoal
    parent: $"forearm-{side}"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.0107719, -0.0460057, 0])
      c: mirrorX(isRight, [0.0230827, -0.0985838, 0])
      radiusStart: 0.0513
      radiusEnd: 0.0513
    }
  }

  shape Sweep $"finger-{side}-0" {
    id: 167 + isRight * 68
    position: mirrorX(isRight, [-0.3382, 0.7431, -0.1047])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.130367, 0.388295, -0.137633, 0.901825]))
    material: charcoal
    parent: $"forearm-{side}"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.0215438, -0.0920114, 0.00675])
      c: mirrorX(isRight, [0.0236724, -0.0845806, -0.056025])
      radiusStart: 0.01755
      radiusEnd: 0.01755
    }
  }

  shape Sweep $"finger-{side}-1" {
    id: 168 + isRight * 68
    position: mirrorX(isRight, [-0.3665, 0.7377, -0.0744])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.130367, 0.388295, -0.137633, 0.901825]))
    material: charcoal
    parent: $"forearm-{side}"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.0233905, -0.0998981, 0.00675])
      c: mirrorX(isRight, [0.0230741, -0.0930397, -0.056025])
      radiusStart: 0.01755
      radiusEnd: 0.01755
    }
  }

  shape Sweep $"finger-{side}-2" {
    id: 169 + isRight * 68
    position: mirrorX(isRight, [-0.3949, 0.7324, -0.044])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.130367, 0.388295, -0.137633, 0.901825]))
    material: charcoal
    parent: $"forearm-{side}"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.0215438, -0.0920114, 0.00675])
      c: mirrorX(isRight, [0.0187826, -0.0857254, -0.056025])
      radiusStart: 0.01755
      radiusEnd: 0.01755
    }
  }

  shape Sweep $"finger-{side}-3" {
    id: 170 + isRight * 68
    position: mirrorX(isRight, [-0.4232, 0.727, -0.0137])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.130367, 0.388295, -0.137633, 0.901825]))
    material: charcoal
    parent: $"forearm-{side}"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.0184662, -0.078867, 0.00675])
      c: mirrorX(isRight, [0.01326, -0.0731534, -0.056025])
      radiusStart: 0.01755
      radiusEnd: 0.01755
    }
  }

  shape Sweep $"thumb-{side}" {
    id: 171 + isRight * 68
    position: mirrorX(isRight, [-0.3312, 0.7959, -0.086])
    rotation: compose(rotate([0, 1, 0], 180), mirrorRotation(isRight, [-0.130367, 0.388295, -0.137633, 0.901825]))
    material: charcoal
    parent: $"forearm-{side}"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [-0.0399434, -0.0869971, -0.0054])
      c: mirrorX(isRight, [0.020021, -0.1062331, -0.04995])
      radiusStart: 0.02565
      radiusEnd: 0.02565
    }
  }

  shape Sweep $"thigh-{side}" {
    id: 174 + isRight * 68
    position: mirrorX(isRight, [-0.135, 1.0265, 0])
    rotation: rotate([0, 1, 0], 180)
    material: charcoal
    parent: "pelvis"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.025, -0.135, 0])
      c: mirrorX(isRight, [0.05, -0.285, 0])
      radiusStart: 0.095
      radiusEnd: 0.095
    }
    // The stride swings in the plane of travel: the hip's own turn into the travel direction is undone, the plane
    // is turned to the full travel direction, the leg strides, and both turns are put back. A forward diagonal
    // strides straight ahead of the turned hips, a pure strafe abducts into a sidestep, and a backpedal strides
    // backward.
    swings [
      swing("heading", [0, 1, 0], 0.7, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "sine" }
      swing("heading", [0, 1, 0], -0.5, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear" }
      swing("gait", [-1, 0, 0], 0.7, mirrorX(isRight, [-0.145, 1.0265, 0])) with {
        wave: "sine"
        phase: bySide(isRight, 0, pi)
      }
      swing("heading", [0, 1, 0], 0.5, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear" }
      swing("heading", [0, 1, 0], -0.7, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "sine" }
      // In flight mode the hip undoes the air tuck the hover would hold at zero vertical speed (0.8 rad) and trails
      // the leg 0.1 rad back, so she hovers and flies with straight legs.
      swing("flight", [-1, 0, 0], 0.898, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear", phase: 0 }
      // In the air the thigh lifts 0.8 rad at the peak, 1.1 on the way up and 0.5 reaching for the ground.
      swing("air", [-1, 0, 0], -0.06, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear", phase: 13.3 }
      // Touching down at about 4 m/s the hip folds 0.4 rad into the crouch, and springs back as the give settles.
      swing("land", [-1, 0, 0], 0.1, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear" }
    ]
  }

