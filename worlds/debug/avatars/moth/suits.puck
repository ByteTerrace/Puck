  // The greave (see `greaveFront`): its front outline is the shape, its side outline clips it, and the arches the boot
  // passes through are cut front and back, their faces the dark of the boot's well. Its ivory bands, side panel and
  // vents are paint (`greavePaints`).
  shape Prism $"shin-{side}" {
    id: 180 + isRight * 68
    position: mirrorX(isRight, greaveAt)
    rotation: halfTurn
    scale [0.2 * slim, 0.3215, 0.23]
    material: shinViolet
    group: greaveGroup(isRight)
    parent: $"thigh-{side}"
    profile { kind: "Convex", vertices: greaveFront, cornerRadius: 0.1 }
    rounding: 0.03
    swings [
      swing("swim", [-1, 0, 0], 0.45, mirrorX(isRight, [-0.19, 0.7465, 0])) with {
        wave: "sine"
        phase: bySide(isRight, 0, pi)
      }
      swing("gait", [-1, 0, 0], 1.25, mirrorX(isRight, [-0.19, 0.7465, 0])) with {
        wave: "halfSine"
        phase: bySide(isRight, 5.184, 2.0424)
      }
      // And the knee undoes its 1.2 rad of air tuck, keeping a 0.2 rad bend.
      swing("flight", [-1, 0, 0], -1, mirrorX(isRight, [-0.19, 0.7465, 0])) with { wave: "linear", phase: 0 }
      // The knee folds 1.2 rad at the peak, 1.45 rising and 0.95 falling, the shin a little behind the knee.
      swing("air", [-1, 0, 0], 0.05, mirrorX(isRight, [-0.19, 0.7465, 0])) with { wave: "linear", phase: 24 }
      // The knee takes twice the hip's fold.
      swing("land", [-1, 0, 0], -0.2, mirrorX(isRight, [-0.19, 0.7465, 0])) with { wave: "linear" }
      swing("mantle", [-1, 0, 0], 1.8, mirrorX(isRight, [-0.19, 0.7465, 0])) with { wave: "curve:mantle-fold" }
    ]
  }

