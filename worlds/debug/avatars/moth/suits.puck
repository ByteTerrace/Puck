// The Moth's suits: the armoured frames she wears over her body (body.puck), one shape family in two sculpts. The mech
// suit is the concept pack's dusty lavender over warm ivory, heavy, with the back pods' jetpack and the heel jets' air
// jump. The scout suit is the same family cut lighter and slimmer in bone and teal: one shoulder plate a side, narrower
// greaves and gauntlets, a dorsal plate where the pods would hang and plain heels, since its contract (contract.puck)
// grants no jetpack and no air jump. Each is a prototype of its own, so a world bakes only the ones its bodies wear. Her
// head (head.puck) sits recessed in the hood; the suits' rig is her skeleton's own, driven by the look rows the avatar
// document (moth.puck) authors. A document of prototypes and nothing else: no kit, rule, light, air or floor.
//
// How the suits stay cheap: every shape that rides one bone without moving on its own joins that bone's bake group, so a
// limb bakes as one mesh; every trim, band, panel line and vent is a paint on the plate it marks, crisp at any distance
// and absent from the bake; and no plate carries a point warp (flare, shear), whose scope asks the bake for cells a
// thirty-second of the plate's thickness. Plates that taper or arch are prisms whose outlines carry the shape.
schema: "puck.world.definition.v1"
import "../../../standard/styles"
import "../../../standard/mirror"
import "../../../standard/rig"
import "../../../standard/occlusion"
import "../../../standard/wrist-panel"
import "../../menagerie"
import "head"
// Her wrist panel's mount and glass slots are her contract's (`mothWristMount`, `mothWornScreen`).
import "contract"

// What an importer binds: the creations its looks wear.
exports {
  reads [moth, $"moth-scout"]
}

// Her real head, about 0.26 m from crown to chin, sits recessed in the hood with dark lining round it.
let headScale = 0.7
let headAt = [0, 1.735, -0.207]

// The near-black of a vent slot.
let ventSlot = "#2B2630"

// Her look, swapped live by `moth.style` for playtesting: each painted slot (the plates, the undersuit, her skin, hair and
// fittings) shades plain or with the standard's cel look by the mothStyle row, which changes only those materials' style
// rows and programs and bakes nothing. Her eyes' whites and catchlights, the lights and the bare metals stay continuous in
// both, as the turnaround's glowing lenses and satin pistons read. She boots Cel, the debug world's treatment.
let mothStyles = {
  state: "state.mothStyle"
  cases [plainLook, celLook(celStyle)]
}

// The palette, by role. A slot number says nothing; a name says what the surface IS.
let skin = 0 // ivory: ear mounts, knee guards and hip guards
let violet = 1 // lavender: hood shell, pelvic plate, boots, toe caps and heel guards
let charcoal = 2 // #252630 joints, pivots, undersuit and soles
let rust = 3 // #B76B3C her skin
let ink = 4 // #171210 hair, lids and brows
let ivory = 5 // #FFF8E9 the eyes' whites
let leather = 7 // #754137
let brass = 8 // #C98F35 ochre collar and belt
let umber = 9 // #89481D
let jet = 10 // #120D13
let pearl = 11 // #FFF8EF
let violetBandLeft = 12 // lavender left shoulder plates under their ivory bands
let violetBandRight = 13 // lavender right shoulder plates under their ivory bands
let violetPodLeft = 14 // lavender left back pod under its painted ivory bands, seams, vent and grey plate
let violetPodRight = 15 // lavender right back pod under its painted ivory bands, seams, vent and grey plate
let chestArmor = 16 // ivory chest slab round its lavender centre
let plainIvory = 17 // ivory with no paints: the scout's dorsal plate
let shinViolet = 18 // lavender greaves under their painted ivory arch bands, side panels and vents
let gunmetal = 19 // #43464E heel housing, heel tread and ankle hubs, with the hubs' bezel and lens and the jets' ring painted
let steel = 20 // #8B9099 piston rods
let thrusterGlow = 21 // #D8FDFF the back-pod thruster cores, lit by flight mode (lane 2)
let thrusterCyan = 22 // #1F9BAE the back-pod thruster lenses, lit by flight mode (lane 2)
let gauntletLeft = 23 // ivory left gauntlet, lavender on its inner half, vents on its outer face
let gauntletRight = 24 // ivory right gauntlet, lavender on its inner half, vents on its outer face
let bootCyan = 25 // #1F9BAE the heel lenses' idle pilot light
let bootGlow = 26 // #D8FDFF the heel lenses' pale cores
let pistonSteel = 27 // satin steel piston cylinders
let torsoSuit = 28 // segmented charcoal fabric between the chest and belt
// The journal panels' glass: their paints are the journal's interface (contract.puck's worn screen slots).
let journalScreenLeft = mothMechSuit.wornScreen.screens.left
let journalScreenRight = mothMechSuit.wornScreen.screens.right
// Slot 6 (cyan) is free.

// Each bone's bake group, by side: every shape riding that bone without a joint of its own joins it, so the bone bakes as
// one mesh. Her head's groups are head.puck's (6 to 9 and 14).
let pelvisGroup = 2
let torsoGroup = 3
let hoodGroup = 4
function upperArmGroup(isRight) = 40 + isRight * 10
function forearmGroup(isRight) = 41 + isRight * 10
function thighGroup(isRight) = 42 + isRight * 10
function greaveGroup(isRight) = 43 + isRight * 10
function bootGroup(isRight) = 44 + isRight * 10
function toeGroup(isRight) = 45 + isRight * 10
function podGroup(isRight) = 70 + isRight

// Wear is a faint floor on a pristine suit: its coverage stays under the primer's threshold except at the tightest
// edges, where pale primer shows first, then the dark alloy.
let plateWear = 0
let lilacUndercoat = [
  { threshold: 0.2, surface { color: "#C9B4CB", roughness: 0.6, metal: 0.05 } }
  { threshold: 0.38, surface { color: "#51525C", roughness: 0.52, metal: 0.55 } }
]
let creamUndercoat = [
  { threshold: 0.2, surface { color: "#C9B9A6", roughness: 0.65, metal: 0.05 } }
  { threshold: 0.38, surface { color: "#5B5D63", roughness: 0.52, metal: 0.55 } }
]
// A plate's weathering: the shared reach, scale and deposit, its undercoat and seed its own.
function plateWeathering(seed, under) = {
  edge: 0.55
  lines: 0
  settle: 0.025
  reach: 0.014
  seed: seed
  scale: 75
  floor: plateWear
  under: under
  deposit { color: "#807568", roughness: 0.85, metal: 0 }
}
// A plate's slot: its colour, the cel switch, its finish and its weathering.
function plateSlot(color, seed, under, roughness = 0.36, specular = 0.08, coat = 0.28, paints = []) = {
  color: color
  toonSelect: mothStyles
  roughness: roughness
  specular: specular
  emissive: 0
  coat: coat
  weathering: plateWeathering(seed, under)
  paints: paints
}

// The reference's recessed heel jets point 55 degrees below rearward horizontal.
// The cylinder's -Y cap and the lens's -Z face share (0, -sin(55), -cos(55));
// the exhaust volume inherits the lens frame, so it leaves along the same axis.
let bootNozzleRotation = [-0.3007058, 0, 0, 0.9537170]
let bootLensRotation = [0.4617486, 0, 0, 0.8870108]
let bootPlanOutline = [[-0.82, -1], [-1, -0.3], [-0.9, 0.72], [-0.64, 1], [0.64, 1], [0.9, 0.72], [1, -0.3], [0.82, -1]]

// Values repeated across the body, named so changing one changes the moth rather than 120 shapes.
let softness = 2.1 // the superellipsoid exponent every rounded body part shares
let diagonal = 0.7071068 // sin/cos of 45 degrees, the quarter-turn quaternion component
let halfTurn = rotate([0, 1, 0], 180)

// The greave: a flared plate from a narrow top under the knee to a wide foot, the intersection of its front outline
// (extruded front to back) and its side outline (extruded across), both rounded, so its corners stay round with no
// warp. Outlines are in the greave's own frame about `greaveAt`, the frame its paints are authored in; the side outline's
// +X runs to her back, so its front flares further over the boot than its back.
let greaveAt = [-0.2, 0.4265, -0.0125]
let greaveFront = [[-0.75, -1], [-0.975, -0.622], [-0.825, 0], [-0.5, 0.879], [0.5, 0.879], [0.825, 0], [0.975, -0.622], [0.75, -1]]
let greaveSide = [[-0.78, -1], [-1, -0.622], [-0.546, 0.879], [0.546, 0.879], [0.878, -0.622], [0.732, -1]]
// The arch the boot passes through, front and back, and its rounded corners: the cutters carve it, and the painted
// ivory bands round it follow the same outline at a larger size.
let archOutline = [[-1, -1], [-1, 0], [-0.809, 0.588], [-0.309, 0.951], [0.309, 0.951], [0.809, 0.588], [1, 0], [1, -1]]
let archCorner = 0.25
let archFrontAt = [-0.2, 0.0458, -0.075]
let archFrontTurn = [0, 0.9397, 0.342, 0]
let archBackAt = [-0.2, 0.195, 0.25]
let archBackBandAt = [-0.2, 0.195, 0.2125]
// The pentagonal side panel on each greave's outer face, in the panel's own XY, standing at `sidePanelAt`.
let shinPanelOutline = [[-0.5, 1], [0.2692308, 1], [0.5384615, 0.1944444], [-0.1730769, -1], [-1, -0.4166667]]
let sidePanelAt = [-0.35, 0.4465, -0.0125]
function sidePanelTurn(isRight) = compose(halfTurn, mirrorRotation(isRight, [0, diagonal, 0, diagonal]))

// One greave's paints, on shinViolet: the ivory band round the front arch and the back arch, each edged by a seam and
// clipped to its half of the greave, and the ivory side panel with its two vent slots. Each band is the arch's outline at
// a larger size, posed where the arch is cut (poseIn), so the band hugs the cut.
function greavePaints(side, isRight, ivoryPlate, lavenderSeam) = let at = mirrorX(isRight, greaveAt) in let front = poseIn(
  at,
  halfTurn,
  mirrorX(isRight, archFrontAt),
  archFrontTurn
) in let frontBand = front with { position: front.position + rotatePoint(front.rotation, [0, 0, 0.15]) } in let back = poseIn(
  at,
  halfTurn,
  mirrorX(isRight, archBackBandAt),
  halfTurn
) in let panel = poseIn(
  at,
  halfTurn,
  mirrorX(isRight, sidePanelAt),
  sidePanelTurn(isRight)
) in let arch = { kind: "Convex", vertices: archOutline, cornerRadius: archCorner } in [
  frontBand with { parent: $"shin-{side}", type: "Prism", scale [0.212, 0.159, 0.16], profile: arch, color: ivoryPlate }
  frontBand with {
    parent: $"shin-{side}"
    type: "Prism"
    scale [0.212, 0.159, 0.16]
    profile: arch
    stroke: 0.004
    color: lavenderSeam
  }
  back with { parent: $"shin-{side}", type: "Prism", scale [0.19, 0.205, 0.2], profile: arch, color: ivoryPlate }
  back with { parent: $"shin-{side}", type: "Prism", scale [0.19, 0.205, 0.2], profile: arch, stroke: 0.004, color: lavenderSeam }
  panel with {
    parent: $"shin-{side}"
    type: "Prism"
    scale [0.13, 0.18, 0.2]
    profile { kind: "Convex", vertices: shinPanelOutline, cornerRadius: 0.12 }
    color: ivoryPlate
  }
  panel with {
    parent: $"shin-{side}"
    type: "Prism"
    scale [0.13, 0.18, 0.2]
    profile { kind: "Convex", vertices: shinPanelOutline, cornerRadius: 0.12 }
    stroke: 0.003
    color: lavenderSeam
  }
  { parent: $"shin-{side}", type: "Box", position: mirrorX(isRight, [0.16, 0.115, 0.03]), scale [0.08, 0.0075, 0.032], color: ventSlot }
  { parent: $"shin-{side}", type: "Box", position: mirrorX(isRight, [0.16, 0.08, 0.03]), scale [0.08, 0.0075, 0.032], color: ventSlot }
]

// The back pod: one lavender shell, cut flat against her back and on its inner face and bevelled over its shoulder, with
// the nozzle in a well under it. Its segmented look is paint: the ivory bands and the seams between its plates follow
// the arcs the first sculpt's stacked plates were cut by, posed in the shell's frame.
function podAt(isRight) = mirrorX(isRight, [-0.2, 1.13, 0.195])
function podTurn(isRight) = compose(halfTurn, mirrorTurnRotation(isRight, [0, 0, 0.0998, 0.995]))
function podPlateTurn(isRight, q) = compose(halfTurn, mirrorTurnRotation(isRight, q))
// Each plate edge, top to bottom: where the cap gives way to the upper band, the upper band to the middle plate, the
// middle plate to the lower band and the lower band to the skirt. Each is a stadium whose top arc is the edge; a paint of
// it colours everything below the arc.
function podEdges(isRight) = [
  { position: mirrorX(isRight, [-0.4779, -0.9156, 0.195]), rotation: podPlateTurn(isRight, [0, 0, 0.0998, 0.995]) }
  { position: mirrorX(isRight, [-0.5023, -1.0361, 0.3161]), rotation: podPlateTurn(isRight, [0.0249, 0.0025, 0.0998, 0.9947]) }
  { position: mirrorX(isRight, [-0.5303, -1.1741, 0.3168]), rotation: podPlateTurn(isRight, [0.0249, 0.0025, 0.0998, 0.9947]) }
  { position: mirrorX(isRight, [-0.5479, -1.2612, 0.5372]), rotation: podPlateTurn(isRight, [0.0746, 0.0075, 0.0996, 0.9922]) }
]
let podEdgeShape = { type: "Prism", scale [0.3386, 2.34, 0.78], profile { kind: "RoundedRectangle", cornerRadius: 1 }, taper: 1 }
// The vent slot on the pod's upper back, where the first sculpt cut it.
function podVentPose(isRight) = {
  position: mirrorX(isRight, [-0.1141, 1.3772, 0.4123])
  rotation: compose(halfTurn, bySide(isRight, [-0.3605, -0.5774, 0.513, 0.523], [-0.513, -0.523, 0.3605, 0.5774]))
}
// One pod's paints, on its violetPod slot: alternating ivory and lavender below each plate edge, a seam on each edge,
// the vent slot, then the grey plate and its trim strip on the flat inner face (in the inner cut's frame).
function podPaints(side, isRight, ivoryPlate, lavenderPlate, lavenderSeam) = let at = podAt(isRight) in let turn = podTurn(isRight) in let edges = map(
  podEdges(isRight),
  e => poseIn(at, turn, e.position, e.rotation)
) in let vent = podVentPose(isRight) in concat(
  [
    (podEdgeShape with edges[0]) with { parent: $"pod-{side}", color: ivoryPlate }
    (podEdgeShape with edges[1]) with { parent: $"pod-{side}", color: lavenderPlate }
    (podEdgeShape with edges[2]) with { parent: $"pod-{side}", color: ivoryPlate }
    (podEdgeShape with edges[3]) with { parent: $"pod-{side}", color: lavenderPlate }
  ],
  map(edges, e => (podEdgeShape with e) with { parent: $"pod-{side}", stroke: 0.004, color: lavenderSeam }),
  [
    poseIn(at, turn, vent.position, vent.rotation) with {
      parent: $"pod-{side}"
      type: "Box"
      scale [0.039, 0.0109, 0.0281]
      color: ventSlot
    }
    {
      parent: $"podCoreCut-{side}"
      type: "Box"
      position: mirrorX(isRight, [0.0526, 0.8091, 0.0417])
      rotation: bySide(isRight, [-0.0451, -0.0937, 0.896, -0.4318], [0.0451, 0.0937, 0.896, -0.4318])
      scale [0.0312, 0.0094, 0.2]
      color: "#9DA3B4"
    }
    { parent: $"podCoreCut-{side}", type: "Box", position [-0.117, 0.9953, 0], scale [0.22, 0.0109, 0.22], color: "#7A7F8C" }
  ]
)

// The shoulder plates: thick slabs arched over the shoulder, their front and back drooping, as a prism whose side
// outline is the arch (extruded across her shoulder) with rounded edges.
let shoulderUpperOutline = [
  [-0.85, -1]
  [-1, -0.6]
  [-1, 0.261]
  [-0.571, 0.496]
  [0, 0.609]
  [0.571, 0.496]
  [1, 0.261]
  [1, -0.6]
  [0.85, -1]
]
let shoulderLowerOutline = [
  [-0.85, -1]
  [-1, -0.6]
  [-1, 0.425]
  [-0.54, 0.625]
  [0, 0.708]
  [0.54, 0.625]
  [1, 0.425]
  [1, -0.6]
  [0.85, -1]
]
// The shoulder plates' paints, on violetBand: an ivory band along the upper plate's lower edge, and the lower plate
// ivory above its lavender skirt. The scout's single plate carries the upper band alone.
function shoulderPaints(side, ivoryPlate, scout) = concat(
  [{ parent: $"shoulderSlab-{side}", type: "Box", position [0, -0.04, 0], scale [0.25, 0.026, 0.2], color: ivoryPlate }],
  scout ? [] : [
    { parent: $"shoulderSlabLower-{side}", type: "Box", position [0, 0.035, 0], scale [0.25, 0.034, 0.2], color: ivoryPlate }
  ]
)

// The gauntlet's paints, on its own slot: lavender on the inner half facing her body, and two vent slots on its outer
// face.
function gauntletPaints(side, isRight, lavenderPlate) = [
  { parent: $"bracer-{side}", type: "Box", position: mirrorX(isRight, [-0.11, 0, 0]), scale [0.09, 0.25, 0.2], color: lavenderPlate }
  { parent: $"bracer-{side}", type: "Box", position: mirrorX(isRight, [0.12, 0.075, 0]), scale [0.03, 0.0075, 0.042], color: ventSlot }
  { parent: $"bracer-{side}", type: "Box", position: mirrorX(isRight, [0.12, 0.04, 0]), scale [0.03, 0.0075, 0.042], color: ventSlot }
]

// The gunmetal fittings' paints: each ankle hub's lavender bezel round its dark lens on its outer face, and each heel jet's
// bright steel ring round its mouth. The scout's plain heels carry no jet.
function fittingPaints(lavenderPlate, scout) = concat(
  flatMap(
    ["left", "right"],
    side => [
      { parent: $"ankleHub-{side}", type: "Cylinder", scale [0.057, 0.05, 0.057], color: lavenderPlate }
      { parent: $"ankleHub-{side}", type: "Cylinder", scale [0.036, 0.05, 0.036], color: "#120D13" }
    ]
  ),
  scout ? [] : flatMap(
    [["left", 0], ["right", 1]],
    s => [
      poseIn(
        mirrorX(s[1], [-0.2, 0.245, 0.16]),
        compose(bootNozzleRotation, halfTurn),
        mirrorX(s[1], [-0.2, 0.2089573, 0.1852374]),
        compose(bootNozzleRotation, halfTurn)
      ) with { parent: $"heelHousing-{s[0]}", type: "Cylinder", scale [0.099, 0.014, 0.099], color: "#8B9099" }
    ]
  )
)

// The hood's ear mounts' paints, on the ivory: a lavender cover, a brass ring and a lavender button, concentric on each
// mount's outer face.
function earPaints(lavenderPlate) = flatMap(
  ["left", "right"],
  side => [
    { parent: $"earMount-{side}", type: "Cylinder", scale [0.07, 0.05, 0.07], color: lavenderPlate }
    { parent: $"earMount-{side}", type: "Cylinder", scale [0.044, 0.05, 0.044], color: "#C98F35" }
    { parent: $"earMount-{side}", type: "Cylinder", scale [0.033, 0.05, 0.033], color: lavenderPlate }
  ]
)

// Both sides of the body: the left side is written out, and `standard/mirror` gives the right side its values from it.
// `side` is "left" or "right" and `isRight` 0 or 1; `scout` cuts the scout suit's lighter frame.

template mothLimbs(side, isRight, scout) {
  // The scout's plates are narrower front to back and across.
  let slim = scout ? 0.86 : 1

  shape Sweep $"upperArm-{side}" {
    id: 148 + isRight * 68
    position: mirrorX(isRight, [-0.295, 1.4515, 0])
    rotation: compose(halfTurn, mirrorRotation(isRight, [0, 0, -0.078459, 0.996917]))
    material: charcoal
    group: upperArmGroup(isRight)
    parent: "torso"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.0363, -0.1009, 0])
      c: mirrorX(isRight, [0.0727, -0.2059, 0])
      radiusStart: 0.08
      radiusEnd: 0.08
    }
    swings [
      swing("swim", [-1, 0, 0], 0.55, mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "sine"
        phase: bySide(isRight, 0, pi)
      }
      swing("swim", [0, 0, -1], flip(isRight, -0.85), mirrorX(isRight, [-0.295, 1.4515, 0])) with { wave: "constant" }
      swing("run", [0, 0, -1], flip(isRight, -0.15), mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "constant"
        phase: 0
      }
      swing("gait", signed(isRight, [-0.987688, -0.156434, 0], [1, -1, 1]), 0.42, mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "sine"
        phase: bySide(isRight, pi, 2 * pi)
      }
      swing("flight", [0, 0, -1], flip(isRight, -0.1), mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "linear"
        phase: 0
      }
      // The arms open 0.45 rad from the sides at the peak, 0.6 on the way up and 0.3 coming down.
      swing("air", [0, 0, -1], flip(isRight, 0.03), mirrorX(isRight, [-0.295, 1.4515, 0])) with {
        wave: "linear"
        phase: 15
      }
      // And lift forward 0.12 rad, 0.2 rising.
      swing(
        "air",
        signed(isRight, [-0.987688, -0.156434, 0], [1, -1, 1]),
        -0.015,
        mirrorX(isRight, [-0.295, 1.4515, 0])
      ) with {
        wave: "linear"
        phase: 8
      }
      // On a wall both arms reach forward and up to it; the hand effectors plant each palm in turn as she climbs.
      swing("cling", [-1, 0, 0], -2.2, mirrorX(isRight, [-0.295, 1.4515, 0])) with { wave: "constant" }
      // A mantle throws both arms up for the catch, brings the hands down onto the top, pushes and sweeps them back.
      swing("mantle", [-1, 0, 0], -2.4, mirrorX(isRight, [-0.295, 1.4515, 0])) with { wave: "curve:mantle-reach" }
      for s in wristPanelSwings("upper", mothWristMount, side, isRight) { s }
    ]
  }

  shape Superellipsoid $"elbow-{side}" {
    id: 149 + isRight * 68
    position: mirrorX(isRight, [-0.336, 1.2201, -0.004])
    rotation: mirrorRotation(isRight, [0, 0, 0.078459, 0.996917])
    scale [0.07, 0.065, 0.072]
    material: charcoal
    group: upperArmGroup(isRight)
    parent: $"upperArm-{side}"
    exponent: softness
  }

  // The shoulder stack: two thick plates on a round charcoal pivot, riding the upper arm (the scout wears the upper one
  // alone). The upper plate's inner edge stays outboard of the hood as the arm swings.
  shape Superellipsoid $"shoulderPivot-{side}" {
    id: 150 + isRight * 68
    position: mirrorX(isRight, [-0.3, 1.46, 0])
    scale [0.085, 0.085, 0.085]
    material: charcoal
    group: upperArmGroup(isRight)
    parent: $"upperArm-{side}"
    exponent: 3
  }

  shape Prism $"shoulderSlab-{side}" {
    id: 151 + isRight * 68
    position: mirrorX(isRight, scout ? [-0.385, 1.545, 0.005] : [-0.395, 1.57, 0.005])
    rotation: compose(halfTurn, mirrorRotation(isRight, [0, 0, -0.1305, 0.9914]), rotate([0, 1, 0], 90))
    scale: scout ? [0.165, 0.11, 0.125] : [0.175, 0.115, 0.135]
    material: bySide(isRight, violetBandLeft, violetBandRight)
    group: upperArmGroup(isRight)
    parent: $"upperArm-{side}"
    profile { kind: "Convex", vertices: shoulderUpperOutline, cornerRadius: 0.15 }
    rounding: 0.025
  }

  if scout == false {
    shape Prism $"shoulderSlabLower-{side}" {
      id: 152 + isRight * 68
      position: mirrorX(isRight, [-0.415, 1.43, 0])
      rotation: compose(halfTurn, mirrorRotation(isRight, [0, 0, -0.0698, 0.9976]), rotate([0, 1, 0], 90))
      scale [0.185, 0.12, 0.14]
      material: bySide(isRight, violetBandLeft, violetBandRight)
      group: upperArmGroup(isRight)
      parent: $"upperArm-{side}"
      profile { kind: "Convex", vertices: shoulderLowerOutline, cornerRadius: 0.15 }
      rounding: 0.025
    }
  }

  // The elbow piston, inside the bend: a cylinder on the upper arm and a rod on the forearm, both aimed at the
  // hinge so they meet inside the joint at any bend.
  shape Cylinder $"elbowCylinder-{side}" {
    id: 153 + isRight * 68
    position: mirrorX(isRight, [-0.3834, 1.3086, -0.0499])
    rotation: mirrorRotation(isRight, [0.6604, 0, -0.6817, 0.3149])
    scale [0.022, 0.0594, 0.022]
    material: pistonSteel
