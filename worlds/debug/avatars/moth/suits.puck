      material: bootGlow
      group: bootGroup(isRight)
      parent: $"boot-{side}"
      exponent: 2
    }
  }

  shape Prism $"toe-{side}" {
    id: 199 + isRight * 68
    position: mirrorX(isRight, [-0.2, 0.125, -0.205])
    rotation: compose(halfTurn, [0, -diagonal, 0, diagonal])
    scale [0.19, 0.12, 0.215 * slim]
    material: violet
    group: toeGroup(isRight)
    parent: $"boot-{side}"
    profile {
      kind: "Convex"
      cornerRadius: 0.075
      vertices [
        [-1, -0.78]
        [-1, 0.22]
        [-0.65, 0.64]
        [0.28, 0.51]
        [0.82, 0.13]
        [1, -0.35]
        [0.86, -0.78]
      ]
    }
  }

  shape Prism $"toePlan-{side}" {
    id: 200 + isRight * 68
    position: mirrorX(isRight, [-0.2, 0.1, -0.205])
    rotation: compose(halfTurn, [diagonal, 0, 0, diagonal])
    scale [0.18 * slim, 0.2, 0.2]
    material: violet
    blend: "SmoothIntersection"
    smooth: 0.02
    group: toeGroup(isRight)
    parent: $"boot-{side}"
    profile {
      kind: "Convex"
      cornerRadius: 0.12
      vertices: bootPlanOutline
    }
  }

  if scout == false {
    // The air gate opens the heel before a second-jump jet fires: fold the centre tread forward, and splay the two
    // carved guards at their front hinges.
    shape Prism $"heelTread-{side}" {
      id: 956 + isRight * 7
      position: mirrorX(isRight, [-0.2, 0.035, 0.08])
      rotation [0, 1, 0, 0]
      scale [0.055, 0.035, 0.065]
      material: gunmetal
      parent: $"boot-{side}"
      swings [
        swing("air", [-1, 0, 0], 1.0471976, mirrorX(isRight, [-0.2, 0.09, 0.015])) with { wave: "constant", phase: 0 }
      ]
      slides [
        {
          driver: "air"
          axis [0, 0, -1]
          amplitude: 0.08
          phase: 0
          wave: "constant"
        }
      ]
      profile {
        kind: "RoundedRectangle"
        cornerRadius: 0.25
        sides: 6
      }
      rounding: 0.008
    }

    for (cheek, k) in [
      { name: "inner", id: 1301, x: -0.085, splay: 0.1, group: 129 }
      { name: "outer", id: 1300, x: -0.315, splay: -0.28, group: 130 }
    ] {
      shape Prism $"heelCheek-{cheek.name}-{side}" {
        id: cheek.id + isRight * 20
        position: mirrorX(isRight, [cheek.x, 0.09, 0.135])
        rotation [0, 0.7071068, 0, 0.7071068]
        scale [0.115, 0.09, 0.052]
        material: violet
        group: cheek.group + isRight * 2
        parent: $"boot-{side}"
        swings [
          swing("air", [0, 1, 0], flip(isRight, cheek.splay), mirrorX(isRight, [cheek.x, 0.09, 0.02])) with {
            wave: "constant"
            phase: 0
          }
        ]
        profile {
          kind: "Convex"
          cornerRadius: 0.18
          sides: 6
          vertices [
            [-1, -0.8]
            [-1, 0.22]
            [-0.3, 0.84]
            [0.55, 0.55]
            [1, -0.1]
            [0.85, -0.8]
          ]
        }
      }

      shape Cylinder $"heelCheekClearance-{cheek.name}-{side}" {
        id: 1342 + k + isRight * 20
        position: mirrorX(isRight, [-0.2, 0.169638, 0.212769])
        rotation: compose(bootNozzleRotation, halfTurn)
        scale [0.12, 0.24, 0.12]
        material: violet
        blend: "SmoothSubtraction"
        smooth: 0.02
        group: cheek.group + isRight * 2
        parent: $"heelCheek-{cheek.name}-{side}"
        rounding: 0.008
      }
    }

    // The thruster pod (`podAt`): one lavender shell cut flat against her back and on its inner face, bevelled over its
    // shoulder, with the nozzle in a dark well under it. Its plates' bands, seams and vent are paint (`podPaints`).
    shape Superellipsoid $"pod-{side}" {
      id: 1100 + isRight * 100
      position: podAt(isRight)
      rotation: podTurn(isRight)
      scale [0.1841, 0.4446, 0.2387]
      material: bySide(isRight, violetPodLeft, violetPodRight)
      group: podGroup(isRight)
      parent: "torso"
      exponent: 2.8
      swings [
        swing("wings", [0, 0, -1], flip(isRight, 0.105), mirrorX(isRight, [-0.09, 1.6015, 0.185])) with {
          wave: "linear"
          phase: 0
        }
        swing("wings", [-1, 0, 0], 0.07, mirrorX(isRight, [-0.09, 1.6015, 0.185])) with { wave: "linear", phase: 0 }
        swing("bank", [0, 1, 0], flip(isRight, 0.05), mirrorX(isRight, [-0.09, 1.6015, 0.185])) with {
          wave: "linear"
          phase: 0
        }
      ]
    }

    shape Box $"podCapClip-{side}" {
      id: 1107 + isRight * 100
      position: mirrorX(isRight, [-1.04, 1.13, 0.4376])
      rotation: compose(halfTurn, mirrorTurnRotation(isRight, [0, 0, 0, 1]))
      scale [1, 1, 0.2254]
      material: bySide(isRight, violetPodLeft, violetPodRight)
      blend: "Intersection"
      group: podGroup(isRight)
      parent: $"pod-{side}"
    }

    // The flat inner face, where the grey plate is painted in this cutter's frame.
    shape Box $"podCoreCut-{side}" {
      id: 1104 + isRight * 100
      position: mirrorX(isRight, [-0.7473, 1.6778, -0.0131])
      rotation: compose(halfTurn, mirrorTurnRotation(isRight, [-0.0356, -0.0977, 0.9346, 0.3402]))
      scale [1, 1, 1]
      material: bySide(isRight, violetPodLeft, violetPodRight)
      blend: "Intersection"
      group: podGroup(isRight)
      parent: $"pod-{side}"
    }

    for (bevel, k) in [{ x: -0.014, y: 1.0923, smooth: 0.03 }, { x: -0.0545, y: 1.1005, smooth: 0.08 }] {
      shape Box $"podShoulder{k}-{side}" {
        id: 1110 + k + isRight * 100
        position: mirrorX(isRight, [bevel.x, bevel.y, 0.195])
        rotation: compose(halfTurn, mirrorTurnRotation(isRight, [0, 0, -0.633, 0.7742]))
        scale [0.78, 0.78, 0.78]
        material: bySide(isRight, violetPodLeft, violetPodRight)
        blend: "SmoothIntersection"
        smooth: bevel.smooth
        group: podGroup(isRight)
        parent: $"pod-{side}"
      }
    }

    // The well under the shell's foot the nozzle sits in, its face the dark of the cut.
    shape Superellipsoid $"podWell-{side}" {
      id: 1103 + isRight * 100
      position: mirrorX(isRight, [-0.215, 0.76, 0.3])
      scale [0.13, 0.14, 0.16]
      material: charcoal
      blend: "Subtraction"
      group: podGroup(isRight)
      parent: $"pod-{side}"
      exponent: 2.5
    }

    // The strap it hangs from.
    shape Superellipsoid $"podHanger-{side}" {
      id: 1105 + isRight * 100
      position: mirrorX(isRight, [-0.105, 1.5, 0.18])
      rotation: mirrorTurnRotation(isRight, [0, 0, 0, 1])
      scale [0.024, 0.12, 0.016]
      material: charcoal
      group: podGroup(isRight)
      parent: $"pod-{side}"
      exponent: 6
    }

    // The nozzle's gunmetal lip, then the nozzle in it with its bore, and the lens and core lit in the bore.
    shape Prism $"nozzleLip-{side}" {
      id: 1140 + isRight * 100
      position: mirrorX(isRight, [-0.229, 0.8711, 0.3075])
      rotation: compose(halfTurn, mirrorTurnRotation(isRight, [-0.5959, 0.2037, -0.28, 0.7246]))
      scale [0.154, 0.104, 0.0156]
      material: gunmetal
      group: podGroup(isRight)
      parent: $"pod-{side}"
      profile {
        kind: "RoundedRectangle"
        cornerRadius: 1
      }
      taper: 1
      rounding: 0.006
    }

    shape Prism $"nozzleLipHole-{side}" {
      id: 1141 + isRight * 100
      position: mirrorX(isRight, [-0.229, 0.8711, 0.3075])
      rotation: compose(halfTurn, mirrorTurnRotation(isRight, [-0.5959, 0.2037, -0.28, 0.7246]))
      scale [0.1353, 0.0853, 0.0312]
      material: gunmetal
      blend: "Subtraction"
      group: podGroup(isRight)
      parent: $"pod-{side}"
      profile {
        kind: "RoundedRectangle"
        cornerRadius: 1
      }
      taper: 1
    }

    shape Prism $"nozzle-{side}" {
      id: 1135 + isRight * 100
      position: mirrorX(isRight, [-0.232, 0.8746, 0.3066])
      rotation: mirrorTurnRotation(isRight, [0.5959, 0.2037, 0.28, 0.7246])
      scale [0.1321, 0.0822, 0.0234]
      material: charcoal
      group: podGroup(isRight)
      parent: $"pod-{side}"
      profile {
        kind: "RoundedRectangle"
        cornerRadius: 1
      }
      taper: 1
      rounding: 0.008
    }

    shape Prism $"nozzleBore-{side}" {
      id: 1137 + isRight * 100
      position: mirrorX(isRight, [-0.2172, 0.8571, 0.3114])
      rotation: mirrorTurnRotation(isRight, [0.5959, 0.2037, 0.28, 0.7246])
      scale [0.1181, 0.0682, 0.0125]
      material: jet
      blend: "Subtraction"
      group: podGroup(isRight)
      parent: $"pod-{side}"
      profile {
        kind: "RoundedRectangle"
        cornerRadius: 1
      }
      taper: 1
    }

    shape Superellipsoid $"nozzleGlow-{side}" {
      id: 1138 + isRight * 100
      position: mirrorX(isRight, [-0.2236, 0.8647, 0.3093])
      rotation: mirrorTurnRotation(isRight, [0.5959, 0.2037, 0.28, 0.7246])
      scale [0.0595, 0.037, 0.0055]
      material: thrusterCyan
      group: podGroup(isRight)
      parent: $"pod-{side}"
      exponent: softness
    }

    shape Superellipsoid $"nozzleCore-{side}" {
      id: 1139 + isRight * 100
      position: mirrorX(isRight, [-0.2212, 0.8617, 0.3101])
      rotation: mirrorTurnRotation(isRight, [0.5959, 0.2037, 0.28, 0.7246])
      scale [0.0238, 0.0148, 0.0047]
      material: thrusterGlow
      group: podGroup(isRight)
      parent: $"pod-{side}"
      exponent: softness
    }

    shape Cylinder $"podHinge-{side}" {
      id: 212 + isRight * 68
      position: mirrorX(isRight, [-0.102, 1.6015, 0.185])
      rotation [-diagonal, 0, 0, diagonal]
      scale [0.018, 0.008, 0.018]
      material: charcoal
      group: torsoGroup
      parent: "torso"
    }
  }
}

// The mech suit's exhaust: each pod's leaves its nozzle 55 degrees back from straight down and narrows to two and a half
// times its mouth, so in a straight-legged hover it passes behind the greaves rather than over them (sheet 10), and each
// heel thruster's lens fires one, dark but for the air jump's boost. Each pod's is posed in its shell's frame.
let exhaustRamp = [
  { density: 0, color: "#134D8B" }
  { density: 0.3, color: "#238EDB" }
  { density: 0.65, color: "#57DCEE" }
  { density: 1, color: "#DCFCFF" }
]
function podExhaust(side, isRight, seed) = poseIn(
  podAt(isRight),
  podTurn(isRight),
  mirrorX(isRight, [-0.21, 1.0413, 0.1872]) + rotatePoint(halfTurn, mirrorX(isRight, [0.0072, -0.4054, -0.2791])),
  compose(halfTurn, [0.4617, 0, 0, 0.887])
) with {
  kind: "flow"
  parent: $"pod-{side}"
  halfExtent [0.2, 0.25, 0.2]
  axis: 0.5
  width: 0.0432
  spread: 2.5
  fade: 1.5
  noiseScale: 0.08
  noiseDepth: 0.4
  speed: 1.5
  seed: seed
  steps: 40
  intensity: 90000
  extinction: 1.2
  pulseAmplitude: 0.04
  pulseFrequency: 14
  intensityLane: 1
  ramp: exhaustRamp
}
function heelExhaust(side, seed) = {
  kind: "flow"
  parent: $"heelLight-{side}"
  position [0, 0, -0.19]
  rotation [0.707107, 0, 0, 0.707107]
  halfExtent [0.08, 0.18, 0.08]
  axis: 0.36
  width: 0.045
  spread: 1.3
  fade: 1.1
  noiseScale: 0.05
  noiseDepth: 0.4
  speed: 2.5
  seed: seed
  steps: 32
  intensity: 330000
  extinction: 1.2
  pulseAmplitude: 0.06
  pulseFrequency: 18
  intensityLane: 3
  ramp: exhaustRamp
}
let mechExhaust = [podExhaust("left", 0, 31), podExhaust("right", 1, 39), heelExhaust("left", 53), heelExhaust("right", 59)]

// One suit: the frame below as the prototype `id`, its ivory plates, lavender plates and the lavender of its grooves in
// the colours given; `scout` cuts the scout's lighter frame.
template suitPrototype(id, ivoryPlate = "#F2C49A", lavenderPlate = "#744080", lavenderSeam = "#5E3468", scout = false) {
prototypes {
  allow PUCK133 "her wall toes solve after her ground feet on the same legs: on a face the ground feet have let go, and at a wall's foot the toes are meant to win"
  prototype $"{id}" {
    // Her capsule darkens the floor at her feet and the wall beside her, and shadows her from a lamp onto them.
    occlusion: bodyOcclusion
    document {
      schema: "puck.creation.v2"
      name: $"{id}"
      // At rest her breath re-poses her ten times a second: a breath's few millimetres stay smooth at it, and the views
      // that show her stand between poses. A stride poses her on the frame it starts.
      behavior {
        restRate: 10
      }
      // The blink seats each closed lid over its eye and parks the open eye's pieces behind the face, at the head's scale.
      frames [mothBlinkFrame(headAt, headScale)]
      // The suit is pristine, as on the sheets: wear reaches only the tightest edges, and faintly.
      palette [
        plateSlot(ivoryPlate, 71, creamUndercoat, paints: earPaints(lavenderPlate))
        // The sole grooves, and the hood's ivory trim in the helmet's frame: a horseshoe round the face opening, its
        // ellipse projected along the face's forward axis; the throat opening leaves the helmet no surface below it.
        plateSlot(
          lavenderPlate,
          72,
          lilacUndercoat,
          roughness: 0.3,
          specular: 0.12,
          coat: 0.4,
          paints: concat(
            flatMap(
              ["left", "right"],
              side => [
                {
                  parent: $"sole-{side}"
                  type: "Prism"
                  position [0, 0.02, 0.29]
                  rotation [0, diagonal, 0, diagonal]
                  scale [0.0065, 0.0065, 0.3]
                  profile { kind: "Ellipse" }
                  color: lavenderSeam
                }
                {
                  parent: $"sole-{side}"
                  type: "Prism"
                  position [0, 0.022, -0.115]
                  rotation [0, diagonal, 0, diagonal]
                  scale [0.0065, 0.0065, 0.3]
                  profile { kind: "Ellipse" }
                  color: lavenderSeam
                }
              ]
            ),
            [
              {
                parent: "helmet"
                type: "Prism"
                position [0, -0.0198, 0.21575]
                scale [0.24265, 0.26245, 0.2]
                profile { kind: "Ellipse" }
                stroke: 0.0227
                color: ivoryPlate
              }
            ]
          )
        )
        {
          color: "#252630"
          toonSelect: mothStyles
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#B76B3C"
          toonSelect: mothStyles
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
          wrap: 0.35
          fill: "#8A4A2C"
          // The mouth, in the face's frame: a line where the face crosses a thin quadratic sweep laid on it.
          paints [
            {
              parent: "face"
              type: "Sweep"
              curve {
                a: map([-0.05808, -0.088389, 0.1068], v => v * headScale)
                b: map([0, -0.1141765, 0.1082], v => v * headScale)
                c: map([0.05808, -0.0862981, 0.1078], v => v * headScale)
                radiusStart: 0.0015
                radiusEnd: 0.0015
              }
              color: "#754137"
            }
          ]
        }
        {
          color: "#171210"
          toonSelect: mothStyles
          roughness: 0.32
          specular: 0.1
          emissive: 0
          coat: 0.05
          sheen: 0.3
        }
        {
          color: "#FFF8E9"
          roughness: 0.22
          specular: 0.04
          emissive: 0
          coat: 0
          paints: mothLidPaints(headScale)
        }
        {
          color: "#2ED6EC"
          roughness: 0.25
          specular: 0.04
          emissive: 2250
          coat: 0
        }
        {
          color: "#754137"
          toonSelect: mothStyles
          roughness: 0.6
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#C98F35"
          toonSelect: mothStyles
          roughness: 0.42
          specular: 0.04
          emissive: 0
          coat: 0
          metal: 0.2
          weathering {
            edge: 0.5
            lines: 0
            settle: 0.015
            reach: 0.012
            seed: 79
            scale: 45
            floor: plateWear
            under [{ threshold: 0.22, surface { color: "#D0AF70", roughness: 0.6, metal: 0.5 } }]
            deposit { color: "#615B53", roughness: 0.85, metal: 0 }
          }
        }
        {
          color: "#89481D"
          toonSelect: mothStyles
          roughness: 0.25
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#120D13"
          toonSelect: mothStyles
          roughness: 0.25
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#FFF8EF"
          roughness: 0.2
          specular: 0.04
          emissive: 1200
          coat: 0
        }
        // The shoulder plates, each side's in its plates' own frames.
        plateSlot(lavenderPlate, 83, lilacUndercoat, roughness: 0.3, specular: 0.12, coat: 0.4, paints: shoulderPaints("left", ivoryPlate, scout))
        plateSlot(lavenderPlate, 84, lilacUndercoat, roughness: 0.3, specular: 0.12, coat: 0.4, paints: shoulderPaints("right", ivoryPlate, scout))
        // The back pods, each in its shell's frame.
        plateSlot(
          lavenderPlate,
          85,
          lilacUndercoat,
          roughness: 0.3,
          specular: 0.12,
          coat: 0.4,
          paints: scout ? [] : podPaints("left", 0, ivoryPlate, lavenderPlate, lavenderSeam)
        )
        plateSlot(
          lavenderPlate,
          86,
          lilacUndercoat,
          roughness: 0.3,
          specular: 0.12,
          coat: 0.4,
          paints: scout ? [] : podPaints("right", 1, ivoryPlate, lavenderPlate, lavenderSeam)
        )
        // The chest slab's lavender centre, in the slab's frame, leaving the ivory border round it.
        plateSlot(
          ivoryPlate,
          87,
          creamUndercoat,
          roughness: 0.34,
          coat: 0.3,
          paints: [
            {
              parent: "chestSlab"
              type: "Prism"
              position [0, -0.005, 0.055]
              scale [0.125, 0.105, 0.06]
              profile {
                kind: "Polygon"
                sides: 6
              }
              color: lavenderPlate
            }
          ]
        )
        plateSlot(ivoryPlate, 88, creamUndercoat)
        // The greaves, each in its own frame.
        plateSlot(
          lavenderPlate,
          89,
          lilacUndercoat,
          paints: concat(greavePaints("left", 0, ivoryPlate, lavenderSeam), greavePaints("right", 1, ivoryPlate, lavenderSeam))
        )
        {
          color: "#43464E"
          roughness: 0.34
          specular: 0.35
          metal: 0.6
          emissive: 0
          coat: 0.2
          weathering {
            edge: 0.5
            lines: 0
            settle: 0.015
            reach: 0.012
            seed: 90
            scale: 45
            floor: plateWear
            under [{ threshold: 0.22, surface { color: "#858891", roughness: 0.6, metal: 0.5 } }]
            deposit { color: "#615B53", roughness: 0.85, metal: 0 }
          }
          paints: fittingPaints(lavenderPlate, scout)
        }
        {
          color: "#8B9099"
          roughness: 0.3
          specular: 0.4
          metal: 0.7
          emissive: 0
          coat: 0.2
          weathering {
            edge: 0.5
            lines: 0
            settle: 0.015
            reach: 0.012
            seed: 91
            scale: 45
            floor: plateWear
            under [{ threshold: 0.22, surface { color: "#BDC1C5", roughness: 0.6, metal: 0.5 } }]
            deposit { color: "#615B53", roughness: 0.85, metal: 0 }
          }
        }
        {
          color: "#D8FDFF"
          roughness: 0.2
          specular: 0.04
          emissive: 4500
          emissiveLane: 2
          coat: 0
        }
        {
          color: "#1F9BAE"
          roughness: 0.25
          specular: 0.04
          emissive: 3600
          emissiveLane: 2
          coat: 0
        }
        // The gauntlets, each in its own frame.
        plateSlot(ivoryPlate, 94, creamUndercoat, paints: gauntletPaints("left", 0, lavenderPlate))
        plateSlot(ivoryPlate, 95, creamUndercoat, paints: gauntletPaints("right", 1, lavenderPlate))
        {
          color: "#1F9BAE"
          roughness: 0.25
          specular: 0.04
          emissive: 1050
          coat: 0
        }
        {
          color: "#D8FDFF"
          roughness: 0.2
          specular: 0.04
          emissive: 1950
          coat: 0
        }
        {
          color: "#7A7E88"
          roughness: 0.3
          specular: 0.4
          metal: 0.6
          coat: 0.15
        }
        {
          color: "#1C1D24"
          toonSelect: mothStyles
          roughness: 0.65
          specular: 0.05
          paints [
            {
              type: "Box"
              position [0.12, -0.04, 0.09]
              rotation [0, 0, 0.1736482, 0.9848078]
              scale [0.06, 0.003, 0.08]
              color: "#0D1016"
            }
            {
              type: "Box"
              position [-0.12, -0.04, 0.09]
              rotation [0, 0, -0.1736482, 0.9848078]
              scale [0.06, 0.003, 0.08]
              color: "#0D1016"
            }
            {
              type: "Box"
              position [0.12, -0.1, 0.09]
              rotation [0, 0, 0.1736482, 0.9848078]
              scale [0.06, 0.003, 0.08]
              color: "#0D1016"
            }
            {
              type: "Box"
              position [-0.12, -0.1, 0.09]
              rotation [0, 0, -0.1736482, 0.9848078]
              scale [0.06, 0.003, 0.08]
              color: "#0D1016"
            }
          ]
        }
        // The journal panels' glass (the wrist panel's), lettered with the journal's interface and lit as a flap opens.
        wristPanelGlass("left", menagerieKinds)
        wristPanelGlass("right", menagerieKinds)
      ]
      shape Superellipsoid "pelvis" {
        id: 1
        position [0, 1.0215, 0]
        scale [0.195, 0.1425, 0.1475]
        material: charcoal
        group: pelvisGroup
        exponent: softness
        // The whole body rides the pelvis: it turns its hips into a diagonal (0.7 rad at 45 degrees off the facing,
        // none in a pure strafe or backpedal), trails a turn by 0.12 s of turn rate, and leans about the ground into
        // its planar acceleration, sideways into a curving run and forward into a start.
        swings [
          swing("gait", [0, 1, 0], 0.08, [0, 1.0765, 0]) with { wave: "sine", phase: 0 }
          // Moving in flight pitches the whole body 0.6 rad about her middle, so the legs trail behind; the cruise gate
          // eases it in and out. A constant wave: the pitch is a pose, the same at any speed.
          swing("cruise", [-1, 0, 0], 0.6, [0, 1, 0]) with { wave: "constant", phase: 0 }
          swing("gait", [0, 0, -1], 0.05, [0, 1.0765, 0]) with { wave: "sine", phase: 0 }
          swing("heading", [0, 1, 0], 0.7, [0, 1.0765, 0]) with { wave: "sine" }
          swing("trail", [0, 1, 0], -0.12, [0, 1.0765, 0]) with { wave: "linear" }
          swing("lean", [0, 0, -1], -0.016, [0, 0, 0]) with { wave: "linear" }
          swing("surge", [-1, 0, 0], 0.006, [0, 0, 0]) with { wave: "linear" }
          // Landing pitches her forward about the ground point, 0.08 rad at 4 m/s.
          swing("land", [-1, 0, 0], -0.02, [0, 0, 0]) with { wave: "linear" }
          // Over a ledge her hips pitch with her chest as it drives over her hands.
          swing("mantle", [-1, 0, 0], 0.25, [0, 1, 0]) with { wave: "curve:mantle-chest" }
        ]
        slides [
          {
            driver: "bob"
            axis [0, 1, 0]
            amplitude: 0.022
            phase: -1.5708
            wave: "sine"
          }
          // And drops her hips 10 cm at 4 m/s; the planted feet fold the legs under them.
          {
            driver: "land"
            axis [0, 1, 0]
            amplitude: 0.025
            wave: "linear"
          }
        ]
      }

      // The lavender plate below the belt, narrowing to a point between the thighs, and the ochre belt and its clasp.
      shape Prism "pelvicShield" {
        id: 7
        position [0, 1.0, -0.13]
        rotation: halfTurn
        scale [0.125, 0.11, 0.04]
        material: violet
        group: pelvisGroup
        parent: "pelvis"
        profile {
          kind: "Convex"
          vertices [[-1, 1], [1, 1], [0.85, 0.2], [0.3, -1], [-0.3, -1], [-0.85, 0.2]]
          cornerRadius: 0.1
        }
      }

      shape Superellipsoid "belt" {
        id: 10
        position [0, 1.118, 0]
        rotation: halfTurn
        scale [0.17, 0.026, 0.1325]
        material: brass
        group: pelvisGroup
        parent: "pelvis"
        exponent: softness
      }

      shape Prism "beltClasp" {
        id: 11
        position [0, 1.126, -0.133]
        rotation: halfTurn
        scale [0.069, 0.027, 0.015]
        material: brass
        group: pelvisGroup
        parent: "pelvis"
        profile {
          kind: "Convex"
          vertices [
            [-0.72, 1]
            [0.72, 1]
            [1, 0.25]
            [0.72, -1]
            [-0.72, -1]
            [-1, 0.25]
          ]
          cornerRadius: 0.12
        }
      }

      shape Superellipsoid "torso" {
        id: 2
        position [0, 1.2915, 0]
        rotation: halfTurn
        scale [0.15, 0.285, 0.1225]
        material: torsoSuit
        group: torsoGroup
        parent: "pelvis"
        exponent: softness
        // The chest turns most of the way back from the hips toward the facing and leads a turn the hips trail.
        swings [
          swing("dash", [-1, 0, 0], 0.4, [0, 1.0765, 0]) with { wave: "linear" }
          // Over a ledge her chest arches back for the catch, then drives over her hands onto the top.
          swing("mantle", [-1, 0, 0], 0.55, [0, 1.0765, 0]) with { wave: "curve:mantle-chest" }
          swing("gait", [0, 1, 0], -0.16, [0, 1.0765, 0]) with { wave: "sine", phase: 0 }
          swing("bob", [-1, 0, 0], -0.025, [0, 1.0765, 0]) with { wave: "sine", phase: -1.0708 }
          swing("heading", [0, 1, 0], -0.4, [0, 1.0765, 0]) with { wave: "sine" }
          swing("trail", [0, 1, 0], 0.08, [0, 1.0765, 0]) with { wave: "linear" }
          swing("bank", [0, 0, -1], -0.2, [0, 1.0765, 0]) with { wave: "linear", phase: 0 }
          swing("run", [-1, 0, 0], 0.1, [0, 1.0765, 0]) with { wave: "constant", phase: 0 }
        ]
        slides [
          {
            driver: "breath"
            axis [0, 1, 0]
            amplitude: 0.003
            phase: 0
            wave: "sine"
          }
        ]
      }

      // One flat chamfered slab over the chest; its ivory border and lavender centre are paint (chestArmor). The
      // scout's is smaller.
      shape Prism "chestSlab" {
        id: 3
        position [0, 1.38, -0.1]
        rotation: halfTurn
        scale: scout ? [0.15, 0.14, 0.045] : [0.175, 0.165, 0.055]
        material: chestArmor
        group: torsoGroup
        parent: "torso"
        profile {
          kind: "ChamferedRectangle"
          cornerRadius: 0.3
        }
        rounding: 0.012
      }

      shape Superellipsoid "neckYoke" {
        id: 13
        position [0, 1.495, -0.0025]
        scale [0.175, 0.07, 0.115]
        material: charcoal
        group: torsoGroup
        parent: "torso"
        exponent: softness
      }

      // The spine down her back and its five joints, one shape repeated.
      shape Superellipsoid "spine" {
        id: 14
        position [0, 1.3465, 0.155]
        scale [0.0225, 0.1775, 0.0175]
        material: charcoal
        group: torsoGroup
        parent: "torso"
        exponent: 3
      }

      shape Superellipsoid "spineJoints" {
        id: 15
        position [0, 1.339, 0.172]
        scale [0.019, 0.012, 0.01]
        material: charcoal
        group: torsoGroup
        parent: "torso"
        exponent: 3
        domain [repeat(spacing: [1, 0.0675, 1], limit: [0, 2, 0], origin: [0, 1.339, 0.172])]
      }

      if scout {
        // The scout's dorsal plate, where the mech suit's pods hang: a slim bone shield down her back over the spine.
        shape Prism "dorsalPlate" {
          id: 30
          position [0, 1.36, 0.165]
          rotation: halfTurn
          scale [0.11, 0.17, 0.022]
          material: plainIvory
          group: torsoGroup
          parent: "torso"
          profile {
            kind: "Convex"
            vertices [[-0.55, -1], [-1, -0.35], [-0.85, 0.75], [-0.4, 1], [0.4, 1], [0.85, 0.75], [1, -0.35], [0.55, -1]]
            cornerRadius: 0.05
          }
          rounding: 0.012
        }
      }

      shape Prism "collar" {
        id: 20
        position [0, 1.585, -0.09]
        rotation: compose(halfTurn, [diagonal, 0, 0, diagonal])
        scale [0.1, 0.095, 0.03]
        material: brass
        group: torsoGroup
        parent: "torso"
        profile {
          kind: "Ellipse"
        }
        rounding: 0.005
      }

      shape Prism "collarOpening" {
        id: 21
        position [0, 1.585, -0.09]
        rotation [-diagonal, 0, 0, diagonal]
        scale [0.066, 0.065, 0.045]
        material: charcoal
        blend: "Subtraction"
        group: torsoGroup
        parent: "torso"
        profile {
          kind: "Ellipse"
        }
      }

      shape Cylinder "collarStud" {
        id: 22
        position [-0.035, 1.58, -0.185]
        rotation [-diagonal, 0, 0, diagonal]
        scale [0.011, 0.0025, 0.011]
        material: charcoal
        group: torsoGroup
        parent: "torso"
      }

      shape Superellipsoid "helmet" {
        id: 23
        position [0, 1.7603, 0.01575]
        rotation: halfTurn
        scale [0.2882, 0.3014, 0.2475]
        material: violet
        group: hoodGroup
        parent: "torso"
        exponent: softness
        // The head keeps to the facing whatever the hips do, and looks ahead into a turn.
        swings [
          swing("gait", [0, 1, 0], 0.08, [0, 1.5715, 0]) with { wave: "sine", phase: 0.3 }
          swing("heading", [0, 1, 0], -0.3, [0, 1.5715, 0]) with { wave: "sine" }
          swing("trail", [0, 1, 0], 0.07, [0, 1.5715, 0]) with { wave: "linear" }
          swing("cruise", [-1, 0, 0], -0.4, [0, 1.5715, 0]) with { wave: "constant", phase: 0 }
          // Over a ledge she looks up at the lip, then down over the top.
          swing("mantle", [-1, 0, 0], -0.35, [0, 1.5715, 0]) with { wave: "curve:mantle-look" }
        ]
      }

      // The hood's charcoal interior, the headroom round her face reading as its padded lining: the cut takes the
      // cutter's charcoal, and its rounded seam leaves no knife edge where it meets the face opening.
      shape Superellipsoid "helmetInner" {
        id: 24
        position [0, 1.7559, -0.009]
        scale [0.21, 0.224, 0.186]
        material: charcoal
        blend: "SmoothSubtraction"
        smooth: 0.02
        group: hoodGroup
        parent: "helmet"
        exponent: softness
      }

      shape Prism "helmetFaceOpening" {
        id: 25
        position [0, 1.7405, -0.2475]
        scale [0.2222, 0.24112, 0.23175]
        material: charcoal
        // A rounded cut, so the rim and the interior meet the opening without a knife edge the bake would tear.
        blend: "SmoothSubtraction"
        smooth: 0.02
        group: hoodGroup
        parent: "helmet"
        profile {
          kind: "Ellipse"
        }
      }

      shape Box "helmetThroatOpening" {
        id: 26
        position [0, 1.37, 0]
        scale [0.6, 0.197, 0.6]
        material: charcoal
        blend: "Subtraction"
        group: hoodGroup
        parent: "helmet"
      }

      // The ivory ear mounts; each one's lavender cover, brass ring and button are paint (`earPaints`).
      for (ear, k) in [{ side: "left", id: 51, x: -0.27544 }, { side: "right", id: 67, x: 0.27544 }] {
        shape Cylinder $"earMount-{ear.side}" {
          id: ear.id
          position [ear.x, 1.7295, 0.01575]
          rotation: compose(halfTurn, [0, 0, diagonal, diagonal])
          scale [0.09592, 0.01452, 0.09592]
          material: skin
          group: hoodGroup
          parent: "helmet"
        }
      }

      mothHead(headScale, headAt, "helmet", rust, leather, ivory, umber, jet, pearl, ink)

      // The braid roots under the lock beside her right cheek as one smooth tapering root, then plaits as three twisted
      // strands below her jaw and leaves through the hood's front opening to an ochre tie and a short tassel; it keeps its
      // full thickness whatever the head's scale.
      shape Sweep "braid-root-0" {
        id: 119
        position [0.1232, 1.695, -0.137]
        rotation: halfTurn
        material: ink
        group: hoodGroup
        parent: "helmet"
        curve {
          a [0, 0, 0]
          b [-0.012, -0.095, 0.012]
          c [-0.1144, -0.1371, -0.02]
          radiusStart: 0.011
          radiusEnd: 0.019
        }
      }

      for (plait, k) in [
        { name: "braid-root-1", id: 120, at [0.2376, 1.5579, -0.117], parent: "braid-root-0", b [-0.0044, -0.077, 0.0135], c [-0.0088, -0.154, 0.027] }
        { name: "braid-root-2", id: 121, at [0.2464, 1.4039, -0.144], parent: "braid-root-1", b [-0.0088, -0.0792, 0.009], c [-0.0176, -0.1584, 0.018] }
      ] {
        shape Sweep $"{plait.name}" {
          id: plait.id
          position: plait.at
          rotation: halfTurn
          material: ink
          group: hoodGroup
          parent: plait.parent
          curve {
            a [0, 0, 0]
            b: plait.b
            c: plait.c
            radiusStart: 0.011
            radiusEnd: 0.011
            strands: 3
            strandOffset: 0.011
            twist: 2
          }
        }
      }

      shape Cylinder "braidTie" {
        id: 146
        position [0.264, 1.2455, -0.162]
        rotation: halfTurn
        scale [0.028, 0.009, 0.028]
        material: brass
        group: hoodGroup
        parent: "braid-root-2"
        rounding: 0.003
      }

      shape Superellipsoid "braidTassel" {
        id: 147
        position [0.264, 1.2085, -0.162]
        rotation [0, 0, 0.0998334, 0.9950042]
        scale [0.02, 0.035, 0.016]
        material: ink
        group: hoodGroup
        parent: "braid-root-2"
        exponent: softness
      }

      mothLimbs("left", 0, scout)
      mothLimbs("right", 1, scout)

      drivers [
        // A gentle tread while the medium hold carries her shoulders at the surface.
        { name: "swim", signal: "time", cadence: 3.2, blendInSeconds: 0.3, blendOutSeconds: 0.2, when ["InMedium"] }
        // On a wall: the reach she holds, and the cycle her hands and feet plant on, one round every metre and a half
        // of travel along the face.
        {
          name: "cling"
          signal: "time"
          cadence: 1
          blendInSeconds: 0.15
          blendOutSeconds: 0.2
          when ["HoldingUnwalkable"]
        }
        { name: "climb", signal: "travel", cadence: 4.2, when ["HoldingUnwalkable", "moving"] }
        {
          name: "dash"
          signal: "state.dashPose.$body"
          cadence: 1
          blendInSeconds: 0
          blendOutSeconds: 0
          when ["always"]
        }
        // Her wrist panel's arm raise and flaps.
        for driver in wristPanelDrivers { driver }
        // Her pace in metres per second, the X every gait curve reads.
        {
          name: "pace"
          cadence: 1
          signal: "speed"
          dynamics: "gait-pace"
          when [
            "always"
          ]
        }
        // The one stride cycle her feet plant on and every gait driver below rides; its radians per metre fall as her
        // pace rises, so her stride lengthens and her step rate climbs more slowly than her speed.
        {
          name: "stride"
          cadence: 1
          signal: "planarTravel"
          cadenceBy {
            driver: "pace"
            curve: "moth-stride"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        // The stride swings, half their amplitude at a walk and whole at a run.
        {
          name: "gait"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-gait"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        // What only a run has: the forward lean and the bent elbows, and at twice the stride's rate, the bob.
        {
          name: "run"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "bob"
          cadence: 2
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "breath"
          cadence: 1.7
          signal: "time"
          when [
            "still"
          ]
        }
        {
          name: "flight"
          cadence: 1
          signal: "state.airPose.$body"
          when [
            "always"
          ]
        }
        {
          name: "wings"
          cadence: 1
          signal: "state.airWings.$body"
          when [
            "always"
          ]
        }
        {
          name: "bank"
          cadence: 0.26
          signal: "turnRate"
          when [
            "state.airPose.$body"
            "Airborne"
          ]
        }
        {
          name: "cruise"
          cadence: 0.18
          signal: "speed"
          when [
            "state.airPose.$body"
            "Airborne"
            "moving"
          ]
        }
        // Twice the travel direction off the facing: a sine of it peaks on the diagonals and vanishes on a pure
        // strafe or backpedal, and half of it, linear, is the direction itself.
        {
          name: "heading"
          cadence: 2
          signal: "travelDirection"
          blendInSeconds: 0.12
          blendOutSeconds: 0.3
          when [
            "Grounded"
            "moving"
          ]
        }
        // The turn rate through an underdamped response: a part swinging against it trails a turn, catches up a
        // beat after the turn stops and overshoots a little as it settles.
        {
          name: "trail"
          cadence: 1
          signal: "turnRate"
          dynamics: "body-turn"
          when [
            "always"
          ]
        }
        {
          name: "lean"
          cadence: 1
          signal: "lateralAcceleration"
          dynamics: "body-lean"
          when [
            "Grounded"
          ]
        }
        {
          name: "surge"
          cadence: 1
          signal: "forwardAcceleration"
          dynamics: "body-lean"
          when [
            "Grounded"
          ]
        }
        // Her vertical speed in metres per second, eased so the pose follows the arc without the frame's noise:
        // positive rising, zero at the peak, negative falling. It poses her only in the air.
        {
          name: "air"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-air"
          blendInSeconds: 0.06
          blendOutSeconds: 0.04
          when [
            "Airborne"
          ]
        }
        // The same speed through an underdamped response that lags it: touching down, it is still the fall's
        // speed and decays to rest through a small rebound, which is the crouch and the spring back up.
        {
          name: "land"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-land"
          blendInSeconds: 0
          blendOutSeconds: 0.08
          when [
            "Grounded"
          ]
        }
        // The pull over a ledge, keyed over the mantle's progress (moth.puck's `mantlePose` and its mantle curves): it
        // takes her hips, chest, head, arms and legs from every layer above while she mantles, and hands them back as
        // she steps out running.
        progressLayer(name: "mantle", row: "mantlePose")
      ]
      volumes: scout ? [] : mechExhaust
      effectors [
        {
          name: "foot-left"
          chain [
            "thigh-left"
            "shin-left"
          ]
          tip: "boot-left"
          // The sole stays flat on the ground however far the planted boot sits from its rest offset, so the boot
          // centre's rest height is the standoff that puts the whole sole on the surface.
          align: 1
          when [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [0, 3.1415925]
            // At rest the boot holds its spot and steps once its stance point drifts 9 cm: turning in place, or
            // settling into the stance after a stop.
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
        {
          name: "foot-right"
          chain [
            "thigh-right"
            "shin-right"
          ]
          tip: "boot-right"
          align: 1
          when [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [3.1415925, 6.28]
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
        // On a wall her palms and her toes find the face ahead of her. Each is planted for half of the climb's cycle
        // and reaches for the next spot in the other half: a hand and the opposite foot hold together, the foot an
        // eighth of a cycle behind its hand, so she moves one limb at a time. The wall feet solve after the ground
        // feet on the same legs and hold only on a face, where the ground feet's gate has let them go; standing at
        // a wall's foot with a hand on it, the wall feet win. A boot stays level with its toe on the face, its centre
        // the toe's length off it.
        for limb in [
          {
            name: "hand-left"
            chain ["upperArm-left", "forearm-left"]
            tip: "palm-left"
            reach: 0.75
            standoff: 0.04
            align: 0
            window [0, 3.1415925]
          }
          {
            name: "hand-right"
            chain ["upperArm-right", "forearm-right"]
            tip: "palm-right"
            reach: 0.75
            standoff: 0.04
            align: 0
            window [3.1415925, 6.28]
          }
          {
            name: "toe-right"
            chain ["thigh-right", "shin-right"]
            tip: "boot-right"
            reach: 0.7
            standoff: 0.22
            align: 1
            window [0.7853981, 3.9269906]
          }
          {
            name: "toe-left"
            chain ["thigh-left", "shin-left"]
            tip: "boot-left"
            reach: 0.7
            standoff: 0.22
            align: 1
            window [3.9269906, 0.7853981]
          }
        ] {
          {
            name: limb.name
            chain: limb.chain
            tip: limb.tip
            align: limb.align
            when [
              "HoldingUnwalkable"
            ]
            target {
              kind: "surface"
              direction [0, 0, -1]
              reach: limb.reach
              standoff: limb.standoff
            }
            plant {
              driver: "climb"
              window: limb.window
            }
          }
        }
      ]
    }
  }
}
}

// The mech suit: lavender and ivory, after the concept pack.
suitPrototype(id: "moth")

// The scout suit: bone plates over teal, the lighter frame with no flight in it.
suitPrototype(id: "moth-scout", ivoryPlate: "#E6DFCF", lavenderPlate: "#2E7A80", lavenderSeam: "#215C61", scout: true)
