  shape Sweep $"thigh-{side}" {
    id: 174 + isRight * 68
    position: mirrorX(isRight, [-0.135, 1.0265, 0])
    rotation: halfTurn
    material: charcoal
    group: thighGroup(isRight)
    parent: "pelvis"
    curve {
      a [0, 0, 0]
      b: mirrorX(isRight, [0.025, -0.135, 0])
      c: mirrorX(isRight, [0.05, -0.285, 0])
      radiusStart: 0.095
      radiusEnd: 0.095
    }
    // The stride swings in the plane of travel: the hip's own turn into the travel direction is undone, the plane
    // is turned to the full travel direction, the leg strides, and both turns are put back. A forward diagonal
    // strides straight ahead of the turned hips, a pure strafe abducts into a sidestep, and a backpedal strides
    // backward.
    swings [
      swing("heading", [0, 1, 0], 0.7, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "sine" }
      swing("heading", [0, 1, 0], -0.5, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear" }
      swing("gait", [-1, 0, 0], 0.7, mirrorX(isRight, [-0.145, 1.0265, 0])) with {
        wave: "sine"
        phase: bySide(isRight, 0, pi)
      }
      swing("heading", [0, 1, 0], 0.5, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear" }
      swing("heading", [0, 1, 0], -0.7, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "sine" }
      // In flight mode the hip undoes the air tuck the hover would hold at zero vertical speed (0.8 rad) and trails
      // the leg 0.1 rad back, so she hovers and flies with straight legs.
      swing("flight", [-1, 0, 0], 0.898, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear", phase: 0 }
      // In the air the thigh lifts 0.8 rad at the peak, 1.1 on the way up and 0.5 reaching for the ground.
      swing("air", [-1, 0, 0], -0.06, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear", phase: 13.3 }
      // Touching down at about 4 m/s the hip folds 0.4 rad into the crouch, and springs back as the give settles.
      swing("land", [-1, 0, 0], 0.1, mirrorX(isRight, [-0.145, 1.0265, 0])) with { wave: "linear" }
      // Over a ledge the knees tuck up under her; her left leg leads onto the top and her right pushes off it.
      swing("mantle", [-1, 0, 0], -1.5, mirrorX(isRight, [-0.145, 1.0265, 0])) with {
        wave: bySide(isRight, "curve:mantle-tuck-lead", "curve:mantle-tuck-trail")
      }
    ]
  }

