  shape Sweep $"thumb-{side}" {
    id: 171 + isRight * 68
    position: mirrorX(isRight, [-0.3312, 0.7959, -0.086])
    rotation: compose(halfTurn, mirrorRotation(isRight, [-0.130367, 0.388295, -0.137633, 0.901825]))
    material: charcoal
