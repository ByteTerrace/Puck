          intensity: 330000
          extinction: 1.2
          pulseAmplitude: 0.06
          pulseFrequency: 18
          intensityLane: 3
          ramp [
            {
              density: 0
              color: "#134D8B"
            }
            {
              density: 0.3
              color: "#238EDB"
            }
            {
              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
      ]
      effectors [
        {
          name: "foot-left"
          chain [
            "thigh-left"
            "shin-left"
          ]
          tip: "boot-left"
          // The sole stays flat on the ground however far the planted boot sits from its rest offset, so the boot
          // centre's rest height is the standoff that puts the whole sole on the surface.
          align: 1
          when [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [0, 3.1415925]
            // At rest the boot holds its spot and steps once its stance point drifts 9 cm: turning in place, or
            // settling into the stance after a stop.
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
        {
          name: "foot-right"
          chain [
            "thigh-right"
            "shin-right"
          ]
          tip: "boot-right"
          align: 1
          when [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [3.1415925, 6.28]
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
        // On a wall her palms and her toes find the face ahead of her. Each is planted for half of the climb's cycle
        // and reaches for the next spot in the other half: a hand and the opposite foot hold together, the foot an
        // eighth of a cycle behind its hand, so she moves one limb at a time. The wall feet solve after the ground
        // feet on the same legs and hold only on a face, where the ground feet's gate has let them go; standing at
        // a wall's foot with a hand on it, the wall feet win. A boot stays level with its toe on the face, its centre
        // the toe's length off it.
        for limb in [
          {
            name: "hand-left"
            chain ["upperArm-left", "forearm-left"]
            tip: "palm-left"
            reach: 0.75
            standoff: 0.04
            align: 0
            window [0, 3.1415925]
          }
          {
            name: "hand-right"
            chain ["upperArm-right", "forearm-right"]
            tip: "palm-right"
            reach: 0.75
            standoff: 0.04
            align: 0
            window [3.1415925, 6.28]
          }
          {
            name: "toe-right"
            chain ["thigh-right", "shin-right"]
            tip: "boot-right"
            reach: 0.7
            standoff: 0.22
            align: 1
            window [0.7853981, 3.9269906]
          }
          {
            name: "toe-left"
            chain ["thigh-left", "shin-left"]
            tip: "boot-left"
            reach: 0.7
            standoff: 0.22
            align: 1
            window [3.9269906, 0.7853981]
          }
        ] {
          {
            name: limb.name
            chain: limb.chain
            tip: limb.tip
            align: limb.align
            when [
              "HoldingUnwalkable"
            ]
            target {
              kind: "surface"
              direction [0, 0, -1]
              reach: limb.reach
              standoff: limb.standoff
            }
            plant {
              driver: "climb"
              window: limb.window
            }
          }
        }
      ]
    }
  }
}
}

// The mech suit: lavender and ivory, after the concept pack.
suitPrototype(id: "moth")

// The scout suit: bone plates over teal, the frame with no flight in it.
suitPrototype(id: "moth-scout", ivoryPlate: "#E6DFCF", lavenderPlate: "#2E7A80", lavenderSeam: "#215C61")
