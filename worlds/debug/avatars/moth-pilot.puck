      shape Prism "brickLens" {
        id: 249
        position [0, 1.201, -0.0189]
        scale [0.0285, 0.0245, 0.0006]
        material: brickLens
        parent: "handheld"
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.16
        }
      }

      // The screen's picture on the lens, the device's own glass: 160 by 144 pixels at 0.275 mm, 44 by 39.6 mm, its face
      // 1 mm proud of the lens. While she holds the brick its screen row's `carry` names this box, so it shows the live
      // game (devices.puck).
      shape Box "brickPicture" {
        id: 257
        position [0, 1.201, -0.0195]
        scale [0.022, 0.0198, 0.001]
