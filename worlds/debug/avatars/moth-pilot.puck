// The Moth out of her suit: the 1.68 m pilot of the concept pack's off-suit turnaround (sheet 04), a grounded, athletic
// working woman in a charcoal undersuit with full sleeves, straight-cut work trousers, soft knee and elbow pads, a
// contact harness, lavender shoulder patches and flat ankle boots, her hands bare. Her head is the suited Moth's own
// (the moth-head library at the same 0.68 scale), so one head model serves both forms.
//
// suit.puck wears her through the `moth-pilot` look when the body's suit register is 0. Every coordinate is in the author
// frame (+Y up, +Z her front, +X her left), with her soles at Y = 0. A template's `side` is 1 for her left and -1 for
// her right: it mirrors X, the Y and Z of a rotation's vector part, and the sign of a swing about a sideways-tilting axis.
//
// She rides the suited Moth's drivers and dynamics; her stride curve (`pilot-stride`) is her own, scaled to her 0.85 m
// hip. While `pilotHold` holds 1 for her body, the `hold` driver bends her arms in front of her and the `hold` frame
// seats the handheld (75 x 133 x 27.5 mm) in her hands.

import "moth-head"

// What an importer binds: the creation its look wears, and the cell its look's hold pose reads, which the importer's
// rules write.
exports {
  reads [$"moth-pilot", pilotHold]
  actions [pilotHold]
}

let pilotHeadScale = 0.68
// Her eyes sit 1.527 m up: the suited Moth's eye line less the 0.208 m footbed of sheet 05.
let pilotHeadAt = [0, 1.527, 0.095]

let pilotSoftness = 2.2
// The plait's lobes down her braid's core, alternating either side of it, and the half-angle each leans by.
let braidLobes = [
  [-0.112, 1.335, 0.0904]
  [-0.1278, 1.313, 0.0951]
  [-0.102, 1.291, 0.0994]
  [-0.1187, 1.269, 0.1032]
  [-0.0938, 1.247, 0.1065]
  [-0.1113, 1.225, 0.1094]
  [-0.089, 1.203, 0.1104]
  [-0.1095, 1.181, 0.1107]
  [-0.0881, 1.159, 0.1106]
  [-0.1088, 1.137, 0.1102]
  [-0.0876, 1.115, 0.1095]
]
let braidTwist = 0.247404
let braidUntwist = 0.9689124
let diagonal = 0.7071068

// Her joints on her left side, each a swing pivot: hip (0.09, 0.86, 0), knee (0.1, 0.475, 0.012), ankle
// (0.105, 0.085, -0.005), shoulder (0.172, 1.355, -0.015), elbow (0.212, 1.068, -0.032); her spine turns about
// (0, 0.96, 0) and her neck about (0, 1.36, -0.005).

// The stride's radians per metre, π(1.5 + 0.6v)/v: 1.8 steps a second and 0.28 m steps at 0.5 m/s, 4.5 and 1.1 m at
// 5 m/s, the suited Moth's rate scaled by her 1.03 m hip over this 0.85 m one.
curves [
  {
    name: "pilot-stride"
    knots [
      { position [0.5, 0, 11.30973], tangentYaw: -1.517794, curvature: 0.011211 }
      { position [0.75, 0, 8.16814], tangentYaw: -1.451992, curvature: 0.037198 }
      { position [1, 0, 6.59734], tangentYaw: -1.361692, curvature: 0.084305 }
      { position [1.5, 0, 5.02655], tangentYaw: -1.125339, curvature: 0.223377 }
      { position [2, 0, 4.24115], tangentYaw: -0.866984, curvature: 0.319267 }
      { position [2.5, 0, 3.76991], tangentYaw: -0.646045, curvature: 0.307064 }
      { position [3, 0, 3.45575], tangentYaw: -0.482348, curvature: 0.242702 }
      { position [4, 0, 3.06305], tangentYaw: -0.286426, curvature: 0.129987 }
      { position [5, 0, 2.82743], tangentYaw: -0.18631, curvature: 0.071551 }
    ]
  }
]

state {
  world {
    // 1 while her body holds the handheld up in front of her: `world.state.cell.set pilotHold 0 1`.
    table pilotHold {
      "0" = 0
    }
  }
}

let undersuit = 0 // charcoal undersuit: torso and sleeves, with the harness straps and lavender shoulder patches painted
let trousers = 1 // charcoal work trousers, with the knee pads' straps painted
let skin = 2 // #B76B3C her skin
let hair = 3 // #171210 hair, lids and brows
let eyeWhite = 4 // #FFF8E9 the eyes' whites
let lip = 5 // #754137 the nostrils
let iris = 6 // #89481D
let pupil = 7 // #120D13
let glint = 8 // #FFF8EF catchlights
let pad = 9 // soft rubber knee and elbow pads
let leather = 10 // flat ankle boots
let sole = 11 // boot soles
let belt = 12 // the belt
let ochre = 13 // the belt buckle, harness plate and braid tie
let collarKnit = 14 // the undersuit's high collar
let strap = 15 // the harness's front straps, with their ochre buckles painted
let brickGlass = 16 // the Humble Gaming Brick's see-through atomic-orange shell, the devices' own glass
let sleeve = 17 // the undersuit's sleeves, with the lavender shoulder patches painted
let brickLens = 18 // the brick's dark screen lens and its picture's box
let brickKeys = 19 // the d-pad and the speaker's slots
let brickButtons = 20 // the smoked A and B buttons
let brickRubber = 21 // select and start
let brickBoard = 22 // the pale green board under the face
let brickChip = 23 // the processor
let brickCartridge = 24 // the cartridge down its slot
let brickCell = 25 // the two AA cells in the battery bay
let brickLed = 26 // the red power light

// Authored darker than the sheet reads: the studio's light lifts a charcoal about half again, as it lifts the suit's
// lavender #744080 to the owner's dusty #B186B6.
let fabric = "#1C1D21"
let padStrap = "#151519"
let strapGrey = "#3A3C44"
let patchLavender = "#8C6A94"
let ochreTone = "#C98F35"

// One arm: sleeve, shoulder patch, elbow pad, cuff and the bare hand with its four fingers and thumb. Its upper arm
// swings at the shoulder and its forearm at the elbow, on the suited Moth's drivers; `hold` brings both forward and in.
template pilotArm(name, side, baseId, handGroup) {
  shape Sweep $"upperArm-{name}" {
    id: baseId
    position [side * 0.172, 1.355, -0.015]
    material: sleeve
    parent: "torso"
    curve {
      a [0, 0, 0]
      b [side * 0.02, -0.14, -0.01]
      c [side * 0.04, -0.287, -0.017]
      radiusStart: 0.05
      radiusEnd: 0.04
      bulge: 0.005
    }
    swings [
      {
        driver: "run"
        axis [0, 0, 1]
        amplitude: -0.06 * side
        pivot [side * 0.172, 1.355, -0.015]
        wave: "constant"
      }
      {
        driver: "gait"
        axis [0.990, side * 0.138, 0]
        amplitude: 0.5
        pivot [side * 0.172, 1.355, -0.015]
        wave: "sine"
        phase: 3.1415927 * (1 + side) / 2
      }
      // The arms open 0.45 rad from the sides at the jump's peak, 0.6 on the way up and 0.3 coming down.
      {
        driver: "air"
        axis [0, 0, 1]
        amplitude: 0.03 * side
        pivot [side * 0.172, 1.355, -0.015]
        wave: "linear"
        phase: 15
      }
      {
        driver: "air"
        axis [0.990, side * 0.138, 0]
        amplitude: -0.015
        pivot [side * 0.172, 1.355, -0.015]
        wave: "linear"
        phase: 8
      }
      // Holding the handheld: the upper arm forward a little and turned in, so the bent forearm points to her middle.
      {
        driver: "hold"
        axis [1, 0, 0]
        amplitude: -0.25
        pivot [side * 0.172, 1.355, -0.015]
        wave: "constant"
      }
      {
        driver: "hold"
        axis [0, 1, 0]
        amplitude: -0.5 * side
        pivot [side * 0.172, 1.355, -0.015]
        wave: "constant"
      }
    ]
  }

  // The deltoid under the sleeve; the lavender patch over it is paint.
  shape Superellipsoid $"deltoid-{name}" {
    id: baseId + 1
    position [side * 0.182, 1.325, -0.016]
    scale [0.05, 0.066, 0.056]
    material: sleeve
    parent: $"upperArm-{name}"
    exponent: pilotSoftness
  }

  shape Sweep $"forearm-{name}" {
    id: baseId + 2
    position [side * 0.212, 1.068, -0.032]
    material: sleeve
    parent: $"upperArm-{name}"
    curve {
      a [0, 0, 0]
      b [side * 0.005, -0.115, 0.008]
      c [side * 0.01, -0.233, 0.022]
      radiusStart: 0.041
      radiusEnd: 0.03
      bulge: 0.005
    }
    swings [
      {
        driver: "run"
        axis [1, 0, 0]
        amplitude: -1.1
        pivot [side * 0.212, 1.068, -0.032]
        wave: "constant"
      }
      {
        driver: "gait"
        axis [1, 0, 0]
        amplitude: 0.18
        pivot [side * 0.212, 1.068, -0.032]
        wave: "sine"
        phase: 0.5 + 3.1415927 * (1 + side) / 2
      }
      // The elbows bend 0.36 rad at the jump's peak, 0.51 rising and 0.21 falling, and a little further on landing.
      {
        driver: "air"
        axis [1, 0, 0]
        amplitude: -0.03
        pivot [side * 0.212, 1.068, -0.032]
        wave: "linear"
        phase: 12
      }
      {
        driver: "land"
        axis [1, 0, 0]
        amplitude: 0.05
        pivot [side * 0.212, 1.068, -0.032]
        wave: "linear"
      }
      // Holding: the forearm turns a little palm-up, then the elbow bends, so the palms face each other in front of
      // her chest with the thumbs up, 11 cm apart round the handheld's 75 mm. Swings compose in list order, then the
      // parent's delta.
      {
        driver: "hold"
        axis [0, 1, 0]
        amplitude: 0.15 * side
        pivot [side * 0.212, 1.068, -0.032]
        wave: "constant"
      }
      {
        driver: "hold"
        axis [1, 0, 0]
        amplitude: -1.5
        pivot [side * 0.212, 1.068, -0.032]
        wave: "constant"
      }
    ]
  }

  shape Superellipsoid $"elbowPad-{name}" {
    id: baseId + 3
    position [side * 0.218, 1.062, -0.066]
    scale [0.04, 0.05, 0.022]
    material: pad
    parent: $"forearm-{name}"
    exponent: 2.6
  }

  shape Superellipsoid $"cuff-{name}" {
    id: baseId + 4
    position [side * 0.222, 0.846, -0.01]
    scale [0.033, 0.013, 0.033]
    material: collarKnit
    parent: $"forearm-{name}"
    exponent: 2.4
  }

  // The bare hand hangs palm in, its fingers curling a little toward the palm.
  shape Sweep $"wrist-{name}" {
    id: baseId + 5
    position [side * 0.222, 0.845, -0.01]
    material: skin
    group: handGroup
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * 0.001, -0.02, 0.002]
      c [side * 0.002, -0.04, 0.004]
      radiusStart: 0.024
      radiusEnd: 0.023
    }
  }

  shape Superellipsoid $"palm-{name}" {
    id: baseId + 6
    position [side * 0.224, 0.777, -0.006]
    scale [0.017, 0.05, 0.041]
    material: skin
    blend: "SmoothUnion"
    smooth: 0.01
    group: handGroup
    parent: $"forearm-{name}"
    exponent: 2.6
  }

  shape Sweep $"thumb-{name}" {
    id: baseId + 7
    position [side * 0.214, 0.79, 0.022]
    material: skin
    blend: "SmoothUnion"
    smooth: 0.006
    group: handGroup
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * -0.014, -0.024, 0.016]
      c [side * -0.02, -0.052, 0.012]
      radiusStart: 0.0105
      radiusEnd: 0.0085
    }
  }

  shape Sweep $"finger-{name}-0" {
    id: baseId + 8
    position [side * 0.222, 0.735, 0.024]
    material: skin
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * -0.002, -0.038, 0.002]
      c [side * -0.014, -0.068, 0.004]
      radiusStart: 0.0082
      radiusEnd: 0.0068
    }
  }

  shape Sweep $"finger-{name}-1" {
    id: baseId + 9
    position [side * 0.222, 0.735, 0.0035]
    material: skin
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * -0.002, -0.042, 0]
      c [side * -0.016, -0.076, 0]
      radiusStart: 0.0084
      radiusEnd: 0.007
    }
  }

  shape Sweep $"finger-{name}-2" {
    id: baseId + 10
    position [side * 0.222, 0.735, -0.0165]
    material: skin
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * -0.002, -0.04, -0.001]
      c [side * -0.015, -0.071, -0.003]
      radiusStart: 0.008
      radiusEnd: 0.0066
    }
  }

  shape Sweep $"finger-{name}-3" {
    id: baseId + 11
    position [side * 0.222, 0.737, -0.036]
    material: skin
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * -0.002, -0.031, -0.002]
      c [side * -0.012, -0.056, -0.006]
      radiusStart: 0.007
      radiusEnd: 0.0058
    }
  }
}

// One leg: the trouser thigh and shin, the knee pad and the flat ankle boot. The thigh's stride swings sit between
// the yaw swings that turn the stride plane to the travel direction, as the suited Moth's do; the boot is the foot
// effector's tip, its origin on the sole's top so the standoff is its rest height.
template pilotLeg(name, side, baseId) {
  shape Sweep $"thigh-{name}" {
    id: baseId
    position [side * 0.088, 0.92, 0]
    material: trousers
    parent: "pelvis"
    curve {
      a [0, 0, 0]
      b [side * 0.008, -0.222, 0.018]
      c [side * 0.012, -0.445, 0.012]
      radiusStart: 0.088
      radiusEnd: 0.06
      bulge: 0.004
    }
    swings [
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: 0.7
        pivot [side * 0.09, 0.86, 0]
        wave: "sine"
      }
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: -0.5
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
      }
      {
        driver: "gait"
        axis [1, 0, 0]
        amplitude: 0.7
        pivot [side * 0.09, 0.86, 0]
        wave: "sine"
        phase: 3.1415927 * (1 - side) / 2
      }
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: 0.5
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
      }
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: -0.7
        pivot [side * 0.09, 0.86, 0]
        wave: "sine"
      }
      // In the air the thigh lifts 0.8 rad at the peak, 1.1 on the way up and 0.5 reaching for the ground.
      {
        driver: "air"
        axis [1, 0, 0]
        amplitude: -0.06
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
        phase: 13.3
      }
      // Touching down at about 4 m/s the hip folds 0.4 rad into the crouch, and springs back as the give settles.
      {
        driver: "land"
        axis [1, 0, 0]
        amplitude: 0.1
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
      }
    ]
  }

  shape Sweep $"shin-{name}" {
    id: baseId + 1
    position [side * 0.1, 0.475, 0.012]
    material: trousers
    parent: $"thigh-{name}"
    curve {
      a [0, 0, 0]
      b [side * 0.003, -0.13, -0.008]
      c [side * 0.005, -0.265, -0.018]
      radiusStart: 0.058
      radiusEnd: 0.063
    }
    swings [
      {
        driver: "gait"
        axis [1, 0, 0]
        amplitude: 1.25
        pivot [side * 0.1, 0.475, 0.012]
        wave: "halfSine"
        phase: 2.0424 + 3.1415927 * (1 + side) / 2
      }
      // The knee folds 1.2 rad at the peak, 1.45 rising and 0.95 falling, and takes twice the hip's fold on landing.
      {
        driver: "air"
        axis [1, 0, 0]
        amplitude: 0.05
        pivot [side * 0.1, 0.475, 0.012]
        wave: "linear"
        phase: 24
      }
      {
        driver: "land"
        axis [1, 0, 0]
        amplitude: -0.2
        pivot [side * 0.1, 0.475, 0.012]
        wave: "linear"
      }
    ]
  }

  shape Prism $"kneePad-{name}" {
    id: baseId + 2
    position [side * 0.1, 0.468, 0.07]
    scale [0.054, 0.07, 0.017]
    material: pad
    parent: $"shin-{name}"
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.65
    }
    rounding: 0.01
  }

  shape Prism $"boot-{name}" {
    id: baseId + 3
    position [side * 0.105, 0.025, 0.04]
    rotation [0, -diagonal, 0, diagonal]
    scale [0.13, 0.13, 0.055]
    material: leather
    parent: $"shin-{name}"
    profile {
      kind: "Convex"
      cornerRadius: 0.12
      vertices [[-1, 0], [-1, 0.62], [-0.4, 0.78], [0.35, 0.55], [0.78, 0.41], [1, 0.24], [1, 0]]
    }
    swings [
      {
        driver: "gait"
        pivot [side * 0.105, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: 0.2
        phase: 3.1415927 * (1 - side) / 2
        wave: "sine"
      }
      {
        driver: "gait"
        pivot [side * 0.105, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: -0.25
        phase: 2.0424 + 3.1415927 * (1 + side) / 2
        wave: "halfSine"
      }
      {
        driver: "air"
        pivot [side * 0.105, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: 0.02
        phase: 12.5
        wave: "linear"
      }
      {
        driver: "land"
        pivot [side * 0.105, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: 0.1
        wave: "linear"
      }
    ]
  }

  shape Superellipsoid $"bootShaft-{name}" {
    id: baseId + 4
    position [side * 0.105, 0.12, -0.008]
    scale [0.058, 0.09, 0.066]
    material: leather
    parent: $"boot-{name}"
    exponent: 3
  }

  shape Prism $"sole-{name}" {
    id: baseId + 5
    position [side * 0.105, 0.0125, 0.04]
    rotation [diagonal, 0, 0, diagonal]
    scale [0.054, 0.135, 0.0125]
    material: sole
    parent: $"boot-{name}"
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.7
    }
  }
}

prototypes {
  prototype "moth-pilot" {
    document {
      schema: "puck.creation.v1"
      name: "moth-pilot"
      frames [
        // Holding: the handheld leaves its rest inside her chest for her hands, its screen toward her eyes. A frame poses
        // each shape it names, not the shapes riding it, so every part of the brick is posed with the shell: its rest
        // offset from the shell's centre turned by the shell's 30 degrees and added to the shell's held place.
        {
          name: "hold"
          transforms [
            { id: 230, position [0, 1.2, 0.3378], rotation [0.2588, 0, 0, 0.9659] }
            { id: 243, position [0, 1.16238, 0.33196], rotation [0.2588, 0, 0, 0.9659] }
            { id: 244, position [0, 1.19594, 0.33084], rotation [0.2588, 0, 0, 0.9659] }
            { id: 245, position [0.002, 1.18528, 0.3233], rotation [0.2588, 0, 0, 0.9659] }
            { id: 246, position [0, 1.24241, 0.36834], rotation [0.2588, 0, 0, 0.9659] }
            { id: 247, position [0, 1.17584, 0.33165], rotation [0.183, -0.183, 0.68299, 0.68299] }
            { id: 248, position [0, 1.16199, 0.32365], rotation [0.183, -0.183, 0.68299, 0.68299] }
            { id: 249, position [0, 1.23267, 0.34321], rotation [0.2588, 0, 0, 0.9659] }
            { id: 257, position [0, 1.23297, 0.34269], rotation [0.2588, 0, 0, 0.9659] }
            { id: 250, position [0.0335, 1.24479, 0.35021], rotation [0.2588, 0, 0, 0.9659] }
            { id: 251, position [0.0215, 1.18394, 0.31462], rotation [0.2588, 0, 0, 0.9659] }
            { id: 252, position [0.0215, 1.18394, 0.31462], rotation [0.2588, 0, 0, 0.9659] }
            { id: 253, position [-0.0262, 1.18812, 0.31738], rotation [0.2588, 0, 0, 0.9659] }
            { id: 254, position [-0.0132, 1.18137, 0.31348], rotation [0.2588, 0, 0, 0.9659] }
            { id: 255, position [0.0085, 1.16556, 0.30446], rotation [0.25267, -0.056, 0.20902, 0.94301] }
            { id: 256, position [-0.0085, 1.16556, 0.30446], rotation [0.25267, -0.056, 0.20902, 0.94301] }
          ]
        }
        // The blink seats each closed lid over its eye and parks the open eye's pieces behind the face.
        {
          name: "blink"
          transforms: map(
            mothBlinkPose,
            row => {
              id: row[0]
              position: map(
                [row[1], row[2], row[3]],
                (v, k) => pilotHeadAt[k] + (v - mothHeadPivot[k]) * pilotHeadScale
              )
              rotation [0, 0, 0, 1]
            }
          )
        }
      ]
      palette [
        // The undersuit: the harness straps over her shoulders and across her back, and the lavender patches where
        // her shoulders meet her sleeves, are paint. A paint is placed in its parent shape's own frame: the torso's
        // origin is (0, 1.205, -0.008).
        {
          color: fabric
          roughness: 0.82
          specular: 0.03
          sheen: 0.25
          paints [
            {
              parent: "torso"
              type: "Box"
              position [0.068, 0.18, -0.027]
              scale [0.016, 0.05, 0.07]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [-0.068, 0.18, -0.027]
              scale [0.016, 0.05, 0.07]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [0.045, 0.105, -0.122]
              rotation [0, 0, -0.2588, 0.9659]
              scale [0.016, 0.085, 0.1]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [-0.045, 0.105, -0.122]
              rotation [0, 0, 0.2588, 0.9659]
              scale [0.016, 0.085, 0.1]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [0.045, -0.075, -0.112]
