      drivers [
        // Her pace in metres per second, the X every gait curve reads.
        { name: "pace", cadence: 1, signal: "speed", dynamics: "gait-pace", when ["always"] }
        // The one stride cycle her feet plant on and every gait driver rides, its length opening with her pace.
        {
          name: "stride"
          cadence: 1
          signal: "planarTravel"
          cadenceBy { driver: "pace", curve: "pilot-stride" }
          when ["Grounded", "moving"]
        }
        // The stride swings, half their amplitude at a walk and whole at a run.
        {
          name: "gait"
          cadence: 1
          signal: "driver.stride"
          weightBy { driver: "pace", curve: "moth-gait" }
          when ["Grounded", "moving"]
        }
        // What only a run has: the forward lean and the bent elbows, and at twice the stride's rate, the bob.
        {
          name: "run"
          cadence: 1
          signal: "driver.stride"
          weightBy { driver: "pace", curve: "moth-run" }
          when ["Grounded", "moving"]
        }
        {
          name: "bob"
          cadence: 2
          signal: "driver.stride"
          weightBy { driver: "pace", curve: "moth-run" }
          when ["Grounded", "moving"]
        }
        { name: "breath", cadence: 1.7, signal: "time", when ["still"] }
        // Twice the travel direction off the facing: a sine of it peaks on the diagonals and vanishes on a pure
        // strafe or backpedal, and half of it, linear, is the direction itself.
        {
          name: "heading"
          cadence: 2
          signal: "travelDirection"
          blendInSeconds: 0.12
          blendOutSeconds: 0.3
          when ["Grounded", "moving"]
        }
        { name: "trail", cadence: 1, signal: "turnRate", dynamics: "body-turn", when ["always"] }
        { name: "lean", cadence: 1, signal: "lateralAcceleration", dynamics: "body-lean", when ["Grounded"] }
        { name: "surge", cadence: 1, signal: "forwardAcceleration", dynamics: "body-lean", when ["Grounded"] }
        // Her vertical speed, eased: it poses her in the air, tucked rising and reaching for the ground falling.
        {
          name: "air"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-air"
          blendInSeconds: 0.06
          blendOutSeconds: 0.04
          when ["Airborne"]
        }
        // The same speed through an underdamped response that lags it: the landing's crouch and spring back up.
        {
          name: "land"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-land"
          blendInSeconds: 0
          blendOutSeconds: 0.08
          when ["Grounded"]
        }
        // Her arms come up to hold the handheld while her body's pilotHold cell is set.
        {
          name: "hold"
          cadence: 1
          signal: "time"
          blendInSeconds: 0.2
          blendOutSeconds: 0.2
          when ["state.pilotHold.$body"]
        }
      ]

      effectors [
        {
          name: "foot-left"
          chain ["thigh-left", "shin-left"]
          tip: "boot-left"
          // The sole stays flat on the ground however far the planted boot sits from its rest offset.
          align: 1
          when ["Grounded"]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.35
            standoff: 0.025
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [0, 3.1415925]
            // At rest the boot holds its spot and steps once its stance point drifts 8 cm.
            replant {
              distance: 0.08
              seconds: 0.2
              height: 0.06
            }
          }
        }
        {
          name: "foot-right"
          chain ["thigh-right", "shin-right"]
          tip: "boot-right"
          align: 1
          when ["Grounded"]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.35
            standoff: 0.025
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [3.1415925, 6.28]
            replant {
              distance: 0.08
              seconds: 0.2
              height: 0.06
            }
          }
        }
      ]
    }
  }
}
