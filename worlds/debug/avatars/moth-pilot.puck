// The Moth out of her suit: the 1.68 m pilot of the concept pack's off-suit turnaround (sheet 04), a grounded, athletic
// working woman in a charcoal undersuit with full sleeves, straight-cut work trousers, soft knee and elbow pads, a
// contact harness, lavender shoulder patches, work gloves and ankle boots. Her head is the suited Moth's own (the
// moth-head library at the same 0.68 scale), so one head model serves both forms; the volume of her hair out of the
// hood is her own.
//
// suit.puck wears her through the `moth-pilot` look when the body's suit register is 0. Every coordinate is in the author
// frame (+Y up, +Z her front, +X her left), with her soles at Y = 0. A template's `side` is 1 for her left and -1 for
// her right: it mirrors X, the Y and Z of a rotation's vector part, and the sign of a swing about a sideways-tilting axis.
//
// She rides the suited Moth's drivers and dynamics; her stride curve (`pilot-stride`) is her own, scaled to her 0.85 m
// hip. While `pilotHold` holds 1 for her body, the `hold` driver bends her arms in front of her and the `hold` frame
// seats the handheld (75 x 133 x 27.5 mm) in her hands.

import "moth-head"
import "../../standard/turns"

// What an importer binds: the creation its look wears, and the cell its look's hold pose reads, which the importer's
// rules write.
exports {
  reads [$"moth-pilot", pilotHold]
  actions [pilotHold]
}

let pilotHeadScale = 0.68
// Her eyes sit 1.527 m up: the suited Moth's eye line less the 0.208 m footbed of sheet 05.
let pilotHeadAt = [0, 1.527, 0.095]

let pilotSoftness = 2.2

// Her hair's locks over the head library's scalp, each [name, id, root, control, end, root radius, end radius] in its
// unscaled frame (mothHairLock).
let pilotHairLocks = [
  ["hairSwoop", 90, [-0.08, 1.93, 0.15], [0.12, 0.06, -0.01], [0.27, -0.07, -0.1], 0.046, 0.02]
  ["hairCrown", 97, [0.0, 1.95, 0.11], [0.0, 0.035, -0.25], [-0.01, -0.31, -0.16], 0.062, 0.026]
  ["hairCrown-left", 95, [0.085, 1.935, 0.08], [0.04, 0.0, -0.24], [-0.04, -0.33, -0.12], 0.058, 0.024]
  ["hairCrown-right", 96, [-0.075, 1.93, 0.07], [-0.04, 0.0, -0.24], [0.015, -0.32, -0.11], 0.058, 0.024]
  ["hairFall-left", 92, [0.16, 1.86, 0.085], [0.045, -0.11, -0.01], [0.02, -0.25, -0.05], 0.046, 0.016]
  ["hairFallBack-left", 93, [0.14, 1.84, -0.02], [0.06, -0.1, -0.02], [0.03, -0.24, -0.02], 0.05, 0.018]
  ["hairSweep-right", 94, [-0.13, 1.9, 0.09], [-0.06, -0.1, -0.03], [-0.045, -0.21, -0.01], 0.042, 0.02]
]

// The braid's core, a quadratic from its root beside her right cheek, bowed out over her collarbone, to its tie; the
// plait's lobes sit along it, alternating either side and leaning `braidLean` either way.
let braidRoot = [-0.124, 1.47, 0.04]
let braidBend = [-0.165, 1.33, 0.13]
let braidEnd = [-0.098, 1.1, 0.112]
let braidLean = 0.25
function braidAt(t) = map(
  [0, 1, 2],
  k => (1 - t) * (1 - t) * braidRoot[k] + 2 * (1 - t) * t * braidBend[k] + t * t * braidEnd[k]
)
let diagonal = 0.7071068

// Her joints on her left side, each a swing pivot: hip (0.09, 0.86, 0), knee (0.106, 0.475, 0.012), ankle
// (0.115, 0.085, -0.005), shoulder (0.172, 1.355, -0.015), elbow (0.212, 1.068, -0.032); her spine turns about
// (0, 0.96, 0) and her neck about (0, 1.36, -0.005).

// Her arms rest in sheet 04's slight A: each forearm swings out `elbowRestSpread` about the elbow's forward axis, then
// bends `elbowRestBend` forward about its sideways one. `forearmRest(side)` is that turn and `rested(p, side)` carries a
// point measured on the straight forearm into it; the hold pose's first two forearm swings undo the bend and then the
// swing out, the reverse order, so the pose turns the straight arm.
let elbowRestBend = 0.25
let elbowRestSpread = 0.2
function elbowAt(side) = [side * 0.212, 1.068, -0.032]
function forearmRest(side) = turnThen(turnAbout([0, 0, 1], side * elbowRestSpread), turnAbout([1, 0, 0], 0 - elbowRestBend))
function rested(p, side) = turnPoint(forearmRest(side), p, elbowAt(side))

// The glove's fingers, index to little, each [root height, root depth, length, tip's depth from the root, root
// radius], measured on the straight hand.
let gloveFingers = [
  [0.733, 0.031, 0.068, 0.017, 0.0115]
  [0.731, 0.011, 0.075, 0.009, 0.0118]
  [0.731, -0.011, 0.071, -0.01, 0.0113]
  [0.735, -0.031, 0.057, -0.017, 0.0102]
]

// The stride's radians per metre, π(1.5 + 0.6v)/v: 1.8 steps a second and 0.28 m steps at 0.5 m/s, 4.5 and 1.1 m at
// 5 m/s, the suited Moth's rate scaled by her 1.03 m hip over this 0.85 m one.
curves [
  {
    name: "pilot-stride"
    knots [
      { position [0.5, 0, 11.30973], tangentYaw: -1.517794, curvature: 0.011211 }
      { position [0.75, 0, 8.16814], tangentYaw: -1.451992, curvature: 0.037198 }
      { position [1, 0, 6.59734], tangentYaw: -1.361692, curvature: 0.084305 }
      { position [1.5, 0, 5.02655], tangentYaw: -1.125339, curvature: 0.223377 }
      { position [2, 0, 4.24115], tangentYaw: -0.866984, curvature: 0.319267 }
      { position [2.5, 0, 3.76991], tangentYaw: -0.646045, curvature: 0.307064 }
      { position [3, 0, 3.45575], tangentYaw: -0.482348, curvature: 0.242702 }
      { position [4, 0, 3.06305], tangentYaw: -0.286426, curvature: 0.129987 }
      { position [5, 0, 2.82743], tangentYaw: -0.18631, curvature: 0.071551 }
    ]
  }
]

state {
  world {
    // 1 while her body holds the handheld up in front of her: `world.state.cell.set pilotHold 0 1`.
    table pilotHold capacity(1) {
      "0" = 0
    }
  }
}

let undersuit = 0 // charcoal undersuit: torso and sleeves, with the harness straps and lavender shoulder patches painted
let trousers = 1 // charcoal work trousers, with the knee pads' straps painted
let skin = 2 // #B76B3C her skin
let hair = 3 // #171210 hair, lids and brows
let eyeWhite = 4 // #FFF8E9 the eyes' whites
let glove = 5 // the charcoal work gloves, a strap round each cuff painted
let iris = 6 // #89481D
let pupil = 7 // #120D13
// Slot 8 (pearl) is free.
let pad = 9 // soft rubber knee and elbow pads
let leather = 10 // the ankle boots
let sole = 11 // boot soles
let belt = 12 // the belt
let ochre = 13 // the belt buckle, harness plate and braid tie
let collarKnit = 14 // the undersuit's high collar
let strap = 15 // the harness's front straps, with their ochre buckles painted
let brickGlass = 16 // the Humble Gaming Brick's see-through atomic-orange shell, the devices' own glass
let sleeve = 17 // the undersuit's sleeves, with the lavender shoulder patches painted
let brickLens = 18 // the brick's dark screen lens and its picture's box
let brickKeys = 19 // the d-pad and the speaker's slots
let brickButtons = 20 // the smoked A and B buttons
let brickRubber = 21 // select and start
let brickBoard = 22 // the pale green board under the face
let brickChip = 23 // the processor
let brickCartridge = 24 // the cartridge down its slot
let brickCell = 25 // the two AA cells in the battery bay
let brickLed = 26 // the red power light

// Authored darker than the sheet reads: the studio's light lifts a charcoal about half again, as it lifts the suit's
// lavender #744080 to the owner's dusty #B186B6.
let fabric = "#1C1D21"
let padStrap = "#151519"
let strapGrey = "#3A3C44"
let patchLavender = "#8C6A94"
let ochreTone = "#C98F35"

// One shoulder: the rounded cap from her collar over the top of her arm, in the torso's group, so the trapezius, the
// cap and the deltoid read as one shoulder; the sleeve's top sits inside it and the lavender patch over it is paint.
template pilotShoulder(name, side, id) {
  shape Superellipsoid $"shoulder-{name}" {
    id: id
    position [side * 0.168, 1.312, -0.015]
    rotation: turnAbout([0, 0, 1], side * -0.32)
    scale [0.088, 0.066, 0.068]
    material: undersuit
    blend: "SmoothUnion"
    smooth: 0.045
    group: 40
    parent: "torso"
    exponent: 2.3
  }
}

// One arm: the sleeve's upper arm with its biceps and triceps, the forearm, the elbow pad, and the gloved hand with its
// cuff, padded back, four fingers and a thumb. Its upper arm swings at the shoulder and its forearm at the elbow, on the
// suited Moth's drivers; `hold` brings both forward and in. The forearm and glove are measured on the straight arm and
// placed through `rested`, so they rest swung out and bent; the hold pose's first two forearm swings undo that first.
template pilotArm(name, side, baseId, handGroup, upperGroup, foreGroup) {
  shape Sweep $"upperArm-{name}" {
    id: baseId
    position [side * 0.18, 1.318, -0.016]
    material: sleeve
    group: upperGroup
    parent: "torso"
    curve {
      a [0, 0, 0]
      b [side * 0.016, -0.11, -0.008]
      c [side * 0.032, -0.25, -0.016]
      radiusStart: 0.05
      radiusEnd: 0.043
    }
    swings [
      {
        driver: "run"
        axis [0, 0, 1]
        amplitude: -0.06 * side
        pivot [side * 0.172, 1.355, -0.015]
        wave: "constant"
      }
      {
        driver: "gait"
        axis [0.990, side * 0.138, 0]
        amplitude: 0.5
        pivot [side * 0.172, 1.355, -0.015]
        wave: "sine"
        phase: 3.1415927 * (1 + side) / 2
      }
      // The arms open 0.45 rad from the sides at the jump's peak, 0.6 on the way up and 0.3 coming down.
      {
        driver: "air"
        axis [0, 0, 1]
        amplitude: 0.03 * side
        pivot [side * 0.172, 1.355, -0.015]
        wave: "linear"
        phase: 15
      }
      {
        driver: "air"
        axis [0.990, side * 0.138, 0]
        amplitude: -0.015
        pivot [side * 0.172, 1.355, -0.015]
        wave: "linear"
        phase: 8
      }
      // Holding the handheld: the upper arm forward a little and turned in, so the bent forearm points to her middle.
      {
        driver: "hold"
        axis [1, 0, 0]
        amplitude: -0.25
        pivot [side * 0.172, 1.355, -0.015]
        wave: "constant"
      }
      {
        driver: "hold"
        axis [0, 1, 0]
        amplitude: -0.5 * side
        pivot [side * 0.172, 1.355, -0.015]
        wave: "constant"
      }
    ]
  }

  // The biceps' swell on the front of the upper arm and the triceps' behind it.
  shape Superellipsoid $"biceps-{name}" {
    id: baseId + 12
    position [side * 0.193, 1.195, 0.004]
    scale [0.045, 0.078, 0.047]
    material: sleeve
    blend: "SmoothUnion"
    smooth: 0.03
    group: upperGroup
    parent: $"upperArm-{name}"
    exponent: 2.2
  }

  shape Superellipsoid $"triceps-{name}" {
    id: baseId + 13
    position [side * 0.196, 1.215, -0.036]
    scale [0.043, 0.085, 0.041]
    material: sleeve
    blend: "SmoothUnion"
    smooth: 0.03
    group: upperGroup
    parent: $"upperArm-{name}"
    exponent: 2.2
  }

  shape Sweep $"forearm-{name}" {
    id: baseId + 2
    position: elbowAt(side)
    rotation: forearmRest(side)
    material: sleeve
    group: foreGroup
    parent: $"upperArm-{name}"
    curve {
      a [0, 0, 0]
      b [side * 0.005, -0.115, 0.008]
      c [side * 0.01, -0.21, 0.02]
      radiusStart: 0.046
      radiusEnd: 0.035
      bulge: 0.003
    }
    swings [
      {
        driver: "run"
        axis [1, 0, 0]
        amplitude: -1.1
        pivot: elbowAt(side)
        wave: "constant"
      }
      {
        driver: "gait"
        axis [1, 0, 0]
        amplitude: 0.18
        pivot: elbowAt(side)
        wave: "sine"
        phase: 0.5 + 3.1415927 * (1 + side) / 2
      }
      // The elbows bend 0.36 rad at the jump's peak, 0.51 rising and 0.21 falling, and a little further on landing.
      {
        driver: "air"
        axis [1, 0, 0]
        amplitude: -0.03
        pivot: elbowAt(side)
        wave: "linear"
        phase: 12
      }
      {
        driver: "land"
        axis [1, 0, 0]
        amplitude: 0.05
        pivot: elbowAt(side)
        wave: "linear"
      }
      // Holding: the forearm comes back out of its rest (the bend, then the swing out), turns a little palm-up, then
      // the elbow bends, so the palms face each other in front of her chest with the thumbs up round the handheld's
      // 75 mm. Swings compose in list order, then the parent's delta.
      {
        driver: "hold"
        axis [1, 0, 0]
        amplitude: elbowRestBend
        pivot: elbowAt(side)
        wave: "constant"
      }
      {
        driver: "hold"
        axis [0, 0, 1]
        amplitude: -side * elbowRestSpread
        pivot: elbowAt(side)
        wave: "constant"
      }
      {
        driver: "hold"
        axis [0, 1, 0]
        amplitude: 0.15 * side
        pivot: elbowAt(side)
        wave: "constant"
      }
      {
        driver: "hold"
        axis [1, 0, 0]
        amplitude: -1.5
        pivot: elbowAt(side)
        wave: "constant"
      }
    ]
  }

  // The forearm's muscle under the sleeve, fullest just below the elbow, so the forearm tapers to the wrist.
  shape Superellipsoid $"forearmMass-{name}" {
    id: baseId + 14
    position: rested([side * 0.216, 0.99, -0.024], side)
    rotation: forearmRest(side)
    scale [0.047, 0.075, 0.045]
    material: sleeve
    blend: "SmoothUnion"
    smooth: 0.03
    group: foreGroup
    parent: $"forearm-{name}"
    exponent: 2.2
  }

  // The soft elbow pad on the back of the elbow, turned out a little, as sheet 04 draws it.
  shape Superellipsoid $"elbowPad-{name}" {
    id: baseId + 3
    position: rested([side * 0.233, 1.05, -0.079], side)
    rotation: turnThen(turnAbout([0, 1, 0], side * -0.47), forearmRest(side))
    scale [0.043, 0.055, 0.018]
    material: pad
    parent: $"forearm-{name}"
    exponent: 3
  }

  // The glove's full cuff over the sleeve's end, a strap round it painted.
  shape Superellipsoid $"cuff-{name}" {
    id: baseId + 4
    position: rested([side * 0.222, 0.872, -0.008], side)
    rotation: forearmRest(side)
    scale [0.046, 0.036, 0.048]
    material: glove
    group: handGroup
    parent: $"forearm-{name}"
    exponent: 2.6
  }

  // The gloved hand hangs palm in, its thick fingers curling a little toward the palm.
  shape Sweep $"wrist-{name}" {
    id: baseId + 5
    position: rested([side * 0.222, 0.85, -0.008], side)
    rotation: forearmRest(side)
    material: glove
    blend: "SmoothUnion"
    smooth: 0.01
    group: handGroup
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * 0.001, -0.022, 0.002]
      c [side * 0.002, -0.044, 0.004]
      radiusStart: 0.03
      radiusEnd: 0.028
    }
  }

  shape Superellipsoid $"palm-{name}" {
    id: baseId + 6
    position: rested([side * 0.224, 0.775, -0.005], side)
    rotation: forearmRest(side)
    scale [0.022, 0.052, 0.047]
    material: glove
    blend: "SmoothUnion"
    smooth: 0.012
    group: handGroup
    parent: $"forearm-{name}"
    exponent: 2.6
  }

  // The padded back of the glove over the knuckles.
  shape Superellipsoid $"gloveBack-{name}" {
    id: baseId + 15
    position: rested([side * 0.241, 0.772, -0.005], side)
    rotation: forearmRest(side)
    scale [0.011, 0.044, 0.04]
    material: glove
    blend: "SmoothUnion"
    smooth: 0.008
    group: handGroup
    parent: $"forearm-{name}"
    exponent: 3
  }

  shape Sweep $"thumb-{name}" {
    id: baseId + 7
    position: rested([side * 0.212, 0.792, 0.028], side)
    rotation: forearmRest(side)
    material: glove
    blend: "SmoothUnion"
    smooth: 0.007
    group: handGroup
    parent: $"forearm-{name}"
    curve {
      a [0, 0, 0]
      b [side * -0.012, -0.026, 0.019]
      c [side * -0.019, -0.054, 0.016]
      radiusStart: 0.0138
      radiusEnd: 0.0118
    }
  }

  for (finger, i) in gloveFingers {
    shape Sweep $"finger-{name}-{i}" {
      id: baseId + 8 + i
      position: rested([side * 0.223, finger[0], finger[1]], side)
      rotation: forearmRest(side)
      material: glove
      blend: "SmoothUnion"
      smooth: 0.018
      group: handGroup
      parent: $"forearm-{name}"
      curve {
        a [0, 0, 0]
        b [side * -0.007, -finger[2] * 0.52, finger[3] * 0.4]
        c [side * -0.028, -finger[2], finger[3]]
        radiusStart: finger[4]
        radiusEnd: finger[4] - 0.0016
      }
    }
  }
}

// One leg: the straight-cut trouser thigh and shin, bloused over the boot, the knee pad and the work boot. The thigh's
// stride swings sit between the yaw swings that turn the stride plane to the travel direction, as the suited Moth's
// do; the boot is the foot effector's tip, its origin on the sole's top so the standoff is its rest height.
template pilotLeg(name, side, baseId, shinGroup, bootGroup) {
  shape Sweep $"thigh-{name}" {
    id: baseId
    position [side * 0.09, 0.93, -0.004]
    material: trousers
    parent: "pelvis"
    curve {
      a [0, 0, 0]
      b [side * 0.009, -0.228, 0.014]
      c [side * 0.018, -0.455, 0.016]
      radiusStart: 0.1
      radiusEnd: 0.082
      bulge: 0.004
    }
    swings [
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: 0.7
        pivot [side * 0.09, 0.86, 0]
        wave: "sine"
      }
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: -0.5
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
      }
      {
        driver: "gait"
        axis [1, 0, 0]
        amplitude: 0.7
        pivot [side * 0.09, 0.86, 0]
        wave: "sine"
        phase: 3.1415927 * (1 - side) / 2
      }
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: 0.5
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
      }
      {
        driver: "heading"
        axis [0, 1, 0]
        amplitude: -0.7
        pivot [side * 0.09, 0.86, 0]
        wave: "sine"
      }
      // In the air the thigh lifts 0.8 rad at the peak, 1.1 on the way up and 0.5 reaching for the ground.
      {
        driver: "air"
        axis [1, 0, 0]
        amplitude: -0.06
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
        phase: 13.3
      }
      // Touching down at about 4 m/s the hip folds 0.4 rad into the crouch, and springs back as the give settles.
      {
        driver: "land"
        axis [1, 0, 0]
        amplitude: 0.1
        pivot [side * 0.09, 0.86, 0]
        wave: "linear"
      }
    ]
  }

  shape Sweep $"shin-{name}" {
    id: baseId + 1
    position [side * 0.106, 0.475, 0.012]
    material: trousers
    group: shinGroup
    parent: $"thigh-{name}"
    curve {
      a [0, 0, 0]
      b [side * 0.004, -0.11, -0.006]
      c [side * 0.008, -0.185, -0.012]
      radiusStart: 0.088
      radiusEnd: 0.09
    }
    swings [
      {
        driver: "gait"
        axis [1, 0, 0]
        amplitude: 1.25
        pivot [side * 0.106, 0.475, 0.012]
        wave: "halfSine"
        phase: 2.0424 + 3.1415927 * (1 + side) / 2
      }
      // The knee folds 1.2 rad at the peak, 1.45 rising and 0.95 falling, and takes twice the hip's fold on landing.
      {
        driver: "air"
        axis [1, 0, 0]
        amplitude: 0.05
        pivot [side * 0.106, 0.475, 0.012]
        wave: "linear"
        phase: 24
      }
      {
        driver: "land"
        axis [1, 0, 0]
        amplitude: -0.2
        pivot [side * 0.106, 0.475, 0.012]
        wave: "linear"
      }
    ]
  }

  // The knee pad, a domed shell over the kneecap; its straps are paint.
  shape Superellipsoid $"kneePad-{name}" {
    id: baseId + 2
    position [side * 0.108, 0.468, 0.09]
    rotation: turnAbout([1, 0, 0], -0.1)
    scale [0.062, 0.078, 0.032]
    material: pad
    parent: $"shin-{name}"
    exponent: 2.6
  }

  // The foot effector's tip: its origin on the sole's top, so the standoff is its rest height. The boot's visible
  // leather (shaft, instep and toe box) blends into one surface over it, on a thick sole with a heel step and lugs.
  shape Prism $"boot-{name}" {
    id: baseId + 3
    position [side * 0.115, 0.025, 0.03]
    rotation [0, -diagonal, 0, diagonal]
    scale [0.11, 0.13, 0.06]
    material: leather
    group: bootGroup
    parent: $"shin-{name}"
    profile {
      kind: "Convex"
      cornerRadius: 0.14
      vertices [[-1, 0], [-1, 0.6], [-0.4, 0.74], [0.3, 0.56], [0.75, 0.44], [1, 0.26], [1, 0]]
    }
    swings [
      {
        driver: "gait"
        pivot [side * 0.115, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: 0.2
        phase: 3.1415927 * (1 - side) / 2
        wave: "sine"
      }
      {
        driver: "gait"
        pivot [side * 0.115, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: -0.25
        phase: 2.0424 + 3.1415927 * (1 + side) / 2
        wave: "halfSine"
      }
      {
        driver: "air"
        pivot [side * 0.115, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: 0.02
        phase: 12.5
        wave: "linear"
      }
      {
        driver: "land"
        pivot [side * 0.115, 0.085, -0.005]
        axis [1, 0, 0]
        amplitude: 0.1
        wave: "linear"
      }
    ]
  }

  // The shaft, as wide as the trouser's hem, up the lower shin.
  shape Superellipsoid $"bootShaft-{name}" {
    id: baseId + 4
    position [side * 0.115, 0.13, -0.012]
    scale [0.078, 0.105, 0.085]
    material: leather
    blend: "SmoothUnion"
    smooth: 0.02
    group: bootGroup
    parent: $"boot-{name}"
    exponent: 3.2
  }

  // The instep, sloping from the shaft's front down to the toe box.
  shape Superellipsoid $"instep-{name}" {
    id: baseId + 8
    position [side * 0.115, 0.085, 0.05]
    rotation: turnAbout([1, 0, 0], 0.5)
    scale [0.072, 0.045, 0.075]
    material: leather
    blend: "SmoothUnion"
    smooth: 0.025
    group: bootGroup
    parent: $"boot-{name}"
    exponent: 2.6
  }

  // The round toe box over the front of the foot.
  shape Superellipsoid $"toeCap-{name}" {
    id: baseId + 7
    position [side * 0.115, 0.05, 0.095]
    scale [0.074, 0.052, 0.092]
    material: leather
    blend: "SmoothUnion"
    smooth: 0.02
    group: bootGroup
    parent: $"boot-{name}"
    exponent: 2.5
  }

  // The padded cuff round the shaft's top, just below the trouser's stack.
  shape Superellipsoid $"bootCuff-{name}" {
    id: baseId + 9
    position [side * 0.115, 0.226, -0.012]
    scale [0.082, 0.016, 0.089]
    material: leather
    parent: $"boot-{name}"
    exponent: 3
  }

  // The thick sole under the ball and toe, and the heel a step lower behind its arch.
  shape Prism $"sole-{name}" {
    id: baseId + 5
    position [side * 0.115, 0.014, 0.09]
    rotation [diagonal, 0, 0, diagonal]
    scale [0.079, 0.098, 0.013]
    material: sole
    parent: $"boot-{name}"
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.75
    }
    rounding: 0.004
  }

  shape Prism $"heel-{name}" {
    id: baseId + 10
    position [side * 0.115, 0.013, -0.058]
    rotation [diagonal, 0, 0, diagonal]
    scale [0.074, 0.044, 0.016]
    material: sole
    parent: $"boot-{name}"
    profile {
      kind: "RoundedRectangle"
      cornerRadius: 0.6
    }
    rounding: 0.004
  }

  // The sole's lugs, five bars across the tread: one bar repeated along the foot.
  shape Box $"lugs-{name}" {
    id: baseId + 11
    position [side * 0.115, 0.002, 0.095]
    scale [0.072, 0.004, 0.009]
    material: sole
    parent: $"boot-{name}"
    domain [
      repeat(spacing: [1, 1, 0.034], limit: [0, 0, 2], origin: [side * -0.115, 0.002, -0.095])
    ]
  }
}

prototypes {
  prototype "moth-pilot" {
    document {
      schema: "puck.creation.v1"
      name: "moth-pilot"
      frames [
        // Holding: the handheld leaves its rest inside her chest for her hands, its screen toward her eyes. A frame poses
        // each shape it names, not the shapes riding it, so every part of the brick is posed with the shell: its rest
        // offset from the shell's centre turned by the shell's 30 degrees and added to the shell's held place.
        {
          name: "hold"
          transforms [
            { id: 230, position [0, 1.2, 0.3378], rotation [0.2588, 0, 0, 0.9659] }
            { id: 243, position [0, 1.16238, 0.33196], rotation [0.2588, 0, 0, 0.9659] }
            { id: 244, position [0, 1.19594, 0.33084], rotation [0.2588, 0, 0, 0.9659] }
            { id: 245, position [0.002, 1.18528, 0.3233], rotation [0.2588, 0, 0, 0.9659] }
            { id: 246, position [0, 1.24241, 0.36834], rotation [0.2588, 0, 0, 0.9659] }
            { id: 247, position [0, 1.17584, 0.33165], rotation [0.183, -0.183, 0.68299, 0.68299] }
            { id: 248, position [0, 1.16199, 0.32365], rotation [0.183, -0.183, 0.68299, 0.68299] }
            { id: 249, position [0, 1.23267, 0.34321], rotation [0.2588, 0, 0, 0.9659] }
            { id: 257, position [0, 1.23297, 0.34269], rotation [0.2588, 0, 0, 0.9659] }
            { id: 250, position [0.0335, 1.24479, 0.35021], rotation [0.2588, 0, 0, 0.9659] }
            { id: 251, position [0.0215, 1.18394, 0.31462], rotation [0.2588, 0, 0, 0.9659] }
            { id: 252, position [0.0215, 1.18394, 0.31462], rotation [0.2588, 0, 0, 0.9659] }
            { id: 253, position [-0.0262, 1.18812, 0.31738], rotation [0.2588, 0, 0, 0.9659] }
            { id: 254, position [-0.0132, 1.18137, 0.31348], rotation [0.2588, 0, 0, 0.9659] }
            { id: 255, position [0.0085, 1.16556, 0.30446], rotation [0.25267, -0.056, 0.20902, 0.94301] }
            { id: 256, position [-0.0085, 1.16556, 0.30446], rotation [0.25267, -0.056, 0.20902, 0.94301] }
          ]
        }
        // The blink seats each closed lid over its eye and parks the open eye's pieces behind the face.
        mothBlinkFrame(pilotHeadAt, pilotHeadScale)
      ]
      palette [
        // The undersuit: the harness straps over her shoulders and across her back, and the lavender patches where
        // her shoulders meet her sleeves, are paint. A paint is placed in its parent shape's own frame: the torso's
        // origin is (0, 1.205, -0.008).
        {
          color: fabric
          roughness: 0.82
          specular: 0.03
          sheen: 0.25
          paints [
            {
              parent: "torso"
              type: "Box"
              position [0.068, 0.18, -0.027]
              scale [0.016, 0.05, 0.07]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [-0.068, 0.18, -0.027]
              scale [0.016, 0.05, 0.07]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [0.045, 0.105, -0.122]
              rotation [0, 0, -0.2588, 0.9659]
              scale [0.016, 0.085, 0.1]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [-0.045, 0.105, -0.122]
              rotation [0, 0, 0.2588, 0.9659]
              scale [0.016, 0.085, 0.1]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [0.045, -0.075, -0.112]
              rotation [0, 0, 0.2079, 0.9781]
              scale [0.016, 0.1, 0.1]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Box"
              position [-0.045, -0.075, -0.112]
              rotation [0, 0, -0.2079, 0.9781]
              scale [0.016, 0.1, 0.1]
              color: strapGrey
            }
            {
              parent: "torso"
              type: "Ellipsoid"
              position [0.19, 0.225, 0]
              scale [0.1, 0.15, 0.12]
              color: patchLavender
            }
            {
              parent: "torso"
              type: "Ellipsoid"
              position [-0.19, 0.225, 0]
              scale [0.1, 0.15, 0.12]
              color: patchLavender
            }
          ]
        }
        // The trousers, the knee pads' straps painted round each leg above and below its pad, in the shin's frame
        // (origin at the knee) and the thigh's (origin at the hip).
        {
          color: fabric
          roughness: 0.85
          specular: 0.03
          sheen: 0.2
          paints [
            {
              parent: "shin-left"
              type: "Box"
              position [0, -0.09, -0.012]
              scale [0.11, 0.009, 0.12]
              color: padStrap
            }
            {
              parent: "shin-right"
              type: "Box"
              position [0, -0.09, -0.012]
              scale [0.11, 0.009, 0.12]
              color: padStrap
            }
            {
              parent: "thigh-left"
              type: "Box"
              position [0.015, -0.37, 0.004]
              scale [0.11, 0.009, 0.12]
              color: padStrap
            }
            {
              parent: "thigh-right"
              type: "Box"
              position [-0.015, -0.37, 0.004]
              scale [0.11, 0.009, 0.12]
              color: padStrap
            }
          ]
        }
        {
          color: "#B76B3C"
          roughness: 0.62
          specular: 0.04
          wrap: 0.15
          fill: "#4B2318"
          // The mouth, in the face's frame: a line where the face crosses a thin quadratic sweep laid on it; and the nostrils.
          paints: concat(
            [
              {
                parent: "face"
                type: "Sweep"
                curve {
                  a: map([-0.05808, -0.088389, 0.1068], v => v * pilotHeadScale)
                  b: map([0, -0.1141765, 0.1082], v => v * pilotHeadScale)
                  c: map([0.05808, -0.0862981, 0.1078], v => v * pilotHeadScale)
                  radiusStart: 0.0015
                  radiusEnd: 0.0015
                }
                color: "#754137"
              }
            ],
            mothNostrilPaints(pilotHeadScale, "#754137")
          )
        }
        {
          color: "#171210"
          roughness: 0.32
          specular: 0.1
          coat: 0.05
          sheen: 0.3
        }
        {
          color: "#FFF8E9"
          roughness: 0.22
          specular: 0.04
          paints: mothLidPaints(pilotHeadScale)
        }
        {
          color: "#131316"
          roughness: 0.55
          specular: 0.06
          coat: 0.08
          paints [
            { parent: "cuff-left", type: "Box", position [0, -0.006, 0], scale [0.05, 0.009, 0.05], color: strapGrey }
            { parent: "cuff-right", type: "Box", position [0, -0.006, 0], scale [0.05, 0.009, 0.05], color: strapGrey }
          ]
        }
        {
          color: "#89481D"
          roughness: 0.25
          specular: 0.04
          paints: mothIrisPaints(pilotHeadScale, "#FFF8EF")
        }
        {
          color: "#120D13"
          roughness: 0.25
          specular: 0.04
          paints: mothPupilPaints(pilotHeadScale, "#FFF8EF")
        }
        {
          color: "#FFF8EF"
          roughness: 0.2
          specular: 0.04
          emissive: 1200
        }
        {
          color: "#1A1B1F"
          roughness: 0.5
          specular: 0.08
          coat: 0.1
        }
        // The boots, a strap over each instep.
        {
          color: "#0F0F12"
          roughness: 0.45
          specular: 0.08
          coat: 0.15
          paints [
            { parent: "instep-left", type: "Box", position [0, 0, 0], scale [0.09, 0.07, 0.013], color: strapGrey }
            { parent: "instep-right", type: "Box", position [0, 0, 0], scale [0.09, 0.07, 0.013], color: strapGrey }
          ]
        }
        {
          color: "#070708"
          roughness: 0.8
          specular: 0.03
        }
        {
          color: "#111114"
          roughness: 0.5
          specular: 0.06
          coat: 0.1
        }
        {
          color: ochreTone
          roughness: 0.42
          specular: 0.04
          metal: 0.2
        }
        {
          color: "#1D1E22"
          roughness: 0.85
          specular: 0.03
          sheen: 0.3
        }
        // The front straps, each with its ochre buckle high on her chest.
        {
          color: strapGrey
          roughness: 0.7
          specular: 0.04
          paints [
            {
              parent: "torso"
              type: "Box"
              position [0.068, 0.095, 0.078]
              scale [0.02, 0.015, 0.04]
              color: ochreTone
            }
            {
              parent: "torso"
              type: "Box"
              position [-0.068, 0.095, 0.078]
              scale [0.02, 0.015, 0.04]
              color: ochreTone
            }
          ]
        }
        // The Humble Gaming Brick's shell: the same atomic-orange acrylic glass as the device in the gallery
        // (devices.puck), so the board, cells and cartridge read through a saturated orange.
        { color: "#FF4F10", roughness: 0.06, glass { depth: 0.009, ior: 1.49 } }
        // The sleeves, the lavender patch over each shoulder's cap.
        {
          color: fabric
          roughness: 0.82
          specular: 0.03
          sheen: 0.25
          paints [
            {
              parent: "upperArm-left"
              type: "Ellipsoid"
              position [0.01, 0.112, 0.008]
              scale [0.1, 0.15, 0.12]
              color: patchLavender
            }
            {
              parent: "upperArm-right"
              type: "Ellipsoid"
              position [-0.01, 0.112, 0.008]
              scale [0.1, 0.15, 0.12]
              color: patchLavender
            }
          ]
        }
        // The brick's opaque parts, after its device: the lens, the keys, buttons, rubber, board, processor, cartridge,
        // cells and power light.
        { color: "#17181C", specular: 0.05, roughness: 0.08, coat: 0.6 }
        { color: "#2A2624", roughness: 0.4, specular: 0.04 }
        { color: "#2E2522", roughness: 0.25, specular: 0.05, coat: 0.4 }
        { color: "#5E5E64", roughness: 0.75 }
        { color: "#8CC79A", roughness: 0.5, specular: 0.04 }
        { color: "#151617", roughness: 0.6, specular: 0.04 }
        { color: "#4A4D54", roughness: 0.5, specular: 0.04 }
        { color: "#2C5E8C", roughness: 0.35, specular: 0.05, coat: 0.3 }
        { color: "#FF3A2A", emissive: 400, roughness: 0.3 }
      ]

      // The whole body rides the pelvis, which turns her hips into a diagonal, trails a turn, leans into her planar
      // acceleration and drops into a landing, as the suited Moth's does at her own height.
      shape Superellipsoid "pelvis" {
        id: 120
        position [0, 0.93, -0.006]
        scale [0.162, 0.108, 0.126]
        material: trousers
        group: 43
        exponent: 2.4
        swings [
          { driver: "gait", axis [0, 1, 0], amplitude: 0.08, pivot [0, 0.96, 0], wave: "sine", phase: 0 }
          { driver: "run", axis [1, 0, 0], amplitude: 0.1, pivot [0, 0, 0], wave: "constant", phase: 0 }
          { driver: "gait", axis [0, 0, 1], amplitude: 0.05, pivot [0, 0.96, 0], wave: "sine", phase: 0 }
          { driver: "heading", axis [0, 1, 0], amplitude: 0.7, pivot [0, 0.96, 0], wave: "sine" }
          { driver: "trail", axis [0, 1, 0], amplitude: -0.12, pivot [0, 0.96, 0], wave: "linear" }
          { driver: "lean", axis [0, 0, 1], amplitude: -0.016, pivot [0, 0, 0], wave: "linear" }
          { driver: "surge", axis [1, 0, 0], amplitude: 0.006, pivot [0, 0, 0], wave: "linear" }
          { driver: "land", axis [1, 0, 0], amplitude: -0.02, pivot [0, 0, 0], wave: "linear" }
        ]
        slides [
          { driver: "bob", axis [0, 1, 0], amplitude: 0.018, phase: -1.5708, wave: "sine" }
          { driver: "land", axis [0, 1, 0], amplitude: 0.021, wave: "linear" }
        ]
      }

      shape Superellipsoid "belt" {
        id: 121
        position [0, 1.0, -0.004]
        scale [0.152, 0.022, 0.117]
        material: belt
        parent: "pelvis"
        exponent: 3
      }

      shape Box "beltBuckle" {
        id: 122
        position [0, 1.0, 0.113]
        scale [0.026, 0.018, 0.007]
        material: ochre
        parent: "pelvis"
      }

      shape Box "beltTab-left" {
        id: 123
        position [0.112, 1.0, 0.078]
        rotation [0, 0.4226, 0, 0.9063]
        scale [0.013, 0.016, 0.006]
        material: ochre
        parent: "pelvis"
      }

      shape Box "beltTab-right" {
        id: 124
        position [-0.112, 1.0, 0.078]
        rotation [0, -0.4226, 0, 0.9063]
        scale [0.013, 0.016, 0.006]
        material: ochre
        parent: "pelvis"
      }

      // The chest turns most of the way back from the hips toward the facing and leads a turn the hips trail; the
      // waist, chest, shoulders and upper back blend into one torso that rides it.
      shape Superellipsoid "torso" {
        id: 125
        position [0, 1.205, -0.008]
        scale [0.15, 0.165, 0.114]
        material: undersuit
        group: 40
        parent: "pelvis"
        exponent: 2.3
        swings [
          { driver: "gait", axis [0, 1, 0], amplitude: -0.16, pivot [0, 0.96, 0], wave: "sine", phase: 0 }
          { driver: "bob", axis [1, 0, 0], amplitude: -0.025, pivot [0, 0.96, 0], wave: "sine", phase: -1.0708 }
          { driver: "heading", axis [0, 1, 0], amplitude: -0.4, pivot [0, 0.96, 0], wave: "sine" }
          { driver: "trail", axis [0, 1, 0], amplitude: 0.08, pivot [0, 0.96, 0], wave: "linear" }
        ]
        slides [
          { driver: "breath", axis [0, 1, 0], amplitude: 0.003, phase: 0, wave: "sine" }
        ]
      }

      shape Superellipsoid "waist" {
        id: 126
        position [0, 1.05, -0.004]
        scale [0.122, 0.11, 0.092]
        material: undersuit
        blend: "SmoothUnion"
        smooth: 0.05
        group: 40
        parent: "torso"
        exponent: 2.2
      }

      shape Superellipsoid "chest" {
        id: 127
        position [0, 1.218, 0.045]
        scale [0.124, 0.066, 0.072]
        material: undersuit
        blend: "SmoothUnion"
        smooth: 0.035
        group: 40
        parent: "torso"
        exponent: 2.2
      }

      shape Superellipsoid "trapezius" {
        id: 128
        position [0, 1.335, -0.022]
        scale [0.17, 0.056, 0.084]
        material: undersuit
        blend: "SmoothUnion"
        smooth: 0.045
        group: 40
        parent: "torso"
        exponent: 2.3
      }

      pilotShoulder("left", 1, 137)
      pilotShoulder("right", -1, 138)

      // The harness: two flat front straps from her shoulders to her belt, each in two runs that bridge her chest.
      shape Box "strapUpper-left" {
        id: 129
        position [0.068, 1.312, 0.075]
        rotation [-0.2124, 0, 0, 0.9772]
        scale [0.016, 0.076, 0.003]
        material: strap
        parent: "torso"
      }

      shape Box "strapUpper-right" {
        id: 130
        position [-0.068, 1.312, 0.075]
        rotation [-0.2124, 0, 0, 0.9772]
        scale [0.016, 0.076, 0.003]
        material: strap
        parent: "torso"
      }

      shape Box "strapLower-left" {
        id: 131
        position [0.068, 1.127, 0.103]
        rotation [0.0399, 0, 0, 0.9992]
        scale [0.016, 0.113, 0.003]
        material: strap
        parent: "torso"
      }

      shape Box "strapLower-right" {
        id: 132
        position [-0.068, 1.127, 0.103]
        rotation [0.0399, 0, 0, 0.9992]
        scale [0.016, 0.113, 0.003]
        material: strap
        parent: "torso"
      }

      // The harness's ochre plate between her shoulder blades, where the painted back straps cross.
      shape Box "harnessPlate" {
        id: 134
        position [0, 1.245, -0.12]
        scale [0.03, 0.028, 0.006]
        material: ochre
        parent: "torso"
      }

      // The undersuit's high collar carries her head: it keeps to the facing whatever the hips do and looks ahead
      // into a turn.
      shape Superellipsoid "collar" {
        id: 133
        position [0, 1.395, -0.01]
        scale [0.062, 0.055, 0.056]
        material: collarKnit
        parent: "torso"
        exponent: 2.6
        swings [
          { driver: "gait", axis [0, 1, 0], amplitude: 0.08, pivot [0, 1.36, -0.005], wave: "sine", phase: 0.3 }
          { driver: "heading", axis [0, 1, 0], amplitude: -0.3, pivot [0, 1.36, -0.005], wave: "sine" }
          { driver: "trail", axis [0, 1, 0], amplitude: 0.07, pivot [0, 1.36, -0.005], wave: "linear" }
          // Holding the handheld, she looks down at it.
          { driver: "hold", axis [1, 0, 0], amplitude: 0.3, pivot [0, 1.36, -0.005], wave: "constant" }
        ]
      }

      mothHead(pilotHeadScale, pilotHeadAt, "collar", skin, eyeWhite, iris, pupil, hair)

      // Out of the hood her black hair has the volume sheet 04 draws, as a few tapered locks over a smaller inner mass:
      // a fringe swoop lifting from a parting over her right eye across to her left, three locks swept back over her
      // crown to points at the nape, loose hair falling down her left side past the ear to the jaw, and her right side
      // swept back to the braid's root. Each joins the head's scalp group, so the hair is one swept mass; coordinates
      // are the head library's unscaled frame.
      for lock in pilotHairLocks {
        mothHairLock(lock[0], lock[1], lock[2], lock[3], lock[4], lock[5], lock[6], pilotHeadScale, pilotHeadAt, "collar", hair)
      }

      shape Superellipsoid "hairMass" {
        id: 99
        position: map([0, 1.81, 0.005], (v, k) => pilotHeadAt[k] + (v - mothHeadPivot[k]) * pilotHeadScale)
        scale: map([0.188, 0.155, 0.11], v => v * pilotHeadScale)
        material: hair
        blend: "SmoothUnion"
        smooth: 0.02
        group: 9
        parent: "collar"
        exponent: 2.2
      }

      // The hair over the back of her neck, down to the collar, under the crown locks' points.
      shape Superellipsoid "hairNape" {
        id: 98
        position: map([0, 1.68, -0.035], (v, k) => pilotHeadAt[k] + (v - mothHeadPivot[k]) * pilotHeadScale)
        scale: map([0.15, 0.09, 0.105], v => v * pilotHeadScale)
        material: hair
        blend: "SmoothUnion"
        smooth: 0.02
        group: 9
        parent: "collar"
        exponent: 2.2
      }

      // The braid roots beside her right cheek at its full thickness and falls over her right collarbone onto her chest:
      // a core along `braidAt` blended into the hair at its root, and the plait's lobes alternating down it from the
      // root to an ochre tie and a short tassel. It rides her head, so it sways a little as she walks.
      shape Sweep "braid-0" {
        id: 220
        position: braidRoot
        material: hair
        blend: "SmoothUnion"
        smooth: 0.012
        group: 9
        parent: "collar"
        curve {
          a [0, 0, 0]
          b: map(braidBend, (v, k) => v - braidRoot[k])
          c: map(braidEnd, (v, k) => v - braidRoot[k])
          radiusStart: 0.017
          radiusEnd: 0.013
        }
      }

      for i in range(0, 12) {
        shape Superellipsoid $"braidLobe-{i}" {
          id: 231 + i
          position: map(braidAt(0.03 + i * 0.08), (v, k) => (k == 0) ? v + (((i % 2) == 0) ? 0.006 : -0.006) : v)
          rotation: turnAbout([0, 0, 1], ((i % 2) == 0) ? braidLean : 0 - braidLean)
          scale [0.021, 0.027, 0.02]
          material: hair
          blend: "SmoothUnion"
          smooth: 0.005
          group: 52
          parent: "collar"
          exponent: pilotSoftness
        }
      }

      shape Cylinder "braidTie" {
        id: 223
        position [-0.098, 1.09, 0.112]
        scale [0.021, 0.012, 0.021]
        material: ochre
        group: 52
        parent: "collar"
        rounding: 0.005
      }

      shape Sweep "braidTassel" {
        id: 224
        position [-0.098, 1.086, 0.112]
        material: hair
        group: 52
        parent: "collar"
        curve {
          a [0, 0, 0]
          b [0.002, -0.03, 0.001]
          c [0.004, -0.062, 0.003]
          radiusStart: 0.016
          radiusEnd: 0.007
        }
      }

      pilotArm("left", 1, 140, 41, 44, 46)
      pilotArm("right", -1, 160, 42, 45, 47)
      pilotLeg("left", 1, 180, 48, 50)
      pilotLeg("right", -1, 200, 49, 51)

      // The handheld is the Humble Gaming Brick of the gallery, a faithful simplified copy: 75 x 133 x 23 mm of orange
      // glass with the battery bay 4.5 mm proud of its back, 27.5 mm in all. It rests hidden inside her chest, and the
      // hold frame seats it in her hands; every part rides it. In its frame (its centre at rest, (0, 1.17, -0.005)) the
      // face is its -Z side, toward her eyes when held, so the d-pad on the face's left as she looks at it lies at +X.
      shape Prism "handheld" {
        id: 230
        position [0, 1.17, -0.00725]
        scale [0.0375, 0.0665, 0.0115]
        material: brickGlass
        parent: "torso"
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.24
        }
        rounding: 0.0022
      }

      shape Prism "brickBay" {
