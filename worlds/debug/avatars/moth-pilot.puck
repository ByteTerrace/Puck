        scale [0.0048, 0.0048, 0.0014]
        material: brickButtons
        parent: "handheld"
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0009
      }

      shape Prism "brickButton-b" {
        id: 254
        position [-0.0132, 1.1417, -0.019]
