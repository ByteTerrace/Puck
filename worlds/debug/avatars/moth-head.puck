// The Moth's own head: face, eyes, brows, nose, scalp and swept fringe, one model for the suited Moth and the pilot
// inside the suit. A creation imports this library and calls mothHead(...) inside its document, after the shape the
// head turns with.
//
// Every coordinate below is authored in the suit's rest frame about mothHeadPivot (her face's front at eye level),
// and the template places the head with `at` (where that pivot lands) and scales it uniformly by `s` about it: every
// position, extent, curve, sweep radius and blend radius scales by `s`; rotations do not. s = 1 is the chibi head the
// first Moth wore; 0.68 is her real head, about 0.26 m from crown to chin.
//
// The palette differs between creations, so the slots are parameters: skin, eye whites, iris, pupil and hair. A creation
// also places the head's paints in its own palette, scaled by the same `s`: the mouth on "face" and the nostrils
// (mothNostrilPaints) in its skin slot, the upper lids and lashes (mothLidPaints) in its eye-white slot, the
// catchlights in its pupil (mothPupilPaints) and iris (mothIrisPaints) slots, and its blink frame from mothBlinkPose.

let mothHeadPivot = [0, 1.745, 0.2]
let mothHeadSoftness = 2.1

// The blink frame's poses in the head's unscaled frame, [id, x, y, z]: each closed lid forward over its eye, each open
// eye's white, opening, iris, pupil, upper lid and lash back inside the face. A creation places each at its own
// head as at + (v - mothHeadPivot) * s.
let mothBlinkPose = [
  [284, 0.07656, 1.74842, 0.21045]
  [285, 0.03356, 1.74842, 0.23245]
  [41, 0.07656, 1.74842, 0.06945]
  [42, 0.07656, 1.74842, 0.06945]
  [43, 0.07456, 1.74842, 0.11045]
  [44, 0.07456, 1.74842, 0.11545]
  [47, 0.02956, 1.74842, 0.09645]
  [49, 0.11656, 1.76542, 0.09945]
  [286, -0.07656, 1.74842, 0.21045]
  [287, -0.11956, 1.74842, 0.23245]
  [57, -0.07656, 1.74842, 0.06945]
  [58, -0.07656, 1.74842, 0.06945]
  [59, -0.07456, 1.74842, 0.11045]
  [60, -0.07456, 1.74842, 0.11545]
  [63, -0.02956, 1.74842, 0.09645]
  [65, -0.11656, 1.76542, 0.09945]
]

// The blink frame of a creation whose head stands at `at` scaled by `s`: each closed lid seated over its eye and the open
// eye's pieces parked behind the face.
function mothBlinkFrame(at, s) = {
  name: "blink"
  transforms: map(
    mothBlinkPose,
    row => {
      id: row[0]
      position: map([row[1], row[2], row[3]], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
      rotation [0, 0, 0, 1]
    }
  )
}

// The paints on an eye white where each eye's upper lid and lash meet it, in the eye's own frame and scaled by `s`:
// their curves are half a millimetre wider than the tubes, so the white under a tube's edge reads as the tube rather
// than two meshes trading pixels. The eyes are `eye-left` and `eye-right` (`mothEye`).
function mothLidPaints(s) = [
  {
    parent: "eye-left"
    type: "Sweep"
    curve {
      a: map([-0.047, 0, 0.027], v => v * s)
      b: map([0, 0.066, 0.052], v => v * s)
      c: map([0.047, 0.004, 0.027], v => v * s)
      radiusStart: 0.0045 * s
      radiusEnd: 0.0045 * s
    }
    color: "#171210"
  }
  {
    parent: "eye-left"
    type: "Sweep"
    curve {
      a: map([0.04, 0.017, 0.03], v => v * s)
      b: map([0.05, 0.023, 0.023], v => v * s)
      c: map([0.059, 0.023, 0.016], v => v * s)
      radiusStart: 0.0035 * s
      radiusEnd: 0.0035 * s
    }
    color: "#171210"
  }
  {
    parent: "eye-right"
    type: "Sweep"
    curve {
      a: map([0.047, 0, 0.027], v => v * s)
      b: map([0, 0.066, 0.052], v => v * s)
      c: map([-0.047, 0.004, 0.027], v => v * s)
      radiusStart: 0.0045 * s
      radiusEnd: 0.0045 * s
    }
    color: "#171210"
  }
  {
    parent: "eye-right"
    type: "Sweep"
    curve {
      a: map([-0.04, 0.017, 0.03], v => v * s)
      b: map([-0.05, 0.023, 0.023], v => v * s)
      c: map([-0.059, 0.023, 0.016], v => v * s)
      radiusStart: 0.0035 * s
      radiusEnd: 0.0035 * s
    }
    color: "#171210"
  }
]

// The nostrils, two dark ovals painted under the nose's tip in the nose's frame and scaled by `s`; a sculpted nostril is
// a millimetre across and bakes no surface.
function mothNostrilPaints(s, color) = [
  { parent: "nose", type: "Ellipsoid", position: map([-0.0085, -0.0105, 0.004], v => v * s), scale: map([0.0038, 0.0022, 0.008], v => v * s), color: color }
  { parent: "nose", type: "Ellipsoid", position: map([0.0085, -0.0105, 0.004], v => v * s), scale: map([0.0038, 0.0022, 0.008], v => v * s), color: color }
]

// The large catchlight, high on each pupil toward her right (both eyes see one light), in the pupil's frame and scaled
// by `s`.
function mothPupilPaints(s, color) = [
  { parent: "pupil-left", type: "Ellipsoid", position: map([-0.004, 0.009, 0.004], v => v * s), scale: map([0.0045, 0.0055, 0.008], v => v * s), color: color }
  { parent: "pupil-right", type: "Ellipsoid", position: map([-0.004, 0.009, 0.004], v => v * s), scale: map([0.0045, 0.0055, 0.008], v => v * s), color: color }
]

// The small catchlight, low on each iris toward her left, in the iris's frame and scaled by `s`.
function mothIrisPaints(s, color) = [
  { parent: "iris-left", type: "Ellipsoid", position: map([0.012, -0.014, 0.006], v => v * s), scale: map([0.0026, 0.003, 0.008], v => v * s), color: color }
  { parent: "iris-right", type: "Ellipsoid", position: map([0.012, -0.014, 0.006], v => v * s), scale: map([0.0026, 0.003, 0.008], v => v * s), color: color }
]

// One lock of hair: a tapering sweep from its root on the crown or temple, laid over the scalp and face and smoothly
// joined to the scalp's group, so the hair reads as one swept mass. `a` is the root in the head's unscaled frame, `b` and
// `c` the sweep's control and end points relative to it.
template mothHairLock(name, id, a, b, c, radiusStart, radiusEnd, s, at, parentName, hair) {
  shape Sweep $"{name}" {
    id: id
    position: map(a, (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    material: hair
    blend: "SmoothUnion"
    smooth: 0.028 * s
    group: 9
    parent: parentName
    curve {
      a [0, 0, 0]
      b: map(b, v => v * s)
      c: map(c, v => v * s)
      radiusStart: radiusStart * s
      radiusEnd: radiusEnd * s
    }
  }
}

// One eye: a carved socket in the face, a white clipped to an almond opening, iris, pupil, the upper lid, a lash flick
// and the brow; the catchlights and the lid lines on the white are paints. `side` is 1 for her left (+X) and -1 for her right.
template mothEye(name, side, baseId, eyeGroup, s, at, parentName, skin, white, iris, pupil, hair) {
  shape Prism $"socket-{name}" {
    id: baseId
    position: map([side * 0.07656, 1.74842, 0.20745], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.049, 0.034, 0.06], v => v * s)
    material: skin
    blend: "SmoothSubtraction"
    smooth: 0.012 * s
    group: 6
    parent: parentName
    profile {
      kind: "Ellipse"
    }
  }

  shape Superellipsoid $"eye-{name}" {
    id: baseId + 1
    position: map([side * 0.07656, 1.74842, 0.1755], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.058, 0.058, 0.058], v => v * s)
    material: white
    group: eyeGroup
    parent: parentName
    exponent: 2
  }

  shape Prism $"eyeOpening-{name}" {
    id: baseId + 2
    position: map([side * 0.07656, 1.74842, 0.18945], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.048, 0.033, 0.065], v => v * s)
    material: white
    blend: "SmoothIntersection"
    smooth: 0.004 * s
    group: eyeGroup
    parent: parentName
    profile {
      kind: "Ellipse"
    }
  }

  shape Superellipsoid $"iris-{name}" {
    id: baseId + 3
    position: map([side * 0.07456, 1.74842, 0.23045], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.023, 0.028, 0.006], v => v * s)
    material: iris
    parent: parentName
    exponent: mothHeadSoftness
  }

  shape Superellipsoid $"pupil-{name}" {
    id: baseId + 4
    position: map([side * 0.07456, 1.74842, 0.23545], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.0105, 0.016, 0.004], v => v * s)
    material: pupil
    parent: parentName
    exponent: mothHeadSoftness
  }

  shape Sweep $"upperLid-{name}" {
    id: baseId + 7
    position: map([side * 0.02956, 1.74842, 0.2265], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    material: hair
    parent: parentName
    curve {
      a [0, 0, 0]
      b: map([side * 0.047, 0.066, 0.033], v => v * s)
      c: map([side * 0.094, 0.004, 0], v => v * s)
      radiusStart: 0.0065 * s
      radiusEnd: 0.0065 * s
    }
  }

  shape Sweep $"lash-{name}" {
    id: baseId + 9
    position: map([side * 0.11656, 1.76542, 0.21945], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    material: hair
    parent: parentName
    curve {
      a [0, 0, 0]
      b: map([side * 0.01, 0.006, -0.007], v => v * s)
      c: map([side * 0.019, 0.006, -0.014], v => v * s)
      radiusStart: 0.003 * s
      radiusEnd: 0.003 * s
    }
  }

  shape Sweep $"brow-{name}" {
    id: baseId + 10
    position: map([side * 0.02992, 1.8241, 0.22005], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    material: hair
    parent: parentName
    curve {
      a [0, 0, 0]
      b: map([side * 0.04048, 0.02332, 0.0072], v => v * s)
      c: map([side * 0.09988, 0.00132, -0.02655], v => v * s)
      radiusStart: 0.005 * s
      radiusEnd: 0.005 * s
    }
  }
}

// The closed lid the blink frame seats over each eye: a skin cover and a crease, parked behind the face at rest.
template mothBlinkLid(name, side, baseId, s, at, parentName, skin, hair) {
  shape Superellipsoid $"blinkCover-{name}" {
    id: baseId
    position: map([side * 0.07656, 1.74842, 0.09945], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.056, 0.04, 0.021], v => v * s)
    material: skin
    parent: parentName
    exponent: mothHeadSoftness
  }

  shape Sweep $"blinkCrease-{name}" {
    id: baseId + 1
    position: map([side * 0.07656 - 0.043, 1.74842, 0.11245], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    material: hair
    parent: parentName
    curve {
      a [0, 0, 0]
      b: map([0.043, -0.012, 0.003], v => v * s)
      c: map([0.086, 0, 0], v => v * s)
      radiusStart: 0.0017 * s
      radiusEnd: 0.0017 * s
    }
  }
}

// The whole head. Shape ids are the suited Moth's: face, chin, ears and features 32..50 and 56..66, scalp 76..78, the hair locks
// 81..84 and the blink lids 284..287; groups 6..9.
template mothHead(s, at, parentName, skin, white, iris, pupil, hair) {
  shape Superellipsoid "face" {
    id: 32
    position: map([0, 1.734, 0.10575], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.162, 0.176, 0.13275], v => v * s)
    material: skin
    group: 6
    parent: parentName
    exponent: mothHeadSoftness
  }

  // The chin: a small rounded point under the mouth, blended into the face so the jaw tapers to it.
  shape Superellipsoid "chin" {
    id: 36
    position: map([0, 1.6, 0.16], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.062, 0.042, 0.052], v => v * s)
    material: skin
    blend: "SmoothUnion"
    smooth: 0.055 * s
    group: 6
    parent: parentName
    exponent: mothHeadSoftness
  }

  // The ears, set at eye level behind the cheeks and blended into the face; the side locks cover their tops.
  for (ear, k) in [{ name: "left", side: 1, id: 38 }, { name: "right", side: -1, id: 39 }] {
    shape Superellipsoid $"ear-{ear.name}" {
      id: ear.id
      position: map([ear.side * 0.168, 1.722, 0.07], (v, k2) => at[k2] + (v - mothHeadPivot[k2]) * s)
      rotation [0, ear.side * 0.17365, 0, 0.98481]
      scale: map([0.017, 0.04, 0.028], v => v * s)
      material: skin
      blend: "SmoothUnion"
      smooth: 0.012 * s
      group: 6
      parent: parentName
      exponent: mothHeadSoftness
    }
  }

  shape Superellipsoid "neck" {
    id: 33
    position: map([0, 1.5579, 0.05625], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.07, 0.075, 0.055], v => v * s)
    material: skin
    blend: "SmoothUnion"
    smooth: 0.006 * s
    group: 6
    parent: parentName
    exponent: mothHeadSoftness
  }

  shape Box "jaw-1" {
    id: 34
    position: map([-0.222, 1.54, 0.1], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    rotation [0, 0, -0.3255682, 0.9455186]
    scale: map([0.18, 0.11, 0.3], v => v * s)
    material: skin
    blend: "SmoothSubtraction"
    smooth: 0.012 * s
    group: 6
    parent: parentName
  }

  shape Box "jaw1" {
    id: 35
    position: map([0.222, 1.54, 0.1], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    rotation [0, 0, 0.3255682, 0.9455186]
    scale: map([0.18, 0.11, 0.3], v => v * s)
    material: skin
    blend: "SmoothSubtraction"
    smooth: 0.012 * s
    group: 6
    parent: parentName
  }

  // A small soft nose, one rounded tip blended into the face's group, so it bakes on the face's lattice as one continuous
  // surface; the nostrils are paints (mothNostrilPaints).
  shape Superellipsoid "nose" {
    id: 37
    position: map([0, 1.6935, 0.2365], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.017, 0.014, 0.012], v => v * s)
    material: skin
    blend: "SmoothUnion"
    smooth: 0.02 * s
    group: 6
    parent: parentName
    exponent: mothHeadSoftness
  }



  mothEye("left", 1, 40, 7, s, at, parentName, skin, white, iris, pupil, hair)
  mothEye("right", -1, 56, 8, s, at, parentName, skin, white, iris, pupil, hair)

  shape Superellipsoid "scalp" {
    id: 76
    position: map([0, 1.7735, 0.0855], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.1958, 0.1892, 0.1575], v => v * s)
    material: hair
    group: 9
    parent: parentName
    exponent: mothHeadSoftness
  }

  // The hairline: the scalp cut away under her temples and in front of her crown, with rounded seams so its edge reads
  // as hair lying on the head rather than a sawn shell.
  shape Box "scalpBottom" {
    id: 77
    position: map([0, 1.68, 0.25], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.4, 0.141, 0.22], v => v * s)
    material: hair
    blend: "SmoothSubtraction"
    smooth: 0.02 * s
    group: 9
    parent: parentName
  }

  shape Box "scalpFront" {
    id: 78
    position: map([0, 1.88, 0.435], (v, k) => at[k] + (v - mothHeadPivot[k]) * s)
    scale: map([0.4, 0.4, 0.24925], v => v * s)
    material: hair
    blend: "SmoothSubtraction"
    smooth: 0.02 * s
    group: 9
    parent: parentName
  }

  // The swept fringe: a thick lock from the parting on her left across her forehead to her right temple, a shorter one
  // back to her left temple, and a lock down each side of her face in front of the ear, her left one to the jaw. Each
  // fringe lock roots inside the scalp, so it leaves the crown already lying flat and nothing stands up from it.
  mothHairLock(
    "fringe-0",
    81,
    [0.0028, 1.9201, 0.1111],
    [0.0162, -0.0204, 0.1322],
    [-0.1416, -0.0968, 0.064],
    0.04,
    0.016,
    s,
    at,
    parentName,
    hair
  )
  mothHairLock(
    "fringe-1",
    82,
    [0.0056, 1.9201, 0.1103],
    [0.0461, -0.0232, 0.0743],
    [0.1623, -0.0612, 0.0393],
    0.034,
    0.014,
    s,
    at,
    parentName,
    hair
  )
  mothHairLock(
    "sideLock-left",
    83,
    [0.1329, 1.8546, 0.1487],
    [0.0712, -0.0732, -0.0265],
    [0.0459, -0.148, -0.0349],
    0.026,
    0.011,
    s,
    at,
    parentName,
    hair
  )
  mothHairLock(
    "sideLock-right",
    84,
    [-0.1205, 1.8474, 0.1486],
    [-0.0814, -0.0569, -0.0181],
    [-0.0604, -0.1146, -0.0282],
    0.024,
    0.012,
    s,
    at,
    parentName,
    hair
  )

  mothBlinkLid("left", 1, 284, s, at, parentName, skin, hair)
  mothBlinkLid("right", -1, 286, s, at, parentName, skin, hair)
}
