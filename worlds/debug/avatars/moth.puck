// The suit's two plate colours, from the concept pack: dusty lavender and a warm ivory, with the darker lavender of
// a groove and the near-black of a vent slot.
let lavenderPlate = "#744080"
let ivoryPlate = "#F2C49A"
let lavenderSeam = "#5E3468"
let ventSlot = "#2B2630"

// The palette, by role. A slot number says nothing; a name says what the surface IS.
let skin = 0 // ivory: hood rim, ear mounts, cheek guards, knee guards, hip guards and boot insteps
let violet = 1 // lavender: hood shell, forearms, pelvic plate, toe caps and heel guards
let charcoal = 2 // #252630 joints, pivots, undersuit and soles
let rust = 3 // #B76B3C her skin
let ink = 4 // #171210 hair, lids and brows
let ivory = 5 // #FFF8E9 the eyes' whites
let leather = 7 // #754137
let brass = 8 // #C98F35 ochre collar and belt
let umber = 9 // #89481D
let jet = 10 // #120D13
let pearl = 11 // #FFF8EF
let violetBandLeft = 12 // lavender left shoulder stack under its ivory bands
let violetBandRight = 13 // lavender right shoulder stack under its ivory bands
let violetPodLeft = 14 // lavender of the left back pod's plates, under its vent and grey plate
let violetPodRight = 15 // lavender of the right back pod's plates, under its vent and grey plate
let chestArmor = 16 // ivory chest slab round its lavender centre
let shinCream = 17 // ivory ankle trim, shin side panels with their vents, and back-pod bands
let shinViolet = 18 // lavender greaves under their ivory arch band and side panel
let gunmetal = 19 // #43464E heel lens housing and heel block
let steel = 20 // #8B9099 the lens housing's bright ring
let thrusterGlow = 21 // #D8FDFF the back-pod thruster cores, lit by flight mode (lane 2)
let thrusterCyan = 22 // #1F9BAE the back-pod thruster lenses, lit by flight mode (lane 2)
let gauntletLeft = 23 // ivory left gauntlet, lavender on its inner half, vents on its outer face
let gauntletRight = 24 // ivory right gauntlet, lavender on its inner half, vents on its outer face
let bootCyan = 25 // #1F9BAE the heel lenses' idle pilot light
let bootGlow = 26 // #D8FDFF the heel lenses' pale cores
let pistonSteel = 27 // satin steel piston cylinders
let torsoSuit = 28 // segmented charcoal fabric between the chest and belt
// Slots 6 (cyan), 29 and 30 (lavender) are free.

// Wear is a faint floor on a pristine suit: its coverage stays under the primer's threshold except at the tightest
// edges, where pale primer shows first, then the dark alloy.
let plateWear = 0
let lilacUndercoat = [
  { threshold: 0.2, surface { color: "#C9B4CB", roughness: 0.6, metal: 0.05 } }
  { threshold: 0.38, surface { color: "#51525C", roughness: 0.52, metal: 0.55 } }
]
let creamUndercoat = [
  { threshold: 0.2, surface { color: "#C9B9A6", roughness: 0.65, metal: 0.05 } }
  { threshold: 0.38, surface { color: "#5B5D63", roughness: 0.52, metal: 0.55 } }
]

// The reference's recessed heel jets point 55 degrees below rearward horizontal.
// The cylinder's -Y cap and the lens's -Z face share (0, -sin(55), -cos(55));
// the exhaust volume inherits the lens frame, so it leaves along the same axis.
let bootNozzleRotation = [0.3007058, 0, 0, 0.9537170]
let bootLensRotation = [-0.4617486, 0, 0, 0.8870108]
let bootPlanOutline = [[-0.82, -1], [-1, -0.3], [-0.9, 0.72], [-0.64, 1], [0.64, 1], [0.9, 0.72], [1, -0.3], [0.82, -1]]

let archBackOutline = [
