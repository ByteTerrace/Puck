              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
      ]
      effectors [
        {
          name: "foot-left"
          chain [
            "thigh-left"
            "shin-left"
          ]
          tip: "boot-left"
          // The sole stays flat on the ground however far the planted boot sits from its rest offset, so the boot
          // centre's rest height is the standoff that puts the whole sole on the surface.
          align: 1
          "when" [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [0, 3.1415925]
            // At rest the boot holds its spot and steps once its stance point drifts 9 cm: turning in place, or
            // settling into the stance after a stop.
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
        {
          name: "foot-right"
          chain [
            "thigh-right"
            "shin-right"
          ]
          tip: "boot-right"
          align: 1
          "when" [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [3.1415925, 6.28]
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
      ]
    }
  }
}

render {
  ambientOcclusion: true
  farDistance: 80
  lighting {
    curvature {
      cavity: 0.15
      ink: 0.04
      inkColor: "#241E28"
      inkHigh: 90
      inkLow: 30
      rim: 0.02
    }
    lights [
      directional(name: "key", direction: [3, 5, -4], color: "#FFF0DC", weight: 0.95, shadow: always, angularRadius: 0.2)
      directional(direction: [-0.7, 0.3, -0.65], color: "#DDE3FF", weight: 0.32)
    ]
  }
  renderScale: 1
  shadowLights: 1
  shadows: High
  sky {
    layers [
      gradient(visibility: camera, stops: [
        {
          color: "#8E8AA3"
          elevation: -1
        }
        {
          color: "#BDB8C9"
          elevation: -0.05
        }
        {
          color: "#E8E3EC"
          elevation: 0.35
        }
        {
          color: "#F4EFF2"
          elevation: 1
        }
      ]
      )
      gradient(name: "studio", visibility: lighting, stops: [{ elevation: -1, color: "#151117" }, { elevation: 1, color: "#6E6572" }])
      panel(name: "panel1", direction: [0.6, 1, -0.5], size: [0.25, 0.5], color: "#FFF1E0", intensity: 1.8, blur: 0.15, visibility: lighting)
      panel(name: "panel2", direction: [-0.6, 0.75, 0.6], size: [0.24, 0.6], color: "#EEE4FF", intensity: 1, blur: 0.18, visibility: lighting)
    ]
  }
  atmosphere {
    fog {
      density: 0.012
    }
  }
  upscaleSharpness: 0
  tonemap: Filmic
  environment {
    ambient: 0.4
    reflection: 1
  }
}

// The flight pose and wings deploy only in flight mode; an ordinary jump keeps her upright.
rule "airborne-on" {
  when fact(each, Airborne) == 1 and bodyState(each, flightFuel) > 0
  mode: Edge
  forEach: airPose
  airPose[$each] = 1
  airWings[$each] = 1
}

rule "airborne-off" {
  when fact(each, Airborne) == 0 or bodyState(each, flightFuel) == 0
  mode: Edge
  forEach: airPose
  airPose[$each] = 0
  airWings[$each] = 0
}

// The air jump spends her last jump: the boot jets fire for a quarter second, then ease out.
rule "boot-boost-on" {
  when bodyState(each, jumps) == 0 and fact(each, Airborne) == 1 and bodyState(each, flightFuel) == 0
  mode: Edge
  forEach: bootBoost
  bootBoost[$each] = 1
  schedule bootBoostEnd[$each] in 0.25s
}

rule "boot-boost-off" {
  when bootBoost[$each] == 1 and $tick >= bootBoostEnd[$each]
  mode: Level
  forEach: bootBoost
  bootBoost[$each] = 0
}

rule "blink-close" {
  when blink[$each] == 0 and $tick >= blinkAt[$each]
  mode: Level
  forEach: blink
  blink[$each] = 1
  schedule blinkAt[$each] in 0.12s
}

rule "blink-open" {
  when blink[$each] == 1 and $tick >= blinkAt[$each]
  mode: Level
  forEach: blink
  blink[$each] = 0
  generate(row: blinkRest)
  blinkAt[$each] = $tick + blinkRest
}

// The seat camera's feel: pointer orbit at a milliradian a pixel, and the look stick (or a typed player.look) at 3.5
// radians a second at full deflection. Without it every look input turns the camera by zero.
seatDefaults {
  seatCameraFeel {
    invertPitch: false
    invertYaw: false
    pitchSensitivity: 0.001
    stickLookRate: 3.5
    yawSensitivity: 0.001
  }
}

simulation {
  rateHz: 30
}

spawnPoints [
  // A clean stage for inspection shots, 68 m clear of the debug world's test room, cubes, axis markers and portal.
  {
    id: "hero"
    position [48, 0, -48]
    yawDegrees: 0
  }
  {
    id: "stage"
    position [0, 0, 0]
    yawDegrees: 0
  }
]

state {
  // Flight mode is fuel the flight holds spend: 1000 while switched on (it drains a thousandth a second), 0 off, so the
  // hover and thrust rows are offered only in flight mode. Jumps counts the jumps left before landing.
  body [
    {
      name: "flightFuel"
      kind: "Counter"
      initial: 0
    }
    {
      name: "flightPress"
      kind: "Counter"
      initial: 0
    }
    {
      name: "jumps"
      kind: "Counter"
      initial: 2
      resetFact: "Grounded"
    }
  ]

  world {
    row {
      cells [
        {
          dynamics {
            row: "flight-pose"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      name: "airPose"
    }
    row {
      cells [
        {
          dynamics {
            row: "wing-deploy"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      name: "airWings"
    }
    row {
      cells [
        {
          dynamics {
            row: "boot-boost"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      name: "bootBoost"
    }
    table bootBoostEnd {
      "0" = 0
    }
    table blink {
      "0" = 0
    }
    table blinkAt {
      "0" = 90
    }
    row {
      draw {
        generator {
          bound: 1
          mode: "WithReplacement"
          rangeMax: 150
          rangeMin: 75
          source: "UniformRange"
        }
        skip: 0
        timing: "Event"
      }
      kind: "Int"
      name: "blinkRest"
      value: 90
    }
  }
}

views {
  // The seat's own camera comes first, so it is what a boot shows; the named inspection cameras follow.
  layout "play" {
    seatCount: 0
    slots [
      {
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  cameraLayout("three-quarter")
  cameraLayout("front")
  cameraLayout("rear")
  cameraLayout("flight-stage")

  cameraLayout("head")
  cameraLayout("face")
  cameraLayout("face-side")
  cameraLayout("shoulder")
  cameraLayout("back-close")
  cameraLayout("shoulder-top")
  cameraLayout("boots")
  cameraLayout("knee")
  cameraLayout("boots-side")
  cameraLayout("boots-rear")

  // The legs from eight sides at once, for judging the greaves and boots against the model sheet.
  layout "legs-hero" {
    seatCount: 0
    slots [
      {
        camera: "legs-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "legs-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "legs-left"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "legs-back-left"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "legs-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "legs-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "legs-right"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "legs-front-right"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  // The shoulders from eight sides at once.
  layout "shoulders-hero" {
    seatCount: 0
    slots [
      {
        camera: "shoulders-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "shoulders-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "shoulders-left"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "shoulders-back-left"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "shoulders-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "shoulders-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "shoulders-right"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "shoulders-front-right"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  // The jetpack from eight sides at once.
  layout "pods-hero" {
    seatCount: 0
    slots [
      {
        camera: "pods-rear"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "pods-rear-low"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "pods-top"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "pods-below"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "pods-side-left"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "pods-side-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "pods-front"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "pods-rear-three-quarter"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }

  // A dual-stick third-person action camera: the left stick moves and strafes relative to the camera, the right stick
  // turns the camera and the body with it, and the right-stick press recenters it behind the body.
  seatControl {
    maxPitch: 1.2
    minPitch: -0.5
    yawReference: "World"
  }

  seatRig "moth-camera" {
    version: "puck.camera.program.v1"
    operations [
      orbit(distance: 4.2, opcode: "orbit", pitch: 0.3, pivotOffset: [0, 1, 0], yaw: 0)
      lookAt(focusDistance: 4.2, opcode: "lookAt", subject: reference(), targetOffset: [0, 1, 0], worldAxes: true)
      fieldOfView(fieldOfViewRadians: 0.96, opcode: "fov")
      dynamics(row: `camera-boom`)
    ]
    fovOp {
      fieldOfViewRadians: 0.96
      opcode: "fov"
    }
    lookAtOp {
      focusDistance: 4.2
      opcode: "lookAt"
      subject: reference()
      targetOffset [0, 1, 0]
      worldAxes: true
    }
    orbitOp {
      distance: 4.2
      opcode: "orbit"
      pitch: 0.3
      pivotOffset [0, 1, 0]
      yaw: 0
    }
  }
}
