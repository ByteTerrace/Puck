channels [
  {
    composition: false
    frame: Heading
    name: "forward"
    role: MoveAdvance
    shape: Bipolar
  }
  {
    composition: false
    frame: Heading
    name: "strafe"
    role: MoveStrafe
    shape: Bipolar
  }
  {
    composition: false
    name: "turn"
    role: Turn
    shape: Bipolar
  }
  {
    composition: false
    name: "faceX"
    role: FaceX
    shape: Bipolar
  }
  {
    composition: false
    name: "faceZ"
    role: FaceZ
    shape: Bipolar
  }
  {
    composition: false
    name: "faceY"
    role: FaceY
    shape: Bipolar
  }
  {
    composition: true
    name: "jump"
    shape: Binary
  }
  {
    composition: true
    name: "flight"
    shape: Binary
  }
  {
    composition: false
    name: "rise"
    role: MoveUp
    shape: Bipolar
  }
  // The pad's start button, which the Moth herself ignores: an engaged machine reads it as its own start.
  {
    composition: true
    name: "start"
    shape: Binary
  }
  // The pad's select button, which the Moth herself ignores: an engaged machine reads it as its own select.
  {
    composition: true
    name: "select"
    shape: Binary
  }
  // The context button, which the Moth herself ignores: beside an engageable screen naming it as its engage channel,
  // a press engages that screen and the next press leaves it.
  {
    composition: true
    name: "interact"
    shape: Binary
  }
]

collision {
  contactSkin: 0.02
  defaultHold: false
  gradientProbe: 0
  gridCellSize: 0
  maxIterations: 4
  maxSlopeDegrees: 60
  requirements []
}

// The moth's gait as curves of her pace in metres per second (X), each knot's tangent and curvature those of the
// function it samples. moth-stride is radians of stride per metre, π(1.25 + 0.5v)/v: her step rate rises linearly
// from 1.5 steps a second at 0.5 m/s to 3.75 at 5 m/s while her stride opens from 0.7 m to 2.7 m. moth-gait scales
// every stride swing from half at a walk to whole at a run, and moth-run fades in what only a run has: the bob, the
// forward lean and the bent elbows.
curves [
  {
    name: "moth-stride"
    knots [
      {
        position [0.5, 0, 9.42478]
        tangentYaw: -1.50722
        curvature: 0.016113
      }
      {
        position [0.75, 0, 6.80678]
        tangentYaw: -1.428525
        curvature: 0.053072
      }
      {
        position [1, 0, 5.49779]
        tangentYaw: -1.321448
        curvature: 0.118027
      }
      {
        position [1.5, 0, 4.18879]
        tangentYaw: -1.050498
        curvature: 0.285923
      }
      {
        position [2, 0, 3.53429]
        tangentYaw: -0.776188
        curvature: 0.356734
      }
      {
        position [2.5, 0, 3.14159]
        tangentYaw: -0.560982
        curvature: 0.305147
      }
      {
        position [3, 0, 2.87979]
        tangentYaw: -0.41143
        curvature: 0.223972
      }
      {
        position [4, 0, 2.55254]
        tangentYaw: -0.240679
        curvature: 0.11241
      }
      {
        position [5, 0, 2.35619]
        tangentYaw: -0.155806
        curvature: 0.060576
      }
    ]
  }
  {
    name: "moth-gait"
    knots [
      {
        position [1, 0, 0.5]
        tangentYaw: 0
        curvature: 0.244898
      }
      {
        position [1.875, 0, 0.57812]
        tangentYaw: 0.159352
        curvature: 0.117854
      }
      {
        position [2.75, 0, 0.75]
        tangentYaw: 0.211093
        curvature: 0
      }
      {
        position [3.625, 0, 0.92188]
        tangentYaw: 0.159352
        curvature: -0.117854
      }
      {
        position [4.5, 0, 1]
        tangentYaw: 0
        curvature: -0.244898
      }
    ]
  }
  {
    name: "moth-run"
    knots [
      {
        position [1.5, 0, 0]
        tangentYaw: 0
        curvature: 0.666667
      }
      {
        position [2.25, 0, 0.15625]
        tangentYaw: 0.358771
        curvature: 0.27363
      }
      {
        position [3, 0, 0.5]
        tangentYaw: 0.463648
        curvature: 0
      }
      {
        position [3.75, 0, 0.84375]
        tangentYaw: 0.358771
        curvature: -0.27363
      }
      {
        position [4.5, 0, 1]
        tangentYaw: 0
        curvature: -0.666667
      }
    ]
  }
]

defaultSeatKit: "walker"

dynamics [
  {
    f: 4
    name: "camera-boom"
    r: 0
    zeta: 1
  }
  {
    f: 3
    name: "flight-pose"
    r: 0.5
    zeta: 0.9
  }
  {
    f: 1.2
    name: "wing-deploy"
    r: 0.2
    zeta: 0.8
  }
  // The moth rig's followers: the turn her hips trail and settle from, and the lean her planar acceleration builds.
  {
    f: 2.2
    name: "body-turn"
    r: 0
    zeta: 0.55
  }
  {
    f: 1.8
    name: "body-lean"
    r: 0
    zeta: 0.75
  }
  // Her pace, the speed her gait curves read, settles without overshoot so a stick sweep eases the stride open.
  {
    f: 3
    name: "gait-pace"
    r: 0
    zeta: 1
  }
  // Her vertical speed for the air pose: quick and critically damped, so the tuck follows the arc closely.
  {
    f: 5
    name: "body-air"
    r: 0
    zeta: 1
  }
  // Her vertical speed for the landing give: slow enough to still read the fall a beat after touchdown, and
  // underdamped so the crouch springs back up past rest.
  {
    f: 2.2
    name: "body-land"
    r: 0
    zeta: 0.5
  }
  // The boot jets' flame: lit within a few frames of the air jump and out within a quarter second of its cut.
  {
    f: 6
    name: "boot-boost"
    r: 0
    zeta: 1
  }
]

gravity {
  attractors []
  gravitationalConstant: 0
  isActive: true
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, -18, 0]
}

host {
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  height: 900
  journalDepth: 2000
  presentMode: Vsync
  presentation: Windowed
  surfaceFormat: r8g8b8a8
  targetHertz: 60
  width: 1280
}

kits {
  rows [
    {
      bodyContact: Solid
      bodyMotionProgram: "walk"
      // The capsule stands as tall as the drawn Moth: its 0.35 m spheres span 0 to 2.06 m, the top of the helmet.
      collider: capsule(endpoint: [0, 1.36, 0], radius: 0.35)
      mass: 0
      motion {
        facingSnap: false
        groundStick: 2
        // Flight mode's rows come first and spend flightFuel, so they are offered only while it is switched on: on the
        // ground the rise channel lifts her off, and in the air she hovers and thrusts. Out of flight mode she walks and
        // falls with no hover and no thrust, and jumps instead.
        holds [
          {
            name: "groundFlight"
            bond: Surface
            hold: Gravity
            cone [0, 60]
            reach: 1.2
            forward: Heading
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
            thrust: 1
            spend {
              state: "flightFuel"
              ratePerSecond: 0.001
            }
          }
          {
            name: "ground"
            bond: Surface
            hold: Gravity
            cone [0, 60]
            reach: 1.2
            forward: Heading
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
          }
          {
            name: "flight"
            bond: Free
            hold: Lift
            forward: Heading
            lift: 1
            gravity {
              fall: 46
              rise: 28
            }
            thrust: 1
            spend {
              state: "flightFuel"
              ratePerSecond: 0.001
            }
          }
          {
            name: "fall"
            bond: Free
            hold: Gravity
            forward: Heading
            gravity {
              fall: 46
              rise: 28
            }
            envelope {
              sinkSpeed: 40
            }
          }
        ]
        moveFrame: World
        shaping [
          {
            along {
              engage: 40
              release: 50
            }
            turnScale: 1
          }
        ]
        speed {
          value: 5
        }
        // Knee height: she walks up a kerb or the test room's raised floor; anything taller stops her.
        stepHeight: 0.3
        turn {
          falloff: 1
          maxPitch: 1.2
          pitchRate: 0
          rate: 2.5
        }
      }
      // Out of flight mode, south or space jumps: 5.1 m/s peaks about 1.2 m under the rise the world's 18 m/s² gravity
      // makes of the holds' 28:46 arc, a second press in the air fires the boot jets for one more, and letting go while still rising cuts the
      // arc short. North or F switches flight mode.
      actions {
        jump {
          onPress {
            gate: all(predicates: [
              compareState(state: flightFuel, comparison: Equal, value: 0)
              compareState(state: jumps, comparison: Greater, value: 0)
            ]
            )
            latchSeconds: 0
            effects [
              setVerticalVelocity(velocity: 5.1)
              addState(state: jumps, value: -1)
            ]
          }
          onRelease {
            gate: all(predicates: [
              compareState(state: flightFuel, comparison: Equal, value: 0)
              now(fact: Rising)
            ]
            )
            latchSeconds: 0
            effects [
              scaleVerticalVelocity(factor: 0.45)
            ]
          }
          // Leaving the ground without jumping (walking off a ledge) spends the ground jump, so the one left is the
          // air jump her boot jets push.
          onFact [
            {
              fact: "Airborne"
              mode: "Edge"
              gate: compareState(state: jumps, comparison: Equal, value: 2)
              effects [
                addState(state: jumps, value: -1)
              ]
            }
          ]
        }
        // A press is counted, then flipped on the next tick whether she stands or flies: on to 1000, or off to 0.
        flight {
          onPress {
            latchSeconds: 0
            effects [
              setState(state: flightPress, value: 1)
            ]
          }
          onFact [
            {
              fact: "Grounded"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Equal, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 1000)
                setState(state: flightPress, value: 0)
              ]
            }
            {
              fact: "Airborne"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Equal, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 1000)
                setState(state: flightPress, value: 0)
              ]
            }
            {
              fact: "Grounded"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Greater, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 0)
                setState(state: flightPress, value: 0)
              ]
            }
            {
              fact: "Airborne"
              mode: "Level"
              gate: all(predicates: [
                compareState(state: flightPress, comparison: Greater, value: 0)
                compareState(state: flightFuel, comparison: Greater, value: 0)
              ]
              )
              effects [
                setState(state: flightFuel, value: 0)
                setState(state: flightPress, value: 0)
              ]
            }
          ]
        }
      }

      name: "walker"
    }
  ]
}

looks {
  assignment {
    rows [
      "moth"
    ]
    sequence {
      name: "r1"
      offset: 0
      step: 0
    }
  }
  rows [
    {
      motion {
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
        // Lane 1 is the jets: dark out of flight mode, a pilot flame at a fifth when flight mode is on, full burn as she
        // flies. Lane 2 is flight mode itself, the heel and nozzle glows it lights. Lane 3 is the
        // boot jets' flame under the air jump.
        lanes [
          0
          bodyState($body, flightFuel) / 1000 * (0.2 + 0.8 * airPose[$body])
          bodyState($body, flightFuel) / 1000
          bootBoost[$body]
        ]
        poses {
          blink: "state.blink.$body"
        }
      }
      name: "moth"
      scale: 1
      source: creation(prototypeId: moth)
    }
  ]
}

placements {
  placement "floor" {
    prototype: "floor"
    grip {
      holdable: true
    }
    position [0, 0, 0]
    solid
  }
}

prototypes {
  prototype "floor" {
    document {
      name: "floor"
      palette [
        {
          color: "#ADA69F"
          emissive: 0
          specular: 0.02
          roughness: 0.85
        }
      ]
      schema: "puck.creation.v1"
      shape Box {
        material: skin
        position [0, -0.2, 0]
        scale [18, 0.2, 18]
      }
    }
  }

  prototype "moth" {
    document {
      schema: "puck.creation.v1"
      name: "moth"
      // The blink seats each closed lid over its eye and parks the open eye's pieces behind the face, at the head's scale.
      frames [
        {
          name: "blink"
          transforms: map(blinkPose, row => { id: row[0], position: map([row[1], row[2], row[3]], (v, k) => headAt[k] + (v - mothHeadPivot[k]) * headScale), rotation [0, 0, 0, 1] })
        }
      ]
      // The suit is pristine, as on the sheets: wear reaches only the tightest edges, and faintly.
      palette [
        {
          color: ivoryPlate
          roughness: 0.36
          specular: 0.08
          emissive: 0
          coat: 0.28
          weathering {
            edge: 0.55
            lines: 0
            settle: 0.025
            reach: 0.014
            seed: 71
            scale: 75
            floor: plateWear
            under: creamUndercoat
            deposit { color: "#807568", roughness: 0.85, metal: 0 }
          }
        }
        {
          color: lavenderPlate
          roughness: 0.3
          specular: 0.12
          emissive: 0
          coat: 0.4
          weathering {
            edge: 0.55
            lines: 0
            settle: 0.025
            reach: 0.014
            seed: 72
            scale: 75
            floor: plateWear
            under: lilacUndercoat
            deposit { color: "#807568", roughness: 0.85, metal: 0 }
          }
          // The sole grooves, and the hood's ivory trim in the helmet's frame: a horseshoe round the face opening, its
          // ellipse projected along the face's forward axis; the throat opening leaves the helmet no surface below it.
          paints [
            { parent: "sole-left", type: "Prism", position [0, 0.02, 0.29], rotation [0, diagonal, 0, diagonal], scale [0.0065, 0.0065, 0.3], profile { kind: "Ellipse" }, color: lavenderSeam }
            { parent: "sole-left", type: "Prism", position [0, 0.022, -0.115], rotation [0, diagonal, 0, diagonal], scale [0.0065, 0.0065, 0.3], profile { kind: "Ellipse" }, color: lavenderSeam }
            { parent: "sole-right", type: "Prism", position [0, 0.02, 0.29], rotation [0, diagonal, 0, diagonal], scale [0.0065, 0.0065, 0.3], profile { kind: "Ellipse" }, color: lavenderSeam }
            { parent: "sole-right", type: "Prism", position [0, 0.022, -0.115], rotation [0, diagonal, 0, diagonal], scale [0.0065, 0.0065, 0.3], profile { kind: "Ellipse" }, color: lavenderSeam }
            { parent: "helmet", type: "Prism", position [0, -0.0198, 0.21575], scale [0.24265, 0.26245, 0.2], profile { kind: "Ellipse" }, stroke: 0.0227, color: ivoryPlate }
          ]
        }
        {
          color: "#252630"
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#B76B3C"
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
          wrap: 0.35
          fill: "#8A4A2C"
          // The mouth, in the face's frame: a line where the face crosses a thin quadratic sweep laid on it.
          paints [
            {
              parent: "face"
              type: "Sweep"
              curve {
                a: map([-0.05808, -0.088389, 0.1068], v => v * headScale)
                b: map([0, -0.1141765, 0.1082], v => v * headScale)
                c: map([0.05808, -0.0862981, 0.1078], v => v * headScale)
                radiusStart: 0.0015
                radiusEnd: 0.0015
              }
              color: "#754137"
            }
          ]
        }
        {
          color: "#171210"
          roughness: 0.32
          specular: 0.1
          emissive: 0
          coat: 0.05
          sheen: 0.3
        }
        {
          color: "#FFF8E9"
          roughness: 0.22
          specular: 0.04
          emissive: 0
          coat: 0
          // Where each eye's upper lid and lash meet its white, in the eye's frame: their own curves, half a millimetre
          // wider than the tubes, so the white under a tube's edge reads as the tube rather than two meshes trading pixels.
          paints [
            { parent: "eye-left", type: "Sweep", curve { a: map([-0.047, 0, 0.027], v => v * headScale), b: map([0, 0.066, 0.052], v => v * headScale), c: map([0.047, 0.004, 0.027], v => v * headScale), radiusStart: 0.0045 * headScale, radiusEnd: 0.0045 * headScale }, color: "#171210" }
            { parent: "eye-left", type: "Sweep", curve { a: map([0.04, 0.017, 0.03], v => v * headScale), b: map([0.05, 0.023, 0.023], v => v * headScale), c: map([0.059, 0.023, 0.016], v => v * headScale), radiusStart: 0.0035 * headScale, radiusEnd: 0.0035 * headScale }, color: "#171210" }
            { parent: "eye-right", type: "Sweep", curve { a: map([0.047, 0, 0.027], v => v * headScale), b: map([0, 0.066, 0.052], v => v * headScale), c: map([-0.047, 0.004, 0.027], v => v * headScale), radiusStart: 0.0045 * headScale, radiusEnd: 0.0045 * headScale }, color: "#171210" }
            { parent: "eye-right", type: "Sweep", curve { a: map([-0.04, 0.017, 0.03], v => v * headScale), b: map([-0.05, 0.023, 0.023], v => v * headScale), c: map([-0.059, 0.023, 0.016], v => v * headScale), radiusStart: 0.0035 * headScale, radiusEnd: 0.0035 * headScale }, color: "#171210" }
          ]
        }
        {
          color: "#2ED6EC"
          roughness: 0.25
          specular: 0.04
          emissive: 1.5
          coat: 0
        }
        {
          color: "#754137"
          roughness: 0.6
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#C98F35"
          roughness: 0.42
          specular: 0.04
          emissive: 0
          coat: 0
          metal: 0.2
          weathering {
            edge: 0.5
            lines: 0
            settle: 0.015
            reach: 0.012
            seed: 79
            scale: 45
            floor: plateWear
            under [{ threshold: 0.22, surface { color: "#D0AF70", roughness: 0.6, metal: 0.5 } }]
            deposit { color: "#615B53", roughness: 0.85, metal: 0 }
          }
        }
        {
          color: "#89481D"
          roughness: 0.25
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#120D13"
          roughness: 0.25
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#FFF8EF"
          roughness: 0.2
          specular: 0.04
          emissive: 0.8
          coat: 0
        }
        // The left shoulder stack, in each slab's own frame: an ivory band along the upper slab's lower edge, and the
        // lower slab ivory above its lavender skirt.
