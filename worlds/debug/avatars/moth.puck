      braidChain(0, 122, braid0Position, braid0Rotation)
      braidChain(1, 134, braid1Position, braid1Rotation)

      shape Cylinder "braidTie" {
        id: 146
        position [-0.264, 1.2455, 0.162]
        scale [0.028, 0.009, 0.028]
        material: brass
        parent: "braid-root-2"
        rounding: 0.003
      }

      shape Superellipsoid "braidTassel" {
        id: 147
        position [-0.264, 1.2085, 0.162]
        rotation [0, 0, -0.0998334, 0.9950042]
        scale [0.02, 0.035, 0.016]
        material: ink
        parent: "braid-root-2"
        exponent: softness
      }

      mothLimbs("left", 0)
      mothLimbs("right", 1)

      drivers [
        // A gentle tread while the medium hold carries her shoulders at the surface.
        { name: "swim", signal: "time", cadence: 3.2, blendInSeconds: 0.3, blendOutSeconds: 0.2, when ["InMedium"] }
        {
          name: "dash"
          signal: "state.dashPose.$body"
          cadence: 1
          blendInSeconds: 0
          blendOutSeconds: 0
          when ["always"]
        }
        // Her pace in metres per second, the X every gait curve reads.
        {
          name: "pace"
          cadence: 1
          signal: "speed"
          dynamics: "gait-pace"
          when [
            "always"
          ]
        }
        // The one stride cycle her feet plant on and every gait driver below rides; its radians per metre fall as her
        // pace rises, so her stride lengthens and her step rate climbs more slowly than her speed.
        {
          name: "stride"
          cadence: 1
          signal: "planarTravel"
          cadenceBy {
            driver: "pace"
            curve: "moth-stride"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        // The stride swings, half their amplitude at a walk and whole at a run.
        {
          name: "gait"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-gait"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        // What only a run has: the forward lean and the bent elbows, and at twice the stride's rate, the bob.
        {
          name: "run"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "bob"
          cadence: 2
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          when [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "breath"
          cadence: 1.7
          signal: "time"
          when [
            "still"
          ]
        }
        {
          name: "flight"
          cadence: 1
          signal: "state.airPose.$body"
          when [
            "always"
          ]
        }
        {
          name: "wings"
          cadence: 1
          signal: "state.airWings.$body"
          when [
            "always"
          ]
        }
        {
          name: "bank"
          cadence: 0.26
          signal: "turnRate"
          when [
            "state.airPose.$body"
            "Airborne"
          ]
        }
        {
          name: "cruise"
          cadence: 0.18
          signal: "speed"
          when [
            "state.airPose.$body"
            "Airborne"
            "moving"
          ]
        }
        // Twice the travel direction off the facing: a sine of it peaks on the diagonals and vanishes on a pure
        // strafe or backpedal, and half of it, linear, is the direction itself.
        {
          name: "heading"
          cadence: 2
          signal: "travelDirection"
          blendInSeconds: 0.12
          blendOutSeconds: 0.3
          when [
            "Grounded"
            "moving"
          ]
        }
        // The turn rate through an underdamped response: a part swinging against it trails a turn, catches up a
        // beat after the turn stops and overshoots a little as it settles.
        {
          name: "trail"
          cadence: 1
          signal: "turnRate"
          dynamics: "body-turn"
          when [
            "always"
          ]
        }
        {
          name: "lean"
          cadence: 1
          signal: "lateralAcceleration"
          dynamics: "body-lean"
          when [
            "Grounded"
          ]
        }
        {
          name: "surge"
          cadence: 1
          signal: "forwardAcceleration"
          dynamics: "body-lean"
          when [
            "Grounded"
          ]
        }
        // Her vertical speed in metres per second, eased so the pose follows the arc without the frame's noise:
        // positive rising, zero at the peak, negative falling. It poses her only in the air.
        {
          name: "air"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-air"
          blendInSeconds: 0.06
          blendOutSeconds: 0.04
          when [
            "Airborne"
          ]
        }
        // The same speed through an underdamped response that lags it: touching down, it is still the fall's
        // speed and decays to rest through a small rebound, which is the crouch and the spring back up.
        {
          name: "land"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-land"
          blendInSeconds: 0
          blendOutSeconds: 0.08
          when [
            "Grounded"
          ]
        }
      ]
      // Each pod's exhaust leaves its nozzle 55 degrees back from straight down in the pod's frame and narrows to two and a
      // half times its mouth, so in a straight-legged hover it passes behind the greaves rather than over them (sheet 10).
      volumes [
        {
          kind: "flow"
          parent: "pod-left"
          position [0.0072, -0.4054, -0.2791]
          rotation [0.4617, 0, 0, 0.887]
          halfExtent [0.2, 0.25, 0.2]
          axis: 0.5
          width: 0.0432
          spread: 2.5
          fade: 1.5
          noiseScale: 0.08
          noiseDepth: 0.4
          speed: 1.5
          seed: 31
          steps: 40
          intensity: 90000
          extinction: 1.2
          pulseAmplitude: 0.04
          pulseFrequency: 14
          intensityLane: 1
          ramp [
            {
              density: 0
              color: "#134D8B"
            }
            {
              density: 0.3
              color: "#238EDB"
            }
            {
              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
        {
          kind: "flow"
          parent: "pod-right"
          position [-0.0072, -0.4054, -0.2791]
          rotation [0.4617, 0, 0, 0.887]
          halfExtent [0.2, 0.25, 0.2]
          axis: 0.5
          width: 0.0432
          spread: 2.5
          fade: 1.5
          noiseScale: 0.08
          noiseDepth: 0.4
          speed: 1.5
          seed: 39
          steps: 40
          intensity: 90000
          extinction: 1.2
          pulseAmplitude: 0.04
          pulseFrequency: 14
          intensityLane: 1
          ramp [
            {
              density: 0
              color: "#134D8B"
            }
            {
              density: 0.3
              color: "#238EDB"
            }
            {
              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
        // The boot jets, one out of each heel thruster's lens, dark but for the air jump's boost.
        {
          kind: "flow"
          parent: "heelLight-left"
          position [0, 0, -0.19]
          rotation [0.707107, 0, 0, 0.707107]
          halfExtent [0.08, 0.18, 0.08]
          axis: 0.36
          width: 0.045
          spread: 1.3
          fade: 1.1
          noiseScale: 0.05
          noiseDepth: 0.4
          speed: 2.5
          seed: 53
          steps: 32
          intensity: 330000
          extinction: 1.2
          pulseAmplitude: 0.06
          pulseFrequency: 18
          intensityLane: 3
          ramp [
            {
              density: 0
              color: "#134D8B"
            }
            {
              density: 0.3
              color: "#238EDB"
            }
            {
              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
        {
          kind: "flow"
          parent: "heelLight-right"
          position [0, 0, -0.19]
          rotation [0.707107, 0, 0, 0.707107]
          halfExtent [0.08, 0.18, 0.08]
          axis: 0.36
          width: 0.045
          spread: 1.3
          fade: 1.1
          noiseScale: 0.05
          noiseDepth: 0.4
          speed: 2.5
          seed: 59
          steps: 32
          intensity: 330000
          extinction: 1.2
          pulseAmplitude: 0.06
          pulseFrequency: 18
          intensityLane: 3
          ramp [
            {
              density: 0
              color: "#134D8B"
            }
            {
              density: 0.3
              color: "#238EDB"
            }
            {
              density: 0.65
              color: "#57DCEE"
            }
            {
              density: 1
              color: "#DCFCFF"
            }
          ]
        }
      ]
      effectors [
        {
          name: "foot-left"
          chain [
            "thigh-left"
            "shin-left"
          ]
          tip: "boot-left"
          // The sole stays flat on the ground however far the planted boot sits from its rest offset, so the boot
          // centre's rest height is the standoff that puts the whole sole on the surface.
          align: 1
          when [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [0, 3.1415925]
            // At rest the boot holds its spot and steps once its stance point drifts 9 cm: turning in place, or
            // settling into the stance after a stop.
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
        {
          name: "foot-right"
          chain [
            "thigh-right"
            "shin-right"
          ]
          tip: "boot-right"
          align: 1
          when [
            "Grounded"
          ]
          target {
            kind: "surface"
            direction [0, -1, 0]
            reach: 0.42
            standoff: 0.1875
          }
          plant {
            driver: "stride"
            swingWeight: 0
            window [3.1415925, 6.28]
            replant {
              distance: 0.09
              seconds: 0.2
              height: 0.07
            }
          }
        }
      ]
    }
  }
}

render {
  ambientOcclusion: true
  farDistance: 80
  lighting {
    curvature {
      cavity: 0.15
      ink: 0.04
      inkColor: "#241E28"
      inkHigh: 90
      inkLow: 30
      rim: 0.02
    }
    // The sun, a clear midday's 100,000 lux. The sky fills the shadows: its luminance (each layer's, by default a
    // white surface's under this sun) reaches every surface the irradiance volume finds open to it.
    lights [
      directional(
        name: "key",
        direction: [3, 5, -4],
        color: "#FFF0DC",
        illuminance: 100000lx,
        shadow: always,
        angularRadius: 0.2
      )
    ]
  }
  // The camera adapts like an eye: it meters each view's own picture and eases there over three quarters of a second,
  // from a sunlit day (about EV 14) down to a dim room (EV 7), where a 150-nit screen shows its picture as bright as a
  // display does and a room lit only by it stays dark. The meter averages the middle four fifths of the picture's
  // brightness, leaving out its darkest corners and its light fittings and sun, weights the centre over the edges, and
  // holds while the picture stays within half a stop of what it settled on, so walking through an evenly lit room never
  // moves it. It exposes two and a half stops over the meter's middle grey, the pale, bright look the world was drawn
  // for, and adapts halfway to each surface's own surroundings, so a room beside its sunlit windows reads as the eye
  // sees it rather than as a photograph's dark interior.
  exposure {
    mode: Auto
    minimum: 7
    maximum: 16
    compensation: 2.5
    adaptation: 0.75
    local: 0.5
    band: 0.75
    low: 0.1
    high: 0.9
    center: 0.25
  }
  renderScale: 1
  shadowLights: 1
  shadows: High
  sky {
    layers [
      gradient(visibility: camera, stops: [
        {
          color: "#8E8AA3"
          elevation: -1
        }
        {
          color: "#BDB8C9"
          elevation: -0.05
        }
        {
          color: "#E8E3EC"
          elevation: 0.35
        }
        {
          color: "#F4EFF2"
          elevation: 1
        }
      ])
      gradient(
        name: "studio",
        visibility: lighting,
        stops: [{ elevation: -1, color: "#151117" }, { elevation: 1, color: "#6E6572" }]
      )
      panel(
        name: "panel1",
        direction: [0.6, 1, -0.5],
        size: [0.25, 0.5],
        color: "#FFF1E0",
        intensity: 1.8,
        blur: 0.15,
        visibility: lighting
      )
      panel(
        name: "panel2",
        direction: [-0.6, 0.75, 0.6],
        size: [0.24, 0.6],
        color: "#EEE4FF",
        intensity: 1,
        blur: 0.18,
        visibility: lighting
      )
    ]
  }
  atmosphere {
    fog {
      density: 0.012
    }
  }
  upscaleSharpness: 0
  tonemap: Filmic
  environment {
    ambient: 0.40625
    reflection: 1
  }
}

// Fly: seat 1 pressing rise without jump (the fly bindings, not Space or South, which press both) switches flight mode
// on, so she takes off and climbs. One rule a local seat, since a rule reads a seat as a literal (`bodies.localSeats`).
rule "fly-1" {
  when channel(1, rise) >= 1 and channel(1, jump) == 0 and bodyState(body, 0, flightFuel) == 0
  mode: Level
  setBodyState(key: 0, state: "flightFuel", expression: 1000)
}

// The flight pose and wings deploy only in flight mode; an ordinary jump keeps her upright.
rule "airborne-on" {
  when fact(each, Airborne) == 1 and bodyState(each, flightFuel) > 0
  mode: Edge
  forEach: airPose
  airPose[$each] = 1
  airWings[$each] = 1
}

rule "airborne-off" {
  when fact(each, Airborne) == 0 or bodyState(each, flightFuel) == 0
  mode: Edge
  forEach: airPose
  airPose[$each] = 0
  airWings[$each] = 0
}

// The air jump spends her last jump: the boot jets fire for a quarter second, then ease out.
rule "boot-boost-on" {
  when bodyState(each, jumps) == 0 and fact(each, Airborne) == 1 and bodyState(each, flightFuel) == 0
  mode: Edge
  forEach: bootBoost
  bootBoost[$each] = 1
  schedule bootBoostEnd[$each] in 0.25s
}

rule "boot-boost-off" {
  when bootBoost[$each] == 1 and $tick >= bootBoostEnd[$each]
  mode: Level
  forEach: bootBoost
  bootBoost[$each] = 0
}

rule "blink-close" {
  when blink[$each] == 0 and $tick >= blinkAt[$each]
  mode: Level
  forEach: blink
  blink[$each] = 1
  schedule blinkAt[$each] in 0.12s
}

rule "blink-open" {
  when blink[$each] == 1 and $tick >= blinkAt[$each]
  mode: Level
  forEach: blink
  blink[$each] = 0
  generate(row: blinkRest)
  blinkAt[$each] = $tick + blinkRest
}

simulation {
  rateHz: 30
}

spawnPoints [
  // A clean stage for inspection shots, 68 m clear of the debug world's test room, cubes, axis markers and portal.
  {
    id: "hero"
    position [48, 0, -48]
    yawDegrees: 0
  }
  {
    id: "stage"
    position [0, 0, 0]
    yawDegrees: 0
  }
]

state {
  // Flight mode is fuel the flight holds spend: 1000 while switched on (it drains a thousandth a second), 0 off, so the
  // hover and thrust rows are offered only in flight mode. Jumps counts the jumps left before landing.
  body [
    { name: "dashCooldown", kind: "Timer", initial: 0 }
    { name: "dashActive", kind: "Timer", initial: 0 }
    {
      name: "flightFuel"
      kind: "Counter"
      initial: 0
      envelope { $type: "range", minimum: 0, maximum: 1000 }
    }
    {
      name: "flightPress"
      kind: "Counter"
      initial: 0
    }
    {
      name: "jumps"
      kind: "Counter"
      initial: 2
      resetFact: "Grounded"
    }
  ]

  enums [
    { name: "MothStyle", members ["Plain", "Cel"] }
  ]

  world {
    // Her look (mothStyles): Plain shades every slot continuously, Cel with the standard's celStyle.
    slot mothStyle: MothStyle = 0

    row {
      name: "dashPose"
      kind: "Fixed"
      capacity: 1
      cells [{ key: "0", value: "0", dynamics { row: "flight-pose" } }]
    }
    row {
      cells [
        {
          dynamics {
            row: "flight-pose"
          }
          key: "0"
          value: "0"
        }
      ]
      capacity: 1
      kind: "Fixed"
      name: "airPose"
    }
    row {
      cells [
        {
          dynamics {
            row: "wing-deploy"
          }
          key: "0"
          value: "0"
        }
      ]
      kind: "Fixed"
      name: "airWings"
    }
    row {
      cells [
        {
          dynamics {
            row: "boot-boost"
          }
          key: "0"
          value: "0"
        }
      ]
      capacity: 1
      kind: "Fixed"
      name: "bootBoost"
    }
    table bootBoostEnd {
      "0" = 0
    }
    table blink capacity(1) {
      "0" = 0
    }
    table blinkAt {
      "0" = 90
    }
    row {
      draw {
        generator {
          bound: 1
          mode: "WithReplacement"
          rangeMax: 150
          rangeMin: 75
          source: "UniformRange"
        }
        skip: 0
        timing: "Event"
      }
      kind: "Int"
      name: "blinkRest"
      value: 90
    }
  }
}

commands [
  {
    name: "moth.style"
    help: "Swaps the Moth's look for playtesting: Plain shades every slot of her suit continuously, Cel with the standard's cel style. Writes the mothStyle row her palette's style selection reads; only her materials' style rows change, so nothing bakes."
    parameters [
      { name: "style", kind: Choice, values ["Plain", "Cel"] }
    ]
    lines [
      "world.state.cell.set mothStyle $value {style}"
    ]
  }
]

views {
  // The seat's own camera comes first, so it is what a boot shows; the named inspection cameras follow.
  layout "play" {
    seatCount: 0
    slots [
      {
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
  }

  cameraLayout("three-quarter")
  cameraLayout("front")
  cameraLayout("rear")
  cameraLayout("flight-stage")

  cameraLayout("head")
  cameraLayout("face")
  cameraLayout("face-side")
  cameraLayout("shoulder")
  cameraLayout("back-close")
  cameraLayout("shoulder-top")
  cameraLayout("boots")
  cameraLayout("knee")
  cameraLayout("boots-side")
  cameraLayout("boots-rear")

  // The legs from eight sides at once, for judging the greaves and boots against the model sheet.
  layout "legs-hero" {
    seatCount: 0
    slots [
      {
        camera: "legs-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "legs-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
