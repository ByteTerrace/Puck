            driver: "flight"
            axis [1, 0, 0]
            amplitude: -1
            pivot [-0.19, 0.7465, 0]
            wave: "linear"
            phase: 0
          }
          // The knee folds 1.2 rad at the peak, 1.45 rising and 0.95 falling, the shin a little behind the knee.
