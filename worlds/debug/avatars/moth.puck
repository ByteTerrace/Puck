      shape Superellipsoid "pelvis" {
        id: 1
        position [0, 1.0215, 0]
        scale [0.195, 0.1425, 0.1475]
        material: charcoal
        exponent: softness
        // The whole body rides the pelvis: it turns its hips into a diagonal (0.7 rad at 45 degrees off the facing,
        // none in a pure strafe or backpedal), trails a turn by 0.12 s of turn rate, and leans about the ground into
        // its planar acceleration, sideways into a curving run and forward into a start.
        swings [
          swing("gait", [0, 1, 0], 0.08, [0, 1.0765, 0]) with { wave: "sine", phase: 0 }
          // Moving in flight pitches the whole body 0.6 rad about her middle, so the legs trail behind; the cruise gate
          // eases it in and out. A constant wave: the pitch is a pose, the same at any speed.
          swing("cruise", [1, 0, 0], 0.6, [0, 1, 0]) with { wave: "constant", phase: 0 }
          swing("gait", [0, 0, 1], 0.05, [0, 1.0765, 0]) with { wave: "sine", phase: 0 }
          swing("heading", [0, 1, 0], 0.7, [0, 1.0765, 0]) with { wave: "sine" }
          swing("trail", [0, 1, 0], -0.12, [0, 1.0765, 0]) with { wave: "linear" }
          swing("lean", [0, 0, 1], -0.016, [0, 0, 0]) with { wave: "linear" }
          swing("surge", [1, 0, 0], 0.006, [0, 0, 0]) with { wave: "linear" }
          // Landing pitches her forward about the ground point, 0.08 rad at 4 m/s.
          swing("land", [1, 0, 0], -0.02, [0, 0, 0]) with { wave: "linear" }
        ]
        slides [
          {
            driver: "bob"
            axis [0, 1, 0]
            amplitude: 0.022
            phase: -1.5708
            wave: "sine"
          }
          // And drops her hips 10 cm at 4 m/s; the planted feet fold the legs under them.
          {
            driver: "land"
            axis [0, 1, 0]
            amplitude: 0.025
            wave: "linear"
          }
        ]
      }

      shape Superellipsoid "torso" {
        id: 2
        position [0, 1.2915, 0]
        scale [0.15, 0.285, 0.1225]
        material: torsoSuit
        parent: "pelvis"
        exponent: softness
        // The chest turns most of the way back from the hips toward the facing and leads a turn the hips trail.
        swings [
          swing("dash", [1, 0, 0], 0.4, [0, 1.0765, 0]) with { wave: "linear" }
          swing("gait", [0, 1, 0], -0.16, [0, 1.0765, 0]) with { wave: "sine", phase: 0 }
          swing("bob", [1, 0, 0], -0.025, [0, 1.0765, 0]) with { wave: "sine", phase: -1.0708 }
          swing("heading", [0, 1, 0], -0.4, [0, 1.0765, 0]) with { wave: "sine" }
          swing("trail", [0, 1, 0], 0.08, [0, 1.0765, 0]) with { wave: "linear" }
          swing("bank", [0, 0, 1], -0.2, [0, 1.0765, 0]) with { wave: "linear", phase: 0 }
          swing("run", [1, 0, 0], 0.1, [0, 1.0765, 0]) with { wave: "constant", phase: 0 }
        ]
        slides [
          {
            driver: "breath"
            axis [0, 1, 0]
            amplitude: 0.003
            phase: 0
            wave: "sine"
          }
        ]
      }

