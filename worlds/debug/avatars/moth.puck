      operations [
        anchor(opcode: "anchor", subject: worldPoint(point: [0.9, 0.55, -1.7]))
        lookAt(focusDistance: 6, opcode: "lookAt", subject: worldPoint(point: [0, 0.35, 0]), worldAxes: false)
        fieldOfView(fieldOfViewRadians: 0.6, opcode: "fov")
      ]
