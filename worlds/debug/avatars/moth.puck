            driver: "air"
            axis [1, 0, 0]
            amplitude: 0.05
            pivot [-0.19, 0.7465, 0]
            wave: "linear"
            phase: 24
          }
          // The knee takes twice the hip's fold.
          {
            driver: "land"
            axis [1, 0, 0]
            amplitude: -0.2
            pivot [-0.19, 0.7465, 0]
            wave: "linear"
          }
        ]
      }

