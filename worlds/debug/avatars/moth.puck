  // The shoulders from eight sides at once.
  layout "shoulders-hero" {
    seatCount: 0
    slots [
      {
        camera: "shoulders-front"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "shoulders-front-left"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "shoulders-left"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "shoulders-back-left"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "shoulders-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "shoulders-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "shoulders-right"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "shoulders-front-right"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
  }

  // The jetpack from eight sides at once.
  layout "pods-hero" {
    seatCount: 0
    slots [
      {
        camera: "pods-rear"
        height: 0.5
        width: 0.25
        x: 0
        y: 0
      }
      {
        camera: "pods-rear-low"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0
      }
      {
        camera: "pods-top"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0
      }
      {
        camera: "pods-below"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "pods-side-left"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "pods-side-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "pods-front"
        height: 0.5
        width: 0.25
        x: 0.5
        y: 0.5
      }
      {
        camera: "pods-rear-three-quarter"
        height: 0.5
        width: 0.25
        x: 0.75
        y: 0.5
      }
    ]
  }
}

// The simulation timer drives one eased presentation cell for the torso lean and back-pod burn.
rule "dash-pose-on" {
  when bodyState(each, dashActive) > 0
  mode: Edge
  forEach: dashPose
  dashPose[$each] = 1
}
rule "dash-pose-off" {
  when bodyState(each, dashActive) == 0
  mode: Edge
  forEach: dashPose
  dashPose[$each] = 0
}
