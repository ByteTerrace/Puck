        width: 0.25
        x: 0.75
        y: 0
      }
      {
        camera: "legs-back"
        height: 0.5
        width: 0.25
        x: 0
        y: 0.5
      }
      {
        camera: "legs-back-right"
        height: 0.5
        width: 0.25
        x: 0.25
        y: 0.5
      }
      {
        camera: "legs-right"
        height: 0.5
        width: 0.25
        x: 0.5
