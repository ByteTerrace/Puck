]

defaultSeatKit: "walker"

dynamics [
  {
    f: 3
    name: "flight-pose"
    r: 0.5
    zeta: 0.9
  }
  {
    f: 1.2
    name: "wing-deploy"
    r: 0.2
    zeta: 0.8
  }
  // The moth rig's followers: the turn her hips trail and settle from, and the lean her planar acceleration builds.
  {
    f: 2.2
    name: "body-turn"
    r: 0
    zeta: 0.55
  }
  {
    f: 1.8
    name: "body-lean"
    r: 0
    zeta: 0.75
  }
  // Her pace, the speed her gait curves read, settles without overshoot so a stick sweep eases the stride open.
  {
    f: 3
    name: "gait-pace"
    r: 0
    zeta: 1
  }
  // Her vertical speed for the air pose: quick and critically damped, so the tuck follows the arc closely.
  {
    f: 5
    name: "body-air"
    r: 0
    zeta: 1
  }
  // Her vertical speed for the landing give: slow enough to still read the fall a beat after touchdown, and
  // underdamped so the crouch springs back up past rest.
  {
    f: 2.2
    name: "body-land"
    r: 0
    zeta: 0.5
  }
  // The boot jets' flame: lit within a few frames of the air jump and out within a quarter second of its cut.
  {
    f: 6
    name: "boot-boost"
    r: 0
    zeta: 1
  }
]

gravity {
  attractors []
  gravitationalConstant: 0
  isActive: true
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, -18, 0]
}

host {
  backend: auto
  exitAfterSeconds: 0
  fullscreen: false
  height: 900
  journalDepth: 2000
  presentMode: Vsync
  presentation: Windowed
  surfaceFormat: r8g8b8a8
  targetHertz: 60
  width: 1280
}

// Her flight holds spend flightFuel at one rate: the ground hold that thrusts as well, and the lift that carries her in
// the air at her running pace (running in the air doubles it).
let flightSpend = { state: "flightFuel", ratePerSecond: 0.001 }
let groundFlightHold = groundHold with { name: "groundFlight", thrust: 1, spend: flightSpend }
let flightHold = {
  name: "flight"
  bond: Free
  hold: Lift
  forward: Heading
  lift: 1
  speed: 5
  gravity: standardGravity
  thrust: 1
  spend: flightSpend
}

kits [
  {
    bodyContact: Solid
    bodyMotionProgram: "walk"
    // The capsule stands as tall as the drawn Moth: its 0.35 m spheres span 0 to 2.06 m, the top of the helmet.
    collider: capsule(endpoint: [0, 1.36, 0], radius: 0.35)
    mass: 0
    // Water leads: where the world has a medium at her cell (water.puck's pool) she swims, floating with her feet 1.25 m
    // under the surface, which leaves her shoulders at it, and wading at half her walking pace; the MoveUp channel dives and
    // surfaces her. A world with no medium never offers it.
    // Flight mode's rows spend flightFuel, so they are offered only while it is switched on: on the
    // ground the rise channel lifts her off, and in the air she hovers and thrusts. Out of flight mode she walks and
    // falls with no hover and no thrust, and jumps instead. She walks at 5 m/s and runs at 10 while the run channel is
    // held, and steps up to knee height: a kerb or the test room's raised floor, and nothing taller.
    motion: walkerMotion with {
      holds [
        swimHold(equilibriumOffset: 1.25, settleRate: 2.5, speed: 2.5)
        groundFlightHold
        groundHold
        flightHold
        fallHold
      ]
      speed: walkerMotion.speed with { value: 5 }
    }
    // Out of flight mode, south or space jumps: 5.1 m/s peaks about 1.2 m under the rise the world's 18 m/s² gravity
    // makes of the holds' 28:46 arc, a second press in the air fires the boot jets for one more, and letting go while still rising cuts the
    // arc short. North or F switches flight mode.
    actions {
      jump {
        onPress {
          gate: all(predicates: [
            compareState(state: flightFuel, comparison: Equal, value: 0)
            compareState(state: jumps, comparison: Greater, value: 0)
          ])
          latchSeconds: 0
          effects [
            setVerticalVelocity(velocity: 5.1)
            addState(state: jumps, value: -1)
          ]
        }
        onRelease {
          gate: all(predicates: [
            compareState(state: flightFuel, comparison: Equal, value: 0)
            now(fact: Rising)
          ])
          latchSeconds: 0
          effects [
            scaleVerticalVelocity(factor: 0.45)
          ]
        }
        // Leaving the ground without jumping (walking off a ledge) spends the ground jump, so the one left is the
        // air jump her boot jets push.
        onFact [
          {
            fact: "Airborne"
            mode: "Edge"
            gate: compareState(state: jumps, comparison: Equal, value: 2)
            effects [
              addState(state: jumps, value: -1)
            ]
          }
        ]
      }
      // A press is counted, then flipped on the next tick whether she stands or flies: on to 1000, or off to 0.
      flight {
        onPress {
          latchSeconds: 0
          effects [
            setState(state: flightPress, value: 1)
          ]
        }
        onFact [
          {
            fact: "Grounded"
            mode: "Level"
            gate: all(predicates: [
              compareState(state: flightPress, comparison: Greater, value: 0)
              compareState(state: flightFuel, comparison: Equal, value: 0)
            ])
            effects [
              setState(state: flightFuel, value: 1000)
              setState(state: flightPress, value: 0)
            ]
          }
          {
            fact: "Airborne"
            mode: "Level"
            gate: all(predicates: [
              compareState(state: flightPress, comparison: Greater, value: 0)
              compareState(state: flightFuel, comparison: Equal, value: 0)
            ])
            effects [
              setState(state: flightFuel, value: 1000)
              setState(state: flightPress, value: 0)
            ]
          }
          {
            fact: "Grounded"
            mode: "Level"
            gate: all(predicates: [
              compareState(state: flightPress, comparison: Greater, value: 0)
              compareState(state: flightFuel, comparison: Greater, value: 0)
            ])
            effects [
              setState(state: flightFuel, value: 0)
              setState(state: flightPress, value: 0)
            ]
          }
          {
            fact: "Airborne"
            mode: "Level"
            gate: all(predicates: [
              compareState(state: flightPress, comparison: Greater, value: 0)
              compareState(state: flightFuel, comparison: Greater, value: 0)
            ])
            effects [
              setState(state: flightFuel, value: 0)
              setState(state: flightPress, value: 0)
            ]
          }
        ]
      }
    }

    name: "walker"
  }
]

looks {
  assignment {
    rows [
      "moth"
    ]
    sequence {
      name: "r1"
      offset: 0
      step: 0
    }
  }
  rows [
    {
      motion {
        gaitAmplitude: 0
        replayFrames: false
        secondsPerFrame: 0
        // Lane 1 is the jets: dark out of flight mode, a pilot flame at a fifth when flight mode is on, full burn as she
        // flies. Lane 2 is flight mode itself, the heel and nozzle glows it lights. Lane 3 is the
        // boot jets' flame under the air jump.
        lanes [
          0
          maximum(bodyState($body, flightFuel) / 1000 * (0.2 + 0.8 * airPose[$body]), dashPose[$body])
          maximum(bodyState($body, flightFuel) / 1000, dashPose[$body])
          bootBoost[$body]
        ]
        poses {
          blink: "state.blink.$body"
        }
      }
      name: "moth"
      scale: 1
      source: creation(prototypeId: moth)
    }
  ]
}

placements {
  placement "floor" {
    prototype: "floor"
    grip {
      holdable: true
    }
    position [0, 0, 0]
    solid
  }
}

prototypes {
  prototype "floor" {
    document {
      name: "floor"
      palette [
        {
          color: "#ADA69F"
          emissive: 0
          specular: 0.02
          roughness: 0.85
        }
      ]
      schema: "puck.creation.v1"
      shape Box "ground" {
        material: skin
        position [0, -0.2, 0]
        scale [18, 0.2, 18]
      }
    }
  }

  prototype "moth" {
    document {
      schema: "puck.creation.v1"
      name: "moth"
      // The blink seats each closed lid over its eye and parks the open eye's pieces behind the face, at the head's scale.
      frames [mothBlinkFrame(headAt, headScale)]
      // The suit is pristine, as on the sheets: wear reaches only the tightest edges, and faintly.
      palette [
        {
          color: ivoryPlate
          toonSelect: mothStyles
          roughness: 0.36
          specular: 0.08
          emissive: 0
          coat: 0.28
          weathering {
            edge: 0.55
            lines: 0
            settle: 0.025
            reach: 0.014
            seed: 71
            scale: 75
            floor: plateWear
            under: creamUndercoat
            deposit { color: "#807568", roughness: 0.85, metal: 0 }
          }
        }
        {
          color: lavenderPlate
          toonSelect: mothStyles
          roughness: 0.3
          specular: 0.12
          emissive: 0
          coat: 0.4
          weathering {
            edge: 0.55
            lines: 0
            settle: 0.025
            reach: 0.014
            seed: 72
            scale: 75
            floor: plateWear
            under: lilacUndercoat
            deposit { color: "#807568", roughness: 0.85, metal: 0 }
          }
          // The sole grooves, and the hood's ivory trim in the helmet's frame: a horseshoe round the face opening, its
          // ellipse projected along the face's forward axis; the throat opening leaves the helmet no surface below it.
          paints [
            {
              parent: "sole-left"
              type: "Prism"
              position [0, 0.02, 0.29]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "sole-left"
              type: "Prism"
              position [0, 0.022, -0.115]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "sole-right"
              type: "Prism"
              position [0, 0.02, 0.29]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "sole-right"
              type: "Prism"
              position [0, 0.022, -0.115]
              rotation [0, diagonal, 0, diagonal]
              scale [0.0065, 0.0065, 0.3]
              profile { kind: "Ellipse" }
              color: lavenderSeam
            }
            {
              parent: "helmet"
              type: "Prism"
              position [0, -0.0198, 0.21575]
              scale [0.24265, 0.26245, 0.2]
              profile { kind: "Ellipse" }
              stroke: 0.0227
              color: ivoryPlate
            }
          ]
        }
        {
          color: "#252630"
          toonSelect: mothStyles
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#B76B3C"
          toonSelect: mothStyles
          roughness: 0.62
          specular: 0.04
          emissive: 0
          coat: 0
          wrap: 0.35
          fill: "#8A4A2C"
          // The mouth, in the face's frame: a line where the face crosses a thin quadratic sweep laid on it.
          paints [
            {
              parent: "face"
              type: "Sweep"
              curve {
                a: map([-0.05808, -0.088389, 0.1068], v => v * headScale)
                b: map([0, -0.1141765, 0.1082], v => v * headScale)
                c: map([0.05808, -0.0862981, 0.1078], v => v * headScale)
                radiusStart: 0.0015
                radiusEnd: 0.0015
              }
              color: "#754137"
            }
          ]
        }
        {
          color: "#171210"
          toonSelect: mothStyles
          roughness: 0.32
          specular: 0.1
          emissive: 0
          coat: 0.05
          sheen: 0.3
        }
        {
          color: "#FFF8E9"
          toonSelect: mothStyles
          roughness: 0.22
          specular: 0.04
          emissive: 0
          coat: 0
          paints: mothLidPaints(headScale)
        }
        {
          color: "#2ED6EC"
          toonSelect: mothStyles
          roughness: 0.25
          specular: 0.04
          emissive: 2250
          coat: 0
        }
        {
          color: "#754137"
          toonSelect: mothStyles
          roughness: 0.6
          specular: 0.04
          emissive: 0
          coat: 0
        }
        {
          color: "#C98F35"
          toonSelect: mothStyles
          roughness: 0.42
          specular: 0.04
          emissive: 0
          coat: 0
          metal: 0.2
          weathering {
            edge: 0.5
