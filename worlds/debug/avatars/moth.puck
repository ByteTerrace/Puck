      drivers [
        // Her pace in metres per second, the X every gait curve reads.
        {
          name: "pace"
          cadence: 1
          signal: "speed"
          dynamics: "gait-pace"
          "when" [
            "always"
          ]
        }
        // The one stride cycle her feet plant on and every gait driver below rides; its radians per metre fall as her
        // pace rises, so her stride lengthens and her step rate climbs more slowly than her speed.
        {
          name: "stride"
          cadence: 1
          signal: "planarTravel"
          cadenceBy {
            driver: "pace"
            curve: "moth-stride"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        // The stride swings, half their amplitude at a walk and whole at a run.
        {
          name: "gait"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-gait"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        // What only a run has: the forward lean and the bent elbows, and at twice the stride's rate, the bob.
        {
          name: "run"
          cadence: 1
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "bob"
          cadence: 2
          signal: "driver.stride"
          weightBy {
            driver: "pace"
            curve: "moth-run"
          }
          "when" [
            "Grounded"
            "moving"
          ]
        }
        {
          name: "breath"
          cadence: 1.7
          signal: "time"
          "when" [
            "still"
          ]
        }
        {
          name: "flight"
          cadence: 1
          signal: "state.airPose.$body"
          "when" [
            "always"
          ]
        }
        {
          name: "wings"
          cadence: 1
          signal: "state.airWings.$body"
          "when" [
            "always"
          ]
        }
        {
          name: "bank"
          cadence: 0.26
          signal: "turnRate"
          "when" [
            "state.airPose.$body"
            "Airborne"
          ]
        }
        {
          name: "cruise"
          cadence: 0.18
          signal: "speed"
          "when" [
            "state.airPose.$body"
            "Airborne"
            "moving"
          ]
        }
        // Twice the travel direction off the facing: a sine of it peaks on the diagonals and vanishes on a pure
        // strafe or backpedal, and half of it, linear, is the direction itself.
        {
          name: "heading"
          cadence: 2
          signal: "travelDirection"
          blendInSeconds: 0.12
          blendOutSeconds: 0.3
          "when" [
            "Grounded"
            "moving"
          ]
        }
        // The turn rate through an underdamped response: a part swinging against it trails a turn, catches up a
        // beat after the turn stops and overshoots a little as it settles.
        {
          name: "trail"
          cadence: 1
          signal: "turnRate"
          dynamics: "body-turn"
          "when" [
            "always"
          ]
        }
        {
          name: "lean"
          cadence: 1
          signal: "lateralAcceleration"
          dynamics: "body-lean"
          "when" [
            "Grounded"
          ]
        }
        {
          name: "surge"
          cadence: 1
          signal: "forwardAcceleration"
          dynamics: "body-lean"
          "when" [
            "Grounded"
          ]
        }
        // Her vertical speed in metres per second, eased so the pose follows the arc without the frame's noise:
        // positive rising, zero at the peak, negative falling. It poses her only in the air.
        {
          name: "air"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-air"
          blendInSeconds: 0.06
          blendOutSeconds: 0.04
          "when" [
            "Airborne"
          ]
        }
        // The same speed through an underdamped response that lags it: touching down, it is still the fall's
        // speed and decays to rest through a small rebound, which is the crouch and the spring back up.
        {
          name: "land"
          cadence: 1
          signal: "verticalSpeed"
          dynamics: "body-land"
          blendInSeconds: 0
          blendOutSeconds: 0.08
          "when" [
            "Grounded"
          ]
        }
      ]
