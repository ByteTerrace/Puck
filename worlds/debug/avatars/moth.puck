      shape Sweep "thigh-left" {
        id: 174
        position [0.135, 1.0265, 0]
        material: charcoal
        parent: "pelvis"
        curve {
          a [0, 0, 0]
          b [0.025, -0.135, 0]
          c [0.05, -0.285, 0]
          radiusStart: 0.095
          radiusEnd: 0.095
        }
        // The stride swings in the plane of travel: the hip's own turn into the travel direction is undone, the plane
        // is turned to the full travel direction, the leg strides, and both turns are put back. A forward diagonal
        // strides straight ahead of the turned hips, a pure strafe abducts into a sidestep, and a backpedal strides
        // backward.
        swings [
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: 0.7
            pivot [0.145, 1.0265, 0]
            wave: "sine"
          }
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: -0.5
            pivot [0.145, 1.0265, 0]
            wave: "linear"
          }
          {
            driver: "gait"
            axis [1, 0, 0]
            amplitude: 0.7
            pivot [0.145, 1.0265, 0]
            wave: "sine"
            phase: 0
          }
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0.145, 1.0265, 0]
            wave: "linear"
          }
          {
            driver: "heading"
            axis [0, 1, 0]
            amplitude: -0.7
            pivot [0.145, 1.0265, 0]
            wave: "sine"
          }
          // In flight mode the hip undoes the air tuck the hover would hold at zero vertical speed (0.8 rad) and trails
          // the leg 0.1 rad back, so she hovers and flies with straight legs.
          {
            driver: "flight"
            axis [1, 0, 0]
            amplitude: 0.898
            pivot [0.145, 1.0265, 0]
            wave: "linear"
            phase: 0
          }
          // In the air the thigh lifts 0.8 rad at the peak, 1.1 on the way up and 0.5 reaching for the ground.
          {
            driver: "air"
            axis [1, 0, 0]
            amplitude: -0.06
            pivot [0.145, 1.0265, 0]
            wave: "linear"
            phase: 13.3
          }
          // Touching down at about 4 m/s the hip folds 0.4 rad into the crouch, and springs back as the give settles.
          {
            driver: "land"
            axis [1, 0, 0]
            amplitude: 0.1
            pivot [0.145, 1.0265, 0]
            wave: "linear"
          }
        ]
      }

