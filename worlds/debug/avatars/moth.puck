        phase: bySide(isRight, 5.184, 2.0424)
      }
      // And the knee undoes its 1.2 rad of air tuck, keeping a 0.2 rad bend.
      swing("flight", [1, 0, 0], -1, mirrorX(isRight, [0.19, 0.7465, 0])) with { wave: "linear", phase: 0 }
      // The knee folds 1.2 rad at the peak, 1.45 rising and 0.95 falling, the shin a little behind the knee.
      swing("air", [1, 0, 0], 0.05, mirrorX(isRight, [0.19, 0.7465, 0])) with { wave: "linear", phase: 24 }
      // The knee takes twice the hip's fold.
      swing("land", [1, 0, 0], -0.2, mirrorX(isRight, [0.19, 0.7465, 0])) with { wave: "linear" }
    ]
  }

