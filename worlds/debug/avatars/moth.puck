  [-1, 0]
  [-0.809, 0.588]
  [-0.309, 0.951]
  [0.309, 0.951]
  [0.809, 0.588]
  [1, 0]
  [1, -1]
]

// Values repeated across the body, named so changing one changes the moth rather than 120 shapes.
let softness = 2.1 // the superellipsoid exponent every rounded body part shares
let diagonal = 0.7071068 // sin/cos of 45 degrees, the quarter-turn quaternion component
let braidTwist = 0.247404 // sin of the braid's half-angle
let braidUntwist = 0.9689124 // cos of the same
