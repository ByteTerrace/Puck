        curvature: 0.356734
      }
      {
        position [2.5, 0, 3.14159]
        tangentYaw: -0.560982
        curvature: 0.305147
      }
      {
        position [3, 0, 2.87979]
        tangentYaw: -0.41143
        curvature: 0.223972
      }
      {
        position [4, 0, 2.55254]
        tangentYaw: -0.240679
        curvature: 0.11241
      }
      {
        position [5, 0, 2.35619]
        tangentYaw: -0.155806
        curvature: 0.060576
      }
    ]
  }
  {
    name: "moth-gait"
    knots [
      {
        position [1, 0, 0.5]
        tangentYaw: 0
        curvature: 0.244898
      }
      {
        position [1.875, 0, 0.57812]
        tangentYaw: 0.159352
        curvature: 0.117854
      }
      {
        position [2.75, 0, 0.75]
        tangentYaw: 0.211093
        curvature: 0
      }
      {
        position [3.625, 0, 0.92188]
        tangentYaw: 0.159352
        curvature: -0.117854
      }
      {
        position [4.5, 0, 1]
        tangentYaw: 0
        curvature: -0.244898
      }
    ]
  }
  {
    name: "moth-run"
    knots [
      {
        position [1.5, 0, 0]
