template cameraLayout(name) {
  layout name {
    seatCount: 0
    slots [
      {
        camera: name
        height: 1
        width: 1
        x: 0
        y: 0
      }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }
}

template braidChain(chainIdx, baseId, positions, rotations) {
  for i in range(0, 12) {
    shape Superellipsoid $"braid-{chainIdx}-{i}" {
      id: baseId + i
      blend: "Union"
      exponent: softness
      material: ink
      parent: braidParent[i]
      position: positions[i]
      rotation: rotations[i]
      scale [0.014, 0.026, 0.016]
      smooth: 0
    }
  }
}

documentId: "moth-flight-studio"

bindingOverlays [
  {
    document {
      chords [
        {
          chord []
          group: "play"
          page {
            entries [
              {
                channel: "forward"
                id: "forward"
                scale: 1
                sources [
                  "keyboard.w"
                  "keyboard.arrowUp"
                  "gamepad.dpadUp"
                ]
              }
              {
                channel: "forward"
                id: "back"
                scale: -1
                sources [
                  "keyboard.s"
                  "keyboard.arrowDown"
                  "gamepad.dpadDown"
                ]
              }
              {
                channel: "strafe"
                id: "left"
                scale: -1
                sources [
                  "keyboard.a"
                  "gamepad.dpadLeft"
                ]
              }
              {
                channel: "strafe"
                id: "right"
                scale: 1
                sources [
                  "keyboard.d"
                  "gamepad.dpadRight"
                ]
              }
              {
                channel: "turn"
                id: "turnLeft"
                scale: 1
                sources [
                  "keyboard.arrowLeft"
                ]
              }
              {
                channel: "turn"
                id: "turnRight"
                scale: -1
                sources [
                  "keyboard.arrowRight"
                ]
              }
              {
                command: "player.move.strafe"
                id: "move"
                sources [
                  "gamepad.leftStick"
                ]
              }
              {
                command: "player.look.steer"
                id: "look"
                sources [
                  "gamepad.rightStick"
                ]
              }
              {
                command: "player.look.recenter"
                id: "recenter"
                label: "Recenter"
                sources [
                  "keyboard.r"
                  "gamepad.rightStickPress"
                ]
              }
              {
                command: "player.orbit"
                id: "orbit"
                sources [
                  "mouse.button1"
                ]
              }
              {
                command: "player.steer"
                id: "steer"
                label: "Steer"
                sources [
                  "mouse.button2"
                ]
              }
              {
                channel: "flight"
                id: "flight"
                scale: 1
                sources [
                  "keyboard.f"
                  "gamepad.buttonNorth"
                ]
              }
              {
                channel: "rise"
                id: "rise"
                scale: 1
                sources [
                  "keyboard.space"
                  "gamepad.buttonSouth"
                ]
              }
              {
                channel: "jump"
                id: "jump"
                scale: 1
                sources [
                  "keyboard.space"
                  "gamepad.buttonSouth"
                ]
              }
              {
                channel: "rise"
                id: "descend"
                scale: -1
                sources [
                  "keyboard.controlLeft"
                  "keyboard.controlRight"
                  "gamepad.buttonEast"
                ]
              }
              {
                channel: "start"
                id: "start"
                scale: 1
                sources [
                  "keyboard.enter"
                  "gamepad.start"
                ]
              }
              {
                channel: "select"
                id: "select"
                scale: 1
                sources [
                  "keyboard.shiftRight"
                  "gamepad.back"
                ]
              }
              {
                channel: "interact"
                id: "interact"
                scale: 1
                sources [
                  "keyboard.e"
                  "gamepad.buttonWest"
                ]
              }
              {
                command: "view.override"
                id: "camera1"
                sources [
                  "keyboard.1"
                ]
                value {
                  kind: "Axis1D"
                  raw [1, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera2"
                sources [
                  "keyboard.2"
                ]
                value {
                  kind: "Axis1D"
                  raw [2, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera3"
                sources [
                  "keyboard.3"
                ]
                value {
                  kind: "Axis1D"
                  raw [3, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera4"
                sources [
                  "keyboard.4"
                ]
                value {
                  kind: "Axis1D"
                  raw [4, 0, 0, 0]
                }
              }
              {
                command: "view.override"
                id: "camera5"
                sources [
                  "keyboard.5"
                ]
                value {
                  kind: "Axis1D"
                  raw [5, 0, 0, 0]
                }
              }
              {
                command: "view.annotate"
                id: "annotate"
                label: "Annotate"
                sources [
                  "keyboard.f3"
                ]
                text: "toggle"
              }
              {
                command: "view.isolate"
                id: "jetpackAlone"
                label: "Jetpack alone"
                sources [
                  "keyboard.f4"
                ]
                text: "toggle moth pod* nozzle*"
              }
            ]
            id: "base"
          }
        }
        // Both mouse buttons held, in either order, walk her forward until either is released. The chord passes each
        // press through to the button's own binding, so the right button keeps steering her (steer outranks the left
        // button's orbit) and a button left held after the other's release keeps its own drag.
        {
          held [
            "mouse.button1"
            "mouse.button2"
          ]
          group: "play"
          command {
            channel: "forward"
            label: "Forward"
            passThrough: true
            scale: 1
          }
        }
      ]
      modifiers []
      version: "puck.input.bindings.v1"
    }
    id: "bare"
  }
]

bodies {
  capacity: 8
  localSeats: 1
  networkPlayers: 0
  reconnectGraceSeconds: 0
  seatSpawns [
    "stage"
  ]
  sleepAfterSeconds: 0s
}

bodyMotionPrograms [
  {
    kind: Motion
    name: "walk"
    operations [
      ResolveYawAttitudeAndPlanarFrame
      ResolveHold
      ComputePlanarTargetVelocity
      ShapeVelocity
      SnapYawToPlanarIntent
      RunActionTriggers
      ApplyHold
      IntegratePlanarAndVerticalVelocity
      CommitPose
    ]
    planarTarget {
      backward: 0.7
      strafe: 0.85
    }
    version: "puck.body.program.v1"
  }
]

cameras [
  // Eight cameras round the jetpack alone, framed on her hovering 2 m above the hero spawn (body.pose 48 2 -48 0 0 0 in
  // flight mode, then view.isolate moth pod* nozzle*), tiled by the pods-hero layout: rear, rear-low, top, below, both
  // sides, the body-facing front and a rear three-quarter.
  {
    name: "pods-rear"
    renderHeight: 450
    renderWidth: 320
    rig {
      anchorOp {
        opcode: "anchor"
        subject: worldPoint(point: [48, 3.12, -45.4])
      }
      fovOp {
        fieldOfViewRadians: 0.62
        opcode: "fov"
      }
      lookAtOp {
        focusDistance: 6
        opcode: "lookAt"
        subject: worldPoint(point: [48, 3.12, -47.8])
        worldAxes: false
      }
      name: "pods-rear"
      operations [
        anchor(opcode: "anchor", subject: worldPoint(point: [48, 3.12, -45.4]))
        lookAt(focusDistance: 6, opcode: "lookAt", subject: worldPoint(point: [48, 3.12, -47.8]), worldAxes: false)
