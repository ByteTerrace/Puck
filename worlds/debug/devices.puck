// The device row: one of each gaming device the World hosts, at the size of the real thing, each on a labelled stand
// whose screen shows the machine running, with the cartridges it can swap to in the folders its `contentFolders` name.
// The debug world imports this file whole. The row stands in the gallery hall's lobby (hall.puck) on its level 0 floor,
// at z = 28, every device 2.5 m from the next and facing -Z, toward the entrance, so a visitor walking in faces the
// screens:
//
//   x 17.5  the Humble Gaming Brick: a see-through atomic-orange Color brick (75 x 133 x 27.5 mm) leaning back 20
//           degrees on a machined stand, on a 1.15 m plinth
//   x 15    the Advanced Gaming Brick: an aluminium clamshell (84.6 x 82 x 23.7 mm closed) open to its 150-degree stop
//           on a 30-degree stand, on a 1.15 m plinth, its screen leaning back 30 degrees
//   x 12.5  the Humble Gaming Deck: a top-loading console (160 x 168 x 64 mm) and its pad beside a 14-inch television,
//           on a low cart whose top is 0.55 m up
//
// Each device is two or three placements at the same position: the stand (a plinth, or the deck's cart), solid, with the
// device's name on its face; and the device itself, its own prototype so the bake meshes it at its own millimetre scale
// rather than at its stand's (a static placement bakes as one group whose lattice is sized by the whole group). Every
// creation row below is authored in the creation frame (x screen-right, y up, z toward the viewer: the world is that
// turned 180 degrees about up). The handhelds lean back, so their rows were placed from a device frame (origin, tilt
// about x) by a one-off calculation: to move a part, edit its local position in that frame and turn it by the tilt
// again, rotation included. Each prototype's comment names its frame.
//
// Walk up to a device and press the context button (E, or X on a pad) to engage it: the camera frames its screen and
// the seat plays it until the same button leaves. devices.md beside this file gives the console lines that list, swap,
// engage, reset and eject each one, and the camera lines that frame each device.

let deviceZ = 28
// The lobby floor's top (hall.puck's level 0).
let deviceFloor = 0.05
// The handhelds' plinths: 0.4 m square and 1.15 m tall, so a handheld's screen stands about 1.3 m up, under the Moth's
// 1.75 m eye and turned up toward it.
let plinthTop = 1.15

let devicePlinth = { color: "#3A3F47", roughness: 0.85 }
let deviceLabel = { color: "#F2EEE4", roughness: 0.6 }
let devicePlinthKick = { color: "#25292F", roughness: 0.7 }

// A handheld's plinth: a box with a darker kick at its foot and the device's name on its face, which faces +Z.
template plinth(label) {
  name: label
  schema: "puck.creation.v1"
  palette [devicePlinth, deviceLabel, devicePlinthKick]
  shape Box "plinth" {
    material: 0
    position [0, (plinthTop / 2), 0]
    scale [0.2, (plinthTop / 2), 0.2]
  }
  shape Box "kick" {
    material: 2
    position [0, 0.04, 0]
    scale [0.205, 0.04, 0.205]
  }
  textRuns [{ text: label, position [0, (plinthTop - 0.1), 0.2], rotation [0, 0, 0, 1], emHeight: 0.03, depth: 0.004, mode: "emboss", material: 1, align: "center", maxWidth: 0.34 }]
}

// The Humble Gaming Brick's slots. Its shell is clear atomic-orange plastic: the renderer draws opaque surfaces, so each
// shell slot carries an `inset`, a painted plane inside the case that the surface refracts the view onto (ior 1.49,
// acrylic) and shows in place of its own colour, with a clearcoat over it. The front's plane lies 7.5 mm under the face
// on the board, a square ramp (modulation 4) centred on the processor: the dark chip, the board around it, its edge,
// then clear orange where nothing stands behind the plastic. The back's lies over the battery bay, a wide ramp
// (modulation 2) of the two cells. Both frames are world space (a static placement's inset is), turned with the brick's
// 20-degree lean; each seed puts its modulation's phase where the ramp's corners or long axis lie along the case's.
let brickShellFront = 0
let brickShellBack = 1
let brickLens = 2
let brickButtons = 3
let brickKeys = 4
let brickRubber = 5
let brickStand = 6
let brickMarking = 7
let brickLed = 8
let brickCartridge = 9

let advancedPalette = [
  { color: "#454A7A", metal: 0.9, roughness: 0.34, specular: 0.5, sheen: 0.3 }
  { color: "#0A0B0D", specular: 0.6, roughness: 0.04, coat: 0.8 }
  { color: "#C8CBD2", metal: 1, roughness: 0.12, specular: 0.6 }
  { color: "#1A1B1F", roughness: 0.22, specular: 0.45, coat: 0.3 }
  { color: "#5F636B", roughness: 0.5, specular: 0.2 }
  { color: "#7CFFB0", emissive: 3 }
  { color: "#9EA3AE", roughness: 0.4 }
  { color: "#D9DBDF", metal: 1, roughness: 0.3, specular: 0.5 }
]
// The Advanced Gaming Brick's slots: anodised aluminium shells, the edge-to-edge dark glass and speaker slots, polished
// aluminium (the hinge, the d-pad's ring), black ceramic keys, the cartridge, the power light, the wordmark and the stand.
let agbShell = 0
let agbGlass = 1
let agbPolished = 2
let agbKeys = 3
let agbCartridge = 4
let agbLed = 5
let agbMarking = 6
let agbStand = 7

// The deck's cart: walnut veneer, its label, the casters and the spare cartridges on its shelf.
let standWood = 0
let standLabel = 1
let standCaster = 2
let standCartridge = 3

// The television: the charcoal cabinet, the silver mask ring and power key, the tube's dark glass round the picture,
// the knobs and feet, the speaker and vent slots, the standby light and the chrome antenna.
let tvCabinet = 0
let tvTrim = 1
let tvTube = 2
let tvKnobs = 3
let tvGrille = 4
let tvLed = 5
let tvChrome = 6

// The console and its pad: graphite and aluminium shells, black inlays (slot, ports, keys, cable), the cartridge, the
// power light, the pad's red keys, and the eight colour bars on the cartridge's label.
let deckGraphite = 0
let deckAluminium = 1
let deckInlay = 2
let deckCartridge = 3
let deckLed = 4
let deckButtons = 5
let deckBarWhite = 6
let deckBarYellow = 7
let deckBarCyan = 8
let deckBarGreen = 9
let deckBarMagenta = 10
let deckBarRed = 11
let deckBarBlue = 12
let deckBarBlack = 13

prototypes {
  prototype "device-humble-gaming-brick-plinth" {
    document {
      plinth(label: "HUMBLE GAMING BRICK")
    }
  }

  prototype "device-advanced-gaming-brick-plinth" {
    document {
      plinth(label: "ADVANCED GAMING BRICK")
    }
  }

  // The brick in its frame: origin at the body's centre, x right, y up the face, z out of it, leaning back 20 degrees
  // (turned -20 degrees about x), its bottom-back edge 1 mm into the stand's base plate on the plinth. In that frame the
  // body is 75 by 133 mm, front and back shells 11.5 mm each, the battery bay 4.5 mm proud of the back; the screen's
  // picture (screen 0) is centred at y 0.031 on a dark lens 57 by 49 mm, 0.5 mm proud of the lens; the d-pad stands at
  // (-21.5, -25.5) mm, A and B at (26.2, -20.5) and (13.2, -28.3), select and start at (-8.5, -46.5) and (8.5, -46.5),
  // the speaker's five slots at (22.5, -50.5), and the cartridge stands 10 mm out of the top.
  prototype "device-humble-gaming-brick" {
    document {
      name: "HUMBLE GAMING BRICK"
      schema: "puck.creation.v1"
      palette [
        { color: "#F58220", specular: 0.5, roughness: 0.15, coat: 0.6, inset { origin [17.497, 1.257756, 28.006707], rotation [0, 0.984808, 0.173648, 0], depth: 0, ior: 1.49, paint { stops [{ radius: 0, color: "#2E1606" }, { radius: 0.0065, color: "#7A3210" }, { radius: 0.03, color: "#A8480F" }, { radius: 0.037, color: "#F58220" }], softness: 0.3, modulationAmplitude: 0.12, modulationFrequency: 4, seed: 3154 } } }
        { color: "#F58220", specular: 0.5, roughness: 0.15, coat: 0.6, inset { origin [17.5, 1.24024, 28.010973], rotation [0, 0.984808, 0.173648, 0], depth: 0, ior: 1.49, paint { stops [{ radius: 0, color: "#24201E" }, { radius: 0.016, color: "#6E3412" }, { radius: 0.024, color: "#B9560F" }, { radius: 0.03, color: "#F58220" }], softness: 0.35, modulationAmplitude: 0.3, modulationFrequency: 2, seed: 932 } } }
        { color: "#17181C", specular: 0.6, roughness: 0.08, coat: 0.6 }
        { color: "#2E2522", roughness: 0.25, specular: 0.35, coat: 0.4 }
        { color: "#2A2624", roughness: 0.4, specular: 0.25 }
        { color: "#5E5E64", roughness: 0.75 }
        { color: "#BFC2C7", metal: 1, roughness: 0.28, specular: 0.5 }
        { color: "#FBE6D2", roughness: 0.5 }
        { color: "#FF3A2A", emissive: 4, roughness: 0.3 }
        { color: "#4A4D54", roughness: 0.5, specular: 0.2 }
      ]
      shape Prism "shell-front" {
        material: brickShellFront
        position [0, 1.223389, -0.010535]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0375, 0.0665, 0.00575]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.24
        }
        rounding: 0.0022
      }
      shape Prism "shell-back" {
        material: brickShellBack
