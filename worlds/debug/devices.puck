        position [-0.0265, 1.195605, 0.018327]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0118, 0.0118, 0.0003]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
      }
      shape Box "dpad-across" {
