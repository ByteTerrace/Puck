// The device row: one of each gaming device the World hosts, each a labelled body on a plinth whose screen
// shows the machine running, with the cartridges it can swap to in the folders its `contentFolders` name. The debug
// world imports this file whole. The row stands on the open ground west of the spawn at z = -6, every device 3 m from
// the next and facing +Z, toward the origin:
//
//   x -10  the Humble Gaming Brick
//   x -13  the Advanced Gaming Brick
//   x -16  the Humble Gaming Deck, running its test cartridges on the set above it
//
// Walk up to a device and press the context button (E, or X on a pad) to engage it: the camera frames its screen and
// the seat plays it until the same button leaves. devices.md beside this file gives the console lines that list,
// swap, engage, reset and eject each one.

let deviceZ = -6

// Slot 0 the shell, 1 the plinth, 2 the label, 3 the screen bezel, 4 the face buttons, 5 the d-pad and small keys.
let devicePlinth = { color: "#3A3F47", roughness: 0.85 }
let deviceLabel = { color: "#F2EEE4", roughness: 0.6 }
let deviceBezel = { color: "#202227", roughness: 0.5, specular: 0.2 }
let deviceKeys = { color: "#26272B", roughness: 0.6 }

// The plinth beneath a device and its label, which faces +Z.
template device(label, shell, buttons) {
  name: label
  schema: "puck.creation.v1"
  palette [shell, devicePlinth, deviceLabel, deviceBezel, buttons, deviceKeys]
  shape Box "plinth" {
    material: 1
    position [0, 0.15, 0]
    scale [0.6, 0.15, 0.25]
  }
  textRuns [{ text: label, position [0, 0.15, 0.25], rotation [0, 0, 0, 1], emHeight: 0.08, depth: 0.006, mode: "emboss", material: 2, align: "center" }]
}

// A portrait handheld: the shell, the bezel round a 160 by 144 screen centred at y 0.88, a d-pad, two face buttons and
// start and select.
template portraitHandheld() {
  shape Superellipsoid "shell" {
    exponent: 6
    material: 0
    position [0, 0.715, 0]
    scale [0.26, 0.42, 0.05]
  }
  shape Box "bezel" {
    material: 3
    position [0, 0.88, 0.045]
    scale [0.21, 0.19, 0.012]
  }
  shape Box "dpad-across" {
    material: 5
    position [-0.13, 0.54, 0.05]
    scale [0.06, 0.02, 0.012]
  }
  shape Box "dpad-down" {
    material: 5
    position [-0.13, 0.54, 0.05]
    scale [0.02, 0.06, 0.012]
  }
  shape Sphere "button-a" {
    material: 4
    position [0.16, 0.57, 0.045]
    scale [0.03, 0.03, 0.03]
  }
  shape Sphere "button-b" {
    material: 4
    position [0.08, 0.52, 0.045]
    scale [0.03, 0.03, 0.03]
  }
  shape Box "select" {
    material: 5
    position [-0.04, 0.41, 0.05]
    scale [0.025, 0.008, 0.008]
  }
  shape Box "start" {
    material: 5
    position [0.04, 0.41, 0.05]
    scale [0.025, 0.008, 0.008]
  }
}

// A landscape handheld: the shell, shoulder buttons, the bezel round the screen centred at y 0.6, a d-pad left of it,
// two face buttons right of it and start and select below the face buttons.
template landscapeHandheld() {
  shape Superellipsoid "shell" {
    exponent: 4
    material: 0
    position [0, 0.555, 0]
    scale [0.5, 0.26, 0.06]
  }
  shape Box "shoulder-left" {
    material: 5
    position [-0.36, 0.8, -0.01]
    scale [0.1, 0.02, 0.04]
  }
  shape Box "shoulder-right" {
    material: 5
    position [0.36, 0.8, -0.01]
    scale [0.1, 0.02, 0.04]
  }
  shape Box "bezel" {
    material: 3
    position [0, 0.6, 0.055]
    scale [0.29, 0.2, 0.012]
  }
  shape Box "dpad-across" {
    material: 5
    position [-0.39, 0.6, 0.058]
    scale [0.055, 0.018, 0.012]
  }
  shape Box "dpad-down" {
    material: 5
    position [-0.39, 0.6, 0.058]
    scale [0.018, 0.055, 0.012]
  }
  shape Sphere "button-a" {
    material: 4
    position [0.43, 0.63, 0.055]
    scale [0.028, 0.028, 0.028]
  }
  shape Sphere "button-b" {
    material: 4
    position [0.36, 0.58, 0.055]
    scale [0.028, 0.028, 0.028]
  }
  shape Box "select" {
    material: 5
    position [0.35, 0.44, 0.058]
    scale [0.02, 0.007, 0.007]
  }
  shape Box "start" {
    material: 5
    position [0.42, 0.44, 0.058]
    scale [0.02, 0.007, 0.007]
  }
}

prototypes {
  prototype "device-humble-gaming-brick" {
    document {
      device(label: "HUMBLE GAMING BRICK", shell: { color: "#2E9C9C", roughness: 0.45, specular: 0.25 }, buttons: { color: "#26272B", roughness: 0.4, specular: 0.3 })
      portraitHandheld()
    }
  }

  prototype "device-advanced-gaming-brick" {
    document {
      device(label: "ADVANCED GAMING BRICK", shell: { color: "#4B3F9E", roughness: 0.45, specular: 0.25 }, buttons: { color: "#D8D4CC", roughness: 0.4, specular: 0.3 })
      landscapeHandheld()
    }
  }

  // A home console and its television: the set's screen above, the console with its cartridge slot in front.
  prototype "device-humble-gaming-deck" {
    document {
      device(label: "HUMBLE GAMING DECK", shell: { color: "#2B2B2E", roughness: 0.6, specular: 0.15 }, buttons: { color: "#B8312F", roughness: 0.4, specular: 0.3 })
      shape Box "set" {
        chamfer: 0.03
        material: 0
        position [0, 0.63, -0.06]
        scale [0.34, 0.32, 0.16]
      }
      shape Box "bezel" {
        material: 3
        position [0, 0.64, 0.1]
        scale [0.29, 0.27, 0.012]
      }
      shape Box "console" {
        chamfer: 0.01
        material: 5
        position [0, 0.34, 0.16]
        scale [0.24, 0.04, 0.07]
      }
      shape Box "slot" {
        material: 3
        position [0, 0.38, 0.15]
        scale [0.14, 0.006, 0.03]
      }
      shape Box "power" {
        material: 4
        position [-0.17, 0.34, 0.232]
        scale [0.02, 0.01, 0.006]
      }
    }
  }
}

placements {
  placement "device-humble-gaming-brick" {
    prototype: "device-humble-gaming-brick"
    position [-10, 0, deviceZ]
    yawDegrees: 180
  }

  placement "device-advanced-gaming-brick" {
    prototype: "device-advanced-gaming-brick"
    position [-13, 0, deviceZ]
    yawDegrees: 180
  }

  placement "device-humble-gaming-deck" {
    prototype: "device-humble-gaming-deck"
    position [-16, 0, deviceZ]
    yawDegrees: 180
  }
}

// Each machine boots a shipped cartridge, so the world boots the same on every machine, and swaps to any file
// `machine.content` lists from its folders. The brick is the Color model, which runs the forge's cgb and dmg targets
// alike. A device's last folder is the owner's local, git-ignored `roms/` at the repository root, which resolves when
// the world boots from this source and is listed as absent wherever it does not exist. Each device prefers its folders'
// default: where a local folder's own `folder.json` names one (`machine.default`), the device boots it instead of its
// shipped cartridge, and everywhere else it boots the shipped cartridge.
machines [
  {
    name: "humble-gaming-brick"
    engine: "gaming-brick"
    configuration {
      schema: "puck.gaming-brick.configuration.v1"
      model: "cgb"
      content {
        path: "cartridges/cgb/tetromino.cgb.cartridge.json"
      }
    }
    contentFolders ["cartridges/cgb", "cartridges/dmg", "../../roms/hgb"]
    preferFolderDefault: true
  }
  {
    name: "advanced-gaming-brick"
    engine: "advanced-gaming-brick"
    configuration {
      schema: "puck.advanced-gaming-brick.config.v1"
      content {
        path: "cartridges/agb/pip.agb.cartridge.json"
      }
    }
    contentFolders ["cartridges/agb", "../../roms/agb"]
    preferFolderDefault: true
  }
  {
    name: "humble-gaming-deck"
    engine: "humble-gaming-deck"
    configuration {
      schema: "puck.humble-gaming-deck.configuration.v1"
      content {
        path: "cartridges/deck/colour-bars.nes"
      }
    }
    contentFolders ["cartridges/deck", "../../roms/hgd"]
    preferFolderDefault: true
  }
]

// The pad a seat wears on a device it engages: the Moth's movement drives the d-pad, jump is A, flight is B and the
// start channel (the pad's Start, Enter on a keyboard) is start.
kits {
  rows [
    {
      name: "devicePad"
      bodyMotionProgram: "walk"
      motion {
        holds [
          {
            bond: Free
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 4
        }
        turn {
          rate: 2
        }
      }
      pad {
        forward: "LeftStickY"
        strafe: "LeftStickX"
        jump: "South"
        flight: "East"
        start: "Start"
      }
    }
  ]
}

// The debug world draws no HUD panels: the controller bar is its only on-screen UI, so engaging a device shows no
// prompt. The section's panel list lives here because the garden, which imports controls.puck too, authors its own.
hud {
  panels []
}

// Each screen is a 1 cm glass slab standing on its device's bezel, its face 1 cm proud of it. The brick's screen is
// 160 by 144, the advanced brick's 240 by 160 and the deck's 256 by 240, at 2 mm a pixel.
// Each engages on the Moth's context button (`interact`), which the pad does not play, so the same press leaves.
let deviceRoute = { engageable: true, engageRadius: 3, engageChannel: "interact", kit: "devicePad" }

screens [
  {
    index: 0
    origin [-10, 0.88, (deviceZ + 0.067)]
    right [1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.16
    halfHeight: 0.144
    halfDepth: 0.005
    round: 0
    source: machine(instance: `humble-gaming-brick`, output: "video")
    route: deviceRoute
  }
  {
    index: 1
    origin [-13, 0.6, (deviceZ + 0.077)]
    right [1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.24
    halfHeight: 0.16
    halfDepth: 0.005
    round: 0
    source: machine(instance: `advanced-gaming-brick`, output: "video")
    route: deviceRoute
  }
  {
    index: 2
    origin [-16, 0.64, (deviceZ + 0.122)]
    right [1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.256
    halfHeight: 0.24
    halfDepth: 0.005
    round: 0
    source: machine(instance: `humble-gaming-deck`, output: "video")
    // The deck has two controller ports; an engaged seat plays the first.
    route {
      engageable: true
      engageRadius: 3
      engageChannel: "interact"
      kit: "devicePad"
      port: "controls"
    }
  }
]
