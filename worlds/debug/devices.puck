placements {
  placement "device-humble-gaming-brick-plinth" {
    prototype: "device-humble-gaming-brick-plinth"
    position [17.5, deviceFloor, deviceZ]
    yawDegrees: 0
    solid
  }

  placement "device-humble-gaming-brick" {
    prototype: "device-humble-gaming-brick"
    position [17.5, deviceFloor, deviceZ]
    yawDegrees: 0
  }

  placement "device-advanced-gaming-brick-plinth" {
    prototype: "device-advanced-gaming-brick-plinth"
    position [15, deviceFloor, deviceZ]
    yawDegrees: 0
    solid
  }

  placement "device-advanced-gaming-brick" {
    prototype: "device-advanced-gaming-brick"
    position [15, deviceFloor, deviceZ]
    yawDegrees: 0
  }

  placement "device-humble-gaming-deck-stand" {
    prototype: "device-humble-gaming-deck-stand"
    position [12.5, deviceFloor, deviceZ]
    yawDegrees: 0
    solid
  }

  placement "device-humble-gaming-deck-television" {
    prototype: "device-humble-gaming-deck-television"
    position [12.5, deviceFloor, deviceZ]
    yawDegrees: 0
  }

  placement "device-humble-gaming-deck" {
    prototype: "device-humble-gaming-deck"
    position [12.5, deviceFloor, deviceZ]
    yawDegrees: 0
  }
}

// Each machine boots a shipped cartridge, so the world boots the same on every machine, and swaps to any file
// `machine.content` lists from its folders. The brick is the Color model, which runs the forge's cgb and dmg targets
// alike. A device's last folder is the owner's local, git-ignored `roms/` at the repository root, which resolves when
// the world boots from this source and is listed as absent wherever it does not exist. Each device prefers its folders'
// default: where a local folder's own `folder.json` names one (`machine.default`), the device boots it instead of its
// shipped cartridge, and everywhere else it boots the shipped cartridge.
machines [
  {
    name: "humble-gaming-brick"
    engine: "gaming-brick"
    configuration {
      schema: "puck.gaming-brick.configuration.v1"
      model: "cgb"
      content {
        path: "cartridges/cgb/tetromino.cgb.cartridge.json"
      }
    }
    contentFolders ["cartridges/cgb", "cartridges/dmg", "../../roms/hgb"]
    preferFolderDefault: true
  }
  {
    name: "advanced-gaming-brick"
    engine: "advanced-gaming-brick"
    configuration {
      schema: "puck.advanced-gaming-brick.config.v1"
      content {
        path: "cartridges/agb/pip.agb.cartridge.json"
      }
    }
    contentFolders ["cartridges/agb", "../../roms/agb"]
    preferFolderDefault: true
  }
  {
    name: "humble-gaming-deck"
    engine: "humble-gaming-deck"
    configuration {
      schema: "puck.humble-gaming-deck.configuration.v1"
      content {
        path: "cartridges/deck/colour-bars.nes"
      }
    }
    contentFolders ["cartridges/deck", "../../roms/hgd"]
    preferFolderDefault: true
  }
]

// The pad a seat wears on a device it engages: the Moth's movement drives the d-pad, jump is A, flight is B, the start
// channel (the pad's Start, Enter on a keyboard) is start and the select channel (the pad's Back, right Shift) is select.
kits {
  rows [
    {
      name: "devicePad"
      bodyMotionProgram: "walk"
      motion {
        holds [
          {
            bond: Free
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 4
        }
        turn {
          rate: 2
        }
      }
      pad {
        forward: "LeftStickY"
        strafe: "LeftStickX"
        jump: "South"
        flight: "East"
        start: "Start"
        select: "Back"
      }
    }
  ]
}

// The debug world draws no HUD panels: the controller bar is its only on-screen UI, so engaging a device shows no
// prompt. The section's panel list lives here because the garden, which imports controls.puck too, authors its own.
hud {
  panels []
}

// Each screen's glass is exactly its picture: the source's width and height in pixels at the device's pixel pitch, the
// device's case lying outside it, never inside. The handhelds' pixels are square; the television's are 8:7, as wide as
// tall times 8/7, so its 256 by 240 picture is 256 by 210 mm and the 224 lines a set shows make the 4:3 picture a
// 14-inch tube gives. Each glass is a 2 mm slab (4 mm on the television) square to its device's face, standing a
// fraction of a millimetre to 1 mm proud of it, the rest of its depth sunk into the face.
//
//   screen 0, the brick: 160 by 144 at 0.275 mm, 44 by 39.6 mm, leaning back 20 degrees with the brick
//   screen 1, the advanced brick: 240 by 160 at 0.255 mm, 61.2 by 40.8 mm, leaning back 30 degrees with its upper half
//   screen 2, the deck: 256 by 240 at 1 by 0.875 mm, 256 by 210 mm, upright in the television
let brickPitch = 0.000275
let advancedPitch = 0.000255
let deckPitchY = 0.000875
let deckPitchX = (deckPitchY * (8 / 7))
// Each engages on the Moth's context button (`interact`), which the pad does not play, so the same press leaves. Once
// the camera has framed the picture, the window shows it alone, as a desktop emulator does, on the matte its route's
// `display` fills: black on every device.
let deviceDisplay = { fill: "#000000" }
let deviceRoute = { engageable: true, engageRadius: 3, engageChannel: "interact", kit: "devicePad", display: deviceDisplay }

screens [
  {
    index: 0
    origin [17.5, (deviceFloor + 1.254589), (deviceZ + 0.015452)]
    right [-1, 0, 0]
    up [0, 0.939693, 0.34202]
    halfWidth: ((160 * brickPitch) / 2)
    halfHeight: ((144 * brickPitch) / 2)
    halfDepth: 0.001
    round: 0
    source: machine(instance: `humble-gaming-brick`, output: "video")
    route: deviceRoute
  }
  {
    index: 1
    origin [15, (deviceFloor + 1.251641), (deviceZ + 0.037797)]
    right [-1, 0, 0]
    up [0, 0.866025, 0.5]
    halfWidth: ((240 * advancedPitch) / 2)
    halfHeight: ((160 * advancedPitch) / 2)
    halfDepth: 0.001
    round: 0
    source: machine(instance: `advanced-gaming-brick`, output: "video")
    route: deviceRoute
  }
  {
    index: 2
    origin [12.675, (deviceFloor + 0.741), (deviceZ - 0.164)]
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: ((256 * deckPitchX) / 2)
    halfHeight: ((240 * deckPitchY) / 2)
    halfDepth: 0.002
    round: 0
    source: machine(instance: `humble-gaming-deck`, output: "video")
    // The deck has two controller ports; an engaged seat plays the first.
    route {
      engageable: true
      engageRadius: 3
      engageChannel: "interact"
      kit: "devicePad"
      port: "controls"
      display: deviceDisplay
    }
  }
]
