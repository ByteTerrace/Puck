      }
      textRuns [{ text: "HUMBLE GAMING DECK", position [0, 0.532, 0.225], rotation [0, 0, 0, 1], emHeight: 0.017, depth: 0.003, mode: "emboss", material: standLabel, align: "center" }]
    }
