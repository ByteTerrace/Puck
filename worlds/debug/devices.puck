// The device row: one of each gaming device the World hosts, each on a labelled stand whose screen shows the machine
// running, with the cartridges it can swap to in the folders its `contentFolders` name. The debug world imports this
// file whole. The row stands in the gallery hall's lobby (hall.puck) on its level 0 floor, at z = 28, every device
// 2.5 m from the next and facing -Z, toward the entrance, so a visitor walking in faces the screens:
//
//   x 17.5  the Humble Gaming Brick: a Color brick in clear atomic-orange glass over its board and cells (75 x 133 x
//           27.5 mm) leaning back 20 degrees on a machined stand, on a 1.15 m plinth
//   x 15    the Advanced Gaming Brick: an aluminium clamshell (84.6 x 82 x 23.7 mm closed) open to its 150-degree stop
//           on a 30-degree stand, on a 1.15 m plinth, its screen leaning back 30 degrees
//   x 12.5  the Humble Gaming Deck: a top-loading console (160 x 168 x 64 mm) and its pad beside a 27-inch television,
//           on a walnut AV cabinet whose top is 0.65 m up
//
// The handhelds are modelled in their real millimetres and shown at handheldScale (1.5) times that, so they read from
// the walking distance (the owner's ruling); the deck and its television are at their real size. Each device is two or
// three placements at the same position: the stand (a plinth, or the deck's cabinet), solid, with the device's name on
// its face; and the device itself, its own prototype so the bake meshes it at its own millimetre scale rather than at
// its stand's (a static placement bakes as one group whose lattice is sized by the whole group). A handheld's prototype
// stands on the plinth's top, its y = 0 there, so its placement scales it about that point. Every creation row below is
// authored in the creation frame (x screen-right, y up, z toward the viewer: the world is that turned 180 degrees about
// up). The handhelds lean back, so their rows were placed from a device frame (origin, tilt about x) by a one-off
// calculation: to move a part, edit its local position in that frame and turn it by the tilt again, rotation included.
// Each prototype's comment names its frame.
//
// Walk up to a device and press the context button (E, or X on a pad) to engage it: the camera frames its screen and
// the seat plays it until the same button leaves. devices.md beside this file gives the console lines that list, swap,
// engage, reset and eject each one, and the camera lines that frame each device.

let deviceZ = 28
// The lobby floor's top (hall.puck's level 0).
let deviceFloor = 0.05
// The handhelds' plinths: 0.4 m square and 1.15 m tall, so a handheld's screen stands about 1.35 m up, under the Moth's
// 1.75 m eye and turned up toward it.
let plinthTop = 1.15
let handheldScale = 1.5

let devicePlinth = { color: "#3A3F47", roughness: 0.85 }
let deviceLabel = { color: "#F2EEE4", roughness: 0.6 }
let devicePlinthKick = { color: "#25292F", roughness: 0.7 }

// The stands' names, at a size their bake keeps. An embossed run bakes as a group of its own, refined toward its
// declared detail (the thinner of its relief and a tenth of its em, about its stroke) but no finer than an eighth of a
// 15 mm cell along the run: 1.875 mm. At a 40 mm em a stroke is about 4 mm, two of those cells, and a 2 mm relief
// declares a detail that reaches them; a stroke near one cell wide, as at an 18 mm em, drops out where it falls
// between samples (an "I" lost from the deck's label).
let labelEm = 0.04
let labelDepth = 0.002

// A handheld's plinth: a box with a darker kick at its foot and the device's name on its face, which faces +Z, on two
// lines, the model over GAMING BRICK, the longer about 0.32 m of the 0.4 m face.
template plinth(label, model) {
  name: label
  schema: "puck.creation.v1"
  palette [devicePlinth, deviceLabel, devicePlinthKick]
  shape Box "plinth" {
    material: 0
    position [0, (plinthTop / 2), 0]
    scale [0.2, (plinthTop / 2), 0.2]
  }
  shape Box "kick" {
    material: 2
    position [0, 0.04, 0]
    scale [0.205, 0.04, 0.205]
  }
  textRuns [{ text: $"{model}\nGAMING BRICK", position [0, (plinthTop - 0.075), 0.2], rotation [0, 0, 0, 1], emHeight: labelEm, depth: labelDepth, mode: "emboss", material: 1, align: "center", maxWidth: 0.38 }]
}

// The Humble Gaming Brick's slots. Its shell is glass (`glass`): atomic-orange acrylic (ior 1.49) whose tint is reached
// through 12 mm, about the 11 mm of shell over the board at the placement's scale (a static placement's glass depth is
// world units), so the board reads through a saturated orange and the parts deeper in, or the 34 mm through the whole
// body at its rim, a deeper red-orange. Glass only tints what it transmits, so the board is a pale green: through the
// orange it reads amber, where a dark board would turn the shell brown. The shell bakes and draws apart from the opaque
// parts, which show through it: the board and its parts, the cells, the speaker, the cartridge, and the keys sunk into
// the face. Then the lens, the smoked buttons, the d-pad and slots, the rubber keys, the stand, the power light, the
// cartridge, the board, the chips and the speaker's cone, the board's small parts and the cells.
let brickShell = 0
let brickLens = 1
let brickButtons = 2
let brickKeys = 3
let brickRubber = 4
let brickStand = 5
let brickLed = 6
let brickCartridge = 7
let brickBoard = 8
let brickChip = 9
let brickPart = 10
let brickCell = 11

let advancedPalette = [
  { color: "#454A7A", metal: 0.9, roughness: 0.34, specular: 0.5, sheen: 0.3 }
  { color: "#0A0B0D", specular: 0.05, roughness: 0.04, coat: 0.8 }
  { color: "#C8CBD2", metal: 1, roughness: 0.12, specular: 0.6 }
  { color: "#1A1B1F", roughness: 0.22, specular: 0.05, coat: 0.3 }
  { color: "#5F636B", roughness: 0.5, specular: 0.04 }
  { color: "#7CFFB0", emissive: 3 }
  { color: "#D9DBDF", metal: 1, roughness: 0.3, specular: 0.5 }
]
// The Advanced Gaming Brick's slots: anodised aluminium shells, the edge-to-edge dark glass and speaker slots, polished
// aluminium (the hinge, the d-pad's ring), black ceramic keys, the cartridge, the power light and the stand. It carries
// no wordmark: lettering a few millimetres high is finer than an embossed text run's bake keeps (devices.md).
let agbShell = 0
let agbGlass = 1
let agbPolished = 2
let agbKeys = 3
let agbCartridge = 4
let agbLed = 5
let agbStand = 6

// The deck's cabinet: walnut veneer, its label, the black kick and the spare cartridges in its bay.
let standWood = 0
let standLabel = 1
let standKick = 2
let standCartridge = 3
// The cabinet's top, which the television and the console stand on.
let deckTop = 0.65

// The television: the black body, the silver bezel, the tube's dark face round the picture, the base and power key,
// the grille and vents, the standby light and the chrome badge. Its frame: the set's centre at x tvX, the
// bezel's face at z tvFront and the tube's face 5 mm behind it, the picture's centre pictureY up. The picture is 256 by
// 240 at 1.875 mm a line and 8/7 of that a pixel across (deckPitchX), 548.6 by 450 mm, so the 224 lines a set shows
// are a 548.6 by 420 mm, 4:3 picture: a 27-inch tube's. The tube's opening is 9 mm wider each side and 8 mm taller.
let tvX = -0.22
let tvFront = 0.205
let tubeFront = 0.2
let deckPitchY = 0.001875
let deckPitchX = (deckPitchY * (8 / 7))
let pictureY = (deckTop + 0.357)
let pictureHalfWidth = ((256 * deckPitchX) / 2)
let pictureHalfHeight = ((240 * deckPitchY) / 2)
let tubeHalfWidth = (pictureHalfWidth + 0.009)
let tubeHalfHeight = (pictureHalfHeight + 0.008)
let tubeTop = (pictureY + tubeHalfHeight)
let tubeBottom = (pictureY - tubeHalfHeight)
let tvCabinet = 0
let tvTrim = 1
let tvTube = 2
let tvKnobs = 3
let tvGrille = 4
let tvLed = 5
let tvChrome = 6

// The console and its pad: graphite and aluminium shells, black inlays (slot, ports, keys, cable), the cartridge, the
// power light, the pad's red keys, and the eight colour bars on the cartridge's label.
let deckGraphite = 0
let deckAluminium = 1
let deckInlay = 2
let deckCartridge = 3
let deckLed = 4
let deckButtons = 5
let deckBarWhite = 6
let deckBarYellow = 7
let deckBarCyan = 8
let deckBarGreen = 9
let deckBarMagenta = 10
let deckBarRed = 11
let deckBarBlue = 12
let deckBarBlack = 13

prototypes {
  prototype "device-humble-gaming-brick-plinth" {
    document {
      plinth(label: "HUMBLE GAMING BRICK", model: "HUMBLE")
    }
  }

  prototype "device-advanced-gaming-brick-plinth" {
    document {
      plinth(label: "ADVANCED GAMING BRICK", model: "ADVANCED")
    }
  }

  // The brick in its frame: origin at the body's centre, x right, y up the face, z out of it, leaning back 20 degrees
  // (turned -20 degrees about x), its bottom-back edge 1 mm into the stand's base plate, whose underside is the
  // prototype's y = 0 (the plinth's top). In that frame the body is 75 by 133 by 23 mm of orange shell, the battery bay
  // 4.5 mm proud of its back. Inside it lie the board 7.5 mm under the face (its processor at (-2, -13) mm, its memory,
  // regulator and two rows of parts), the screen's module behind the lens, the speaker's dark cone at (22.5, -50.5), the
  // cartridge down its slot behind the board on its connector, and two AA cells across the bay. On the face: the
  // screen's picture (screen 0) centred at y 31 on a dark lens 57 by 49 mm, its face 1 mm proud of the lens; the d-pad
  // at (-21.5, -25.5), A and B at (26.2, -20.5) and (13.2, -28.3), select and start at (-8.5, -46.5) and
  // (8.5, -46.5), the speaker's five slots at (22.5, -50.5); the cartridge stands 8.5 mm out of the top.
  prototype "device-humble-gaming-brick" {
    document {
      name: "HUMBLE GAMING BRICK"
      schema: "puck.creation.v1"
      palette [
        { color: "#FF4A0C", roughness: 0.06, glass { depth: 0.012, ior: 1.49 } }
        { color: "#17181C", specular: 0.05, roughness: 0.08, coat: 0.6 }
        { color: "#2E2522", roughness: 0.25, specular: 0.05, coat: 0.4 }
        { color: "#2A2624", roughness: 0.4, specular: 0.04 }
        { color: "#5E5E64", roughness: 0.75 }
        { color: "#BFC2C7", metal: 1, roughness: 0.28, specular: 0.5 }
        { color: "#FF3A2A", emissive: 4, roughness: 0.3 }
        { color: "#4A4D54", roughness: 0.5, specular: 0.04 }
        { color: "#8CC79A", roughness: 0.5, specular: 0.04 }
        { color: "#151617", roughness: 0.6, specular: 0.04 }
        { color: "#D8C49A", roughness: 0.5, specular: 0.04 }
        { color: "#2C5E8C", roughness: 0.35, specular: 0.05, coat: 0.3 }
      ]
      shape Prism "shell" {
        material: brickShell
        position [0, 0.071422, -0.015938]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0375, 0.0665, 0.0115]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.24
        }
        rounding: 0.0022
      }
      shape Prism "battery-bay" {
        material: brickShell
        position [0, 0.038017, -0.017082]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.029, 0.021, 0.0035]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.3
        }
        rounding: 0.0015
      }
      shape Box "board" {
        material: brickBoard
        position [0, 0.064931, -0.010383]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.034, 0.054, 0.0006]
        chamfer: 0.0004
      }
      shape Box "lcd-module" {
        material: brickChip
        position [0, 0.102222, -0.01757]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.026, 0.022, 0.0025]
        chamfer: 0.0006
      }
      shape Box "processor" {
        material: brickChip
        position [-0.002, 0.060609, -0.007639]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0075, 0.0075, 0.0006]
        chamfer: 0.0004
      }
      shape Box "memory" {
        material: brickChip
        position [0.015, 0.068058, -0.010563]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.005, 0.003, 0.0004]
        chamfer: 0.0003
      }
      shape Box "regulator" {
        material: brickChip
        position [-0.017, 0.069937, -0.011247]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.004, 0.004, 0.0004]
        chamfer: 0.0003
      }
      shape Box "parts-row" {
        material: brickPart
        position [0, 0.074115, -0.012927]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0008, 0.0005, 0.00025]
        domain [repeat(spacing: [0.004, 1, 1], limit: [6, 0, 0], origin: [0, 0.074115, 0.012927])]
      }
      shape Box "parts-low" {
        material: brickPart
        position [-0.02, 0.033238, 0.001951]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0008, 0.0005, 0.00025]
        domain [repeat(spacing: [0.003, 1, 1], limit: [3, 0, 0], origin: [0.02, 0.033238, -0.001951])]
      }
      shape Cylinder "speaker-can" {
        material: brickChip
        position [0.0225, 0.02602, 0.006972]
        rotation [0.573576, 0, 0, 0.819152]
        scale [0.01, 0.0025, 0.01]
      }
      shape Box "cartridge-connector" {
        material: brickChip
        position [0, 0.094443, -0.03017]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.03, 0.003, 0.0045]
        chamfer: 0.0005
      }
      shape Cylinder "cell-upper" {
        material: brickCell
        position [0, 0.047244, -0.015119]
        rotation [-0.122788, 0.122788, 0.696364, 0.696364]
        scale [0.00725, 0.02525, 0.00725]
        rounding: 0.001
      }
      shape Cylinder "cell-lower" {
        material: brickCell
        position [0, 0.032209, -0.009647]
        rotation [-0.122788, 0.122788, 0.696364, 0.696364]
        scale [0.00725, 0.02525, 0.00725]
        rounding: 0.001
      }
      shape Box "cartridge" {
        material: brickCartridge
        position [0, 0.118405, -0.038891]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0285, 0.023, 0.0038]
        chamfer: 0.001
      }
      shape Prism "lens" {
        material: brickLens
        position [0, 0.103145, -0.015033]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0285, 0.0245, 0.0006]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.16
        }
      }
      shape Sphere "power-led" {
        material: brickLed
        position [-0.0254, 0.113618, -0.01842]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0011, 0.0011, 0.0011]
      }
      shape Prism "dpad-well" {
        material: brickKeys
        position [-0.0215, 0.051428, 0.003684]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0128, 0.0128, 0.0004]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
      }
      shape Box "dpad-across" {
        material: brickKeys
        position [-0.0215, 0.051701, 0.004436]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0105, 0.0036, 0.0016]
        chamfer: 0.0007
      }
      shape Box "dpad-down" {
        material: brickKeys
        position [-0.0215, 0.051701, 0.004436]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0036, 0.0105, 0.0016]
        chamfer: 0.0007
      }
      shape Prism "button-a" {
        material: brickButtons
        position [0.0262, 0.056331, 0.002538]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0048, 0.0048, 0.0014]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0009
      }
      shape Prism "button-b" {
        material: brickButtons
        position [0.0132, 0.049002, 0.005205]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0048, 0.0048, 0.0014]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0009
      }
      shape Prism "select" {
        material: brickRubber
        position [-0.0085, 0.031763, 0.011054]
        rotation [-0.169532, 0.037584, 0.213151, 0.961464]
        scale [0.0052, 0.0017, 0.0009]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0006
      }
      shape Prism "start" {
        material: brickRubber
        position [0.0085, 0.031763, 0.011054]
        rotation [-0.169532, 0.037584, 0.213151, 0.961464]
        scale [0.0052, 0.0017, 0.0009]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0006
      }
      shape Prism "speaker" {
        material: brickKeys
        position [0.0225, 0.027935, 0.012234]
        rotation [-0.150384, 0.086824, 0.492404, 0.852869]
        scale [0.0045, 0.0007, 0.0004]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        domain [repeat(spacing: [0.0032, 1, 1], limit: [2, 0, 0], origin: [-0.0225, 0.027935, -0.012234])]
      }
      shape Box "power-switch" {
        material: brickKeys
        position [-0.022, 0.134878, -0.036906]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.0045, 0.0016, 0.003]
      }
      shape Box "ir-window" {
        material: brickLens
        position [0.014, 0.134656, -0.035761]
        rotation [-0.173648, 0, 0, 0.984808]
        scale [0.007, 0.0012, 0.0032]
      }
      shape Box "stand-base" {
        material: brickStand
        position [0, 0.0025, -0.009051]
        scale [0.032, 0.0035, 0.032664]
        chamfer: 0.0012
      }
      shape Box "stand-lip" {
        material: brickStand
        position [0, 0.009, 0.020413]
        scale [0.032, 0.0045, 0.0022]
        chamfer: 0.0008
      }
      shape Prism "stand-rest" {
        material: brickStand
        position [0, 0.028983, -0.023986]
        rotation [0, 0.707107, 0, 0.707107]
        scale [0.015729, 0.023983, 0.024]
        profile {
          kind: "Convex"
          vertices [
            [-1, -1]
            [0.109928, 1]
            [1, 1]
            [1, -1]
          ]
        }
      }
    }
  }

  // The clamshell in two frames meeting at its hinge axis: the lower half's (x right, y from the hinge toward its front
  // edge running negative, z out of the control face), turned -60 degrees about x so the half lies 30 degrees up from
  // level on the stand, whose underside is the prototype's y = 0 (the plinth's top); and the upper half's (y from
  // the hinge up the screen, z out of the glass), turned -30 degrees, the 150-degree stop. The halves are 82 and 80 mm
  // long, 13.3 and 10.4 mm thick, chamfered 1.2 mm round every rim; each half begins 1.6 mm from the axis. The dark
  // glass covers the upper half's face to 2 mm of its edges, and the screen's picture (screen 1) lies centred on it,
  // 42.6 mm from the axis, its face 1 mm proud. The lower half carries the d-pad at (-26.5, -41.6) mm in its frame, A
  // and B at (30, -37.1) and (18.5, -45.1), select and start at (-33.5, -67.6) and (-21.5, -67.6), five speaker slots
  // at (26, -69.6), the power light by the hinge, the shoulder keys at its back corners and the cartridge out of its
  // front edge.
  prototype "device-advanced-gaming-brick" {
    document {
      name: "ADVANCED GAMING BRICK"
      schema: "puck.creation.v1"
      palette: advancedPalette
      shape Prism "lower-shell" {
        material: agbShell
        position [0, 0.039259, 0.015818]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0423, 0.041, 0.00665]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.17
        }
        chamfer: 0.0012
      }
      shape Prism "upper-shell" {
        material: agbShell
        position [0, 0.097559, -0.040867]
        rotation [-0.258819, 0, 0, 0.965926]
        scale [0.0423, 0.04, 0.0052]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.17
        }
        chamfer: 0.0012
      }
      shape Prism "glass" {
        material: agbGlass
        position [0, 0.100825, -0.03721]
        rotation [-0.258819, 0, 0, 0.965926]
        scale [0.0402, 0.0372, 0.0006]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.12
        }
      }
      shape Cylinder "hinge" {
        material: agbPolished
        position [0, 0.061134, -0.020748]
        rotation [0, 0, 0.707107, 0.707107]
        scale [0.0062, 0.03, 0.0062]
        rounding: 0.0015
      }
      shape Box "shoulder-left" {
        material: agbKeys
        position [-0.034, 0.060229, -0.020803]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0075, 0.0025, 0.0045]
        chamfer: 0.001
      }
      shape Box "shoulder-right" {
        material: agbKeys
        position [0.034, 0.060229, -0.020803]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0075, 0.0025, 0.0045]
        chamfer: 0.001
      }
      shape Prism "dpad-ring" {
        material: agbPolished
        position [-0.0265, 0.045605, 0.018327]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0118, 0.0118, 0.0003]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
      }
      shape Box "dpad-across" {
        material: agbKeys
        position [-0.0265, 0.046298, 0.018727]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0095, 0.0032, 0.0014]
        chamfer: 0.0006
      }
      shape Box "dpad-down" {
        material: agbKeys
        position [-0.0265, 0.046298, 0.018727]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0032, 0.0095, 0.0014]
        chamfer: 0.0006
      }
      shape Prism "button-a" {
        material: agbKeys
        position [0.03, 0.048461, 0.01478]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0045, 0.0045, 0.0013]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0008
      }
      shape Prism "button-b" {
        material: agbKeys
        position [0.0185, 0.044461, 0.021708]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0045, 0.0045, 0.0013]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0008
      }
      shape Prism "select" {
        material: agbKeys
        position [-0.0335, 0.033038, 0.041094]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0024, 0.0024, 0.0009]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0006
      }
      shape Prism "start" {
        material: agbKeys
        position [-0.0215, 0.033038, 0.041094]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0024, 0.0024, 0.0009]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.0006
      }
      shape Prism "speaker" {
        material: agbGlass
        position [0.026, 0.031605, 0.042576]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0006, 0.0045, 0.0003]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        domain [repeat(spacing: [0.0025, 1, 1], limit: [2, 0, 0], origin: [-0.026, 0.031605, -0.042576])]
      }
      shape Sphere "power-led" {
        material: agbLed
        position [0.036, 0.059691, -0.005872]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0009, 0.0009, 0.0009]
      }
      shape Box "cartridge" {
        material: agbCartridge
        position [0, 0.017399, 0.054581]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.0285, 0.0045, 0.0034]
        chamfer: 0.0008
      }
      shape Prism "stand" {
        material: agbStand
        position [0, 0.023717, 0.014908]
        rotation [0, 0.707107, 0, 0.707107]
        scale [0.02728, 0.024717, 0.032]
        profile {
          kind: "Convex"
          vertices [
            [-1, -1]
            [-1, -0.274452]
            [1, 1]
            [1, -1]
          ]
        }
      }
    }
  }

  // The deck's stand: a walnut AV cabinet 1.2 m wide and 0.58 m deep, its 50 mm top 0.65 m up, open bays under the set
  // and the console with two spare cartridges in the right-hand one, a black kick, and the deck's name centred on the
  // top's front edge. Every part is a box, so the analytic contact collides the cabinet as it looks.
  prototype "device-humble-gaming-deck-stand" {
    document {
      name: "HUMBLE GAMING DECK"
      schema: "puck.creation.v1"
      palette [
        { color: "#5A3E2B", roughness: 0.55, specular: 0.04 }
        deviceLabel
        { color: "#1C1C1E", roughness: 0.6, specular: 0.04 }
        { color: "#8B8E94", roughness: 0.55, specular: 0.04 }
      ]
      shape Box "top" {
        material: standWood
        position [0, (deckTop - 0.025), 0]
        scale [0.6, 0.025, 0.29]
        chamfer: 0.003
      }
      shape Box "side-left" {
        material: standWood
        position [-0.585, 0.335, 0]
        scale [0.015, 0.29, 0.285]
      }
      shape Box "side-right" {
        material: standWood
        position [0.585, 0.335, 0]
        scale [0.015, 0.29, 0.285]
      }
      shape Box "divider" {
        material: standWood
        position [0.15, 0.335, 0]
        scale [0.012, 0.29, 0.28]
      }
      shape Box "shelf" {
        material: standWood
        position [-0.215, 0.34, 0]
        scale [0.36, 0.012, 0.275]
      }
      shape Box "bottom" {
        material: standWood
        position [0, 0.06, 0]
        scale [0.575, 0.015, 0.28]
      }
      shape Box "back" {
        material: standWood
        position [0, 0.335, -0.279]
        scale [0.575, 0.29, 0.006]
      }
      shape Box "kick" {
        material: standKick
        position [0, 0.024, -0.01]
        scale [0.57, 0.024, 0.26]
      }
      shape Box "spare-cartridge" {
        material: standCartridge
        position [0.33, 0.0835, 0.02]
        scale [0.06, 0.0095, 0.0665]
        chamfer: 0.002
      }
      shape Box "spare-cartridge-top" {
        material: standCartridge
        position [0.335, 0.102, 0.03]
        rotation [0, 0.069756, 0, 0.997564]
        scale [0.06, 0.0095, 0.0665]
        chamfer: 0.002
      }
      textRuns [{ text: "HUMBLE GAMING DECK", position [0, (deckTop - 0.04), 0.29], rotation [0, 0, 0, 1], emHeight: labelEm, depth: labelDepth, mode: "emboss", material: standLabel, align: "center" }]
    }
  }

  // A 27-inch flat-faced television on the cabinet's left (x tvX): a silver bezel 740 by 621 mm round the tube's
  // opening, a black body 505 mm deep with the tube's tapered housing and neck behind it, and under the picture a
  // full-width speaker grille, a badge, the power key and the standby light. The bezel's opening is carved through it
  // with a 6 mm bevel round its rim (the one subtraction, so the creation emits in one scope), and the tube's flat dark
  // face lies 5 mm back inside it. The picture (screen 2) stands 3 mm proud of that face, the rest of its slab sunk
  // into it.
  prototype "device-humble-gaming-deck-television" {
    document {
      name: "HUMBLE GAMING DECK TELEVISION"
      schema: "puck.creation.v1"
      palette [
        { color: "#1B1C1F", roughness: 0.4, specular: 0.05 }
        { color: "#8E9198", metal: 0.6, roughness: 0.35, specular: 0.4 }
        { color: "#141618", specular: 0.05, roughness: 0.06, coat: 0.6 }
        { color: "#1E1F22", roughness: 0.45, specular: 0.04 }
        { color: "#151517", roughness: 0.8, specular: 0.04 }
        { color: "#FF2A1A", emissive: 3 }
        { color: "#D0D3D8", metal: 1, roughness: 0.15, specular: 0.6 }
      ]
      shape Box "bezel" {
        material: tvTrim
        position [tvX, (((deckTop - 0.001) + (tubeTop + 0.03)) / 2), (tvFront - 0.06)]
        scale [0.37, (((tubeTop + 0.03) - (deckTop - 0.001)) / 2), 0.06]
        chamfer: 0.004
      }
      shape Box "opening" {
        material: tvTrim
        position [tvX, pictureY, (tvFront - 0.06)]
        scale [tubeHalfWidth, tubeHalfHeight, 0.07]
        blend: ChamferSubtraction
        smooth: 0.006
      }
      shape Prism "tube" {
        material: tvTube
        position [tvX, pictureY, (tubeFront - 0.008)]
        scale [(tubeHalfWidth + 0.012), (tubeHalfHeight + 0.012), 0.008]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.1
        }
      }
      shape Box "body" {
        material: tvCabinet
        position [tvX, (deckTop + 0.311), 0]
        scale [0.36, 0.3, 0.09]
        chamfer: 0.02
      }
      shape Box "tube-housing" {
        material: tvCabinet
        position [tvX, (deckTop + 0.33), -0.17]
        scale [0.3, 0.25, 0.09]
        chamfer: 0.06
      }
      shape Box "neck" {
        material: tvCabinet
        position [tvX, (deckTop + 0.35), -0.27]
        scale [0.17, 0.15, 0.03]
        chamfer: 0.02
      }
      shape Box "vents" {
        material: tvGrille
        position [tvX, (deckTop + 0.5795), -0.17]
        scale [0.005, 0.0012, 0.025]
        domain [repeat(spacing: [0.025, 1, 1], limit: [6, 0, 0], origin: [(0 - tvX), (deckTop + 0.5795), 0.17])]
      }
      shape Box "base" {
        material: tvKnobs
        position [tvX, (deckTop + 0.007), -0.03]
        scale [0.33, 0.008, 0.2]
      }
      shape Box "grille" {
        material: tvGrille
        position [tvX, (deckTop + 0.062), (tvFront - 0.0005)]
        scale [0.3, 0.032, 0.0025]
      }
      shape Box "badge" {
        material: tvChrome
        position [tvX, (deckTop + 0.109), (tvFront + 0.0005)]
        scale [0.03, 0.004, 0.0015]
        chamfer: 0.0008
      }
      shape Box "power" {
        material: tvKnobs
        position [(tvX + 0.335), (deckTop + 0.04), (tvFront + 0.0005)]
        scale [0.012, 0.006, 0.0025]
        chamfer: 0.001
      }
      shape Sphere "standby-led" {
        material: tvLed
        position [(tvX + 0.335), (deckTop + 0.062), (tvFront + 0.0005)]
        scale [0.0022, 0.0022, 0.0022]
      }
    }
  }

  // The console on the cabinet's right (x 0.3), 70 mm from the television: a top loader, 160 by 168 mm on four feet, a
  // graphite base under an aluminium deck, the graphite slot housing across its back with the cartridge standing in it
  // (its label the colour bars of the cartridge it boots), power and reset keys on the deck's front flanks, a power
  // light, and two controller ports in the base's face. Its pad lies on the cabinet in front, its cable plugged into
  // port 1.
  prototype "device-humble-gaming-deck" {
    document {
      name: "HUMBLE GAMING DECK"
      schema: "puck.creation.v1"
      palette [
        { color: "#3A3C41", metal: 0.85, roughness: 0.35, specular: 0.4 }
        { color: "#C7C9CE", metal: 0.9, roughness: 0.3, specular: 0.5 }
        { color: "#141517", roughness: 0.3, specular: 0.05 }
        { color: "#8B8E94", roughness: 0.55, specular: 0.04 }
        { color: "#EAF4FF", emissive: 3 }
        { color: "#B8312F", roughness: 0.3, specular: 0.05, coat: 0.3 }
        { color: "#F2F2F2", roughness: 0.5 }
        { color: "#F2E23A", roughness: 0.5 }
        { color: "#3AD8E8", roughness: 0.5 }
        { color: "#3EC24A", roughness: 0.5 }
        { color: "#D83AC8", roughness: 0.5 }
        { color: "#D8323A", roughness: 0.5 }
        { color: "#2E42D0", roughness: 0.5 }
        { color: "#111111", roughness: 0.5 }
      ]
      shape Cylinder "foot-left-back" {
        material: deckInlay
        position [0.24, 0.6515, -0.1]
        scale [0.006, 0.0025, 0.006]
      }
      shape Cylinder "foot-left-front" {
        material: deckInlay
        position [0.24, 0.6515, 0.02]
        scale [0.006, 0.0025, 0.006]
      }
      shape Cylinder "foot-right-back" {
        material: deckInlay
        position [0.36, 0.6515, -0.1]
        scale [0.006, 0.0025, 0.006]
      }
      shape Cylinder "foot-right-front" {
        material: deckInlay
        position [0.36, 0.6515, 0.02]
        scale [0.006, 0.0025, 0.006]
      }
      shape Prism "base" {
        material: deckGraphite
        position [0.3, 0.67, -0.04]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.08, 0.084, 0.016]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.28
        }
        chamfer: 0.003
      }
      shape Prism "deck" {
        material: deckAluminium
        position [0.3, 0.6925, -0.044]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.0755, 0.078, 0.008]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.26
        }
        chamfer: 0.0035
      }
      shape Prism "slot-housing" {
        material: deckGraphite
        position [0.3, 0.7065, -0.075]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.069, 0.032, 0.0075]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.3
        }
        chamfer: 0.004
      }
      shape Box "slot" {
        material: deckInlay
        position [0.3, 0.7142, -0.075]
        scale [0.0625, 0.0006, 0.0115]
      }
      shape Box "cartridge" {
        material: deckCartridge
        position [0.3, 0.75, -0.075]
        scale [0.06, 0.04, 0.0095]
        chamfer: 0.002
      }
      shape Box "label-0" {
        material: deckBarWhite
        position [0.26325, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "label-1" {
        material: deckBarYellow
        position [0.27375, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "label-2" {
        material: deckBarCyan
        position [0.28425, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "label-3" {
        material: deckBarGreen
        position [0.29475, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "label-4" {
        material: deckBarMagenta
        position [0.30525, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "label-5" {
        material: deckBarRed
        position [0.31575, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "label-6" {
        material: deckBarBlue
        position [0.32625, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "label-7" {
        material: deckBarBlack
        position [0.33675, 0.765, -0.0653]
        scale [0.00525, 0.017, 0.0004]
      }
      shape Box "power" {
        material: deckInlay
        position [0.255, 0.702, -0.005]
        scale [0.013, 0.0035, 0.009]
        chamfer: 0.0015
      }
      shape Box "reset" {
        material: deckInlay
        position [0.345, 0.702, -0.005]
        scale [0.013, 0.0035, 0.009]
        chamfer: 0.0015
      }
      shape Box "power-led" {
        material: deckLed
        position [0.35, 0.676, 0.044]
        scale [0.006, 0.0008, 0.0008]
      }
      shape Prism "port-1" {
        material: deckInlay
        position [0.272, 0.669, 0.0444]
        scale [0.0055, 0.0085, 0.0008]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.5
        }
      }
      shape Prism "port-2" {
        material: deckInlay
        position [0.328, 0.669, 0.0444]
        scale [0.0055, 0.0085, 0.0008]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.5
        }
      }
      shape Box "plug" {
        material: deckInlay
        position [0.272, 0.669, 0.052]
        scale [0.007, 0.0095, 0.008]
        chamfer: 0.0015
      }
      shape Cylinder "pad-left" {
        material: deckAluminium
        position [0.206, 0.659, 0.164]
        scale [0.026, 0.0095, 0.026]
        rounding: 0.004
      }
      shape Cylinder "pad-right" {
        material: deckAluminium
        position [0.274, 0.659, 0.164]
        scale [0.026, 0.0095, 0.026]
        rounding: 0.004
      }
      shape Prism "pad-bridge" {
        material: deckAluminium
        position [0.24, 0.659, 0.164]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.034, 0.02, 0.0085]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.5
        }
        rounding: 0.003
      }
      shape Box "pad-dpad-across" {
        material: deckInlay
        position [0.206, 0.6697, 0.164]
        scale [0.0105, 0.0016, 0.0034]
        chamfer: 0.0006
      }
      shape Box "pad-dpad-down" {
        material: deckInlay
        position [0.206, 0.6697, 0.164]
        scale [0.0034, 0.0016, 0.0105]
        chamfer: 0.0006
      }
      shape Prism "pad-b" {
        material: deckButtons
        position [0.2655, 0.6695, 0.169]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.0048, 0.0048, 0.0016]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.001
      }
      shape Prism "pad-a" {
        material: deckButtons
        position [0.283, 0.6695, 0.161]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.0048, 0.0048, 0.0016]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
        rounding: 0.001
      }
      shape Prism "pad-select" {
        material: deckInlay
        position [0.232, 0.6678, 0.167]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.0055, 0.002, 0.0012]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
      }
      shape Prism "pad-start" {
        material: deckInlay
        position [0.248, 0.6678, 0.167]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.0055, 0.002, 0.0012]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 1
        }
      }
      shape Sweep "cable" {
        material: deckInlay
        position [0.24, 0.656, 0.143]
        curve {
          a [0, 0, 0]
          b [0.05, -0.012019, -0.042]
          c [0.032, 0.013, -0.084]
          radiusStart: 0.0022
          radiusEnd: 0.0022
        }
      }
    }
  }
}

placements {
  placement "device-humble-gaming-brick-plinth" {
    prototype: "device-humble-gaming-brick-plinth"
    position [17.5, deviceFloor, deviceZ]
    yawDegrees: 0
    solid
  }

  placement "device-humble-gaming-brick" {
    prototype: "device-humble-gaming-brick"
    position [17.5, (deviceFloor + plinthTop), deviceZ]
    yawDegrees: 0
    scale: handheldScale
  }

  placement "device-advanced-gaming-brick-plinth" {
    prototype: "device-advanced-gaming-brick-plinth"
    position [15, deviceFloor, deviceZ]
    yawDegrees: 0
    solid
  }

  placement "device-advanced-gaming-brick" {
    prototype: "device-advanced-gaming-brick"
    position [15, (deviceFloor + plinthTop), deviceZ]
    yawDegrees: 0
    scale: handheldScale
  }

  placement "device-humble-gaming-deck-stand" {
    prototype: "device-humble-gaming-deck-stand"
    position [12.5, deviceFloor, deviceZ]
    yawDegrees: 0
    solid
  }

  placement "device-humble-gaming-deck-television" {
    prototype: "device-humble-gaming-deck-television"
    position [12.5, deviceFloor, deviceZ]
    yawDegrees: 0
  }

  placement "device-humble-gaming-deck" {
    prototype: "device-humble-gaming-deck"
    position [12.5, deviceFloor, deviceZ]
    yawDegrees: 0
  }
}

// Each machine boots a shipped cartridge, so the world boots the same on every machine, and swaps to any file
// `machine.content` lists from its folders. The brick is the Color model, which runs the forge's cgb and dmg targets
// alike. A device's last folder is the owner's local, git-ignored `roms/` at the repository root, which resolves when
// the world boots from this source and is listed as absent wherever it does not exist. Each device prefers its folders'
// default: where a local folder's own `folder.json` names one (`machine.default`), the device boots it instead of its
// shipped cartridge, and everywhere else it boots the shipped cartridge.
machines [
  {
    name: "humble-gaming-brick"
    engine: "gaming-brick"
    configuration {
      schema: "puck.gaming-brick.configuration.v1"
      model: "cgb"
      content {
        path: "cartridges/cgb/tetromino.cgb.cartridge.json"
      }
    }
    contentFolders ["cartridges/cgb", "cartridges/dmg", "../../roms/hgb"]
    preferFolderDefault: true
  }
  {
    name: "advanced-gaming-brick"
    engine: "advanced-gaming-brick"
    configuration {
      schema: "puck.advanced-gaming-brick.config.v1"
      content {
        path: "cartridges/agb/pip.agb.cartridge.json"
      }
    }
    contentFolders ["cartridges/agb", "../../roms/agb"]
    preferFolderDefault: true
  }
  {
    name: "humble-gaming-deck"
    engine: "humble-gaming-deck"
    configuration {
      schema: "puck.humble-gaming-deck.configuration.v1"
      content {
        path: "cartridges/deck/colour-bars.nes"
      }
    }
    contentFolders ["cartridges/deck", "../../roms/hgd"]
    preferFolderDefault: true
  }
]

// The pad a seat wears on a device it engages: the Moth's movement drives the d-pad, jump is A, flight is B, the start
// channel (the pad's Start, Enter on a keyboard) is start and the select channel (the pad's Back, right Shift) is select.
kits {
  rows [
    {
      name: "devicePad"
      bodyMotionProgram: "walk"
      motion {
        holds [
          {
            bond: Free
            envelope {
              sinkSpeed: 40
            }
            gravity {
              fall: 46
              rise: 28
            }
            hold: Gravity
            name: "air"
          }
        ]
        shaping [
          {
            along {}
          }
        ]
        speed {
          value: 4
        }
        turn {
          rate: 2
        }
      }
      pad {
        forward: "LeftStickY"
        strafe: "LeftStickX"
        jump: "South"
        flight: "East"
        start: "Start"
        select: "Back"
      }
    }
  ]
}

// The debug world draws no HUD panels: the controller bar is its only on-screen UI, so engaging a device shows no
// prompt. The section's panel list lives here because the garden, which imports controls.puck too, authors its own.
hud {
  panels []
}

// Each screen's glass is exactly its picture: the source's width and height in pixels at the device's pixel pitch, the
// device's case lying outside it, never inside. The handhelds' pixels are square, their pitch the real one at the
// handhelds' shown scale; the television's are 8:7, as wide as tall times 8/7 (deckPitchX, beside the television's
// frame). Each glass is a thin slab square to its device's face. A screen's `origin` is the glass's front face, not its
// middle (the slab runs 2 halfDepth back from it), and it stands proud of the lens or tube round it (1 mm at the
// handhelds' real size, 3 mm on the television, whose bake is coarser), the rest of its depth sunk into the face: a
// face behind the lens's is hidden by it and shows no picture. Each handheld's origin is its real offset from the
// plinth's top, scaled with the device.
//
//   screen 0, the brick: 160 by 144 at 0.4125 mm (0.275 real), 66 by 59.4 mm, leaning back 20 degrees with the brick
//   screen 1, the advanced brick: 240 by 160 at 0.3825 mm (0.255 real), 91.8 by 61.2 mm, leaning back 30 degrees with
//   its upper half
//   screen 2, the deck: 256 by 240 at 2.143 by 1.875 mm, 548.6 by 450 mm, upright in the television
let brickPitch = (0.000275 * handheldScale)
let advancedPitch = (0.000255 * handheldScale)
// Each engages on the Moth's context button (`interact`), which the pad does not play, so the same press leaves. Once
// the camera has framed the picture, the window shows it alone, as a desktop emulator does, on the matte its route's
// `display` fills: black on every device.
let deviceDisplay = { fill: "#000000" }
let deviceRoute = { engageable: true, engageRadius: 3, engageChannel: "interact", kit: "devicePad", display: deviceDisplay }

screens [
  {
    index: 0
    origin [17.5, ((deviceFloor + plinthTop) + (handheldScale * 0.105102)), (deviceZ + (handheldScale * 0.014043))]
    right [-1, 0, 0]
    up [0, 0.939693, 0.34202]
    halfWidth: ((160 * brickPitch) / 2)
    halfHeight: ((144 * brickPitch) / 2)
    halfDepth: (0.001 * handheldScale)
    round: 0
    source: machine(instance: `humble-gaming-brick`, output: "video")
    route: deviceRoute
  }
  {
    index: 1
    origin [15, ((deviceFloor + plinthTop) + (handheldScale * 0.101622)), (deviceZ + (handheldScale * 0.035821))]
    right [-1, 0, 0]
    up [0, 0.866025, 0.5]
    halfWidth: ((240 * advancedPitch) / 2)
    halfHeight: ((160 * advancedPitch) / 2)
    halfDepth: (0.001 * handheldScale)
    round: 0
    source: machine(instance: `advanced-gaming-brick`, output: "video")
    route: deviceRoute
  }
  {
    index: 2
    origin [(12.5 - tvX), (deviceFloor + pictureY), (deviceZ - (tubeFront + 0.003))]
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: pictureHalfWidth
    halfHeight: pictureHalfHeight
    halfDepth: 0.003
    round: 0
    source: machine(instance: `humble-gaming-deck`, output: "video")
    // The deck has two controller ports; an engaged seat plays the first.
    route {
      engageable: true
      engageRadius: 3
      engageChannel: "interact"
      kit: "devicePad"
      port: "controls"
      display: deviceDisplay
    }
  }
]
