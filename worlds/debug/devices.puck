        position [0, 1.250825, -0.03721]
        rotation [-0.258819, 0, 0, 0.965926]
        scale [0.0402, 0.0372, 0.0006]
        profile {
          kind: "RoundedRectangle"
          cornerRadius: 0.12
        }
      }
      shape Cylinder "hinge" {
