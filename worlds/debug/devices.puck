        scale [0.0095, 0.0032, 0.0014]
        chamfer: 0.0006
      }
      shape Box "dpad-down" {
        material: agbKeys
        position [-0.0265, 1.196298, 0.018727]
        rotation [-0.5, 0, 0, 0.866025]
