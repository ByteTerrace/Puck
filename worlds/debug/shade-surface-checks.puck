// Execution witnesses: wrapped backfaces under a blocker, lane-turned normals,
// the standard cel style, and local flow on rotated static glass copies.
schema: "puck.world.definition.v1"
basis: "shade-checks"
documentId: "shade-surface-checks"
import "../standard/styles"
import "../standard/water"

shade template shadowProbe() {
  surface {
    wrap: lanes.world0
    normal: normalize(surface.normal + [0, 0, 2] * lanes.world1)
  }
}
state {
  world {
    slot shadeWrap = 1
    slot shadeTilt = 0
  }
}
render {
  shadows: High
  lanes ["state.shadeWrap", "state.shadeTilt"]
  lighting {
    lights [
      directional(
        name: "key",
        direction: [1, 1, 1],
        color: "#FFFFFF",
        illuminance: 100000lx,
        shadow: always,
        angularRadius: 0.2
      )
    ]
  }
  sky {
    layers [
      gradient(
        name: "dark",
        visibility: lighting,
        stops: [{ elevation: -1, color: "#000000" }, { elevation: 1, color: "#000000" }]
      )
    ]
  }
}
prototypes {
  prototype "shade-sphere" {
    document {
      schema: "puck.creation.v1"
      palette [{ color: "#C9A27E", roughness: 0.6, specular: 0.04, wrap: 0.35, toon: celStyle }]
      shape Sphere "sphere" {
        position [0, 1, -3]
        scale [1, 1, 1]
      }
    }
  }
  prototype "shade-panel" {
    document {
      schema: "puck.creation.v1"
      palette [{ color: "#FFFFFF", roughness: 1, specular: 0, shade: shadowProbe() }]
      shape Box "panel" {
        scale [0.8, 0.8, 0.04]
      }
    }
  }
  prototype "shade-blocker" {
    document {
      schema: "puck.creation.v1"
      palette [{ color: "#303030", roughness: 1, specular: 0 }]
      shape Box "blocker" {
        scale [2, 2, 0.2]
      }
    }
  }
  prototype "shade-water" {
    document {
      schema: "puck.creation.v1"
      palette [
        flowed(waterMaterial, stillFlowLayer with { frame: Object, coverage: 0.3, tilt: 0.1 }, world: 0, glass: 1)
      ]
      shape Box "water" {
        scale [1.5, 0.1, 1.5]
      }
    }
  }
}
placements {
  placement "shade-open" {
    prototype: "shade-panel"
    position [4, 1, 3]
    solid
  }
  placement "shade-shadowed" {
    prototype: "shade-panel"
    position [8, 1, 3]
    solid
  }
  placement "shade-blocker" {
    prototype: "shade-blocker"
    position [10, 3, 5]
    solid
  }
  placement "shade-water-a" {
    prototype: "shade-water"
    position [-4, 0.15, 3]
  }
  placement "shade-water-b" {
    prototype: "shade-water"
    position [-8, 0.15, 3]
    yawDegrees: 90
  }
}
