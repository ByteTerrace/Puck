// A scenario fixture imports this when none of its claims reads a machine: every device of the debug world stays
// mounted, engageable and swappable, but the host does not advance it, so a scenario does not pay for emulating
// cartridges it never looks at. A machine added to the debug world (devices.puck, range.puck, gallery/toybox.puck,
// gallery/rentals.puck) is added here too; the toybox's decks and the rentals' handhelds come by name from the plan
// that places them (gallery/layout.puck).
import "gallery/layout"

machines: map(
  concat(
    ["humble-gaming-brick", "advanced-gaming-brick", "humble-gaming-deck", "range-deck-9", "range-deck-24", "range-deck-50"],
    toyboxMachines,
    rentalMachines
  ),
  name => { name: name, running: false }
)
