// The Moth's climbing on two walls of her studio, with her own kit and bindings. The east wall is a thin holdable face
// 6 m tall in front of a plain block whose top is ordinary floor, so the top is a mantle onto ground no hold can take.
// The west wall is 30 m tall, more than one wheel of stamina climbs. Both face along X, which a camera-framed walker
// reads as her strafe axis, so each climb also proves the command is laid onto the face. She is posed facing the wall
// (yaw 270 faces +X, 90 faces -X) and the keys are hers: W drives where she faces, D to her right, Space jumps, Left
// Shift runs. A square pillar to the north, holdable all round, is the outside corner she swings round; a thin fin to
// the east, 4 m tall with nothing behind it, is a top that cannot be stood on.
// `puck test worlds/debug/climb-tests.puck --reproduce`.
schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "climb-tests"

import "set-controls"

prototypes {
  prototype "climb-face" {
    document {
      schema: "puck.creation.v1"
      name: "climb-face"
      palette [{ color: "#8A7F72" }]
      shape Box {
        position [0, 0, 0]
        scale [0.2, 3, 4]
        material: 0
      }
    }
  }
  prototype "climb-block" {
    document {
      schema: "puck.creation.v1"
      name: "climb-block"
      palette [{ color: "#B9B2A6" }]
      shape Box {
        position [0, 0, 0]
        scale [2, 3, 4]
        material: 0
      }
    }
  }
  prototype "climb-tower" {
    document {
      schema: "puck.creation.v1"
      name: "climb-tower"
      palette [{ color: "#8A7F72" }]
      shape Box {
        position [0, 0, 0]
        scale [0.2, 15, 4]
        material: 0
      }
    }
  }
  prototype "climb-pillar" {
    document {
      schema: "puck.creation.v1"
      name: "climb-pillar"
      palette [{ color: "#8A7F72" }]
      shape Box {
        position [0, 0, 0]
        scale [1, 4, 1]
        material: 0
      }
    }
  }
  prototype "climb-fin" {
    document {
      schema: "puck.creation.v1"
      name: "climb-fin"
      palette [{ color: "#8A7F72" }]
      shape Box {
        position [0, 0, 0]
        scale [0.05, 2, 2]
        material: 0
      }
    }
  }
}

placements {
  // The east face stands from x 6.0 to 6.4 and the block behind it to 10.4, both 6 m tall and 8 m wide.
  placement "climb-face" {
    prototype: "climb-face"
    position [6.2, 3, 0]
    grip {
      holdable: true
    }
    solid
  }
  placement "climb-block" {
    prototype: "climb-block"
    position [8.4, 3, 0]
    solid
  }
  // The west face stands at x -6.0, 30 m tall.
  placement "climb-tower" {
    prototype: "climb-tower"
    position [-6.2, 15, 0]
    grip {
      holdable: true
    }
    solid
  }
  // The pillar stands from x -1 to 1 and z -13 to -11, 8 m tall: its south face is at z -11 and its east face at x 1.
  placement "climb-pillar" {
    prototype: "climb-pillar"
    position [0, 4, -12]
    grip {
      holdable: true
    }
    solid
  }
  // The fin's west face stands at x 11.95, 4 m tall and 0.1 m thick, from z -12 to -8: thinner than her body, so a step
  // in over its top finds nothing under her.
  placement "climb-fin" {
    prototype: "climb-fin"
    position [12, 2, -10]
    grip {
      holdable: true
    }
    solid
  }
}

test "walking into a wall takes it and driving on climbs it" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 45
    seat1: player.signal keyboard.w release
  }
  expect {
    bodyPosition(body, 0, y) > 2
    bodyPosition(body, 0, y) < 3.3
    bodyPosition(body, 0, x) > 5.5
    bodyPosition(body, 0, x) < 5.8
    fact(body, 0, HoldingUnwalkable) == 1
    bodyState(body, 0, stamina) < 9.5
  }
}

test "brushing a wall for a moment is not a grab" {
  when {
    ticks 15
    seat1: body.pose 5.6 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 4
    seat1: player.signal keyboard.w release
    ticks 10
  }
  expect {
    fact(body, 0, HoldingUnwalkable) == 0
    fact(body, 0, Grounded) == 1
    bodyState(body, 0, stamina) == 10
  }
}

test "hanging still spends nothing and holds her where she is" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 45
    seat1: player.signal keyboard.w release
    ticks 120
  }
  expect {
    bodyPosition(body, 0, y) > 2
    bodyPosition(body, 0, y) < 3.3
    fact(body, 0, HoldingUnwalkable) == 1
    bodyState(body, 0, stamina) > 8.5
  }
}

test "the top of the wall is a mantle onto plain floor" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 80
    seat1: player.signal keyboard.w release
    ticks 30
  }
  expect {
    bodyPosition(body, 0, y) > 5.9
    bodyPosition(body, 0, y) < 6.2
    bodyPosition(body, 0, x) > 6.1
    bodyPosition(body, 0, x) < 10
    fact(body, 0, Grounded) == 1
    fact(body, 0, HoldingUnwalkable) == 0
  }
}

test "jump on the wall leaps up it for a fifth of the wheel" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 20
    seat1: player.signal keyboard.space press
    ticks 3
    seat1: player.signal keyboard.space release
    ticks 12
    seat1: player.signal keyboard.w release
  }
  expect {
    bodyPosition(body, 0, y) > 3.3
    fact(body, 0, HoldingUnwalkable) == 1
    bodyState(body, 0, stamina) < 7.5
    bodyState(body, 0, flightFuel) == 0
  }
}

test "run lets go and the wall does not take her straight back" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 45
    seat1: player.signal keyboard.shiftLeft press
    ticks 6
  }
  expect {
    fact(body, 0, HoldingUnwalkable) == 0
    bodyState(body, 0, climbRest) > 0
  }
}

test "sideways she stops at the face's edge instead of walking off it" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 2.5 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 40
    seat1: player.signal keyboard.w release
    seat1: player.signal keyboard.d press
    ticks 90
    seat1: player.signal keyboard.d release
  }
  expect {
    bodyPosition(body, 0, z) > 3.3
    bodyPosition(body, 0, z) < 4.1
    bodyPosition(body, 0, y) > 1.5
    fact(body, 0, HoldingUnwalkable) == 1
  }
}

test "an emptied wheel lets go, and she cannot climb again until it refills" {
  when {
    ticks 15
    seat1: body.pose -5 0.05 0 90 0 0 0
    seat1: player.signal keyboard.w press
    ticks 420
  }
  expect {
    bodyState(body, 0, winded) == 1
    fact(body, 0, HoldingUnwalkable) == 0
    bodyPosition(body, 0, y) < 1
  }
}

test "the ground refills the wheel and clears winded" {
  when {
    ticks 15
    seat1: body.pose -5 0.05 0 90 0 0 0
    seat1: player.signal keyboard.w press
    ticks 420
    seat1: player.signal keyboard.w release
    ticks 150
  }
  expect {
    bodyState(body, 0, winded) == 0
    bodyState(body, 0, stamina) == 10
  }
}

// She takes the pillar's south face facing -Z, so D traverses toward +X, off the face's east end. The wrap lands her
// on the east face, one standoff off it and facing it, where D goes on toward -Z and W climbs.
test "traversing off an outside corner swings her round onto the next face" {
  when {
    ticks 15
    seat1: body.pose 0 0.05 -10 0 0 0 0
    seat1: player.signal keyboard.w press
    ticks 40
    seat1: player.signal keyboard.w release
    seat1: player.signal keyboard.d press
    ticks 34
    seat1: player.signal keyboard.d release
    ticks 5
  }
  expect {
    bodyPosition(body, 0, x) > 1.2
    bodyPosition(body, 0, x) < 1.5
    bodyPosition(body, 0, z) < -11.2
    bodyPosition(body, 0, z) > -12.7
    bodyPosition(body, 0, y) > 1.5
    fact(body, 0, HoldingUnwalkable) == 1
  }
}

test "round the corner her keys are still hers: forward climbs the new face" {
  when {
    ticks 15
    seat1: body.pose 0 0.05 -10 0 0 0 0
    seat1: player.signal keyboard.w press
    ticks 40
    seat1: player.signal keyboard.w release
    seat1: player.signal keyboard.d press
    ticks 34
    seat1: player.signal keyboard.d release
    seat1: player.signal keyboard.w press
    ticks 25
    seat1: player.signal keyboard.w release
  }
  expect {
    bodyPosition(body, 0, x) > 1.2
    bodyPosition(body, 0, x) < 1.5
    bodyPosition(body, 0, y) > 3.3
    fact(body, 0, HoldingUnwalkable) == 1
  }
}

// The right stick turns the camera, and on the ground her with it. On a wall it turns the camera alone, so W, which
// drives where she faces, still climbs after a third of a turn.
test "turning the camera on a wall does not turn her off it" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 40
    seat1: player.signal keyboard.w release
    seat1: player.signal gamepad.rightStick 1 0
    ticks 20
    seat1: player.signal gamepad.rightStick 0 0
    seat1: player.signal keyboard.w press
    ticks 25
    seat1: player.signal keyboard.w release
  }
  expect {
    bodyPosition(body, 0, y) > 3.3
    bodyPosition(body, 0, x) > 5.5
  }
}

// The left stick is camera-framed on the ground. On a wall it is hers: pushed forward it climbs wherever the camera
// has turned to.
test "the stick climbs whichever way the camera looks" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 40
    seat1: player.signal keyboard.w release
    seat1: player.signal gamepad.rightStick 1 0
    ticks 20
    seat1: player.signal gamepad.rightStick 0 0
    seat1: player.signal gamepad.leftStick 0 1
    ticks 25
    seat1: player.signal gamepad.leftStick 0 0
  }
  expect {
    bodyPosition(body, 0, y) > 3.3
    bodyPosition(body, 0, x) > 5.5
  }
}

// The fin's top is too thin to stand on, so she hangs under it. A leap there has nowhere to go: it is not made, and
// the wheel keeps what the leap would have cost.
test "a leap the top of the face would stop at once is not made and costs nothing" {
  when {
    ticks 15
    seat1: body.pose 11.2 0.05 -10 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 75
    seat1: player.signal keyboard.w release
    ticks 3
    seat1: player.signal keyboard.space press
    ticks 3
    seat1: player.signal keyboard.space release
    ticks 25
  }
  expect {
    bodyPosition(body, 0, y) > 2.4
    bodyPosition(body, 0, y) < 3.1
    fact(body, 0, HoldingUnwalkable) == 1
    bodyState(body, 0, stamina) > 8
  }
}

// From half way up the east wall a leap with nothing pushed goes straight up. Its top can be stood on, so where the
// leap brings the edge within her reach it becomes the mantle.
test "a leap that reaches a top she can stand on becomes the mantle" {
  when {
    ticks 15
    seat1: body.pose 5 0.05 0 270 0 0 0
    seat1: player.signal keyboard.w press
    ticks 50
    seat1: player.signal keyboard.w release
    ticks 3
    seat1: player.signal keyboard.space press
    ticks 3
    seat1: player.signal keyboard.space release
    ticks 45
  }
  expect {
    bodyPosition(body, 0, y) > 5.9
    bodyPosition(body, 0, y) < 6.2
    bodyPosition(body, 0, x) > 6.1
    fact(body, 0, Grounded) == 1
    fact(body, 0, HoldingUnwalkable) == 0
  }
}
