// The chess table's scenarios (chess.puck), each booted in the whole debug world: `puck test worlds/debug/chess-tests.puck`.
// A step poses a piece body onto a square's centre, 0.5 m over the table's top, and the piece drops onto the board. A
// piece's body is 39 minus its piece number (the e2 pawn, piece12, is body 27); square (file, rank) from a1 = (0, 0)
// stands at x = 57.2 - 0.2 * file, z = 21.9 + 0.2 * rank, and its cell is 8 * rank + 7 - file (e2 is 11, e4 27).
// x = 55.6 is beside the board past the h-file, on the table. Every scenario but the opponent's own leaves both sides to
// the steps (aiSide -1).

schema: "puck.world.definition.v1"
basis: "debug"
// Keep same-world portals in this fixture's boot instance instead of opening another live debug world.
documentId: "debug"

state {
  world {
    slot replayWitness = 0
  }
}

// Keep unrelated devices mounted but stopped in these table fixtures. World rules, bodies, the faerie and the
// other boards continue normally; emulating six cartridges is independent of the table's replay proof.
machines: map([
  "humble-gaming-brick", "advanced-gaming-brick", "humble-gaming-deck",
  "range-deck-9", "range-deck-24", "range-deck-50"
], name => { name: name, running: false })

// 37 plies (19 White moves). The first idle run records real accepted moves; the second proves the tape's
// per-tick scope hashes, while a world-owned cell outside the scope keeps its live value. No hash is authored.
test "the idle demo records all 19 moves then replays with matching scope hashes and loops" {
  given {
    aiSide = -1
    chessDemo.idleTicks = 30
    chessDemo.holdTicks = 30
  }
  when {
    ticks 150
    seat1: world.state.cell.set replayWitness $value 731
    seat1: body.pose 3 0.05 3 0 0 0 0
    ticks 3500
    seat1: world.state chessDemo
    // Keep a different table active during playback; its airborne disc must not affect this verdict.
    seat1: body.pose 65 30 22.6 0 0 0 108
    ticks 3400
  }
  expect {
    chessDemo.loops >= 2
    chessDemo.matches >= 1
    chessTape.completed >= 2
    illegalCount == 0
    chessDemo.cancelled == 0
    chessDemo.playing == 1
    replayWitness == 731
    // Normal contact correction can move her slightly; a whole-world reset would return her to the spawn.
    bodyPosition(body, 0, x) > 2.9
    bodyPosition(body, 0, x) < 3.1
    $tick > 7000
  }
}

test "the replay holds the historical final position and its scope verdict" {
  given {
    aiSide = -1
    chessDemo.idleTicks = 30
    chessDemo.holdTicks = 1200
  }
  when {
    ticks 4000
    seat1: world.state chessDemo
    ticks 4000
    seat1: world.state chessDemo
    ticks 150
  }
  expect {
    chessInput.accepted == 37
    turn == Black
    verdict == 1
    illegalCount == 0
    chessTape.status == 4
    chessDemo.matches == 1
    pieceCell.piece10 == 29
    pieceCell.piece28 == 61
  }
}

test "engaging the demo cancels it and restores a fresh playable table" {
  given {
    aiSide = -1
    chessDemo.idleTicks = 30
  }
  when {
    ticks 800
    seat1: body.pose 56.5 9.25 21.1 0 0 0 0
    ticks 100
    seat1: body.press interact
    ticks 30
  }
  expect {
    chessDemo.cancelled == 1
    chessDemo.playing == 0
    chessTape.status == 0
    chessInput.accepted == 0
    turn == White
    pieceCell.piece12 == 11
    board(engaged, board, 1) == 1
  }
}

test "a scope changed during replay reports a mismatch instead of blessing a new hash" {
  given {
    aiSide = -1
    chessDemo.idleTicks = 30
    chessDemo.holdTicks = 300
  }
  when {
    ticks 3800
    seat1: world.state.cell.set illegalCount $value 7
    ticks 3500
  }
  expect {
    chessTape.status == -1
    chessDemo.matches == 0
    chessDemo.loops == 2
  }
}

// Seat 1 stands at White's edge, sits down with the context button and plays e2-e4 with the keys (lift, two steps up
// the board, put down), then e7-e5 by dragging with the pointer (press over e7, move over e5, release).
test "a seated player plays e4 with the keys and e5 with a pointer drag" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 56.5 9.25 21.1 0 0 0 0
    ticks 150
    seat1: body.press interact
    ticks 5
    seat1: body.press confirm
    ticks 5
    seat1: body.press forward 1
    ticks 4
    seat1: body.press forward 1
    ticks 4
    seat1: body.press confirm
    ticks 150
    seat1: source.pointer.origin 56.4 12 23.1
    seat1: source.pointer.direction 0 -1 0
    ticks 3
    seat1: body.press confirm 1 1.0
    ticks 10
    seat1: source.pointer.origin 56.4 12 22.7
    ticks 190
  }
  expect {
    pieceCell.piece12 == 27
    pieceCell.piece20 == 35
    verdict == 1
    turn == White
    illegalCount == 0
    play.held == -1
  }
}

// Seat 1 sits down, lifts the e2 pawn and puts it back with the cancel button, steps left to d2 (from White's side the
// a-file is on the left), puts the d2 pawn down on d5, which is judged illegal and put back as it stood, steps back
// down and plays d2-d4, and the context button stands her up. Had the cancel not put e2 back, the d2 press would take
// nothing and no legal move would follow.
test "a seated player cancels a lift, an illegal put-down is put back and the context button stands her up" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 56.5 9.25 21.1 0 0 0 0
    ticks 150
    seat1: body.press interact
    ticks 5
    seat1: body.press confirm
    ticks 5
    seat1: body.press cancel
    ticks 150
    seat1: body.press strafe -1
    ticks 4
    seat1: body.press confirm
    ticks 5
    seat1: body.press forward 1
    ticks 4
    seat1: body.press forward 1
    ticks 4
    seat1: body.press forward 1
    ticks 4
    seat1: body.press confirm
    ticks 250
    seat1: body.press forward -1
    ticks 4
    seat1: body.press forward -1
    ticks 4
    seat1: body.press forward -1
    ticks 4
    seat1: body.press confirm
    ticks 5
    seat1: body.press forward 1
    ticks 4
    seat1: body.press forward 1
    ticks 4
    seat1: body.press confirm
    ticks 200
    seat1: body.press interact
    ticks 10
  }
  expect {
    pieceCell.piece12 == 11
    pieceCell.piece11 == 28
    illegalCount == 1
    turn == Black
    play.held == -1
    board(engaged, board, 1) == 0
  }
}

test "pieces settle and derive initial board cells" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
  }
  expect {
    pieceCell.piece12 == 11
    pieceCode.piece12 == Pawn
    gameStarted == 1
    boardCollisions == 0
  }
}

test "e2e4 records legal" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
    seat1: body.pose 56.4 10.35 22.5 0 0 0 27
    ticks 150
  }
  expect {
    verdict == 1
    pieceCell.piece12 == 27
    turn == Black
  }
}

test "illegal knight move records illegal then legal succeeds" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
    seat1: body.pose 56 10.35 22.3 0 0 0 33
    ticks 150
    seat1: body.pose 56.2 10.35 22.3 0 0 0 33
    ticks 150
  }
  expect {
    verdict == 1
    illegalCount == 1
    pieceCell.piece6 == 18
    turn == Black
  }
}

test "king step records legal and multi step refused" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 55.6 10.35 22.3 0 0 0 27
    ticks 150
    seat1: body.pose 56.4 10.35 22.3 0 0 0 35
    ticks 150
    seat1: body.pose 56.4 10.35 22.1 0 0 0 35
    ticks 150
  }
  expect {
    verdict == 1
    illegalCount == 1
    move.kind == Quiet
    move.mover == King
    pieceCell.piece4 == 11
    turn == Black
  }
}

test "knight capture records move kind two" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 56.8 10.35 22.3 0 0 0 23
    ticks 150
    seat1: body.pose 55.6 10.35 22.3 0 0 0 23
    seat1: body.pose 56.8 10.35 22.3 0 0 0 38
    ticks 150
  }
  expect {
    verdict == 1
    move.kind == Capture
    move.captured == -((Pawn))
    pieceCell.piece1 == 21
    pieceCell.piece16 == -1
    turn == Black
  }
}

test "pawn diagonal capture records legal" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 56.6 10.35 22.3 0 0 0 20
    ticks 150
    seat1: body.pose 55.6 10.35 22.3 0 0 0 20
    seat1: body.pose 56.6 10.35 22.3 0 0 0 27
    ticks 150
  }
  expect {
    verdict == 1
    move.kind == Capture
    move.captured == -((Pawn))
    move.mover == Pawn
    pieceCell.piece12 == 20
    pieceCell.piece19 == -1
    turn == Black
  }
}

test "queen diagonal slide records legal" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 55.6 10.35 22.3 0 0 0 27
    ticks 150
    seat1: body.pose 55.8 10.35 22.7 0 0 0 36
    ticks 150
  }
  expect {
    verdict == 1
    move.kind == Quiet
