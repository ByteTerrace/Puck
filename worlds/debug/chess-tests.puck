test "white kingside castle records legal" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 55.6 10.35 21.9 0 0 0 34
    seat1: body.pose 55.6 10.35 22.1 0 0 0 33
    ticks 150
    seat1: body.pose 55.6 10.35 22.3 0 0 0 32
    ticks 150
    seat1: body.pose 55.8 10.35 21.9 0 0 0 32
    ticks 150
    seat1: body.pose 56 10.35 21.9 0 0 0 35
    seat1: body.pose 56.2 10.35 21.9 0 0 0 32
    ticks 150
  }
  expect {
    verdict == 1
    move.kind == Castle
    move.mover == King
    move.from == 3
    move.to == 1
    pieceCell.piece4 == 1
    pieceCell.piece7 == 2
    castleRights == 3
    turn == Black
  }
}

// 1. Nc3 a6 2. d3 a5 3. Be3 a4 4. Qd2 h6 5. O-O-O: the king goes from e1 (cell 3) to c1 (cell 5) and the a1 rook
// (cell 7) to d1 (cell 4), past d1's transit check.
test "white queenside castle records legal" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
    seat1: body.pose 56.8 10.35 22.3 0 0 0 38
    ticks 150
    seat1: body.pose 57.2 10.35 22.9 0 0 0 23
    ticks 150
    seat1: body.pose 56.6 10.35 22.3 0 0 0 28
    ticks 150
    seat1: body.pose 57.2 10.35 22.7 0 0 0 23
    ticks 150
    seat1: body.pose 56.4 10.35 22.3 0 0 0 37
    ticks 150
    seat1: body.pose 57.2 10.35 22.5 0 0 0 23
    ticks 150
    seat1: body.pose 56.6 10.35 22.1 0 0 0 36
    ticks 150
    seat1: body.pose 55.8 10.35 22.9 0 0 0 16
    ticks 150
    seat1: body.pose 56.8 10.35 21.9 0 0 0 35
    seat1: body.pose 56.6 10.35 21.9 0 0 0 39
    ticks 150
  }
  expect {
    verdict == 1
    illegalCount == 0
    move.kind == Castle
    move.from == 3
    move.to == 5
    pieceCell.piece4 == 5
    pieceCell.piece0 == 4
    castleTransitAttacked.wq == 0
    castleRights == 3
    turn == Black
  }
}

// 1. e3 Nf6 2. a3 e6 3. a4 Be7 4. h3 O-O: the black king goes from e8 (cell 59) to g8 (cell 57) and the h8 rook (cell
// 56) to f8 (cell 58).
test "black kingside castle records legal" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
    seat1: body.pose 56.4 10.35 22.3 0 0 0 27
    ticks 150
    seat1: body.pose 56.2 10.35 22.9 0 0 0 9
    ticks 150
    seat1: body.pose 57.2 10.35 22.3 0 0 0 31
    ticks 150
    seat1: body.pose 56.4 10.35 22.9 0 0 0 19
    ticks 150
    seat1: body.pose 57.2 10.35 22.5 0 0 0 31
    ticks 150
    seat1: body.pose 56.4 10.35 23.1 0 0 0 10
    ticks 150
    seat1: body.pose 55.8 10.35 22.3 0 0 0 24
    ticks 150
    seat1: body.pose 56 10.35 23.3 0 0 0 11
    seat1: body.pose 56.2 10.35 23.3 0 0 0 8
    ticks 150
  }
  expect {
    verdict == 1
    illegalCount == 0
    move.kind == Castle
    move.from == 59
    move.to == 57
    pieceCell.piece28 == 57
    pieceCell.piece31 == 58
    castleTransitAttacked.bk == 0
    castleRights == 12
    turn == White
  }
}

test "castle cannot cross knight attack" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 55.6 10.35 21.9 0 0 0 34
    seat1: body.pose 55.6 10.35 22.1 0 0 0 33
    seat1: body.pose 56 10.35 22.3 0 0 0 9
    ticks 150
    seat1: body.pose 56 10.35 21.9 0 0 0 35
    seat1: body.pose 56.2 10.35 21.9 0 0 0 32
    ticks 150
  }
  expect {
    castleTransitAttacked.wk == 1
    verdict == 0
    turn == White
    castleRights == 0
  }
}

test "castle safe when knight does not attack transit" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    seat1: body.pose 55.6 10.35 21.9 0 0 0 34
    seat1: body.pose 55.6 10.35 22.1 0 0 0 33
    seat1: body.pose 57 10.35 22.3 0 0 0 9
    ticks 150
    seat1: body.pose 56 10.35 21.9 0 0 0 35
    seat1: body.pose 56.2 10.35 21.9 0 0 0 32
    ticks 150
  }
  expect {
    castleTransitAttacked.wk == 0
    verdict == 1
    turn == Black
    castleRights == 3
  }
}

test "move leaving king in check is refused" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
    seat1: body.pose 56.2 10.35 22.3 0 0 0 9
    ticks 150
    seat1: body.pose 56.4 10.35 22.5 0 0 0 27
    ticks 150
  }
  expect {
    inCheck[0] == 1
    verdict == 0
    turn == White
  }
}

test "en passant capture records move kind en passant" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
    seat1: body.pose 56.4 10.35 22.5 0 0 0 27
    ticks 150
    seat1: body.pose 57.2 10.35 22.9 0 0 0 23
    ticks 150
    seat1: body.pose 56.4 10.35 22.7 0 0 0 27
    ticks 150
    seat1: body.pose 56.6 10.35 22.7 0 0 0 20
    ticks 150
    seat1: body.pose 55.6 10.35 22.3 0 0 0 20
    seat1: body.pose 56.6 10.35 22.9 0 0 0 27
    ticks 150
  }
  expect {
    verdict == 1
    move.kind == EnPassant
    move.captured == -((Pawn))
    pieceCell.piece12 == 44
    pieceCell.piece19 == -1
    turn == Black
  }
}

test "initial position counts in threefold repetition" {
  given {
    chessDemo.enabled = 0
    aiSide = -1
  }
  when {
    ticks 150
    seat1: body.pose 56.2 10.35 22.3 0 0 0 33
    ticks 150
    seat1: body.pose 56.2 10.35 22.9 0 0 0 9
    ticks 150
    seat1: body.pose 56 10.35 21.9 0 0 0 33
    ticks 150
    seat1: body.pose 56 10.35 23.3 0 0 0 9
    ticks 150
    seat1: body.pose 56.2 10.35 22.3 0 0 0 33
    ticks 150
    seat1: body.pose 56.2 10.35 22.9 0 0 0 9
    ticks 150
    seat1: body.pose 56 10.35 21.9 0 0 0 33
    ticks 150
    seat1: body.pose 56 10.35 23.3 0 0 0 9
    ticks 150
  }
  expect {
    verdict == 1
    turn == White
    repetitionCount == 3
    historyLength == 9
    halfmoveClock == 8
  }
}

test "AI White makes one legal opening move and waits for Black" {
  given {
    chessDemo.enabled = 0
    aiSide = White
  }
  when {
    ticks 600
  }
  expect {
    turn == Black
    verdict == 1
    ai.pending == 0
    aiEnabled == 0
    aiBest.token == -1
    boardCollisions == 0
  }
}

test "AI Black replies after a human opening" {
  when {
    ticks 150
    seat1: body.pose 56.4 10.35 22.5 0 0 0 27
    ticks 600
  }
  expect {
    aiSide == Black
    turn == White
    ai.pending == 0
    aiEnabled == 0
    aiBest.token == -1
    boardCollisions == 0
  }
}

test "a stale AI answer cannot move a piece" {
  given {
    chessDemo.enabled = 0
    aiSide = White
    aiBest.token = 12
    aiBest.to = 63
    aiBest.revision = 0
  }
  when {
    ticks 600
  }
  expect {
    turn == Black
    pieceCell.piece12 != 63
    boardCollisions == 0
    ai.pending == 0
  }
}
