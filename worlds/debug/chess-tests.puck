// Holodeck chess on a game station of its own (game-stations.puck's gameStationRoom, chess-station.puck over chess.puck):
// `puck test worlds/debug/chess-tests.puck --reproduce`. The station shows chess from boot, so its 32 piece bodies stand
// on the glass and settle, and the first settled board is read as the starting position. Seat 1 boots at the near chair
// (White's), sits down with the context button and plays with the pointer straight down onto the glass: a square's
// centre stands at x = -0.6 + 0.15 * (column + 0.5), z = -0.56 + 0.15 * (row + 0.5), the glass at y = 0.95, and its cell
// is 8 * row + column, column = 7 - file (e2 is cell 11 at x -0.075, z -0.335; e4 cell 27 at z -0.035; g1 cell 1 at
// x -0.375, z -0.485; g3 cell 17 at z -0.185). With the near chair taken, the computer plays Black.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "chess-tests"

import "game-stations"

gameStationRoom(stations: [rootStation])

state {
  // The chess game's vocabularies (game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}

use gameStationGames as station(station: rootStation, index: 0)

// The holodeck stands every piece, the pieces settle, and the judge reads the starting position off them.
test "the station materializes its 32 pieces and reads the starting position off them" {
  when {
    ticks 240
  }
  expect {
    sum(station.holodeckLive) == 32
    station.gameStarted == 1
    station.boardCollisions == 0
    station.pieceCell.piece12 == 11
    station.pieceCell.piece28 == 59
    station.illegalCount == 0
  }
}

// Seat 1 lifts the e2 pawn's body, which hovers over the cursor, and sets it down on e4; the settled board is judged
// legal, and the computer answers for Black by moving one of its pieces' bodies, which settles and is judged in turn.
test "a seated player lifts e2 and sets it on e4, and the computer's reply lands" {
  when {
    ticks 240
    seat1: body.press interact
    ticks 5
    seat1: source.pointer.origin -0.075 3 -0.335
    seat1: source.pointer.direction 0 -1 0
    ticks 3
    seat1: body.press confirm
    ticks 10
    seat1: source.pointer.origin -0.075 3 -0.035
    ticks 3
    seat1: body.press confirm
    ticks 450
  }
  expect {
    station.pieceCell.piece12 == 27
    station.chessStationPlies == 2
    station.turn == White
    station.verdict == 1
    station.illegalCount == 0
    station.putDown.judging == 0
  }
}

// A knight set down where no knight moves is judged illegal and put back: the cells are restored and its body stands on
// g1 again, and it is still White's move.
test "an illegal physical move is refused and the knight stands on g1 again" {
  when {
    ticks 240
    seat1: body.press interact
    ticks 5
    seat1: source.pointer.origin -0.375 3 -0.485
    seat1: source.pointer.direction 0 -1 0
    ticks 3
    seat1: body.press confirm
    ticks 10
    seat1: source.pointer.origin -0.375 3 -0.185
    ticks 3
    seat1: body.press confirm
    ticks 300
  }
  expect {
    station.pieceCell.piece6 == 1
    station.illegalCount == 1
    station.turn == White
    station.chessStationPlies == 0
    station.putDown.judging == 0
    sum(station.holodeckLive) == 32
  }
}

// Showing Klondike releases every piece's body and holds the game where it stood; the deck's cards stand instead.
test "a game switch releases the pieces and stands the cards" {
  when {
    ticks 240
    seat1: world.state.cell.set gameStationGame station 1
    ticks 60
  }
  expect {
    sum(station.holodeckLive) == 0
    station.chessHold == 1
    station.pieceCell.piece12 == 11
    sum(holodeckLive) == 52
  }
}
