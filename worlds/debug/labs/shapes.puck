// The shape lab (README.md): one shape station on a bare floor, booted alone so a change to the station, its console or
// an exhibit boots and bakes without the building. It is the station the gallery stands twelve of: shapes.puck's
// plinth, turntable and console, and shape-station.puck's terminal and rules, expanded here for one display whose
// console lists the whole catalog, so `gallery.show <exhibit>` reaches every exhibit, the blends and cubic blends among
// them. Boot it with `--world worlds/debug/labs/shapes.puck`; shapes.md says how to iterate on it. The gallery's lab wing
// reaches it through its door `lab-shapes`, and the `arrival` frame behind the station's console leads back there.
//
// The seat boots at the console, on the `hero` spawn point (one `gallery` too, and one per exhibit, which `gallery.go`
// walks to): stand there, press the context button (E, or the pad's RB) and the camera eases to the station view. Every
// exhibit of the catalog is one tap on the console's list away.

schema: "puck.world.definition.v1"
basis: "../stage"
documentId: "lab-shapes"

// A clear, neutral midday that hardly moves.
import "../still-noon"
import "../../standard/contexts/modes"
import "../set-controls"
import "../noclip"
import "../ship-rows"
import "../shapes"
import "../../standard/frame"
import "../shape-station"
import "lab-kit"

metadata {
  title: "Shape lab"
  description: "One of the shape gallery's display stations on a bare floor, for iterating on the station and its exhibits."
}

// The way back stands 8 m before the console, facing it, so a body walks out of it toward the station.
labWayBack(id: "shapes", at: [0, 0, 8], yaw: 0)

// The one station: the display the gallery repeats, standing at the floor's centre in the world's own frame (no parent,
// and the identity frame for its site), its console facing +z. It is home to every exhibit, so the exhibits that stand a paint or a reach at the place
// they are shown (the paint and IK exhibits) stand them here.
let station = {
  id: "shapes"
  title: "SHAPE STATION"
  level: 0
  default: "shape-sphere"
  homes: map(galleryDisplayRows, group => group.id)
  x: 0
  z: 0
  yaw: 180
  floor: 0
  site: frameIdentity
  parent: null
}
let stations = [station]

// The seat boots before the console; `gallery` is the entrance `gallery.go` names, and each exhibit has a spawn point
// of its own at the same place.
spawnPoints: concat(
  [displaySpawn("hero", station), displaySpawn("gallery", station)],
  stationSpawns(stations)
)

commands: concat(
  galleryCommands,
  [
    goCommand(
      help: "Poses a body at one of the shape lab's places (hero and gallery at the console, an exhibit's name before it, or any spawn point) and returns the view to the play layout's chase camera."
    )
  ]
)

bodies {
  capacity: (seatPopulation + visitorPopulation)
  localSeats: seatPopulation
  networkPlayers: visitorPopulation
  seatSpawns [hero]
}

// What a seat may press: the Moth's movement and forms, the context button that engages the console and the tap that
// presses its glass, and the terminal's own channels while engaged and while its console is open.
inputModes {
  global: concat(movementChannels, ["interact", "tap", "scroll", "jump", "rise", "flight", "dash", "suit", "noclip"])
  families [
    terminalFamily()
    terminalConsoleFamily()
  ]
}

// The font the plinth labels and the console emboss and draw in, as the debug world declares it.
labText()

state {
  world {
    galleryState(displays: stations)
    displayState(displays: stations)
  }
}

placements {
  // The floor, a plain slab under the station's pad.
  placement "station-floor" {
    prototype: "station-floor"
    position [0, 0, 0]
    solid
  }
  displayPlacements(displays: stations)
}

prototypes {
  galleryPrototypes(displays: stations)

  // A slab ten metres either way with its top at the floor's height and the station's cream pad under it: a paint on a
  // static creation stands in the world's frame, so the pad is placed at the display.
  prototype "station-floor" {
    document {
      name: "station-floor"
      schema: "puck.creation.v2"
      palette [
        {
          color: "#A9A395"
          roughness: 0.6
          specular: 0.04
          paints [
            {
              type: "Box"
              position: displayWorld(station, [0, 0, 0])
              scale [1.875, 0.2, 1.875]
              color: "#EADBBE"
            }
          ]
        }
      ]
      shape Box "slab" {
        material: 0
        position [0, -0.5, 0]
        scale [10, 0.5, 10]
      }
    }
  }
}

// The station's terminal and its console, one display's worth of rules and cameras.
shapeStation(displays: stations)
