// The board games lab's stress mode: twelve game stations playing holodeck chess at once, the stress scenario for the
// board games under real use (board-games.puck beside it is the lab itself). Each station is the debug world set's
// station (../game-stations.puck), instanced under its own alias, so every station has its own rows, rules, piece
// bodies, topology and search job, and a move at one station never restarts another's search (a search job restarts when
// a row its judge's rules read changes, and no station's rules read another's rows). Every station's computer plays both
// sides from its own opening (chess-station.puck's `autoplay`), so all twelve lift pieces, settle and judge continuously,
// 384 rigid piece bodies in all; a game that stops passing turns (a draw limit, a mate) is set up afresh, every body
// standing on its starting square again. The stations open in four groups of three, eight ticks apart, so the worst tick
// sees three stations changing together.
//
// Boot it with `--world worlds/debug/labs/board-games-stress.puck`; the seat starts at the first station's near chair.
// What to read while it plays: `world.budget.rules --spent` (the sheet's total against the tick's ceiling and the top
// rules), `world.counters physics` (contacts, bodies awake, solver work), `world.search` (each station's job: restarts,
// lastRestart, spent and peak tick), `host.frames` (the tick's parts: rules, motion, contact) and `world.status` (bodies
// against capacity). `world.state s0$chessStationPlies` reads one station's turns played and `s0$chessStationGames` its
// games set up afresh; `station.chess s3 11 27` plays e2-e4 at station s3 through its move door. `puck test
// worlds/debug/labs/board-games-stress.puck --reproduce` plays every station's first turns twice and compares the runs.

schema: "puck.world.definition.v1"
basis: "../avatars/moth"
documentId: "board-games-stress"

import "../set-controls"
import "../../standard/skies"
import "../../standard/inputs"
import "../game-stations"

metadata {
  title: "Board games stress lab"
  description: "Twelve game stations, each playing holodeck chess against itself, for measuring the board games under load."
}

// The stations stand in a grid of four columns and three rows, 4 m apart, each placement 0.5 m under the floor so its
// creation's floor stands on it.
let stressColumns = 4
let stressRows = 3
let stressSpacing = 4
let stressStations = map(range(0, 12), index => {
  id: $"s{index}"
  at [
    (index % stressColumns - (stressColumns - 1) / 2) * stressSpacing,
    -0.5,
    (floor(index / stressColumns) - (stressRows - 1) / 2) * stressSpacing
  ]
})
// Station `index` opens once its board has first rested and its group's start has passed: four groups (the column), 8
// ticks apart. A station that passes no turn for 150 ticks (5 s at 30 Hz) starts afresh.
function stressAutoplay(index) = {
  start: 60 + 8 * (index % stressColumns)
  stall: 150
  opening: stressOpenings[index]
}
// Twelve White openings, one a station, as [from, to] cells (8 * rank + 7 - file from a1), so the games differ: e4, d4,
// c4, Nf3, Nc3, g3, b3, f4, e3, d3, a4 and h4.
let stressOpenings = [
  [11, 27],
  [12, 28],
  [13, 29],
  [1, 18],
  [6, 21],
  [9, 17],
  [14, 22],
  [10, 26],
  [11, 19],
  [12, 20],
  [15, 31],
  [8, 24]
]

gameStationRoom(stations: stressStations)

state {
  // The chess game's vocabularies (../game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}

use gameStationGames as s0(station: stressStations[0], index: 0, autoplay: stressAutoplay(0))
use gameStationGames as s1(station: stressStations[1], index: 1, autoplay: stressAutoplay(1))
use gameStationGames as s2(station: stressStations[2], index: 2, autoplay: stressAutoplay(2))
use gameStationGames as s3(station: stressStations[3], index: 3, autoplay: stressAutoplay(3))
use gameStationGames as s4(station: stressStations[4], index: 4, autoplay: stressAutoplay(4))
use gameStationGames as s5(station: stressStations[5], index: 5, autoplay: stressAutoplay(5))
use gameStationGames as s6(station: stressStations[6], index: 6, autoplay: stressAutoplay(6))
use gameStationGames as s7(station: stressStations[7], index: 7, autoplay: stressAutoplay(7))
use gameStationGames as s8(station: stressStations[8], index: 8, autoplay: stressAutoplay(8))
use gameStationGames as s9(station: stressStations[9], index: 9, autoplay: stressAutoplay(9))
use gameStationGames as s10(station: stressStations[10], index: 10, autoplay: stressAutoplay(10))
use gameStationGames as s11(station: stressStations[11], index: 11, autoplay: stressAutoplay(11))

render {
  farDistance: 200
  lighting {
    lights [
      sunlight(direction: [-2, 4, -3], color: "#FFF1D6", illuminance: 60000lx)
    ]
  }
  sky {
    clearDay()
  }
  atmosphere {
    clearDayAir()
  }
}

// Determinism at scale: every station opens and plays its turns, and two runs agree tick for tick under `--reproduce`.
// A station's turns are counted across the games it sets up afresh, so the claim holds whether a game ends early or not.
test "twelve stations each play their turns, and two runs agree" {
  when {
    ticks 1800
  }
  expect {
    s0.chessStationPlies >= 16
    s1.chessStationPlies >= 16
    s2.chessStationPlies >= 16
    s3.chessStationPlies >= 16
    s4.chessStationPlies >= 16
    s5.chessStationPlies >= 16
    s6.chessStationPlies >= 16
    s7.chessStationPlies >= 16
    s8.chessStationPlies >= 16
    s9.chessStationPlies >= 16
    s10.chessStationPlies >= 16
    s11.chessStationPlies >= 16
  }
}
