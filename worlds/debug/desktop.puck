// The desktop pane: a live capture of the Claude desktop app's window, shown as a pane below the play view and on a
// screen standing in the world. The debug world imports this file whole. desktop.md beside it gives the console lines
// that show the pane, hand the window the keyboard and mouse, take them back, and reload this file while it runs.
//
// The capture finds its window by title: the first visible top-level window whose title contains `claudeTitle`,
// compared without regard to case. Nothing here sends the window input: only the local user's own console opens a
// passthrough source (`source.passthrough open claude Claude`), and the engine refuses a document that tries.

let claudeTitle = "Claude"

// The capture's output extent and cadence. The window is scaled into this extent, and the pane shows it at the window's
// own aspect ratio whatever the extent's, so the extent sets only how many pixels the capture keeps: about a maximized
// window's shape on a 2560 by 1440 display, at three quarters of its size.
let claudeCapture = {
  windowTitle: claudeTitle
  profile { width: 1920, height: 1044, refreshRateHz: 30 }
}

// The wall screen's capture: the window at its own size and shape (2560 by 1392 here), so its text stays sharp on the
// wall. A window of another shape reads stretched until `wallCapture.profile` and the slab follow it.
let wallCapture = {
  windowTitle: claudeTitle
  profile { width: 2560, height: 1392, refreshRateHz: 30 }
}

// The pane's share of the display, from the bottom edge. Two fifths leave the play view the top three fifths.
let paneHeight = 0.4

views {
  // Contained: the window keeps its own aspect ratio, centred in its slot with bars beside it, and a pointer on a bar
  // stays with the game.
  graph "claude" {
    package: "source.capture"
    settings: claudeCapture
    fit: Contain
  }

  // `view.override layout desktop` shows it; `view.override layout play` (or `auto`) hides it.
  layout "desktop" {
    seatCount: 0
    slots [
      { x: 0, y: 0, width: 1, height: (1 - paneHeight) }
      { x: 0, y: (1 - paneHeight), width: 1, height: paneHeight, instance: "claude" }
    ]
    transitionRenderScale: 1
    transitionSeconds: 0
  }
}

// The same window as a wall screen: a 4 m wide glass slab, its height following the window's 2560 by 1392 shape, eight
// metres ahead of the spawn and eight to the right, facing +Z, beside the portal frame. It is its own capture of the
// window, at `wallCapture`'s full size.
screens [
  {
    index: 16
    origin [8, 1.2, -8]
    right [1, 0, 0]
    up [0, 1, 0]
    halfWidth: 2
    halfHeight: 1.0875
    halfDepth: 0.02
    round: 0
    source: producer(id: "capture", settings: wallCapture)
    filter: Linear
    route {
      engageable: false
      engageRadius: 0
    }
  }
]
