// The gallery's kit pieces, each as a creation of its own so `puck mesh preview --world worlds/debug/gallery-kit.puck
// --prototype <id>` judges its form in seconds without a World.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "gallery-kit"

import "../standard/architecture"

// The fan shade's easing, and the cell its preview follows.
dynamics [
  { name: "kit-shade", f: 0.5, r: 0, zeta: 1 }
]

state {
  world {
    slot kitShade = 1
  }
}

prototypes {
  prototype "kit-pier" {
    document {
      name: "kit-pier"
      schema: "puck.creation.v1"
      palette: structurePalette
      branchedPier(base: 0, height: 4.2, span: 2.0)
    }
  }
  prototype "kit-plinth" {
    document {
      name: "kit-plinth"
      schema: "puck.creation.v1"
      palette: plinthPalette
      exhibitPlinth(base: 0)
      shape Sphere "subject" {
        material: plinthBrass
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
    }
  }
  prototype "kit-bay" {
    document {
      name: "kit-bay"
      schema: "puck.creation.v1"
      palette: kitPalette
      windowBay(base: 0)
    }
  }
  prototype "kit-fan" {
    document {
      name: "kit-fan"
      schema: "puck.creation.v1"
      palette: kitPalette
      fanShade(base: 0, signal: "state.kitShade", dynamics: "kit-shade")
    }
  }
  prototype "kit-rail" {
    document {
      name: "kit-rail"
      schema: "puck.creation.v1"
      palette: kitPalette
      balustrade(base: 0)
    }
  }
  prototype "kit-planter" {
    document {
      name: "kit-planter"
      schema: "puck.creation.v1"
      palette: kitPalette
      planter(base: 0)
    }
  }
  prototype "kit-bench" {
    document {
      name: "kit-bench"
      schema: "puck.creation.v1"
      palette: kitPalette
      bench(base: 0)
    }
  }
  prototype "kit-banner" {
    document {
      name: "kit-banner"
      schema: "puck.creation.v1"
      palette: kitPalette
      banner(base: 0)
    }
  }
}

placements {
  for (id, index) in ["kit-plinth", "kit-pier", "kit-bay", "kit-rail", "kit-planter", "kit-bench"] {
    placement $"{id}" {
      prototype: id
      position [(index * 6), 0, 4]
    }
  }
  placement "kit-fan" {
    prototype: "kit-fan"
    position [12, 1.74, 3.6]
  }
  placement "kit-banner" {
    prototype: "kit-banner"
    position [36, 3.4, 4]
  }
}
