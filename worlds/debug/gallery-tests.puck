// The gallery (gallery/gallery.puck), each scenario booted in the whole debug world: `puck test
// worlds/debug/gallery-tests.puck --reproduce`. The north lift's car is an attached solid riding the body its own
// placement spawns, which a rule poses along a box topology read in the building's frame, and its doors swap their
// colliders through `respond`; these scenarios pin the ride's exact floor stop and that a collider swap, and its swap
// back, reproduce from the checkpoint. Positions are world coordinates with the building at layout.puck's
// `gallerySite`: the car's centre stands at (69.5, 39.885), she stands 0.575 m behind it toward the rail at its back,
// and its buttons along that rail, door open at x 69.975 and door close at 70.292, are pressed from 1.525 m behind it.
// They follow the car's place, `puck eval worlds/debug/debug.puck "galleryWorld(galleryLifts[0].x, 0, galleryLifts[0].z)"`
// (69.5, 0, 39.885), the car turned half round so its back lies toward -z; move them with it. The car's cells are its
// key's, 0. Enum members are written as their numbers: the rows reach this file only through the debug world's import
// of the gallery.

schema: "puck.world.definition.v1"
basis: "debug"
// Keep same-world portals in this fixture's boot instance instead of opening another live debug world.
documentId: "debug"
import "stopped-machines"

test "the north lift carries a standing Moth from level 0 to level 2" {
  when {
    seat1: body.pose 69.5 0.05 39.31 0 0 0 0
    ticks 30
    seat1: world.state.cell.set liftCall 0 2
    ticks 180
  }
  expect {
    liftAt[0] == 144
    liftLevel[0] == 2
    bodyPosition(body, 0, y) > 9
    bodyPosition(body, 0, y) < 9.15
    fact(body, 0, Grounded) == 1
    liftCarDoor[0] == 1
    liftDoorsOf0[0] == 0
    liftDoorsOf0[1] == 0
    liftDoorsOf0[2] == 1
    liftDoorsOf0[3] == 0
  }
}

test "door open after door close brings the doors back and the lamp goes out" {
  when {
    seat1: body.pose 70.292 0.05 38.36 0 0 0 0
    ticks 30
    seat1: body.press interact 1 0.2 0
    ticks 10
    seat1: body.pose 69.975 0.05 38.36 0 0 0 0
    ticks 10
    seat1: body.press interact 1 0.2 0
    ticks 30
  }
  expect {
    liftCarDoor[0] == 1
    liftDoorsOf0[0] == 1
    liftLampOpen[0] == 0
    liftLampClose[0] == 0
  }
}
