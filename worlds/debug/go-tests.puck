// The Go table's scenarios (go.puck), each booted in the whole debug world: `puck test worlds/debug/go-tests.puck`.
// Points use 19 * row + column. The centre is 180, neighbours 161, 179, 181 and 199.
// The table fills a given accepted position one point per reading.
// Every scenario but the opponent's own leaves both sides to the steps (goAiSide 0).

schema: "puck.world.definition.v1"
basis: "debug"
documentId: "go-tests"

test "the stones settle in their trays and the board reads empty" {
  given {
    goAiSide = 0
  }
  when {
    ticks 150
  }
  expect {
    goChangedCount == 0
    goCollisions == 0
    goIllegal == 0
    goCell.goStone0 == -1
    goCell.goStone360 == -361
    goHold == 9
    goNewCell == -1
    goFix == -1
  }
}

// Seat 1 stands at Black's edge, sits down with the context button and plays the centre point with the pick button
// (the cursor starts there); the computer, playing White, answers with a stone of its own.
test "a seated player plays the centre and the computer answers" {
  when {
    seat1: body.pose 56.5 9.25 29 0 0 0 0
    ticks 150
    seat1: body.press interact
    ticks 5
    seat1: body.press confirm
    ticks 1000
  }
  expect {
    goBoard[180] == 1
    goSeen[180] == 1
    goMoves == 2
    goTurn == 1
    goStoneCount[1] == 1
    goStoneCount[2] == 1
    goIllegal == 0
    board(engaged, goBoard, 1) == 1
  }
}

// The seated player steps the cursor one point up the board (+Z from Black's side) and one to the right (-X), and the
// cancel button passes; a second pass, from the console, ends the game.
test "a seated player steps the cursor, plays and passes" {
  given {
    goAiSide = 0
  }
  when {
    seat1: body.pose 56.5 9.25 29 0 0 0 0
    ticks 150
    seat1: body.press interact
    ticks 5
    seat1: body.press forward 1
    ticks 4
    seat1: body.press strafe 1
    ticks 4
    seat1: body.press confirm
    ticks 150
    seat1: body.press cancel
    ticks 10
  }
  expect {
    goBoard[198] == 1
    goSeen[198] == 1
    goTurn == 1
    goPasses == 1
    goSeat.cursor == 198
  }
}

test "a lone stone keeps four liberties" {
  given {
    goAiSide = 0
    goMove.play = 180
  }
  when {
    ticks 3
  }
  expect {
    goBoard[180] == 1
    goGroup == 1
    goLiberties == 4
    goAtari == 0
    goMoves == 1
    goTurn == 2
  }
}

// White at 180 has black on its -Z and -X sides; black's stone on its +X side leaves it one liberty, 199.
test "a stone taking the second-last liberty puts the group in atari" {
  given {
    goAiSide = 0
    goBoard[180] = 2
    goBoard[161] = 1
    goBoard[179] = 1
    goStoneCount[1] = 2
    goStoneCount[2] = 1
    goMove.play = 181
  }
  when {
    ticks 3
  }
  expect {
    goBoard[181] == 1
    goBoard[180] == 2
    goAtari == 1
    goLiberties == 3
    goCaptured == 0
  }
}

// White's two stones at 180 and 181 share their liberties; black's stone at 200 takes the last one and the whole group
// comes off.
test "a stone filling the last liberty captures a whole group" {
  given {
    goAiSide = 0
    goBoard[180] = 2
    goBoard[181] = 2
    goBoard[161] = 1
    goBoard[162] = 1
    goBoard[179] = 1
    goBoard[182] = 1
    goBoard[199] = 1
    goStoneCount[1] = 5
    goStoneCount[2] = 2
    goMove.play = 200
  }
  when {
    ticks 3
  }
  expect {
    goBoard[180] == 0
    goBoard[181] == 0
    goCaptured == 2
    goPrisoners[1] == 2
    goStoneCount[2] == 0
    goGroup == 2
    goLiberties == 6
  }
}

// Black surrounds 180 on every side; a white stone there would have no liberty and takes nothing.
test "a stone with no liberty that captures nothing is refused as suicide" {
  given {
    goAiSide = 0
    goTurn = 2
    goBoard[161] = 1
    goBoard[179] = 1
    goBoard[181] = 1
    goBoard[199] = 1
    goStoneCount[1] = 4
    goMove.play = 180
  }
  when {
    ticks 3
  }
  expect {
    goBoard[180] == 0
    goRefusal == 2
    goRejected == 1
    goMoves == 0
    goTurn == 2
    goMove.play == -1
  }
}

// The ko shape: black's stone at 181 sits in a white mouth whose one opening is 180, and black guards 180 from -Z, -X and
// +Z. White takes at 180; black taking straight back at 181 would remake the position the game opened on, which the
// history ring still holds one turn back.
test "retaking a ko at once is refused" {
  given {
    goAiSide = 0
    goTurn = 2
    goBoard[161] = 1
    goBoard[179] = 1
    goBoard[199] = 1
    goBoard[181] = 1
    goBoard[162] = 2
    goBoard[182] = 2
    goBoard[200] = 2
    goStoneCount[1] = 4
    goStoneCount[2] = 3
  }
  when {
    ticks 2
    seat1: world.state.cell.set goMove play 180
    ticks 2
    seat1: world.state.cell.set goMove play 181
    ticks 2
  }
  expect {
    goBoard[180] == 2
    goBoard[181] == 0
    goRefusal == 3
    goRejected == 1
    goMoves == 1
    goTurn == 1
  }
}

// The same ko, with one exchange elsewhere first: the position a turn back is no longer the one the retake makes, so
// the retake stands.
test "a ko may be retaken after an exchange elsewhere" {
  given {
    goAiSide = 0
    goTurn = 2
    goBoard[161] = 1
    goBoard[179] = 1
    goBoard[199] = 1
    goBoard[181] = 1
    goBoard[162] = 2
    goBoard[182] = 2
    goBoard[200] = 2
    goStoneCount[1] = 4
    goStoneCount[2] = 3
  }
  when {
    ticks 2
    seat1: world.state.cell.set goMove play 180
    ticks 2
    seat1: world.state.cell.set goMove play 0
    ticks 2
    seat1: world.state.cell.set goMove play 360
    ticks 2
    seat1: world.state.cell.set goMove play 181
    ticks 2
  }
  expect {
    goBoard[181] == 1
    goBoard[180] == 0
    goCaptured == 1
    goRejected == 0
    goMoves == 4
  }
}

// A position given on the board is set on the table from the trays; black then plays 199 with a put, capturing the white
// stone at 180, which goes back to White's tray.
test "the table fills a given position and a captured stone goes back to its tray" {
  given {
    goAiSide = 0
    goBoard[180] = 2
    goBoard[161] = 1
    goBoard[179] = 1
    goBoard[181] = 1
    goStoneCount[1] = 3
    goStoneCount[2] = 1
  }
  when {
    ticks 1000
    seat1: world.state.cell.set goPut $value 199
    ticks 400
  }
  expect {
    goBoard[199] == 1
    goBoard[180] == 0
    goSeen[180] == 0
    goSeen[161] == 1
    goSeen[199] == 1
    goCaptured == 1
    goChangedCount == 0
    goCell.goStone360 == -361
  }
}

// Black to move, a white stone (goStone181, body 289) is set by hand on point 181, 10 cm over the board: the reading
// records the arrangement illegal and puts the stone back in White's tray. Then a black stone and a second black stone
// beside it: two points changed, illegal again, and both go back.
test "an arrangement that is not one stone of the side to move is illegal and put right" {
  given {
    goAiSide = 0
  }
  when {
    ticks 150
    seat1: body.pose 56.58 10 30.6 0 0 0 289
    ticks 150
    seat1: body.pose 56.58 10 30.6 0 0 0 470
    seat1: body.pose 56.66 10 30.6 0 0 0 469
    ticks 400
  }
  expect {
    goIllegal == 2
    goMoves == 0
    goSeen[181] == 0
    goSeen[182] == 0
    goChangedCount == 0
    goCell.goStone181 == -182
    goCell.goStone0 == -1
  }
}

// The computer plays Black on an empty board: the search judges every point, grows its tree over several ticks within
// each tick's work allowance, and puts its stone down on the table as a player's is.
test "the computer plays one move" {
  given {
    goAiSide = 1
  }
  when {
    ticks 1000
  }
  expect {
    goMoves == 1
    goStoneCount[1] == 1
    goTurn == 2
    goRejected == 0
    goIllegal == 0
  }
}

// Each side walls off a three-by-three corner with seven stones; the open middle reaches both walls and counts for
// neither. Areas tie at nine, and komi gives the game to White.
test "the game ends on two passes and is scored by area" {
  given {
    goAiSide = 0
    goBoard[3] = 1
    goBoard[22] = 1
    goBoard[41] = 1
    goBoard[57] = 1
    goBoard[58] = 1
    goBoard[59] = 1
    goBoard[60] = 1
    goBoard[357] = 2
    goBoard[338] = 2
    goBoard[319] = 2
    goBoard[303] = 2
    goBoard[302] = 2
    goBoard[301] = 2
    goBoard[300] = 2
    goStoneCount[1] = 7
    goStoneCount[2] = 7
  }
  when {
    ticks 2
    seat1: world.state.cell.set goPassRequest $value 1
    ticks 2
    seat1: world.state.cell.set goPassRequest $value 2
    ticks 120
  }
  expect {
    goOver == 1
    goScoring == 2
    goTerritory[1] == 9
    goTerritory[2] == 9
    goWinner == 2
  }
}

test "a capture is legal even when the drop begins with no empty neighbour" {
  given {
    goAiSide = 0
    goBoard[180] = 2
    goBoard[161] = 1
    goBoard[179] = 1
    goBoard[181] = 1
    goBoard[198] = 2
    goBoard[200] = 2
    goBoard[218] = 2
    goStoneCount[1] = 3
    goStoneCount[2] = 4
    goMove.play = 199
  }
  when {
    ticks 3
  }
  expect {
    goBoard[180] == 0
    goBoard[199] == 1
    goCaptured == 1
    goRejected == 0
  }
}

test "the far corner belongs to the full board" {
  given {
    goAiSide = 0
    goMove.play = 360
  }
  when {
    ticks 3
  }
  expect {
    goBoard[360] == 1
    goLiberties == 2
    goMoves == 1
  }
}

test "a reset drains its deterministic return queue" {
  given {
    goAiSide = 0
  }
  when {
    ticks 150
    seat1: body.pose 56.5 10 30.6 0 0 0 470
    ticks 150
    seat1: world.state.cell.set goReset $value 1
    ticks 400
  }
  expect {
    goMoves == 0
    goTurn == 1
    goReseat == 0
    goResetAll == 0
    goChangedCount == 0
    goCell.goStone0 == -1
    goCell.goStone360 == -361
  }
}

