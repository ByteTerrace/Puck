// The lantern trail: the debug world's quest, a chain of two parts that crosses worlds (standard/quests.puck). Its steps
// are places, so playing it walks the painting wing and the garden:
//
//   lanternLit   taken up standing before the garden painting; its first step is finished in the garden, past the
//                arrival frame (garden.puck), and its second back home before the painting.
//   lanternKept  open to a character who finished lanternLit, taken up before the painting again, and finished at the
//                garden's obelisk (garden.puck).
//
// The quests live on each seat's character, so the progress made in the garden is the progress read here. The four
// local seats are the debug party: a seat writing its body index into `lanternTrailShare.from` shares the trail with the
// others, and each joins at the farthest part it qualifies for. lantern-trail-tests.puck plays the crossing.

import "../standard/quests"

// Where the trail starts and ends at home: the floor before the garden painting, which faces the wing from its south
// wall (paintings.puck); a body walking +Z from here passes through its glass into the garden.
let lanternTrailStart = { x: 57, z: 36.3, reach: 1.5 }
let lanternTrailHome = { x: 57, near: 38, far: 41, halfWidth: 2 }

function nearLanternStart() = (((bodyPosition(each, x) - lanternTrailStart.x) *
  (bodyPosition(each, x) - lanternTrailStart.x)) +
  ((bodyPosition(each, z) - lanternTrailStart.z) * (bodyPosition(each, z) - lanternTrailStart.z))) <
  (lanternTrailStart.reach * lanternTrailStart.reach)
function backFromTheGarden() = (bodyPosition(each, z) > lanternTrailHome.near) and
  (bodyPosition(each, z) < lanternTrailHome.far) and
  ((bodyPosition(each, x) - lanternTrailHome.x) < lanternTrailHome.halfWidth) and
  ((lanternTrailHome.x - bodyPosition(each, x)) < lanternTrailHome.halfWidth)

groups {
  kinds [
    {
      name: "party"
      roles [{ name: "member", capabilities [Observe] }]
      lifetime: Persistent
      evictionPolicy: Remove
      capacity: 4
    }
  ]
  groups [
    {
      id: "debugParty"
      kindName: "party"
      members: map(range(0, 4), s => { ref { kind: Local, principal: $"seat{s + 1}" }, role: "member", joinOrdinal: s })
      nextJoinOrdinal: 4
    }
  ]
  ownership []
}

questChain(
  id: "lanternTrail",
  parts: [{ quest: "lanternLit", steps: 2 }, { quest: "lanternKept", steps: 1 }],
  group: "debugParty"
)

rule "lantern-trail-take-up" {
  forEach: $players
  when nearLanternStart() and questStatus("lanternLit") == 0
  mode: Edge
  questStart(questId: "lanternLit", chain: "lanternTrail", part: 0)
}

rule "lantern-trail-home" {
  forEach: $players
  when backFromTheGarden() and questAt("lanternLit", 1)
  mode: Edge
  questAdvance(questId: "lanternLit", fromStep: 1, steps: 2)
}

rule "lantern-trail-keep" {
  forEach: $players
  when nearLanternStart() and questStatus("lanternLit") == questDone and questStatus("lanternKept") == 0
  mode: Edge
  questStart(questId: "lanternKept", chain: "lanternTrail", part: 1)
}
