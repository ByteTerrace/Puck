// Focused execution witnesses for the debug world's authored shading.
schema: "puck.world.definition.v1"
basis: "../minimal/minimal"
documentId: "shade-checks"
import "../standard/shading"

render {
  shade: plain()
  lanes ["state.shadeLane"]
}
state {
  world {
    slot shadeLane = 0
  }
}
spawnPoints [{ id: "start", position [-10, 0, -10], yawDegrees: 0 }]
prototypes {
  prototype "shade-sphere" {
    document {
      schema: "puck.creation.v1"
      palette [{ color: "#C9A27E", roughness: 0.6, wrap: 0.35, specular: 0.04 }]
      shape Sphere "sphere" {
        position [0, 1, -3]
        scale [1, 1, 1]
      }
    }
  }
}
placements {
  placement "shade-sphere" {
    prototype: "shade-sphere"
    position [0, 0, 0]
    solid
  }
}
