// The debug world set's keys for the suit switch. The player module (../standard/player/player.puck) steps a standing
// player's body to the next form its avatar owns on each `suit` press: for the Moth, her mech suit, the scout suit and
// her own body in turn (avatars/moth/contract.puck), the kit and look following the body's `suit` register on the same
// tick, so a saved world keeps them and a crossing carries them. This document binds the press: T, or South while the
// right trigger is held; `body.press suit` from the console and the play wheel's Suit sector press it too. A press in
// the air does nothing unless it is still held when she lands.
import "../standard/inputs"
import "pad-kit"

bindingOverlays [
  {
    id: "suit-keys"
    document {
      version: "puck.input.bindings.v1"
      modifiers: padModifiers
      chords [
        {
          chord []
          group: "play"
          page {
            id: "base"
            entries [
              {
                channel: "suit"
                id: "suit"
                label: "Suit"
                scale: 1
                sources ["keyboard.t"]
              }
            ]
          }
        }
        // The pad's toggle is a bar plate on the Debug page (controls.puck), the right trigger's: hold it (or X) and press
        // South (or K).
        {
          chord ["rt"]
          group: "play"
          page {
            id: "pad-rt"
            inherits: "base"
            label: "Debug"
            entries [
              {
                channel: "suit"
                id: "dbgSuit"
                label: "Suit"
                scale: 1
                sources ["gamepad.buttonSouth", "keyboard.k"]
              }
            ]
          }
        }
      ]
    }
  }
]
