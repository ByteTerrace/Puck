{
  "note": "The debug world's sweep (puck sweep): the tools it runs for a bounded span, the signals it reads, and the capture tour. Rules name a metric, an operator and a value; a red rule makes the signal red, an amber rule amber, and a rule whose metric the answer lacks leaves the signal unmeasured, which fails the run like red. compare says how a metric is judged against a previous report: exact (any change is named), relative:<fraction> (a change beyond that fraction of the old value is named) or none. The headless leg steps its World only inside waits (paused between calls), so ticks and tick-counted metrics repeat; the wall-clock metrics (host.frames, host.memory) and the compile-cache counters (world.boot.*, which depend on how warm the cache is) are not compared exactly. A signal marked recheck is read again after the tour.",
  "tools": [
    {
      "name": "fuzzer",
      "note": "300 seeded steps of body 44 in the studio bounds, under the watchdog.",
      "lines": ["world.state.cell.set fuzzer seed 12345", "world.state.cell.set fuzzer limit 300", "world.state.cell.set fuzzer enabled 1"],
      "until": { "line": "world.state fuzzer", "metric": "enabled", "in": ["0"] },
      "everyTicks": 60,
      "maxTicks": 1200
    },
    {
      "name": "traversal-studio",
      "note": "The traversal bot's studio pass (route entries 0..14): steps, ramps, stairs and the round dais.",
      "lines": ["body.stop 43", "body.pose 60 0.05 -30 0 0 0 43", "world.state.cell.set traversal start 0", "world.state.cell.set traversal count 15", "world.state.cell.set traversal run 1"],
      "until": { "line": "world.state traversal", "metric": "run", "in": ["0"] },
      "everyTicks": 150,
      "maxTicks": 9000
    },
    {
      "name": "traversal-gallery",
      "note": "The traversal bot's gallery pass (route entries 15..22): both flights of the stairwell and the lift.",
      "lines": ["body.stop 43", "body.pose 11.2 0.05 32.5 0 0 0 43", "world.state.cell.set traversal start 15", "world.state.cell.set traversal count 23", "world.state.cell.set traversal run 1"],
      "until": { "line": "world.state traversal", "metric": "run", "in": ["0"] },
      "everyTicks": 150,
      "maxTicks": 6000
    },
    {
      "name": "chess-scope",
      "note": "The chess table's idle demonstration: the first cycle records its scope tape, the second replays and compares it. It runs after the fuzzer and the traversal bot, whose lift rides recompile the solid consumers, so the sweep shows the scope's restore validating exactly its own rows and bodies.",
      "lines": [],
      "until": { "line": "replay.scope chess-demo", "metric": "status", "in": ["4", "-1"], "red": ["-1"] },
      "everyTicks": 300,
      "maxTicks": 12000
    }
  ],
  "signals": [
    { "name": "watchdog", "line": "world.state watchdog", "parse": "cells", "recheck": true, "red": ["count > 0", "checked < 1"], "compare": { "count": "exact", "checked": "exact", "observed": "exact" } },
    { "name": "watchdog-log", "line": "world.state watchdogLog", "parse": "cells", "recheck": true, "compare": { "*": "exact" } },
    { "name": "fuzzer", "line": "world.state fuzzer", "parse": "cells", "leg": "headless", "red": ["steps < 300"], "compare": { "steps": "exact", "rng": "exact", "draw": "exact" } },
    { "name": "traversal", "line": "world.state traversal", "parse": "cells", "leg": "headless", "red": ["missed > 0", "falls > 0", "reached < 23"], "compare": { "reached": "exact", "missed": "exact", "falls": "exact" } },
    { "name": "traversal-failures", "line": "world.state traversalFailures", "parse": "cells", "leg": "headless", "compare": { "*": "exact" } },
    { "name": "traversal-falls", "line": "world.state traversalFalls", "parse": "cells", "leg": "headless", "compare": { "*": "exact" } },
    { "name": "chess-scope", "line": "replay.scope chess-demo", "parse": "words", "leg": "headless", "red": ["status == -1"], "compare": { "inputs": "exact" } },
    { "name": "rule-failures", "line": "world.rule.failures", "parse": "text", "recheck": true, "amber": ["text != [world.rule.failures: none]"], "compare": { "text": "exact" } },
    { "name": "colliders", "line": "world.debug-view report colliders --json", "parse": "report", "timeoutSeconds": 120, "red": ["findings.red > 0"], "amber": ["coverage.complete == false"], "compare": { "findings.*": "exact", "comparisons.*": "exact", "coverage.tested": "exact" } },
    { "name": "contacts", "line": "world.debug-view report contacts", "parse": "text", "timeoutSeconds": 120, "metrics": { "findings.red": "^\\[contacts: red=(\\d+)", "findings.amber": "^\\[contacts: red=\\d+ amber=(\\d+)", "findings.unknown": "^\\[contacts: red=\\d+ amber=\\d+ unknown=(\\d+)", "coverage.tested": "^\\[contacts: [^\\]]* tested=(\\d+)/", "coverage.eligible": "^\\[contacts: [^\\]]* tested=\\d+/(\\d+)", "coverage": "^\\[contacts: [^\\]]* coverage=(\\w+)" }, "red": ["findings.red > 0"], "amber": ["coverage == incomplete"], "compare": { "findings.*": "exact", "coverage*": "exact" } },
    {
      "name": "budget",
      "line": "world.budget",
      "parse": "text",
      "metrics": {
        "placements": "placements (\\d+) static",
        "state.rows": "state (\\d+) row",
        "rules": "rules (\\d+),",
        "rules.worst": "worst (\\d+) evaluation",
        "rules.work": "(\\d+)/\\d+ work unit",
        "rules.workCeiling": "\\d+/(\\d+) work unit",
        "rigid": "rigid (\\d+) body",
        "rigid.sleeping": "(\\d+) sleeping\\)"
      },
      "red": ["rules.work > rules.workCeiling"],
      "compare": { "placements": "exact", "state.rows": "exact", "rules": "exact", "rules.worst": "relative:0.25", "rules.work": "relative:0.25", "rigid": "exact" }
    },
    { "name": "counters-state", "line": "world.counters state", "parse": "counters", "compare": { "*": "exact" } },
    { "name": "counters-boot", "line": "world.counters world.boot", "parse": "counters", "compare": { "*": "none" } },
    { "name": "counters-physics", "line": "world.counters physics", "parse": "counters", "compare": { "*": "exact" } },
    { "name": "addons", "line": "world.addons", "parse": "text", "recheck": true, "metrics": { "watchdog.fuel": "watchdog ENABLED fuel-budget:\\d+ fuel-last-tick:(\\d+)", "companion.fuel": "companion ENABLED fuel-budget:\\d+ fuel-last-tick:(\\d+)", "dropped": "answers-dropped-total:(?<sum>\\d+)" }, "red": ["dropped > 0", "text ~ FAULTED", "text ~ DISABLED", "watchdog.fuel < 1"], "compare": { "watchdog.fuel": "relative:0.25", "companion.fuel": "relative:0.25" } },
    { "name": "frames", "line": "host.frames 300", "parse": "frames", "leg": "headless", "compare": { "simulate.p50": "none" } },
    { "name": "memory", "line": "host.memory collect", "parse": "pairs", "compare": { "ws": "relative:0.25", "private": "relative:0.25", "heap": "relative:0.25" } },
    { "name": "bakes", "line": "world.wait bakes 600", "parse": "text", "leg": "windowed", "timeoutSeconds": 620, "red": ["text ~ not settled"], "compare": { "text": "none" } },
    { "name": "bake-counters", "line": "world.counters sdf.mesh-settle", "parse": "counters", "leg": "windowed", "red": ["sdf.mesh-settle.refused > 0"], "compare": { "*": "relative:0.25" } },
    { "name": "gi-counters", "line": "world.counters sdf.mesh-gi", "parse": "counters", "leg": "windowed", "compare": { "*": "relative:0.25" } },
    { "name": "indirect", "line": "world.indirect", "parse": "pairs", "leg": "windowed", "compare": { "*": "exact" } },
    { "name": "gpu-counters", "line": "world.counters gpu summary", "parse": "counters", "leg": "windowed", "compare": { "*": "relative:0.25" } },
    { "name": "frames-standing", "line": "host.frames reset\nworld.wait 150\nhost.frames 150", "parse": "frames", "leg": "windowed", "red": ["p99 > 16.7"], "amber": ["max > 16.7"], "compare": { "p50": "relative:0.2", "p99": "relative:0.2" } },
    { "name": "frames-walking", "line": "debug.go gallery-level-0\nbody.fly 1 0 0 0 0 0 4\nhost.frames reset\nworld.wait 120\nhost.frames 120", "parse": "frames", "leg": "windowed", "red": ["p99 > 16.7"], "amber": ["max > 16.7"], "compare": { "p50": "relative:0.2", "p99": "relative:0.2" } },
    { "name": "memory-windowed", "line": "host.memory", "parse": "pairs", "leg": "windowed", "compare": { "ws": "relative:0.25", "private": "relative:0.25" } }
  ],
  "tour": {
    "note": "Each stop starts from the reset lines, runs its own, waits for the bakes, and takes a settled capture pinned to a named tick: a start tick a fixed lead after the bakes settled, plus the stop's settle ticks. A stop's steps are console lines pinned to ticks after the start tick (world.at), so a motion still shows the same tick whatever the bakes cost. Images are compared with the baseline's by changed pixels: a pixel changes when any channel differs by more than the level tolerance, and a still whose changed fraction exceeds the amber fraction is amber.",
    "prelude": ["world.row.set hud.defaults enabled false", "world.binding-bar off 1", "world.inspect off", "console off 1", "view.annotate off", "world.state.cell.set chessDemo enabled 0", "world.wait 300"],
    "reset": ["body.stop 0", "world.debug-view off", "view.override camera auto", "view.override layout play"],
    "frame": ["player.look.recenter"],
    "settle": 45,
    "levelTolerance": 16,
    "amberFraction": 0.02,
    "columns": 4,
    "cellWidth": 480,
    "stops": [
      { "name": "finding-wall-slivers", "group": "findings", "note": "White slivers along the Moth's wall-side silhouette (walkthrough: indirect light).", "lines": ["body.pose 10.67 2.32 39.33 156 0 0"] },
      { "name": "finding-wall-slivers-indirect", "group": "findings", "note": "The same pose in the indirect view.", "lines": ["body.pose 10.67 2.32 39.33 156 0 0", "world.debug-view indirect"] },
      { "name": "finding-flight-a-level-1", "group": "findings", "note": "Dark patches where flight A meets the wall on level 1.", "lines": ["body.pose 13.73 3.47 36.89 0 0 0"] },
      { "name": "finding-flight-a-foot", "group": "findings", "note": "The foot of flight A.", "lines": ["body.pose 11.73 5.31 35.24 0 0 0"] },
      { "name": "finding-stairwell-level-3", "group": "findings", "note": "Level 3 of the stairwell renders almost black with speckled bright edges.", "lines": ["body.pose 12.2 13.55 38.7 0 0 0"] },
      { "name": "finding-plinths-level-2", "group": "findings", "note": "Hard-edged light and dark rectangles beside the level 2 plinths (x 21 to 50 at z 31).", "lines": ["body.pose 30 9.05 31 270 0 0"] },
      { "name": "finding-plinths-level-2-indirect", "group": "findings", "note": "The level 2 aisle in the indirect view.", "lines": ["body.pose 30 9.05 31 270 0 0", "world.debug-view indirect"] },
      { "name": "finding-emissive", "group": "findings", "note": "Black plinth shadows stretching from the level 3 EMISSIVE exhibit.", "lines": ["body.pose 31.74 13.57 22.28 0 0 0"] },
      { "name": "finding-flight-b-open", "group": "findings", "note": "Flight B's east side open beside the lift shaft.", "lines": ["body.pose 12.67 7.63 36.82 306 0 0"] },
      { "name": "finding-torus-lines", "group": "findings", "note": "Thin bright lines along the torus's crown and inner rim.", "lines": ["gallery.go shape-torus"] },
      { "name": "finding-sphere-step", "group": "findings", "note": "The SPHERE step on level 0.", "lines": ["gallery.go shape-sphere", "world.debug-view indirect"] },
      { "name": "finding-revolved-floor", "group": "findings", "note": "The REVOLVED floor rectangle on level 0.", "lines": ["gallery.go shape-revolve-trapezoid", "world.debug-view indirect"] },
      { "name": "finding-spin-seam", "group": "findings", "note": "The SPIN dotted ceiling seam on level 3.", "lines": ["gallery.go motion-spin"] },
      { "name": "finding-teal-roof", "group": "findings", "note": "The teal room's roof junction (gi-corner).", "lines": ["body.pose -2 0 18 0 0 0"] },
      { "name": "gallery-entrance", "group": "indoor", "lines": ["debug.go gallery"] },
      { "name": "gallery-level-0", "group": "indoor", "lines": ["debug.go gallery-level-0"] },
      { "name": "gallery-level-1", "group": "indoor", "lines": ["debug.go gallery-level-1"] },
      { "name": "gallery-level-2", "group": "indoor", "lines": ["debug.go gallery-level-2"] },
      { "name": "gallery-level-3", "group": "indoor", "lines": ["debug.go gallery-level-3"] },
      { "name": "stairwell", "group": "indoor", "lines": ["debug.go stairs"] },
      { "name": "lift", "group": "indoor", "lines": ["gallery.lift 0", "world.wait 300", "debug.go lift"] },
      { "name": "boardroom", "group": "indoor", "lines": ["debug.go boardroom"] },
      { "name": "chess", "group": "indoor", "lines": ["debug.go chess"] },
      { "name": "wonderland-painting", "group": "indoor", "lines": ["debug.go wonderland"] },
      { "name": "wonderland-room", "group": "indoor", "lines": ["debug.go wonderland-room"] },
      { "name": "devices", "group": "indoor", "lines": ["debug.go devices"] },
      { "name": "desktop", "group": "indoor", "lines": ["debug.go desktop"] },
      { "name": "painting-wing", "group": "indoor", "lines": ["debug.go portals"] },
      { "name": "portal-link", "group": "indoor", "lines": ["debug.go portal-link"] },
      { "name": "portal-fall", "group": "indoor", "lines": ["debug.go portal-fall"] },
      { "name": "garden-painting", "group": "indoor", "lines": ["debug.go portal-garden"] },
      { "name": "night-painting", "group": "indoor", "note": "The night field through its painting, seen from the gallery.", "lines": ["debug.go portal-night"] },
      { "name": "studio", "group": "outdoor", "lines": ["debug.go hero"] },
      { "name": "traversal-course", "group": "outdoor", "lines": ["body.pose 60 0.05 -28 0 0 0"] },
      { "name": "rate-range", "group": "outdoor", "lines": ["debug.go range"] },
      { "name": "camera-course", "group": "outdoor", "lines": ["debug.go camera-course"] },
      { "name": "camera-bays", "group": "outdoor", "lines": ["debug.go camera-bays"] },
      { "name": "stage", "group": "outdoor", "lines": ["debug.go stage"] },
      { "name": "jump", "group": "motion", "note": "The jump press lands 30 ticks after the start tick and the still is taken 9 ticks later, on the tick it names whatever the bakes cost.", "lines": ["debug.go stage"], "steps": [{ "at": 30, "run": "body.press jump 1 0.6" }], "settle": 39 },
      { "name": "flight", "group": "motion", "lines": ["debug.go stage"], "steps": [{ "at": 30, "run": "body.press flight 1 0.2" }, { "at": 40, "run": "body.fly 0 0 1 0 0 0 1.5" }], "settle": 90, "after": ["body.press flight 1 0.2", "world.wait 120"] },
      { "name": "noclip", "group": "motion", "lines": ["debug.go stage"], "steps": [{ "at": 30, "run": "body.press noclip 1 0.2 0" }, { "at": 40, "run": "body.press rise 1 1 0" }], "settle": 65, "after": ["body.press noclip 1 0.2 0", "world.wait 60"] },
      { "name": "garden", "group": "outdoor", "note": "Through the garden painting, last: once she stands in the garden, debug.go's places are the debug world's and the garden refuses them by name, so no later stop could pose her.", "lines": ["debug.go portal-garden", "body.fly -1 0 0 0 0 0 4", "world.wait 150", "body.stop 0"] }
    ]
  }
}
