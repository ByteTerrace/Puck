// What a body arrives as in a world the debug world's ship flies to: the kit and look selectors read `form`, the
// Moth's suit register on everything but a craft, 4 on a craft and 5 on a craft in space (../standard/ship.puck's
// `craft` and `space` registers, the space kit's camera and motion taking over where nothing pulls), so a
// ship that crosses the sky seam is a ship here and the Moth steps out of a painting in the form she left in. The
// debug world's own `form` also counts noclip (noclip.puck); a world that imports this file imports suit.puck for the
// suit register and the pilot's kit and look, and replaces its selectors with these.

import "../standard/ship"
import "suit"
import "ship-rows"

shipCraft()

state {
  body [
    {
      name: "form"
      kind: "Counter"
      initial: 1
      envelope { $type: "set", values [0, 1, 4, 5] }
    }
  ]
}

kits {
  assignment {
    select {
      bodyState: "form"
      cases [
        { value: 0, row: "pilot" }
        { value: 4, row: "ship" }
        { value: 5, row: "ship-space" }
      ]
    }
  }
}

looks {
  assignment {
    select {
      bodyState: "form"
      cases [
        { value: 0, row: "moth-pilot" }
        { value: 4, row: "ship" }
        { value: 5, row: "ship" }
      ]
    }
  }
}

// Rules run before the tick's kit selection, so a body's form moves its kit the tick it lands.
rule "craft-form" {
  when bodyState(each, form) != ((bodyState(each, craft) * (4 + bodyState(each, space))) + ((1 - bodyState(each, craft)) * bodyState(each, suit)))
  mode: Level
  forEach: $bodies
  setBodyState(key: $each, state: "form", expression: (bodyState(each, craft) * (4 + bodyState(each, space))) + ((1 - bodyState(each, craft)) * bodyState(each, suit)))
}
