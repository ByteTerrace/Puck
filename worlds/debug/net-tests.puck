// The rope net panel of the climbing lab (labs/climbing.puck, the panel the gallery stands on level 1's north edge: gallery/shell.puck),
// climbed as a player climbs it: seat 1 plays the `climb-net` route with the standard's `walker` program, which walks
// the body straight at the net, pushes into it until the climb takes it, climbs until it is a metre up, hangs, then runs
// back, which lets go. Rules in this test world latch how far the climb got and what the net did, reading the body's own
// facts and the net's readings (`net(<placement>, deflection|awake|holders|pushers)`, $net:):
//
//   reached     the climb's last stage: 1 took the net, 2 a metre up on it, 3 back on the floor after letting go
//   held        the most bodies the net carried at once while she climbed: one
//   dipped      the net's deepest deflection while she was on it, grab included, past a strand's thickness, so her
//               weight pulled it, and short of its reach, so the bound never stopped it
//   bellied     the net's deflection as she hangs a metre up, settled from the grab: past a strand and within four fifths
//               of the reach, the belly her weight makes in the taut net, about a fifth of a metre
//   bounded     never past the net's reach: the solver's bound held
//   settled     the net asleep again at the export tick: it came to rest and costs nothing
//
// Two more tests walk the body straight at the net's side half on the `net-slip` route, once at full size and once at
// Alice's size (layout.puck's `toyLatticeNet` is sized between the two):
//
//   through     the body came to stand behind the net without ever rising past head height: through the mesh, not
//               over the frame (the lab's frame stands free, so a climber can go over its head, which the gallery's
//               fascia closes)
//   grabbed     the body took a hold on the net while on that walk
//
// At Alice's size it slips through and never takes the net; at full size it is held: it never gets through the mesh,
// and takes the climb instead.
//
// The same blocks run twice with `puck test --reproduce worlds/debug/net-tests.puck` show the net's nodes are part of
// the state two runs agree on: a pushed, held and released net steps bit for bit alike.

schema: "puck.world.definition.v1"
basis: "labs/climbing"
documentId: "lab-climbing"
import "labs/climbing-plan"
import "../standard/architecture"
import "size"
import "gallery/look"

// The rope net placement (the lab's `climbNetPanel`), and the readings that judge it: a strand's thickness is the least
// dip worth calling one, and the net's reach (standard/architecture.puck's ropeNet) the most any node may stand off rest.
// A full-size climber's weight bellies the taut net about a fifth of a metre (half her weight, half that), so a belly
// within four fifths of the reach is her weight's and not the bound's.
let netPanel = climbNetPanel
let netStrand = toyLatticeNet.strand
let netReach = ropeNet.reach
let netBelly = (ropeNet.reach * 0.8)
// How far over the lab's floor the body's foot is a metre up the net, and the band over the floor it stands in again.
let netFloor = 0
let netClimb = 1
let netFloorBand = 0.3
// Behind the net: a body this far past its plane that never rose past this height went through the mesh.
let netBehind = 0.3
let netBelowHead = 2

state {
  world {
    // Which body size the walk tests: 1 shrinks the body to Alice's (look.puck's `lookWonderSize`) once it is posed.
    table netTrial {
      shrink = 0
    }
    slot netShrunk = 0
    slot netThrough = 0
    slot netWentHigh = 0
    slot netGrabbed = 0
    slot netReached = 0
    slot netHeld = 0
    // Deflections, in metres.
    row {
      name: "netDeepest"
      kind: Fixed
      value: "0"
    }
    row {
      name: "netFarthest"
      kind: Fixed
      value: "0"
    }
    row {
      name: "netHanging"
      kind: Fixed
      value: "0"
    }
  }
}

rule "net-shrink" {
  when netTrial["shrink"] == 1 and bodyState(body, 0, size) > lookWonderSize and bodyPosition(body, 0, x) > 1 and bodyPosition(body, 0, z) < climbFaceZ
  mode: Level
  setBodyState(key: 0, state: "size", expression: lookWonderSize)
  netShrunk = 1
}
rule "net-went-high" {
  when bodyPosition(body, 0, y) > netBelowHead
  mode: Level
  netWentHigh = 1
}
rule "net-through" {
  when netWentHigh == 0 and bodyPosition(body, 0, z) > (climbFaceZ + netBehind)
  mode: Level
  netThrough = 1
}
rule "net-grabbed" {
  when bodyPosition(body, 0, x) > 1 and fact(body, 0, HoldingUnwalkable) == 1
  mode: Level
  netGrabbed = 1
}
rule "net-took" {
  when netReached == 0 and fact(body, 0, HoldingUnwalkable) == 1 and net(netPanel, holders) >= 1
  mode: Level
  netReached = 1
}
rule "net-climbed" {
  when netReached == 1 and fact(body, 0, HoldingUnwalkable) == 1 and bodyPosition(body, 0, y) >= (netFloor + netClimb)
  mode: Level
  netReached = 2
  netHanging = net(netPanel, deflection)
}
rule "net-dropped" {
  when (netReached == 2 and fact(body, 0, HoldingUnwalkable) == 0 and fact(body, 0, Grounded) == 1 and
    bodyPosition(body, 0, y) <= (netFloor + netFloorBand))
  mode: Level
  netReached = 3
}
// The most holders and the deepest dip while she is on the net; the farthest deflection ever.
rule "net-held" {
  when netReached >= 1 and netReached <= 2 and net(netPanel, holders) > netHeld
  mode: Level
  netHeld = net(netPanel, holders)
}
rule "net-dipped" {
  when netReached >= 1 and netReached <= 2 and net(netPanel, deflection) > netDeepest
  mode: Level
  netDeepest = net(netPanel, deflection)
}
rule "net-farthest" {
  when net(netPanel, deflection) > netFarthest
  mode: Level
  netFarthest = net(netPanel, deflection)
}

test "the rope net, taken, climbed a metre and let go" {
  when {
    seat1: route.play climb-net
    ticks 900
  }
  expect {
    netReached == 3
    netHeld == 1
    netDeepest > netStrand
    netDeepest < netReach
    netHanging > netStrand
    netHanging < netBelly
    netFarthest <= netReach
    net(netPanel, awake) == 0
    fact(body, 0, Grounded) == 1
    netThrough == 0
  }
}

test "a full-size body walking into the net is held" {
  when {
    seat1: route.play net-slip
    ticks 600
  }
  expect {
    netThrough == 0
    netGrabbed == 1
  }
}

test "a body at Alice's size slips through the net" {
  when {
    seat1: world.state.cell.set netTrial shrink 1
    seat1: route.play net-slip
    ticks 1500
  }
  expect {
    netShrunk == 1
    netThrough == 1
    netGrabbed == 0
    fact(body, 0, Grounded) == 1
  }
}
