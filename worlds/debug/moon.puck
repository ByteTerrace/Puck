// The moon: a federated world of its own, the pale one of the valley's two. A cratered sphere `moonRadius` metres in
// radius about this world's origin, small enough to walk round and to fly round, whose pull points at its centre
// inside `moonReach` and is nothing beyond it. The debug world shows this world in its sky and reaches it two ways:
// the moon painting of its painting wing (paintings.puck) opens onto the arrival frame at the north pole here, and a
// ship climbing out of the valley is handed across the `sky` seam under the moon.
// Boot the debug world, never this one. moon.md beside this file says how to get here and what to look at.
//
// The two worlds share one frame up to a shift: a point at `p` here stands at `p + moonCentre` in the debug world
// (moon-frame.puck), so the valley lies below the moon's south side and the pole's sky looks away from it. The valley
// hangs in this sky as the debug world's far product (the sky's `debug` view): its settled ground and standing masses,
// merged once from what the debug world already baked, so seeing the planet bakes nothing and holds none of its bodies.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "moon"

// The debug world's chrome, so a traveller keeps its bar and wheel here, and the Moth's size; her suit toggle comes
// with craft-form.puck below.
import "moth-controls"
import "size"
import "painting-kit"
import "place-kit"
import "moon-frame"
import "moon-surface"
import "../standard/agreement"
import "../standard/skies"
import "../standard/visitors"
// A ship that crosses the sky seam is a ship here: the craft register and the selectors that read it.
import "craft-form"

// The moon draws no HUD panels; controls.puck supplies its cursor.
hud {
  panels []
}

metadata {
  title: "Moon"
  description: "The pale moon of the debug world's valley: a cratered sphere to walk and fly round, reached through the painting wing's moon painting or by ship through the sky seam."
}

// The debug world's sky and painting observe the moon whole as sessions; arriving visitors receive the standard visitor row.
admission [
  {
    admits: Session
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 8
        capability: Drive
        exclusive: true
      }
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
  }
  visitorAdmissionRow(domain: "*")
]

references [
  {
    document: "debug"
    name: "debug"
  }
  {
    document: "sun"
    name: "sun"
  }
]

destinations [
  {
    durability: persisted
    name: "debug"
    reference: "debug"
    scope: global
  }
  {
    durability: persisted
    name: "sun"
    reference: "sun"
    scope: global
  }
]

views {
  nestingDepth: 3
}

// The seam under the moon, the debug world's `sky` seen from above: a body that sinks through it is the debug
// world's again.
adjacencies [
  {
    name: "sky"
    destination: "debug"
    counterpart: "sky"
    presentation: Apart
    boundary {
      center [debugOrigin[0], (debugOrigin[1] + skySeamAltitude), debugOrigin[2]]
      outwardYawDegrees: 180
      outwardPitchDegrees: -90
      width: skySeamSpan
      height: skySeamSpan
    }
  }
]

// How long this world grants a pairing with one of the valley's moon doors before its socket closes on its own.
let socketLease = 60s
// The sockets the valley's doors pair with (moon-door.puck's `moonDoors`), each on the pad's rim facing across it, and
// each door's way home: the moon painting's on the east rim, the launch field frame's on the west.
let moonSockets = [
  { agreement: "moonDoor", placement: "moon-socket", door: "painting-moon", x: (padRadius - 2), yaw: 90 }
  { agreement: "valleyDoor", placement: "valley-socket", door: "moon-door-valley", x: (2 - padRadius), yaw: -90 }
]

// The beacon's mast height over the pad and its lamp's luminous power while lit.
let beaconHeight = 4
let beaconLumens = 40000

// The moon holds more than a traveller's own body: a ship and its pilot arrive as two.
bodies {
  capacity: 16
  localSeats: 4
  networkPlayers: 8
  reconnectGraceSeconds: 3
}

// The pull: toward the centre at `moonGravity` everywhere inside `moonReach`. The planet and the sun are too far to
// pull a body here against the moon, and their whole pull moves the moon and everything on it alike, so what this
// world feels of them is their tide: the difference of each pull across the moon, a stretch along the line to the
// source and a squeeze across it, which grows with distance from the moon's centre. Outside the reach it is all that
// is left, far too faint to turn a body: under a metre a second squared a field moves no body's up, so a body out in
// the open keeps the up it came with until the moon takes it, and keeps the moon's on the way out. The sun's share
// is scaled by the sun's mass as it has reached the moon (`sunMass`, a followed row), so a sun that goes out stops
// pulling here when its last pull has arrived.
gravity {
  attractors []
  gravitationalConstant: 0
  isActive: true
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, 0, 0]
  areas [
    {
      placementId: `moon-core`
      priority: 0
      mode: Replace
      bounds: sphere(radius: moonReach)
      acceleration: radial(magnitude: moonGravity)
    }
  ]
  tideOrigin: `moon-core`
  tides [
    { placementId: `planet-core`, surfaceGravity: planetGravity, referenceRadius: planetRadius }
    { placementId: `sun-core`, surfaceGravity: sunGravity, referenceRadius: sunRadius, scale: sunMass }
  ]
}

// Every surface of the moon is ground a hold can take, so a ship's touchdown hold settles it anywhere it is brought
// down (the basis leaves that to the placements it marks).
collision {
  contactSkin: 0.02
  defaultHold: true
  gradientProbe: 0
  gridCellSize: 0
  maxIterations: 4
  maxSlopeDegrees: 60
  requirements []
}

spawnPoints [
  { id: "stage", position [0, (moonRadius + padTop), -5], yawDegrees: 0 }
  { id: "moon-arrival", position [0, (moonRadius + padTop), -5], yawDegrees: 0 }
]

placements {
  policy {
    authoringHeadroomInstances: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  // What the pull rides: the moon's centre.
  placement "moon-core" {
    prototype: "place"
    position [0, 0, 0]
  }

  // Where the planet's centre and the sun stand in this world's coordinates: the sources of the tide.
  placement "planet-core" {
    prototype: "place"
    position [
      (debugOrigin[0] + planetCentre[0]),
      (debugOrigin[1] + planetCentre[1]),
      (debugOrigin[2] + planetCentre[2])
    ]
  }
  placement "sun-core" {
    prototype: "place"
    position [(debugOrigin[0] + sunCentre[0]), (debugOrigin[1] + sunCentre[1]), (debugOrigin[2] + sunCentre[2])]
  }

  placement "place-moon-pole" {
    prototype: "place"
    position [0, (moonRadius + 3), 0]
    region {
      halfExtents [14, 6, 14]
    }
  }

  for sector in moonSectors {
    placement $"moon-{sector.name}" {
      prototype: $"moon-{sector.name}"
      position [0, 0, 0]
      yawDegrees: 180
      solid
    }
  }

  // The pad at the north pole, level with the frame's foot.
  placement "moon-pad" {
    prototype: "moon-pad"
    position [0, moonRadius, 0]
    solid
  }

  // The sockets the valley's moon doors pair with (moon-door.puck), each on the pad's rim facing across the pad: a door
  // this world owns, open only while it grants its valley door's offer, its stone leaf standing aside while it does. Its
  // glass shows the valley door it pairs with and leads back before it.
  for socket in moonSockets {
    placement $"{socket.placement}" {
      prototype: "moon-socket"
      position [socket.x, (moonRadius + padTop), 0]
      yawDegrees: socket.yaw
      faceSources [
        {
          face: "glass"
          filter: linear
          portal {
            arrival: "mapped"
            counterpart: $"{socket.door}/glass"
            destination: "debug"
            travel: "body"
            open: state(state: $"{socket.agreement}Grant", comparison: Equal, value: 1)
          }
          source {
            $type: "session"
            destination: "debug"
            fallback: "#D8D2C6"
            projection: window
          }
        }
      ]
    }

    placement $"{socket.placement}-leaf" {
      prototype: "moon-socket-leaf-shut"
      position [socket.x, (moonRadius + padTop), 0]
      yawDegrees: socket.yaw
      respond [
        {
          when: state(state: $"{socket.agreement}Grant", comparison: Equal, value: 1)
          prototypeId: "moon-socket-leaf-open"
        }
      ]
    }
  }

  // The beacon on the pad's far rim, behind the arrival frame: a mast whose lamp burns while the valley's switch is on.
  placement "moon-beacon" {
    prototype: "moon-beacon-dark"
    position [0, (moonRadius + padTop), (0 - padRadius)]
    solid
    respond [
      {
        when: state(state: moonBeacon, comparison: Equal, value: 1)
        prototypeId: "moon-beacon-lit"
      }
    ]
  }

  // The moon painting's counterpart, facing -Z like it, so a crossing turns the traveller about. Its glass is the way
  // back: walking +Z into it arrives out of the painting walking -Z, into the wing.
  placement "arrival" {
    prototype: "frame"
    position [0, (moonRadius + padTop), 0]
    yawDegrees: 0
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "painting-moon/glass"
          destination: "debug"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "debug"
          fallback: "#D8D2C6"
          projection: window
        }
      }
    ]
  }
}

prototypes {
  // The basis's floor, which this world has no use for: a speck at the centre, under 600 m of rock.
  prototype "floor" {
    document {
      name: "floor"
      palette [{ color: "#000000" }]
      schema: "puck.creation.v1"
      shape Box "ground" {
        material: 0
        position [0, 0, 0]
        scale [1, 1, 1]
      }
    }
  }

  for sector in moonSectors {
    prototype $"moon-{sector.name}" {
      document {
        moonSector(sector: sector)
      }
    }
  }

  prototype "moon-pad" {
    document {
      moonPad()
    }
  }

  for lamp in [{ name: "dark", glow: 0 }, { name: "lit", glow: 2500 }] {
    prototype $"moon-beacon-{lamp.name}" {
      document {
        name: $"moon-beacon-{lamp.name}"
        schema: "puck.creation.v1"
        palette [
          { color: "#5A5E66", roughness: 0.5, specular: 0.3 }
          { color: "#FFB347", roughness: 0.3, emissive: lamp.glow }
        ]
        shape Cylinder "mast" {
          material: 0
          position [0, (beaconHeight / 2), 0]
          scale [0.12, (beaconHeight / 2), 0.12]
        }
        shape Sphere "lamp" {
          material: 1
          position [0, beaconHeight, 0]
          scale [0.45, 0.45, 0.45]
        }
      }
    }
  }

  // The socket: a bronze frame, and its stone leaf, which fills the frame while this world has not granted the pairing
  // and stands open beside it while it has.
  prototype "moon-socket" {
    document {
      arrivalFrame(color: "#8C6A3F", roughness: 0.4, specular: 0.4, post: 0.12)
    }
  }
  for leaf in [
    { name: "shut", x: 0, z: -0.08, sx: 1.1, sz: 0.03 }
    { name: "open", x: 1.28, z: -0.62, sx: 0.03, sz: 0.55 }
  ] {
    prototype $"moon-socket-leaf-{leaf.name}" {
      document {
        name: $"moon-socket-leaf-{leaf.name}"
        palette [{ color: "#9A958C", roughness: 0.85, specular: 0.05 }]
        schema: "puck.creation.v1"
        shape Box "leaf" {
          material: 0
          position [leaf.x, 1.3, leaf.z]
          scale [leaf.sx, 1.4, leaf.sz]
        }
      }
    }
  }

  // The way back: the shared arrival frame (painting-kit.puck) in pale stone.
  prototype "frame" {
    document {
      arrivalFrame(color: "#E9E4D8", roughness: 0.6, specular: 0.1, post: 0.12)
    }
  }
}

// The day the two worlds share (moon-frame.puck): the debug world's own `day`, which this row follows. The debug
// world owns the hour; this authority adopts it from that world's delivery whenever the two read apart, so writing
// `day` there moves the moon's sun too, and writing it here is refused. Between adoptions the row advances at the
// shared rate, as the debug world's does, so the two read alike every tick.
timeline {
  clocks [
    { name: day, state: day, spanSeconds: 24h }
    // The sun's light as received, on a dial whose half turn spans dark to full (a clock wraps at its whole span), which
    // the key light's strength keys on.
    { name: sun, state: sunDial, spanSeconds: 1s }
  ]
}

state {
  world [
    {
      name: "day"
      kind: "Fixed"
      value: $"{sharedDayStart / 24}"
      advance { perSecondNumerator: 1, perSecondDenominator: sharedDaySeconds }
      follows { destination: "debug" }
    }
    // The sun's light and mass as they reach the moon (sun.puck): each read `sunDelayMoon` seconds after the sun wrote
    // it. The key light below burns at the light received, and the sun's tide is scaled by the mass received.
    { name: "sunLight", kind: "Fixed", value: "1", follows { destination: "sun", delaySeconds: sunDelayMoon } }
    { name: "sunMass", kind: "Fixed", value: "1", follows { destination: "sun", delaySeconds: sunDelayMoon } }
    // The dial the key light reads: half the light received, which the rule below keeps.
    { name: "sunDial", kind: "Fixed", value: "0.5" }
    // The beacon switch beside the moon painting in the debug world (moon-beacon.puck): the debug world owns it, this
    // row follows it, and the rules below decide what it does here.
    { name: "moonBeacon", kind: "Int", value: 0, min: 0, max: 1, follows { destination: "debug" } }
    // The beacon's light, in lumens, which this world's own rules write from the switch's state.
    { name: "beaconPower", kind: "Fixed", value: "0" }
  ]
}

// The valley's moon doors (moon-door.puck): this world's half of each door's agreement (../standard/agreement.puck).
// Each socket answers its door's offer by this world's rules: granted unless this world refuses (`<door>Refuses`), for
// a lease it counts itself, so a socket whose door went quiet frees itself.
for socket in moonSockets {
  agreementGrants(name: socket.agreement, partner: "debug", lease: socketLease)
}

// What the valley's switch does on the moon is this world's to decide: the pad's beacon burns while it is on.
rule "beacon-lit" {
  when moonBeacon == 1
  mode: Edge
  beaconPower = beaconLumens
}
rule "beacon-dark" {
  when moonBeacon == 0
  mode: Edge
  beaconPower = 0
}

// The moon lights itself from the sun's light as it has arrived here, never from the sun's world directly.
rule "sun-dial" {
  when sunDial != (sunLight / 2)
  mode: Level
  sunDial = sunLight / 2
}

// Vacuum: a hard sun over a black sky of stars, and no air between the eye and the far crater walls. The sun is the
// valley's, turning with the shared day at full strength all the way round, since no horizon of the valley's hides it
// here: the ground under it has a day and a night, and the side the valley sees shows a phase.
render {
  farDistance: 6500
  lighting {
    lights [
      directional(
        name: "key",
        direction: sunDirection(sharedDayStart, sharedSunHeading, sharedNoonElevation),
        color: "#FFF4E2",
        // Full strength while the sun's light arrives, and dark when the last of it has: the moon lights itself from
        // the light it has received, never from the sun's world directly.
        illuminance: {
          clock: sun
          keys [
            { at: 0, value: 0 }
            { at: 0.5, value: 100000 }
          ]
        },
        shadow: always,
        angularRadius: 0.0046
      )
      point(
        name: "beacon",
        position: [0, (moonRadius + padTop + beaconHeight), (0 - padRadius)],
        temperature: 2200K,
        power: "state.beaconPower"
      )
    ]
    clock: day
    keys: map(range(0, 24), h => {
      at: h * 3600
      lights {
        key: directional(direction: sunDirection(h, sharedSunHeading, sharedNoonElevation))
      }
    })
  }
  sky {
    layers [
      gradient(name: "void", luminance: spaceLuminance, stops: [
        { elevation: -1, color: spaceColor }
        { elevation: 1, color: spaceColor }
      ])
      stars(
        name: "stars",
        luminance: spaceStarLuminance,
        density: spaceStarDensity,
        brightness: spaceStarBrightness,
        seed: spaceStarSeed
      )
      sunDisc(name: "sun", light: 0, radius: 0.53deg, intensity: 12, color: "#FFF1D6")
      // The planet below: the debug world, seen from where the viewer stands in the frame the two worlds share, so the
      // valley a ship climbed out of lies under the seam it crossed and shrinks as the ship nears the moon. It draws the
      // debug world's far product (its render.farProduct), never a residency of that world: the seam is the hand-over,
      // below it the debug world draws itself. Only geometry is drawn, inside the bound round the caldera, so the void
      // and the stars show round it. It mirrors the moon the valley's sky holds (day.puck).
      {
        $type: "view"
        name: "debug"
        destination: "debug"
        anchor: moonCentre
        follow: true
        coverage: true
        farProduct: true
        bound { center [0, 150, 0], radius: 1500 }
        farDistance: 7000
        scale: 1
        refresh: 1
        shadows: false
        fallback: "#00000000"
      }
    ]
  }
  atmosphere {
    fog {
      density: 0
    }
  }
  // A camera in vacuum meters its sunlit ground, not the black sky round it: the darkest seven tenths of the image
  // stay out of the meter, and the exposure keeps to daylight's range, so the lit ground holds its tone against the
  // void and the night side goes dark under the stars. The meter otherwise reads as the valley's does at the seam
  // (hall.puck's exposure at the top of its `altitude` keys), so a camera crossing it keeps its exposure.
  exposure {
    mode: Auto
    minimum: 11
    maximum: 16
    adaptation: 0.75
    local: 0.5
    band: 0.75
    low: 0.7
    high: 0.9
    center: 0.25
  }
}
