// The Klondike scenarios (../games/klondike.puck, ../games/patience-station.puck) on a game station of its own
// (game-stations.puck's gameStationRoom), showing Klondike: `puck test worlds/debug/klondike-tests.puck --reproduce`.
// The station deals by itself, from its own seeded stream, once Klondike is shown. Piles are 0 the stock, 1 the waste,
// 2 to 8 the tableau and 10 to 13 the foundations. What any one card's place is depends on the seeded deal, so these
// claims read only what every deal shares.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "klondike-tests"

import "game-stations"

gameStationRoom(stations: [rootStation])

state {
  // The chess game's vocabularies (game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}

use gameStationGames as station(station: rootStation, index: 0)

// The deal: a card a tick gathers, shuffles, then deals the 28 cards of the tableau; the stock keeps 24.
test "the seeded deal fills the tableau and leaves 24 in the stock" {
  given {
    gameStationGame.station = 1
  }
  when {
    ticks 400
  }
  expect {
    station.solitaireKlondike.deals == 1
    station.solitaireKlondike.status == 1
    count(station.solitaireKlondikePile0) == 24
    count(station.solitaireKlondikePile1) == 0
    count(station.solitaireKlondikePile2) == 1
    count(station.solitaireKlondikePile5) == 4
    count(station.solitaireKlondikePile8) == 7
  }
}

// A draw turns the stock's top card over onto the waste.
test "the stock draws a card to the waste" {
  given {
    gameStationGame.station = 1
  }
  when {
    ticks 400
    seat1: world.state.cell.set station$solitaireKlondike action 3
    seat1: world.state.cell.set station$solitaireKlondike request 1 add
    ticks 20
  }
  expect {
    station.solitaireKlondike.result == 1
    count(station.solitaireKlondikePile0) == 23
    count(station.solitaireKlondikePile1) == 1
  }
}

// The waste is empty after the deal, so a move out of it is refused and the tableau stands as dealt.
test "a move out of the empty waste is refused" {
  given {
    gameStationGame.station = 1
  }
  when {
    ticks 400
    seat1: world.state.cell.set station$solitaireKlondike from 1
    seat1: world.state.cell.set station$solitaireKlondike to 2
    seat1: world.state.cell.set station$solitaireKlondike card 0
    seat1: world.state.cell.set station$solitaireKlondike action 2
    seat1: world.state.cell.set station$solitaireKlondike request 1 add
    ticks 20
  }
  expect {
    station.solitaireKlondike.result == -1
    station.solitaireKlondike.moves == 0
    count(station.solitaireKlondikePile2) == 1
  }
}
