// The Klondike scenarios (../games/klondike.puck, ../games/patience-station.puck) on a game station of its own
// (game-stations.puck's gameStationRoom), showing Klondike: `puck test worlds/debug/klondike-tests.puck --reproduce`.
// The station deals by itself, from its own seeded stream, once Klondike is shown. Piles are 0 the stock, 1 the waste,
// 2 to 8 the tableau's face-up parts (each column's face-down part its own pile) and 10 to 13 the foundations; the
// station is table 0, so its cells are `klondike<Field>[0]` and its piles the families' members `klondike<Pile>Of0`.
// What any one card's place is depends on the seeded deal, so these claims read only what every deal shares.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "klondike-tests"

import "game-stations"

gameStationRoom(stations: [rootStation])

state {
  // The chess game's vocabularies (game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}

use gameStationGames as station(station: rootStation, index: 0)

// The deal: a card a tick gathers, shuffles, then deals the 28 cards of the tableau; the stock keeps 24.
test "the seeded deal fills the tableau and leaves 24 in the stock" {
  given {
    gameStationGame.station = 1
  }
  when {
    ticks 400
  }
  expect {
    klondikeDeals[0] == 1
    klondikeStatus[0] == 1
    count(klondikeStockOf0) == 24
    count(klondikeWasteOf0) == 0
    count(klondikePile2Of0) == 1
    count(klondikeDown2Of0) == 0
    count(klondikePile5Of0) == 1
    count(klondikeDown5Of0) == 3
    count(klondikePile8Of0) == 1
    count(klondikeDown8Of0) == 6
    // Face down are the stock's 24 and the columns' 21 behind their face-up cards; the seven face-up cards are not.
    sum(klondikeFaceDownOf0) == 45
    // The glass read the piles: column 1's one card lies at the column's first slot (76), and column 4's face-up card
    // over its three face-down ones (133 to 136).
    patienceSlotOf0[patienceCardAtOf0[76]] == 76
    patienceSlotOf0[patienceCardAtOf0[135]] == 135
    patienceSlotOf0[patienceCardAtOf0[136]] == 136
  }
}

// A draw turns the stock's top card over onto the waste.
test "the stock draws a card to the waste" {
  given {
    gameStationGame.station = 1
  }
  when {
    ticks 400
    seat1: world.state.cell.set klondikeAction 0 3
    seat1: world.state.cell.set klondikeRequest 0 1 add
    ticks 20
  }
  expect {
    klondikeResult[0] == 1
    count(klondikeStockOf0) == 23
    count(klondikeWasteOf0) == 1
    sum(klondikeFaceDownOf0) == 44
  }
}

// The waste is empty after the deal, so a move out of it is refused and the tableau stands as dealt.
test "a move out of the empty waste is refused" {
  given {
    gameStationGame.station = 1
  }
  when {
    ticks 400
    seat1: world.state.cell.set klondikeFrom 0 1
    seat1: world.state.cell.set klondikeTo 0 2
    seat1: world.state.cell.set klondikeCard 0 0
    seat1: world.state.cell.set klondikeAction 0 2
    seat1: world.state.cell.set klondikeRequest 0 1 add
    ticks 20
  }
  expect {
    klondikeResult[0] == -1
    klondikeMoves[0] == 0
    count(klondikePile2Of0) == 1
  }
}
