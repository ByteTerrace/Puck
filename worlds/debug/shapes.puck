      }
      exhibit(label: "PRISM CHAMFER")
    }
  }
  prototype "shape-cylinder-chamfer" {
    document {
      shape Cylinder "subject" {
        chamfer: 0.08
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0.4]
      }
      exhibit(label: "CYLINDER CHAMFER")
    }
  }
  prototype "shape-revolve-solid" {
    document {
      shape Prism "subject" {
        lift: "Revolve"
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.4, 0.4, 0]
        taper: 0.3
      }
      exhibit(label: "REV SOLID")
    }
  }
  // An even-odd fill: a square whose right side is a cubic Bezier, holed by a circle of two arcs.
  prototype "shape-path-holes" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            contours [
              {
                start [-0.8, -0.8]
                segments [
                  {
                    end [0.8, -0.8]
                  }
                  {
                    end [0.8, 0.8]
                    control [0.95, -0.3]
                    control2 [0.6, 0.3]
                  }
                  {
                    end [-0.8, 0.8]
                  }
                  {
                    end [-0.8, -0.8]
                  }
                ]
              }
              {
                start [0.35, 0]
                segments [
                  {
                    end [-0.35, 0]
                    arcCenter [0, 0]
                  }
                  {
                    end [0.35, 0]
                    arcCenter [0, 0]
                  }
                ]
              }
            ]
          }
        }
        scale [0.5, 0.5, 0.1]
      }
      exhibit(label: "PATH HOLES")
    }
  }
  prototype "shape-path-shear" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            shear {
              linear: 0.2
              quadratic: 0.4
              target: 0
            }
            contours [
              {
                start [-0.5, -0.7]
                segments [
                  {
                    end [0.5, -0.7]
                  }
                  {
                    end [0.5, 0.7]
                  }
                  {
                    end [-0.5, 0.7]
                  }
                  {
                    end [-0.5, -0.7]
                  }
                ]
              }
            ]
          }
        }
        scale [0.5, 0.5, 0.1]
      }
      exhibit(label: "PATH SHEAR")
    }
  }
  prototype "shape-path-closed-stroke" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            stroke {
              radiusStart: 0.06
              radiusEnd: 0.06
            }
            contours [
              {
                start [-0.6, 0]
                closed: true
                segments [
                  {
                    end [0.6, 0]
                    control [-0.6, 0.85]
                    control2 [0.6, 0.85]
                  }
                  {
                    end [-0.6, 0]
                    control [0.6, -0.85]
                    control2 [-0.6, -0.85]
                  }
                ]
              }
            ]
          }
        }
        scale [0.6, 0.6, 0.08]
      }
      exhibit(label: "PATH CLOSED")
    }
  }
  // A linear radius ramp over the middle half of the stroke, along a clockwise arc and a line.
  prototype "shape-path-stroke-ramp" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            stroke {
              radiusStart: 0.1
              radiusEnd: 0.02
              smooth: false
              from: 0.25
              to: 0.75
            }
            contours [
              {
                start [-0.6, -0.3]
                segments [
                  {
                    end [0.6, -0.3]
                    arcCenter [0, -0.3]
                    clockwise: true
                  }
                  {
                    end [0.6, 0.6]
                  }
                ]
              }
            ]
          }
        }
        scale [0.6, 0.6, 0.08]
      }
      exhibit(label: "PATH RAMP")
    }
  }
  prototype "shape-sweep-braid" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.7, 0]
        rotation: rotate([0, 1, 0], 180)
        curve {
          a [0, 0, 0]
          b [0.2, 0.5, 0]
          c [0, 1.0, 0]
          radiusStart: 0.04
          radiusEnd: 0.04
          strands: 4
          strandOffset: 0.08
          twist: 2
        }
      }
      exhibit(label: "SWEEP BRAID")
    }
  }
}

// Surfaces: palette channels, weathering, panels, trims, a world-space paint, text runs, volumes and a state-bound
// colour, each on slot 3. The static paints stand in the world: a static placement shares one palette and draws an
// unparented paint in world space, so the stripe names the place its exhibit stands at, the middle of its home display's
// turntable exhibit, among `displays`.
template surfacePrototypes(displays = galleryDisplays) {
  let paintCentre = exhibitWorld(stationOf(displays, "shape-paint-world"), [0, 1.2, 0])
  let tilesZ = stationOf(displays, "shape-paint-tiles").site[2] + stationOf(displays, "shape-paint-tiles").z
  prototype "shape-metal" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "METAL", extra: [{ color: "#D4AF37", metal: 1, roughness: 0.25, specular: 0.5 }])
    }
  }
  prototype "shape-coat" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "COAT", extra: [{ color: "#B3261E", specular: 0.35, roughness: 0.4, coat: 0.5 }])
    }
  }
  prototype "shape-sheen" {
    document {
      shape Box "subject" {
        chamfer: 0.08
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.38, 0.38, 0.38]
      }
      exhibit(label: "SHEEN", extra: [{ color: "#4A6FA5", roughness: 0.7, sheen: 1 }])
    }
  }
  prototype "shape-emissive" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "EMISSIVE", extra: [{ color: "#FFB347", emissive: 300 }])
    }
  }
  prototype "shape-wrap-soften" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.18
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "WRAP SOFTEN", extra: [{ color: "#C9A27E", roughness: 0.6, wrap: 0.6, soften: 1 }])
    }
  }
  prototype "shape-fill-bleed" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "FILL BLEED",
        extra: [{ color: "#DDDDDD", roughness: 0.8, fill: "#2F5BFF", bleed: "#FF5A1F", receive: 1.5 }]
      )
    }
  }
  // Two spheres of one paint, the left banded by its palette row's own cel style and the right continuous, under a
  // world whose default style is off: the left shows the band, its soft shadow edge, its rim and its ink, the right and
  // the plinth stay continuous.
  prototype "shape-cel" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0.3, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "continuous" {
        material: 4
        position [-0.3, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      exhibit(
        label: "CEL STYLE",
        extra: [
          celMaterial({ color: "#C9A27E", roughness: 0.6, specular: 0.04, wrap: 0.35 }, celStyle)
          { color: "#C9A27E", roughness: 0.6, specular: 0.04, wrap: 0.35 }
        ]
      )
    }
  }
  prototype "shape-cel-hard" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0.3, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "continuous" {
        material: 4
        position [-0.3, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      exhibit(
        label: "CEL HARD",
        extra: [
          celMaterial({ color: "#C9A27E", roughness: 0.6, specular: 0.04, wrap: 0.35 }, celHardStyle)
          { color: "#C9A27E", roughness: 0.6, specular: 0.04, wrap: 0.35 }
        ]
      )
    }
  }
  // The grey card the display transform is read against: a matte wedge of reflectances (3, 9, 18, 36, 59 and 90%) over
  // the three primaries, on the near-black board's +Z face: the console's side, which faces the spawn point. Each
  // patch's hex is the sRGB code of its reflectance, so at an exposure that maps a white surface's light to display
  // white, each patch reads back as its own code; the 18% patch reads 118 (the presented burst's `level` over a region
  // of it). The primaries catch a display transform that converts its primaries wrongly, which a grey alone passes.
  prototype "shape-grey-card" {
    document {
      shape Box "board" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.26, 0.01]
      }
      shape Box "grey-03" {
        material: 4
        position [0.375, 1.32, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "grey-09" {
        material: 5
        position [0.225, 1.32, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "grey-18" {
        material: 6
        position [0.075, 1.32, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "grey-36" {
        material: 7
        position [-0.075, 1.32, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "grey-59" {
        material: 8
        position [-0.225, 1.32, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "grey-90" {
        material: 9
        position [-0.375, 1.32, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "red" {
        material: 10
        position [0.15, 1.08, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "green" {
        material: 11
        position [0, 1.08, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      shape Box "blue" {
        material: 12
        position [-0.15, 1.08, -0.015]
        scale [0.065, 0.065, 0.01]
      }
      exhibit(
        label: "GREY CARD",
        extra: [
          { color: "#1C1C1C", roughness: 1, specular: 0 }
          { color: "#303030", roughness: 1, specular: 0 }
          { color: "#555555", roughness: 1, specular: 0 }
          { color: "#767676", roughness: 1, specular: 0 }
          { color: "#A2A2A2", roughness: 1, specular: 0 }
          { color: "#CACACA", roughness: 1, specular: 0 }
          { color: "#F3F3F3", roughness: 1, specular: 0 }
          { color: "#FF0000", roughness: 1, specular: 0 }
          { color: "#00FF00", roughness: 1, specular: 0 }
          { color: "#0000FF", roughness: 1, specular: 0 }
        ]
      )
    }
  }
  // A repeated paint: one box paint a joint smaller than its cell, repeated on a world-space lattice over the slot's
  // joint colour, each tile's tone varied between two terracottas by a hash of the tile.
  prototype "shape-paint-tiles" {
    document {
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.45, 0.45, 0.04]
      }
      exhibit(
        label: "PAINT TILES",
        extra: [
          {
            color: "#8A3F2C"
            roughness: 0.85
            paints [
              // World space on a static placement: the lattice repeats along x and y, and the box's depth stands
              // about the exhibit's z in the world, where the panel is.
              {
                type: "Box"
                position [0, 0, tilesZ]
                scale [0.145, 0.145, 1]
                color: "#B4553A"
                repeat { cell [0.3, 0.3, 0], tone: "#C86E48", seed: 7 }
              }
            ]
          }
        ]
      )
    }
  }
  prototype "shape-weathering-edge" {
    document {
      shape Cylinder "subject" {
        rounding: 0.1
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.38, 0.38, 0.38]
      }
      exhibit(
        label: "WEAR EDGE",
        extra: [
          {
            color: "#2E6B3A"
            roughness: 0.5
            weathering {
              edge: 1
              reach: 0.08
              floor: 1
              seed: 5
              under [
                { threshold: 0.25, surface { color: "#B5895B", roughness: 0.8, metal: 0 } }
                { threshold: 0.6, surface { color: "#9AA0A6", roughness: 0.3, metal: 1 } }
              ]
            }
          }
        ]
      )
    }
  }
  prototype "shape-weathering-lines" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "WEAR LINES",
        extra: [
          {
            color: "#7A2E2E"
            roughness: 0.5
            weathering {
              lines: 0.6
              floor: 1
              scale: 4
              seed: 9
              under [{ threshold: 0.2, surface { color: "#C0C4C8", roughness: 0.3, metal: 1 } }]
            }
          }
        ]
      )
    }
  }
  prototype "shape-weathering-settle" {
    document {
      shape Torus "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "WEAR SETTLE",
        extra: [
          {
            color: "#3B4A5A"
            roughness: 0.5
            weathering { settle: 1, floor: 1, deposit { color: "#F4F1EA", roughness: 0.95, metal: 0 } }
          }
        ]
      )
    }
  }
  prototype "shape-panel-recess" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        panel {
          inset: 0.06
          depth: 0.03
          material: accentMaterial
        }
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.4, 0.35, 0.12]
      }
      exhibit(label: "PANEL RECESS", extra: [accent])
    }
  }
  prototype "shape-panel-raise" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        panel {
          inset: 0.06
          depth: -0.03
          material: accentMaterial
        }
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.4, 0.35, 0.12]
      }
      exhibit(label: "PANEL RAISE", extra: [accent])
    }
  }
  // The trim band follows the thin slab hidden inside the box, round its equator.
  prototype "shape-trims" {
    document {
      shape Box "band" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.34, 0.004, 0.34]
      }
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.35, 0.35, 0.35]
        trims [
          {
            shape: "band"
            width: 0.03
            material: accentMaterial
          }
        ]
      }
      exhibit(label: "TRIMS", extra: [accent])
    }
  }
  prototype "shape-paint-world" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "PAINT WORLD",
        extra: [
          {
            color: "#B9C4D0"
            roughness: 0.45
            specular: 0.3
            paints [
              {
                type: "Plane"
                position: paintCentre
                rotation [0, 0, 0.258819, 0.965926]
                stroke: 0.035
                color: "#1F4E79"
              }
            ]
            shade: paint("#1F4E79")
          }
        ]
      )
    }
  }
  prototype "shape-text-engrave" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.25, 0.08]
      }
      exhibit(
        label: "TEXT ENGRAVE",
        extra: [accent],
        runs: [
          {
            text: "ENGRAVED"
            position [0, 1.2, -0.08]
            rotation [0, 1, 0, 0]
            emHeight: 0.13
            depth: 0.012
            mode: "engrave"
            material: accentMaterial
            align: "center"
          }
        ]
      )
    }
  }
  prototype "shape-text-ride" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [0.173648, 0.984808, 0, 0]
        scale [0.45, 0.3, 0.05]
      }
      exhibit(
        label: "TEXT ON SHAPE",
        extra: [accent],
        runs: [
          {
            text: "TEXT RIDES A SHAPE"
            shapeId: 0
            position [0, 0, 1]
            rotation [0, 0, 0, 1]
            emHeight: 0.08
            depth: 0.004
            maxWidth: 0.7
            tracking: 0.05
            lineSpacing: 1.2
            material: accentMaterial
            align: "center"
          }
        ]
      )
    }
  }
  // A flow runs from its box's +Y face toward -Y; the half-turn about X puts the mouth on the nozzle and the plume above.
  prototype "shape-volume-flow" {
    document {
      shape Cylinder "nozzle" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        scale [0.07, 0.15, 0.07]
      }
      volumes [
        {
          kind: "flow"
          position [0, 1.35, 0]
          rotation [0, 0, -1, 0]
          halfExtent [0.2, 0.4, 0.2]
          axis: 0.8
          width: 0.06
          spread: 3
          fade: 1.2
          noiseScale: 0.06
          noiseDepth: 0.5
          speed: 1.2
          seed: 7
          steps: 40
          intensity: 3000
          pulseAmplitude: 0.2
          pulseFrequency: 3
          ramp [
            {
              density: 0
              color: "#7A1F0B"
            }
            {
              density: 0.4
              color: "#E2571E"
            }
            {
              density: 1
              color: "#FFE9A8"
            }
          ]
        }
      ]
      exhibit(label: "VOLUME FLOW")
    }
  }
  prototype "shape-volume-cloud" {
    document {
      volumes [
        {
          kind: "cloud"
          position [0, 1.25, 0]
          rotation [0, 1, 0, 0]
          halfExtent [0.45, 0.3, 0.45]
          width: 0.2
          extinction: 4
          coverage: 0.6
          softness: 0.25
          ramp [
            {
              density: 0
              color: "#FFFFFF"
            }
            {
              density: 1
              color: "#C8D2DC"
            }
          ]
        }
      ]
      exhibit(label: "VOLUME CLOUD")
    }
  }
  prototype "shape-state-color" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "STATE COLOR", extra: [{ color: "state.galleryInputs.tint", roughness: 0.45, specular: 0.3 }])
    }
  }
  // Glass: slot 4 an orange acrylic whose colour is reached 12 cm in, so the box holding the sphere reads clear orange
  // and deepest through its middle; slot 5 one window glass twice, as an 8 mm pane and a 6 cm block, which the same
  // depth tints faintly and deeply; slot 6 a frosted pane. Glass slots bake and draw apart from the opaque shapes: the
  // sphere and rods are ordinary shapes seen through them, shifted by the refraction and blurred by the frost.
  prototype "shape-glass" {
    document {
      shape Sphere "core" {
        material: accentMaterial
        position [0.38, 1.2, 0]
        scale [0.1, 0.1, 0.1]
      }
      shape Cylinder "rod" {
        material: accentMaterial
        position [-0.2, 1.2, -0.14]
        scale [0.015, 0.3, 0.015]
      }
      shape Cylinder "frost-rod" {
        material: accentMaterial
        position [-0.46, 1.2, -0.1]
        scale [0.015, 0.3, 0.015]
      }
      shape Box "shell" {
        material: 4
        position [0.38, 1.2, 0]
        scale [0.18, 0.18, 0.18]
      }
      shape Box "thin" {
        material: 5
        position [0.05, 1.2, 0]
        scale [0.1, 0.22, 0.004]
      }
      shape Box "thick" {
        material: 5
        position [-0.2, 1.2, 0]
        scale [0.08, 0.22, 0.03]
      }
      shape Box "frost" {
        material: 6
        position [-0.46, 1.2, 0]
        scale [0.1, 0.22, 0.004]
      }
      exhibit(
        label: "GLASS",
        extra: [
          accent
          { color: "#F58220", roughness: 0.05, glass { depth: 0.12, ior: 1.49 } }
          { color: "#C8F0DC", roughness: 0, glass { depth: 0.01, ior: 1.5 } }
          { color: "#F0F0F0", roughness: 0.7, glass { depth: 0.01, ior: 1.5 } }
        ]
      )
    }
  }
}

// Motion through the stamp pool: every prototype here carries a driver (or frames, or an effector), so its placement
// replays through the dynamic stamp path rather than stamping statically. Blends between shapes ride only inside a
// nonzero `group` there; an ungrouped shape unions.
template motionPrototypes() {
  prototype "motion-spin" {
    document {
      clockDriver(key: "spin", cadence: 0.8, ease: 0)
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.4, 0.15, 0.25]
        swings [
          swing("clock", [0, 1, 0], 1, [0, 1.2, 0]) with { wave: "linear" }
        ]
      }
      exhibit(
        label: "SPIN",
        extra: [
          {
            color: "#7A2E2E"
            roughness: 0.5
            weathering {
              lines: 0.6
              floor: 1
              scale: 4
              seed: 9
              under [{ threshold: 0.2, surface { color: "#C0C4C8", roughness: 0.3, metal: 1 } }]
            }
          }
        ]
      )
    }
  }
  prototype "motion-rock" {
    document {
      clockDriver(key: "rock", cadence: 2)
      shape Sphere "hook" {
        material: exhibitMaterial
        position [0, 1.65, 0]
        scale [0.05, 0.05, 0.05]
      }
      shape Cylinder "subject" {
        material: exhibitMaterial
        position [0, 1.375, 0]
        scale [0.025, 0.225, 0.025]
        swings [
          swing("clock", [0, 0, -1], 0.6, [0, 1.65, 0])
        ]
      }
      shape Sphere "bob" {
        material: accentMaterial
        parent: "subject"
        position [0, 1.05, 0]
        scale [0.12, 0.12, 0.12]
      }
      exhibit(label: "ROCK", extra: [accent])
    }
  }
  prototype "motion-slide" {
    document {
      clockDriver(key: "slide", cadence: 1.5)
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.22, 0.22, 0.22]
        slides [
          {
            driver: "clock"
            axis [-1, 0, 0]
            amplitude: 0.35
          }
        ]
      }
      exhibit(label: "SLIDE", extra: [accent])
    }
  }
  prototype "motion-chain" {
    document {
      clockDriver(key: "chain", cadence: 1.6)
      shape Box "upper" {
        material: exhibitMaterial
        position [0, 1.45, 0]
        scale [0.05, 0.2, 0.05]
        swings [
          swing("clock", [0, 0, -1], 0.5, [0, 1.65, 0])
        ]
      }
      shape Box "lower" {
        material: exhibitMaterial
        parent: "upper"
        position [0, 1.07, 0]
        scale [0.04, 0.18, 0.04]
        swings [
          swing("clock", [0, 0, -1], 0.8, [0, 1.25, 0]) with { wave: "halfSine", phase: 1.2 }
        ]
      }
      shape Sphere "bob" {
        material: accentMaterial
        parent: "lower"
        position [0, 0.85, 0]
        scale [0.07, 0.07, 0.07]
      }
      exhibit(label: "PARENT CHAIN", extra: [accent])
    }
  }
  // The sphere slides along the side of the still box, through a smooth union, inside the blend's admitted envelope
  // (D at most half the smooth radius): the group bakes once at rest and skins the fillet, each vertex in it blending
  // the two shapes' motions by its share, so the fillet follows the slide.
  prototype "motion-smooth-blend" {
    document {
      clockDriver(key: "blend", cadence: 1.2)
      shape Box "anchor" {
        group: 1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "visitor" {
        blend: SmoothUnion
        group: 1
        material: accentMaterial
        position [-0.35, 1.2, 0]
        scale [0.18, 0.18, 0.18]
        smooth: 0.15
        slides [
          {
            driver: "clock"
            axis [-1, 0, 0]
            amplitude: 0.06
          }
        ]
      }
      exhibit(
        label: "MOVING BLEND",
        extra: [accent]
      )
    }
  }
  // The same pair stamped statically, its sphere placed by the galleryInputs probe cell: each write re-emits the creation
  // and rebakes the seam exactly, where motion-smooth-blend skins one baked seam.
  prototype "motion-state-blend" {
    document {
      shape Box "anchor" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "visitor" {
        blend: SmoothUnion
        material: accentMaterial
        position: "state.galleryInputs.probe"
        scale [0.18, 0.18, 0.18]
        smooth: 0.15
      }
      exhibit(label: "STATE BLEND", extra: [accent])
    }
  }
  // A cutter sliding across the face of a still box through a smooth subtraction: it moves alone, so it cuts as an
  // operand of the box's group, which bakes again each time the cutter moves a step, and the bowl follows the tool.
  prototype "motion-carve" {
    document {
      clockDriver(key: "carve", cadence: 1.2)
      shape Box "block" {
        group: 1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.3, 0.3, 0.3]
      }
      shape Sphere "cutter" {
        blend: SmoothSubtraction
        group: 1
        material: accentMaterial
        position [0, 1.25, -0.3]
        scale [0.2, 0.2, 0.2]
        smooth: 0.1
        slides [
          {
            driver: "clock"
            axis [-1, 0, 0]
            amplitude: 0.045
          }
        ]
      }
      exhibit(
        label: "MOVING CUT",
        extra: [accent]
      )
    }
  }
  // A head nodding on a still neck through a smooth union: the swing about the neck's top stays inside the envelope,
  // so the throat's fillet skins, blending the head's turn into the neck.
  prototype "motion-nod" {
    document {
      clockDriver(key: "nod", cadence: 1.1)
      shape Cylinder "neck" {
        group: 1
        material: exhibitMaterial
        position [0, 1.12, 0]
        scale [0.05, 0.2, 0.05]
      }
      shape Sphere "head" {
        blend: SmoothUnion
        group: 1
        material: accentMaterial
        position [0, 1.42, -0.02]
        scale [0.13, 0.13, 0.13]
        smooth: 0.08
        swings [
          swing("clock", [-1, 0, 0], 0.16, [0, 1.3, 0])
        ]
      }
      exhibit(
        label: "NODDING BLEND",
        extra: [accent]
      )
    }
  }
  // Two lobes swing on a still body, all three smoothly blended where they meet: a vertex there takes a third owner's
  // share, which two influences cannot hold, so the bake refuses the skin and bakes each owner's part rigid.
  prototype "motion-three" {
    document {
      clockDriver(key: "three", cadence: 1.3)
      shape Sphere "body" {
        group: 1
        material: exhibitMaterial
        position [0, 1.18, 0]
        scale [0.14, 0.14, 0.14]
      }
      shape Sphere "left" {
        blend: SmoothUnion
        group: 1
        material: accentMaterial
        position [0.1, 1.36, 0]
        scale [0.09, 0.09, 0.09]
        smooth: 0.1
        swings [
          swing("clock", [0, 0, -1], 0.06, [0, 1.3, 0])
        ]
      }
      shape Sphere "right" {
        blend: SmoothUnion
        group: 1
        material: accentMaterial
        position [-0.1, 1.36, 0]
        scale [0.09, 0.09, 0.09]
        smooth: 0.1
        swings [
          swing("clock", [0, 0, -1], 0.06, [0, 1.3, 0]) with { phase: 3.14159 }
        ]
      }
      exhibit(
        label: "THREE OWNERS",
        extra: [accent]
      )
    }
  }
  // A folded shape may not swing, but it rides its parent: the symmetry plane yaws with the hinge.
  prototype "motion-mirror" {
    document {
      clockDriver(key: "mirror", cadence: 1.4)
      shape Box "hinge" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.06, 0.06, 0.06]
        swings [
          swing("clock", [0, 1, 0], 0.7, [0, 1.2, 0])
        ]
      }
      shape Capsule "wing" {
        domain [
          symmetry(normal: [-1, 0, 0])
        ]
        material: accentMaterial
        parent: "hinge"
        position [-0.28, 1.25, 0]
        rotation [0.5, 0.866025, 0, 0]
        scale [0.06, 0.16, 0.06]
      }
      exhibit(label: "MOVING MIRROR", extra: [accent])
    }
  }
  // The hub spins about Z through its centre, and the polar-folded blade rides it: one shape, eight spinning copies.
  prototype "motion-polar" {
    document {
      clockDriver(key: "polar", cadence: 0.9, ease: 0)
      shape Cylinder "hub" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [-0.707107, 0, 0, 0.707107]
        scale [0.08, 0.05, 0.08]
        swings [
          swing("clock", [0, 0, -1], 1, [0, 1.2, 0]) with { wave: "linear" }
        ]
      }
      shape Box "blade" {
        domain [
          polar(count: 8, axis: Z, origin: [0, 1.2, 0])
        ]
        material: accentMaterial
        parent: "hub"
        position [0, 1.45, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.035, 0.14, 0.02]
      }
      exhibit(label: "MOVING POLAR", extra: [accent])
    }
  }
}

template motionPrototypesB() {
  // Parented paints ride their shape's own slot: a stroked plane stripe, a stroked ellipse ring, a filled pentagon and
  // a swept line, each in the panel's local frame.
  prototype "motion-paint" {
    document {
      clockDriver(key: "paint", cadence: 1.2)
      shape Box "panel" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.35, 0.3, 0.1]
        swings [
          swing("clock", [0, 1, 0], 0.6, [0, 1.2, 0])
        ]
      }
      exhibit(
        label: "MOVING PAINT",
        extra: [
          {
            color: "#E8E4DA"
            roughness: 0.5
            paints [
              { parent: "panel", type: "Plane", position [0, 0.16, 0], stroke: 0.025, color: "#E4572E" }
              {
                parent: "panel"
                type: "Prism"
                position [0.15, -0.08, 0]
                scale [0.09, 0.09, 0.2]
                profile { kind: "Ellipse" }
                stroke: 0.012
                color: "#1F4E79"
              }
              {
                parent: "panel"
                type: "Prism"
                position [-0.17, -0.1, 0]
                scale [0.08, 0.08, 0.2]
                profile { kind: "Polygon", sides: 5 }
                color: "#3FA34D"
              }
              {
                parent: "panel"
                type: "Sweep"
                curve {
                  a [-0.25, -0.22, 0.1]
                  b [0, -0.12, 0.1]
                  c [0.25, -0.22, 0.1]
                  radiusStart: 0.012
                  radiusEnd: 0.012
                }
                color: "#171210"
              }
            ]
          }
        ]
      )
    }
  }
  // A painted stripe crossing a skinned fillet between a still box and a sliding sphere, one material on both. A vertex
  // wholly one shape's shades in that shape's frame, so the stripe holds on the box and on the sphere; a blended vertex
  // still shades in its first member's frame until moving-blends step 4 maps material coordinates through the skin.
  prototype "motion-seam-paint" {
    document {
      clockDriver(key: "seamPaint", cadence: 1.2)
      shape Box "anchor" {
        group: 1
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "visitor" {
        blend: SmoothUnion
        group: 1
        material: accentMaterial
        position [-0.35, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.18, 0.18, 0.18]
        smooth: 0.15
        slides [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.06
          }
        ]
      }
      exhibit(
        label: "PAINT ACROSS A SEAM",
        extra: [
          {
            color: "#E8E4DA"
            roughness: 0.5
            paints [
              { parent: "anchor", type: "Plane", position [0, 0, 0], stroke: 0.025, color: "#E4572E" }
            ]
          }
        ]
      )
    }
  }
  // An eye: a radial ramp of pupil, iris, limbus and sclera on a plane under a clear cornea, in the winning slot's
  // frame. The eye's hits win its own slot, centred on the eye, so the plane sits a radius in front of that centre, and
  // the half-turn about Y faces it toward the label side. The iris turns with the eye.
  prototype "motion-inset" {
    document {
      clockDriver(key: "inset", cadence: 0.9)
      shape Sphere "eye" {
        material: accentMaterial
        position [0, 1.25, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.25, 0.25, 0.25]
        swings [
          swing("clock", [0, 1, 0], 0.5, [0, 1.25, 0])
          swing("clock", [-1, 0, 0], 0.2, [0, 1.25, 0]) with { phase: 1.5708 }
        ]
      }
      exhibit(
        label: "MOVING INSET",
        extra: [
          {
            color: "#FFFFFF"
            roughness: 0.1
            specular: 0.4
            coat: 0.6
            inset {
              origin [0, 0, -0.25]
              rotation [0, 1, 0, 0]
              depth: 0.05
              ior: 1.336
              paint {
                stops [
                  { radius: 0.03, color: "#0B0B0B" }
                  { radius: 0.075, color: "#3A7BD5" }
                  { radius: 0.085, color: "#1A2A40" }
                  { radius: 0.095, color: "#F5F3EE" }
                ]
                softness: 0.15
                modulationAmplitude: 0.04
                modulationFrequency: 40
              }
            }
            shade: inset(
              [0, 0, -0.25],
              [0, 1, 0, 0],
              0.05,
              1.336,
              0.15,
              0.04,
              40,
              3.82113123,
              "#0B0B0B",
              "#3A7BD5",
              "#1A2A40",
              "#F5F3EE",
              0.03,
              0.075,
              0.085,
              0.095
            )
          }
        ]
      )
    }
  }
  // Static and pooled shapes share twist and bend, and solid contact follows their deformed field. The twist's constant-wave swing is
  // a pose the driver's weight blends in: a lean that eases in and out with the exhibit's gate.
  prototype "motion-twist" {
    document {
      clockDriver(key: "twist", cadence: 0.8)
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.15, 0.4, 0.15]
        twist: 1.5
        swings [
          swing("clock", [0, 1, 0], 0.5, [0, 1.2, 0])
          swing("clock", [0, 0, -1], 0.25, [0, 0.8, 0]) with { wave: "constant" }
        ]
      }
      exhibit(label: "TWIST", extra: [accent])
    }
  }
  prototype "motion-bend" {
    document {
      clockDriver(key: "bend", cadence: 0.8)
      shape Box "subject" {
        bend: 1.2
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.08, 0.4, 0.08]
        swings [
          swing("clock", [0, 1, 0], 0.5, [0, 1.2, 0])
        ]
      }
      exhibit(label: "BEND", extra: [accent])
    }
  }
  // A dynamic slot carries a rigid pose and no scale, so a pulse is six petals sliding out from a core and back. Each
  // petal and the core is a blend group of its own: a group bakes one mesh, and a seam joining shapes that move apart
  // would stretch as they slide.
  prototype "motion-pulse" {
    document {
      clockDriver(key: "pulse", cadence: 2.5)
      shape Sphere "core" {
        group: 1
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.12, 0.12, 0.12]
      }
      for (petal, index) in pulsePetals {
        shape Sphere $"{petal.name}" {
          group: 2 + index
          material: accentMaterial
          position: (petal.at * [-1, 1, -1])
          scale [0.09, 0.09, 0.09]
          slides [
            {
              driver: "clock"
              axis: (petal.out * [-1, 1, -1])
              amplitude: 0.1
            }
          ]
        }
      }
      exhibit(label: "RADIAL PULSE", extra: [accent])
    }
  }
  prototype "motion-cells" {
    document {
      clockDriver(key: "cells", cadence: 1)
      shape Sphere "subject" {
        cells {
          amplitude: 0.12
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.35, 0.35, 0.35]
        swings [
          swing("clock", [-1, 0, 0], 0.5, [0, 1.2, 0])
        ]
      }
      exhibit(label: "MOVING CELLS", extra: [accent])
    }
  }
  // The plume rides the nozzle's slot, so it tilts with the swing.
  prototype "motion-volume" {
    document {
      clockDriver(key: "volume", cadence: 1.2)
      shape Cylinder "nozzle" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.07, 0.15, 0.07]
        swings [
          swing("clock", [0, 0, -1], 0.4, [0, 0.65, 0])
        ]
      }
      volumes [
        {
          kind: "flow"
          parent: "nozzle"
          position [0, 0.55, 0]
          rotation [1, 0, 0, 0]
          halfExtent [0.2, 0.4, 0.2]
          axis: 0.8
          width: 0.06
          spread: 3
          fade: 1.2
          noiseScale: 0.06
          noiseDepth: 0.5
          speed: 1.2
          seed: 7
          steps: 40
          intensity: 3000
          ramp [
            {
              density: 0
              color: "#0B3A7A"
            }
            {
              density: 0.4
              color: "#1E8FE2"
            }
            {
              density: 1
              color: "#D8F4FF"
            }
          ]
        }
      ]
      exhibit(label: "MOVING VOLUME")
    }
  }
  // A two-bone arm solving toward the world point the galleryInputs reach cell holds.
  prototype "motion-ik" {
    document {
      shape Cylinder "base" {
        material: exhibitMaterial
        position [0, 0.95, 0]
        scale [0.07, 0.05, 0.07]
      }
      shape Cylinder "upper" {
        joint [0, 1.0, 0]
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.035, 0.2, 0.035]
      }
      shape Cylinder "lower" {
        joint [0, 1.4, 0]
        material: exhibitMaterial
        parent: "upper"
        position [0, 1.58, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.03, 0.18, 0.03]
      }
      shape Sphere "hand" {
        material: accentMaterial
        parent: "lower"
        position [0, 1.76, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.06, 0.06, 0.06]
      }
      effectors [
        {
          name: "reach"
          chain [
            "upper"
            "lower"
          ]
          tip: "hand"
          when [
            "state.galleryMotion.all"
            "state.galleryMotion.ik"
          ]
          target {
            kind: "state"
            reference: "state.galleryInputs.reach"
          }
        }
      ]
      exhibit(label: "IK REACH", extra: [accent])
    }
  }
  // A hold-style timeline: the stamp pool steps an animated row's frames on the render clock, eight 60 Hz frames
  // each, whatever the gallery clock reads.
  prototype "motion-frames" {
    document {
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.15, 0.15, 0.15]
      }
      frames [
        {
          name: "left"
          transforms [
            {
              id: 0
              position [0.25, 1.2, 0]
              rotation [0, 1, 0, 0]
            }
          ]
        }
        {
          name: "up"
          transforms [
            {
              id: 0
              position [0, 1.45, 0]
              rotation [0.382683, 0.92388, 0, 0]
            }
          ]
        }
        {
          name: "right"
          transforms [
            {
              id: 0
              position [-0.25, 1.2, 0]
              rotation [0, 1, 0, 0]
            }
          ]
        }
        {
          name: "down"
          transforms [
            {
              id: 0
              position [0, 0.95, 0]
              rotation [0, 0.92388, 0, -0.382683]
            }
          ]
        }
      ]
      exhibit(label: "FRAMES", extra: [accent])
    }
  }
}

// Every creation a world needs for `displays`: the plinth and each display's screens, and the whole catalog's exhibits.
template galleryPrototypes(displays = galleryDisplays) {
  // The display plinth (architecture.puck), one creation every display's plinth placement stamps, and each display's
  // screen over its console.
  prototype "gallery-display" {
    document {
      name: "gallery-display"
      schema: "puck.creation.v2"
      palette: plinthPalette
      displayPlinth(base: 0)
    }
  }
  for (display, index) in displays {
    displayScreen(display: display, number: index + 1)
  }
  // Each primitive at a uniform scale.
  prototype "shape-sphere" {
    document {
      shape Sphere "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "SPHERE", subject: exhibitSubjects.sphere)
    }
  }
  prototype "shape-box" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "BOX", subject: exhibitSubjects.box)
    }
  }
  prototype "shape-torus" {
    document {
      shape Torus "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [-0.5, 0, 0, 0.866025]
        scale [0.6, 0.6, 0.6]
      }
      exhibit(label: "TORUS", subject: exhibitSubjects.torus)
    }
  }
  prototype "shape-cylinder" {
    document {
      shape Cylinder "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.5, 0.4]
      }
      exhibit(label: "CYLINDER", subject: exhibitSubjects.cylinder)
    }
  }
  prototype "shape-capsule" {
    document {
      shape Capsule "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.3, 0.4, 0.3]
      }
      exhibit(label: "CAPSULE", subject: exhibitSubjects.capsule)
    }
  }
  prototype "shape-ellipsoid" {
    document {
      shape Ellipsoid "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "ELLIPSOID", subject: exhibitSubjects.ellipsoid)
    }
  }
  prototype "shape-round-cone" {
    document {
      shape RoundCone "subject" {
        material: exhibitMaterial
        position [0, 0.95, 0]
        scale [0.4, 0.4, 0.4]
      }
      exhibit(label: "ROUND CONE", subject: exhibitSubjects.roundCone)
    }
  }
  prototype "shape-cone" {
    document {
      shape Cone "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.5, 0.45]
      }
      exhibit(label: "CONE", subject: exhibitSubjects.cone)
    }
  }
  prototype "shape-superellipsoid" {
    document {
      shape Superellipsoid "subject" {
        exponent: 4
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "SUPERELLIPSOID", subject: exhibitSubjects.superellipsoid)
    }
  }
  prototype "shape-plane" {
    document {
      shape Sphere "subject" {
        material: exhibitMaterial
