  prototype "shape-bumps" {
    document {
      shape Sphere "subject" {
        bumps [
          {
            center [0.35, 0.2, 0.3]
            radii [0.15, 0.15, 0.15]
            push [0.08, 0.05, 0.07]
          }
          {
            center [-0.3, -0.1, 0.35]
            radii [0.2, 0.1, 0.1]
            push [0.05, 0.02, -0.06]
          }
        ]
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.5, 0.5, 0.5]
      }
      exhibit(
        label: "BUMPS"
      )
