        }
        scale [0.2, 0.2, 0.3]
      }
      exhibit(label: "REV CONVEX")
    }
  }

  // Sweeps, the per-shape facets and a domain fold.
  prototype "shape-sweep" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        curve {
          a [-0.4, 0, 0]
          b [0, 1.0, 0.2]
          c [0.4, 0, 0]
          radiusStart: 0.08
          radiusEnd: 0.08
        }
      }
      exhibit(
        label: "SWEEP",
        note: "a tube of one radius along a quadratic curve: the exact closed-form nearest point. a uniform round cable"
      )
    }
  }
  prototype "shape-sweep-tapered" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        curve {
          a [-0.4, 0, 0]
          b [0, 1.0, 0.2]
          c [0.4, 0, 0]
          radiusStart: 0.14
          radiusEnd: 0.04
          bulge: 0.06
        }
      }
      exhibit(
        label: "SWEEP TAPER",
        note: "the radius tapers 0.14 to 0.04 with a mid-span bulge; the gap search picks the nearest sphere. no bulge seam, no pinch"
      )
    }
  }
  prototype "shape-sweep-strands" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.7, 0]
        curve {
          a [0, 0, 0]
          b [0, 0.5, 0]
          c [0, 1.0, 0]
          radiusStart: 0.04
          radiusEnd: 0.04
          strands: 3
          strandOffset: 0.08
          twist: 1.5
        }
      }
      exhibit(
        label: "SWEEP STRANDS",
        note: "three strands orbiting the curve, 1.5 turns of twist: a rope. strands stay apart and evenly spaced"
      )
    }
  }
  prototype "shape-rounding" {
    document {
      shape Cylinder "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rounding: 0.12
        scale [0.4, 0.4, 0.4]
      }
      exhibit(
        label: "ROUNDING",
        note: "a cylinder with its edge rounded 0.12 m: a curved rim, the flat top and side intact"
      )
    }
  }
  prototype "shape-chamfer" {
    document {
      shape Box "subject" {
        chamfer: 0.1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0.4]
      }
      exhibit(
        label: "CHAMFER",
        note: "a box with 0.1 m 45 degree bevels on every edge and corner; flat bevel faces, not a round"
      )
    }
  }
  prototype "shape-onion" {
    document {
      shape Sphere "subject" {
        material: exhibitMaterial
        onion: 0.04
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      shape Box "window" {
        blend: Subtraction
        material: exhibitMaterial
        position [0, 1.45, 0.35]
        scale [0.35, 0.3, 0.35]
      }
      exhibit(
        label: "ONION",
        note: "a 4 cm shell of a sphere, a window cut to see inside: both skins render, the wall is even"
      )
    }
  }
  prototype "shape-dilate" {
    document {
      shape Box "subject" {
        dilate: 0.1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.3, 0.3, 0.3]
      }
      exhibit(label: "DILATE", note: "a 0.3 box inflated by 0.1: rounded by the inflation, 0.4 across, no creases")
    }
  }
  prototype "shape-flare" {
    document {
      shape Cylinder "subject" {
        flare {
          amount: 0.8
          bulge: 0.2
          span: 1
          top: 0.5
          axis: 1
          startScale: 1
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.5, 0.25]
      }
      exhibit(
        label: "FLARE",
        note: "a cylinder whose cross-section scales along y: amount 0.8 and a 0.2 bulge from the top down. the bake cell is coarse here"
      )
    }
  }
  prototype "shape-shear" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.2, 0.5, 0.2]
        shear {
          linear: 0.3
          quadratic: 0.6
          target: 0
          driver: 1
        }
      }
      exhibit(
        label: "SHEAR",
        note: "a box whose x slides by 0.3 y + 0.6 y squared: a lean that curves. faces stay flat along z"
      )
    }
  }
  prototype "shape-bumps" {
    document {
      shape Sphere "subject" {
        bumps [
          {
            center [0.35, 0.2, 0.3]
            radii [0.15, 0.15, 0.15]
            push [0.08, 0.05, 0.07]
          }
          {
            center [-0.3, -0.1, 0.35]
            radii [0.2, 0.1, 0.1]
            push [0.05, 0.02, -0.06]
          }
        ]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(
        label: "BUMPS",
        note: "two gaussian pushes of the point: a swelling on the upper right, a dent lower left. smooth, no ring"
      )
    }
  }
  prototype "shape-cells-f1" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.18
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "CELLS F1", note: "worley F1 relief, amplitude 0.18: raised cells with creased walls, like chitin")
    }
  }
  prototype "shape-cells-f2" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.09
          frequency: 4
          mode: "F2MinusF1"
          randomness: 0.2
          seed: 3751
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "CELLS F2 F1", note: "F2 minus F1 relief: ridges along the cell walls, hollows at their centres")
    }
  }
  prototype "shape-polar-fold" {
    document {
      shape Box "subject" {
        domain [
          polar(count: 6, axis: Y)
        ]
        material: exhibitMaterial
        position [0, 1.2, 0.35]
        scale [0.1, 0.3, 0.06]
      }
      exhibit(
        label: "POLAR FOLD",
        note: "one box authored at the front, folded into six sectors about y: six blades, one shape. no seam between sectors"
      )
    }
  }

  blendPrototypes()
  foldPrototypes()
  formPrototypes()
  surfacePrototypes()
  motionPrototypes()
  motionPrototypesB()
  warpPrototypes()
  signPrototypes()
}

// Warps II: the ISA ops no earlier row reaches. A domain warp and a sine relief, an elongation, the two lattices with
// no finite copy set (a jittered repeat and a log-spherical Droste fold, each clipped by an intersection inside the
// creation scope) and the two pop-only blends, which compose through a scope the shape opens for itself.
template warpPrototypes() {
  prototype "shape-warp" {
    document {
      shape Sphere "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.42, 0.42, 0.42]
        warp {
          frequency [9, 7, 11]
          amplitude: 0.04
        }
      }
      exhibit(
        label: "DOMAIN WARP",
        note: "a sphere whose point is warped by sines of the next axis: a smooth wobble, not relief. normals stay smooth, no creases"
      )
    }
  }
  prototype "shape-displace" {
    document {
      shape Box "subject" {
        displace {
          frequency [26, 26, 26]
          amplitude: 0.022
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.36, 0.36, 0.36]
      }
      exhibit(
        label: "SINE RELIEF",
        note: "a box with a sine product added to its field: real relief that shadows itself. look for even dimples on every face"
      )
    }
  }
  prototype "shape-elongate" {
    document {
      shape Sphere "subject" {
        elongate [0.28, 0, 0.12]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.16, 0.16, 0.16]
      }
      exhibit(
        label: "ELONGATE",
        note: "a sphere swept over a box of half-extents: an exact rounded slab. the field stays a distance everywhere"
      )
    }
  }
  // A jittered lattice of spheres, each cell's copy displaced and recoloured by its hash, clipped by a box whose faces
  // lie on cell walls, so no copy is cut into a sliver; the tumbled boxes' lattice (spacing 0.2) is clipped the same way.
  prototype "shape-jitter" {
    document {
      shape Sphere "lattice" {
        domain [
          jitter(spacing: [0.18, 0.18, 0.18], amount: 0.06, seed: 7, materialVariants: 3)
        ]
        material: accentMaterial
        position [0, 0, 0]
        scale [0.045, 0.045, 0.045]
      }
      shape Box "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.26, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "JITTER",
        extra: [accent, { color: "#2B7BD9", roughness: 0.45 }, { color: "#3FA34D", roughness: 0.45 }],
        note: "a repeat whose every cell moves and recolours its sphere by a hash. no two cells alike, none crossing a cell wall"
      )
    }
  }
  prototype "shape-jitter-tumble" {
    document {
      shape Box "lattice" {
        domain [
          jitter(spacing: [0.2, 0.2, 0.2], amount: 0.05, seed: 19, tumble: 1, flavor: Blue, materialVariants: 2)
        ]
        material: accentMaterial
        position [0, 0, 0]
        scale [0.035, 0.035, 0.035]
      }
      shape Box "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(
        label: "JITTER TUMBLE",
        extra: [accent, { color: "#2B7BD9", roughness: 0.45 }],
        note: "boxes tumbled by a hashed rotation on a blue-noise lattice. every box a different tilt, the pattern de-clumped"
      )
    }
  }
  // A Droste fold: a sphere nine-tenths of a metre from the fold's centre repeats inward as halving copies, each shell
  // turned a little further, clipped to the inner half metre so the zoom reads.
  prototype "shape-log-sphere" {
    document {
      shape Sphere "shell" {
        domain [
          logSphere(shellRatio: 2, twist: 0.6, origin: [0, 1.2, 0])
        ]
        material: accentMaterial
        position [0.9, 1.2, 0]
        scale [0.07, 0.07, 0.07]
      }
      shape Sphere "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(
        label: "LOG SPHERE",
        extra: [accent],
        note: "self-similar shells about the centre: each copy half the last and turned 0.6 rad. a spiral of shrinking spheres inward"
      )
    }
  }
  prototype "shape-stairs-union" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.32, 0.32, 0.32]
      }
      shape Sphere "tool" {
        blend: StairsUnion
        material: accentMaterial
        position [0.22, 1.42, 0.16]
        scale [0.28, 0.28, 0.28]
        smooth: 0.2
        steps: 4
      }
      exhibit(
        label: "STAIRS UNION",
        extra: [accent],
        note: "a union whose seam climbs four steps over its 0.2 m radius: a staircase around the join, not a fillet"
      )
    }
  }
  prototype "shape-stairs-subtraction" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.32, 0.32, 0.32]
      }
      shape Sphere "tool" {
        blend: StairsSubtraction
        material: accentMaterial
        position [0.22, 1.42, 0.16]
        scale [0.28, 0.28, 0.28]
        smooth: 0.15
        steps: 3
      }
      exhibit(
        label: "STAIRS SUBTRACT",
        extra: [accent],
        note: "a carve whose rim steps three times over 0.15 m: terraces into the cut"
      )
    }
  }
  // A static placement reads lane 0, halfway through the morph's -1..1 window: the box and the sphere at equal weight.
  prototype "shape-morph" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.34, 0.34, 0.34]
      }
      shape Sphere "tool" {
        blend: Morph
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.42, 0.42, 0.42]
        morph {
          lane: 0
          from: -1
          to: 1
        }
      }
      exhibit(
        label: "MORPH",
        extra: [accent],
        note: "the box's and the sphere's fields averaged: lane 0 reads 0, halfway. a soft cube, neither shape's edge"
      )
    }
  }
}
