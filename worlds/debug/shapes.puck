// The shape gallery: every authorable signed-distance construct, one prototype an exhibit, each held 1.2 m over a
// labelled plinth so it reads from every side, underside included. The debug world expands `galleryPrototypes()` inside
// its `prototypes` block, `galleryPlacements()` inside its `placements` block and `galleryState()` (the motion rows'
// console controls) inside its `state.world` block. The exhibits stand inside the gallery hall (hall.puck), four levels
// of rows running along +X, every exhibit 2.6 m from the next and its label facing -Z:
//
//   level 0  shape: primitives at a uniform scale and stretched, prism profiles extruded and revolved
//   level 1  composition: sweeps and the per-shape facets, every shape blend, the domain folds
//   level 2  motion: the stamp pool's rotation, swings, slides, moving blends, paints, IK and frames, and warps II; the
//            board game room fills its east end (boardroom.puck)
//   level 3  form and surface: parameter forms, palette channels and wear, glass
//
// A sign hangs over the west end of each row naming the row, a map board in the lobby by the entrance lists the levels
// and rows, a board over the lift door names each level, and every plinth's plaque says what the exhibit demos and what
// to look for. Each exhibit has a spawn point 2.8 m in front of its plinth, named after it, and the gallery.* commands
// (galleryCommands) walk, frame, inspect and flag exhibits through them. shapes.md beside this file holds the levels,
// the coverage table, the operator camera line that frames each exhibit and the console controls the motion rows answer
// to. This file is a library: debug.puck and hall.puck expand its templates and lets.

// The hall's storey height and each level's floor top: level k's floor stands at 4.5k + 0.05 (hall.puck).
let galleryStorey = 4.5
let galleryPopulation = 43
// The board game room's bodies (boardroom.puck): Alchemy's cursor and 31 element tokens (alchemy.puck), Go's cursor and
// 82 stones (go.puck), then Reversi's cursor and 64 discs (reversi.puck). debug.puck imports them ahead of every other
// population, so they take the population's top slots and every body below them keeps its index.
let alchemyBodies = 32
let goBodies = 83
let reversiBodies = 65
let boardRoomBodies = (alchemyBodies + goBodies + reversiBodies)
let galleryFloor = map(range(0, 4), k => ((galleryStorey * k) + 0.05))
let galleryMapDirections = "stairs and lift north-west: press CALL, or gallery.lift <level>"

// The axis of the painting wing's endless fall (paintings.puck): a painting in level 0's floor under its twin in the
// ceiling at (fallX, fallZ). A body that falls out of the ceiling twin needs 2.2 m of air over it, so level 1's slab is
// holed over the ceiling twin, `fallHole` either side of the axis (hall.puck), and a rail stands round the hole.
let fallX = 66
let fallZ = 22.6
let fallHole = 1

// One box given its world bounds, for a creation standing at the origin with no yaw: the author frame is turned 180
// degrees about up from the world's, so the row negates x and z. The hall's shell (hall.puck) and the painting wing's
// (paintings.puck) are written with it.
template hallBox(label, x0, x1, y0, y1, z0, z1, slot) {
  shape Box $"{label}" {
    material: slot
    position [(0 - ((x0 + x1) / 2)), ((y0 + y1) / 2), (0 - ((z0 + z1) / 2))]
    scale [((x1 - x0) / 2), ((y1 - y0) / 2), ((z1 - z0) / 2)]
  }
}

let galleryX = 23
let gallerySpacing = 2.6

let uniformRow = [
  "shape-sphere", "shape-box", "shape-torus", "shape-cylinder", "shape-capsule", "shape-ellipsoid", "shape-round-cone",
  "shape-cone", "shape-superellipsoid", "shape-plane"
]
let stretchedRow = [
  "shape-sphere-xyz", "shape-box-xyz", "shape-torus-xz", "shape-torus-y", "shape-cylinder-xz", "shape-capsule-xz",
  "shape-ellipsoid-xyz", "shape-round-cone-xyz", "shape-cone-xz", "shape-superellipsoid-xyz"
]
let extrudeRow = [
  "shape-trapezoid", "shape-rounded-rectangle", "shape-polygon-6", "shape-polygon-12", "shape-polygon-12-xy",
  "shape-ellipse", "shape-chamfered-rectangle", "shape-convex", "shape-path-fill", "shape-path-stroke",
  "shape-path-stroke-xy"
]
let revolveRow = [
  "shape-revolve-trapezoid", "shape-revolve-rounded-rectangle", "shape-revolve-polygon-6", "shape-revolve-ellipse",
  "shape-revolve-chamfered-rectangle", "shape-revolve-convex"
]
let facetRow = [
  "shape-sweep", "shape-sweep-tapered", "shape-sweep-strands", "shape-rounding", "shape-chamfer", "shape-onion",
  "shape-dilate", "shape-flare", "shape-shear", "shape-bumps", "shape-cells-f1", "shape-cells-f2", "shape-polar-fold"
]
let foldRow = [
  "shape-symmetry", "shape-repeat", "shape-repeat-grid", "shape-repeat-even", "shape-repeat-clipped",
  "shape-polar-mirror", "shape-polar-z", "shape-polar-stride", "shape-wallpaper-pmm", "shape-wallpaper-p4m",
  "shape-wallpaper-p3m1", "shape-wallpaper-p6m", "shape-wallpaper-stride", "shape-erode", "shape-noise"
]
let formRow = [
  "shape-superellipsoid-2", "shape-superellipsoid-8", "shape-prism-triangle", "shape-prism-rectangle",
  "shape-polygon-3", "shape-prism-rounding", "shape-prism-chamfer", "shape-cylinder-chamfer", "shape-revolve-solid",
  "shape-path-holes", "shape-path-shear", "shape-path-closed-stroke", "shape-path-stroke-ramp", "shape-sweep-braid"
]
let surfaceRow = [
  "shape-metal", "shape-coat", "shape-sheen", "shape-emissive", "shape-wrap-soften", "shape-fill-bleed",
  "shape-weathering-edge", "shape-weathering-lines", "shape-weathering-settle", "shape-panel-recess",
  "shape-panel-raise", "shape-trims", "shape-paint-world", "shape-text-engrave", "shape-text-ride", "shape-volume-flow",
  "shape-volume-cloud", "shape-state-color"
]
let glassRow = ["shape-glass"]
let motionRow = [
  "motion-spin", "motion-rock", "motion-slide", "motion-chain", "motion-smooth-blend", "motion-state-blend",
  "motion-carve", "motion-mirror", "motion-polar"
]
let motionRowB = [
  "motion-paint", "motion-inset", "motion-twist", "motion-bend", "motion-pulse", "motion-cells", "motion-volume",
  "motion-ik", "motion-frames"
]
let warpRow = [
  "shape-warp", "shape-displace", "shape-elongate", "shape-jitter", "shape-jitter-tumble", "shape-log-sphere",
  "shape-stairs-union", "shape-stairs-subtraction", "shape-morph"
]

let foldZ = 33
let motionLevel = 2
let motionZ = 17
let motionZB = 25
let warpZ = 33
let surfaceLevel = 3
let surfaceZ = 25
let glassZ = 37

// The levels, in walking order: the board over each lift door names its level and what it shows.
let galleryLevels = [
  { level: 0, title: "LEVEL 0  SHAPE", what: "primitives, stretched, extruded, revolved" }
  { level: 1, title: "LEVEL 1  COMPOSITION", what: "sweeps and facets, blends, folds" }
  { level: 2, title: "LEVEL 2  MOTION AND GAMES", what: "the stamp pool's motion, warps II, the board game room" }
  { level: 3, title: "LEVEL 3  FORM AND SURFACE", what: "forms, surfaces, glass" }
]

// Every row, in walking order: its sign's title, its level, the z it stands on, its exhibit names and what it shows.
let galleryRows = [
  { title: "PRIMITIVES", level: 0, z: 16, names: uniformRow, what: "each primitive at a uniform scale" }
  { title: "STRETCHED", level: 0, z: 22, names: stretchedRow, what: "each primitive scaled unevenly" }
  { title: "EXTRUDED", level: 0, z: 28, names: extrudeRow, what: "each prism profile, extruded" }
  { title: "REVOLVED", level: 0, z: 34, names: revolveRow, what: "each prism profile, revolved" }
  { title: "SWEEPS AND FACETS", level: 1, z: 17, names: facetRow, what: "sweeps, rounding, shells, warps, relief" }
  {
    title: "BLENDS"
    level: 1
    z: 25
    names: map(blendExhibits, entry => entry.id)
    what: "every blend of a box and a sphere"
  }
  { title: "FOLDS", level: 1, z: foldZ, names: foldRow, what: "symmetry, repeats, polar and wallpaper folds" }
  {
    title: "MOTION"
    level: motionLevel
    z: motionZ
    names: motionRow
    what: "the stamp pool: swings, slides, moving blends"
  }
  {
    title: "MOTION II"
    level: motionLevel
    z: motionZB
    names: motionRowB
    what: "moving paints, twist, bend, cells, IK"
  }
  { title: "WARPS II", level: 2, z: warpZ, names: warpRow, what: "domain warp, sine relief, lattices, stairs, morph" }
  { title: "FORMS", level: surfaceLevel, z: 17, names: formRow, what: "exponents, tapers, paths, a braid" }
  {
    title: "SURFACES"
    level: surfaceLevel
    z: surfaceZ
    names: surfaceRow
    what: "palette channels, wear, panels, text"
  }
  {
    title: "GLASS"
    level: surfaceLevel
    z: glassZ
    names: glassRow
    what: "glass over the opaque image: tint, depth, refraction, frost"
  }
]

// A spawn point per exhibit, named after it, 2.8 m in front of the plinth facing it (yaw 180 faces +Z), so
// `body.pose spawn:<exhibit>` and `gallery.go <exhibit>` walk to any exhibit by name.
let gallerySpawns = reduce(
  galleryRows,
  [],
  (spawns, row) => concat(
    spawns,
    map(
      row.names,
      (name, index) => {
        id: name
        position [(galleryX + (gallerySpacing * index)), galleryFloor[row.level], (row.z - 2.8)]
        yawDegrees: 180
      }
    )
  )
)

let galleryPentagon = [[0, 1], [0.95, 0.31], [0.59, -0.81], [-0.59, -0.81], [-0.95, 0.31]]
// The hex wallpapers' clip: a clockwise pointy-top hexagon of inradius 0.45 (circumradius 0.45 / cos 30 degrees).
let galleryHexClip = [
  [0, 0.519615]
  [0.45, 0.259808]
  [0.45, -0.259808]
  [0, -0.519615]
  [-0.45, -0.259808]
  [-0.45, 0.259808]
]

// Slot 0 the exhibit, slot 1 the plinth, slot 2 the label, slot 3 an exhibit's own second material (a blend's tool,
// a palette channel under test) and slots past it whatever else an exhibit appends.
let exhibitMaterial = 0
let accentMaterial = 3
let galleryPalette = [
  { color: "#B9C4D0", roughness: 0.45, specular: 0.3 }
  { color: "#3A3F47", roughness: 0.85 }
  { color: "#F2EEE4", roughness: 0.6 }
]
let accent = { color: "#D9822B", roughness: 0.45, specular: 0.3 }

// The palette, the plinth beneath the exhibit, the plinth's label and its plaque. Expanded after the exhibit's own
// shapes, so an exhibit's subtraction or intersection never reaches the plinth. `extra` appends palette slots from 3 on,
// `runs` text runs after the label, and `note` is the plaque: what the exhibit demos and what to look for, in small
// type under the label (each non-whitespace glyph charges the stamp budget, so a note stays under ~120 glyphs).
template exhibit(label, extra = [], runs = [], note = "") {
  name: label
  schema: "puck.creation.v1"
  palette: concat(galleryPalette, extra)
  shape Box "plinth" {
    material: 1
    position [0, 0.15, 0]
    scale [0.6, 0.15, 0.25]
  }
  textRuns: concat(
    [
      {
        text: label
        position [0, 0.19, 0.25]
        rotation [0, 0, 0, 1]
        emHeight: 0.085
        depth: 0.006
        mode: "emboss"
        material: 2
        align: "center"
      }
    ],
    ((note == "") ? [] : [
      {
        text: note
        position [0, 0.085, 0.25]
        rotation [0, 0, 0, 1]
        emHeight: 0.03
        depth: 0.004
        mode: "emboss"
        material: 2
        align: "center"
        maxWidth: 1.12
        lineSpacing: 1.15
      }
    ]),
    runs
  )
}

// A section board hanging on two rods from the ceiling over a level's floor, its lower edge 2.6 m up: a row's sign,
// and the board game room's over its doorway (boardroom.puck). Its placement's yaw turns the text's face.
template sectionSign(name, title, what) {
  prototype name {
    document {
      name: name
      schema: "puck.creation.v1"
      palette: galleryPalette
      for x in [-0.75, 0.75] {
        shape Box $"hanger-{x}" {
          material: 1
          position [x, 3.66, 0]
          scale [0.025, 0.54, 0.025]
        }
      }
      shape Box "board" {
        material: 2
        position [0, 2.9, 0]
        scale [1.05, 0.3, 0.04]
      }
      textRuns [
        {
          text: title
          position [0, 2.99, 0.04]
          rotation [0, 0, 0, 1]
          emHeight: 0.14
          depth: 0.004
          mode: "emboss"
          material: 1
          align: "center"
          maxWidth: 2
        }
        {
          text: what
          position [0, 2.75, 0.04]
          rotation [0, 0, 0, 1]
          emHeight: 0.065
          depth: 0.003
          mode: "emboss"
          material: 1
          align: "center"
          maxWidth: 2
        }
      ]
    }
  }
}

// The hanging boards face down the hall toward the landing (-X); plinth labels still face -Z.
template signPrototypes() {
  for (row, index) in galleryRows {
    sectionSign(name: $"gallery-sign-{index}", title: row.title, what: row.what)
  }
  // The map board in the lobby: how to get around, then each level and the rows it holds, in walking order.
  prototype "gallery-map" {
    document {
      name: "gallery-map"
      schema: "puck.creation.v1"
      palette: galleryPalette
      for x in [-0.6, 0.6] {
        shape Box $"hanger-{x}" {
          material: 1
          position [x, 3.5, 0]
          scale [0.03, 0.7, 0.03]
        }
      }
      shape Box "board" {
        material: 2
        position [0, 2.24, 0]
        scale [0.72, 0.66, 0.015]
      }
      textRuns: map(concat(
        [
          {
            text: "SHAPE GALLERY"
            position [0, 2.08, 0.015]
            rotation [0, 0, 0, 1]
            emHeight: 0.07
            depth: 0.004
            mode: "emboss"
            material: 1
            align: "center"
          }
        ],
        [
          {
            text: galleryMapDirections
            position [0, 1.98, 0.015]
            rotation [0, 0, 0, 1]
            emHeight: 0.026
            depth: 0.003
            mode: "emboss"
            material: 1
            align: "center"
            maxWidth: 1.36
          }
        ],
        map(
          galleryLevels,
          (level, index) => {
            text: level.title
            position [0, (1.84 - (0.19 * index)), 0.015]
            rotation [0, 0, 0, 1]
            emHeight: 0.05
            depth: 0.003
            mode: "emboss"
            material: 1
            align: "center"
          }
        ),
        map(
          galleryLevels,
          (level, index) => {
            text: reduce(
              filter(galleryRows, row => (row.level == level.level)),
              "",
              (text, row) => ((text == "") ? row.title : $"{text}, {row.title}")
            )
            position [0, (1.775 - (0.19 * index)), 0.015]
            rotation [0, 0, 0, 1]
            emHeight: 0.03
            depth: 0.003
            mode: "emboss"
            material: 1
            align: "center"
            maxWidth: 1.36
          }
        ),
        [
          {
            text: "gallery.go <exhibit>   gallery.next   gallery.flag <exhibit> <note>"
            position [0, 1.08, 0.015]
            rotation [0, 0, 0, 1]
            emHeight: 0.026
            depth: 0.003
            mode: "emboss"
            material: 1
            align: "center"
            maxWidth: 1.36
          }
        ],
        [
          {
            text: "PAINTING WING east   BOARD GAMES level 2 east   WONDERLAND west wall"
            position [0, 0.95, 0.015]
            rotation [0, 0, 0, 1]
            emHeight: 0.026
            depth: 0.003
            mode: "emboss"
            material: 1
            align: "center"
            maxWidth: 1.36
          }
        ]
      ), run => {
        text: run.text
        position [run.position[0], (run.position[1] + 0.7), run.position[2]]
        rotation: run.rotation
        emHeight: run.emHeight
        depth: run.depth
        mode: run.mode
        material: run.material
        align: run.align
        maxWidth: 1.36
      })
    }
  }
}

// The map hangs left of the entrance; row boards hang above the first exhibit.
template gallerySignPlacements() {
  for (row, index) in galleryRows {
    placement $"gallery-sign-{index}" {
      prototype: $"gallery-sign-{index}"
      position [galleryX, galleryFloor[row.level], row.z]
      yawDegrees: 90
    }
  }
  placement "gallery-map" {
    prototype: "gallery-map"
    position [12.4, galleryFloor[0], 16]
  }
}

// The gallery's console commands, composed from existing verbs (docs/reference/commands.md): walk to an exhibit's spawn
// point, isolate an exhibit's shape, flag one that looks wrong (world.flag writes the record and its capture into the
// package's git-ignored flags folder), cycle the debug views, and slice an exhibit's field into the package's slices
// folder. world.debug-view and world.slice.save exist only in a rendered World, so a headless host refuses those two
// commands when they run.
let galleryCommands = [
  {
    name: "gallery.go"
    help: "Walks a body to an exhibit's spawn point (its prototype name, or gallery for the entrance) and returns the view to the chase camera."
    parameters [
      { name: "exhibit", kind: Spawn, default: "gallery" }
      { name: "body", kind: Body, default: "0" }
    ]
    lines [
      "body.pose spawn:{exhibit} {body}"
      "view.override camera auto"
      "view.override layout play"
    ]
  }
  {
    name: "gallery.isolate"
    help: "Draws one exhibit's named shape alone (its subject by default); gallery.isolate off restores every shape."
    parameters [
      { name: "exhibit", kind: Text }
      { name: "shape", kind: Text, default: "subject" }
    ]
    lines [
      "view.isolate {exhibit} {shape}"
    ]
  }
  {
    name: "gallery.flag"
    help: "Flags an exhibit that looks wrong (near, the default, names the one the seat stands at): world.flag writes worlds/debug/flags/<exhibit>.json (the note, the seat's pose and camera) and captures the view to <exhibit>.png beside it, for an agent to read back."
    parameters [
      { name: "exhibit", kind: Text, default: "near" }
      { name: "note", kind: Text, default: "looks-wrong" }
    ]
    lines [
      "world.flag {exhibit} {note}"
    ]
  }
  {
    name: "gallery.view"
    help: "Steps every camera to the next debug view (off, depth, normals, raydir, material-id, visibility, motion, sky-cost, ao, shadow, indirect, then off again), or selects one by name."
    parameters [
      {
        name: "view"
        kind: Choice
        values [
          "next", "off", "depth", "normals", "raydir", "material-id", "visibility", "motion", "sky-cost", "ao",
          "shadow", "indirect"
        ]
        default: "next"
      }
    ]
    lines [
      "world.debug-view {view}"
    ]
  }
  {
    name: "gallery.slice"
    help: "Cuts an exhibit's field (near, the default, names the one the seat stands at) on a plane through its placement and writes the distance diagnostic to worlds/debug/slices/<exhibit>-<axis>.png: by default the level plane through the exhibit's middle, 1.2 m over its floor; an x or z cut wants offset 0 to pass through its centre."
    parameters [
      { name: "exhibit", kind: Text, default: "near" }
      { name: "axis", kind: Choice, values ["y", "x", "z"], default: "y" }
      { name: "offset", kind: Number, default: "1.2" }
    ]
    lines [
      "world.slice.save {exhibit} {axis} offset {offset}"
    ]
  }
]

template galleryPlacements() {
  for row in galleryRows {
    for (name, index) in row.names {
      placement $"{name}" {
        prototype: name
        position [(galleryX + (gallerySpacing * index)), galleryFloor[row.level], row.z]
      }
    }
  }
  // The noisy sphere over the NOISE plinth (the fold row's last exhibit): a separate creation keeps the noise off the plinth.
  placement "shape-noise-subject" {
    prototype: "shape-noise-subject"
    position [(galleryX + (gallerySpacing * (length(foldRow) - 1))), galleryFloor[1], foldZ]
  }
  gallerySignPlacements()
}

// The gallery's motion controls. Every driver in the motion rows reads `galleryClock`, gallery seconds advancing at the
// row's rate; a rate of zero freezes every pose where it stands, and writing the cell scrubs it. Each driver is gated on
// `galleryMotion.all` and on its exhibit's own `galleryMotion` key: a zero eases that exhibit back to its rest pose.
// `galleryInputs` holds text cells three exhibits read: `probe` places motion-state-blend's sphere, `reach` is the world
// point motion-ik's arm reaches for, and `tint` colours shape-state-color. shapes.md gives the console lines.
let reachX = (galleryX + (gallerySpacing * 7))

template galleryState() {
  slot galleryClock = 0.5 advance(perSecond: 1)

  table galleryMotion {
    all = 1
    spin = 1
    rock = 1
    slide = 1
    chain = 1
    blend = 1
    carve = 1
    mirror = 1
    polar = 1
    paint = 1
    inset = 1
    twist = 1
    bend = 1
    pulse = 1
    cells = 1
    volume = 1
    ik = 1
  }

  table galleryInputs {
    probe = "[0.3, 1.35, 0.05]"
    reach = $"[{reachX + 0.35}, {galleryFloor[motionLevel] + 1.45}, {motionZB - 0.25}]"
    tint = "#D9822B"
  }

}

// The one driver every motion exhibit runs on: the gallery clock times `cadence` radians a gallery second, gated on
// the whole gallery and on the exhibit's own key, its weight easing over `ease` seconds as a gate opens or closes.
template clockDriver(key, cadence = 1, ease = 0.3) {
  drivers [
    {
      name: "clock"
      signal: "state.galleryClock"
      cadence: cadence
      blendInSeconds: ease
      blendOutSeconds: ease
      when [
        "state.galleryMotion.all"
        $"state.galleryMotion.{key}"
      ]
    }
  ]
}

// Every shape blend: the box first, then the sphere in the accent colour blended into it, so a seam's material winner
// shows. The intersection family's sphere is larger and nearer the box's centre, so the two overlap enough to read.
let blendExhibits = [
  {
    id: "shape-blend-union"
    label: "UNION"
    blend: "Union"
    smooth: 0
    tool [0.22, 1.42, 0.16]
    radius [0.28, 0.28, 0.28]
    note: "min of the two fields: a hard crease where they meet, the sphere's orange winning its own surface"
  }
  {
    id: "shape-blend-subtraction"
    label: "SUBTRACTION"
    blend: "Subtraction"
    smooth: 0
    tool [0.22, 1.42, 0.16]
    radius [0.28, 0.28, 0.28]
    note: "the sphere carved out of the box: the bowl wears the sphere's colour, the rim stays sharp"
  }
  {
    id: "shape-blend-intersection"
    label: "INTERSECTION"
    blend: "Intersection"
    smooth: 0
    tool [0.1, 1.28, 0.08]
    radius [0.4, 0.4, 0.4]
    note: "only where both overlap: a box with spherical corners, the sphere's colour on its own faces"
  }
  {
    id: "shape-blend-xor"
    label: "XOR"
    blend: "Xor"
    smooth: 0
    tool [0.22, 1.42, 0.16]
    radius [0.28, 0.28, 0.28]
    note: "either but not both: the overlap is cut away, leaving a void you can see into from the seam"
  }
  {
    id: "shape-smooth-union"
    label: "SMOOTH UNION"
    blend: "SmoothUnion"
    smooth: 0.15
    tool [0.22, 1.42, 0.16]
    radius [0.28, 0.28, 0.28]
    note: "a 0.15 m fillet where sphere meets box; the fillet should be a smooth saddle with no step"
  }
  {
    id: "shape-smooth-subtraction"
    label: "SMOOTH SUBTRACT"
    blend: "SmoothSubtraction"
    smooth: 0.1
    tool [0.22, 1.42, 0.16]
    radius [0.28, 0.28, 0.28]
    note: "the carve's rim rounded over 0.1 m into the box"
  }
  {
    id: "shape-smooth-intersection"
