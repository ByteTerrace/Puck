  }
  prototype "shape-prism-rounding" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        profile {
          kind: "Polygon"
          sides: 6
        }
