          span: 1
          top: 0.5
          axis: 1
          startScale: 1
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.25, 0.5, 0.25]
      }
      exhibit(
        label: "FLARE"
      )
