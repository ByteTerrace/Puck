]

template blendPrototypes() {
  for entry in blendExhibits {
    prototype $"{entry.id}" {
      document {
        shape Box "subject" {
          material: exhibitMaterial
          position [0, 1.2, 0]
          scale [0.32, 0.32, 0.32]
        }
        shape Sphere "tool" {
          blend: entry.blend
          material: accentMaterial
          position: entry.tool
          scale: entry.radius
          smooth: entry.smooth
        }
        exhibit(label: entry.label, extra: [accent], note: entry.note)
      }
    }
  }
}

// The six petals motion-pulse slides out from its core and back, sixty degrees apart in the plane facing the label.
let pulsePetals = [
  { name: "petal-0", at [0.27, 1.2, 0], out [1, 0, 0] }
  { name: "petal-1", at [0.135, 1.43383, 0], out [0.5, 0.866025, 0] }
  { name: "petal-2", at [-0.135, 1.43383, 0], out [-0.5, 0.866025, 0] }
  { name: "petal-3", at [-0.27, 1.2, 0], out [-1, 0, 0] }
  { name: "petal-4", at [-0.135, 0.96617, 0], out [-0.5, -0.866025, 0] }
  { name: "petal-5", at [0.135, 0.96617, 0], out [0.5, -0.866025, 0] }
]

// The domain folds, erosion and creation noise. A fold acts in creation space before the shape's own transform, and
// a repeat or polar origin is engine-frame: an author-frame point [x, y, z] is origin [-x, y, -z].
template foldPrototypes() {
  prototype "shape-symmetry" {
    document {
      shape Capsule "subject" {
        domain [
          symmetry(normal: [1, 0, 0])
        ]
        material: exhibitMaterial
        position [0.25, 1.2, 0]
        rotation [0, 0, 0.258819, 0.965926]
        scale [0.08, 0.25, 0.08]
      }
      exhibit(label: "SYMMETRY", note: "one tilted capsule mirrored across x = 0: a V, the pair exactly symmetric")
    }
  }
  prototype "shape-repeat" {
    document {
      shape Sphere "subject" {
        domain [
          repeat(spacing: [0.25, 1, 1], limit: [2, 0, 0])
        ]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.1, 0.1, 0.1]
      }
      exhibit(
        label: "REPEAT 5",
        note: "one sphere repeated 0.25 m apart, limit 2: five copies, the field exact at each"
      )
    }
  }
  prototype "shape-repeat-grid" {
    document {
      shape Box "subject" {
        domain [
          repeat(spacing: [0.22, 1, 0.22], limit: [1, 0, 1])
        ]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.07, 0.07, 0.07]
      }
      exhibit(label: "REPEAT 3X3", note: "one box on a 3 by 3 lattice in x and z")
    }
  }
  // Four copies: the symmetry fold keeps author +X, and the repeat lays three cells from engine x -0.375 to 0.125,
  // the last of which lies in the folded-away half.
  prototype "shape-repeat-even" {
    document {
      shape Sphere "subject" {
        domain [
          symmetry(normal: [1, 0, 0])
          repeat(spacing: [0.25, 1, 1], limit: [1, 0, 0], origin: [-0.125, 0, 0])
        ]
        material: exhibitMaterial
        position [0.125, 1.2, 0]
        scale [0.09, 0.09, 0.09]
      }
      exhibit(
        label: "REPEAT EVEN",
        note: "an even count from a symmetry over an odd repeat: four spheres, the middle gap closed"
      )
    }
  }
  // An unbounded lattice clipped by an intersection: the creation-wide scope keeps the clip off every other placement.
  // The sphere sits in the lattice's central cell, at the creation origin; a shape authored off it is never reached. The
  // clip box's faces lie on cell walls (0.09 + 0.18k), so it cuts no bead and leaves no sliver for the bake to fold.
  prototype "shape-repeat-clipped" {
    document {
      shape Sphere "lattice" {
        domain [
          repeat(spacing: [0.18, 0.18, 0.18])
        ]
        material: exhibitMaterial
        position [0, 0, 0]
        scale [0.06, 0.06, 0.06]
      }
      shape Box "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.26, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "REPEAT CLIPPED",
        note: "an unbounded lattice of spheres clipped by a box on the cell walls: a block of whole beads, none cut"
      )
    }
  }
  prototype "shape-polar-mirror" {
    document {
      shape Box "subject" {
        domain [
          polar(count: 5, axis: Y, mirror: true)
        ]
        material: exhibitMaterial
        position [0, 1.2, 0.3]
        rotation [0, 0, 0.258819, 0.965926]
        scale [0.05, 0.25, 0.1]
      }
      exhibit(
        label: "POLAR MIRROR",
        note: "five sectors, each reflected across its bisector: a kaleidoscope, mirror pairs meeting at the walls"
      )
    }
  }
  prototype "shape-polar-z" {
    document {
      shape Box "subject" {
        domain [
          polar(count: 8, axis: Z, origin: [0, 1.2, 0])
        ]
        material: exhibitMaterial
        position [0, 1.5, 0]
        scale [0.04, 0.12, 0.04]
      }
      exhibit(label: "POLAR Z", note: "eight copies about z through an origin above the plinth: a wheel facing you")
    }
  }
  prototype "shape-polar-stride" {
    document {
      shape Sphere "subject" {
        domain [
          polar(count: 6, axis: Y, materialStride: 1)
        ]
        material: accentMaterial
        position [0, 1.2, 0.32]
        scale [0.12, 0.12, 0.12]
      }
      exhibit(
        label: "POLAR STRIDE",
        extra: [
          accent
          { color: "#2B7BD9", roughness: 0.45 }
          { color: "#3FA34D", roughness: 0.45 }
          { color: "#C23B3B", roughness: 0.45 }
          { color: "#8E5BD9", roughness: 0.45 }
          { color: "#E3C547", roughness: 0.45 }
        ],
        note: "six sectors, each striding the palette one row: six colours, one sphere"
      )
    }
  }
  // Each wallpaper tile sits inside its group's fundamental region of the cell (`SdfWallpaperFold.Fold`), in the
  // engine frame, so author [x, y, z] lands at [-x, y, -z]: Pmm's positive quadrant, P4M below the diagonal, P3M1's
  // wedge from 30 to 90 degrees and P6M's from 30 to 60. A tile outside its region folds onto nothing and draws nothing.
  prototype "shape-wallpaper-pmm" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: Pmm, limit: [1, 1])
        ]
        material: exhibitMaterial
        position [-0.07, 1.2, -0.06]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.07, 0.03, 0.02]
      }
      exhibit(
        label: "WALLPAPER PMM",
        note: "a tile mirrored across both cell axes, limit 1: a 3 by 3 field of mirror images"
      )
    }
  }
  prototype "shape-wallpaper-p4m" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P4M, limit: [1, 1])
        ]
        material: exhibitMaterial
        position [-0.08, 1.2, -0.025]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.07, 0.03, 0.02]
      }
      exhibit(
        label: "WALLPAPER P4M",
        note: "square symmetry with mirrors through the 4-fold centres: eight images per cell"
      )
    }
  }
  // A hex group carries no limit: an intersection inside the creation-wide scope bounds the lattice. The clip is a
  // pointy-top hexagonal prism of inradius 0.45 stood upright, its flat faces 1.5 cells out on the lattice's mirror
  // planes, so every cut face is a tile's own flat section rather than a sliver a cell thin.
  prototype "shape-wallpaper-p3m1" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P3M1)
        ]
        material: exhibitMaterial
        position [-0.03, 1.2, -0.08]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.06, 0.03, 0.02]
      }
      shape Prism "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [0.707107, 0, 0, 0.707107]
        profile {
          kind: "Convex"
          vertices: galleryHexClip
        }
        scale [1, 1, 0.1]
      }
      exhibit(
        label: "WALLPAPER P3M1",
        note: "a hex lattice with mirrors through the corners, clipped by a hexagon on mirror planes: flat cut faces, no creases"
      )
    }
  }
  prototype "shape-wallpaper-p6m" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P6M)
        ]
        material: exhibitMaterial
        position [-0.06, 1.2, -0.06]
        rotation [0, 0.258819, 0, 0.965926]
        scale [0.06, 0.03, 0.02]
      }
      shape Prism "clip" {
        blend: Intersection
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [0.707107, 0, 0, 0.707107]
        profile {
          kind: "Convex"
          vertices: galleryHexClip
        }
        scale [1, 1, 0.1]
      }
      exhibit(
        label: "WALLPAPER P6M",
        note: "the richest hex group, twelve images per cell, clipped on its mirror planes: the tiles meet cleanly"
      )
    }
  }
  prototype "shape-wallpaper-stride" {
    document {
      shape Box "subject" {
        domain [
          wallpaper(cell: [0.3, 0.3], group: P4M, limit: [1, 1], materialStride: 1)
        ]
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.13, 0.04, 0.13]
      }
      exhibit(
        label: "WALLPAPER STRIDE",
        extra: [accent, { color: "#2B7BD9", roughness: 0.45 }],
        note: "p4m with a material stride: cells alternate colour by parity, a checkerboard"
      )
    }
  }
  // A static placement supplies no render lanes, so the lane reads zero: halfway through this from/to window.
  prototype "shape-erode" {
    document {
      shape Sphere "subject" {
        erode {
          lane: 0
          from: -1
          to: 1
          noise: 6
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "ERODE", note: "a lane erodes the sphere, here halfway through")
    }
  }
  // Creation noise displaces every shape and text run of the creation it sits in, with no per-shape or per-group
  // scope, so the plinth and label stay clean by living in a second prototype: "shape-noise" is the bare exhibit
  // (plinth, label and plaque) and "shape-noise-subject" the noisy sphere, placed at the same spot by galleryPlacements().
  prototype "shape-noise" {
    document {
      exhibit(label: "NOISE", note: "fBm noise lumps the sphere; the plinth stays clean")
    }
  }
  prototype "shape-noise-subject" {
    document {
      name: "shape-noise-subject"
      schema: "puck.creation.v1"
      palette: galleryPalette
      noise {
        frequency: 4
        amplitude: 0.12
        seed: 11
      }
      shape Sphere "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0.4]
      }
    }
  }
}

// The parameter forms the first five rows leave out: exponent and taper extremes, the three-sided polygon, rounded and
// chamfered prisms and cylinders, a solid of revolution, and the path profile's holes, shear, closed stroke and radius
// ramp.
template formPrototypes() {
  prototype "shape-superellipsoid-2" {
    document {
      shape Superellipsoid "subject" {
        exponent: 2
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "SUPER EXP 2")
    }
  }
  prototype "shape-superellipsoid-8" {
    document {
      shape Superellipsoid "subject" {
        exponent: 8
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "SUPER EXP 8")
    }
  }
  prototype "shape-prism-triangle" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.45, 0.2]
        taper: 0
      }
      exhibit(label: "TAPER 0")
    }
  }
  prototype "shape-prism-rectangle" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.4, 0.2]
        taper: 1
      }
      exhibit(label: "TAPER 1")
    }
  }
  prototype "shape-polygon-3" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Polygon"
          sides: 3
        }
        scale [0.5, 0.5, 0.2]
      }
      exhibit(label: "POLYGON 3")
    }
  }
  prototype "shape-prism-rounding" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Polygon"
          sides: 6
        }
        rounding: 0.06
        scale [0.5, 0.5, 0.2]
      }
      exhibit(label: "PRISM ROUNDING")
    }
  }
  prototype "shape-prism-chamfer" {
    document {
      shape Prism "subject" {
        chamfer: 0.06
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Ellipse"
        }
        scale [0.55, 0.38, 0.2]
      }
      exhibit(label: "PRISM CHAMFER")
    }
  }
  prototype "shape-cylinder-chamfer" {
    document {
      shape Cylinder "subject" {
        chamfer: 0.08
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0.4]
      }
      exhibit(label: "CYLINDER CHAMFER")
    }
  }
  prototype "shape-revolve-solid" {
    document {
      shape Prism "subject" {
        lift: "Revolve"
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.4, 0]
        taper: 0.3
      }
      exhibit(label: "REV SOLID")
    }
  }
  // An even-odd fill: a square whose right side is a cubic Bezier, holed by a circle of two arcs.
  prototype "shape-path-holes" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            contours [
              {
                start [-0.8, -0.8]
                segments [
                  {
                    end [0.8, -0.8]
                  }
                  {
                    end [0.8, 0.8]
                    control [0.95, -0.3]
                    control2 [0.6, 0.3]
                  }
                  {
                    end [-0.8, 0.8]
                  }
                  {
                    end [-0.8, -0.8]
                  }
                ]
              }
              {
                start [0.35, 0]
                segments [
                  {
                    end [-0.35, 0]
                    arcCenter [0, 0]
                  }
                  {
                    end [0.35, 0]
                    arcCenter [0, 0]
                  }
                ]
              }
            ]
          }
        }
        scale [0.5, 0.5, 0.1]
      }
      exhibit(label: "PATH HOLES")
    }
  }
  prototype "shape-path-shear" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            shear {
              linear: 0.2
              quadratic: 0.4
              target: 0
            }
            contours [
              {
                start [-0.5, -0.7]
                segments [
                  {
                    end [0.5, -0.7]
                  }
                  {
                    end [0.5, 0.7]
                  }
                  {
                    end [-0.5, 0.7]
                  }
                  {
                    end [-0.5, -0.7]
                  }
                ]
              }
            ]
          }
        }
        scale [0.5, 0.5, 0.1]
      }
      exhibit(label: "PATH SHEAR")
    }
  }
  prototype "shape-path-closed-stroke" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            stroke {
              radiusStart: 0.06
              radiusEnd: 0.06
            }
            contours [
              {
                start [-0.6, 0]
                closed: true
                segments [
                  {
                    end [0.6, 0]
                    control [-0.6, 0.85]
                    control2 [0.6, 0.85]
                  }
                  {
                    end [-0.6, 0]
                    control [0.6, -0.85]
                    control2 [-0.6, -0.85]
                  }
                ]
              }
            ]
          }
        }
        scale [0.6, 0.6, 0.08]
      }
      exhibit(label: "PATH CLOSED")
    }
  }
  // A linear radius ramp over the middle half of the stroke, along a clockwise arc and a line.
  prototype "shape-path-stroke-ramp" {
    document {
      shape Prism "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        profile {
          kind: "Path"
          cornerRadius: 0
          path {
            tolerance: 0.002
            stroke {
              radiusStart: 0.1
              radiusEnd: 0.02
              smooth: false
              from: 0.25
              to: 0.75
            }
            contours [
              {
                start [-0.6, -0.3]
                segments [
                  {
                    end [0.6, -0.3]
                    arcCenter [0, -0.3]
                    clockwise: true
                  }
                  {
                    end [0.6, 0.6]
                  }
                ]
              }
            ]
          }
        }
        scale [0.6, 0.6, 0.08]
      }
      exhibit(label: "PATH RAMP")
    }
  }
  prototype "shape-sweep-braid" {
    document {
      shape Sweep "subject" {
        material: exhibitMaterial
        position [0, 0.7, 0]
        curve {
          a [0, 0, 0]
          b [0.2, 0.5, 0]
          c [0, 1.0, 0]
          radiusStart: 0.04
          radiusEnd: 0.04
          strands: 4
          strandOffset: 0.08
          twist: 2
        }
      }
      exhibit(label: "SWEEP BRAID")
    }
  }
}

// The static paint's world-space plane: a static placement shares one palette and draws an unparented paint in world
// space, so the stripe names its own exhibit's place in the surface row (index 12, on level 3).
let paintX = (galleryX + (gallerySpacing * 12))
let paintY = (galleryFloor[surfaceLevel] + 1.2)

// Surfaces: palette channels, weathering, panels, trims, a world-space paint, text runs, volumes and a state-bound
// colour, each on slot 3.
template surfacePrototypes() {
  prototype "shape-metal" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "METAL", extra: [{ color: "#D4AF37", metal: 1, roughness: 0.25, specular: 0.5 }])
    }
  }
  prototype "shape-coat" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "COAT", extra: [{ color: "#B3261E", specular: 0.35, roughness: 0.4, coat: 0.5 }])
    }
  }
  prototype "shape-sheen" {
    document {
      shape Box "subject" {
        chamfer: 0.08
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.38, 0.38, 0.38]
      }
      exhibit(label: "SHEEN", extra: [{ color: "#4A6FA5", roughness: 0.7, sheen: 1 }])
    }
  }
  prototype "shape-emissive" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "EMISSIVE", extra: [{ color: "#FFB347", emissive: 300 }])
    }
  }
  prototype "shape-wrap-soften" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.18
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.5, 0.5, 0.5]
      }
      exhibit(label: "WRAP SOFTEN", extra: [{ color: "#C9A27E", roughness: 0.6, wrap: 0.6, soften: 1 }])
    }
  }
  prototype "shape-fill-bleed" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "FILL BLEED",
        extra: [{ color: "#DDDDDD", roughness: 0.8, fill: "#2F5BFF", bleed: "#FF5A1F", receive: 1.5 }]
      )
    }
  }
  prototype "shape-weathering-edge" {
    document {
      shape Cylinder "subject" {
        rounding: 0.1
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.38, 0.38, 0.38]
      }
      exhibit(
        label: "WEAR EDGE",
        extra: [
          {
            color: "#2E6B3A"
            roughness: 0.5
            weathering {
              edge: 1
              reach: 0.08
              floor: 1
              seed: 5
              under [
                { threshold: 0.25, surface { color: "#B5895B", roughness: 0.8, metal: 0 } }
                { threshold: 0.6, surface { color: "#9AA0A6", roughness: 0.3, metal: 1 } }
              ]
            }
          }
        ]
      )
    }
  }
  prototype "shape-weathering-lines" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "WEAR LINES",
        extra: [
          {
            color: "#7A2E2E"
            roughness: 0.5
            weathering {
              lines: 0.6
              floor: 1
              scale: 4
              seed: 9
              under [{ threshold: 0.2, surface { color: "#C0C4C8", roughness: 0.3, metal: 1 } }]
            }
          }
        ]
      )
    }
  }
  prototype "shape-weathering-settle" {
    document {
      shape Torus "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "WEAR SETTLE",
        extra: [
          {
            color: "#3B4A5A"
            roughness: 0.5
            weathering { settle: 1, floor: 1, deposit { color: "#F4F1EA", roughness: 0.95, metal: 0 } }
          }
        ]
      )
    }
  }
  prototype "shape-panel-recess" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        panel {
          inset: 0.06
          depth: 0.03
          material: accentMaterial
        }
        position [0, 1.2, 0]
        scale [0.4, 0.35, 0.12]
      }
      exhibit(label: "PANEL RECESS", extra: [accent])
    }
  }
  prototype "shape-panel-raise" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        panel {
          inset: 0.06
          depth: -0.03
          material: accentMaterial
        }
        position [0, 1.2, 0]
        scale [0.4, 0.35, 0.12]
      }
      exhibit(label: "PANEL RAISE", extra: [accent])
    }
  }
  // The trim band follows the thin slab hidden inside the box, round its equator.
  prototype "shape-trims" {
    document {
      shape Box "band" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.34, 0.004, 0.34]
      }
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.35, 0.35, 0.35]
        trims [
          {
            shape: "band"
            width: 0.03
            material: accentMaterial
          }
        ]
      }
      exhibit(label: "TRIMS", extra: [accent])
    }
  }
  prototype "shape-paint-world" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(
        label: "PAINT WORLD",
        extra: [
          {
            color: "#B9C4D0"
            roughness: 0.45
            specular: 0.3
            paints [
              {
                type: "Plane"
                position [paintX, paintY, surfaceZ]
                rotation [0, 0, 0.258819, 0.965926]
                stroke: 0.035
                color: "#1F4E79"
              }
            ]
          }
        ]
      )
    }
  }
  prototype "shape-text-engrave" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.25, 0.08]
      }
      exhibit(
        label: "TEXT ENGRAVE",
        extra: [accent],
        runs: [
          {
            text: "ENGRAVED"
            position [0, 1.2, 0.08]
            rotation [0, 0, 0, 1]
            emHeight: 0.13
            depth: 0.012
            mode: "engrave"
            material: accentMaterial
            align: "center"
          }
        ]
      )
    }
  }
  prototype "shape-text-ride" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [0, 0, 0.173648, 0.984808]
        scale [0.45, 0.3, 0.05]
      }
      exhibit(
        label: "TEXT ON SHAPE",
        extra: [accent],
        runs: [
          {
            text: "TEXT RIDES A SHAPE"
            shapeId: 0
            position [0, 0, 1]
            rotation [0, 0, 0, 1]
            emHeight: 0.08
            depth: 0.004
            maxWidth: 0.7
            tracking: 0.05
            lineSpacing: 1.2
            material: accentMaterial
            align: "center"
          }
        ]
      )
    }
  }
  // A flow runs from its box's +Y face toward -Y; the half-turn about X puts the mouth on the nozzle and the plume above.
  prototype "shape-volume-flow" {
    document {
      shape Cylinder "nozzle" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        scale [0.07, 0.15, 0.07]
      }
      volumes [
        {
          kind: "flow"
          position [0, 1.35, 0]
          rotation [1, 0, 0, 0]
          halfExtent [0.2, 0.4, 0.2]
          axis: 0.8
          width: 0.06
          spread: 3
          fade: 1.2
          noiseScale: 0.06
          noiseDepth: 0.5
          speed: 1.2
          seed: 7
          steps: 40
          intensity: 3000
          pulseAmplitude: 0.2
          pulseFrequency: 3
          ramp [
            {
              density: 0
              color: "#7A1F0B"
            }
            {
              density: 0.4
              color: "#E2571E"
            }
            {
              density: 1
              color: "#FFE9A8"
            }
          ]
        }
      ]
      exhibit(label: "VOLUME FLOW")
    }
  }
  prototype "shape-volume-cloud" {
    document {
      volumes [
        {
          kind: "cloud"
          position [0, 1.25, 0]
          rotation [0, 0, 0, 1]
          halfExtent [0.45, 0.3, 0.45]
          width: 0.2
          extinction: 4
          coverage: 0.6
          softness: 0.25
          ramp [
            {
              density: 0
              color: "#FFFFFF"
            }
            {
              density: 1
              color: "#C8D2DC"
            }
          ]
        }
      ]
      exhibit(label: "VOLUME CLOUD")
    }
  }
  prototype "shape-state-color" {
    document {
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.45, 0.45, 0.45]
      }
      exhibit(label: "STATE COLOR", extra: [{ color: "state.galleryInputs.tint", roughness: 0.45, specular: 0.3 }])
    }
  }
  // Glass: slot 4 an orange acrylic whose colour is reached 12 cm in, so the box holding the sphere reads clear orange
  // and deepest through its middle; slot 5 one window glass twice, as an 8 mm pane and a 6 cm block, which the same
  // depth tints faintly and deeply; slot 6 a frosted pane. Glass slots bake and draw apart from the opaque shapes: the
  // sphere and rods are ordinary shapes seen through them, shifted by the refraction and blurred by the frost.
  prototype "shape-glass" {
    document {
      shape Sphere "core" {
        material: accentMaterial
        position [-0.38, 1.2, 0]
        scale [0.1, 0.1, 0.1]
      }
      shape Cylinder "rod" {
        material: accentMaterial
        position [0.2, 1.2, 0.14]
        scale [0.015, 0.3, 0.015]
      }
      shape Cylinder "frost-rod" {
        material: accentMaterial
        position [0.46, 1.2, 0.1]
        scale [0.015, 0.3, 0.015]
      }
      shape Box "shell" {
        material: 4
        position [-0.38, 1.2, 0]
        scale [0.18, 0.18, 0.18]
      }
      shape Box "thin" {
        material: 5
        position [-0.05, 1.2, 0]
        scale [0.1, 0.22, 0.004]
      }
      shape Box "thick" {
        material: 5
        position [0.2, 1.2, 0]
        scale [0.08, 0.22, 0.03]
      }
      shape Box "frost" {
        material: 6
        position [0.46, 1.2, 0]
        scale [0.1, 0.22, 0.004]
      }
      exhibit(
        label: "GLASS",
        extra: [
          accent
          { color: "#F58220", roughness: 0.05, glass { depth: 0.12, ior: 1.49 } }
          { color: "#C8F0DC", roughness: 0, glass { depth: 0.01, ior: 1.5 } }
          { color: "#F0F0F0", roughness: 0.7, glass { depth: 0.01, ior: 1.5 } }
        ],
        note: "Orange box holds a sphere; one window glass thin and thick; a frosted pane. Depth deepens tint, panes shift the rods."
      )
    }
  }
}

// Motion through the stamp pool: every prototype here carries a driver (or frames, or an effector), so its placement
// replays through the dynamic stamp path rather than stamping statically. Blends between shapes ride only inside a
// nonzero `group` there; an ungrouped shape unions.
template motionPrototypes() {
  prototype "motion-spin" {
    document {
      clockDriver(key: "spin", cadence: 0.8, ease: 0)
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.4, 0.15, 0.25]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 1
            pivot [0, 1.2, 0]
            wave: "linear"
          }
        ]
      }
      exhibit(
        label: "SPIN",
        extra: [
          {
            color: "#7A2E2E"
            roughness: 0.5
            weathering {
              lines: 0.6
              floor: 1
              scale: 4
              seed: 9
              under [{ threshold: 0.2, surface { color: "#C0C4C8", roughness: 0.3, metal: 1 } }]
            }
          }
        ]
      )
    }
  }
  prototype "motion-rock" {
    document {
      clockDriver(key: "rock", cadence: 2)
      shape Sphere "hook" {
        material: exhibitMaterial
        position [0, 1.65, 0]
        scale [0.05, 0.05, 0.05]
      }
      shape Cylinder "subject" {
        material: exhibitMaterial
        position [0, 1.375, 0]
        scale [0.025, 0.225, 0.025]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.6
            pivot [0, 1.65, 0]
          }
        ]
      }
      shape Sphere "bob" {
        material: accentMaterial
        parent: "subject"
        position [0, 1.05, 0]
        scale [0.12, 0.12, 0.12]
      }
      exhibit(label: "ROCK", extra: [accent])
    }
  }
  prototype "motion-slide" {
    document {
      clockDriver(key: "slide", cadence: 1.5)
      shape Sphere "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.22, 0.22, 0.22]
        slides [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.35
          }
        ]
      }
      exhibit(label: "SLIDE", extra: [accent])
    }
  }
  prototype "motion-chain" {
    document {
      clockDriver(key: "chain", cadence: 1.6)
      shape Box "upper" {
        material: exhibitMaterial
        position [0, 1.45, 0]
        scale [0.05, 0.2, 0.05]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.5
            pivot [0, 1.65, 0]
          }
        ]
      }
      shape Box "lower" {
        material: exhibitMaterial
        parent: "upper"
        position [0, 1.07, 0]
        scale [0.04, 0.18, 0.04]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.8
            phase: 1.2
            pivot [0, 1.25, 0]
            wave: "halfSine"
          }
        ]
      }
      shape Sphere "bob" {
        material: accentMaterial
        parent: "lower"
        position [0, 0.85, 0]
        scale [0.07, 0.07, 0.07]
      }
      exhibit(label: "PARENT CHAIN", extra: [accent])
    }
  }
  // The sphere slides along the side of the still box, through a smooth union. The group bakes at the pose its program
  // arrived in and skins each vertex to its winning shape's slot, so the seam stretches as the sphere moves away, until
  // the clock pauses and the group bakes again at the held pose (PUCK122 warns of it). The sphere stays partly outside
  // the box over the whole slide: a sphere the bake found inside the box would bake into no surface and never draw.
  prototype "motion-smooth-blend" {
    document {
      clockDriver(key: "blend", cadence: 1.2)
      shape Box "anchor" {
        group: 1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "visitor" {
        blend: SmoothUnion
        group: 1
        material: accentMaterial
        position [0.35, 1.2, 0]
        scale [0.18, 0.18, 0.18]
        smooth: 0.15
        slides [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.15
          }
        ]
      }
      exhibit(label: "MOVING BLEND", extra: [accent])
    }
  }
  // The same pair stamped statically, its sphere placed by the galleryInputs probe cell: each write re-emits the creation
  // and rebakes the seam exactly, where motion-smooth-blend skins one baked seam.
  prototype "motion-state-blend" {
    document {
      shape Box "anchor" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.25, 0.25, 0.25]
      }
      shape Sphere "visitor" {
        blend: SmoothUnion
        material: accentMaterial
        position: "state.galleryInputs.probe"
        scale [0.18, 0.18, 0.18]
        smooth: 0.15
      }
      exhibit(label: "STATE BLEND", extra: [accent])
    }
  }
  // A cutter sliding across the face of a still box: a cut face keeps the slot of the shape it shapes.
  prototype "motion-carve" {
    document {
      clockDriver(key: "carve", cadence: 1.2)
      shape Box "block" {
        group: 1
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.3, 0.3, 0.3]
      }
      shape Sphere "cutter" {
        blend: Subtraction
        group: 1
        material: accentMaterial
        position [0, 1.25, 0.3]
        scale [0.2, 0.2, 0.2]
        slides [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.3
          }
        ]
      }
      exhibit(label: "MOVING CUT", extra: [accent])
    }
  }
  // A folded shape may not swing, but it rides its parent: the symmetry plane yaws with the hinge.
  prototype "motion-mirror" {
    document {
      clockDriver(key: "mirror", cadence: 1.4)
      shape Box "hinge" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.06, 0.06, 0.06]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.7
            pivot [0, 1.2, 0]
          }
        ]
      }
      shape Capsule "wing" {
        domain [
          symmetry(normal: [1, 0, 0])
        ]
        material: accentMaterial
        parent: "hinge"
        position [0.28, 1.25, 0]
        rotation [0, 0, 0.5, 0.866025]
        scale [0.06, 0.16, 0.06]
      }
      exhibit(label: "MOVING MIRROR", extra: [accent])
    }
  }
  // The hub spins about Z through its centre, and the polar-folded blade rides it: one shape, eight spinning copies.
  prototype "motion-polar" {
    document {
      clockDriver(key: "polar", cadence: 0.9, ease: 0)
      shape Cylinder "hub" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation [0.707107, 0, 0, 0.707107]
        scale [0.08, 0.05, 0.08]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 1
            pivot [0, 1.2, 0]
            wave: "linear"
          }
        ]
      }
      shape Box "blade" {
        domain [
          polar(count: 8, axis: Z, origin: [0, 1.2, 0])
        ]
        material: accentMaterial
        parent: "hub"
        position [0, 1.45, 0]
        scale [0.035, 0.14, 0.02]
      }
      exhibit(label: "MOVING POLAR", extra: [accent])
    }
  }
}

template motionPrototypesB() {
  // Parented paints ride their shape's own slot: a stroked plane stripe, a stroked ellipse ring, a filled pentagon and
  // a swept line, each in the panel's local frame.
  prototype "motion-paint" {
    document {
      clockDriver(key: "paint", cadence: 1.2)
      shape Box "panel" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.35, 0.3, 0.1]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.6
            pivot [0, 1.2, 0]
          }
        ]
      }
      exhibit(
        label: "MOVING PAINT",
        extra: [
          {
            color: "#E8E4DA"
            roughness: 0.5
            paints [
              { parent: "panel", type: "Plane", position [0, 0.16, 0], stroke: 0.025, color: "#E4572E" }
              {
                parent: "panel"
                type: "Prism"
                position [0.15, -0.08, 0]
                scale [0.09, 0.09, 0.2]
                profile { kind: "Ellipse" }
                stroke: 0.012
                color: "#1F4E79"
              }
              {
                parent: "panel"
                type: "Prism"
                position [-0.17, -0.1, 0]
                scale [0.08, 0.08, 0.2]
                profile { kind: "Polygon", sides: 5 }
                color: "#3FA34D"
              }
              {
                parent: "panel"
                type: "Sweep"
                curve {
                  a [-0.25, -0.22, 0.1]
                  b [0, -0.12, 0.1]
                  c [0.25, -0.22, 0.1]
                  radiusStart: 0.012
                  radiusEnd: 0.012
                }
                color: "#171210"
              }
            ]
          }
        ]
      )
    }
  }
  // An eye: a radial ramp of pupil, iris, limbus and sclera on a plane under a clear cornea, in the winning slot's
  // frame. The eye's hits win its own slot, centred on the eye, so the plane sits a radius in front of that centre, and
  // the half-turn about Y faces it toward the label side. The iris turns with the eye.
  prototype "motion-inset" {
    document {
      clockDriver(key: "inset", cadence: 0.9)
      shape Sphere "eye" {
        material: accentMaterial
        position [0, 1.25, 0]
        scale [0.25, 0.25, 0.25]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0, 1.25, 0]
          }
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.2
            phase: 1.5708
            pivot [0, 1.25, 0]
          }
        ]
      }
      exhibit(
        label: "MOVING INSET",
        extra: [
          {
            color: "#FFFFFF"
            roughness: 0.1
            specular: 0.4
            coat: 0.6
            inset {
              origin [0, 0, -0.25]
              rotation [0, 1, 0, 0]
              depth: 0.05
              ior: 1.336
              paint {
                stops [
                  { radius: 0.03, color: "#0B0B0B" }
                  { radius: 0.075, color: "#3A7BD5" }
                  { radius: 0.085, color: "#1A2A40" }
                  { radius: 0.095, color: "#F5F3EE" }
                ]
                softness: 0.15
                modulationAmplitude: 0.04
                modulationFrequency: 40
              }
            }
          }
        ]
      )
    }
  }
  // Twist and bend emit only on the stamp-pool path; a static placement ignores both. The twist's constant-wave swing is
  // a pose the driver's weight blends in: a lean that eases in and out with the exhibit's gate.
  prototype "motion-twist" {
    document {
      clockDriver(key: "twist", cadence: 0.8)
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.15, 0.4, 0.15]
        twist: 1.5
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0, 1.2, 0]
          }
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.25
            pivot [0, 0.8, 0]
            wave: "constant"
          }
        ]
      }
      exhibit(label: "TWIST", extra: [accent])
    }
  }
  prototype "motion-bend" {
    document {
      clockDriver(key: "bend", cadence: 0.8)
      shape Box "subject" {
        bend: 1.2
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.08, 0.4, 0.08]
        swings [
          {
            driver: "clock"
            axis [0, 1, 0]
            amplitude: 0.5
            pivot [0, 1.2, 0]
          }
        ]
      }
      exhibit(label: "BEND", extra: [accent])
    }
  }
  // A dynamic slot carries a rigid pose and no scale, so a pulse is six petals sliding out from a core and back, all
  // smooth-unioned in one group.
  prototype "motion-pulse" {
    document {
      clockDriver(key: "pulse", cadence: 2.5)
      shape Sphere "core" {
        group: 1
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.12, 0.12, 0.12]
      }
      for petal in pulsePetals {
        shape Sphere $"{petal.name}" {
          blend: SmoothUnion
          group: 1
          material: accentMaterial
          position: petal.at
          scale [0.09, 0.09, 0.09]
          smooth: 0.06
          slides [
            {
              driver: "clock"
              axis: petal.out
              amplitude: 0.1
            }
          ]
        }
      }
      exhibit(label: "RADIAL PULSE", extra: [accent])
    }
  }
  prototype "motion-cells" {
    document {
      clockDriver(key: "cells", cadence: 1)
      shape Sphere "subject" {
        cells {
          amplitude: 0.12
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.35, 0.35, 0.35]
        swings [
          {
            driver: "clock"
            axis [1, 0, 0]
            amplitude: 0.5
            pivot [0, 1.2, 0]
          }
        ]
      }
      exhibit(label: "MOVING CELLS", extra: [accent])
    }
  }
  // The plume rides the nozzle's slot, so it tilts with the swing.
  prototype "motion-volume" {
    document {
      clockDriver(key: "volume", cadence: 1.2)
      shape Cylinder "nozzle" {
        material: exhibitMaterial
        position [0, 0.8, 0]
        scale [0.07, 0.15, 0.07]
        swings [
          {
            driver: "clock"
            axis [0, 0, 1]
            amplitude: 0.4
            pivot [0, 0.65, 0]
          }
        ]
      }
      volumes [
        {
          kind: "flow"
          parent: "nozzle"
          position [0, 0.55, 0]
          rotation [1, 0, 0, 0]
          halfExtent [0.2, 0.4, 0.2]
          axis: 0.8
          width: 0.06
          spread: 3
          fade: 1.2
          noiseScale: 0.06
          noiseDepth: 0.5
          speed: 1.2
          seed: 7
          steps: 40
          intensity: 3000
          ramp [
            {
              density: 0
              color: "#0B3A7A"
            }
            {
              density: 0.4
              color: "#1E8FE2"
            }
            {
              density: 1
              color: "#D8F4FF"
            }
          ]
        }
      ]
      exhibit(label: "MOVING VOLUME")
    }
  }
  // A two-bone arm solving toward the world point the galleryInputs reach cell holds.
  prototype "motion-ik" {
    document {
      shape Cylinder "base" {
        material: exhibitMaterial
        position [0, 0.95, 0]
        scale [0.07, 0.05, 0.07]
      }
      shape Cylinder "upper" {
        joint [0, 1.0, 0]
        material: exhibitMaterial
        position [0, 1.2, 0]
        scale [0.035, 0.2, 0.035]
      }
      shape Cylinder "lower" {
        joint [0, 1.4, 0]
        material: exhibitMaterial
        parent: "upper"
        position [0, 1.58, 0]
        scale [0.03, 0.18, 0.03]
      }
      shape Sphere "hand" {
        material: accentMaterial
        parent: "lower"
        position [0, 1.76, 0]
        scale [0.06, 0.06, 0.06]
      }
      effectors [
        {
          name: "reach"
          chain [
            "upper"
            "lower"
          ]
          tip: "hand"
          when [
            "state.galleryMotion.all"
            "state.galleryMotion.ik"
          ]
          target {
            kind: "state"
            reference: "state.galleryInputs.reach"
          }
        }
      ]
      exhibit(label: "IK REACH", extra: [accent])
    }
  }
  // A hold-style timeline: the stamp pool steps an animated row's frames on the render clock, eight 60 Hz frames
  // each, whatever the gallery clock reads.
  prototype "motion-frames" {
    document {
      shape Box "subject" {
        material: accentMaterial
        position [0, 1.2, 0]
        scale [0.15, 0.15, 0.15]
      }
      frames [
        {
          name: "left"
          transforms [
            {
              id: 0
              position [-0.25, 1.2, 0]
              rotation [0, 0, 0, 1]
            }
          ]
        }
        {
          name: "up"
          transforms [
            {
              id: 0
              position [0, 1.45, 0]
              rotation [0, 0, 0.382683, 0.92388]
            }
          ]
        }
        {
          name: "right"
          transforms [
            {
              id: 0
              position [0.25, 1.2, 0]
              rotation [0, 0, 0, 1]
            }
          ]
        }
        {
          name: "down"
          transforms [
            {
              id: 0
              position [0, 0.95, 0]
              rotation [0, 0.382683, 0, 0.92388]
            }
          ]
        }
      ]
      exhibit(label: "FRAMES", extra: [accent])
    }
  }
}

