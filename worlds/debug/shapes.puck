  prototype "shape-shear" {
    document {
      shape Box "subject" {
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.2, 0.5, 0.2]
        shear {
          linear: 0.3
          quadratic: 0.6
          target: 0
          driver: 1
        }
      }
      exhibit(
        label: "SHEAR"
      )
    }
