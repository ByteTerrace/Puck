// The shape gallery: every authorable signed-distance construct, one prototype an exhibit, shown on interactive display
// stations. A display is a large display plinth whose turntable shows one exhibit at a time, at first one of its own
// group (primitives, stretched, extruded, revolved, and so on); its console is one interactive screen listing every
// exhibit in the catalog, and a tap on one shows it on the turntable, with its name and what it shows beside the list.
// The debug world expands `galleryPrototypes()` inside its `prototypes` block,
// `galleryPlacements()` inside its `placements` block and `galleryState()` (the displays' selections and screens and
// the motion exhibits' console controls) inside its `state.world` block. The displays stand inside the gallery
// (gallery/gallery.puck), where its plan puts them (gallery/layout.puck, gallery.md):
//
//   level 0  shape and surface, in six pairs from the west: glass and warps II under the bridge, cel styles with palette
//            channels and wear,
//            sweeps and facets with parameter forms, primitives at a uniform scale and extruded profiles, stretched
//            primitives and revolved profiles, every shape blend and the domain folds
//   level 1  open: its balconies hold no displays yet
//   level 2  motion: the stamp pool's rotation, swings, slides, moving blends, paints, IK and frames; the
//            board game room fills its south gallery (gallery.md)
//   level 3  open: its galleries hold no displays yet
//
// A sign hangs beside each display naming its group, a map board in the lobby by the entrance lists the levels and
// groups, and a board over the lift door names each level. Each display has a spawn point before its console, named
// after its turntable's placement, and each exhibit one at the same place named after it (gallerySpawns says how she
// stands there so the chase camera frames the exhibit); the gallery.* commands (galleryCommands) walk to, show, frame,
// inspect and flag exhibits through them. shapes.md beside this file holds the displays, the coverage table and the
// console controls the motion exhibits answer to. This file is a library: debug.puck and gallery/gallery.puck expand
// its templates and lets, and gallery/gallery.puck holds the displays' rules.
import "gallery/layout"
import "reach"
import "../standard/styles"
import "../standard/rig"
import "../standard/architecture"

let seatPopulation = 4
let visitorPopulation = 8
let galleryPopulation = (41 + seatPopulation + visitorPopulation)
// The board game room's bodies: the granary board's cursor (granaries.puck), Alchemy's cursor and 31
// element tokens (alchemy.puck), Go's cursor and 361 stones (go.puck), then Reversi's cursor and 64 discs
// (reversi.puck), and above them the card table's cursor, 52 cards and held marker (cardtable.puck). debug.puck imports
// the card table first and the others after it, so the cards take the population's very top slots, the granary board
// the highest below them, and every other body keeps the index it held before the cards came.
let granaryBodies = 1
let alchemyBodies = 32
let goBodies = 362
let reversiBodies = 65
let cardBodies = 54
let boardRoomBodies = (granaryBodies + alchemyBodies + goBodies + reversiBodies)
// The launch field's ship (launch.puck) takes the population's highest slot, and debug.puck's capacity is one more.
let launchShipBody = (galleryPopulation + 2 + boardRoomBodies + cardBodies + seatPopulation + 1)
let galleryMapDirections = "stairs and lift beside the entrance: press CALL, or gallery.lift <level>"

let uniformRow = [
  "shape-sphere", "shape-box", "shape-torus", "shape-cylinder", "shape-capsule", "shape-ellipsoid", "shape-round-cone",
  "shape-cone", "shape-superellipsoid", "shape-plane"
]
let stretchedRow = [
  "shape-sphere-xyz", "shape-box-xyz", "shape-torus-xz", "shape-torus-y", "shape-cylinder-xz", "shape-capsule-xz",
  "shape-ellipsoid-xyz", "shape-round-cone-xyz", "shape-cone-xz", "shape-superellipsoid-xyz", "shape-stretch-cut",
  "shape-stretch-smooth"
]
let extrudeRow = [
  "shape-trapezoid", "shape-rounded-rectangle", "shape-polygon-6", "shape-polygon-12", "shape-polygon-12-xy",
  "shape-ellipse", "shape-chamfered-rectangle", "shape-convex", "shape-path-fill", "shape-path-stroke",
  "shape-path-stroke-xy"
]
let revolveRow = [
  "shape-revolve-trapezoid", "shape-revolve-rounded-rectangle", "shape-revolve-polygon-6", "shape-revolve-ellipse",
  "shape-revolve-chamfered-rectangle", "shape-revolve-convex"
]
let facetRow = [
  "shape-sweep", "shape-sweep-tapered", "shape-sweep-strands", "shape-rounding", "shape-chamfer", "shape-onion",
  "shape-dilate", "shape-flare", "shape-shear", "shape-bumps", "shape-cells-f1", "shape-cells-f2", "shape-polar-fold"
]
let foldRow = [
  "shape-symmetry", "shape-repeat", "shape-repeat-grid", "shape-repeat-even", "shape-repeat-clipped",
  "shape-polar-mirror", "shape-polar-z", "shape-polar-stride", "shape-wallpaper-pmm", "shape-wallpaper-p4m",
  "shape-wallpaper-p3m1", "shape-wallpaper-p6m", "shape-wallpaper-stride", "shape-erode", "shape-noise-mask", "shape-noise"
]
let formRow = [
  "shape-superellipsoid-2", "shape-superellipsoid-8", "shape-prism-triangle", "shape-prism-rectangle",
  "shape-polygon-3", "shape-prism-rounding", "shape-prism-chamfer", "shape-cylinder-chamfer", "shape-revolve-solid",
  "shape-path-holes", "shape-path-shear", "shape-path-closed-stroke", "shape-path-stroke-ramp", "shape-sweep-braid"
]
let surfaceRow = [
  "shape-metal", "shape-coat", "shape-sheen", "shape-emissive", "shape-wrap-soften", "shape-fill-bleed",
  "shape-weathering-edge", "shape-weathering-lines", "shape-weathering-settle", "shape-panel-recess",
  "shape-panel-raise", "shape-trims", "shape-paint-world", "shape-text-engrave", "shape-text-ride", "shape-volume-flow",
  "shape-volume-cloud", "shape-state-color"
]
let glassRow = ["shape-glass"]
let styleRow = ["shape-cel", "shape-cel-hard", "shape-grey-card", "shape-paint-tiles"]
let motionRow = [
  "motion-spin", "motion-rock", "motion-slide", "motion-chain", "motion-smooth-blend", "motion-state-blend",
  "motion-carve", "motion-mirror", "motion-polar", "motion-nod", "motion-three"
]
let motionRowB = [
  "motion-paint", "motion-inset", "motion-twist", "motion-bend", "motion-pulse", "motion-cells", "motion-volume",
  "motion-ik", "motion-frames", "motion-seam-paint"
]
let warpRow = [
  "shape-warp", "shape-displace", "shape-elongate", "shape-jitter", "shape-jitter-tumble", "shape-log-sphere",
  "shape-stairs-union", "shape-stairs-subtraction", "shape-morph"
]

let motionLevel = 2
let surfaceLevel = 3

// The levels, in walking order: the board over each lift door names its level and what it shows.
let galleryLevels = [
  { level: 0, title: "LEVEL 0  SHAPE AND SURFACE", what: "glass, warps, styles, surfaces, facets, forms, primitives, profiles, blends, folds" }
  { level: 1, title: "LEVEL 1  BALCONIES", what: "open galleries over the nave" }
  { level: 2, title: "LEVEL 2  MOTION AND GAMES", what: "the stamp pool's motion, the board game room" }
  { level: 3, title: "LEVEL 3  GALLERIES", what: "open galleries over the nave" }
]

// The display stations in walking order, each showing one group of the gallery's exhibits: its id (the key of its state
// cells and the stem of its placements' names), its sign's title and what the group shows, its level, where it stands
// in the building's frame and the yaw its console faces (layout.puck's display lines), and its exhibits in order.
let galleryDisplayRows = [
  {
    id: "primitives", title: "PRIMITIVES", level: 0, names: uniformRow, what: "each primitive at a uniform scale"
    x: bayX(showcaseBays[3]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "stretched", title: "STRETCHED", level: 0, names: stretchedRow, what: "each primitive scaled unevenly"
    x: bayX(showcaseBays[4]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "extruded", title: "EXTRUDED", level: 0, names: extrudeRow, what: "each prism profile, extruded"
    x: bayX(showcaseBays[3]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "revolved", title: "REVOLVED", level: 0, names: revolveRow, what: "each prism profile, revolved"
    x: bayX(showcaseBays[4]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "facets", title: "SWEEPS AND FACETS", level: 0, names: facetRow, what: "sweeps, rounding, shells, warps, relief"
    x: bayX(showcaseBays[2]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "blends", title: "BLENDS", level: 0, names: map(blendExhibits, entry => entry.id), what: "every blend of a box and a sphere"
    x: bayX(showcaseBays[5]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "folds", title: "FOLDS", level: 0, names: foldRow, what: "symmetry, repeats, polar and wallpaper folds"
    x: bayX(showcaseBays[5]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "motion", title: "MOTION", level: motionLevel, names: motionRow, what: "the stamp pool: swings, slides, moving blends"
    x: 20, z: displayNorth, yaw: 0
  }
  {
    id: "motion2", title: "MOTION II", level: motionLevel, names: motionRowB, what: "moving paints, twist, bend, cells, IK"
    x: 34, z: displayNorth, yaw: 0
  }
  {
    id: "warps", title: "WARPS II", level: 0, names: warpRow, what: "domain warp, sine relief, lattices, stairs, morph"
    x: bayX(showcaseBays[0]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "forms", title: "FORMS", level: 0, names: formRow, what: "exponents, tapers, paths, a braid"
    x: bayX(showcaseBays[2]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "surfaces", title: "SURFACES", level: 0, names: surfaceRow, what: "palette channels, wear, panels, text"
    x: bayX(showcaseBays[1]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "styles", title: "STYLES", level: 0, names: styleRow
    what: "a cel style per material, beside continuous ones, the grey card and tiles"
    x: bayX(showcaseBays[1]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "glass", title: "GLASS", level: 0, names: glassRow
    what: "glass over the opaque image: tint, depth, refraction, frost"
    x: bayX(showcaseBays[0]), z: tileZ(showcaseRowSouth), yaw: 180
  }
]
// Every display stands on a floor tile's centre (layout.puck's module), so its pad lies square on the tiles.
let galleryDisplays = map(galleryDisplayRows, display => (display with { x: galleryTileX(display.x), z: galleryTileZ(display.z) }))

// Where each display's list starts in the catalog, and every exhibit in walking order, display by display: its name,
// the display that shows it (its index in galleryDisplays), its place in that display's list (`slot`) and in the
// catalog (`index`). An exhibit's catalog index is its identity: a display's selection cell (`gallerySelect`) holds it.
let galleryDisplayFirsts = map(
  range(0, length(galleryDisplays)),
  i => reduce(map(range(0, i), j => length(galleryDisplays[j].names)), 0, (sum, count) => (sum + count))
)
let galleryCatalog = flatMap(
  range(0, length(galleryDisplays)),
  i => map(galleryDisplays[i].names, (name, slot) => { name: name, display: i, slot: slot, index: (galleryDisplayFirsts[i] + slot) })
)
let galleryLast = (length(galleryCatalog) - 1)

// A display's floor height, and `front`, the sign of z its console faces along (1 at yaw 180, -1 at yaw 0).
function displayFloor(display) = galleryFloor[display.level]
function displayFront(display) = ((display.yaw == 0) ? -1 : 1)
// A point given in the display plinth's own author frame (architecture.puck's: +X to the right of a viewer facing the
// console, +Y up, +Z toward that viewer), placed in the building's frame: the plinth stands at `displayScale`, a yaw-180
// display's author axes are the building's, and a yaw-0 display's turn x and z about.
function displayPoint(display, p) = [
  (display.x + (displayFront(display) * displayScale * p[0])),
  (displayFloor(display) + (displayScale * p[1])),
  (display.z + (displayFront(display) * displayScale * p[2]))
]
// The same point in the world, where the debug world stands the building: a static creation's paints stand there.
function displayWorld(display, p) = galleryWorld(displayPoint(display, p)[0], displayPoint(display, p)[1], displayPoint(display, p)[2])
// The turn that carries a paint's +X along the console's face to the viewer's right, its +Y up the face and its +Z out
// of it, in the world: the plinth's own face turn (`plinthFace`) at yaw 180, and the same turned half round at yaw 0.
function displayFaceTurn(display) = ((display.yaw == 0) ? [0, plinthFace[3], (0 - plinthFace[0]), 0] : plinthFace)
// Where a body stands before the console, in the plinth's author frame: within reach of the screen, 1.25 m clear of
// the console.
let displayStand = [0, 0, 1.75]
// The exhibit on the turntable stands this far over the display's floor (layout.puck's displayExhibitScale): the
// exhibits' own frame puts the plinth's cap at 0.75, and the display's cap stands at plinthCapTop times displayScale.
let displayExhibitDrop = (((plinthCapTop * displayScale) - (0.75 * displayExhibitScale)) + displayExhibitLift)

// Every exhibit's station: its name, its catalog index and slot, and its display's place (the turntable's centre, its
// level and floor height, the yaw it stands at and `front`).
let galleryStations = map(
  galleryCatalog,
  entry => {
    name: entry.name
    index: entry.index
    slot: entry.slot
    display: galleryDisplays[entry.display].id
    level: galleryDisplays[entry.display].level
    x: galleryDisplays[entry.display].x
    y: displayFloor(galleryDisplays[entry.display])
    z: galleryDisplays[entry.display].z
    yaw: galleryDisplays[entry.display].yaw
    front: displayFront(galleryDisplays[entry.display])
  }
)
function galleryStation(name) = filter(galleryStations, station => (station.name == name))[0]
// Where a point an exhibit authors in its own frame stands in the building: its display's turntable, set down by
// displayExhibitDrop, the point scaled by `displayExhibitScale` and turned as the display is.
function exhibitPoint(station, p) = [
  (station.x + (station.front * displayExhibitScale * p[0])),
  (station.y + displayExhibitDrop + (displayExhibitScale * p[1])),
  (station.z + (station.front * displayExhibitScale * p[2]))
]

// A spawn point per display before its console, named after its turntable's placement (`display-<id>`), then one per
// exhibit at its display's, named after the exhibit, so `body.pose spawn:<exhibit>` and `gallery.go <exhibit>` walk to
// any exhibit by name. The display's own comes first, so a verb that takes the spawn point nearest a body
// (`gallery.flag near`) names the display, and a slice of the one at hand (`gallery.slice near`) cuts its turntable.
// She stands turned `gallerySpawnTurn` degrees past facing the display, because the chase camera keeps its place behind
// her: square to it, her body stands between the camera and the console and hides it. Turned, the camera (4 m back
// along her heading, 1.2 m over her pivot) sees the exhibit and the console beside her. The points are authored in the
// building's frame, under its root placement.
let gallerySpawnTurn = 40
function displaySpawn(id, display) = {
  id: id
  parent: gallery
  position: displayPoint(display, displayStand)
  yawDegrees: (((display.yaw + 180) % 360) + gallerySpawnTurn)
}
let gallerySpawns = concat(
  map(galleryDisplays, display => displaySpawn($"display-{display.id}", display)),
  map(galleryCatalog, entry => displaySpawn(entry.name, galleryDisplays[entry.display]))
)

let galleryPentagon = [[0, 1], [0.95, 0.31], [0.59, -0.81], [-0.59, -0.81], [-0.95, 0.31]]
// The hex wallpapers' clip: a clockwise pointy-top hexagon of inradius 0.45 (circumradius 0.45 / cos 30 degrees).
let galleryHexClip = [
  [0, 0.519615]
  [0.45, 0.259808]
  [0.45, -0.259808]
  [0, -0.519615]
  [-0.45, -0.259808]
  [-0.45, 0.259808]
]

// Slot 0 the exhibit, slots 1 and 2 a dark and a pale tone in the gallery's cel look (the signs' board and lettering),
// slot 3 an exhibit's own second material (a blend's tool, a palette channel under test) and slots past it whatever
// else an exhibit appends.
let exhibitMaterial = 0
let accentMaterial = 3
// The gallery's cel look, its walls and signs (galleryCel): the shade a near-neutral step, so a lit room
// still reflects untinted light onto its exhibits and an albedo reads as itself, and a thin cool ink on the building's
// silhouettes and folds, even along its length as a drafted line is. An exhibit's subject (slot 0 of an exhibit's palette, and the slots it adds) keeps its own
// shading: the gallery is the engine's self-test, and its displays' screens say what each subject shows.
let galleryStyle = celStyle with {
  threshold: 0.08
  softness: 0.1
  shadowTint [0.86, 0.84, 0.9]
  specularSize: 0.02
  restore: 0.65
  bleed: 0.2
  form: 0.25
  ink: standardInk with { weight: 0.022, bold: 1.8, tint [0.42, 0.42, 0.48], crease: 0.6, fold: 0.45, uneven: 0 }
}
function galleryCel(base) = celMaterial(base, galleryStyle)
// The primitives that open the gallery each take a material of their own (`exhibit`'s `subject`): a glazed torus, a
// bronze sphere, a gilt cone, so the nave's first exhibits read as a collection and each form by its own surface.
let exhibitSubjects = {
  sphere { color: "#B98A4E", roughness: 0.32, metal: 1 }
  box { color: "#E9DFCB", roughness: 0.7, specular: 0.04 }
  torus { color: "#2F78A8", roughness: 0.12, specular: 0.05, coat: 0.6 }
  cylinder { color: "#C8553A", roughness: 0.4, specular: 0.04 }
  capsule { color: "#5E9E8F", roughness: 0.3, specular: 0.05, coat: 0.4 }
  ellipsoid { color: "#D9A7B0", roughness: 0.45, specular: 0.04 }
  roundCone { color: "#7C6BB0", roughness: 0.35, specular: 0.05 }
  cone { color: "#E2A72E", roughness: 0.3, specular: 0.05, coat: 0.4 }
  superellipsoid { color: "#9FC6DC", roughness: 0.18, specular: 0.05, coat: 0.5 }
}
// The exhibits' own grey is a plain dielectric, so a subject's form reads by its shading and no exhibit is glossier than
// its screen says: an exhibit that shows gloss, metal or a coat authors it in its own slots.
let galleryPalette = [
  { color: "#B9C4D0", roughness: 0.5, specular: 0.04 }
  galleryCel({ color: "#3A3F47", roughness: 0.85 })
  galleryCel({ color: "#F2EEE4", roughness: 0.6 })
]
let accent = { color: "#D9822B", roughness: 0.5, specular: 0.04 }

// An exhibit's document: its palette and any text runs the exhibit itself shows, expanded after the exhibit's own
// shapes. `label` names the creation; the display's screen shows its copy (galleryCopy). `extra` appends palette slots
// from 3 on, and `runs` the exhibit's own lettering.
template exhibit(label, extra = [], runs = [], subject = galleryPalette[0]) {
  name: label
  schema: "puck.creation.v1"
  palette: concat([subject], map(range(1, (length(galleryPalette) - 1)), i => galleryPalette[i]), extra)
  textRuns: runs
}

// Each exhibit's copy, which its display's screen shows while the exhibit stands on the turntable: its name, and what it
// shows and what to look for. The note strip wraps over two lines, so a note of up to about 180 characters reads at its
// full size.
let galleryCopy = {
  "shape-sphere" { title: "SPHERE", note: "The sphere primitive at a uniform scale." }
  "shape-box" { title: "BOX", note: "The box primitive at a uniform scale." }
  "shape-torus" { title: "TORUS", note: "The torus primitive at a uniform scale." }
  "shape-cylinder" { title: "CYLINDER", note: "The cylinder primitive at a uniform scale." }
  "shape-capsule" { title: "CAPSULE", note: "The capsule primitive at a uniform scale." }
  "shape-ellipsoid" { title: "ELLIPSOID", note: "The ellipsoid primitive at a uniform scale." }
  "shape-round-cone" { title: "ROUND CONE", note: "The round cone primitive at a uniform scale." }
  "shape-cone" { title: "CONE", note: "The cone primitive at a uniform scale." }
  "shape-superellipsoid" { title: "SUPERELLIPSOID", note: "A superellipsoid at exponent 4." }
  "shape-plane" { title: "PLANE CUT", note: "A sphere intersected with a tilted plane." }
  "shape-sphere-xyz" { title: "SPHERE XYZ", note: "A sphere scaled unevenly on all three axes." }
  "shape-box-xyz" { title: "BOX XYZ", note: "A box scaled unevenly on all three axes." }
  "shape-torus-xz" { title: "TORUS XZ", note: "A torus with X and Z scaled differently." }
  "shape-torus-y" { title: "TORUS Y", note: "A torus with Y alone stretched." }
  "shape-cylinder-xz" { title: "CYLINDER XZ", note: "A cylinder with X and Z scaled differently." }
  "shape-capsule-xz" { title: "CAPSULE XZ", note: "A capsule with X and Z scaled differently." }
  "shape-ellipsoid-xyz" { title: "ELLIPSOID XYZ", note: "An ellipsoid scaled unevenly." }
  "shape-round-cone-xyz" { title: "ROUND CONE XYZ", note: "A round cone scaled unevenly." }
  "shape-cone-xz" { title: "CONE XZ", note: "A cone with X and Z scaled differently." }
  "shape-superellipsoid-xyz" { title: "SUPER XYZ", note: "A stretched capsule, cone and torus cut from a slab: each rim sharp, each wall smooth." }
  "shape-stretch-cut" { title: "STRETCH CUT", note: "A stretched capsule, cone and torus cut from a slab: each rim sharp, each wall smooth." }
  "shape-stretch-smooth" { title: "STRETCH SMOOTH", note: "The same three cut smoothly at 0.04 m: each rim's fillet one width all the way round." }
  "shape-trapezoid" { title: "TRAPEZOID", note: "A trapezoid profile, extruded." }
  "shape-rounded-rectangle" { title: "ROUNDED RECT", note: "A rounded rectangle profile, extruded." }
  "shape-polygon-6" { title: "POLYGON 6", note: "A hexagon profile, extruded." }
  "shape-polygon-12" { title: "POLYGON 12", note: "A twelve-sided polygon profile, extruded." }
  "shape-polygon-12-xy" { title: "POLYGON 12 XY", note: "The twelve-gon extruded with X and Y unequal." }
  "shape-ellipse" { title: "ELLIPSE", note: "An ellipse profile, extruded." }
  "shape-chamfered-rectangle" { title: "CHAMFER RECT", note: "A chamfered rectangle profile, extruded." }
  "shape-convex" { title: "CONVEX", note: "A convex pentagon profile, extruded." }
  "shape-path-fill" { title: "PATH FILL", note: "A filled path of lines and curves, extruded." }
  "shape-path-stroke" { title: "PATH STROKE", note: "An open stroked path, extruded." }
  "shape-path-stroke-xy" { title: "PATH STROKE XY", note: "The stroked path extruded with X and Y unequal." }
  "shape-revolve-trapezoid" { title: "REV TRAPEZOID", note: "A trapezoid profile revolved into a ring." }
  "shape-revolve-rounded-rectangle" { title: "REV ROUND RECT", note: "A rounded rectangle revolved into a ring." }
  "shape-revolve-polygon-6" { title: "REV POLYGON 6", note: "A hexagon revolved into a ring." }
  "shape-revolve-ellipse" { title: "REV ELLIPSE", note: "An ellipse revolved into a ring." }
  "shape-revolve-chamfered-rectangle" { title: "REV CHAMFER", note: "A chamfered rectangle revolved into a ring." }
  "shape-revolve-convex" { title: "REV CONVEX", note: "A convex pentagon revolved into a ring." }
  "shape-sweep" { title: "SWEEP", note: "A tube of one radius along a quadratic curve: the exact closed-form nearest point. a uniform round cable." }
  "shape-sweep-tapered" { title: "SWEEP TAPER", note: "The radius tapers 0.14 to 0.04 with a mid-span bulge; the gap search picks the nearest sphere. no bulge seam, no pinch." }
  "shape-sweep-strands" { title: "SWEEP STRANDS", note: "Three strands orbiting the curve, 1.5 turns of twist: a rope. strands stay apart and evenly spaced." }
  "shape-rounding" { title: "ROUNDING", note: "A cylinder with its edge rounded 0.12 m: a curved rim, the flat top and side intact." }
  "shape-chamfer" { title: "CHAMFER", note: "A box with 0.1 m 45 degree bevels on every edge and corner; flat bevel faces, not a round." }
  "shape-onion" { title: "ONION", note: "A 4 cm shell of a sphere, a window cut to see inside: both skins render, the wall is even." }
  "shape-dilate" { title: "DILATE", note: "A 0.3 box inflated by 0.1: rounded by the inflation, 0.4 across, no creases." }
  "shape-flare" { title: "FLARE", note: "A cylinder whose cross-section scales along y: amount 0.8 and a 0.2 bulge from the top down. the bake cell is coarse here." }
  "shape-shear" { title: "SHEAR", note: "A box whose x slides by 0.3 y + 0.6 y squared: a lean that curves. faces stay flat along z." }
  "shape-bumps" { title: "BUMPS", note: "Two gaussian pushes of the point: a swelling on the upper right, a dent lower left. smooth, no ring." }
  "shape-cells-f1" { title: "CELLS F1", note: "Worley F1 relief, amplitude 0.18: raised cells with creased walls, like chitin." }
  "shape-cells-f2" { title: "CELLS F2 F1", note: "F2 minus F1 relief: ridges along the cell walls, hollows at their centres." }
  "shape-polar-fold" { title: "POLAR FOLD", note: "One box authored at the front, folded into six sectors about y: six blades, one shape. no seam between sectors." }
  "shape-blend-union" { title: "UNION", note: "Min of the two fields: a hard crease where they meet, the sphere's orange winning its own surface." }
  "shape-blend-subtraction" { title: "SUBTRACTION", note: "The sphere carved out of the box: the bowl wears the sphere's colour, the rim stays sharp." }
  "shape-blend-intersection" { title: "INTERSECTION", note: "Only where both overlap: a box with spherical corners, the sphere's colour on its own faces." }
  "shape-blend-xor" { title: "XOR", note: "Either but not both: the overlap is cut away, leaving a void you can see into from the seam." }
  "shape-smooth-union" { title: "SMOOTH UNION", note: "A 0.15 m fillet where sphere meets box; the fillet should be a smooth saddle with no step." }
  "shape-smooth-subtraction" { title: "SMOOTH SUBTRACT", note: "The carve's rim rounded over 0.1 m into the box." }
  "shape-smooth-intersection" { title: "SMOOTH INTERSECT", note: "The intersection's edges rounded over 0.1 m." }
  "shape-chamfer-union" { title: "CHAMFER UNION", note: "A flat 45 degree bevel along the seam, 0.1 m wide, instead of a fillet." }
  "shape-chamfer-subtraction" { title: "CHAMFER SUBTRACT", note: "The carve's rim bevelled at 45 degrees." }
  "shape-chamfer-intersection" { title: "CHAMFER INTERSECT", note: "The intersection's edges bevelled at 45 degrees." }
  "shape-groove-union" { title: "GROOVE UNION", note: "A round groove cut along the seam curve, 0.05 m: a recessed line following the join." }
  "shape-pipe-union" { title: "PIPE UNION", note: "A round bead laid along the seam curve, 0.04 m: a raised weld following the join." }
  "shape-groove-subtraction" { title: "GROOVE SUBTRACT", note: "A groove cut along the carve's rim." }
  "shape-pipe-subtraction" { title: "PIPE SUBTRACT", note: "A bead laid along the carve's rim." }
  "shape-symmetry" { title: "SYMMETRY", note: "One tilted capsule mirrored across x = 0: a V, the pair exactly symmetric." }
  "shape-repeat" { title: "REPEAT 5", note: "One sphere repeated 0.25 m apart, limit 2: five copies, the field exact at each." }
  "shape-repeat-grid" { title: "REPEAT 3X3", note: "One box on a 3 by 3 lattice in x and z." }
  "shape-repeat-even" { title: "REPEAT EVEN", note: "An even count from a symmetry over an odd repeat: four spheres, the middle gap closed." }
  "shape-repeat-clipped" { title: "REPEAT CLIPPED", note: "An unbounded lattice of spheres clipped by a box on the cell walls: a block of whole beads, none cut." }
  "shape-polar-mirror" { title: "POLAR MIRROR", note: "Five sectors, each reflected across its bisector: a kaleidoscope, mirror pairs meeting at the walls." }
  "shape-polar-z" { title: "POLAR Z", note: "Eight copies about z through an origin above the plinth: a wheel facing you." }
  "shape-polar-stride" { title: "POLAR STRIDE", note: "Six sectors, each striding the palette one row: six colours, one sphere." }
  "shape-wallpaper-pmm" { title: "WALLPAPER PMM", note: "A tile mirrored across both cell axes, limit 1: a 3 by 3 field of mirror images." }
  "shape-wallpaper-p4m" { title: "WALLPAPER P4M", note: "Square symmetry with mirrors through the 4-fold centres: eight images per cell." }
  "shape-wallpaper-p3m1" { title: "WALLPAPER P3M1", note: "A hex lattice with mirrors through the corners, clipped by a hexagon on mirror planes: flat cut faces, no creases." }
  "shape-wallpaper-p6m" { title: "WALLPAPER P6M", note: "The richest hex group, twelve images per cell, clipped on its mirror planes: the tiles meet cleanly." }
  "shape-wallpaper-stride" { title: "WALLPAPER STRIDE", note: "P4m with a material stride: cells alternate colour by parity, a checkerboard." }
  "shape-erode" { title: "ERODE", note: "A lane erodes the sphere, here halfway through." }
  "shape-noise-mask" { title: "RELIEF MASK", note: "The bowl stays smooth; the slab around it stays rough." }
  "shape-noise" { title: "NOISE", note: "FBm noise lumps the sphere; the plinth stays clean." }
  "motion-spin" { title: "SPIN", note: "A rigid rotation on a linear wave." }
  "motion-rock" { title: "ROCK", note: "A sine swing about a pivot." }
  "motion-slide" { title: "SLIDE", note: "A translation on the gallery clock." }
  "motion-chain" { title: "PARENT CHAIN", note: "A chain of parented swings." }
  "motion-smooth-blend" { title: "MOVING BLEND", note: "A skinned fillet: the sphere slides 6 cm and the fillet stretches with it, never tearing, stepping or popping." }
  "motion-state-blend" { title: "STATE BLEND", note: "The blend placed by state; each write rebakes." }
  "motion-carve" { title: "MOVING CUT", note: "A smooth cut by a sliding tool: the box bakes again as the cutter moves, so the orange bowl and its soft rim follow it." }
  "motion-mirror" { title: "MOVING MIRROR", note: "A mirrored shape riding a yawing hinge." }
  "motion-polar" { title: "MOVING POLAR", note: "A polar-folded blade spinning on its hub." }
  "motion-nod" { title: "NODDING BLEND", note: "A head nods on its neck: the throat fillet bends with the nod, no crack, spike or fold at either extreme." }
  "motion-three" { title: "THREE OWNERS", note: "Three moving owners meet: the bake splits them into rigid parts, so expect creases where they join, never tears." }
  "motion-paint" { title: "MOVING PAINT", note: "Paints riding a swinging panel." }
  "motion-inset" { title: "MOVING INSET", note: "An eye inset that turns with its shape." }
  "motion-twist" { title: "TWIST", note: "A twist, drawn on the stamp-pool path." }
  "motion-bend" { title: "BEND", note: "A bend, drawn on the stamp-pool path." }
  "motion-pulse" { title: "RADIAL PULSE", note: "Six petals sliding out from a core and back." }
  "motion-cells" { title: "MOVING CELLS", note: "Cells relief on a swinging shape." }
  "motion-volume" { title: "MOVING VOLUME", note: "A plume riding a tilting nozzle." }
  "motion-ik" { title: "IK REACH", note: "A two-bone arm reaching for a state point." }
  "motion-frames" { title: "FRAMES", note: "Timeline frames stepped on the render clock." }
  "motion-seam-paint" { title: "PAINT ACROSS A SEAM", note: "Expected to fail until step 4: the stripe holds on box and sphere but slides across the fillet as the sphere moves." }
  "shape-warp" { title: "DOMAIN WARP", note: "A sphere whose point is warped by sines of the next axis: a smooth wobble, not relief. normals stay smooth, no creases." }
  "shape-displace" { title: "SINE RELIEF", note: "A box with a sine product added to its field: real relief that shadows itself. look for even dimples on every face." }
  "shape-elongate" { title: "ELONGATE", note: "A sphere swept over a box of half-extents: an exact rounded slab. the field stays a distance everywhere." }
  "shape-jitter" { title: "JITTER", note: "A repeat whose every cell moves and recolours its sphere by a hash. no two cells alike, none crossing a cell wall." }
  "shape-jitter-tumble" { title: "JITTER TUMBLE", note: "Boxes tumbled by a hashed rotation on a blue-noise lattice. every box a different tilt, the pattern de-clumped." }
  "shape-log-sphere" { title: "LOG SPHERE", note: "Self-similar shells about the centre: each copy half the last and turned 0.6 rad. a spiral of shrinking spheres inward." }
  "shape-stairs-union" { title: "STAIRS UNION", note: "A union whose seam climbs four steps over its 0.2 m radius: a staircase around the join, not a fillet." }
  "shape-stairs-subtraction" { title: "STAIRS SUBTRACT", note: "A carve whose rim steps three times over 0.15 m: terraces into the cut." }
  "shape-morph" { title: "MORPH", note: "The box's and the sphere's fields averaged: lane 0 reads 0, halfway. a soft cube, neither shape's edge." }
  "shape-superellipsoid-2" { title: "SUPER EXP 2", note: "A superellipsoid at exponent 2." }
  "shape-superellipsoid-8" { title: "SUPER EXP 8", note: "A superellipsoid at exponent 8, nearly a box." }
  "shape-prism-triangle" { title: "TAPER 0", note: "A prism at taper 0." }
  "shape-prism-rectangle" { title: "TAPER 1", note: "A prism at taper 1." }
  "shape-polygon-3" { title: "POLYGON 3", note: "A triangle profile, extruded." }
  "shape-prism-rounding" { title: "PRISM ROUNDING", note: "An extruded prism with rounded edges." }
  "shape-prism-chamfer" { title: "PRISM CHAMFER", note: "An extruded prism with chamfered edges." }
  "shape-cylinder-chamfer" { title: "CYLINDER CHAMFER", note: "A cylinder with chamfered rims." }
  "shape-revolve-solid" { title: "REV SOLID", note: "A profile revolved at offset 0: a solid." }
  "shape-path-holes" { title: "PATH HOLES", note: "An even-odd fill: a cubic edge, a round hole." }
  "shape-path-shear" { title: "PATH SHEAR", note: "An extruded path, sheared." }
  "shape-path-closed-stroke" { title: "PATH CLOSED", note: "A closed cubic stroke." }
  "shape-path-stroke-ramp" { title: "PATH RAMP", note: "A stroke whose radius ramps along an arc." }
  "shape-sweep-braid" { title: "SWEEP BRAID", note: "Four strands braided along a sweep." }
  "shape-metal" { title: "METAL", note: "The palette's metal channel." }
  "shape-coat" { title: "COAT", note: "A clear coat over the base colour." }
  "shape-sheen" { title: "SHEEN", note: "The sheen channel: a soft rim like cloth." }
  "shape-emissive" { title: "EMISSIVE", note: "An emissive surface, lit from within." }
  "shape-wrap-soften" { title: "WRAP SOFTEN", note: "Wrap and soften on cells relief." }
  "shape-fill-bleed" { title: "FILL BLEED", note: "Fill, bleed and receive between palette slots." }
  "shape-weathering-edge" { title: "WEAR EDGE", note: "Edge weathering in two stages." }
  "shape-weathering-lines" { title: "WEAR LINES", note: "Line weathering across the surface." }
  "shape-weathering-settle" { title: "WEAR SETTLE", note: "Settle weathering: a deposit on the upper faces." }
  "shape-panel-recess" { title: "PANEL RECESS", note: "A recessed panel set into the face." }
  "shape-panel-raise" { title: "PANEL RAISE", note: "A raised panel standing off the face." }
  "shape-trims" { title: "TRIMS", note: "A trim band round the box's equator." }
  "shape-paint-world" { title: "PAINT WORLD", note: "A world-space paint on a static placement." }
  "shape-text-engrave" { title: "TEXT ENGRAVE", note: "Text engraved into the surface." }
  "shape-text-ride" { title: "TEXT ON SHAPE", note: "Text riding a shape, wrapped to a width." }
  "shape-volume-flow" { title: "VOLUME FLOW", note: "A flow volume pulsing from a nozzle." }
  "shape-volume-cloud" { title: "VOLUME CLOUD", note: "A cloud volume." }
  "shape-state-color" { title: "STATE COLOR", note: "A colour bound to state: galleryInputs.tint." }
  "shape-cel" { title: "CEL STYLE", note: "Left: its own cel style, the shadow kept under the band; right: continuous." }
  "shape-cel-hard" { title: "CEL HARD", note: "Left: the band over light and shadow together; right: continuous." }
  "shape-grey-card" { title: "GREY CARD", note: "18% grey reads sRGB 118 where white maps to display white; the wedge steps evenly." }
  "shape-paint-tiles" { title: "PAINT TILES", note: "One box paint repeated on a 30 cm lattice: 1 cm joints, each tile's tone hashed." }
  "shape-glass" { title: "GLASS", note: "Orange box holds a sphere; one window glass thin and thick; a frosted pane. Depth deepens tint, panes shift the rods." }
}

// A display's console is one interactive screen (gallery.md, "Display consoles"): a glass a little proud of the
// plinth's own (architecture.puck's plinth glass) on which the interface glows, laid out in the LCARS manner in the
// kit's palette (consoleLook). An ochre elbow frames the top left and turns into the top bar, whose cap names the
// catalog; PREV and NEXT buttons stack down the left column beside a list of every exhibit in the catalog, the chosen one
// lit amber; a rule closes the list's foot; and the right of the screen tells the chosen exhibit's title, its group and
// place in the catalog, and its note. A tap on a row shows that exhibit on this display's turntable, a drag scrolls the
// list a row for each row the pointer travels, and PREV and NEXT turn it a page (gallery/gallery.puck's console rules).
//
// Every rectangle is in the glass's own coordinates in the plinth's units, `x0..x1` across and `y0..y1` up from its
// centre. Each becomes a paint on the display's screen creation (a static placement draws a paint in the world's frame,
// so each display's paints are placed at its console in the world), and the list and the buttons are also regions of the
// screen placement's pointer surface, the rectangle a seat's pointer maps onto.
let consoleRows = 9
let galleryCount = length(galleryCatalog)
let consoleScrollLast = (galleryCount - consoleRows)
let displayGlassOut = 0.003
let displayGlassFront = (displayGlassOut + plinthGlassDepth)
let consoleColumn = { x0: -0.72, x1: -0.58 }
let consoleBar = { y0: 0.125, y1: 0.165 }
let consoleList = { x0: -0.53, x1: 0.105, y0: -0.145, y1: 0.105 }
let consolePrev = { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: -0.025, y1: 0.05 }
let consoleNext = { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: -0.105, y1: -0.03 }
let consoleDetail = { x0: 0.155, x1: 0.72 }
// The list's row pitch, and the font's line height in ems (Inter's ascent and descent), which set each list text's
// line spacing so its lines fall on the rows the pointer's row read counts.
let consoleRowPitch = ((consoleList.y1 - consoleList.y0) / consoleRows)
let consoleFontLine = 1.21
let consoleNameEm = 0.019
let consoleGroupEm = 0.0125

function consoleMid(rect) = [((rect.x0 + rect.x1) / 2), ((rect.y0 + rect.y1) / 2)]
function consoleHalf(rect) = [((rect.x1 - rect.x0) / 2), ((rect.y1 - rect.y0) / 2)]
// A rectangle as the fractions of the glass a pointer hit reads: x right from the glass's left edge, y down from its
// top edge.
function consoleRegion(id, rect, rows = 1) = {
  id: id
  left: ((rect.x0 + plinthGlassHalf[0]) / (2 * plinthGlassHalf[0]))
  top: ((plinthGlassHalf[1] - rect.y1) / (2 * plinthGlassHalf[1]))
  right: ((rect.x1 + plinthGlassHalf[0]) / (2 * plinthGlassHalf[0]))
  bottom: ((plinthGlassHalf[1] - rect.y0) / (2 * plinthGlassHalf[1]))
  rows: rows
}
// A filled rectangle on a display's glass, its corners rounded by `round`, in the world's frame. Its box reaches
// 8 cm either side of the glass, past any rounding, and only the glass wears its palette slot.
function consoleFill(display, rect, color, round = 0) = {
  type: "Box"
  position: displayWorld(display, plinthOnFace(consoleMid(rect)[0], consoleMid(rect)[1], displayGlassFront))
  rotation: displayFaceTurn(display)
  scale [(displayScale * consoleHalf(rect)[0]), (displayScale * consoleHalf(rect)[1]), 0.08]
  rounding: (displayScale * round)
  color: color
}
// Lettering in a rectangle on a display's glass: `em` in the plinth's units, `spacing` the line spacing, `wrap` breaking
// lines at the box's width and `markup` reading the substituted text's colour tags. A text fits its box.
function consoleText(display, rect, template, ink, em, align, wrap = false, markup = false, spacing = 1) = {
  type: "Box"
  position: displayWorld(display, plinthOnFace(consoleMid(rect)[0], consoleMid(rect)[1], displayGlassFront))
  rotation: displayFaceTurn(display)
  scale [(displayScale * consoleHalf(rect)[0]), (displayScale * consoleHalf(rect)[1]), 0.03]
  color: ink
  text { template: template, emHeight: (displayScale * em), align: align, fit: true, wrap: wrap, markup: markup, lineSpacing: spacing }
}
// The list's lines, one a row: a row's title in its ink, read from a display's row cells (keyed `<display>-<row>`), and
// a row's group.
function consoleNameLine(display, row) = $"[color={{state.galleryRowInk.{display.id}-{row}}}]{{state.galleryRowName.{display.id}-{row}}}[/color]"
function consoleGroupLine(display, row) = $"{{state.galleryRowGroup.{display.id}-{row}}}"
function consoleNameLines(display) = reduce(range(0, consoleRows), "", (text, row) => ((row == 0) ? consoleNameLine(display, row) : $"{text}\n{consoleNameLine(display, row)}"))
function consoleGroupLines(display) = reduce(range(0, consoleRows), "", (text, row) => ((row == 0) ? consoleGroupLine(display, row) : $"{text}\n{consoleGroupLine(display, row)}"))
function consolePaints(display) = [
  // The elbow: the left column's head turning into the top bar, its inner corner a quarter round the field cuts.
  consoleFill(display, { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: 0.06, y1: consoleBar.y1 }, consoleLook.frame, 0.03)
  consoleFill(display, { x0: (consoleColumn.x0 + 0.03), x1: 0.3, y0: consoleBar.y0, y1: consoleBar.y1 }, consoleLook.frame)
  consoleFill(display, { x0: consoleColumn.x1, x1: (consoleColumn.x1 + 0.03), y0: (consoleBar.y0 - 0.03), y1: consoleBar.y0 }, consoleLook.frame)
  consoleFill(display, { x0: consoleColumn.x1, x1: (consoleColumn.x1 + 0.12), y0: (consoleBar.y0 - 0.12), y1: consoleBar.y0 }, consoleLook.field, 0.03)
  // The top bar's cap, which names the catalog, and the left column's buttons and foot.
  consoleFill(display, { x0: 0.33, x1: 0.72, y0: consoleBar.y0, y1: consoleBar.y1 }, consoleLook.frame, 0.02)
  consoleFill(display, consolePrev, consoleLook.cream, 0.012)
  consoleFill(display, consoleNext, consoleLook.teal, 0.012)
  consoleFill(display, { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: -0.165, y1: -0.11 }, consoleLook.terracotta, 0.025)
  // The rule closing the list's foot, and the divider between the list and the chosen exhibit.
  consoleFill(display, { x0: (consoleColumn.x1 + 0.025), x1: 0.72, y0: -0.165, y1: -0.153 }, consoleLook.frame, 0.006)
  consoleFill(display, { x0: 0.125, x1: 0.133, y0: consoleList.y0, y1: consoleList.y1 }, consoleLook.frame, 0.004)
  consoleText(display, { x0: 0.35, x1: 0.70, y0: consoleBar.y0, y1: consoleBar.y1 }, $"SHAPE CATALOG {galleryCount}", consoleLook.ink, 0.02, "right")
  consoleText(display, { x0: (consolePrev.x0 + 0.01), x1: (consolePrev.x1 - 0.01), y0: consolePrev.y0, y1: (consolePrev.y0 + 0.035) }, "PREV", consoleLook.ink, 0.017, "right")
  consoleText(display, { x0: (consoleNext.x0 + 0.01), x1: (consoleNext.x1 - 0.01), y0: consoleNext.y0, y1: (consoleNext.y0 + 0.035) }, "NEXT", consoleLook.ink, 0.017, "right")
  // The list: every row's title in its ink (the chosen one lit), and its group beside it.
  consoleText(
    display,
    { x0: consoleList.x0, x1: -0.095, y0: consoleList.y0, y1: consoleList.y1 },
    consoleNameLines(display),
    consoleLook.dim,
    consoleNameEm,
    "left",
    markup: true,
    spacing: (consoleRowPitch / (consoleNameEm * consoleFontLine))
  )
  consoleText(
    display,
    { x0: -0.09, x1: consoleList.x1, y0: consoleList.y0, y1: consoleList.y1 },
    consoleGroupLines(display),
    consoleLook.quiet,
    consoleGroupEm,
    "right",
    spacing: (consoleRowPitch / (consoleGroupEm * consoleFontLine))
  )
  // The chosen exhibit: its title, its group and place in the catalog, and its note.
  consoleText(display, { x0: consoleDetail.x0, x1: consoleDetail.x1, y0: 0.05, y1: 0.105 }, $"{{state.galleryScreenTitle.{display.id}}}", consoleLook.lit, 0.034, "left")
  consoleText(
    display,
    { x0: consoleDetail.x0, x1: consoleDetail.x1, y0: 0.022, y1: 0.048 },
    $"{{state.galleryScreenGroup.{display.id}}}   {{state.galleryPlace.{display.id}}} / {galleryCount}",
    consoleLook.quiet,
    0.015,
    "left"
  )
  consoleText(display, { x0: consoleDetail.x0, x1: consoleDetail.x1, y0: consoleList.y0, y1: 0.016 }, $"{{state.galleryScreenNote.{display.id}}}", consoleLook.dim, 0.0145, "left", wrap: true)
]
// The pointer surface a display's screen placement carries: the glass's front face, carried from the plinth's author
// frame into the placement's (author x and z point the other way), with the list and the buttons as its regions.
let consolePointer = {
  origin [0, plinthOnFace(0, 0, displayGlassFront)[1], (0 - plinthOnFace(0, 0, displayGlassFront)[2])]
  right [-1, 0, 0]
  up [0, plinthTiltCos, plinthTiltSin]
  halfWidth: plinthGlassHalf[0]
  halfHeight: plinthGlassHalf[1]
  regions [consoleRegion("list", consoleList, consoleRows), consoleRegion("prev", consolePrev), consoleRegion("next", consoleNext)]
}
template displayScreen(display) {
  prototype $"gallery-screen-{display.id}" {
    document {
      name: $"gallery-screen-{display.id}"
      schema: "puck.creation.v1"
      palette [consoleGlass with { paints: consolePaints(display) }]
      shape Box "glass" {
        material: 0
        position: plinthOnFace(0, 0, displayGlassOut)
        rotation: plinthFace
        scale [plinthGlassHalf[0], plinthGlassHalf[1], plinthGlassDepth]
        rounding: 0.01
      }
    }
  }
}

// A section board hanging on two rods from the ceiling over a level's floor, its lower edge 2.6 m up: a display's
// sign, and the board game room's over its doorway (gallery/gallery.puck). Its placement's yaw turns the text's face.
template sectionSign(name, title, what) {
  prototype name {
    document {
      name: name
      schema: "puck.creation.v1"
      palette: galleryPalette
      for x in [-0.75, 0.75] {
        shape Box $"hanger-{x}" {
          material: 1
          position [x, 3.66, 0]
          scale [0.025, 0.54, 0.025]
        }
      }
      shape Box "board" {
        material: 2
        position [0, 2.9, 0]
        scale [1.05, 0.3, 0.04]
      }
      textRuns [
        {
          text: title
          position [0, 2.99, 0.04]
          rotation [0, 0, 0, 1]
          emHeight: 0.14
          depth: 0.004
          mode: "emboss"
          material: 1
          align: "center"
          maxWidth: 2
        }
        {
          text: what
          position [0, 2.75, 0.04]
          rotation [0, 0, 0, 1]
          emHeight: 0.065
          depth: 0.003
          mode: "emboss"
          material: 1
          align: "center"
          maxWidth: 2
        }
      ]
    }
  }
}

// The gallery's boards: the map in the lobby. A display names its group on its own screen.
template signPrototypes() {
  // The map board in the lobby: how to get around, then each level and the rows it holds, in walking order.
  prototype "gallery-map" {
    document {
      name: "gallery-map"
      schema: "puck.creation.v1"
      palette: galleryPalette
      for x in [-0.6, 0.6] {
        shape Box $"hanger-{x}" {
          material: 1
          position [x, 3.5, 0]
          scale [0.03, 0.7, 0.03]
        }
      }
      shape Box "board" {
        material: 2
        position [0, 2.24, 0]
        scale [0.72, 0.66, 0.015]
      }
      textRuns: map(
        concat(
          [
            {
              text: "SHAPE GALLERY"
              position [0, 2.08, 0.015]
              rotation [0, 0, 0, 1]
              emHeight: 0.07
              depth: 0.004
              mode: "emboss"
              material: 1
              align: "center"
            }
          ],
          [
            {
              text: galleryMapDirections
              position [0, 1.98, 0.015]
              rotation [0, 0, 0, 1]
              emHeight: 0.026
              depth: 0.003
              mode: "emboss"
              material: 1
              align: "center"
              maxWidth: 1.36
            }
          ],
          map(
            galleryLevels,
            (level, index) => {
              text: level.title
              position [0, (1.84 - (0.19 * index)), 0.015]
              rotation [0, 0, 0, 1]
              emHeight: 0.05
              depth: 0.003
              mode: "emboss"
              material: 1
              align: "center"
            }
          ),
          map(
            galleryLevels,
            (level, index) => {
              text: reduce(
                filter(galleryDisplays, display => (display.level == level.level)),
                "",
                (text, display) => ((text == "") ? display.title : $"{text}, {display.title}")
              )
              position [0, (1.775 - (0.19 * index)), 0.015]
              rotation [0, 0, 0, 1]
              emHeight: 0.03
              depth: 0.003
              mode: "emboss"
              material: 1
              align: "center"
              maxWidth: 1.36
            }
          ),
          [
            {
              text: "Tap a display's console to show any shape   gallery.go <exhibit>   gallery.next"
              position [0, 1.08, 0.015]
              rotation [0, 0, 0, 1]
              emHeight: 0.026
              depth: 0.003
              mode: "emboss"
              material: 1
              align: "center"
              maxWidth: 1.36
            }
          ],
          [
            {
              text: "PAINTINGS east of the door   BOARD GAMES level 2   WONDERLAND west wall"
              position [0, 0.95, 0.015]
              rotation [0, 0, 0, 1]
              emHeight: 0.026
              depth: 0.003
              mode: "emboss"
              material: 1
              align: "center"
              maxWidth: 1.36
            }
          ]
        ),
        run => {
          text: run.text
          position [run.position[0], (run.position[1] + 0.7), run.position[2]]
          rotation: run.rotation
          emHeight: run.emHeight
          depth: run.depth
          mode: run.mode
          material: run.material
          align: run.align
          maxWidth: 1.36
        }
      )
    }
  }
}

// The map hangs in the lobby facing the entrance.
template gallerySignPlacements() {
  placement "gallery-map" {
    prototype: "gallery-map"
    parent: "gallery"
    position [((entranceWest + entranceEast) / 2), galleryFloor[0], 6.8]
  }
}

// The gallery's console commands, composed from existing verbs (docs/reference/commands.md): walk to an exhibit and
// show it on its display, isolate an exhibit's shape, flag one that looks wrong (world.flag writes the record and its
// capture into the package's git-ignored flags folder), cycle the debug views, and slice the exhibit at hand's field
// into the package's slices folder. world.debug-view and world.slice.save exist only in a rendered World, so a headless
// host refuses those two commands when they run.
let galleryCommands = [
  {
    name: "gallery.go"
    help: "Walks a body to an exhibit's display and shows that exhibit on its turntable (its prototype name), or walks it to the entrance (gallery, the default), and returns the view to the chase camera."
    parameters [
      { name: "exhibit", kind: Choice, values: concat(["gallery"], map(galleryCatalog, entry => entry.name)), default: "gallery" }
      { name: "body", kind: Body, default: "0" }
    ]
    lines [
      "body.pose spawn:{exhibit} {body}"
      "world.state.cell.set galleryPick {exhibit} 1"
      "view.override camera auto"
      "view.override layout play"
    ]
  }
  {
    name: "gallery.show"
    help: "Shows an exhibit on its display's turntable (its prototype name) without moving anyone, as stepping its console's list does."
    parameters [
      { name: "exhibit", kind: Choice, values: map(galleryCatalog, entry => entry.name) }
    ]
    lines [
      "world.state.cell.set galleryPick {exhibit} 1"
    ]
  }
  {
    name: "gallery.isolate"
    help: "Draws one exhibit's named shape alone (its subject by default); gallery.isolate off restores every shape."
    parameters [
      { name: "exhibit", kind: Text }
      { name: "shape", kind: Text, default: "subject" }
    ]
    lines [
      "view.isolate {exhibit} {shape}"
    ]
  }
  {
    name: "gallery.flag"
    help: "Flags an exhibit that looks wrong (near, the default, names the display the seat stands at; its capture shows the exhibit on the turntable): world.flag writes worlds/debug/flags/<exhibit>.json (the note, the seat's pose and camera) and captures the view to <exhibit>.png beside it, for an agent to read back."
    parameters [
      { name: "exhibit", kind: Text, default: "near" }
      { name: "note", kind: Text, default: "looks-wrong" }
    ]
    lines [
      "world.flag {exhibit} {note}"
    ]
  }
  {
    name: "gallery.view"
    help: "Steps every camera to the next debug view (off, depth, normals, raydir, material-id, visibility, motion, sky-cost, ao, shadow, indirect, then off again), or selects one by name."
    parameters [
      {
        name: "view"
        kind: Choice
        values [
          "next", "off", "depth", "normals", "raydir", "material-id", "visibility", "motion", "sky-cost", "ao",
          "shadow", "indirect"
        ]
        default: "next"
      }
    ]
    lines [
      "world.debug-view {view}"
    ]
  }
  {
    name: "gallery.slice"
    help: "Cuts the field of the exhibit on a display's turntable (near, the default, names the display the seat stands at; a turntable is display-<id>) on a plane through its placement and writes the distance diagnostic to worlds/debug/slices/<display>-<axis>.png: by default the level plane through the exhibit's middle, the offset in metres over the turntable's placement; an x or z cut wants offset 0 to pass through its centre."
    parameters [
      { name: "exhibit", kind: Text, default: "near" }
      { name: "axis", kind: Choice, values ["y", "x", "z"], default: "y" }
      { name: "offset", kind: Number, default: $"{1.2 * displayExhibitScale}" }
    ]
    lines [
      "world.slice.save {exhibit} {axis} offset {offset}"
    ]
  }
]

// The exhibits' signs and the lobby's map, which a world places beside the gallery module (debug.puck,
// gallery-root.puck); the displays themselves are the module's (displayPlacements).
template galleryPlacements() {
  gallerySignPlacements()
}

// Each display, which gallery/gallery.puck places beside the rules that work it: its plinth, solid, and its screen over
// the console's glass, both at `displayScale`, the screen carrying the console's pointer surface (consolePointer); and
// the exhibit on its turntable, which shows the display's first exhibit and, through its response facet, whichever
// exhibit of the whole catalog the display's `gallerySelect` cell holds, so any display can show any exhibit.
template displayPlacements() {
  for display in galleryDisplays {
    placement $"display-{display.id}-plinth" {
      prototype: "gallery-display"
      parent: "gallery"
      position [display.x, displayFloor(display), display.z]
      yawDegrees: display.yaw
      scale: displayScale
      solid
    }
    placement $"display-{display.id}-screen" {
      prototype: $"gallery-screen-{display.id}"
      parent: "gallery"
      position [display.x, displayFloor(display), display.z]
      yawDegrees: display.yaw
      scale: displayScale
      pointer: consolePointer
    }
  }
  for (display, index) in galleryDisplays {
    placement $"display-{display.id}" {
      prototype: display.names[0]
      parent: "gallery"
      position [display.x, (displayFloor(display) + displayExhibitDrop), display.z]
      yawDegrees: display.yaw
      scale: displayExhibitScale
      respond: map(
        filter(galleryCatalog, entry => (entry.index != galleryDisplayFirsts[index])),
        entry => {
          when: state(state: gallerySelect, key: display.id, comparison: Equal, value: entry.index)
          prototypeId: entry.name
        }
      )
    }
  }
}

// The displays' state, which gallery/gallery.puck declares beside the rules that write it. A display's `gallerySelect`
// cell holds the catalog index of the exhibit its turntable shows, any of the catalog's; its console's list, gallery.go,
// gallery.show, gallery.step and the tour write it, and its screen cells (`galleryScreen*`, `galleryPlace`, its place in
// the catalog from 1) follow it. `galleryTitles`, `galleryNotes` and `galleryGroups` hold every exhibit's copy and its
// display's title by catalog index, which the console rules copy from; `galleryPick` is the mailbox gallery.go and
// gallery.show write an exhibit's name to (`gallery`, the entrance, stands at no display).
//
// A console's list: `galleryScroll` is the catalog index its top row shows, and the row cells (keyed `<display>-<row>`)
// hold each row's catalog index, title, group and ink, the chosen row lit; `galleryRowsAt` and `galleryRowsChosen` are
// the scroll and the choice the rows were last written for. A press on the list records the row it landed on, the
// scroll it started from and the last row it passed (`galleryPress`, `galleryPressRow`, `galleryPressScroll`,
// `galleryDragRow`), and `galleryDragged` whether it moved; `galleryStepAt` is the mailbox gallery.step writes a step to.
//
// The motion exhibits' controls, which a world declares (galleryState). Every driver in the motion rows reads `galleryClock`, gallery seconds advancing at the
// row's rate; a rate of zero freezes every pose where it stands, and writing the cell scrubs it. Each driver is gated on
// `galleryMotion.all` and on its exhibit's own `galleryMotion` key: a zero eases that exhibit back to its rest pose.
// `galleryInputs` holds text cells three exhibits read: `probe` places motion-state-blend's sphere, `reach` is the world
// point motion-ik's arm reaches for (before its turntable), and `tint` colours shape-state-color. shapes.md gives the
// console lines.
let reachStation = galleryStation("motion-ik")
let reachPoint = exhibitPoint(reachStation, [-0.35, 1.45, 0.25])
// A display's first exhibit, which its cells hold at boot, and the scroll its list boots at: that exhibit on the top row,
// unless the catalog's end comes first.
function displayFirst(index) = galleryCatalog[galleryDisplayFirsts[index]]
function consoleScrollAt(index) = minimum(galleryDisplayFirsts[index], consoleScrollLast)
// Every row of every console's list as it boots: its cells' key, and the catalog entry it shows.
let consoleSlots = flatMap(
  range(0, length(galleryDisplays)),
  index => map(range(0, consoleRows), row => {
    key: $"{galleryDisplays[index].id}-{row}"
    entry: galleryCatalog[(consoleScrollAt(index) + row)]
    chosen: ((consoleScrollAt(index) + row) == galleryDisplayFirsts[index])
  })
)

// One Int cell a display, keyed by its id and seeded from `values`, a value a display in galleryDisplays' order.
template displayCells(name, values) {
  row {
    name: name
    kind: Int
    capacity: length(galleryDisplays)
    cells: map(range(0, length(galleryDisplays)), index => { key: galleryDisplays[index].id, value: values[index] })
  }
}

template displayState() {
  displayCells(name: "gallerySelect", values: galleryDisplayFirsts)
  displayCells(name: "galleryShownAt", values: galleryDisplayFirsts)
  displayCells(name: "galleryPlace", values: map(galleryDisplayFirsts, first => (first + 1)))
  displayCells(name: "galleryScroll", values: map(range(0, length(galleryDisplays)), index => consoleScrollAt(index)))
  displayCells(name: "galleryRowsAt", values: map(range(0, length(galleryDisplays)), index => consoleScrollAt(index)))
  displayCells(name: "galleryRowsChosen", values: galleryDisplayFirsts)
  displayCells(name: "galleryPress", values: map(galleryDisplays, display => 0))
  displayCells(name: "galleryPressRow", values: map(galleryDisplays, display => -1))
  displayCells(name: "galleryPressScroll", values: map(range(0, length(galleryDisplays)), index => consoleScrollAt(index)))
  displayCells(name: "galleryDragRow", values: map(galleryDisplays, display => -1))
  displayCells(name: "galleryDragged", values: map(galleryDisplays, display => 0))
  displayCells(name: "galleryStepAt", values: map(galleryDisplays, display => 0))
  // One cell a row of every console's list, keyed `<display>-<row>`, seeded from each row's boot slot.
  row {
    name: "galleryRowIndex"
    kind: Int
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: slot.entry.index })
  }
  row {
    name: "galleryRowName"
    kind: Text
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: galleryCopy[slot.entry.name].title })
  }
  row {
    name: "galleryRowGroup"
    kind: Text
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: galleryDisplays[slot.entry.display].title })
  }
  row {
    name: "galleryRowInk"
    kind: Text
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: (slot.chosen ? consoleLook.lit : consoleLook.dim) })
  }
  // The two inks of a list's rows (consoleLook), which the rows rule copies into each row's ink cell.
  row {
    name: "galleryInks"
    kind: Text
    capacity: 2
    cells [{ key: "lit", value: consoleLook.lit }, { key: "dim", value: consoleLook.dim }]
  }
  row {
    name: "galleryTitles"
    kind: Text
    capacity: length(galleryCatalog)
    cells: map(galleryCatalog, entry => { key: $"{entry.index}", value: galleryCopy[entry.name].title })
  }
  row {
    name: "galleryNotes"
    kind: Text
    capacity: length(galleryCatalog)
    cells: map(galleryCatalog, entry => { key: $"{entry.index}", value: galleryCopy[entry.name].note })
  }
  row {
    name: "galleryGroups"
    kind: Text
    capacity: length(galleryCatalog)
    cells: map(galleryCatalog, entry => { key: $"{entry.index}", value: galleryDisplays[entry.display].title })
  }
  row {
    name: "galleryScreenTitle"
    kind: Text
    capacity: length(galleryDisplays)
    cells: map(range(0, length(galleryDisplays)), index => { key: galleryDisplays[index].id, value: galleryCopy[displayFirst(index).name].title })
  }
  row {
    name: "galleryScreenNote"
    kind: Text
    capacity: length(galleryDisplays)
    cells: map(range(0, length(galleryDisplays)), index => { key: galleryDisplays[index].id, value: galleryCopy[displayFirst(index).name].note })
  }
  row {
    name: "galleryScreenGroup"
    kind: Text
    capacity: length(galleryDisplays)
    cells: map(galleryDisplays, display => { key: display.id, value: display.title })
  }
  row {
    name: "galleryPick"
    kind: Int
    capacity: (length(galleryCatalog) + 1)
    cells: concat([{ key: "gallery", value: 0 }], map(galleryCatalog, entry => { key: entry.name, value: 0 }))
  }
}

template galleryState() {

  slot galleryClock = 0.5 advance(perSecond: 1)

  table galleryMotion {
    all = 1
    spin = 1
    rock = 1
    slide = 1
    chain = 1
    blend = 1
    carve = 1
    mirror = 1
    polar = 1
    paint = 1
    inset = 1
    twist = 1
    bend = 1
    pulse = 1
    cells = 1
    volume = 1
    ik = 1
    nod = 1
    three = 1
    seamPaint = 1
  }

  table galleryInputs {
    probe = "[0.3, 1.35, 0.05]"
    reach = $"[{gallerySite[0] + reachPoint[0]}, {gallerySite[1] + reachPoint[1]}, {gallerySite[2] + reachPoint[2]}]"
    tint = "#D9822B"
  }
}

// The one driver every motion exhibit runs on: the gallery clock times `cadence` radians a gallery second, gated on
// the whole gallery and on the exhibit's own key, its weight easing over `ease` seconds as a gate opens or closes.
template clockDriver(key, cadence = 1, ease = 0.3) {
  drivers [
    {
      name: "clock"
      signal: "state.galleryClock"
      cadence: cadence
      blendInSeconds: ease
      blendOutSeconds: ease
      when [
        "state.galleryMotion.all"
        $"state.galleryMotion.{key}"
      ]
    }
  ]
}

// Every shape blend: the box first, then the sphere in the accent colour blended into it, so a seam's material winner
