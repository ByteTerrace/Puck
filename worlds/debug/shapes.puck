  }
  prototype "shape-cells-f1" {
    document {
      shape Sphere "subject" {
        cells {
          amplitude: 0.18
          frequency: 4
          mode: "F1"
          randomness: 0.46
          seed: 3751
        }
        material: exhibitMaterial
        position [0, 1.2, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [0.5, 0.5, 0.5]
