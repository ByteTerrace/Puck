// The shape gallery: every authorable signed-distance construct, one prototype an exhibit, shown on interactive display
// stations. A display is a large display plinth whose turntable shows one exhibit at a time, at first one of its own
// group (primitives, stretched, extruded, revolved, and so on); its console is one interactive screen listing every
// exhibit in the catalog, and a tap on one shows it on the turntable, with its name and what it shows beside the list.
// The debug world expands `galleryPrototypes()` inside its `prototypes` block and `galleryState()` (the displays' selections and screens and
// the motion exhibits' console controls) inside its `state.world` block. The displays stand inside the gallery
// (gallery/gallery.puck), where its plan puts them (gallery/layout.puck, gallery.md):
//
//   level 0  shape and surface, in six pairs from the west: glass and warps II under the bridge, cel styles with palette
//            channels and wear,
//            sweeps and facets with parameter forms, primitives at a uniform scale and extruded profiles, stretched
//            primitives and revolved profiles, every shape blend and the domain folds
//   level 1  open: its balconies hold no displays yet
//   level 2  motion: the stamp pool's rotation, swings, slides, moving blends, paints, IK and frames; the
//            board game room fills its south gallery (gallery.md)
//   level 3  open: its galleries hold no displays yet
//
// A board over the lift door names each level. Each display has a spawn point before its console, named
// after its turntable's placement, and each exhibit one at the same place named after it (gallerySpawns says how she
// stands there so the chase camera frames the exhibit); the gallery.* commands (galleryCommands) walk to, show, frame,
// inspect and flag exhibits through them. shapes.md beside this file holds the displays, the coverage table and the
// console controls the motion exhibits answer to. This file is a library: debug.puck and gallery/gallery.puck expand
// its templates and lets, and gallery/gallery.puck holds the displays' rules.
import "gallery/layout"
import "../standard/reach"
import "../standard/styles"
import "../standard/rig"
import "../standard/architecture"
import "../standard/contexts/terminal-console"

let seatPopulation = 4
let visitorPopulation = 8
let galleryPopulation = (41 + seatPopulation + visitorPopulation)
// The board game room's bodies: the granary board's cursor (granaries.puck), Alchemy's cursor and 31
// element tokens (alchemy.puck), Go's cursor and 361 stones (go.puck), then Reversi's cursor and 64 discs
// (reversi.puck), and above them the game station's deck: its cursor, 52 cards and held marker (game-station-deck.puck,
// one deck a station gallery/games.puck stands). debug.puck imports
// the card table first and the others after it, so the cards take the population's very top slots, the granary board
// the highest below them, and every other body keeps the index it held before the cards came.
let granaryBodies = 1
let alchemyBodies = 32
let goBodies = 362
let reversiBodies = 65
let cardBodies = 54
let boardRoomBodies = (granaryBodies + alchemyBodies + goBodies + reversiBodies)
// The launch field's ship (launch.puck) takes the population's highest slot, and debug.puck's capacity is one more.
let launchShipBody = (galleryPopulation + 2 + boardRoomBodies + cardBodies + seatPopulation + 1)

let uniformRow = [
  "shape-sphere", "shape-box", "shape-torus", "shape-cylinder", "shape-capsule", "shape-ellipsoid", "shape-round-cone",
  "shape-cone", "shape-superellipsoid", "shape-plane"
]
let stretchedRow = [
  "shape-sphere-xyz", "shape-box-xyz", "shape-torus-xz", "shape-torus-y", "shape-cylinder-xz", "shape-capsule-xz",
  "shape-ellipsoid-xyz", "shape-round-cone-xyz", "shape-cone-xz", "shape-superellipsoid-xyz", "shape-stretch-cut",
  "shape-stretch-smooth"
]
let extrudeRow = [
  "shape-trapezoid", "shape-rounded-rectangle", "shape-polygon-6", "shape-polygon-12", "shape-polygon-12-xy",
  "shape-ellipse", "shape-chamfered-rectangle", "shape-convex", "shape-path-fill", "shape-path-stroke",
  "shape-path-stroke-xy"
]
let revolveRow = [
  "shape-revolve-trapezoid", "shape-revolve-rounded-rectangle", "shape-revolve-polygon-6", "shape-revolve-ellipse",
  "shape-revolve-chamfered-rectangle", "shape-revolve-convex"
]
let facetRow = [
  "shape-sweep", "shape-sweep-tapered", "shape-sweep-strands", "shape-rounding", "shape-chamfer", "shape-onion",
  "shape-dilate", "shape-flare", "shape-shear", "shape-bumps", "shape-cells-f1", "shape-cells-f2", "shape-polar-fold"
]
let foldRow = [
  "shape-symmetry", "shape-repeat", "shape-repeat-grid", "shape-repeat-even", "shape-repeat-clipped",
  "shape-polar-mirror", "shape-polar-z", "shape-polar-stride", "shape-wallpaper-pmm", "shape-wallpaper-p4m",
  "shape-wallpaper-p3m1", "shape-wallpaper-p6m", "shape-wallpaper-stride", "shape-erode", "shape-noise-mask", "shape-noise"
]
let formRow = [
  "shape-superellipsoid-2", "shape-superellipsoid-8", "shape-prism-triangle", "shape-prism-rectangle",
  "shape-polygon-3", "shape-prism-rounding", "shape-prism-chamfer", "shape-cylinder-chamfer", "shape-revolve-solid",
  "shape-path-holes", "shape-path-shear", "shape-path-closed-stroke", "shape-path-stroke-ramp", "shape-sweep-braid"
]
let surfaceRow = [
  "shape-metal", "shape-coat", "shape-sheen", "shape-emissive", "shape-wrap-soften", "shape-fill-bleed",
  "shape-weathering-edge", "shape-weathering-lines", "shape-weathering-settle", "shape-panel-recess",
  "shape-panel-raise", "shape-trims", "shape-paint-world", "shape-text-engrave", "shape-text-ride", "shape-volume-flow",
  "shape-volume-cloud", "shape-state-color"
]
let glassRow = ["shape-glass"]
let styleRow = ["shape-cel", "shape-cel-hard", "shape-grey-card", "shape-paint-tiles"]
let motionRow = [
  "motion-spin", "motion-rock", "motion-slide", "motion-chain", "motion-smooth-blend", "motion-state-blend",
  "motion-carve", "motion-mirror", "motion-polar", "motion-nod", "motion-three"
]
let motionRowB = [
  "motion-paint", "motion-inset", "motion-twist", "motion-bend", "motion-pulse", "motion-cells", "motion-volume",
  "motion-ik", "motion-frames", "motion-seam-paint"
]
let warpRow = [
  "shape-warp", "shape-displace", "shape-elongate", "shape-jitter", "shape-jitter-tumble", "shape-log-sphere",
  "shape-stairs-union", "shape-stairs-subtraction", "shape-morph"
]


// The levels, in walking order: the board over each lift door names its level and what it shows.
let galleryLevels = [
  {
    level: 0
    title: "LEVEL 0  SHAPE AND SURFACE"
    what: "glass, warps, shading, surfaces, reshaping, basic shapes, outlines, joins, patterns, motion"
  }
  { level: 1, title: "LEVEL 1  TOYBOX", what: "deck stations: arcade cabinets and television sets" }
  { level: 2, title: "LEVEL 2  GAMES", what: "the board game room" }
  { level: 3, title: "LEVEL 3  GALLERIES", what: "open galleries over the nave" }
]

// The display stations in walking order, each showing one group of the gallery's exhibits: its id (the key of its state
// cells and the stem of its placements' names), its sign's title and what the group shows, its level, where it stands
// in the building's frame and the yaw its console faces (layout.puck's display lines), its exhibits in order, and the
// exhibit it shows when the world starts (`default`, any exhibit of the catalog). All twelve stand on level 0, one to
// each showcase bay's side, and their defaults are the gallery's showpieces, the plain sphere among them: the first
// shape anyone draws, the one every other exhibit departs from. The stamp pool's motion exhibits list on the blends'
// and the stretched shapes' consoles.
let galleryDisplayRows = [
  {
    id: "primitives", title: "Basic shapes", level: 0, names: uniformRow, what: "Ten basic shapes at their natural size", default: "shape-sphere"
    x: bayX(showcaseBays[3]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "stretched", title: "Stretch and motion", level: 0, names: concat(stretchedRow, motionRowB), what: "Shapes stretched unevenly, and shapes that move", default: "motion-twist"
    x: bayX(showcaseBays[4]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "extruded", title: "Pulled outlines", level: 0, names: extrudeRow, what: "Flat outlines pulled out into solids", default: "shape-jitter-tumble"
    x: bayX(showcaseBays[3]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "revolved", title: "Spun outlines", level: 0, names: revolveRow, what: "Flat outlines spun round an axis into rings", default: "shape-morph"
    x: bayX(showcaseBays[4]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "facets", title: "Tubes and reshaping", level: 0, names: facetRow, what: "Tubes, rounded and bevelled edges, shells and relief", default: "shape-cells-f2"
    x: bayX(showcaseBays[2]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "blends", title: "Joins and cuts", level: 0, names: concat(map(blendExhibits, entry => entry.id), motionRow), what: "Every way to join or cut a box and a sphere", default: "motion-smooth-blend"
    x: bayX(showcaseBays[5]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "folds", title: "Patterns and mirrors", level: 0, names: foldRow, what: "Mirrors, repeats, circles of copies and tilings", default: "shape-wallpaper-p6m"
    x: bayX(showcaseBays[5]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "warps", title: "Warps and wobbles", level: 0, names: warpRow, what: "Wobbles, dimples, scattered copies, steps and morphs", default: "shape-log-sphere"
    x: bayX(showcaseBays[0]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "forms", title: "Shape variations", level: 0, names: formRow, what: "Squarer balls, tapers, drawn paths and a braid", default: "shape-sweep-braid"
    x: bayX(showcaseBays[2]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "surfaces", title: "Surfaces and finishes", level: 0, names: surfaceRow, what: "Metal, gloss, glow, wear, panels, text and plumes", default: "shape-volume-cloud"
    x: bayX(showcaseBays[1]), z: tileZ(showcaseRowNorth), yaw: 0
  }
  {
    id: "styles", title: "Shading styles", level: 0, names: styleRow, default: "shape-volume-flow"
    what: "Cartoon and smooth shading, a test card and tiles"
    x: bayX(showcaseBays[1]), z: tileZ(showcaseRowSouth), yaw: 180
  }
  {
    id: "glass", title: "Glass", level: 0, names: glassRow, default: "shape-glass"
    what: "Glass: tint, depth, bending light and frost"
    x: bayX(showcaseBays[0]), z: tileZ(showcaseRowSouth), yaw: 180
  }
]
// Every display stands on a floor tile's centre (layout.puck's module), so its pad lies square on the tiles. A display is
// the station a console and a turntable make, wherever a world stands it, so each row carries the frame it stands in:
// `floor` the height of its floor in that frame, `site` where the frame stands in the world (a static creation's paints and
// a terminal's reach are in world coordinates), `parent` the placement that frame is (null for none), and `homes` the groups
// whose exhibits it is home to (the exhibits whose paints, or whose reach, name the place the exhibit stands at). A world
// that stands one station of its own gives the station templates its own row (shape-station-root.puck).
let galleryDisplays = map(
  galleryDisplayRows,
  display => (display with {
    x: galleryTileX(display.x)
    z: galleryTileZ(display.z)
    floor: galleryFloor[display.level]
    site: gallerySite
    parent: "gallery"
    homes [display.id]
  })
)
// Every display's exhibit turns as on a turntable. At speed 1 it turns once in turntableSecondsPerTurn gallery seconds;
// its console steps the speed one at a time up to turntableSpeeds either way, through the slowest pace into turning the
// other way round, and holds and releases it. `turntableHolds` labels the hold button with what a tap does, by whether
// the turntable turns; `turntablePace` labels the pace, its period and the way it turns.
let turntableSecondsPerTurn = 24
let turntableSpeeds = 3
let turntableSpeed = 1
let turntableRate = (1 / turntableSecondsPerTurn)
let turntableHolds = ["Play", "Pause"]
// What a display's turntable mailbox (galleryTurnAt) asks of it: a pace slower or faster (the console's < and >, which
// step the speed by code - 2), hold or release it (its pause and play button), set it turning or stop it, or take the
// signed speed galleryTurnTo holds.
let galleryTurnCodes = { slower: 1, hold: 2, faster: 3, on: 4, off: 5, pace: 6 }
function turntablePace(speed) = ((speed > 0) ? $"{turntableSecondsPerTurn / speed} s a turn" :
  $"{turntableSecondsPerTurn / (0 - speed)} s a turn, reversed")

// Where each group's list starts in the catalog, and every exhibit in walking order, group by group: its name, the group
// it belongs to (its index in galleryDisplayRows), its place in that group's list (`slot`) and in the catalog (`index`).
// An exhibit's catalog index is its identity: a display's selection cell (`gallerySelect`) holds it. Every display's console
// lists the whole catalog, whichever groups its world stands a display for.
let galleryDisplayFirsts = scan(galleryDisplayRows, row => length(row.names))
let galleryCatalog = flatMap(
  range(0, length(galleryDisplayRows)),
  i => map(
    galleryDisplayRows[i].names,
    (name, slot) => { name: name, group: i, slot: slot, index: (galleryDisplayFirsts[i] + slot) }
  )
)
let galleryLast = (length(galleryCatalog) - 1)
function galleryGroupOf(entry) = galleryDisplayRows[entry.group]
function exhibitEntry(name) = filter(galleryCatalog, entry => (entry.name == name))[0]
// A display's default exhibit, by its catalog index: the one its cells, its list and its turntable hold at boot.
function displayDefault(display) = exhibitEntry(display.default).index

// A display's floor height, and `front`, the sign of z its console faces along (1 at yaw 180, -1 at yaw 0).
function displayFloor(display) = display.floor
function displayFront(display) = ((display.yaw == 0) ? -1 : 1)
// A point given in the display plinth's own author frame (architecture.puck's: +X to the right of a viewer facing the
// console, +Y up, +Z toward that viewer), placed in the display's frame: the plinth stands at `displayScale`, a yaw-180
// display's author axes are the frame's, and a yaw-0 display's turn x and z about.
function displayPoint(display, p) = [
  (display.x + (displayFront(display) * displayScale * p[0])),
  (displayFloor(display) + (displayScale * p[1])),
  (display.z + (displayFront(display) * displayScale * p[2]))
]
// The same point in the world, where the display's frame stands: a static creation's paints stand there.
function displayWorld(display, p) = (display.site + displayPoint(display, p))
// The turn that carries a paint's +X along the console's face to the viewer's right, its +Y up the face and its +Z out
// of it, in the world: the plinth's own face turn (`plinthFace`) at yaw 180, and the same turned half round at yaw 0.
function displayFaceTurn(display) = ((display.yaw == 0) ? [0, plinthFace[3], (0 - plinthFace[0]), 0] : plinthFace)
// Where a body stands before the console, in the plinth's author frame: within reach of the screen, 1.25 m clear of
// the console.
let displayStand = [0, 0, 1.75]
// The exhibit on the turntable stands this far over the display's floor (layout.puck's displayExhibitScale): the
// exhibits' own frame puts the plinth's cap at 0.75, and the display's cap stands at plinthCapTop times displayScale.
let displayExhibitDrop = (((plinthCapTop * displayScale) - (0.75 * displayExhibitScale)) + displayExhibitLift)

// The display an exhibit is home to, among `displays`: the first whose `homes` name the exhibit's group.
function stationHome(displays, entry) = filter(
  displays,
  display => contains(display.homes, galleryGroupOf(entry).id)
)[0]
// An exhibit's station: its name, its catalog index and slot, and its home display's place (the turntable's centre, its
// level and floor height, the yaw it stands at, `front` and the `site` of its frame).
function stationRow(entry, display) = {
  name: entry.name
  index: entry.index
  slot: entry.slot
  display: display.id
  level: display.level
  x: display.x
  y: displayFloor(display)
  z: display.z
  yaw: display.yaw
  front: displayFront(display)
  site: display.site
}
function stationOf(displays, name) = stationRow(exhibitEntry(name), stationHome(displays, exhibitEntry(name)))
// Where a point an exhibit authors in its own frame stands in its display's frame: its display's turntable, set down by
// displayExhibitDrop, the point scaled by `displayExhibitScale` and turned as the display is; `exhibitWorld` in the world.
function exhibitPoint(station, p) = [
  (station.x + (station.front * displayExhibitScale * p[0])),
  (station.y + displayExhibitDrop + (displayExhibitScale * p[1])),
  (station.z + (station.front * displayExhibitScale * p[2]))
]
function exhibitWorld(station, p) = (station.site + exhibitPoint(station, p))

// A spawn point per display before its console, named after its turntable's placement (`display-<id>`), then one per
// exhibit at its home display's, named after the exhibit, so `body.pose spawn:<exhibit>` and `gallery.go <exhibit>` walk to
// any exhibit by name. The display's own comes first, so a verb that takes the spawn point nearest a body
// (`gallery.flag near`) names the display, and a slice of the one at hand (`gallery.slice near`) cuts its turntable.
// She stands turned `gallerySpawnTurn` degrees past facing the display, because the chase camera keeps its place behind
// her: square to it, her body stands between the camera and the console and hides it. Turned, the camera (4 m back
// along her heading, 1.2 m over her pivot) sees the exhibit and the console beside her. The points are authored in the
// display's frame, under its parent placement.
let gallerySpawnTurn = 40
function displaySpawn(id, display) = ({
  id: id
  position: displayPoint(display, displayStand)
  yawDegrees: (((display.yaw + 180) % 360) + gallerySpawnTurn)
} with ((display.parent == null) ? {} : { parent: display.parent }))
function stationSpawns(displays) = concat(
  map(displays, display => displaySpawn($"display-{display.id}", display)),
  map(galleryCatalog, entry => displaySpawn(entry.name, stationHome(displays, entry)))
)
let gallerySpawns = stationSpawns(galleryDisplays)

let galleryPentagon = [[0, 1], [0.95, 0.31], [0.59, -0.81], [-0.59, -0.81], [-0.95, 0.31]]
// The hex wallpapers' clip: a clockwise pointy-top hexagon of inradius 0.45 (circumradius 0.45 / cos 30 degrees).
let galleryHexClip = [
  [0, 0.519615]
  [0.45, 0.259808]
  [0.45, -0.259808]
  [0, -0.519615]
  [-0.45, -0.259808]
  [-0.45, 0.259808]
]

// Slot 0 the exhibit, slots 1 and 2 a dark and a pale tone in the gallery's cel look (the signs' board and lettering),
// slot 3 an exhibit's own second material (a blend's tool, a palette channel under test) and slots past it whatever
// else an exhibit appends.
let exhibitMaterial = 0
let accentMaterial = 3
// The gallery's cel look, its walls and signs (galleryCel): the shade a near-neutral step, so a lit room
// still reflects untinted light onto its exhibits and an albedo reads as itself, and a thin cool ink on the building's
// silhouettes and folds, even along its length as a drafted line is. An exhibit's subject (slot 0 of an exhibit's palette, and the slots it adds) keeps its own
// shading: the gallery is the engine's self-test, and its displays' screens say what each subject shows.
let galleryStyle = celStyle with {
  threshold: 0.08
  softness: 0.1
  shadowTint [0.86, 0.84, 0.9]
  specularSize: 0.02
  restore: 0.65
  bleed: 0.2
  form: 0.25
  ink: standardInk with { weight: 0.022, bold: 1.8, tint [0.42, 0.42, 0.48], crease: 0.6, fold: 0.45, uneven: 0 }
}
function galleryCel(base) = celMaterial(base, galleryStyle)
// The primitives that open the gallery each take a material of their own (`exhibit`'s `subject`): a glazed torus, a
// bronze sphere, a gilt cone, so the nave's first exhibits read as a collection and each form by its own surface.
let exhibitSubjects = {
  sphere { color: "#B98A4E", roughness: 0.32, metal: 1 }
  box { color: "#E9DFCB", roughness: 0.7, specular: 0.04 }
  torus { color: "#2F78A8", roughness: 0.12, specular: 0.05, coat: 0.6 }
  cylinder { color: "#C8553A", roughness: 0.4, specular: 0.04 }
  capsule { color: "#5E9E8F", roughness: 0.3, specular: 0.05, coat: 0.4 }
  ellipsoid { color: "#D9A7B0", roughness: 0.45, specular: 0.04 }
  roundCone { color: "#7C6BB0", roughness: 0.35, specular: 0.05 }
  cone { color: "#E2A72E", roughness: 0.3, specular: 0.05, coat: 0.4 }
  superellipsoid { color: "#9FC6DC", roughness: 0.18, specular: 0.05, coat: 0.5 }
}
// The exhibits' own grey is a plain dielectric, so a subject's form reads by its shading and no exhibit is glossier than
// its screen says: an exhibit that shows gloss, metal or a coat authors it in its own slots.
let galleryPalette = [
  { color: "#B9C4D0", roughness: 0.5, specular: 0.04 }
  galleryCel({ color: "#3A3F47", roughness: 0.85 })
  galleryCel({ color: "#F2EEE4", roughness: 0.6 })
]
let accent = { color: "#D9822B", roughness: 0.5, specular: 0.04 }

// An exhibit's document: its palette and any text runs the exhibit itself shows, expanded after the exhibit's own
// shapes. `label` names the creation; the display's screen shows its copy (galleryCopy). `extra` appends palette slots
// from 3 on, and `runs` the exhibit's own lettering.
template exhibit(label, extra = [], runs = [], subject = galleryPalette[0]) {
  name: label
  schema: "puck.creation.v2"
  palette: concat([subject], map(range(1, length(galleryPalette)), i => galleryPalette[i]), extra)
  textRuns: runs
}

// Each exhibit's copy, which its display's screen shows while the exhibit stands on the turntable: its title and a note
// that says what the shape is and what to notice about it. The note strip wraps and shrinks to fit, so a note of up to
// about 170 characters reads at its full size. A title stays under about 24 characters, so it fits both the list and
// the heading.
let galleryCopy = {
  "shape-sphere" {
    title: "Sphere"
    note: "A perfectly round ball. Every point on its surface is the same distance from the centre."
  }
  "shape-box" {
    title: "Box"
    note: "A box with flat faces and sharp edges. Watch how each face catches the light differently as it turns."
  }
  "shape-torus" {
    title: "Torus"
    note: "A ring shaped like a doughnut. Watch the light slide around its curve as it turns."
  }
  "shape-cylinder" {
    title: "Cylinder"
    note: "A can: two flat round ends joined by a straight side. Look at the crisp edge where the side meets each end."
  }
  "shape-capsule" {
    title: "Capsule"
    note: "A pill shape: a straight tube with a half sphere on each end."
  }
  "shape-ellipsoid" {
    title: "Ellipsoid"
    note: "A ball that can be stretched. Its sizes are equal here, so it looks like the sphere. The stretched shapes show what it can do."
  }
  "shape-round-cone" {
    title: "Rounded cone"
    note: "A small ball on top and a big ball below, joined by a smooth sloping side."
  }
  "shape-cone" {
    title: "Cone"
    note: "A flat round base that narrows to a point. Notice how sharp the tip is."
  }
  "shape-superellipsoid" {
    title: "Superellipsoid"
    note: "A squared-off ball. Its exponent is 4: an exponent of 2 gives a ball, and larger numbers give a box."
  }
  "shape-plane" {
    title: "Sliced sphere"
    note: "A ball cut by a tilted flat plane. Look at the sharp edge where the curve meets the cut."
  }
  "shape-sphere-xyz" {
    title: "Stretched sphere"
    note: "A sphere stretched by a different amount in each direction. It becomes a wide, flat oval."
  }
  "shape-box-xyz" {
    title: "Stretched box"
    note: "A box with three different side lengths, like a brick. The edges stay straight and the corners stay sharp."
  }
  "shape-torus-xz" {
    title: "Wide ring"
    note: "A ring stretched more in one direction than the other, so its hole becomes an oval."
  }
  "shape-torus-y" {
    title: "Tall ring"
    note: "A ring stretched along just one axis. Compare its tube with the plain torus in the basic shapes."
  }
  "shape-cylinder-xz" {
    title: "Oval cylinder"
    note: "A can with an oval top, because its width and depth differ. Its height stays the same."
  }
  "shape-capsule-xz" {
    title: "Oval capsule"
    note: "A capsule whose width and depth differ, so a slice through it is an oval."
  }
  "shape-ellipsoid-xyz" {
    title: "Stretched ellipsoid"
    note: "An ellipsoid with three different sizes, like an egg or a rugby ball."
  }
  "shape-round-cone-xyz" {
    title: "Stretched rounded cone"
    note: "A rounded cone stretched by a different amount along each axis. The join between its two balls stays smooth."
  }
  "shape-cone-xz" {
    title: "Oval cone"
    note: "A cone with an oval base, because its width and depth differ."
  }
  "shape-superellipsoid-xyz" {
    title: "Stretched superellipsoid"
    note: "A squared-off ball stretched by a different amount along each axis, like a soft pillow."
  }
  "shape-stretch-cut" {
    title: "Stretched cutters"
    note: "A stretched capsule, cone and ring cut into a slab. Each cut has a sharp rim and smooth walls."
  }
  "shape-stretch-smooth" {
    title: "Smooth stretched cutters"
    note: "The same three cuts with their rims softened over 4 cm. The soft edge should be the same width all the way round each cut."
  }
  "shape-trapezoid" {
    title: "Trapezoid"
    note: "A trapezoid outline pulled out into a solid: wide at one end and narrow at the other."
  }
  "shape-rounded-rectangle" {
    title: "Rounded rectangle"
    note: "A rectangle with rounded corners, pulled out into a solid. Look at how smoothly the corners curve."
  }
  "shape-polygon-6" {
    title: "Hexagon"
    note: "A six-sided outline pulled out into a solid, like a nut or a honeycomb cell."
  }
  "shape-polygon-12" {
    title: "Twelve-sided shape"
    note: "A twelve-sided outline pulled out into a solid. With this many sides it is close to a circle."
  }
  "shape-polygon-12-xy" {
    title: "Wide twelve-sided shape"
    note: "The twelve-sided outline made wider than it is tall. Its flat sides stretch with it."
  }
  "shape-ellipse" {
    title: "Oval"
    note: "An oval outline pulled out into a solid, like a flat coin."
  }
  "shape-chamfered-rectangle" {
    title: "Bevelled rectangle"
    note: "A rectangle with its corners cut off at an angle, pulled out into a solid."
  }
  "shape-convex" {
    title: "Pentagon"
    note: "A five-sided outline pulled out into a solid. Every corner points outward."
  }
  "shape-path-fill" {
    title: "Filled path"
    note: "A shape drawn with straight lines and curves, filled in and pulled out into a solid."
  }
  "shape-path-stroke" {
    title: "Stroked path"
    note: "A drawn line given thickness and pulled out into a solid. The line is thick at one end and thin at the other."
  }
  "shape-path-stroke-xy" {
    title: "Wide stroked path"
    note: "The stroked line pulled out into a solid, stretched wider than it is tall."
  }
  "shape-revolve-trapezoid" {
    title: "Spun trapezoid"
    note: "A trapezoid outline spun round an axis into a ring with sloping sides."
  }
  "shape-revolve-rounded-rectangle" {
    title: "Spun rounded rectangle"
    note: "A rounded rectangle spun into a ring. A slice through the ring keeps the rounded corners."
  }
  "shape-revolve-polygon-6" {
    title: "Spun hexagon"
    note: "A hexagon spun into a ring. A slice through the ring is a six-sided shape."
  }
  "shape-revolve-ellipse" {
    title: "Spun oval"
    note: "An oval spun into a ring, like a smooth doughnut."
  }
  "shape-revolve-chamfered-rectangle" {
    title: "Spun bevelled rectangle"
    note: "A rectangle with its corners cut off, spun into a ring."
  }
  "shape-revolve-convex" {
    title: "Spun pentagon"
    note: "A five-sided outline spun into a ring."
  }
  "shape-sweep" {
    title: "Tube"
    note: "A tube of even thickness that follows a curve, like a smooth cable. Its surface is exact all the way along."
  }
  "shape-sweep-tapered" {
    title: "Tapered tube"
    note: "A tube whose radius shrinks from 14 cm to 4 cm, with a bulge in the middle. Look for a smooth swelling with no seam and no pinch."
  }
  "shape-sweep-strands" {
    title: "Rope"
    note: "Three strands wind around a curve, with one and a half turns of twist. The strands stay apart and evenly spaced."
  }
  "shape-rounding" {
    title: "Rounded edge"
    note: "A cylinder with its edge rounded by 12 cm. The top and side stay flat, and the rim curves smoothly."
  }
  "shape-chamfer" {
    title: "Bevelled edge"
    note: "A box with a flat 45 degree bevel, 10 cm wide, on every edge and corner. Each bevel is a flat slope."
  }
  "shape-onion" {
    title: "Hollow shell"
    note: "A sphere hollowed into a shell 4 cm thick, with a window cut out so you can see inside. Both skins show, and the wall stays an even thickness."
  }
  "shape-dilate" {
    title: "Inflated box"
    note: "A small box swollen outward by 10 cm, which rounds every edge and corner. Look for smooth surfaces with no creases."
  }
  "shape-flare" {
    title: "Flare"
    note: "A cylinder whose width changes along its height, with a small bulge along the way. The surface looks a little coarse here."
  }
  "shape-shear" {
    title: "Leaning box"
    note: "A box that leans sideways more and more as it rises, so its lean curves. Its faces stay flat from front to back."
  }
  "shape-bumps" {
    title: "Bumps"
    note: "Two round pushes on a surface: a swelling at the upper right and a dent at the lower left. Both blend in smoothly."
  }
  "shape-cells-f1" {
    title: "Cell bumps"
    note: "A surface covered in raised cells with creased walls, like the shell of a beetle."
  }
  "shape-cells-f2" {
    title: "Cell ridges"
    note: "Ridges run along the edges between cells, and a hollow sits at the middle of each cell."
  }
  "shape-polar-fold" {
    title: "Six blades"
    note: "One box drawn at the front and copied round the vertical axis into six sectors. Look for no gap or seam between them."
  }
  "shape-blend-union" {
    title: "Join"
    note: "The box and the sphere merged into one solid. A sharp crease marks where they meet, and the sphere keeps its orange colour."
  }
  "shape-blend-subtraction" {
    title: "Cut"
    note: "The sphere carved out of the box. The dent takes the sphere's colour, and its rim stays sharp."
  }
  "shape-blend-intersection" {
    title: "Overlap"
    note: "Only the part where the box and sphere overlap: a box with rounded corners, with the sphere's colour on its curved faces."
  }
  "shape-blend-xor" {
    title: "Overlap removed"
    note: "The parts of the box and sphere that do not overlap. The shared part is carved away, leaving a hollow you can see into along the seam."
  }
  "shape-smooth-union" {
    title: "Smooth join"
    note: "A 15 cm rounded blend where the sphere meets the box. The blend should flow like a smooth saddle, with no step."
  }
  "shape-smooth-subtraction" {
    title: "Smooth cut"
    note: "The sphere's dent, with its rim rounded over 10 cm where it meets the box."
  }
  "shape-smooth-intersection" {
    title: "Smooth overlap"
    note: "The overlap, with its edges rounded over 10 cm."
  }
  "shape-cubic-smooth-union" {
    title: "Cubic smooth join"
    note: "The smooth join's 15 cm blend, shaped so no crease shows where it meets the faces. A highlight runs on across the join."
  }
  "shape-cubic-smooth-subtraction" {
    title: "Cubic smooth cut"
    note: "The cut's rim rounded over 10 cm. The highlight stays unbroken where the rounding meets the face."
  }
  "shape-cubic-smooth-intersection" {
    title: "Cubic smooth overlap"
    note: "The overlap's edges rounded over 10 cm, with no crease where each rounding meets its face."
  }
  "shape-chamfer-union" {
    title: "Bevelled join"
    note: "A flat 45 degree bevel, 10 cm wide, runs along the seam in place of a round blend."
  }
  "shape-chamfer-subtraction" {
    title: "Bevelled cut"
    note: "The cut's rim sloped at 45 degrees."
  }
  "shape-chamfer-intersection" {
    title: "Bevelled overlap"
    note: "The overlap's edges sloped at 45 degrees."
  }
  "shape-groove-union" {
    title: "Grooved join"
    note: "A round groove, 5 cm wide, cut along the seam. It is a recessed line that follows the join."
  }
  "shape-pipe-union" {
    title: "Beaded join"
    note: "A round bead, 4 cm wide, laid along the seam like a weld that follows the join."
  }
  "shape-groove-subtraction" {
    title: "Grooved cut"
    note: "A groove cut round the rim of the dent."
  }
  "shape-pipe-subtraction" {
    title: "Beaded cut"
    note: "A bead laid round the rim of the dent."
  }
  "shape-symmetry" {
    title: "Mirror"
    note: "One tilted capsule mirrored across the middle to make a V. The two halves match exactly."
  }
  "shape-repeat" {
    title: "Row of five"
    note: "One sphere repeated every 25 cm, two steps each way from the middle, makes five copies."
  }
  "shape-repeat-grid" {
    title: "Grid of nine"
    note: "One box repeated in a 3 by 3 grid."
  }
  "shape-repeat-even" {
    title: "Row of four"
    note: "Four spheres in a row. Mirroring a row of five is how you get an even count, and the gap in the middle closes."
  }
  "shape-repeat-clipped" {
    title: "Block of beads"
    note: "An endless grid of spheres, trimmed by a box that cuts along the walls between cells. You get a block of whole beads with none sliced."
  }
  "shape-polar-mirror" {
    title: "Kaleidoscope"
    note: "Five sectors around the centre, each a mirror image of its neighbour. The mirrored pairs meet along the walls between sectors."
  }
  "shape-polar-z" {
    title: "Wheel"
    note: "Eight copies set in a circle around a point above the plinth, like the spokes of a wheel facing you."
  }
  "shape-polar-stride" {
    title: "Six colours"
    note: "Six sectors round the centre, each stepping to the next colour in the palette. One sphere shows up in six colours."
  }
  "shape-wallpaper-pmm" {
    title: "Rectangle tiling"
    note: "One tile mirrored across both directions of its cell, repeated out to a 3 by 3 field of mirror images."
  }
  "shape-wallpaper-p4m" {
    title: "Square tiling"
    note: "A square pattern in which every cell holds eight mirrored copies of the tile."
  }
  "shape-wallpaper-p3m1" {
    title: "Three-way tiling"
    note: "A honeycomb pattern with mirrors through its corners, trimmed by a hexagon along the mirror lines. The cut faces are flat, with no creases."
  }
  "shape-wallpaper-p6m" {
    title: "Six-way tiling"
    note: "The richest honeycomb pattern: twelve copies in each cell, trimmed along its mirror lines so the tiles meet cleanly."
  }
  "shape-wallpaper-stride" {
    title: "Checkerboard tiling"
    note: "The square tiling with a colour change: neighbouring cells alternate colour, like a checkerboard."
  }
  "shape-erode" {
    title: "Half-eroded sphere"
    note: "A sphere partly worn away, shown halfway through. The edge of the missing part is ragged."
  }
  "shape-noise-mask" {
    title: "Smooth patch"
    note: "A rough slab with a smooth bowl cut into it. A mask keeps the roughness away from the bowl."
  }
  "shape-noise" {
    title: "Lumpy sphere"
    note: "Rolling noise lumps the sphere's surface. The plinth underneath stays clean."
  }
  "motion-spin" {
    title: "Spin"
    note: "A box turning at a steady pace about its middle. Scratches in the red paint show bare metal underneath."
  }
  "motion-rock" {
    title: "Swing"
    note: "A ball on a rod that swings from a pivot at the top, like a pendulum."
  }
  "motion-slide" {
    title: "Slide"
    note: "A ball sliding from side to side along a straight path."
  }
  "motion-chain" {
    title: "Linked swing"
    note: "Two rods linked end to end with a ball at the bottom. The lower rod swings on the upper one, like a double pendulum."
  }
  "motion-smooth-blend" {
    title: "Moving smooth join"
    note: "A sphere slides 6 cm along a box while a smooth blend joins them. The blend stretches with it and never tears, steps or pops."
  }
  "motion-state-blend" {
    title: "Adjustable join"
    note: "The same kind of join, with the sphere placed by a value the world holds. Each change rebuilds the join exactly."
  }
  "motion-carve" {
    title: "Moving cut"
    note: "A sliding tool cuts a smooth bowl into a box. The box is rebuilt as the tool moves, so the orange bowl and its soft rim follow along."
  }
  "motion-mirror" {
    title: "Moving mirror"
    note: "A shape and its mirror image on a swinging hinge. The mirror swings with the hinge."
  }
  "motion-polar" {
    title: "Spinning blades"
    note: "One blade copied around a hub into eight, all spinning together."
  }
  "motion-nod" {
    title: "Nodding head"
    note: "A head nodding on its neck. The smooth join at the throat bends with it, with no crack, spike or fold at either end of the nod."
  }
  "motion-three" {
    title: "Three moving parts"
    note: "Three moving parts meet at one smooth join. The engine splits them into stiff pieces, so expect creases where they meet and no tears."
  }
  "motion-paint" {
    title: "Moving paint"
    note: "Stripes, a ring and a pentagon painted on a swinging panel. The paint swings with the panel."
  }
  "motion-inset" {
    title: "Moving eye"
    note: "An eye with a pupil and an iris, set under a clear cover. The iris turns with its shape."
  }
  "motion-twist" {
    title: "Twist"
    note: "A tall box twisted along its height while it turns and leans."
  }
  "motion-bend" {
    title: "Bend"
    note: "A tall, thin box bent into a curve while it turns."
  }
  "motion-pulse" {
    title: "Pulse"
    note: "Six petals slide out from a core and back again, like a flower opening and closing."
  }
  "motion-cells" {
    title: "Moving cell bumps"
    note: "A bumpy ball with a cell pattern, tipping back and forth. The bumps stay fixed to its surface as it moves."
  }
  "motion-volume" {
    title: "Moving plume"
    note: "A plume coming out of a nozzle that tilts. The plume tilts with the nozzle."
  }
  "motion-ik" {
    title: "Reaching arm"
    note: "A two-part arm that bends at the elbow to reach for a point in space."
  }
  "motion-frames" {
    title: "Frame steps"
    note: "A box that jumps between four poses (left, up, right, down) in fixed steps, like a flip book."
  }
  "motion-seam-paint" {
    title: "Paint across a join"
    note: "A known gap. A stripe painted across a box and a sliding sphere holds steady on each shape but slides across the blend between them."
  }
  "shape-warp" {
    title: "Wobble"
    note: "A sphere bent by waves, so it wobbles smoothly. Look for smooth shading with no creases."
  }
  "shape-displace" {
    title: "Dimples"
    note: "A box with a wave pattern pressed into every face. Look for an even pattern of dimples on each side. The bumps cast tiny shadows."
  }
  "shape-elongate" {
    title: "Rounded slab"
    note: "A sphere dragged along the shape of a box makes a rounded slab with a perfectly even rim."
  }
  "shape-jitter" {
    title: "Scattered spheres"
    note: "A grid of spheres where each one is nudged and recoloured at random. No two match, and none crosses into the next cell."
  }
  "shape-jitter-tumble" {
    title: "Tumbled boxes"
    note: "Boxes turned to random angles and spread evenly across a grid. Each has its own tilt, and none clump together."
  }
  "shape-log-sphere" {
    title: "Spiral of spheres"
    note: "A sphere repeated inward, each copy half the size of the last and turned a little further. The spheres spiral toward the centre."
  }
  "shape-stairs-union" {
    title: "Stepped join"
    note: "A join where the seam climbs four steps over 20 cm. You see a small staircase around the join where a smooth blend would be."
  }
  "shape-stairs-subtraction" {
    title: "Stepped cut"
    note: "A cut whose rim steps down three times over 15 cm, like terraces cut into the box."
  }
  "shape-morph" {
    title: "Morph"
    note: "The box and the sphere blended halfway into each other. The result is a soft cube with neither shape's sharp edges."
  }
  "shape-superellipsoid-2" {
    title: "Exponent 2"
    note: "A superellipsoid with its exponent set to 2, which gives an ordinary ball."
  }
  "shape-superellipsoid-8" {
    title: "Exponent 8"
    note: "An exponent of 8 gives nearly a box, with only slightly rounded corners."
  }
  "shape-prism-triangle" {
    title: "Pointed prism"
    note: "A prism that narrows to a point at one end, so its face is a triangle. Its taper is set to 0."
  }
  "shape-prism-rectangle" {
    title: "Straight prism"
    note: "The same prism with its taper set to 1. It keeps one width all the way along, so its face is a rectangle."
  }
  "shape-polygon-3" {
    title: "Triangle"
    note: "A three-sided outline pulled out into a solid."
  }
  "shape-prism-rounding" {
    title: "Rounded hexagon"
    note: "A hexagon prism with its edges rounded by 6 cm."
  }
  "shape-prism-chamfer" {
    title: "Bevelled oval"
    note: "An oval prism with a 6 cm bevel along its edges."
  }
  "shape-cylinder-chamfer" {
    title: "Bevelled cylinder"
    note: "A cylinder with a bevel cut around both rims."
  }
  "shape-revolve-solid" {
    title: "Spun solid"
    note: "A tapered outline spun right up to the axis, so it makes a solid shape with no hole in the middle."
  }
  "shape-path-holes" {
    title: "Path with a hole"
    note: "A square with one curved side and a round hole, pulled out into a solid. Areas inside two outlines are left empty."
  }
  "shape-path-shear" {
    title: "Slanted path"
    note: "A drawn path pulled out into a solid, then slanted sideways."
  }
  "shape-path-closed-stroke" {
    title: "Looped line"
    note: "A drawn curve that closes on itself, given thickness and pulled out into a solid."
  }
  "shape-path-stroke-ramp" {
    title: "Tapering line"
    note: "A drawn line along an arc and a straight run. Its thickness changes smoothly through the middle."
  }
  "shape-sweep-braid" {
    title: "Braid"
    note: "Four strands braided around a curve."
  }
  "shape-metal" {
    title: "Metal"
    note: "A gold ball. Metal reflects the sky and the room around it, in place of showing a plain colour."
  }
  "shape-coat" {
    title: "Clear coat"
    note: "A red ball with a clear, glossy layer on top, like car paint. Look for a sharp, bright highlight."
  }
  "shape-sheen" {
    title: "Soft sheen"
    note: "A blue box with a soft glow around its edges, like velvet or cloth."
  }
  "shape-emissive" {
    title: "Glow"
    note: "A ball that gives off its own light, as if it were lit from inside."
  }
  "shape-wrap-soften" {
    title: "Wrapped light"
    note: "A bumpy ball where light wraps around the surface, so the shaded side stays soft."
  }
  "shape-fill-bleed" {
    title: "Coloured bounce light"
    note: "A pale ball that adds a blue glow to its own shadows and bounces orange light onto what is nearby."
  }
  "shape-weathering-edge" {
    title: "Worn edges"
    note: "Paint worn away along the edges in two stages, showing the layer underneath."
  }
  "shape-weathering-lines" {
    title: "Scratches"
    note: "Worn lines across the surface, showing what lies under the paint."
  }
  "shape-weathering-settle" {
    title: "Settled dust"
    note: "A deposit that gathers on the upper faces."
  }
  "shape-panel-recess" {
    title: "Sunken panel"
    note: "A panel set into the face of a box."
  }
  "shape-panel-raise" {
    title: "Raised panel"
    note: "A panel standing out from the face of a box."
  }
  "shape-trims" {
    title: "Trim band"
    note: "A band of trim around the middle of a box."
  }
  "shape-paint-world" {
    title: "World stripe"
    note: "A stripe painted at a fixed place in the world, marking where this exhibit stands."
  }
  "shape-text-engrave" {
    title: "Engraved text"
    note: "Words cut into the surface."
  }
  "shape-text-ride" {
    title: "Text on a shape"
    note: "Words that ride along with a shape and wrap to a set width."
  }
  "shape-volume-flow" {
    title: "Flowing plume"
    note: "A plume that pulses out of a nozzle."
  }
  "shape-volume-cloud" {
    title: "Cloud"
    note: "A soft cloud you can see into, with no hard surface."
  }
  "shape-state-color" {
    title: "Colour from the world"
    note: "A colour tied to a value the world keeps, so changing that value changes the colour."
  }
  "shape-cel" {
    title: "Cartoon shading"
    note: "Left: a ball shaded in flat cartoon bands, with the shadow kept under each band. Right: the same ball shaded smoothly."
  }
  "shape-cel-hard" {
    title: "Hard cartoon shading"
    note: "Left: one hard band covers the light and the shadow together. Right: the same ball shaded smoothly."
  }
  "shape-grey-card" {
    title: "Grey card"
    note: "A test card for the screen's brightness. Where white maps to display white, 18 percent grey should read 118 out of 255, and the wedge should step evenly."
  }
  "shape-paint-tiles" {
    title: "Painted tiles"
    note: "One box paint repeated as tiles 30 cm apart, with 1 cm joints. Each tile's tone differs a little, chosen by chance."
  }
  "shape-glass" {
    title: "Glass"
    note: "An orange box holds a sphere, beside a thin pane, a thick pane and a frosted pane. Thicker glass looks deeper in colour, and each pane bends the rods behind it."
  }
}

// A display's console is one interactive screen (gallery.md, "Display consoles"): a glass a little proud of the
// plinth's own (architecture.puck's plinth glass) on which the interface glows, laid out in the LCARS manner in the
// kit's palette (consoleLook). An ochre elbow frames the top left and turns into the top bar, whose cap names the
// catalog; Previous and Next buttons stack down the left column beside a list of every exhibit in the catalog, the chosen one
// lit amber; a rule closes the list's foot; and the right of the screen tells the chosen exhibit's title, its group and
// place in the catalog, and its note, over the turntable's own row: a slower button, a pause and play button, a faster
// button and the pace the turntable keeps. A tap on a row shows that exhibit on this display's turntable, a drag scrolls
// the list a row for each row the pointer travels, Previous and Next turn it a page, and the turntable's buttons slow it,
// hold it and speed it (gallery/gallery.puck's console rules).
//
// Every rectangle is in the glass's own coordinates in the plinth's units, `x0..x1` across and `y0..y1` up from its
// centre. Each becomes a paint on the display's screen creation (a static placement draws a paint in the world's frame,
// so each display's paints are placed at its console in the world), and the list and the buttons are also regions of the
// screen placement's pointer surface, the rectangle a seat's pointer maps onto.
let consoleRows = 9
let galleryCount = length(galleryCatalog)
let consoleScrollLast = (galleryCount - consoleRows)
let displayGlassOut = 0.003
let displayGlassFront = (displayGlassOut + plinthGlassDepth)
let consoleColumn = { x0: -0.72, x1: -0.58 }
let consoleBar = { y0: 0.125, y1: 0.165 }
let consoleList = { x0: -0.53, x1: 0.105, y0: -0.145, y1: 0.105 }
let consolePrev = { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: -0.025, y1: 0.05 }
let consoleNext = { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: -0.105, y1: -0.03 }
let consoleDetail = { x0: 0.155, x1: 0.72 }
// The turntable's row along the foot of the detail column: its three buttons, then the pace it keeps.
let consoleTurnRow = { y0: -0.145, y1: -0.105 }
let consoleSlower = { x0: consoleDetail.x0, x1: 0.235, y0: consoleTurnRow.y0, y1: consoleTurnRow.y1 }
let consoleHold = { x0: 0.245, x1: 0.385, y0: consoleTurnRow.y0, y1: consoleTurnRow.y1 }
let consoleFaster = { x0: 0.395, x1: 0.475, y0: consoleTurnRow.y0, y1: consoleTurnRow.y1 }
let consolePace = { x0: 0.49, x1: consoleDetail.x1, y0: consoleTurnRow.y0, y1: consoleTurnRow.y1 }
// The list's row pitch, and the font's line height in ems (Inter's ascent and descent), which set each list text's
// line spacing so its lines fall on the rows the pointer's row read counts.
let consoleRowPitch = ((consoleList.y1 - consoleList.y0) / consoleRows)
let consoleFontLine = 1.21
let consoleNameEm = 0.019
let consoleGroupEm = 0.0125

function consoleMid(rect) = [((rect.x0 + rect.x1) / 2), ((rect.y0 + rect.y1) / 2)]
function consoleHalf(rect) = [((rect.x1 - rect.x0) / 2), ((rect.y1 - rect.y0) / 2)]
// A button's face less a margin, the box its label fits.
function consoleInset(rect) = {
  x0: (rect.x0 + 0.008)
  x1: (rect.x1 - 0.008)
  y0: (rect.y0 + 0.006)
  y1: (rect.y1 - 0.006)
}
// A rectangle as the fractions of the glass a pointer hit reads: x right from the glass's left edge, y down from its
// top edge.
function consoleRegion(id, rect, rows = 1) = {
  id: id
  left: ((rect.x0 + plinthGlassHalf[0]) / (2 * plinthGlassHalf[0]))
  top: ((plinthGlassHalf[1] - rect.y1) / (2 * plinthGlassHalf[1]))
  right: ((rect.x1 + plinthGlassHalf[0]) / (2 * plinthGlassHalf[0]))
  bottom: ((plinthGlassHalf[1] - rect.y0) / (2 * plinthGlassHalf[1]))
  rows: rows
}
// A filled rectangle on a display's glass, its corners rounded by `round`, in the world's frame. Its box reaches
// 8 cm either side of the glass, past any rounding, and only the glass wears its palette slot.
function consoleFill(display, rect, color, round = 0) = faceFill(
  displayWorld(display, plinthOnFace(consoleMid(rect)[0], consoleMid(rect)[1], displayGlassFront)),
  displayFaceTurn(display),
  [(displayScale * consoleHalf(rect)[0]), (displayScale * consoleHalf(rect)[1])],
  color,
  (displayScale * round),
  0.08
)
// Lettering in a rectangle on a display's glass: `em` in the plinth's units, `spacing` the line spacing, `wrap` breaking
// lines at the box's width and `markup` reading the substituted text's colour tags. A text fits its box.
function consoleText(display, rect, template, ink, em, align, wrap = false, markup = false, spacing = 1) = faceText(
  displayWorld(display, plinthOnFace(consoleMid(rect)[0], consoleMid(rect)[1], displayGlassFront)),
  displayFaceTurn(display),
  [(displayScale * consoleHalf(rect)[0]), (displayScale * consoleHalf(rect)[1])],
  template,
  ink,
  (displayScale * em),
  align,
  wrap,
  markup,
  spacing
)
// The list's lines, one a row: a row's title in its ink, read from a display's row cells (keyed `<display>-<row>`), and
// a row's group.
function consoleNameLine(display, row) = $"[color={{state.galleryRowInk.{display.id}-{row}}}]{{state.galleryRowName.{display.id}-{row}}}[/color]"
function consoleGroupLine(display, row) = $"{{state.galleryRowGroup.{display.id}-{row}}}"
function consoleNameLines(display) = reduce(
  range(0, consoleRows),
  "",
  (text, row) => ((row == 0) ? consoleNameLine(display, row) : $"{text}\n{consoleNameLine(display, row)}")
)
function consoleGroupLines(display) = reduce(
  range(0, consoleRows),
  "",
  (text, row) => ((row == 0) ? consoleGroupLine(display, row) : $"{text}\n{consoleGroupLine(display, row)}")
)
function consolePaints(display) = [
  // The elbow: the left column's head turning into the top bar, its inner corner a quarter round the field cuts.
  consoleFill(
    display,
    { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: 0.06, y1: consoleBar.y1 },
    consoleLook.frame,
    0.03
  )
  consoleFill(
    display,
    { x0: (consoleColumn.x0 + 0.03), x1: 0.3, y0: consoleBar.y0, y1: consoleBar.y1 },
    consoleLook.frame
  )
  consoleFill(
    display,
    { x0: consoleColumn.x1, x1: (consoleColumn.x1 + 0.03), y0: (consoleBar.y0 - 0.03), y1: consoleBar.y0 },
    consoleLook.frame
  )
  consoleFill(
    display,
    { x0: consoleColumn.x1, x1: (consoleColumn.x1 + 0.12), y0: (consoleBar.y0 - 0.12), y1: consoleBar.y0 },
    consoleLook.field,
    0.03
  )
  // The top bar's cap, which names the catalog, and the left column's buttons and foot.
  consoleFill(display, { x0: 0.33, x1: 0.72, y0: consoleBar.y0, y1: consoleBar.y1 }, consoleLook.frame, 0.02)
  consoleFill(display, consolePrev, consoleLook.cream, 0.012)
  consoleFill(display, consoleNext, consoleLook.teal, 0.012)
  consoleFill(
    display,
    { x0: consoleColumn.x0, x1: consoleColumn.x1, y0: -0.165, y1: -0.11 },
    consoleLook.terracotta,
    0.025
  )
  // The rule closing the list's foot, and the divider between the list and the chosen exhibit.
  consoleFill(display, { x0: (consoleColumn.x1 + 0.025), x1: 0.72, y0: -0.165, y1: -0.153 }, consoleLook.frame, 0.006)
  consoleFill(display, { x0: 0.125, x1: 0.133, y0: consoleList.y0, y1: consoleList.y1 }, consoleLook.frame, 0.004)
  consoleText(
    display,
    { x0: 0.35, x1: 0.70, y0: consoleBar.y0, y1: consoleBar.y1 },
    $"{galleryCount} shapes to explore",
    consoleLook.ink,
    0.02,
    "right"
  )
  consoleText(
    display,
    { x0: (consolePrev.x0 + 0.01), x1: (consolePrev.x1 - 0.01), y0: consolePrev.y0, y1: (consolePrev.y0 + 0.035) },
    "Previous",
    consoleLook.ink,
    0.017,
    "right"
  )
  consoleText(
    display,
    { x0: (consoleNext.x0 + 0.01), x1: (consoleNext.x1 - 0.01), y0: consoleNext.y0, y1: (consoleNext.y0 + 0.035) },
    "Next",
    consoleLook.ink,
    0.017,
    "right"
  )
  // The list: every row's title in its ink (the chosen one lit), and its group beside it.
  consoleText(
    display,
    { x0: consoleList.x0, x1: -0.095, y0: consoleList.y0, y1: consoleList.y1 },
    consoleNameLines(display),
    consoleLook.dim,
    consoleNameEm,
    "left",
    markup: true,
    spacing: (consoleRowPitch / (consoleNameEm * consoleFontLine))
  )
  consoleText(
    display,
    { x0: -0.09, x1: consoleList.x1, y0: consoleList.y0, y1: consoleList.y1 },
    consoleGroupLines(display),
    consoleLook.quiet,
    consoleGroupEm,
    "right",
    spacing: (consoleRowPitch / (consoleGroupEm * consoleFontLine))
  )
  // The chosen exhibit: its title, its group and place in the catalog, and its note.
  consoleText(
    display,
    { x0: consoleDetail.x0, x1: consoleDetail.x1, y0: 0.05, y1: 0.105 },
    $"{{state.galleryScreenTitle.{display.id}}}",
    consoleLook.lit,
    0.034,
    "left"
  )
  consoleText(
    display,
    { x0: consoleDetail.x0, x1: consoleDetail.x1, y0: 0.022, y1: 0.048 },
    $"{{state.galleryScreenGroup.{display.id}}}   {{state.galleryPlace.{display.id}}} / {galleryCount}",
    consoleLook.quiet,
    0.015,
    "left"
  )
  consoleText(
    display,
    { x0: consoleDetail.x0, x1: consoleDetail.x1, y0: (consoleTurnRow.y1 + 0.01), y1: 0.016 },
    $"{{state.galleryScreenNote.{display.id}}}",
    consoleLook.dim,
    0.0145,
    "left",
    wrap: true
  )
  // The turntable's row: slower, pause or play (the label names what a tap does), faster, and the pace it keeps.
  consoleFill(display, consoleSlower, consoleLook.teal, 0.012)
  consoleFill(display, consoleHold, consoleLook.cream, 0.012)
  consoleFill(display, consoleFaster, consoleLook.teal, 0.012)
  consoleText(display, consoleInset(consoleSlower), "<", consoleLook.ink, 0.02, "center")
  consoleText(
    display,
    consoleInset(consoleHold),
    $"{{state.galleryTurnHold.{display.id}}}",
    consoleLook.ink,
    0.017,
    "center"
  )
  consoleText(display, consoleInset(consoleFaster), ">", consoleLook.ink, 0.02, "center")
  consoleText(
    display,
    consoleInset(consolePace),
    $"{{state.galleryTurnPace.{display.id}}}",
    consoleLook.quiet,
    0.015,
    "right"
  )
]
// The pointer surface a display's screen placement carries: the glass's front face, carried from the plinth's author
// frame into the placement's (author x and z point the other way), with the list and the buttons as its regions.
let consolePointer = {
  origin [0, plinthOnFace(0, 0, displayGlassFront)[1], (0 - plinthOnFace(0, 0, displayGlassFront)[2])]
  right [-1, 0, 0]
  up [0, plinthTiltCos, plinthTiltSin]
  halfWidth: plinthGlassHalf[0]
  halfHeight: plinthGlassHalf[1]
  regions [
    consoleRegion("list", consoleList, consoleRows)
    consoleRegion("prev", consolePrev)
    consoleRegion("next", consoleNext)
    consoleRegion("slower", consoleSlower)
    consoleRegion("hold", consoleHold)
    consoleRegion("faster", consoleFaster)
  ]
}
// A display's screen in terminal mode: the hidden console its terminal opens (../standard/contexts/terminal-console.puck,
// gallery/gallery.puck's galleryConsole), which the screen placement responds with while the display's
// `terminalConsoleOpen` cell holds 1. It is the same glass in the console's own palette under a deep-teal field lit as the
// interface's controls are (consoleLook.terminal), with scanlines across it, an ochre rule over and under the text, the
// display's group and terminal number small in the top corner, the
// last line run in teal over its reply in cream, and the line being typed in amber behind its prompt. Its type is about
// half again the list's, so someone standing a step or two behind the one typing reads along.
let terminalScreenText = { x0: -0.7, x1: 0.7, y0: -0.105, y1: 0.143 }
let terminalScreenPrompt = { x0: -0.7, x1: 0.7, y0: -0.172, y1: -0.121 }
let terminalScreenEm = 0.0185
let terminalScreenPromptEm = 0.03
// The scanlines, bands of the world's height laid over the glass: their half thickness and pitch, in metres.
let terminalScanHalf = 0.0009
let terminalScanPitch = 0.006
function terminalScreenPaints(display, number) = [
  consoleFill(
    display,
    { x0: (0 - plinthGlassHalf[0]), x1: plinthGlassHalf[0], y0: (0 - plinthGlassHalf[1]), y1: plinthGlassHalf[1] },
    consoleLook.terminal
  )
  {
    type: "Box"
    position: displayWorld(display, plinthOnFace(0, 0, displayGlassFront))
    scale [3, terminalScanHalf, 3]
    color: consoleLook.scan
    repeat { cell [0, terminalScanPitch, 0] }
  }
  consoleFill(display, { x0: consoleColumn.x0, x1: consoleDetail.x1, y0: 0.15, y1: 0.156 }, consoleLook.frame, 0.003)
  consoleFill(display, { x0: consoleColumn.x0, x1: consoleDetail.x1, y0: -0.117, y1: -0.111 }, consoleLook.frame, 0.003)
  consoleText(
    display,
    { x0: 0.3, x1: consoleDetail.x1, y0: 0.157, y1: 0.177 },
    $"{display.title}  {number}",
    consoleLook.teal,
    0.012,
    "right"
  )
  consoleText(
    display,
    terminalScreenText,
    terminalConsoleScreen(number, echo: consoleLook.teal),
    consoleLook.cream,
    terminalScreenEm,
    "left",
    markup: true,
    spacing: (((terminalScreenText.y1 - terminalScreenText.y0) / (terminalConsoleReplyLines + 1)) /
      (terminalScreenEm * consoleFontLine))
  )
  consoleText(
    display,
    terminalScreenPrompt,
    terminalConsolePrompt(number),
    consoleLook.lit,
    terminalScreenPromptEm,
    "left"
  )
]
// One screen creation over a display's console glass, wearing `paints`.
template consoleScreen(name, paints) {
  prototype name {
    document {
      name: name
      schema: "puck.creation.v2"
      palette [consoleGlass with { paints: paints }]
      shape Box "glass" {
        material: 0
        position: (plinthOnFace(0, 0, displayGlassOut) * [-1, 1, -1])
        rotation: compose(rotate([0, 1, 0], 180), plinthFace)
        scale [plinthGlassHalf[0], plinthGlassHalf[1], plinthGlassDepth]
        rounding: 0.01
        // The interface the glass shows lights the plinth's pad and the exhibit before it, in its own colours.
        lightsAs: Face
      }
    }
  }
}
// A display's two screens: its interface, and its terminal mode for terminal `number`.
template displayScreen(display, number) {
  consoleScreen(name: $"gallery-screen-{display.id}", paints: consolePaints(display))
  consoleScreen(name: $"gallery-screen-{display.id}-terminal", paints: terminalScreenPaints(display, number))
}

// The gallery's console commands, composed from existing verbs (docs/reference/commands.md): walk to an exhibit and
// show it on its display, isolate an exhibit's shape, flag one that looks wrong (world.flag writes the record and its
// capture into the package's git-ignored flags folder), cycle the debug views, and slice the exhibit at hand's field
// into the package's slices folder. world.debug-view and world.slice.save exist only in a rendered World, so a headless
// host refuses those two commands when they run.
let galleryCommands = [
  {
    name: "gallery.go"
    help: "Walks a body to an exhibit's display and shows that exhibit on its turntable (its prototype name), to the entrance (gallery, the default), or onto level 1's toybox floor (toybox), where it takes the size its pass gives it, and returns the view to the chase camera."
    parameters [
      {
        name: "exhibit"
        kind: Choice
        values: concat(["gallery", "toybox"], map(galleryCatalog, entry => entry.name))
        default: "gallery"
      }
      { name: "body", kind: Body, default: "0" }
    ]
    lines [
      "body.pose spawn:{exhibit} {body}"
      "world.state.cell.set galleryPick {exhibit} 1"
      "view.override camera auto"
      "view.override layout play"
    ]
  }
  {
    name: "gallery.show"
    help: "Shows an exhibit on its display's turntable (its prototype name) without moving anyone, as stepping its console's list does."
    parameters [
      { name: "exhibit", kind: Choice, values: map(galleryCatalog, entry => entry.name) }
    ]
    lines [
      "world.state.cell.set galleryPick {exhibit} 1"
    ]
  }
  {
    name: "gallery.isolate"
    help: "Draws one exhibit's named shape alone (its subject by default); gallery.isolate off restores every shape."
    parameters [
      { name: "exhibit", kind: Text }
      { name: "shape", kind: Text, default: "subject" }
    ]
    lines [
      "view.isolate {exhibit} {shape}"
    ]
  }
  {
    name: "gallery.flag"
    help: "Flags an exhibit that looks wrong (near, the default, names the display the seat stands at; its capture shows the exhibit on the turntable): world.flag writes worlds/debug/flags/<exhibit>.json (the note, the seat's pose and camera) and captures the view to <exhibit>.png beside it, for an agent to read back."
    parameters [
      { name: "exhibit", kind: Text, default: "near" }
      { name: "note", kind: Text, default: "looks-wrong" }
    ]
    lines [
      "world.flag {exhibit} {note}"
    ]
  }
  {
    name: "gallery.view"
    help: "Steps every camera to the next debug view (off, depth, normals, raydir, material-id, visibility, motion, sky-cost, ao, shadow, indirect, then off again), or selects one by name."
    parameters [
      {
        name: "view"
        kind: Choice
        values [
          "next", "off", "depth", "normals", "raydir", "material-id", "visibility", "motion", "sky-cost", "ao",
          "shadow", "indirect"
        ]
        default: "next"
      }
    ]
    lines [
      "world.debug-view {view}"
    ]
  }
  {
    name: "gallery.slice"
    help: "Cuts the field of the exhibit on a display's turntable (near, the default, names the display the seat stands at; a turntable is display-<id>) on a plane through its placement and writes the distance diagnostic to worlds/debug/slices/<display>-<axis>.png: by default the level plane through the exhibit's middle, the offset in metres over the turntable's placement; an x or z cut wants offset 0 to pass through its centre."
    parameters [
      { name: "exhibit", kind: Text, default: "near" }
      { name: "axis", kind: Choice, values ["y", "x", "z"], default: "y" }
      { name: "offset", kind: Number, default: $"{1.2 * displayExhibitScale}" }
    ]
    lines [
      "world.slice.save {exhibit} {axis} offset {offset}"
    ]
  }
]

// Each of `displays`, which its world places beside the rules that work it (shape-station.puck): its plinth, solid, and
// its screen over the console's glass, both at `displayScale`, the screen carrying the console's pointer surface
// (consolePointer); and the exhibit on its turntable, which shows the display's first exhibit and, through its response
// facet, whichever exhibit of the whole catalog the display's `gallerySelect` cell holds, so any display can show any
// exhibit.
template displayPlacements(displays = galleryDisplays) {
  for (display, index) in displays {
    placement $"display-{display.id}-plinth" {
      prototype: "gallery-display"
      if display.parent != null {
        parent: display.parent
      }
      position [display.x, displayFloor(display), display.z]
      yawDegrees: display.yaw
      scale: displayScale
      solid
    }
    placement $"display-{display.id}-screen" {
      prototype: $"gallery-screen-{display.id}"
      if display.parent != null {
        parent: display.parent
      }
      position [display.x, displayFloor(display), display.z]
      yawDegrees: display.yaw
      scale: displayScale
      pointer: consolePointer
      // The display's terminal (its place in `displays` from 1) turns the screen into its hidden console.
      respond [
        {
          when: state(state: terminalConsoleOpen, key: $"{index + 1}", comparison: Equal, value: 1)
          prototypeId: $"gallery-screen-{display.id}-terminal"
        }
      ]
    }
  }
  for display in displays {
    placement $"display-{display.id}" {
      prototype: galleryCatalog[displayDefault(display)].name
      if display.parent != null {
        parent: display.parent
      }
      position [display.x, (displayFloor(display) + displayExhibitDrop), display.z]
      yawDegrees: display.yaw
      scale: displayExhibitScale
      // The turntable: the exhibit turns by the display's rate a gallery second from its phase (gallery/gallery.puck's
      // turntable rule rebases the phase whenever its console changes the rate, so the angle never jumps).
      turn {
        clock: "state.galleryClock"
        rate: $"state.galleryTurnRate.{display.id}"
        phase: $"state.galleryTurnPhase.{display.id}"
      }
      respond: map(
        filter(galleryCatalog, entry => (entry.index != displayDefault(display))),
        entry => {
          when: state(state: gallerySelect, key: display.id, comparison: Equal, value: entry.index)
          prototypeId: entry.name
        }
      )
    }
  }
}

// The displays' state, which gallery/gallery.puck declares beside the rules that write it. A display's `gallerySelect`
// cell holds the catalog index of the exhibit its turntable shows, any of the catalog's; its console's list, gallery.go,
// gallery.show, gallery.step and the tour write it, and its screen cells (`galleryScreen*`, `galleryPlace`, its place in
// the catalog from 1) follow it. `galleryTitles`, `galleryNotes` and `galleryGroups` hold every exhibit's copy and its
// display's title by catalog index, which the console rules copy from; `galleryPick` is the mailbox gallery.go and
// gallery.show write an exhibit's name to (`gallery`, the entrance, stands at no display).
//
// A console's list: `galleryScroll` is the catalog index its top row shows, and the row cells (keyed `<display>-<row>`)
// hold each row's catalog index, title, group and ink, the chosen row lit; `galleryRowsView` is the scroll and the
// choice the rows were last written for, packed as one number (consoleView). A press on the list records the row it landed on, the
// scroll it started from and the last row it passed (`galleryPress`, `galleryPressRow`, `galleryPressScroll`,
// `galleryDragRow`), and `galleryDragged` whether it moved; `galleryStepAt` is the mailbox gallery.step writes a step to.
//
// The motion exhibits' controls, which a world declares (galleryState). Every driver in the motion rows reads `galleryClock`, gallery seconds advancing at the
// row's rate; a rate of zero freezes every pose where it stands, and writing the cell scrubs it. Each driver is gated on
// `galleryMotion.all` and on its exhibit's own `galleryMotion` key: a zero eases that exhibit back to its rest pose.
// `galleryInputs` holds text cells three exhibits read: `probe` places motion-state-blend's sphere, `reach` is the world
// point motion-ik's arm reaches for (before its turntable), and `tint` colours shape-state-color. shapes.md gives the
// console lines.

// The scroll a display's list boots at: its default exhibit on the top row, unless the catalog's end comes first.
function displayScroll(display) = minimum(displayDefault(display), consoleScrollLast)
// A console's scroll and choice packed as one number, so one cell says what its rows were written for.
let consoleViewStride = 4096
function consoleView(scroll, chosen) = ((scroll * consoleViewStride) + chosen)
// Every row of every console's list as it boots: its cells' key, and the catalog entry it shows.
function consoleSlotsOf(displays) = flatMap(
  displays,
  display => map(range(0, consoleRows), row => {
    key: $"{display.id}-{row}"
    entry: galleryCatalog[(displayScroll(display) + row)]
    chosen: ((displayScroll(display) + row) == displayDefault(display))
  })
)

// One cell a display of `displays` (Int unless `kind` says otherwise), keyed by its id and seeded from `values`, a value a
// display in `displays`' order.
template displayCells(displays, name, values, kind = "Int") {
  row {
    name: name
    kind: kind
    capacity: length(displays)
    cells: map(range(0, length(displays)), index => { key: displays[index].id, value: values[index] })
  }
}

// The state of `displays` and of the catalog their consoles list: the stations' rows, then every exhibit's copy.
template displayState(displays = galleryDisplays) {
  let consoleSlots = consoleSlotsOf(displays)
  displayCells(displays: displays, name: "gallerySelect", values: map(displays, display => displayDefault(display)))
  displayCells(displays: displays, name: "galleryShownAt", values: map(displays, display => displayDefault(display)))
  displayCells(
    displays: displays,
    name: "galleryPlace",
    values: map(displays, display => (displayDefault(display) + 1))
  )
  displayCells(displays: displays, name: "galleryScroll", values: map(displays, display => displayScroll(display)))
  displayCells(
    displays: displays,
    name: "galleryRowsView",
    values: map(displays, display => consoleView(displayScroll(display), displayDefault(display)))
  )
  displayCells(displays: displays, name: "galleryPress", values: map(displays, display => 0))
  displayCells(displays: displays, name: "galleryPressRow", values: map(displays, display => -1))
  displayCells(displays: displays, name: "galleryPressScroll", values: map(displays, display => displayScroll(display)))
  displayCells(displays: displays, name: "galleryDragRow", values: map(displays, display => -1))
  displayCells(displays: displays, name: "galleryDragged", values: map(displays, display => 0))
  displayCells(displays: displays, name: "galleryStepAt", values: map(displays, display => 0))
  // The turntable: its signed pace (turntableSpeeds either way), whether it turns, the rate and phase its turn facet
  // reads, the mailbox its buttons, the gallery.turn commands and the display console write (galleryTurnCodes) with the
  // pace a pace request asks for, and the two labels its console shows.
  displayCells(displays: displays, name: "galleryTurnSpeed", values: map(displays, display => turntableSpeed))
  displayCells(displays: displays, name: "galleryTurnPlay", values: map(displays, display => 1))
  displayCells(
    displays: displays,
    name: "galleryTurnRate",
    kind: "Fixed",
    values: map(displays, display => $"{turntableSpeed * turntableRate}")
  )
  displayCells(displays: displays, name: "galleryTurnPhase", kind: "Fixed", values: map(displays, display => "0"))
  displayCells(displays: displays, name: "galleryTurnNext", kind: "Fixed", values: map(displays, display => "0"))
  displayCells(displays: displays, name: "galleryTurnAt", values: map(displays, display => 0))
  displayCells(displays: displays, name: "galleryTurnTo", values: map(displays, display => 0))
  displayCells(
    displays: displays,
    name: "galleryTurnHold",
    kind: "Text",
    values: map(displays, display => turntableHolds[1])
  )
  displayCells(
    displays: displays,
    name: "galleryTurnPace",
    kind: "Text",
    values: map(displays, display => turntablePace(turntableSpeed))
  )
  row {
    name: "galleryTurnHolds"
    kind: Text
    capacity: 2
    cells: map(range(0, 2), play => { key: $"{play}", value: turntableHolds[play] })
  }
  // The rate each signed speed turns at, in turns a gallery second, and its label, keyed by the speed.
  row {
    name: "galleryTurnRates"
    kind: Fixed
    capacity: (2 * turntableSpeeds)
    cells: map(
      filter(range(0 - turntableSpeeds, turntableSpeeds + 1), speed => (speed != 0)),
      speed => { key: $"{speed}", value: $"{speed * turntableRate}" }
    )
  }
  row {
    name: "galleryTurnPaces"
    kind: Text
    capacity: (2 * turntableSpeeds)
    cells: map(
      filter(range(0 - turntableSpeeds, turntableSpeeds + 1), speed => (speed != 0)),
      speed => { key: $"{speed}", value: turntablePace(speed) }
    )
  }
  // One cell a row of every console's list, keyed `<display>-<row>`, seeded from each row's boot slot.
  row {
    name: "galleryRowIndex"
    kind: Int
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: slot.entry.index })
  }
  row {
    name: "galleryRowName"
    kind: Text
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: galleryCopy[slot.entry.name].title })
  }
  row {
    name: "galleryRowGroup"
    kind: Text
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: galleryGroupOf(slot.entry).title })
  }
  row {
    name: "galleryRowInk"
    kind: Text
    capacity: length(consoleSlots)
    cells: map(consoleSlots, slot => { key: slot.key, value: (slot.chosen ? consoleLook.lit : consoleLook.dim) })
  }
  // The two inks of a list's rows (consoleLook), which the rows rule copies into each row's ink cell.
  row {
    name: "galleryInks"
    kind: Text
    capacity: 2
    cells [{ key: "lit", value: consoleLook.lit }, { key: "dim", value: consoleLook.dim }]
  }
  row {
    name: "galleryTitles"
    kind: Text
    capacity: length(galleryCatalog)
    cells: map(galleryCatalog, entry => { key: $"{entry.index}", value: galleryCopy[entry.name].title })
  }
  row {
    name: "galleryNotes"
    kind: Text
    capacity: length(galleryCatalog)
    cells: map(galleryCatalog, entry => { key: $"{entry.index}", value: galleryCopy[entry.name].note })
  }
  row {
    name: "galleryGroups"
    kind: Text
    capacity: length(galleryCatalog)
    cells: map(galleryCatalog, entry => { key: $"{entry.index}", value: galleryGroupOf(entry).title })
  }
  row {
    name: "galleryScreenTitle"
    kind: Text
    capacity: length(displays)
    cells: map(
      displays,
      display => { key: display.id, value: galleryCopy[galleryCatalog[displayDefault(display)].name].title }
    )
  }
  row {
    name: "galleryScreenNote"
    kind: Text
    capacity: length(displays)
    cells: map(
      displays,
      display => { key: display.id, value: galleryCopy[galleryCatalog[displayDefault(display)].name].note }
    )
  }
  row {
    name: "galleryScreenGroup"
    kind: Text
    capacity: length(displays)
    cells: map(
      displays,
      display => { key: display.id, value: galleryGroupOf(galleryCatalog[displayDefault(display)]).title }
    )
  }
  row {
    name: "galleryPick"
    kind: Int
    capacity: (length(galleryCatalog) + 2)
    cells: concat(
      [{ key: "gallery", value: 0 }, { key: "toybox", value: 0 }],
      map(galleryCatalog, entry => { key: entry.name, value: 0 })
    )
  }
}

// The motion exhibits' controls and the cells they read. The reach target is a point in the world before the turntable
// motion-ik is home to, among `displays`.
template galleryState(displays = galleryDisplays) {
  let reachPoint = exhibitWorld(stationOf(displays, "motion-ik"), [-0.35, 1.45, 0.25])

  slot galleryClock = 0.5 advance(perSecond: 1)

  table galleryMotion {
    all = 1
    spin = 1
    rock = 1
    slide = 1
    chain = 1
    blend = 1
    carve = 1
    mirror = 1
    polar = 1
    paint = 1
    inset = 1
    twist = 1
    bend = 1
    pulse = 1
    cells = 1
    volume = 1
    ik = 1
    nod = 1
    three = 1
    seamPaint = 1
  }

  table galleryInputs {
    probe = "[0.3, 1.35, 0.05]"
    reach = $"[{reachPoint[0]}, {reachPoint[1]}, {reachPoint[2]}]"
    tint = "#D9822B"
  }
}

// The one driver every motion exhibit runs on: the gallery clock times `cadence` radians a gallery second, gated on
// the whole gallery and on the exhibit's own key, its weight easing over `ease` seconds as a gate opens or closes.
template clockDriver(key, cadence = 1, ease = 0.3) {
  drivers [
    {
      name: "clock"
      signal: "state.galleryClock"
      cadence: cadence
      blendInSeconds: ease
      blendOutSeconds: ease
      when [
        "state.galleryMotion.all"
        $"state.galleryMotion.{key}"
      ]
    }
  ]
}

