// Two seats' phrases judged independently in the same ticks (`puck test worlds/debug/instrument-judge-seats-tests.puck
// --reproduce`): one expansion of the instrument for two local seats, one score. Seat 1 plays through its bindings. Seat 2
// plays through `body.press`, which presses a semantic channel on its body at the owner's current mapping, because a
// keyboard signal reaches only the first seat. A press scheduled in tick T lands in interval T plus 2 (see the 30 Hz
// scenarios).
schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "instrument-judge-seats-tests"
import "../standard/standard"
import "../standard/instrument"
import "score"

simulation {
  rateHz: 30
}
bodies {
  localSeats: 2
  seatActivation [Eager, Eager]
  seatSpawns ["stage", "stage"]
}
inputModes {
  global []
  families [instrumentFamily()]
}

instrumentPlay(music: score, seats: 2)

test "two seats play in the same ticks and each is graded on its own presses" {
  when {
    ticks 4
    seat1: player.signal keyboard.z press
    seat1: player.signal keyboard.x press
    seat2: body.press breath 1 5 1
    ticks 9
    seat1: player.signal keyboard.j press at:0
    seat2: body.press vent4 1 0.1 1
    ticks 15
    seat1: player.signal keyboard.i press at:0.03225
    seat2: body.press vent4 1 0.1 1
    ticks 15
    seat1: player.signal keyboard.l press at:0
    ticks 3
  }
  expect {
    bodyState(body, 1, breathing) == 1
    judge.grade1_0 == 3
    judge.grade1_1 == 2
    judge.grade1_2 == 3
    judge.strength1 == 8
    judge.step1 == 3
    judge.status1 == 1
    judge.grade2_0 == 0
    judge.grade2_1 == 0
    judge.misses2 == 2
    judge.strength2 == 0
    judge.status2 == 2
  }
}
