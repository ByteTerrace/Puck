// The city: a destination of the debug world's painting wing, a town on a river bend that stress-tests how Puck scales
// with content (docs/plans/city.md). The debug world's city painting (`painting-city`, hung on the south wall of the
// wing, paintings.puck) opens onto the arrival frame here: a body walking into the painting comes out of the arrival
// frame walking -Z, onto the avenue that leads into the square. Turn round and the arrival frame is the way back. Boot
// the debug world, never this one: it is reached through the debug world's painting.
//
// The town in blockout, its four districts around one square, each a navigation domain of its own (x and z in metres,
// -Z away from the arrival frame):
//
//   the square and market   x -30 .. 30, z -20 .. -80, inside a ring road; the arrival frame at z -6 north of it
//   the terraces            x -150 .. -46, z 40 .. -200: rows of houses with 4 m lanes between them
//   the works               x 46 .. 150, z 40 .. -100: workshops either side of the works road (z -45 .. -55)
//   the quay                x -46 .. 150, z -100 .. -205: warehouses along the river, the avenue south to the bridge
//
// The river runs east to west from z -205 to -245, and a bridge carries the avenue over it to the far bank. A cross
// street (z -125 .. -135) runs the town's width.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "city"

// The debug world's chrome, so a traveller keeps its bar and wheel here, and the Moth's suit toggle and size.
import "moth-controls"
import "suit"
import "size"
import "painting-kit"
import "place-kit"
import "walkers"
import "city-day"
import "../standard/bounds"
import "../standard/domains"
import "../standard/citizen"
import "../standard/vehicle"
import "../standard/market"
import "../standard/styles"

// The city draws no HUD panels; controls.puck supplies its cursor.
hud {
  panels []
}

metadata {
  title: "City"
  description: "A destination of the debug world painting wing: a town on a river bend, with a market square, terraces, works and a quay, and a frame back to the debug world."
}

// A traveller from the debug world arrives here, and the debug world's window onto the city observes it whole.
admission [
  {
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 8
        capability: Drive
        exclusive: true
      }
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
  }
]

references [
  {
    document: "debug"
    name: "debug"
  }
]

destinations [
  {
    durability: persisted
    name: "debug"
    reference: "debug"
    scope: global
  }
]

views {
  nestingDepth: 3
}

// The city's cel look (../standard/styles.puck): the standard band with a warmer held shade, a dusky mauve a step
// below the lit cream and ochre, so the town reads painted rather than lit. Its ink is the standard line at a town's
// scale: a heavier weight, so a house across the square keeps a drawn outline, and a skyline that stays lined. The
// walls and the timber take the ink's strokes in their shade (cityWall); the ground, the awnings and the roofs are
// lined and left clean (cityCel), so the hatching marks the masses and the streets stay open.
let cityStyle = celStyle with {
  shadowTint [0.78, 0.62, 0.74]
  restore: 0.65
  ink: standardInk with {
    weight: 0.07
    bold: 3
    far: 0.6
    fold: 0.7
    tint [0.13, 0.1, 0.16]
    hatch: 0.32
    hatchPitch: 0.4
    hatchWidth: 0.12
    hatchSoftness: 0.3
  }
}
function cityCel(base) = celMaterial(base, cityStyle)
function cityWall(base) = celHatched(base, cityStyle)

// The palette every city prototype shares, by slot: cel paint on everything but the river, and the warm glow of a lit
// window.
let cityPalette = [
  cityWall({ color: "#EBDDBF", roughness: 0.85 })
  cityWall({ color: "#D9A55B", roughness: 0.85 })
  cityCel({ color: "#2F7F7A", roughness: 0.6, specular: 0.15 })
  cityWall({ color: "#B9A88E", roughness: 0.9 })
  cityCel({ color: "#5C5A58", roughness: 0.95 })
  cityCel({ color: "#C9BFAE", roughness: 0.9 })
  { color: "#3D7C8C", roughness: 0.15, specular: 0.5 }
  cityWall({ color: "#8A5A3C", roughness: 0.8 })
  { color: "#FFD9A0", emissive: 160, roughness: 0.4 }
]
let cream = 0
let ochre = 1
let teal = 2
let stone = 3
let road = 4
let paving = 5
let river = 6
let timber = 7
let windowGlow = 8

// A gable's ridge box turned 45 degrees about Z: its upper half stands over the walls as a roof whose ridge runs along Z.
let gableTurn = [0, 0, 0.382683, 0.92388]

// The terraces' houses: lots 10 m wide and 8 m deep on a 14 by 12 m pitch, in rows that leave the cross street clear.
// Each lot's height and wall colour cycle through the variants, so neighbours differ.
let houseHeights = [7, 10, 13]
let houseTones = [{ name: "cream", slot: cream }, { name: "ochre", slot: ochre }]
let terraceColumns = map(range(0, 7), c => -141 + 14 * c)
let terraceRows = flatMap(range(0, 20), k => ((k == 13) or (k == 14)) ? [] : [30 - 12 * k])
let terraceLots = flatMap(range(0, 7), c => map(range(0, 18), r => {
  id: $"house-{c}-{r}"
  x: terraceColumns[c]
  z: terraceRows[r]
  height: houseHeights[(2 * c + r) % 3]
  tone: houseTones[(c + r) % 2].name
}))

// The works' workshops, 22 by 16 m, three across and four deep about the works road; the quay's warehouses, 18 by 12 m,
// six across in two rows; the civic halls west of the avenue.
let shedLots = flatMap(map(range(0, 3), c => 62 + 30 * c), x => map([20, -2, -26, -72], z => { x: x, z: z, yaw: (z == -72) ? 180 : 0 }))
let warehouseLots = flatMap(map(range(0, 6), c => 20 + 24 * c), x => map([-160, -190], z => { x: x, z: z }))
let hallLots = map([-110, -160, -190], z => { x: -22, z: z })

// The market's stalls: twelve round the fountain, 18 m out, every other one under a teal awning.
let stallCount = 12
let stallRing = map(range(0, stallCount), i => {
  id: $"stall-{i}"
  index: i
  x: 18 * sine(i * 6.283185307179586 / stallCount)
  z: -50 + 18 * cosine(i * 6.283185307179586 / stallCount)
  yaw: i * 360 / stallCount
  awning: (i % 2 == 0) ? "teal" : "ochre"
})

// The roads: the ring round the square, the avenue south to the bridge, the cross street and the works road, each a
// strip 2 cm proud of the ground (x0, x1, z0, z1).
let roadStrips = [
  { id: "ring-north", x0: -40, x1: 40, z0: -20, z1: -10 }
  { id: "ring-south", x0: -40, x1: 40, z0: -90, z1: -80 }
  { id: "ring-west", x0: -40, x1: -30, z0: -80, z1: -20 }
  { id: "ring-east", x0: 30, x1: 40, z0: -80, z1: -20 }
  { id: "avenue", x0: -5, x1: 5, z0: -205, z1: -90 }
  { id: "cross-street", x0: -150, x1: 150, z0: -135, z1: -125 }
  { id: "works-road", x0: 40, x1: 150, z0: -55, z1: -45 }
  { id: "quay-lane", x0: 30, x1: 40, z0: -135, z1: -90 }
  { id: "east-lane", x0: 140, x1: 150, z0: -135, z1: -45 }
]

// The districts' navigation domains, 1 m cells on whole-metre origins so neighbouring grids share cells where they
// overlap, each reaching a few metres into its neighbours so a route crosses between them. The four are one `pavement`
// network of shared domains: a citizen heading to an anchor reads its step from that anchor's goal field, which
// crosses the districts at their shared cells, rather than searching a route of its own.
let pavement = { shared: true, network: "pavement" }



// The vehicles (../standard/vehicle.puck): carts lapping two loops of four corner stops, the ring road round the square
// and the works loop (the quay lane, the cross street, the east lane and the works road), at 8 m/s. They drive the
// `roads` network: a shared domain over each road strip, its 1 m cells sized for a vehicle, each a metre longer at both
// ends so neighbouring strips share cells at the corners, and never joined to the pavement. Their bodies sit below the
// citizens', so the citizens keep the top of the capacity.
let vehicleColors = ["#B5523B", "#2F7F7A", "#C98B2E", "#3E6E8E", "#6B8E4E", "#7A4E7E"]
let roadDomains = map(
  filter(roadStrips, strip => (strip.id != "avenue") and (strip.id != "cross-street")),
  strip => surfaceDomain(
    $"road-{strip.id}",
    [(strip.x0 - 1), 0.05, (strip.z0 - 1)],
    1,
    (strip.x1 - strip.x0 + 2),
    (strip.z1 - strip.z0 + 2),
    2.2,
    3,
    256,
    vehicleWalker
  ) with { shared: true, network: "roads" }
)
// The works loop's stretch of the cross street, from the quay lane to the east lane.
let worksCrossDomain = surfaceDomain("road-works-cross", [29, 0.05, -136], 1, 122, 12, 2.2, 3, 256, vehicleWalker) with {
  shared: true
  network: "roads"
}
let vehicleLoops = [
  { group: "ring", stops [[35, -85], [35, -15], [-35, -15], [-35, -85]], perSide: 10 }
  { group: "works", stops [[145, -130], [145, -50], [35, -50], [35, -130]], perSide: 15 }
]
// Each vehicle starts on a side of its loop, driving to the stop that ends the side.
let vehicleSpots = flatMap(vehicleLoops, loop => flatMap(range(0, 4), side => map(range(0, loop.perSide), k => {
  group: loop.group
  stops: loop.stops
  first: side
  x: loop.stops[(side + 3) % 4][0] + (loop.stops[side][0] - loop.stops[(side + 3) % 4][0]) * (k + 0.5) / loop.perSide
  z: loop.stops[(side + 3) % 4][1] + (loop.stops[side][1] - loop.stops[(side + 3) % 4][1]) * (k + 0.5) / loop.perSide
})))
let vehicleCount = length(vehicleSpots)

// The crossings: the ring road's four, at the middle of each side (the north one where the arrival ground meets the
// square), and the works road's, by the middle workshop. Each names its region (cx, cz and half extents hx, hz) and the
// approach box before it on the vehicles' side of travel (x0 .. x1, z0 .. z1): vehicles drive the ring anticlockwise,
// north up the east side, west along the north side, south down the west side and east along the south side.
let cityCrossings = [
  { group: "ring", region: "place-city-crossing-north", cx: 0, cz: -15, hx: 3, hz: 5, x0: 3, x1: 11, z0: -20, z1: -10 }
  { group: "ring", region: "place-city-crossing-west", cx: -35, cz: -50, hx: 5, hz: 3, x0: -40, x1: -30, z0: -47, z1: -39 }
  { group: "ring", region: "place-city-crossing-south", cx: 0, cz: -85, hx: 3, hz: 5, x0: -11, x1: -3, z0: -90, z1: -80 }
  { group: "ring", region: "place-city-crossing-east", cx: 35, cz: -50, hx: 5, hz: 3, x0: 30, x1: 40, z0: -61, z1: -53 }
  { group: "works", region: "place-city-crossing-works", cx: 90, cz: -50, hx: 3, hz: 5, x0: 93, x1: 101, z0: -55, z1: -45 }
]

navigation {
  domains: concat(
    [
      walkable("city-square", [-46, 0.05, -100], 1, 92, 100, 2.2, 3, 1024) with pavement
      walkable("city-terraces", [-150, 0.05, -205], 1, 114, 245, 2.2, 3, 1024) with pavement
      walkable("city-works", [36, 0.05, -100], 1, 114, 140, 2.2, 3, 1024) with pavement
      walkable("city-quay", [-46, 0.05, -205], 1, 196, 119, 2.2, 3, 1024) with pavement
    ],
    roadDomains,
    [worksCrossDomain]
  )
}

vehicleDesign(domain: "road-ring-north")
vehicleLooks(colors: vehicleColors)

// The market (../standard/market.puck): each stall sells to the Moth from a 2 by 2 m spot on the fountain side of its
// counter, 15.8 m out from the fountain, at 3 to 6 coins.
marketStalls(
  stalls: map(stallRing, stall => {
    key: stall.id
    x: round(15.8 * sine(stall.yaw * 3.141592653589793 / 180) * 1024) / 1024
    z: round((-50 + 15.8 * cosine(stall.yaw * 3.141592653589793 / 180)) * 1024) / 1024
    price: 3 + stall.index % 4
  }),
  clock: cityDay
)
vehicleRoutes(vehicles: map(range(0, vehicleCount), v => { key: 7 + vehicleCount - v, stops: vehicleSpots[v].stops, first: vehicleSpots[v].first }))
vehicleCrossings(
  vehicles: map(range(0, vehicleCount), v => { key: 7 + vehicleCount - v, group: vehicleSpots[v].group }),
  crossings: map(cityCrossings, c => {
    region: c.region
    group: c.group
    x0: c.x0
    x1: c.x1
    z0: c.z0
    z1: c.z1
    cx0: c.cx - c.hx
    cx1: c.cx + c.hx
    cz0: c.cz - c.hz
    cz1: c.cz + c.hz
  })
)


// The street lamps: a 4.2 m post with a lantern on each road's outer pavement and round the fountain, each a point light
// of `cityLampLumens` lumens that the city's clock (city-day.puck) turns on from dusk to dawn: 6 along each side of the
// ring, 7 down the avenue, 15 along the cross street, 6 by the works road, 10 on the quay's edge and 8 round the
// fountain. No lamp stands within 6 m of x 0, where the avenue runs and a traveller walks out of the arrival frame.
let cityLampLumens = 1200
let cityLampSpots = concat(
  map(range(0, 6), k => [(-30 + 12 * k), -8.5]),
  map(range(0, 6), k => [(-30 + 12 * k), -91.5]),
  map(range(0, 6), k => [41.5, (-80 + 12 * k)]),
  map(range(0, 6), k => [-41.5, (-80 + 12 * k)]),
  map(range(0, 7), k => [6.5, (-100 - 15 * k)]),
  map(range(0, 15), k => [(-150 + 20 * k), -123.5]),
  map(range(0, 6), k => [(46 + 20 * k), -43.5]),
  map(range(0, 10), k => [(-50 + 20 * k), -202.5]),
  map(range(0, 8), k => [(24 * sine((k + 0.5) * 0.7853981633974483)), (-50 + 24 * cosine((k + 0.5) * 0.7853981633974483))])
)

// The lamps' power: on (`cityLampLumens`) from half past six in the evening to six in the morning, off by day.
state {
  world [
    { name: "cityLamps", kind: "Fixed", value: "0" }
  ]
}
rule "city-lamps-on" {
  when cityDay >= (18.5 / 24) or cityDay < (6 / 24)
  mode: Edge
  cityLamps = cityLampLumens
}
rule "city-lamps-off" {
  when cityDay >= (6 / 24) and cityDay < (18.5 / 24)
  mode: Edge
  cityLamps = 0
}

// The citizens (../standard/citizen.puck). `citizenCount` of them, numbered down from the top of the body capacity
// above the Moth's eight (avatars/moth.puck), in blocks of one look each: look `b` is block `b`, its citizens standing
// in a disc on the open ground north of the square until the schedule sends them off.
let citizenCount = 1920
let citizenCoats = ["#B5523B", "#3E6E8E", "#6B8E4E", "#C98B2E", "#7A4E7E", "#D8CBB0"]
let citizenHats = ["#2F2A26", "#8A5A3C", "#2F7F7A", "#C9BFAE"]
let citizenLookCount = length(citizenCoats) * length(citizenHats)
let citizenBlock = citizenCount / citizenLookCount
let citizenTop = 7 + citizenCount + vehicleCount

// Each citizen's anchors: a home at a terrace house's front lane, work at a workshop, warehouse or civic hall door or
// behind a market stall, and the market inside the stall ring. Assignments step through the lists by coprime strides
// so neighbours in a block live, work and shop in different places.
let citizenHomes = map(terraceLots, lot => [lot.x, (lot.z - 6)])
let citizenWorks = concat(
  map(shedLots, lot => [lot.x, ((lot.yaw == 180) ? (lot.z + 10) : (lot.z - 10))]),
  map(warehouseLots, lot => [lot.x, (lot.z - 7.5)]),
  map(hallLots, lot => [lot.x, (lot.z - 11.5)]),
  map(stallRing, stall => [(20.5 * sine(stall.yaw * 3.141592653589793 / 180)), (-50 + 20.5 * cosine(stall.yaw * 3.141592653589793 / 180))])
)
let citizenMarkets = map(stallRing, stall => [(14 * sine(stall.yaw * 3.141592653589793 / 180)), (-50 + 14 * cosine(stall.yaw * 3.141592653589793 / 180))])
let citizenPeople = map(range(0, citizenCount), i => {
  key: citizenTop - i
  home: citizenHomes[i % length(citizenHomes)]
  work: citizenWorks[(7 * i + 3) % length(citizenWorks)]
  market: citizenMarkets[(5 * i) % length(citizenMarkets)]
  group: i % 12
})

bodies {
  capacity: 8 + citizenCount + vehicleCount
}

citizenDesign(domain: "city-square")
citizenLooks(coats: citizenCoats, hats: citizenHats)
citizenSchedule(
  people: citizenPeople,
  clock: cityDay,
  phases: [
    { from: 19, to: 7, anchor: "home" }
    { from: 7, to: 12, anchor: "work" }
    { from: 12, to: 13, anchor: "market" }
    { from: 13, to: 17, anchor: "work" }
    { from: 17, to: 19, anchor: "market" }
  ]
)

placements {
  policy {
    authoringHeadroomInstances: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  // The city's places (place-kit.puck): the whole town, each district, the market inside the square, the ground before
  // the arrival frame a crossing walks out onto, and the bridge.
  placement "place-city" {
    prototype: "place"
    position [0, 1.5, -80]
    region {
      halfExtents [150, 20, 125]
    }
  }
  placement "place-city-market" {
    prototype: "place"
    position [0, 1.5, -50]
    region {
      halfExtents [22, 3, 22]
    }
  }
  placement "place-city-square" {
    prototype: "place"
    position [0, 1.5, -50]
    region {
      halfExtents [40, 3, 40]
    }
  }
  placement "place-city-terraces" {
    prototype: "place"
    position [-98, 1.5, -80]
    region {
      halfExtents [52, 8, 120]
    }
  }
  placement "place-city-works" {
    prototype: "place"
    position [98, 1.5, -30]
    region {
      halfExtents [52, 8, 70]
    }
  }
  placement "place-city-quay" {
    prototype: "place"
    position [52, 1.5, -152]
    region {
      halfExtents [98, 8, 53]
    }
  }
  placement "place-city-arrival" {
    prototype: "place"
    position [0, 1.5, -8]
    region {
      halfExtents [2, 2, 2]
    }
  }
  // The crossings (../standard/vehicle.puck): a region over each place where the pavement meets a vehicle loop, which
  // holds an approaching vehicle while any body stands in it.
  for crossing in cityCrossings {
    placement $"{crossing.region}" {
      prototype: "place"
      position [crossing.cx, 1.5, crossing.cz]
      region {
        halfExtents [crossing.hx, 2, crossing.hz]
      }
    }
  }
  placement "place-city-bridge" {
    prototype: "place"
    position [0, 1.5, -225]
    region {
      halfExtents [6, 3, 22]
    }
  }

  // The city painting's counterpart, facing -Z like it, so a crossing turns the traveller about. Its glass is the way
  // back: walking +Z into it arrives out of the painting walking +Z, into the wing.
  placement "arrival" {
    prototype: "frame"
    position [0, 0, -6]
    yawDegrees: 0
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "painting-city/glass"
          destination: "debug"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "debug"
          fallback: "#10141B"
          projection: window
        }
      }
    ]
  }

  placement "roads" {
    prototype: "roads"
    position [0, 0, 0]
  }

  for lot in terraceLots {
    placement $"{lot.id}" {
      prototype: $"house-{lot.height}-{lot.tone}"
      position [lot.x, 0, lot.z]
      solid
    }
  }
  for lot in shedLots {
    placement $"shed-{lot.x}-{lot.z}" {
      prototype: "shed"
      position [lot.x, 0, lot.z]
      yawDegrees: lot.yaw
      solid
    }
  }
  for lot in warehouseLots {
    placement $"warehouse-{lot.x}-{lot.z}" {
      prototype: "warehouse"
      position [lot.x, 0, lot.z]
      solid
    }
  }
  for lot in hallLots {
    placement $"hall-{lot.z}" {
      prototype: "civic-hall"
      position [lot.x, 0, lot.z]
      solid
    }
  }

  // The citizens, a block of each look in a disc 10 m across: six blocks across and four deep from the ring road
  // south into the square, 9 m clear of the arrival frame, whose glass carries only the player's body back.
  for b in range(0, citizenLookCount) {
    placement $"citizens-{b}" {
      prototype: $"citizen-{floorDivide(b, length(citizenHats))}-{b % length(citizenHats)}"
      position [(-36 + 14.4 * (b % 6)), 0, (-20 - 7 * floorDivide(b, 6))]
      inhabit {
        count: citizenBlock
        kit: "citizen"
        look: $"citizen-{floorDivide(b, length(citizenHats))}-{b % length(citizenHats)}"
        source: producer(name: "citizenErrand")
        distribution {
          region: disc(radius: 5)
          fill {
            name: "additive"
            offset: 0
            step: 0.001
          }
        }
      }
    }
  }

  // The vehicles, one placement each at its spot on its loop, below the citizens in the body capacity.
  for (spot, v) in vehicleSpots {
    placement $"vehicle-{v}" {
      prototype: $"vehicle-{v % length(vehicleColors)}"
      position [spot.x, 0, spot.z]
      inhabit {
        count: 1
        kit: "vehicle"
        look: $"vehicle-{v % length(vehicleColors)}"
        source: producer(name: "vehicle")
        distribution {
          region: disc(radius: 0.01)
          fill {
            name: "additive"
            offset: 0
            step: 0.001
          }
        }
      }
    }
  }

  placement "fountain" {
    prototype: "fountain"
    position [0, 0, -50]
    solid
  }
  for stall in stallRing {
    placement $"{stall.id}" {
      prototype: $"stall-{stall.awning}"
      position [stall.x, 0, stall.z]
      yawDegrees: stall.yaw
      solid
    }
  }

  for (spot, i) in cityLampSpots {
    placement $"lamp-{i}" {
      prototype: "street-lamp"
      position [spot[0], 0, spot[1]]
      solid
    }
  }

  placement "bridge" {
    prototype: "bridge"
    position [0, 0, -225]
    solid
  }
}

prototypes {
  // The ground: the town's bank down to the river, the river's water 0.8 m below it, and the far bank, each given its
  // world bounds, which boundsBox turns into the creation's author frame.
  prototype "floor" {
    document {
      name: "floor"
      palette: cityPalette
      schema: "puck.creation.v1"
      boundsBox(label: "north-bank", x0: -150, x1: 150, y0: -2, y1: 0, z0: -205, z1: 40, slot: paving)
      boundsBox(label: "river", x0: -150, x1: 150, y0: -2, y1: -0.8, z0: -245, z1: -205, slot: river)
      boundsBox(label: "south-bank", x0: -150, x1: 150, y0: -2, y1: 0, z0: -280, z1: -245, slot: stone)
    }
  }

  prototype "frame" {
    document {
      arrivalFrame(color: "#2F7F7A", roughness: 0.5, specular: 0.25, post: 0.12)
    }
  }

  // The roads, every strip one shape 2 cm proud of the ground.
  prototype "roads" {
    document {
      name: "roads"
      palette: cityPalette
      schema: "puck.creation.v1"
      for strip in roadStrips {
        boundsBox(label: $"road-{strip.id}", x0: strip.x0, x1: strip.x1, y0: 0, y1: 0.02, z0: strip.z0, z1: strip.z1, slot: road)
      }
    }
  }

  // A terrace house of each height and wall colour: a 10 by 8 m block under a teal gable whose ridge runs along Z, with a
  // pair of lit windows on each upper storey of its door face.
  for height in houseHeights {
    for tone in houseTones {
      prototype $"house-{height}-{tone.name}" {
        document {
          name: $"house-{height}-{tone.name}"
          palette: cityPalette
          schema: "puck.creation.v1"
          shape Box "walls" {
            material: tone.slot
            position [0, (height / 2), 0]
            scale [5, (height / 2), 4]
          }
          shape Box "roof" {
            material: teal
            position [0, height, 0]
            rotation: gableTurn
            scale [3.6, 3.6, 4.3]
          }
          shape Box "door" {
            material: timber
            position [0, 1.1, 4]
            scale [0.6, 1.1, 0.06]
          }
          for storey in range(1, floor(height / 3.3)) {
            for side in [-1, 1] {
              shape Box $"window-{storey}-{side}" {
                material: windowGlow
                position [(2.5 * side), (3.3 * storey), 4]
                scale [0.5, 0.65, 0.05]
              }
            }
          }
        }
      }
    }
  }

  // A workshop: a 22 by 16 m ochre shed under a flat teal roof.
  prototype "shed" {
    document {
      name: "shed"
      palette: cityPalette
      schema: "puck.creation.v1"
      shape Box "walls" {
        material: ochre
        position [0, 4, 0]
        scale [11, 4, 8]
      }
      shape Box "roof" {
        material: teal
        position [0, 8.2, 0]
        scale [11.4, 0.2, 8.4]
      }
      shape Box "door" {
        material: timber
        position [0, 2, 8]
        scale [2.5, 2, 0.06]
      }
    }
  }

  // A warehouse on the quay: an 18 by 12 m stone store under a teal roof.
  prototype "warehouse" {
    document {
      name: "warehouse"
      palette: cityPalette
      schema: "puck.creation.v1"
      shape Box "walls" {
        material: stone
        position [0, 5, 0]
        scale [9, 5, 6]
      }
      shape Box "roof" {
        material: teal
        position [0, 10.2, 0]
        scale [9.4, 0.2, 6.4]
      }
      shape Box "door" {
        material: timber
        position [0, 2, 6]
        scale [2, 2, 0.06]
      }
    }
  }

  // A civic hall west of the avenue: a 24 by 20 m cream hall with a tower over its south end (shapes are in the author
  // frame, a half turn from the world's, so local +Z is world -Z).
  prototype "civic-hall" {
    document {
      name: "civic-hall"
      palette: cityPalette
      schema: "puck.creation.v1"
      shape Box "walls" {
        material: cream
        position [0, 6, 0]
        scale [12, 6, 10]
      }
      shape Box "roof" {
        material: teal
        position [0, 12, 0]
        rotation: gableTurn
        scale [8.55, 8.55, 10.4]
      }
      shape Box "tower" {
        material: cream
        position [0, 11, 7]
        scale [3, 11, 3]
      }
      shape Box "tower-cap" {
        material: teal
        position [0, 22.4, 7]
        scale [3.4, 0.4, 3.4]
      }
    }
  }

  // The square's fountain: a stone basin 6 m across round a column.
  prototype "fountain" {
    document {
      name: "fountain"
      palette: cityPalette
      schema: "puck.creation.v1"
      shape Cylinder "basin" {
        material: stone
        position [0, 0.35, 0]
        scale [3, 0.35, 3]
      }
      shape Cylinder "pool" {
        blend: Subtraction
        material: stone
        position [0, 0.55, 0]
        scale [2.7, 0.35, 2.7]
      }
      shape Cylinder "water" {
        material: river
        position [0, 0.4, 0]
        scale [2.7, 0.05, 2.7]
      }
      shape Cylinder "column" {
        material: stone
        position [0, 1.5, 0]
        scale [0.4, 1.5, 0.4]
      }
    }
  }

  // A market stall of each awning colour: a timber counter under an awning on four posts, the counter on the side its yaw
  // turns to face the fountain.
  for awning in [{ name: "teal", slot: teal }, { name: "ochre", slot: ochre }] {
    prototype $"stall-{awning.name}" {
      document {
        name: $"stall-{awning.name}"
        palette: cityPalette
        schema: "puck.creation.v1"
        shape Box "counter" {
          material: timber
          position [0, 0.5, 0.6]
          scale [1.5, 0.5, 0.4]
        }
        shape Box "post-nw" {
          material: timber
          position [-1.4, 1.2, -0.9]
          scale [0.06, 1.2, 0.06]
        }
        shape Box "post-ne" {
          material: timber
          position [1.4, 1.2, -0.9]
          scale [0.06, 1.2, 0.06]
        }
        shape Box "post-sw" {
          material: timber
          position [-1.4, 1.2, 0.9]
          scale [0.06, 1.2, 0.06]
        }
        shape Box "post-se" {
          material: timber
          position [1.4, 1.2, 0.9]
          scale [0.06, 1.2, 0.06]
        }
        shape Box "awning" {
          material: awning.slot
          position [0, 2.45, 0]
          scale [1.6, 0.05, 1.1]
        }
      }
    }
  }

  // A street lamp: a timber post with a glowing lantern under a teal cap; its light is the city's, keyed on the clock,
  // and sits in the lantern, which as the solid holding it never hides it.
  prototype "street-lamp" {
    document {
      name: "street-lamp"
      palette: cityPalette
      schema: "puck.creation.v1"
      shape Cylinder "post" {
        material: timber
        position [0, 2, 0]
        scale [0.08, 2, 0.08]
      }
      shape Box "lantern" {
        material: windowGlow
        position [0, 4.2, 0]
        scale [0.2, 0.25, 0.2]
      }
      shape Box "cap" {
        material: teal
        position [0, 4.52, 0]
        scale [0.28, 0.07, 0.28]
      }
    }
  }

  // The bridge: a stone deck 12 m wide over the river, flush with both banks, between low parapets.
  prototype "bridge" {
    document {
      name: "bridge"
      palette: cityPalette
      schema: "puck.creation.v1"
      shape Box "deck" {
        material: stone
        position [0, -0.3, 0]
        scale [6, 0.3, 24]
      }
      shape Box "parapet-west" {
        material: stone
        position [-5.8, 0.5, 0]
        scale [0.2, 0.5, 20]
      }
      shape Box "parapet-east" {
        material: stone
        position [5.8, 0.5, 0]
        scale [0.2, 0.5, 20]
      }
    }
  }
}

// The town's spawn points: the arrival and the market, for `body.pose` and the benchmark.
spawnPoints [
  { id: "city-arrival", position [0, 0, -9], yawDegrees: 0 }
  { id: "city-market", position [0, 0, -38], yawDegrees: 0 }
]

// The sun the city's day cycle (city-day.puck) turns, and an exposure whose floor follows that day: EV 7 from dawn to
// dusk, keyed a stop and a quarter above the meter so the cream walls read white; at night a floor of EV 3.5 and a stop
// under the meter, so the town stays dark and the lamps' pools and lit windows carry it rather than a lifted average.
render {
  farDistance: 600
  lighting {
    lights: concat(
      [
        directional(
          name: "key",
          direction: [3, 5, -4],
          color: "#FFF0DC",
          illuminance: 100000lx,
          shadow: always,
          angularRadius: 0.2
        )
      ],
      map(range(0, length(cityLampSpots)), i => point(
        name: $"lamp-{i}",
        position: [cityLampSpots[i][0], 4.2, cityLampSpots[i][1]],
        temperature: 2700K,
        power: "state.cityLamps"
      ))
    )
  }
  exposure {
    mode: Auto
    minimum {
      clock: cityDay
      keys [
        { at: 0, value: 3.5 }
        { at: 18900, value: 3.5 }
        { at: 23400, value: 7 }
        { at: 63000, value: 7 }
        { at: 67500, value: 3.5 }
      ]
    }
    compensation {
      clock: cityDay
      keys [
        { at: 0, value: -1 }
        { at: 18900, value: -1 }
        { at: 23400, value: 1.25 }
        { at: 63000, value: 1.25 }
        { at: 67500, value: -1 }
      ]
    }
    maximum: 16
    adaptation: 0.75
    local: 0.5
    band: 0.75
    low: 0.1
    high: 0.9
    center: 0.25
  }
  atmosphere {
    fog {
      density: 0.0015
    }
  }
}
