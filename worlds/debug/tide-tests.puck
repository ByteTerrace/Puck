// A tide by itself: a world with no pull of its own (one weightless area) and one far mass, 400 m along +Z. Two
// rigid marbles float high over the floor, one 40 m toward the mass from the tide's origin and one 40 m to the side.
// The far mass's whole pull moves the world and is never felt; what is felt is its difference across the world: the
// marble toward the mass drifts on toward it, and the one to the side is drawn in toward the line.
// `puck test worlds/debug/tide-tests.puck --reproduce`.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "tide-tests"

import "place-kit"
import "../standard/kits"

// Where the marbles float, clear of the basis's floor.
let aloft = 60

bodies {
  capacity: 10
  localSeats: 4
  networkPlayers: 4
  reconnectGraceSeconds: 3
}

gravity {
  attractors []
  gravitationalConstant: 0
  softeningLength: 0.5
  solver: Pairwise
  uniform [0, 0, 0]
  // The world's own field: none, within a kilometre of the origin.
  areas [
    {
      placementId: `origin`
      priority: 0
      mode: Replace
      bounds: sphere(radius: 1000)
      acceleration: directional(value: [0, 0, 0])
    }
  ]
  tideOrigin: `origin`
  tides [
    { placementId: `far-mass`, surfaceGravity: 20, referenceRadius: 100, scale: massShare }
  ]
}

state {
  world [
    // The far mass as a share of its whole: zero is a mass that has gone.
    { name: "massShare", kind: "Fixed", value: "1" }
  ]
}

pieceKit(name: "marble", collider: sphere(radius: 0.4), mass: 4)

looks [
  {
    motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
    name: "marble"
    scale: 1
    source: creation(prototypeId: marble)
  }
]

placements {
  placement "origin" {
    prototype: "place"
    position [0, aloft, 0]
  }
  placement "far-mass" {
    prototype: "place"
    position [0, aloft, 400]
  }
  for marble in [{ name: "toward", position [0, aloft, 40] }, { name: "aside", position [40, aloft, 0] }] {
    placement $"marble-{marble.name}" {
      prototype: "marble"
      position: marble.position
      inhabit {
        count: 1
        distribution {
          fill {
            name: "additive"
            offset: 0
            step: 0.001
          }
          region: disc(radius: 0.01)
        }
        kit: "marble"
        look: "marble"
        source: "Idle"
      }
    }
  }
}

prototypes {
  prototype "marble" {
    document {
      name: "marble"
      palette [{ color: "#E9E2D0", roughness: 0.25, specular: 0.5 }]
      schema: "puck.creation.v1"
      shape Sphere "ball" {
        material: 0
        position [0, 0, 0]
        scale [0.4, 0.4, 0.4]
      }
    }
  }
}

// The tensor of a mass of 200,000 (20 at 100 m) 400 m off is 0.00625 a second squared along the line to it and half
// that, inward, across it. Over ten seconds the marble 40 m toward the mass gains about 14 m and the one to the side
// loses about 6.
test "a far mass stretches a world along the line to it and squeezes it across" {
  when {
    ticks 300
  }
  expect {
    bodyPosition(body, 8, z) > 50
    bodyPosition(body, 8, z) < 58
    bodyPosition(body, 9, x) < 36
    bodyPosition(body, 9, x) > 31
  }
}

// With the mass gone the tide is gone: nothing moves.
test "a mass that has gone raises no tide" {
  when {
    seat1: world.state.cell.set massShare $value 0
    ticks 300
  }
  expect {
    bodyPosition(body, 8, z) > 39.9
    bodyPosition(body, 8, z) < 40.1
  }
}
