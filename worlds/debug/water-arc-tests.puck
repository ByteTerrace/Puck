// The water's whole arc, simulated in fast time: the glacier melts over three hours of simulated time as (1 - t/T)^3,
// the lake stands at its sill, the falls carry the melt and run dry at T, the river drains into the aquifer until it
// fills, and the river then settles at one level with it (water.puck, the standard's hydrology). One scenario runs the
// 3 h (324 000 ticks at 30 Hz) and three quarters of an hour of settling, latching every gauge at each milestone into a
// probe table, and asserts the arc from those probes; `--reproduce` shows the run replays bit for bit.
schema: "puck.world.definition.v1"
basis: "debug"
documentId: "debug"
import "stopped-machines"

// Ticks of the melt, T, and the milestones probed: every eighth of the melt, then the settling tail at T + 15, 30 and
// 45 minutes.
let meltTicks = 324000
let tail = 27000
let milestones = concat(map(range(0, 9), i => i * meltTicks / 8), map(range(1, 3), j => meltTicks + j * tail))

let probes = ["glacierAt", "lakeAt", "fallsAt", "riverAt", "aquiferAt", "poolAt"]
state {
  world {
    for name in probes {
      row {
        name: name
        kind: "Fixed"
        capacity: length(milestones)
        min: "0"
        max: "4"
        cells: map(range(0, length(milestones)), i => { key: $"{i}", value: "0" })
      }
    }
  }
}

// Each probe fires once, on the first tick at or past its milestone (the first probe at tick 30, once the chain has
// stepped), and copies the gauges of that tick.
for (m, i) in milestones {
  rule $"water-arc-probe-{i}" {
    when $tick >= maximum(30, m)
    mode: Edge
    glacierAt[i] = glacier
    lakeAt[i] = lakeLevel
    fallsAt[i] = fallsFlow
    riverAt[i] = riverDepth
    aquiferAt[i] = aquiferFill
    poolAt[i] = poolLevel
  }
}

test "the glacier melts as (1 - t/T)^3 over three hours, the falls run dry at T, and the river settles with the aquifer" {
  when {
    ticks 378040
  }
  expect {
    // The glacier against (1 - t/T)^3 at each eighth: 1, 0.670, 0.422, 0.244, 0.125, 0.053, 0.016, 0.002, 0.
    glacierAt[0] > 0.99
    glacierAt[1] > 0.66 and glacierAt[1] < 0.68
    glacierAt[2] > 0.41 and glacierAt[2] < 0.43
    glacierAt[3] > 0.235 and glacierAt[3] < 0.255
    glacierAt[4] > 0.12 and glacierAt[4] < 0.13
    glacierAt[5] > 0.045 and glacierAt[5] < 0.06
    glacierAt[6] > 0.01 and glacierAt[6] < 0.02
    glacierAt[7] > 0.0 and glacierAt[7] < 0.005
    glacierAt[8] == 0
    // The falls carry the melt until T and run dry after it.
    fallsAt[0] > 0
    fallsAt[4] > 0
    fallsAt[7] > 0
    fallsAt[9] < 0.001
    fallsAt[10] < 0.001
    // The lake stands at its sill before and after the melt.
    lakeAt[0] > 0
    lakeAt[10] > 0
    // The aquifer fills over the melt and holds full after it.
    aquiferAt[0] < aquiferAt[4]
    aquiferAt[4] < aquiferAt[8]
    aquiferAt[10] > 0.95
    // The river reaches a steady level: its drift over the last quarter hour of the tail is bounded.
    riverAt[10] > 0
    (riverAt[10] - riverAt[9]) < 0.01 and (riverAt[9] - riverAt[10]) < 0.01
    poolAt[10] > poolAt[0]
  }
}
