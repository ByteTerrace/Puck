// The watchdog's positive control (watchdog.puck, addons.md), booted in the whole debug world:
// `puck test worlds/debug/addons-tests.puck`. The sweep reads the watchdog quiet on every run; this forced violation
// shows that a quiet reading means something, by posing body 0 under the floor and reading the tick it was caught.

schema: "puck.world.definition.v1"
basis: "debug"
documentId: "addons-tests"
import "stopped-machines"

test "the watchdog records the tick a body is first under the floor" {
  when {
    seat1: body.pose 5 -3 5 0 0 0 0
    ticks 10
  }
  expect {
    watchdog.count == 1
    watchdog.first == 2
    watchdog.tick == 2
  }
}
