// Relief witnesses: exact gradients of authored heights lighting a surface with no slope written by hand. One panel a
// pattern (fractal noise, cell cracks, brick mortar, the same bricks in a creation's own frame), a panel of the smooth
// functions a height may hold, and a sphere for the fractal relief's look on a curved face.
schema: "puck.world.definition.v1"
basis: "shade-checks"
documentId: "shade-relief-checks"
import "../standard/shading"

let reliefStone = { color: "#A89C8C", roughness: 0.75, specular: 0.04 }
let reliefBrick = [0.4, 0.2]

// The bricks' colour: mortar grey, each brick its own shade of the material.
shade template reliefBrickFace(size, mortar, seed) {
  surface {
    let brick = shadeBrick(surface.position, size, mortar, seed)
    albedo: mix(material.albedo * (0.75 + 0.5 * brick.y), [0.55, 0.55, 0.52], brick.x)
  }
}
// The cracks' colour: dark in the crack.
shade template reliefCrackFace(scale, seed, width) {
  surface {
    albedo: material.albedo *
      (1 - 0.7 * shadeCellBorder(surface.position * scale, seed, width, pixel: surface.footprint * scale))
  }
}
// A height built from every smooth function a height may hold, its normal tilted by its gradient directly.
shade template reliefSmooth(seed) {
  surface {
    let slope = gradient(surface.position, q => 0.004 * (
      pow(saturate(0.5 + 0.5 * sin(q.x * 9)), 2) +
        smoothstep(0.2, 0.8, abs(cos(q.y * 7))) +
        mix(atan2(q.x, q.z + 3), sqrt(dot(q, q) + 1), 0.5) +
        exp2(-length(q - [0, 1, -3])) +
        log2(2 + max(q.x, q.y)) +
        dot(normalize(q + [0.1, 0.2, 0.3]), cross(q, [0, 1, 0])) +
        reflect(q, [0, 0, 1]).z * 0.1 +
        inverseRotate(q, [0, 0.38268343, 0, 0.92387953]).x * tan(0.3) +
        asin(0.5 * sin(q.z)) + acos(0.5 * cos(q.x)) + atan(q.y) +
        (q.x > 0 ? lattice(q * 6, seed) : cells(q * 6, seed).x) -
        min(q.y, 0.5) + floor(q.x * 3) * 0.1
    ))
    normal: tilt(surface.normal, slope * -1, 1.2)
  }
}

prototypes {
  prototype "relief-fbm" {
    document {
      schema: "puck.creation.v2"
      palette [reliefStone with { shade: relief(q => 0.012 * shadeFbm(q * 4, uint(7), octaves: 5, pixel: surface.footprint * 4), 1) }]
      shape Box "panel" {
        scale [0.8, 0.8, 0.04]
      }
    }
  }
  prototype "relief-cracks" {
    document {
      schema: "puck.creation.v2"
      palette [
        reliefStone with {
          shade [
            reliefCrackFace(3, 5, 0.06),
            relief(q => -0.006 * shadeCellBorder(q * 3, uint(5), 0.06, pixel: surface.footprint * 3), 1)
          ]
        }
      ]
      shape Box "panel" {
        scale [0.8, 0.8, 0.04]
      }
    }
  }
  prototype "relief-bricks" {
    document {
      schema: "puck.creation.v2"
      palette [
        { color: "#9C4A32", roughness: 0.85, specular: 0.03 } with {
          shade [
            reliefBrickFace(reliefBrick, 0.025, 3),
            relief(q => -0.008 * shadeBrick(q, reliefBrick, 0.025, uint(3)).x, 1)
          ]
        }
      ]
      shape Box "panel" {
        scale [0.8, 0.8, 0.04]
      }
    }
  }
  prototype "relief-bricks-object" {
    document {
      schema: "puck.creation.v2"
      palette [
        { color: "#9C4A32", roughness: 0.85, specular: 0.03 } with {
          shade: relief(q => -0.008 * shadeBrick(q, reliefBrick, 0.025, uint(3), bevel: 0.8).x, 1, world: 0)
        }
      ]
      shape Box "panel" {
        scale [0.8, 0.8, 0.04]
      }
    }
  }
  prototype "relief-smooth" {
    document {
      schema: "puck.creation.v2"
      palette [reliefStone with { shade: reliefSmooth(9) }]
      shape Box "panel" {
        scale [0.8, 0.8, 0.04]
      }
    }
  }
  prototype "relief-sphere" {
    document {
      schema: "puck.creation.v2"
      palette [reliefStone with { shade: relief(q => 0.02 * shadeRidged(q * 3, uint(11), pixel: surface.footprint * 3), 1) }]
      shape Sphere "sphere" {
        scale [0.7, 0.7, 0.7]
      }
    }
  }
}
placements {
  placement "relief-fbm" {
    prototype: "relief-fbm"
    position [-4, 1, -3]
    solid
  }
  placement "relief-cracks" {
    prototype: "relief-cracks"
    position [-2, 1, -3]
    solid
  }
  placement "relief-bricks" {
    prototype: "relief-bricks"
    position [0, 1, -3]
    solid
  }
  placement "relief-bricks-object" {
    prototype: "relief-bricks-object"
    position [2, 1, -3]
    yawDegrees: 45
    solid
  }
  placement "relief-smooth" {
    prototype: "relief-smooth"
    position [4, 1, -3]
    solid
  }
  placement "relief-sphere" {
    prototype: "relief-sphere"
    position [0, 2.8, -3]
    solid
  }
}
