// The valley's birds: a barn swallow perched on the reservoir pavilion's west rail, gripping the rail's pool-side edge
// with its tail hanging free over the water and its face toward the path. `debug.go pool` stands a body a few metres
// in front of it.
//
// References (a male barn swallow, Hirundo rustica, perched on a rail or wire): an upright stance, the body pitched
// 30 to 40 degrees nose up on short dark legs; a steel-blue back, crown, wings and tail with a glossy sheen; a rich
// chestnut forehead joined to the bill and a chestnut chin and throat; a narrow dark blue breast band closing the
// throat off from warm buff underparts; long pointed wings folded along the back, their tips crossing past the rump;
// a deeply forked tail hanging below the perch, its outer streamers thin and tapering to fine points well past the
// wingtips, with a row of white spots on its inner webs; a small head on a deep chest, a tiny dark bill. It is drawn in
// the valley-and-gallery treatment (docs/game/art/README.md, the visual bar): one shaped body, flat values, crisp
// painted markings and a painted sky-coloured gloss band along the back and crown.
//
// It is sculpted at a real bird's size, in metres, its feet just below the origin gripping the rail's rounded edge, and
// placed at 1.5 times that, so it reads at the distances the pool's path shows it from. Its parts are grouped for the idle rig (open
// items, the visual bar packet): the body, wings and legs in one group, the head with its bill and eyes in another, the
// tail in a third.
import "../standard/rotations"

let swallowPlumage = 0
let swallowFlight = 1
let swallowTail = 2
let swallowEye = 3
let swallowBill = 4

let swallowBodyGroup = 1
let swallowHeadGroup = 2
let swallowTailGroup = 3

let swallowAxisX = [1, 0, 0]
let swallowAxisY = [0, 1, 0]
let swallowAxisZ = [0, 0, 1]

// The body's centre above and a little behind the feet, and its nose-up pitch; the head sits on its upper end.
let swallowBodyAt = [0, 0.02, -0.006]
let swallowPitch = turn(swallowAxisX, -35)
let swallowHeadAt = [0, 0.048, 0.023]
// The breast: under the body's front, along its pitch (body-local [0, -0.008, 0.012]).
let swallowBreastAt = [0, swallowBodyAt[1] + turned(swallowPitch, [0, -0.008, 0.012])[1], swallowBodyAt[2] + turned(swallowPitch, [0, -0.008, 0.012])[2]]

// The plumage colours: the steel-blue back, the near-black blue of the flight feathers (wings and tail), the gloss band
// and its graded edge, the chestnut and the buff.
let swallowSteel = "#253B52"
let swallowSteelDeep = "#131D2B"
let swallowGloss = "#44658A"
let swallowGlossEdge = "#314B69"
let swallowChestnut = "#943C22"
let swallowBuff = "#D6A266"

// The feathered blades (the wings and the tail halves) are thin convex prisms grown by a dilation: the dilation rounds
// every edge and keeps even a pointed tip twice its own radius thick, and the blade's thinness sets the bake's spacing
// fine enough to draw it.

// One half of the forked tail, inset by its dilation: the inner edge runs from the fork's notch out to the streamer's
// tip, the outer edge from the root straight back to it, so the streamer narrows evenly to a single vertex the dilation
// rounds to a point. Profile X runs out to the bird's side and Y back. The blade is barely thicker than its dilation, so
// seen edge-on the streamer is a line, not a slab.
let swallowTailRound = 0.0007
let swallowTailProfile = [[0.003, 0.03], [0.0136, 0.0765], [0.0074, -0.004], [0.0015, -0.004]]

// A profile mirrored across X, its order reversed so it still winds clockwise.
function swallowMirror(profile, sign) = (sign > 0) ? profile : map(
  range(0, length(profile)),
  i => [0 - profile[length(profile) - 1 - i][0], profile[length(profile) - 1 - i][1]]
)

let swallowSides = [{ name: "Left", sign: 1 }, { name: "Right", sign: -1 }]

// One folded wing a side as the side view sees it, inset by its dilation: the bend is its rounded front at the origin, set
// at the shoulder high on the flank under the back's edge; the upper edge runs along the back and the lower edge rakes
// back from the bend, then sweeps up to the pointed tip 9.5 cm behind. Profile X runs back and Y up. The wing's pitch
// turns the profile's down toward the bird's front, so a low point near the bend would sit forward of the shoulder: the
// lower edge leaves the bend almost along X.
let swallowWingRound = 0.0008
let swallowWingProfile = [
  [0.0, 0.0015], [0.004, 0.0035], [0.03, 0.004], [0.06, 0.002], [0.095, -0.0024], [0.0946, -0.0028], [0.07, -0.0075],
  [0.045, -0.0105], [0.02, -0.0095], [0.006, -0.0045], [0.0005, -0.001]
]
// The bend's place: the upper flank at the base of the neck, with the blade's outer face a little proud of the body so it
// reads along its whole length; its upper edge lies just over the back and meets it in a narrow blend, a rounded ledge
// rather than a wide flat fillet.
let swallowShoulder = [0.0099, 0.0335, 0.003]
let swallowWingRoll = 10

// The wing lies along the body's flank (the profile's X turned to point back), rolled so its upper edge leans in over
// the back, yawed so the tips cross behind the rump, and pitched with the body so the tips ride above the hanging tail;
// the right wing rides a little higher, so where the tips cross it lies over the left one rather than blending into it.
function swallowWingTurn(sign) = turnThen(
  turnThen(turnThen(turn(swallowAxisY, 90), turn(swallowAxisZ, sign * swallowWingRoll)), turn(swallowAxisY, sign * 5)),
  turn(swallowAxisX, (sign > 0) ? -36 : -32)
)

template swallowWing(side) {
  shape Prism $"wing{side.name}" {
    group: swallowBodyGroup
    blend: "SmoothUnion"
    smooth: 0.0015
    material: swallowFlight
    position [side.sign * swallowShoulder[0], swallowShoulder[1], swallowShoulder[2]]
    rotation: swallowWingTurn(side.sign)
    scale [1, 1, 0.0009]
    dilate: swallowWingRound
    profile {
      kind: "Convex"
      vertices: swallowWingProfile
      cornerRadius: 0.001
    }
  }
}

// A tail half hangs from the rump (the profile's Y turned to point back, then down 45 degrees), splayed out a little and
// rolled 25 degrees about its length so its outer edge lifts: the closed fork is a shallow V, and a side view sees the
// blade's narrowing face rather than its edge, so each streamer reads as one blade tapering to its point.
template swallowTailHalf(side) {
  shape Prism $"tail{side.name}" {
    group: swallowTailGroup
    blend: "SmoothUnion"
    smooth: 0.003
    material: swallowTail
    position [0, 0.001, -0.031]
    rotation: turnThen(turnThen(turn(swallowAxisY, 0 - side.sign * 25), turn(swallowAxisX, -135)), turn(swallowAxisZ, side.sign * 5))
    scale [1, 1, 0.0003]
    dilate: swallowTailRound
    profile {
      kind: "Convex"
      vertices: swallowMirror(swallowTailProfile, side.sign)
      cornerRadius: 0.001
    }
  }
}

// An eye a side: a glossy dark bead set into the head so only its cap shows.
template swallowEyeBead(side) {
  shape Sphere $"eye{side.name}" {
    group: swallowHeadGroup
    material: swallowEye
    position [side.sign * 0.006, swallowHeadAt[1] + 0.0012, swallowHeadAt[2] + 0.006]
    scale [0.0025, 0.0025, 0.0025]
  }
}

// The perch: the feet grip the rail's rounded pool-side edge `swallowGrip` degrees down its curve from the top, so the
// body stands over the edge and the tail hangs over the water. The curve's centre and radius are the rail's
// (water-scenery.puck's `reservoir-pavilion`: the west rail's top at 1.22 m, its edge rounded 35 mm), in world metres;
// the rest is in the bird's own units, a real bird's metres, placed at `swallowScale`.
let swallowScale = 1.5
let swallowRailEdge = [-45.885, 1.185]
let swallowRailRound = 0.035
let swallowGrip = 35
// Where each foot meets the rail (its toes' root), under the body a little behind its centre; the shank rises from it
// into the belly.
let swallowFootAt = [0.0038, -0.0085, -0.004]
// The rail's curve under the feet in the bird's units, as (z, y) about the foot: its centre, and its radius.
let swallowArcRadius = swallowRailRound / swallowScale
let swallowArcCentre = [swallowFootAt[2] + swallowArcRadius * sine(swallowGrip * radiansPerDegree), swallowFootAt[1] - swallowArcRadius * cosine(swallowGrip * radiansPerDegree)]

// A point on the rail's curve `degrees` from its top toward the pool, lifted off it by `lift`, as (z, y).
function swallowArc(degrees, lift) = [
  swallowArcCentre[0] - (swallowArcRadius + lift) * sine(degrees * radiansPerDegree),
  swallowArcCentre[1] + (swallowArcRadius + lift) * cosine(degrees * radiansPerDegree)
]

// A toe: a tapered stroke lying on the rail's curve from the foot at `swallowGrip` to `reach` degrees, its quadratic
// curve's middle point where the two ends' tangents meet, splayed `splay` degrees off the bird's axis. Its radius keeps
// it two bake cells thick at the finest spacing (WorldPlacementStamper.FinestDetail), and it sinks a little into the
// rail so it grips rather than floats.
let swallowToeRadius = 0.00135
let swallowToeLift = 0.0006

function swallowToePoint(side, splay, degrees, lift) = [
  side.sign * swallowFootAt[0] + side.sign * (swallowArc(degrees, lift)[0] - swallowFootAt[2]) * sine(splay * radiansPerDegree),
  swallowArc(degrees, lift)[1],
  swallowArc(degrees, lift)[0]
]

// The same point relative to the toe's root, the frame its curve is written in.
function swallowToeCurve(side, splay, degrees, lift) = map(
  range(0, 3),
  k => swallowToePoint(side, splay, degrees, lift)[k] - swallowToePoint(side, splay, swallowGrip, swallowToeLift)[k]
)

template swallowToe(side, name, splay, reach) {
  shape Sweep $"{name}{side.name}" {
    group: swallowBodyGroup
    blend: "SmoothUnion"
    smooth: 0.0012
    material: swallowBill
    position: swallowToePoint(side, splay, swallowGrip, swallowToeLift)
    curve {
      a [0, 0, 0]
      b: swallowToeCurve(
        side,
        splay,
        (swallowGrip + reach) / 2,
        (swallowArcRadius + swallowToeLift) / cosine((reach - swallowGrip) / 2 * radiansPerDegree) - swallowArcRadius
      )
      c: swallowToeCurve(side, splay, reach, swallowToeLift)
      radiusStart: swallowToeRadius
      radiusEnd: 0.001
    }
  }
}

// A leg a side: a short dark shank from the foot up into the belly, two front toes curled forward over the edge's crown
// and splayed, and a hind toe curled back down over the edge toward the water.
template swallowLeg(side) {
  shape Sweep $"leg{side.name}" {
    group: swallowBodyGroup
    blend: "SmoothUnion"
    smooth: 0.0015
    material: swallowBill
    position: swallowToePoint(side, 0, swallowGrip, swallowToeLift)
    curve {
      a [0, 0, 0]
      b [0, 0.0045, 0.0026]
      c [0, 0.0095, 0.0035]
      radiusStart: swallowToeRadius
      radiusEnd: swallowToeRadius
    }
  }
  swallowToe(side: side, name: "toeInner", splay: -12, reach: 8)
  swallowToe(side: side, name: "toeOuter", splay: 16, reach: 10)
  swallowToe(side: side, name: "hindToe", splay: 0, reach: 64)
}

// The white spots on a tail half's inner webs near the fork, dashes along the feathers painted through the blade so both
// faces show them; the two halves' spots make a band across the fork.
function swallowTailSpots(side) = [
  {
    parent: $"tail{side.name}"
    type: "Ellipsoid"
    position [side.sign * 0.0042, 0.018, 0]
    scale [0.0016, 0.0032, 0.003]
    color: "#FFFFFF"
  }
  {
    parent: $"tail{side.name}"
    type: "Ellipsoid"
    position [side.sign * 0.0062, 0.026, 0]
    scale [0.0015, 0.003, 0.003]
    color: "#FFFFFF"
  }
]

prototypes {
  prototype "swallow" {
    document {
      name: "swallow"
      schema: "puck.creation.v1"
      palette [
        // The plumage of the body and head, held values under a soft specular, with its markings painted on in order:
        // the gloss band along the back and the crown (a wide edge value under a narrower core, so the band grades), the
        // buff underparts, then the chestnut throat and the forehead blaze joined to the bill. What the buff and the
        // throat leave between them across the breast is the breast band.
        {
          color: swallowSteel
          specular: 0.02
          roughness: 0.75
          paints [
            {
              parent: "body"
              type: "Ellipsoid"
              position [0, 0.0165, 0.002]
              scale [0.0048, 0.006, 0.032]
              color: swallowGlossEdge
            }
            {
              parent: "body"
              type: "Ellipsoid"
              position [0, 0.0175, 0.004]
              scale [0.0026, 0.0045, 0.025]
              color: swallowGloss
            }
            {
              parent: "head"
              type: "Ellipsoid"
              position [0, 0.009, -0.001]
              scale [0.0038, 0.003, 0.007]
              color: swallowGlossEdge
            }
            {
              parent: "head"
              type: "Ellipsoid"
              position [0, 0.0095, -0.001]
              scale [0.002, 0.0022, 0.005]
              color: swallowGloss
            }
            {
              parent: "body"
              type: "Ellipsoid"
              position [0, -0.032, -0.01]
              scale [0.05, 0.03, 0.055]
              color: swallowBuff
            }
            {
              parent: "head"
              type: "Ellipsoid"
              position [0, -0.0098, 0.0068]
              scale [0.0062, 0.0076, 0.008]
              color: swallowChestnut
            }
            {
              parent: "head"
              type: "Ellipsoid"
              position [0, -0.0004, 0.0096]
              scale [0.0048, 0.0028, 0.0042]
              color: swallowChestnut
            }
          ]
        }
        // The wings' flight feathers, near black against the back.
        { color: swallowSteelDeep, specular: 0.02, roughness: 0.75 }
        // The tail, as the wings, with its white spots.
        {
          color: swallowSteelDeep
          specular: 0.02
          roughness: 0.75
          paints: concat(swallowTailSpots(swallowSides[0]), swallowTailSpots(swallowSides[1]))
        }
        // The eyes: near black under a clear coat that holds a small highlight.
        { color: "#0D0908", specular: 0.04, roughness: 0.35, coat: 0.5 }
        // The bill, legs and feet.
        { color: "#2A2523", specular: 0.04, roughness: 0.6 }
      ]
      // One shaped body: a long near-ellipsoid along the body's axis, and the deep breast swelling under its front,
      // blended into it. Neither is warped: on a static placement a warped shape (a flare, a shear, bumps) bakes apart
      // from its neighbours (WorldPlacementStamper.BakesAlone), so the head's and the wings' smooth blends into it would
      // bake as creases.
      shape Superellipsoid "body" {
        group: swallowBodyGroup
        material: swallowPlumage
        position: swallowBodyAt
        rotation: swallowPitch
        scale [0.0095, 0.0155, 0.041]
        exponent: 2.2
      }
      shape Superellipsoid "breast" {
        group: swallowBodyGroup
        blend: "SmoothUnion"
        smooth: 0.008
        material: swallowPlumage
        position: swallowBreastAt
        rotation: swallowPitch
        scale [0.0125, 0.0135, 0.016]
        exponent: 2.2
      }
      // The head: a small, slightly flattened crown on the body's upper end, narrower than the chest below it.
      shape Superellipsoid "head" {
        group: swallowHeadGroup
        blend: "SmoothUnion"
        smooth: 0.007
        material: swallowPlumage
        position: swallowHeadAt
        scale [0.0088, 0.0088, 0.0105]
        exponent: 2.2
      }
      for side in swallowSides {
        swallowEyeBead(side: side)
        swallowWing(side: side)
        swallowTailHalf(side: side)
        swallowLeg(side: side)
      }
      // The bill: a small flat dark wedge, wider than it is tall, tapering (the flare) to its point forward and a little
      // down between the forehead blaze and the throat. Its shape turns half round so the flare, which narrows toward
      // local -Z, narrows forward. It comes last: a warped shape bakes alone and so does the one after it, and the bill
      // meets the head in a hard union anyway.
      shape Superellipsoid "bill" {
        group: swallowHeadGroup
        material: swallowBill
        position [0, swallowHeadAt[1] - 0.0022, swallowHeadAt[2] + 0.0132]
        rotation: turnThen(turn(swallowAxisY, 180), turn(swallowAxisX, 8))
        scale [0.0036, 0.002, 0.0048]
        exponent: 2.2
        flare {
          amount: -0.6
          bulge: 0
          span: 0.0096
          top: 0.0048
          axis: 2
          startScale: 1
        }
      }
    }
  }
}

// On the reservoir pavilion's west rail, facing east along the path with the tail hanging over the pool: the bird's +Z
// turns to world +X, so the feet land on the rail's edge at `swallowGrip` (the origin sits `swallowScale` times the
// foot's offset away from that point).
let swallowPerch = [
  swallowRailEdge[0] - swallowRailRound * sine(swallowGrip * radiansPerDegree) - swallowScale * swallowFootAt[2],
  swallowRailEdge[1] + swallowRailRound * cosine(swallowGrip * radiansPerDegree) - swallowScale * swallowFootAt[1],
  -14.5
]

placements {
  placement "swallow" {
    prototype: "swallow"
    position: swallowPerch
    yawDegrees: -90
    scale: swallowScale
  }
}

cameras [
  {
    name: "swallow-portrait"
    renderWidth: 1280
    renderHeight: 900
    rig {
      name: "swallow-portrait"
      version: "puck.camera.program.v1"
      operations [
        anchor(opcode: "anchor", subject: worldPoint(point: [swallowPerch[0] + 0.32, swallowPerch[1] + 0.12, swallowPerch[2] - 0.22]))
        lookAt(focusDistance: 0.4, opcode: "lookAt", subject: worldPoint(point: [swallowPerch[0], swallowPerch[1] + 0.04, swallowPerch[2]]), worldAxes: false)
        fieldOfView(fieldOfViewRadians: 0.6, opcode: "fov")
      ]
    }
  }
  {
    name: "swallow-side"
    renderWidth: 1280
    renderHeight: 900
    rig {
      name: "swallow-side"
      version: "puck.camera.program.v1"
      operations [
        anchor(opcode: "anchor", subject: worldPoint(point: [swallowPerch[0] - 0.02, swallowPerch[1] + 0.02, swallowPerch[2] - 0.45]))
        lookAt(focusDistance: 0.45, opcode: "lookAt", subject: worldPoint(point: [swallowPerch[0] - 0.02, swallowPerch[1] + 0.01, swallowPerch[2]]), worldAxes: false)
        fieldOfView(fieldOfViewRadians: 0.6, opcode: "fov")
      ]
    }
  }
]
