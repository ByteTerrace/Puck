// The valley's birds: a barn swallow perched on the reservoir pavilion's west rail, gripping the rail's pool-side edge
// with its tail hanging free over the water and its face toward the path. `debug.go pool` stands a body a few metres
// in front of it.
//
// Its reference is docs/game/art/barn-swallow-reference.md: the cited sources, the stylized proportions in
// centimetres (the body length L, bill tip to tail root, is 7.6 cm), the silhouette each preview view must show and the
// palette. It is drawn in the valley-and-gallery treatment (docs/game/art/README.md, the visual bar): one shaped body,
// flat values, crisp painted markings and a painted sky-coloured gloss band along the back and crown.
//
// It is sculpted at a real bird's size, in metres, its feet just below the origin gripping the rail's rounded edge, and
// placed at 1.5 times that, so it reads at the distances the pool's path shows it from. Its parts are grouped for the
// idle rig (open items, the visual bar packet): the body, wings and legs in one group, the head with its bill and eyes
// in another, the tail in a third.
//
// The construction makes the reference's silhouette by design rather than by patching: the body is one tapered sweep
// (a torpedo, round in section, which bakes with its neighbours where a warped superellipsoid would bake alone), the
// head a flattened superellipsoid sunk into its front, the bill a flat triangular prism, each folded wing one long
// pointed blade rooted inside the flank and crossing its twin behind the rump, and each tail half one convex blade whose
// outline carries the inner feathers and the streamer together. The blades meet the body in hard unions: at the
// placement's bake cell (`mesh audit --cpu` reports 1.4 mm in placed metres, under 1 mm in the bird's units) a fillet
// narrower than the cell bakes as stairs, where an exact intersection bakes as one clean crease.
import "../standard/rotations"
import "../standard/outlines"

let swallowPlumage = 0
let swallowFeathers = 1
let swallowEye = 2
let swallowBill = 3

let swallowBodyGroup = 1
let swallowHeadGroup = 2
let swallowTailGroup = 3

let swallowAxisX = [1, 0, 0]
let swallowAxisY = [0, 1, 0]

// The plumage colours: the steel-blue back, the near-black blue of the flight feathers (wings and tail), the gloss
// highlight, the chestnut and the buff.
let swallowSteel = "#253B52"
let swallowSteelDeep = "#131D2B"
let swallowGloss = "#44658A"
let swallowChestnut = "#943C22"
let swallowBuff = "#D6A266"

let swallowSides = [{ name: "Left", sign: 1 }, { name: "Right", sign: -1 }]

// The body's frame: its axis pitched 35 degrees nose up through `swallowBodyAt`, which sits over the feet so the belly
// clears the rail's top by a few millimetres. Body-local X runs to the bird's left, Y up off the back, Z forward along
// the axis; every part is authored in that frame and placed with `swallowOnBody` and `swallowBodyTurn`.
let swallowBodyAt = [0, 0.0055, -0.006]
let swallowPitch = turn(swallowAxisX, -35)
function swallowOnBody(v) = [
  v[0]
  swallowBodyAt[1] + turned(swallowPitch, v)[1]
  swallowBodyAt[2] + turned(swallowPitch, v)[2]
]
function swallowBodyTurn(local) = turnThen(local, swallowPitch)

// The body: a sweep from the chest's centre back to the tail root, its radius tapering from the chest to the rump with
// a slight swell a third of the way back, and its path arched a little so the back rounds up behind the nape. The
// breast is the sweep's front cap.
let swallowChestAt = [0, 0, 0.016]
let swallowRumpAt = [0, 0, -0.0305]
let swallowChestRadius = 0.0125
let swallowRumpRadius = 0.0045

// The head: a flattened superellipsoid on the body's upper front, its crown no more than 3 mm proud of the back's line,
// its lower half inside the breast so the throat runs into it, pitched 20 degrees flatter than the body.
let swallowHeadLocal = [0, 0.0075, 0.0215]
let swallowHeadTurn = turn(swallowAxisX, -15)
let swallowHeadScale = [0.00825, 0.00775, 0.01]
let swallowHeadAt = swallowOnBody(swallowHeadLocal)
function swallowOnHead(v) = map(range(0, 3), k => swallowHeadAt[k] + turned(swallowHeadTurn, v)[k])

// The bill: a flat triangle from above (its profile X across, Y forward), a wedge from the side, rooted 2.5 mm inside
// the head's front and pitched 8 degrees below the head's axis. Its prism's extrusion is its thickness: the profile's
// +Y turns to the head's +Z and its +Z to the head's -Y, then the pitches, all about X.
let swallowBillRootLocal = [0, -0.0015, 0.009]
let swallowBillProfile = [[-0.0036, -0.0025], [0, 0.0095], [0.0036, -0.0025]]
let swallowBillTurn = turnThen(turn(swallowAxisX, 90 + 8), swallowHeadTurn)
let swallowBillDepth = 0.0008
let swallowBillRound = 0.0007

// A folded wing a side: one long pointed blade, a convex triangle whose root edge stands inside the flank (buried, so
// no edge of it shows there) and whose two straight edges run to the tip past the rump, where the two blades cross, the
// right riding above the left. The blade's profile X runs root to tip and Y across it; its frame takes X onto the
// root-to-tip line by the shortest turn (which keeps Y upward) and then rolls about that line so the upper edge leans
// in over the back. The blade is dark flight feather; the coverts on the flank in front of it are a paint on the body.
let swallowWingRootHalf = 0.0065
let swallowWingTipX = 0.004
let swallowWingTipZ = -0.09
let swallowWingRoll = 50
let swallowWingUpper = 0.0065
let swallowWingLower = 0.0065
let swallowWingWidest = 0.008
let swallowWingDepth = 0.0001
let swallowWingRound = 0.0013
function swallowWingRootLocal(side) = [side.sign * swallowWingRootHalf, ((side.sign > 0) ? 0.003 : 0.006), 0]
function swallowWingTipLocal(side) = [
  0 - side.sign * swallowWingTipX,
  ((side.sign > 0) ? -0.009 : -0.004)
  swallowWingTipZ
]
function swallowWingLine(side) = map(range(0, 3), k => swallowWingTipLocal(side)[k] - swallowWingRootLocal(side)[k])
function swallowWingLocalTurn(side) = turnThen(
  turnBetween(swallowAxisX, unitVector(swallowWingLine(side))),
  turn(unitVector(swallowWingLine(side)), 0 - side.sign * swallowWingRoll)
)
// The blade's outline: a short root edge inside the flank, an upper edge rising to its full breadth and then running
// straight to the tip, and a lower edge straight from the root to the tip, which lies along the blade's own line, so
// the blade stays inside the flank until the rump and emerges there along the back's side.
function swallowWingProfile(side) = [
  [0, 0.003],
  [swallowWingWidest, swallowWingUpper],
  [vectorLength(swallowWingLine(side)), 0],
  [0, -0.002]
]

template swallowWing(side) {
  shape Prism $"wing{side.name}" {
    group: swallowBodyGroup
    material: swallowFeathers
    position: swallowOnBody(swallowWingRootLocal(side))
    rotation: swallowBodyTurn(swallowWingLocalTurn(side))
    scale [1, 1, swallowWingDepth]
    dilate: swallowWingRound
    profile {
      kind: "Convex"
      vertices: swallowWingProfile(side)
      cornerRadius: 0.05
    }
  }
}

// The tail: two convex blades hanging from under the rump, 15 degrees below the body's axis, each holding its half of
// the inner feathers and its streamer in one outline (profile X out to the bird's side, Y along the tail): the inner
// edge runs from the root along the midline to the fork's notch, where the two halves' dilations have made the inner
// tail one plate, then the streamer's trailing edge splays out to the fine tip and the outer edge returns straight to
// the root. Each half rolls 8 degrees about its length so the fan is a shallow V with its outer edges up.
let swallowTailLocal = [0, -0.0035, -0.0305]
let swallowTailDroop = 15
let swallowTailDihedral = 8
let swallowTailProfile = [[0, 0], [0.0012, 0.05], [0.0105, 0.1], [0.0045, 0]]
let swallowTailDepth = 0.0001
let swallowTailRound = 0.0013
function swallowTailLocalTurn(side) = turnThen(
  turn(swallowAxisY, 0 - side.sign * swallowTailDihedral),
  turn(swallowAxisX, 0 - 90 - swallowTailDroop)
)

// A profile mirrored across X, its order reversed so it still winds clockwise.
function swallowMirror(profile, sign) = (sign > 0) ? profile : map(
  range(0, length(profile)),
  i => [0 - profile[length(profile) - 1 - i][0], profile[length(profile) - 1 - i][1]]
)

template swallowTailHalf(side) {
  shape Prism $"tail{side.name}" {
    group: swallowTailGroup
    blend: "SmoothUnion"
    smooth: 0.003
    material: swallowFeathers
    position: swallowOnBody(swallowTailLocal)
    rotation: swallowBodyTurn(swallowTailLocalTurn(side))
    scale [1, 1, swallowTailDepth]
    dilate: swallowTailRound
    profile {
      kind: "Convex"
      vertices: swallowMirror(swallowTailProfile, side.sign)
      cornerRadius: 0.02
    }
  }
}

// An eye a side: a glossy dark bead set into the head so only its cap shows.
template swallowEyeBead(side) {
  shape Sphere $"eye{side.name}" {
    group: swallowHeadGroup
    material: swallowEye
    position: swallowOnHead([side.sign * 0.0068, 0.0012, 0.0035])
    scale [0.0024, 0.0024, 0.0024]
  }
}

// The perch: the feet grip the rail's rounded pool-side edge `swallowGrip` degrees down its curve from the top, so the
// body stands over the edge and the tail hangs over the water. The curve's centre and radius are the rail's
// (water-scenery.puck's `reservoir-pavilion`: the west rail's top at 1.22 m, its edge rounded 35 mm), in world metres;
// the rest is in the bird's own units, a real bird's metres, placed at `swallowScale`.
let swallowScale = 1.5
let swallowRailEdge = [-45.885, 1.185]
let swallowRailRound = 0.035
let swallowGrip = 35
// Where each foot meets the rail (its toes' root), under the body a little behind its centre; the shank rises from it
// into the belly.
let swallowFootAt = [0.0038, -0.0085, -0.004]
// The rail's curve under the feet in the bird's units, as (z, y) about the foot: its centre, and its radius.
let swallowArcRadius = swallowRailRound / swallowScale
let swallowArcCentre = [
  swallowFootAt[2] + swallowArcRadius * sine(swallowGrip * radiansPerDegree)
  swallowFootAt[1] - swallowArcRadius * cosine(swallowGrip * radiansPerDegree)
]

// A point on the rail's curve `degrees` from its top toward the pool, lifted off it by `lift`, as (z, y).
function swallowArc(degrees, lift) = [
  swallowArcCentre[0] - (swallowArcRadius + lift) * sine(degrees * radiansPerDegree),
  swallowArcCentre[1] + (swallowArcRadius + lift) * cosine(degrees * radiansPerDegree)
]

// A toe: a tapered stroke lying on the rail's curve from the foot at `swallowGrip` to `reach` degrees, its quadratic
// curve's middle point where the two ends' tangents meet, splayed `splay` degrees off the bird's axis. Its radius keeps
// it two bake cells thick at the finest spacing (WorldPlacementStamper.FinestDetail), and it sinks a little into the
// rail so it grips rather than floats.
let swallowToeRadius = 0.0021
let swallowToeLift = 0.001

function swallowToePoint(side, splay, degrees, lift) = [
  side.sign * swallowFootAt[0] +
    side.sign * (swallowArc(degrees, lift)[0] - swallowFootAt[2]) * sine(splay * radiansPerDegree),
  swallowArc(degrees, lift)[1],
  swallowArc(degrees, lift)[0]
]

// The same point relative to the toe's root, the frame its curve is written in.
function swallowToeCurve(side, splay, degrees, lift) = map(
  range(0, 3),
  k => swallowToePoint(side, splay, degrees, lift)[k] - swallowToePoint(side, splay, swallowGrip, swallowToeLift)[k]
)

template swallowToe(side, name, splay, reach) {
  shape Sweep $"{name}{side.name}" {
    group: swallowBodyGroup
    blend: "SmoothUnion"
    smooth: 0.0012
    material: swallowBill
    position: swallowToePoint(side, splay, swallowGrip, swallowToeLift)
    curve {
      a [0, 0, 0]
      b: swallowToeCurve(
        side,
        splay,
        (swallowGrip + reach) / 2,
        (swallowArcRadius + swallowToeLift) / cosine((reach - swallowGrip) / 2 * radiansPerDegree) - swallowArcRadius
      )
      c: swallowToeCurve(side, splay, reach, swallowToeLift)
      radiusStart: swallowToeRadius
      radiusEnd: 0.0015
    }
  }
}

// A leg a side: a short dark shank from the foot up into the belly (a hard union, so the feathers' edge over the leg is
// one crisp line and no fillet mixes the two materials into a collar), two front toes curled forward over the edge's
// crown and splayed, and a hind toe curled back down over the edge toward the water.
template swallowLeg(side) {
  shape Sweep $"leg{side.name}" {
    group: swallowBodyGroup
    material: swallowBill
    position: swallowToePoint(side, 0, swallowGrip, swallowToeLift)
    curve {
      a [0, 0, 0]
      b [0, 0.0045, 0.0026]
      c [0, 0.0105, 0.0035]
      radiusStart: swallowToeRadius
      radiusEnd: swallowToeRadius
    }
  }
  swallowToe(side: side, name: "toeInner", splay: -12, reach: 8)
  swallowToe(side: side, name: "toeOuter", splay: 16, reach: 10)
  swallowToe(side: side, name: "hindToe", splay: 0, reach: 64)
}

// The coverts: the folded wing's inner half lies flat on the flank, so it is a paint, the dark feather drawn over the
// body's steel from the shoulder back to where the blade leaves the flank. The outline is in the blade's own frame
// (X along it, Y across), reaching forward past the root over the shoulder, and is projected through the flank along
// the blade's normal; its depth keeps it to the near flank.
let swallowCovertsForward = -0.03
let swallowCovertsBack = 0.032
function swallowCovertsOutline(side) = [
  [swallowCovertsForward, 0.002],
  [swallowCovertsForward + 0.008, swallowWingUpper - 0.001],
  [swallowCovertsBack, swallowWingUpper],
  [swallowCovertsBack, 0 - swallowWingLower],
  [swallowCovertsForward + 0.01, 0 - swallowWingLower + 0.0015],
  [swallowCovertsForward, -0.003]
]
function swallowCovertsPaint(side) = {
  parent: "body"
  type: "Prism"
  position: swallowWingRootLocal(side)
  rotation: swallowWingLocalTurn(side)
  scale [1, 1, 0.012]
  profile {
    kind: "Convex"
    vertices: swallowCovertsOutline(side)
    cornerRadius: 0.2
  }
  color: swallowSteelDeep
}

// The white spots on a tail half's inner webs near the fork, dashes along the feathers painted through the blade so both
// faces show them; the two halves' spots make a band across the fork.
function swallowTailSpots(side) = [
  {
    parent: $"tail{side.name}"
    type: "Ellipsoid"
    position [side.sign * 0.003, 0.042, 0]
    scale [0.0014, 0.003, 0.003]
    color: "#FFFFFF"
  }
  {
    parent: $"tail{side.name}"
    type: "Ellipsoid"
    position [side.sign * 0.0062, 0.047, 0]
    scale [0.0013, 0.0028, 0.003]
    color: "#FFFFFF"
  }
]

prototypes {
  prototype "swallow" {
    document {
      name: "swallow"
      schema: "puck.creation.v1"
      palette [
        // The plumage of the body and head, held values under a soft specular, with its markings painted on in order:
        // the gloss highlight, the buff underparts, the coverts on each flank, then the chestnut throat and the
        // forehead blaze joined to the bill. What the buff and the throat leave between them across the breast is the
        // breast band. The highlight is one stroke along the dorsal line in the body's frame, from the rump over the
        // back to the nape, held just under the surface: it shows where the back rounds up into it.
        {
          color: swallowSteel
          specular: 0.02
          roughness: 0.75
          paints: concat(
            [
              {
                parent: "body"
                type: "Sweep"
                curve {
                  a [0, 0.003, -0.028]
                  b [0, 0.0128, -0.004]
                  c [0, 0.0112, 0.018]
                  radiusStart: 0.0012
                  radiusEnd: 0.0018
                  bulge: 0.0012
                }
                color: swallowGloss
              }
              {
                parent: "body"
                type: "Ellipsoid"
                position [0, -0.02, -0.006]
                scale [0.018, 0.019, 0.034]
                color: swallowBuff
              }
              swallowCovertsPaint(swallowSides[0]),
              swallowCovertsPaint(swallowSides[1]),
              {
                parent: "head"
                type: "Ellipsoid"
                position [0, -0.0062, 0.0058]
                scale [0.0064, 0.0058, 0.0074]
                color: swallowChestnut
              }
              {
                parent: "head"
                type: "Ellipsoid"
                position [0, 0.0004, 0.0098]
                scale [0.0046, 0.0028, 0.0038]
                color: swallowChestnut
              }
            ]
          )
        }
        // The flight feathers, the wings and the tail, near black, with the tail's white spots.
        {
          color: swallowSteelDeep
          specular: 0.02
          roughness: 0.75
          paints: concat(swallowTailSpots(swallowSides[0]), swallowTailSpots(swallowSides[1]))
        }
        // The eyes: near black under a clear coat that holds a small highlight.
        { color: "#0D0908", specular: 0.04, roughness: 0.35, coat: 0.5 }
        // The bill, legs and feet.
        { color: "#1A1513", specular: 0.01, roughness: 0.95 }
      ]
      shape Sweep "body" {
        group: swallowBodyGroup
        material: swallowPlumage
        position: swallowBodyAt
        rotation: swallowPitch
        curve {
          a: swallowChestAt
          b [0, 0.0012, (swallowChestAt[2] + swallowRumpAt[2]) / 2]
          c: swallowRumpAt
          radiusStart: swallowChestRadius
          radiusEnd: swallowRumpRadius
          bulge: 0.0015
        }
      }
      shape Superellipsoid "head" {
        group: swallowHeadGroup
        blend: "SmoothUnion"
        smooth: 0.006
        material: swallowPlumage
        position: swallowHeadAt
        rotation: swallowHeadTurn
        scale: swallowHeadScale
        exponent: 2.3
      }
      shape Prism "bill" {
        group: swallowHeadGroup
        material: swallowBill
        position: swallowOnHead(swallowBillRootLocal)
        rotation: swallowBillTurn
        scale [1, 1, swallowBillDepth]
        dilate: swallowBillRound
        profile {
          kind: "Convex"
          vertices: swallowBillProfile
          cornerRadius: 0.15
        }
      }
      for side in swallowSides {
        swallowEyeBead(side: side)
        swallowWing(side: side)
        swallowTailHalf(side: side)
        swallowLeg(side: side)
      }
    }
  }
}

// On the reservoir pavilion's west rail, facing east along the path with the tail hanging over the pool: the bird's +Z
// turns to world +X, so the feet land on the rail's edge at `swallowGrip` (the origin sits `swallowScale` times the
// foot's offset away from that point).
let swallowPerch = [
  swallowRailEdge[0] - swallowRailRound * sine(swallowGrip * radiansPerDegree) - swallowScale * swallowFootAt[2],
  swallowRailEdge[1] + swallowRailRound * cosine(swallowGrip * radiansPerDegree) - swallowScale * swallowFootAt[1],
  -14.5
]

placements {
  placement "swallow" {
    prototype: "swallow"
    position: swallowPerch
    yawDegrees: -90
    scale: swallowScale
  }
}

cameras [
  {
    name: "swallow-portrait"
    renderWidth: 1280
    renderHeight: 900
    rig {
      name: "swallow-portrait"
      version: "puck.camera.program.v1"
      operations [
        anchor(
          opcode: "anchor",
          subject: worldPoint(point: [swallowPerch[0] + 0.32, swallowPerch[1] + 0.12, swallowPerch[2] - 0.22])
        )
        lookAt(
          focusDistance: 0.4,
          opcode: "lookAt",
          subject: worldPoint(point: [swallowPerch[0], swallowPerch[1] + 0.04, swallowPerch[2]]),
          worldAxes: false
        )
        fieldOfView(fieldOfViewRadians: 0.6, opcode: "fov")
      ]
    }
  }
  {
    name: "swallow-side"
    renderWidth: 1280
    renderHeight: 900
    rig {
      name: "swallow-side"
      version: "puck.camera.program.v1"
      operations [
        anchor(
          opcode: "anchor",
          subject: worldPoint(point: [swallowPerch[0] - 0.02, swallowPerch[1] + 0.02, swallowPerch[2] - 0.45])
        )
        lookAt(
          focusDistance: 0.45,
          opcode: "lookAt",
          subject: worldPoint(point: [swallowPerch[0] - 0.02, swallowPerch[1] + 0.01, swallowPerch[2]]),
          worldAxes: false
        )
        fieldOfView(fieldOfViewRadians: 0.6, opcode: "fov")
      ]
    }
  }
]
