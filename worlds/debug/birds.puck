// The valley's birds: a barn swallow perched on the reservoir pavilion's west rail, facing out over the pool it hunts
// above. `debug.go pool` stands a body on the path a few metres north-east of it.
//
// References (a male barn swallow, Hirundo rustica, perched): a glossy steel-blue back, crown, wings and tail; a rich
// chestnut forehead and throat; a dark blue breast band closing the throat off from cream-to-buff underparts; a long,
// deeply forked tail whose outer streamers reach well past the folded wingtips, with a row of white spots on its inner
// webs; long, pointed wings folded along the back and crossing over the rump; a tiny dark bill under a flat crown, and
// short legs hidden by the belly. It is drawn in the valley-and-gallery treatment (docs/game/art/README.md, the visual
// bar): one shaped body, flat values, crisp painted markings and a glossy plumage that catches the sky.
//
// It is sculpted at a real bird's size, in metres, and placed at 1.3 times that, so it reads at the distances
// the pool's path shows it from. Its parts are grouped for the idle rig (open items, the visual bar packet): the body
// and wings in one group, the head with its bill and eyes in another, the tail in a third.
import "../standard/rotations"

let swallowPlumage = 0
let swallowFlight = 1
let swallowTail = 2
let swallowEye = 3
let swallowBill = 4

let swallowBodyGroup = 1
let swallowHeadGroup = 2
let swallowTailGroup = 3

let swallowAxisX = [1, 0, 0]
let swallowAxisY = [0, 1, 0]
let swallowAxisZ = [0, 0, 1]

// The body's centre and its nose-up pitch; the head sits forward and above it.
let swallowBodyAt = [0, 0.024, 0]
let swallowPitch = turn(swallowAxisX, -18)
let swallowHeadAt = [0, 0.0425, 0.025]

// The feathered blades (the wings and the tail halves) are thin convex prisms grown by a dilation: the dilation rounds
// every edge and keeps even a pointed tip at least twice its own radius thick, so no tip thins below the bake's cells.

// One half of the forked tail from above, inset by its dilation: the inner edge runs from the fork's notch out to the
// streamer's tip, the outer edge from the root straight back to it. Profile X runs out to the bird's side and Y back.
let swallowTailRound = 0.0012
let swallowTailProfile = [[0.003, 0.038], [0.0172, 0.108], [0.0178, 0.1075], [0.0075, -0.004], [0.0015, -0.004]]

// A profile mirrored across X, its order reversed so it still winds clockwise.
function swallowMirror(profile, sign) = (sign > 0) ? profile : map(
  range(0, length(profile)),
  i => [0 - profile[length(profile) - 1 - i][0], profile[length(profile) - 1 - i][1]]
)

let swallowSides = [{ name: "Left", sign: 1 }, { name: "Right", sign: -1 }]

// One folded wing a side as the side view sees it, inset by its dilation: a rounded shoulder at the origin, the upper
// edge along the back and the lower edge sweeping up to the pointed tip 10.5 cm behind. Profile X runs back and Y up.
let swallowWingRound = 0.0014
let swallowWingProfile = [[-0.012, -0.001], [0, 0.0065], [0.108, -0.003], [0.1065, -0.0038], [0.035, -0.0105], [0, -0.0085]]

// The wing lies in the body's side plane (the profile's X turned to point back), rolled so its upper edge tucks over
// the back, yawed so the tips close over the rump, and pitched less than the body so they ride above the tail.
function swallowWingTurn(sign) = turnThen(
  turnThen(turnThen(turn(swallowAxisY, 90), turn(swallowAxisZ, sign * 22)), turn(swallowAxisY, sign * 4)),
  turn(swallowAxisX, -7)
)

template swallowWing(side) {
  shape Prism $"wing{side.name}" {
    group: swallowBodyGroup
    blend: "SmoothUnion"
    smooth: 0.007
    material: swallowFlight
    position [side.sign * 0.0085, 0.031, 0.017]
    rotation: swallowWingTurn(side.sign)
    scale [1, 1, 0.0018]
    dilate: swallowWingRound
    profile {
      kind: "Convex"
      vertices: swallowWingProfile
      cornerRadius: 0.001
    }
  }
}

// A tail half lies flat (the profile's Y turned to point back), continuing the body's line a little below level, its
// outer edge lifted a little.
template swallowTailHalf(side) {
  shape Prism $"tail{side.name}" {
    group: swallowTailGroup
    blend: "SmoothUnion"
    smooth: 0.003
    material: swallowTail
    position [0, 0.019, -0.024]
    rotation: turnThen(turn(swallowAxisX, -94), turn(swallowAxisZ, side.sign * 6))
    scale [1, 1, 0.001]
    dilate: swallowTailRound
    profile {
      kind: "Convex"
      vertices: swallowMirror(swallowTailProfile, side.sign)
      cornerRadius: 0.001
    }
  }
}

// An eye a side: a glossy dark bead set into the head so only its cap shows.
template swallowEyeBead(side) {
  shape Sphere $"eye{side.name}" {
    group: swallowHeadGroup
    material: swallowEye
    position [side.sign * 0.007, swallowHeadAt[1] + 0.001, swallowHeadAt[2] + 0.0065]
    scale [0.0028, 0.0028, 0.0028]
  }
}

// The white spots on a tail half's inner web, dashes along the feather painted through the blade so both faces show
// them.
function swallowTailSpots(side) = [
  {
    parent: $"tail{side.name}"
    type: "Ellipsoid"
    position [side.sign * 0.009, 0.05, 0]
    scale [0.0022, 0.0045, 0.003]
    color: "#F4F1EA"
  }
  {
    parent: $"tail{side.name}"
    type: "Ellipsoid"
    position [side.sign * 0.0122, 0.072, 0]
    scale [0.0017, 0.004, 0.003]
    color: "#F4F1EA"
  }
]

prototypes {
  prototype "swallow" {
    document {
      name: "swallow"
      schema: "puck.creation.v1"
      palette [
        // The plumage of the body and head, with its markings painted on: the cream underparts below a line along the
        // flank that dips under the breast, the chestnut throat under the bill, and the chestnut forehead above it.
        // What the paints leave between the throat and the cream is the breast band.
        {
          color: "#16305A"
          specular: 0.06
          roughness: 0.4
          sheen: 0.3
          coat: 0.3
          paints [
            {
              parent: "body"
              type: "Ellipsoid"
              position [0, -0.033, -0.02]
              scale [0.05, 0.03, 0.045]
              color: "#EFDCBE"
            }
            {
              parent: "head"
              type: "Ellipsoid"
              position [0, -0.0088, 0.0088]
              scale [0.0082, 0.0088, 0.0098]
              color: "#8C3A22"
            }
            {
              parent: "head"
              type: "Ellipsoid"
              position [0, 0.0025, 0.0115]
              scale [0.0045, 0.0022, 0.003]
              color: "#8C3A22"
            }
          ]
        }
        // The wings, a shade darker than the back.
        { color: "#11264A", specular: 0.06, roughness: 0.4, sheen: 0.3, coat: 0.3 }
        // The tail, as the wings, with its white spots.
        {
          color: "#11264A"
          specular: 0.06
          roughness: 0.4
          sheen: 0.3
          coat: 0.3
          paints: concat(swallowTailSpots(swallowSides[0]), swallowTailSpots(swallowSides[1]))
        }
        // The eyes: near black under a clear coat that holds a small highlight.
        { color: "#0D0908", specular: 0.04, roughness: 0.35, coat: 0.6 }
        // The bill and feet.
        { color: "#2A2523", specular: 0.04, roughness: 0.6 }
      ]
      // One shaped body: a near-ellipsoid along its length, full at the breast and narrowing to the rump.
      shape Superellipsoid "body" {
        group: swallowBodyGroup
        material: swallowPlumage
        position: swallowBodyAt
        rotation: swallowPitch
        scale [0.015, 0.0158, 0.041]
        exponent: 2.2
        flare {
          amount: -0.45
          bulge: 0.12
          span: 0.082
          top: 0.041
          axis: 2
          startScale: 1
        }
      }
      // The head: a slightly flattened round crown, grown out of the breast.
      shape Superellipsoid "head" {
        group: swallowHeadGroup
        blend: "SmoothUnion"
        smooth: 0.011
        material: swallowPlumage
        position: swallowHeadAt
        scale [0.0108, 0.0104, 0.0118]
        exponent: 2.2
      }
      // The bill: a short dark cone pointing forward and a little down.
      shape Cone "bill" {
        group: swallowHeadGroup
        material: swallowBill
        position [0, swallowHeadAt[1] - 0.0025, swallowHeadAt[2] + 0.0135]
        rotation: turn(swallowAxisX, 100)
        scale [0.0033, 0.0052, 0.0033]
      }
      for side in swallowSides {
        swallowEyeBead(side: side)
        swallowWing(side: side)
        swallowTailHalf(side: side)
      }
    }
  }
}

// On the reservoir pavilion's west rail (water-scenery.puck's `reservoir-pavilion`, its rail's top at 1.22 m), its belly
// on the rail near its outer edge, facing west over the pool with its tail over the rail.
let swallowPerch = [-45.86, 1.2098, -14.5]

placements {
  placement "swallow" {
    prototype: "swallow"
    position: swallowPerch
    yawDegrees: 90
    scale: 1.3
  }
}

cameras [
  {
    name: "swallow-portrait"
    renderWidth: 1280
    renderHeight: 900
    rig {
      name: "swallow-portrait"
      version: "puck.camera.program.v1"
      operations [
        anchor(opcode: "anchor", subject: worldPoint(point: [swallowPerch[0] - 0.32, swallowPerch[1] + 0.14, swallowPerch[2] - 0.22]))
        lookAt(focusDistance: 0.4, opcode: "lookAt", subject: worldPoint(point: [swallowPerch[0], swallowPerch[1] + 0.04, swallowPerch[2]]), worldAxes: false)
        fieldOfView(fieldOfViewRadians: 0.6, opcode: "fov")
      ]
    }
  }
  {
    name: "swallow-side"
    renderWidth: 1280
    renderHeight: 900
    rig {
      name: "swallow-side"
      version: "puck.camera.program.v1"
      operations [
        anchor(opcode: "anchor", subject: worldPoint(point: [swallowPerch[0] + 0.06, swallowPerch[1] + 0.06, swallowPerch[2] - 0.45]))
        lookAt(focusDistance: 0.45, opcode: "lookAt", subject: worldPoint(point: [swallowPerch[0] + 0.06, swallowPerch[1] + 0.04, swallowPerch[2]]), worldAxes: false)
        fieldOfView(fieldOfViewRadians: 0.6, opcode: "fov")
      ]
    }
  }
]
