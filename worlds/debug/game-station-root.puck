// One game station on its own: the debug world set's station (game-stations.puck, over the standard's
// ../standard/game-station.puck), holding its own games of chess, Klondike and FreeCell, on a small floor under a clear
// day, booted alone so a change to the station bakes and boots only the station. Boot it with
// `--world worlds/debug/game-station-root.puck`: the seat starts at the station's near chair (`hero`), a second seat at
// its far chair (`rival`), and the context button sits a seat down at the glass. The station's id is `station`.

schema: "puck.world.definition.v1"
basis: "stage"
documentId: "game-station"

import "set-controls"
import "../standard/skies"
import "game-stations"

metadata {
  title: "Game station"
  description: "One game station from the debug world set on a small floor, for iterating on the station."
}

gameStationRoom(stations: [rootStation])

state {
  // The chess game's vocabularies (game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}

use gameStationGames as station(station: rootStation, index: 0)

render {
  farDistance: 200
  lighting {
    lights [
      sunlight(direction: [-2, 4, -3], color: "#FFF1D6", illuminance: 60000lx)
    ]
  }
  sky {
    clearDay()
  }
  atmosphere {
    clearDayAir()
  }
}
