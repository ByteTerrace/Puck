// What a seat and a session that may not read some of a row's cells are told about that row: the smallest fixture of
// the noninterference harness. `puck disclosure worlds/debug/disclosure-probe.puck` boots one world per variant of
// disclosure-probe.disclosure.json beside it. Each variant's operator steps mint zero, one or two cells only seat1
// reads into `hand` (or one only later), seat2 runs the same console lines in every world, and a replica, a
// presentation and a writing session observe each world; anything seat2 or a session receives that differs between
// two variants is a leak, named by where its stream first differs and by the doors that answered differently.
//
// The variants replace `hand` (dropping the public `a`) with their hidden cells first and add the public `pub` after,
// so `pub` lands behind them in the row's storage and in `probe-hand`'s deal, a shape no reader's answer may reflect.
// The row's `cellVisibility: true` declares that its cells may carry their own readers, so it is a restricted row for
// every seat whether or not a hidden member is present now. `probe-hand` deals one card per cell of `hand`: what a
// reader is shown of the dealt cards (their count, slots and positions) is a door too.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "disclosure-probe"

bodies {
  localSeats: 2
  seatActivation [Eager, Eager]
  seatSpawns ["stage", "stage"]
}

// The sessions the harness observes from: the authority's name decides the tier. The writer may mutate the state
// section and edit `hand` and `pile` as well as observe, so its drawn writes, transforms and guarded batches reach the
// mutation path rather than stopping at a capability denial.
admission [
  {
    disclosure: Replica
    domain: "replica"
    grants [{ budget: 64, capability: Observe, subject: "all" }]
    mode: FederatedAuthority
  }
  {
    disclosure: Presentation
    domain: "presentation"
    grants [{ budget: 64, capability: Observe, subject: "all" }]
    mode: FederatedAuthority
  }
  {
    disclosure: Replica
    domain: "writer"
    grants [
      { budget: 64, capability: Observe, subject: "all" }
      {
        budget: 64
        capability: Mutate
        subject: "section:State"
        kindMask: "UpsertStateCell,RemoveStateCell,Generate,TransformState,Batch"
      }
      { budget: 64, capability: Edit, subject: "state:hand" }
      { budget: 64, capability: Edit, subject: "state:pile" }
    ]
    mode: FederatedAuthority
  }
]

// `pile` is public: a transform moving a card from `hand` to it, or a write guarded on a `hand` cell, is a door from
// the hidden row into a public one.
state {
  world {
    row {
      name: "hand"
      kind: "Int"
      capacity: 4
      cellVisibility: true
      cells [{ key: "a", value: 1 }]
    }
    row {
      name: "pile"
      kind: "Int"
      capacity: 8
      cells [{ key: "top", value: 0 }]
    }
  }
}

prototypes {
  prototype "probeCard" {
    document {
      name: "probeCard"
      palette [{ color: "#E8E2D0", roughness: 0.8 }]
      schema: "puck.creation.v1"
      shape Box "card" {
        material: 0
        position [0, 0, 0]
        scale [0.06, 0.002, 0.09]
      }
    }
  }
}

placements {
  // Public membership with a restricted variant row exercises the same missing-child reconciliation boundary.
  placement "probe-faces" {
    prototype: "probeCard"
    position [1, 0.8, 4]
    distribution {
      fill {
        name: "none"
        offset: 0
        step: 0
      }
      region: lattice(stepA: [0.15, 0, 0], countA: 8, stepB: [0, 0, 0.2], countB: 1)
    }
    deal {
      row: "pile"
      variants {
        row: "hand"
        map {
          "3": "probeCard"
        }
      }
    }
  }
  placement "probe-hand" {
    prototype: "probeCard"
    position [0, 0.8, 4]
    distribution {
      fill {
        name: "none"
        offset: 0
        step: 0
      }
      region: lattice(stepA: [0.15, 0, 0], countA: 4, stepB: [0, 0, 0.2], countB: 1)
    }
    deal {
      row: "hand"
    }
  }
}

schedule {
  settleTicks: 4
  rows [
    { tick: 20, principal: "seat2", command: "world.row state hand" }
    { tick: 20, principal: "seat2", command: "world.state hand" }
    { tick: 20, principal: "seat2", command: "world.hud.template p={state.hand.pub}" }
    { tick: 20, principal: "seat2", command: "world.hud.template s={state.hand.secret0}" }
    { tick: 20, principal: "seat2", command: "world.hud.template n={state.hand.nothing}" }
    { tick: 20, principal: "seat2", command: "world.state.observe" }
    { tick: 20, principal: "seat2", command: "world.observe seat2" }
    { tick: 21, principal: "seat2", command: "world.row.step state.hand.max 1" }
    { tick: 60, principal: "seat2", command: "world.state hand" }
  ]
}
