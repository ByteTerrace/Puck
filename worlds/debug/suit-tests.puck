// The Moth's suit on and off (suit.puck), each scenario booted in the whole debug world:
// `puck test worlds/debug/suit-tests.puck --reproduce`. `bodyState(body, 0, suit)` is body 0's own register, which
// selects her kit (walker in the suit, pilot out of it) and her look (moth, or moth-pilot). Flight mode is the walker's:
// pressing flight and holding rise lifts her off the ground in the suit and leaves her standing out of it.
//
// The crossing scenarios walk her at the garden painting and back. A headless seat's camera faces -Z, so
// `body.fly -1 …` walks +Z: from the pose before the painting (z 36.3) into its glass, and in the garden from just past
// the arrival frame (z -8.2) back through it, out of the painting at z 39.3. Her registers cross with her both ways, so
// what she did in the garden reads here: a flight press there turns flight mode on only in the suit, and flightFuel
// comes home with whatever it did. `puck test` stages the garden beside each scenario world, and the garden's way back
// names this world's id, so she comes home to the instance the run booted and body 0 is her again.

schema: "puck.world.definition.v1"
basis: "debug"
// The debug world's own id: the garden's way back names the document `debug`, so a scenario world under another id
// would send her home to a second world rather than to this one.
documentId: "debug"

// The crossing's witness. A live body's size never falls below a quarter (size.puck), so body 0's size reads 0 only
// while she is in another world: `away` latches that she left, and a crossing scenario that never leaves fails on it.
state {
  world {
    table away {
      "0" = 0
    }
  }
}

rule "round-trip-away" {
  when $tick > 10 and bodyState(body, 0, size) == 0
  mode: Edge
  away[0] = 1
}

// The two-seat scenarios seat a second body: the toggle is one rule per local seat (suit-toggle.puck), and this world
// seats two where the Moth worlds seat one, so it instantiates the second seat's own.
import "suit-toggle"

bodies {
  localSeats: 2
  seatActivation [Eager, Eager]
  seatSpawns ["stage", "stage"]
}

suitToggle(seat: 2, index: 1)

test "the Moth starts in the suit" {
  when {
    ticks 30
  }
  expect {
    bodyState(body, 0, suit) == 1
  }
}

test "in the suit, flight lifts her off the ground" {
  when {
    ticks 30
    seat1: body.press flight 1 0.2 0
    ticks 15
    seat1: body.press rise 1 1 0
    ticks 30
  }
  expect {
    bodyState(body, 0, suit) == 1
    bodyState(body, 0, flightFuel) > 0
    bodyPosition(body, 0, y) > 1
  }
}

test "a press on the ground takes the suit off and refuses flight" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.press flight 1 0.2 0
    ticks 15
    seat1: body.press rise 1 1 0
    ticks 30
  }
  expect {
    bodyState(body, 0, suit) == 0
    bodyState(body, 0, flightFuel) == 0
    airPose[0] == 0
    bodyPosition(body, 0, y) < 0.5
  }
}

test "a second press puts the suit back on and flight works again" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.press flight 1 0.2 0
    ticks 15
    seat1: body.press rise 1 1 0
    ticks 30
  }
  expect {
    bodyState(body, 0, suit) == 1
    bodyPosition(body, 0, y) > 1
  }
}

test "a press in the air leaves the suit on" {
  when {
    ticks 30
    seat1: body.press jump 1 0.3 0
    ticks 6
    seat1: body.press suit 1 0.1 0
    ticks 45
  }
  expect {
    bodyState(body, 0, suit) == 1
  }
}

// The control for the next scenario: in the suit, the same flight press in the garden turns flight mode on, and the
// fuel comes home with her.
test "in the suit she crosses suited, and flight mode works in the garden" {
  when {
    ticks 30
    seat1: body.pose 57 0.05 36.3 180 0 0
    ticks 10
    seat1: body.fly -1 0 0 0 0 0 2
    ticks 70
    seat1: body.press flight 1 0.2 0
    ticks 15
    seat1: body.fly -1 0 0 0 0 0 1
    ticks 45
  }
  expect {
    away[0] == 1
    bodyState(body, 0, suit) == 1
    bodyState(body, 0, flightFuel) > 0
    bodyPosition(body, 0, z) > 38
  }
}

test "out of the suit she crosses unsuited, and the garden refuses her flight" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.pose 57 0.05 36.3 180 0 0
    ticks 10
    seat1: body.fly -1 0 0 0 0 0 2
    ticks 70
    seat1: body.press flight 1 0.2 0
    ticks 15
    seat1: body.press rise 1 1 0
    ticks 30
    seat1: body.fly -1 0 0 0 0 0 1
    ticks 45
  }
  expect {
    away[0] == 1
    bodyState(body, 0, suit) == 0
    bodyState(body, 0, flightFuel) == 0
    bodyPosition(body, 0, z) > 38
  }
}

test "suited up in the garden, she comes home suited and flies" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.pose 57 0.05 36.3 180 0 0
    ticks 10
    seat1: body.fly -1 0 0 0 0 0 2
    ticks 70
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.fly -1 0 0 0 0 0 1
    ticks 45
    seat1: body.press flight 1 0.2 0
    ticks 15
    seat1: body.press rise 1 1 0
    ticks 30
  }
  expect {
    away[0] == 1
    bodyState(body, 0, suit) == 1
    bodyPosition(body, 0, y) > 1
    bodyPosition(body, 0, z) > 38
  }
}

// Each seat toggles its own body: a press on the second seat's suit channel takes off the second body's suit and leaves
// the first seat's body in hers, and a press from each takes off both.
test "the second seat's press takes off only its own suit" {
  when {
    ticks 30
    seat2: body.press suit 1 0.2 1
    ticks 15
  }
  expect {
    bodyState(body, 1, size) == 1
    bodyState(body, 0, suit) == 1
    bodyState(body, 1, suit) == 0
  }
}

test "the first seat's press leaves the second seat in her suit" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    ticks 15
  }
  expect {
    bodyState(body, 1, size) == 1
    bodyState(body, 0, suit) == 0
    bodyState(body, 1, suit) == 1
  }
}

// The Humble Gaming Brick (devices.puck): standing a metre in front of it, the context button engages it. Out of the
// suit she picks it up, so her pilotHold cell raises her look's hold pose and the brick's placement shows nothing on
// its rest; the same button puts it back. In the suit she plays it where it stands.
test "out of the suit, engaging the brick picks it up" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.pose 7.6 0.05 29.4 90 0 0
    ticks 5
    seat1: body.press interact 1 0.2 0
    ticks 10
  }
  expect {
    engaged(body, 0, 0) == 1
    pilotHold[0] == 1
  }
}

test "leaving the brick puts it back" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    ticks 15
    seat1: body.pose 7.6 0.05 29.4 90 0 0
    ticks 5
    seat1: body.press interact 1 0.2 0
    ticks 10
    seat1: body.press interact 1 0.2 0
    ticks 10
  }
  expect {
    engaged(body, 0, 0) == 0
    pilotHold[0] == 0
  }
}

test "in the suit, she plays the brick where it stands" {
  when {
    ticks 30
    seat1: body.pose 7.6 0.05 29.4 90 0 0
    ticks 5
    seat1: body.press interact 1 0.2 0
    ticks 10
  }
  expect {
    engaged(body, 0, 0) == 1
    pilotHold[0] == 0
  }
}

test "a press from each seat takes off both suits" {
  when {
    ticks 30
    seat1: body.press suit 1 0.2 0
    seat2: body.press suit 1 0.2 1
    ticks 15
  }
  expect {
    bodyState(body, 1, size) == 1
    bodyState(body, 0, suit) == 0
    bodyState(body, 1, suit) == 0
  }
}
