import "../standard/inputs"
import "chess-table"
// Physical chess in the debug world: one table of 32 rigid piece bodies whose every settled arrangement is judged against
// the last legal board, with captures, promotion, castling, en passant, check, the draw limits and a one-ply computer
// opponent (the table is chess-table.puck's module, over the rules in ../games/chess.puck). The debug world imports
// this file whole. The table stands in the gallery hall's board game room on level 2 (gallery/gallery.puck): its board's
// centre over the table's placement (`chessTable`), White's back rank on its -Z side and Black's on +Z. chess.md beside
// this file says how to move a piece, read the game and set the opponent. The board game room's game station
// (gallery/games.puck) draws the same game on its glass and asks its moves through the display door, so a game played at
// either table is one game.

// What a game station's glass (../standard/game-station.puck, the gallery's board game room) reads of this game to draw
// it, and the door it asks a move through (`chessPut`, ../games/chess.puck's chessPutDown).
export read board, turn, verdict, move, inCheck, aiSide, halfmoveClock, repetitionCount, chessPut, chessSeated
export action chessPut, chessSeated

// The debug world reserves 18 lower slots (4 seats, 8 visitors and 6 range targets); the table's 32 pieces and its board
// cursor take the rest.
bodies {
  capacity: 51
}

// The pieces are bodies 18 to 49, piece n body 49 - n, above the four seats, eight visitors and six range walkers
// (debug.puck), and the seat drives each of them: a seat's `body.pose <x> <y>
// <z> 0 0 0 <body>` lifts a piece onto a square (chess.md).
grants: concat(
  map(range(18, 50), body => { budget: 64, capability: Drive, grantee: "seat1", subject: $"body:{body}" }),
  [{ capability: Edit, grantee: "seat1", subject: "state:chessInput" }]
)

// The table's placement, its creation's floor 0.5 m under its origin on level 2's floor (y 9.05), and the ticks the
// physics must stay at rest before an arrangement is judged (0.3 s at the debug world's 30 Hz). The rigid solver's own
// resting latch has already held each piece still before its own resting fact reads 1, so the hold only has to outlast
// a piece that is touched, knocked or dropped beside another settling.
let chessTable = [37, 8.55, 10.3]
let chessSettleTicks = 9
let chessDemoIdleSeconds = 60
let chessDemoHoldSeconds = 12
let chessDemoPlyTicks = 90

physicalChessSet()

// The table, its rows under their plain names (no alias), its judge gated by the idle demonstration's replay scope, and
// the demonstration holding its computer off while it plays.
use physicalChessTable(at: chessTable, settleTicks: chessSettleTicks, scope: "chess-demo", demo: true)

state {
  // The rules' vocabularies (../games/chess.puck), declared here so the rules fold their members and every document
  // built on this table reads them by name.
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }

  world {
    table chessDemo capacity(auto) {
      enabled = 1
      ready = 0
      playing = 0
      near = 0
      lastTurn = 0
      idleDue = 0
      holdDue = 0
      loops = 0
      matches = 0
      cancelled = 0
      // The live debug world's authored 30 Hz, in seconds at the authoring boundary.
      idleTicks = chessDemoIdleSeconds * 30
      holdTicks = chessDemoHoldSeconds * 30
    }
    table chessTape capacity(auto) {
      request = 0
      status = 0
      cursor = 0
      completed = 0
    }
    table chessDemoInk capacity(auto) {
      recorded = "#000000"
      match = "#000000"
      mismatch = "#000000"
      result = "#000000"
    }
  }
}

// ---- The idle historical demonstration ---------------------------------------------------------------
// Deep Blue (White) - Garry Kasparov, New York, 11 May 1997, game 6, 1-0.
// chess.md cites the public score. The source authors inputs, never boards or expected hashes.
// The first idle run derives the tape through the live move door; later loops compare against that recording.
replays [
  {
    name: "chess-demo"
    control: chessTape
    rows [
      board, lastLegal, plan, ai, aiEnabled, aiRevision, aiBest, aiBefore,
      pieceOrdinal, pieceCode, pieceCell, play, putDown, putBefore, putBeforeCode, chessRested, chessHold,
      turn, verdict, illegalCount, settleHold, gameStarted, move,
      promotionPending, enPassantTarget, inCheck, previousInCheck,
      positionCounts, enPassantProbe, enPassantProbeCheck, repetitionEnPassant,
      historyPending, historyReset, historyLength, halfmoveClock, repetitionCount,
      shapeLegal, castleLegal, castleRights, castleTransitAttacked,
      boardMismatch, boardChanged, boardCollisions, chessInput
    ]
    bodies: range(18, 51)
    seats ["seat1"]
    durationTicks: 37 * chessDemoPlyTicks
    inputs: map(
      [
        [11, 27],
        [53, 45],
        [12, 28],
        [52, 36],
        [6, 21],
        [36, 27],
        [21, 27],
        [62, 52],
        [27, 33],
        [57, 42],
        [2, 20],
        [51, 43],
        [1, 18],
        [48, 40],
        [33, 43],
        [60, 51],
        [3, 1],
        [50, 43],
        [20, 41],
        [59, 60],
        [5, 26],
        [54, 38],
        [15, 31],
        [61, 54],
        [2, 3],
        [42, 36],
        [26, 17],
        [60, 61],
        [31, 38],
        [45, 38],
        [4, 20],
        [54, 45],
        [41, 34],
        [43, 34],
        [3, 51],
        [58, 51],
        [13, 29]
      ],
      (move, i) => {
        tick: i * chessDemoPlyTicks
        principal: "seat1"
        cells [
          { row: chessInput, key: from, value: move[0] }
          { row: chessInput, key: to, value: move[1] }
          { row: chessInput, key: request, value: 1 }
        ]
      }
    )
  }
]

// A scope that holds no starting state (status -2: an edit re-declared one of its rows) gives up the loop it was in and
// lets the fresh-start rule below capture again. A diverged replay (status -1) still holds its start and loops on.
rule "chess-demo-lost-start" {
  when chessTape.status == -2
  mode: Level
  chessDemo.ready = 0
  chessDemo.playing = 0
  chessDemo.holdDue = 0
  chessDemoInk.recorded = "#000000"
  chessDemoInk.match = "#000000"
  chessDemoInk.mismatch = "#000000"
  chessDemoInk.result = "#000000"
}

rule "chess-demo-fresh-start" {
  when chessDemo.ready == 0 and gameStarted == 1 and settleHold == chessSettleTicks
  mode: Level
  chessTape.request = 4
  chessDemo.ready = 1
  chessDemo.idleDue = $tick + chessDemo.idleTicks
}

rule "chess-demo-near-reset" {
  mode: Level
  chessDemo.near = 0
}
// Within 3 m of the board's centre on the table's floor (its creation's floor lies 0.5 m over its origin).
for seat in range(0, 8) {
  rule $"chess-demo-near-{seat}" {
    local dx = bodyPosition(body, seat, x) - chessTable[0]
    local dy = bodyPosition(body, seat, y) - (chessTable[1] + 0.5)
    local dz = bodyPosition(body, seat, z) - chessTable[2]
    when (dx * dx + dy * dy + dz * dz) < 9
    mode: Level
    chessDemo.near = 1
  }
}

rule "chess-demo-engaged" {
  when board(engaged, board, 1) == 1 or chessSeated == 1
  mode: Level
  chessDemo.near = 1
}

rule "chess-demo-idle-reset" {
  when chessDemo.near == 1 or turn != chessDemo.lastTurn
  mode: Level
  chessDemo.idleDue = $tick + chessDemo.idleTicks
}
rule "chess-demo-remember-turn" {
  mode: Level
  chessDemo.lastTurn = turn
}

rule "chess-demo-cancel" {
  when chessDemo.playing == 1 and (chessDemo.near == 1 or chessDemo.enabled == 0)
  mode: Level
  chessTape.request = 2
  chessDemo.playing = 0
  chessDemo.holdDue = 0
  chessDemo.cancelled += 1
  chessDemoInk.recorded = "#000000"
  chessDemoInk.match = "#000000"
  chessDemoInk.mismatch = "#000000"
  chessDemoInk.result = "#000000"
}

rule "chess-demo-idle-start" {
  when (chessDemo.ready == 1 and
    chessDemo.enabled == 1 and
    chessDemo.playing == 0 and
    chessDemo.near == 0 and
    $tick >= chessDemo.idleDue)
  mode: Level
  chessTape.request = 1
  chessDemo.playing = 1
  chessDemo.holdDue = 0
}

rule "chess-demo-result" {
  when chessDemo.playing == 1 and chessTape.status >= 3 and chessDemo.holdDue == 0
  mode: Level
  chessDemo.loops += 1
  chessDemo.holdDue = $tick + chessDemo.holdTicks
  chessDemoInk.result = "#F2E9D8"
  if chessTape.status == 4 {
    chessDemo.matches += 1
    chessDemoInk.match = "#58D68D"
  } else {
    chessDemoInk.recorded = "#F0C674"
  }
}
rule "chess-demo-diverged" {
  when chessDemo.playing == 1 and chessTape.status == -1 and chessDemo.holdDue == 0
  mode: Level
  chessDemo.loops += 1
  chessDemo.holdDue = $tick + chessDemo.holdTicks
  chessDemoInk.mismatch = "#FF6655"
}

rule "chess-demo-loop" {
  when chessDemo.playing == 1 and chessDemo.holdDue > 0 and $tick >= chessDemo.holdDue
  mode: Level
  chessTape.request = 1
  chessDemo.holdDue = 0
  chessDemoInk.recorded = "#000000"
  chessDemoInk.match = "#000000"
  chessDemoInk.mismatch = "#000000"
  chessDemoInk.result = "#000000"
}

// The table's slim display sits beyond Black's back rank, facing White, `up` metres over the table's origin. Each line is
// a text screen; state-backed ink lights the verdict that actually occurred. No engine screen knows this game's
// vocabulary.
function chessScreenAt(up) = [chessTable[0], (chessTable[1] + up), (chessTable[2] + 1.05)]
screens [
  {
    index: 12
    origin: chessScreenAt(2)
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.09
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["DEEP BLUE - KASPAROV", "NEW YORK 1997 - GAME 6"] }
  }
  {
    index: 8
    origin: chessScreenAt(1.81)
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["19.c4  1-0  BLACK RESIGNED"], foreground: "state.chessDemoInk.result" }
  }
  {
    index: 9
    origin: chessScreenAt(1.67)
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["SCOPE TAPE RECORDED"], foreground: "state.chessDemoInk.recorded" }
  }
  {
    index: 10
    origin: chessScreenAt(1.53)
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["SCOPE HASH MATCH"], foreground: "state.chessDemoInk.match" }
  }
  {
    index: 11
    origin: chessScreenAt(1.39)
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["SCOPE HASH MISMATCH"], foreground: "state.chessDemoInk.mismatch" }
  }
]

commands [
  {
    name: "chess.move"
    help: "Requests a move through the table's real apply and settled-board judge. Cells count 8 * rank + 7 - file from a1."
    parameters [
      { name: "from", kind: Integer }
      { name: "to", kind: Integer }
    ]
    lines [
      "world.state.cell.set chessInput from {from}"
      "world.state.cell.set chessInput to {to}"
      "world.state.cell.set chessInput request 1"
    ]
  }
]
