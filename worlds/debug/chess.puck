import "../standard/inputs"
import "../standard/kits"
import "../standard/seat"
import "../games/chess"
// Physical chess: a table of 32 rigid piece bodies whose every settled arrangement is judged against the last legal
// board (the tabletop primitive), with captures, promotion, castling, en passant, check, the draw limits and a
// one-ply computer opponent. The debug world imports this file whole. The table stands in the gallery hall's board game
// room at the east end of level 2 (hall.puck), south-west of the Reversi table and south of the Go table: its board's
// centre at (56.5, 9.85, 22.6), White's back rank on its -Z side, toward the south windows, and Black's on +Z, toward
// the room's doorway aisle. chess.md beside this file says how to move a piece,
// read the game and set the opponent.

// The Moth basis seats eight bodies; the 32 pieces and the board cursor take the rest.
bodies {
  capacity: 41
}

// The pieces are bodies 8 to 39, piece n body 39 - n, and the seat drives each of them: a seat's `body.pose <x> <y>
// <z> 0 0 0 <body>` lifts a piece onto a square (chess.md).
grants: concat(
  map(range(8, 32), body => { capability: Drive, grantee: "seat1", subject: $"body:{body}" }),
  [{ capability: Edit, grantee: "seat1", subject: "state:chessInput" }]
)

// The table's placement, its creation's floor 0.5 m under its origin on level 2's floor (y 9.05), and the ticks the
// physics must stay at rest before an arrangement is judged (0.3 s at the debug world's 30 Hz). The rigid solver's own
// resting latch has already held each piece still before its own resting fact reads 1, so the hold only has to outlast
// a piece that is touched, knocked or dropped beside another settling.
let chessTable = [56.5, 8.55, 22.6]
let chessSettleTicks = 9
let chessDemoIdleSeconds = 60
let chessDemoHoldSeconds = 12
let chessDemoPlyTicks = 90

let pieceTypes = ["pawn", "knight", "bishop", "rook", "queen", "king"]
let pieceLooks = concat(
  map(pieceTypes, kind => $"piece_white_{kind}"),
  map(pieceTypes, kind => $"piece_black_{kind}")
)

looks: map(concat(pieceLooks, ["boardCursor"]), name => {
  motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
  name: name
  scale: 1
  source: creation(prototypeId: name)
})

// The board reads as a real one from each side. The `chessBoard` grid is world-axis-aligned, cell = 8 * row + column,
// its rows running +Z and its columns +X; a rank is a row (rank 1 on the -Z side, White's), and a file runs the other
// way, column = 7 - file, so the a-file lies on +X. Seated at White's -Z edge and looking +Z, the camera's right is -X
// (forward crossed with up), so a1 is dark at White's left, h1 light at her right, and the queen on her colour (d1,
// light) left of the king; from Black's +Z edge a8 is light at Black's right and h8 dark at his left. The kings start
// in column 3 and the queens in column 4, so the castling rules below name kingside by a falling column. Piece n
// stands on file n % 8 (piece 4 the white king on e1, piece 12 the e2 pawn), at column 7 - n % 8.
let boardCoords = [-0.7, -0.5, -0.3, -0.1, 0.1, 0.3, 0.5, 0.7]
let backRankTypes = ["rook", "knight", "bishop", "queen", "king", "bishop", "knight", "rook"]
// Cell (row, column) is light when row + column is even: column 0 of rank 1 is h1.
let squareTypes = ["boardSquareLight", "boardSquareDark"]

template piecePlacement(name, prototypeName, x, z) {
  placement name {
    prototype: prototypeName
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "piece"
      look: prototypeName
      source: "Idle"
    }
    parent: "chessTable"
    position [x, 1.8, z]
  }
}

template pieceProto(color, name, sx, sy, sz) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        scale [sx, sy, sz]
      }
    }
  }
}

template crownedPieceProto(color, name, sx, sy, sz, csx, csy, csz, crownY) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        scale [sx, sy, sz]
      }
      shape Sphere "crown" {
        blend: "SmoothUnion"
        material: 0
        position [0, crownY, 0]
        scale [csx, csy, csz]
        smooth: 0.01
      }
    }
  }
}

template squareProto(name, colorKey) {
  prototype name {
    document {
      name: name
      palette [
        {
          color: $"state.boardColors.{colorKey}"
          roughness: 0.846
          specular: 0.05
        }
      ]
      schema: "puck.creation.v1"
      shape Box "square" {
        material: 0
        position [0, 0, 0]
        scale [0.095, 0.004, 0.095]
      }
    }
  }
}

pieceKit(
  name: "piece",
  collider: box(halfExtents: [0.045, 0.12, 0.045], rotation: [0, 0, 0, 1]),
  mass: 0.12,
  friction: 0.5,
  restitution: 0.1,
  rollingResistance: 0.0015
)
heldKit(name: "boardCursor")


placements {
  // The table's top stands 0.8 m above the ground; its leg runs on below it.
  placement "chessTable" {
    prototype: "chessTable"
    board {
      move: "move"
      occupancy: "board"
      plan: "plan"
      topology: "chessBoard"
      turn: "turn"
      verdict: "verdict"
      // The context button within 2.5 m of the board's centre sits the seat down in the nearer chair, White's at the
      // -Z edge or Black's at the +Z edge, and the next press stands it up; seated, the camera looks down on the board
      // from the chair and the pointer picks squares on their tops, 6 cm above the board's frame.
      engage {
        channel: "interact"
        radius: 2.5
        pitch: 62
        margin: 0.12
        surface: 0.06
        seats [{ yawDegrees: 180 }, { yawDegrees: 0 }]
      }
    }
    position: chessTable
    solid
  }

  // The square cursor a seated player moves (body 40 in the debug world, before the pieces so they keep 8 to 39): the
  // rules pose it on the cursor's square while the seat sits at the table and park it inside the tabletop otherwise.
  placement "boardCursor" {
    prototype: "boardCursor"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "boardCursor"
      look: "boardCursor"
      source: "Idle"
    }
    parent: "chessTable"
    position [0, 1.25, 0]
  }

  for i in range(0, 8) {
    piecePlacement($"piece{i}", $"piece_white_{backRankTypes[i]}", boardCoords[7 - i], -0.7)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{8 + i}", "piece_white_pawn", boardCoords[7 - i], -0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{16 + i}", "piece_black_pawn", boardCoords[7 - i], 0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{24 + i}", $"piece_black_{backRankTypes[i]}", boardCoords[7 - i], 0.7)
  }

  for r in range(0, 8) {
    for c in range(0, 8) {
      placement $"boardSquare-{r * 8 + c}" {
        prototype: squareTypes[(r + c) % 2]
        parent: "chessTable"
        position [boardCoords[c], 1.305, boardCoords[r]]
      }
    }
  }
}

prototypes {
  prototype "chessTable" {
    document {
      name: "chessTable"
      palette [
        {
          color: "#8A6A45"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "top" {
        material: 0
        position [0, 1.25, 0]
        scale [1, 0.05, 1]
      }

      // The pedestal stands on the floor 0.5 m under the creation's origin.
      shape Cylinder "leg" {
        material: 0
        position [0, 0.855, 0]
        scale [0.08, 0.355, 0.08]
      }

      shape Cylinder "foot" {
        material: 0
        position [0, 0.52, 0]
        scale [0.45, 0.02, 0.45]
      }
    }
  }

  for color in ["white", "black"] {
    pieceProto(color, "pawn", 0.035, 0.09, 0.035)
    pieceProto(color, "knight", 0.04, 0.12, 0.04)
    pieceProto(color, "bishop", 0.04, 0.15, 0.04)
    pieceProto(color, "rook", 0.05, 0.11, 0.05)
    crownedPieceProto(color, "queen", 0.045, 0.17, 0.045, 0.055, 0.055, 0.055, 0.203)
    crownedPieceProto(color, "king", 0.045, 0.19, 0.045, 0.06, 0.06, 0.06, 0.226)
  }

  squareProto("boardSquareLight", "light")
  squareProto("boardSquareDark", "dark")

  // A square's outline, one cell across: four flat bars around the square the cursor stands on.
  prototype "boardCursor" {
    document {
      name: "boardCursor"
      palette [
        {
          color: "state.boardColors.cursor"
          roughness: 0.4
          specular: 0.3
        }
      ]
      schema: "puck.creation.v1"
      shape Box "near" {
        material: 0
        position [0, 0, -0.088]
        scale [0.1, 0.004, 0.012]
      }
      shape Box "far" {
        material: 0
        position [0, 0, 0.088]
        scale [0.1, 0.004, 0.012]
      }
      shape Box "left" {
        material: 0
        position [-0.088, 0, 0]
        scale [0.012, 0.004, 0.1]
      }
      shape Box "right" {
        material: 0
        position [0.088, 0, 0]
        scale [0.012, 0.004, 0.1]
      }
    }
  }
}

chessJudge(settleTicks: chessSettleTicks, scope: "chess-demo")

chessComputer(settleTicks: chessSettleTicks, scope: "chess-demo")

rule "chess-ai-enable" {
  mode: Level
  aiEnabled = (
    (aiSide == turn) and
    chessDemo.playing == 0 and
    (physics(quiescent, "chess-demo") == 1) and
    (settleHold == chessSettleTicks) and
    (gameStarted == 1) and
    (boardCollisions == 0) and
    ((verdict == 1) or (boardChanged == 0)) and
    (halfmoveClock < 150) and
    (repetitionCount < 5)
  )
}

chessMoveDoor(settleTicks: chessSettleTicks, scope: "chess-demo")

// A captured piece stands on the table's own margin (the top is 2 m across, the board 1.6 m, so a margin is 0.2 m wide),
// one column of 16 places 0.1 m apart per colour: White's along the -X margin (x -0.9 in the table's frame), Black's
// along the +X margin (0.9), each running +Z from -0.75 to 0.75. The offsets are from cell 0's centre (-0.7, -0.7).
let captureColumnX = [-0.2, 1.6]
for side in range(0, 2) {
  for slot in range(0, 16) {
    rule $"chess-ai-capture-{16 * side + slot}" {
      when (ai.pending == 1 and
        pieceCell[$"piece{16 * side + slot}"] != ((aiBefore[$"piece{16 * side + slot}"] & 127) - 1) and
        pieceCell[$"piece{16 * side + slot}"] < 0)
      mode: Level
      poseCell(
        key: $"placement:piece{16 * side + slot}",
        topology: chessBoard,
        expression: 0,
        offset: [captureColumnX[side], 0.3, 0.1 * slot - 0.05]
      )
    }
  }
}

for i in range(0, 32) {
  rule $"chess-ai-place-{i}" {
    when (ai.pending == 1 and
      pieceCell[$"piece{i}"] != ((aiBefore[$"piece{i}"] & 127) - 1) and
      pieceCell[$"piece{i}"] >= 0)
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: pieceCell[$"piece{i}"], offset: [0, 0.08, 0])
  }
}

chessMoveDone()

// ---- Playing at the table --------------------------------------------------------------------------------------
// Seat 1 sits down with the context button (the board's engage block) and plays with the board page below: the cursor
// follows the pointer, the movement keys, the d-pad or the stick, one square a press, up the board being away from the
// side the seat sits on. The pick button lifts the side to move's piece under the cursor, which then hovers over the
// cursor; the next press puts it down there, or a release away from the square it left does (a drag). Pressing on the
// square it left, the cancel button or standing up puts it back. A put-down hands the move to the computer's own apply
// path (ai[from], ai[to], ai[pending]): it stands a captured piece on the table margin, moves a castling rook, lifts the
// pawn an en-passant capture takes and queens a pawn on the last rank, then the settled arrangement is judged as ever.
// An arrangement judged illegal is put back as it stood before the put-down.

// The seated seat's buttons this tick, each 1 while held past half way.
rule "chess-play-buttons" {
  mode: Level
  for button in seatButtons {
    play[$"{button.name}Now"] = 0
  }
  for button in seatButtons {
    if seatHeld(board, button.channel, button.sign) {
      play[$"{button.name}Now"] = 1
    }
  }
}

// The press images: each binary is this tick's press on a rising edge, and each step is +1 or -1 on a rising edge.
rule "chess-play-edges" {
  local pick = play.pickNow
  local cancel = play.cancelNow
  local ahead = play.aheadNow
  local behind = play.behindNow
  local rightward = play.rightNow
  local leftward = play.leftNow
  mode: Level
  play.pickEdge = pick & (play.pickDown == 0)
  play.releaseEdge = (pick == 0) and (play.pickDown == 1)
  play.cancelEdge = cancel & (play.cancelDown == 0)
  play.stepAhead = (ahead & (play.aheadDown == 0)) - (behind & (play.behindDown == 0))
  play.stepRight = (rightward & (play.rightDown == 0)) - (leftward & (play.leftDown == 0))
  play.pickDown = pick
  play.cancelDown = cancel
  play.aheadDown = ahead
  play.behindDown = behind
  play.rightDown = rightward
  play.leftDown = leftward
}

// The pointer moves the cursor whenever it moves onto another square.
rule "chess-play-point" {
  local pointed = board(pointer, board, 1)
  when board(engaged, board, 1) == 1
  mode: Level
  if pointed >= 0 and pointed != play.pointer {
    play.cursor = pointed
  }
  play.pointer = pointed
}

// A step moves the cursor one square in the seat's own frame (the standard seat library's step): from White's chair
// ahead is toward Black and right is toward the h-file.
rule "chess-play-step" {
  when play.stepAhead or play.stepRight
  mode: Level
  play.cursor = seatStepCell(board, play.cursor, 8, 8, play.stepAhead, play.stepRight)
}

// A press lifts the side to move's piece under the cursor, once the board has rested and while no answer is moving.
rule "chess-play-lift" {
  when play.pickEdge == 1 and play.held < 0 and play.judging == 0 and pieceCell[$each] == play.cursor and (
      pieceCode[$each] * (1 - 2 * turn)
    ) > 0 and aiSide != turn and ai.pending == 0 and settleHold == chessSettleTicks
  mode: Level
  forEach: pieceCode
  // A firing holds a piece, which closes the gate for every later binding.
  maxFirings: 1
  play.held = pieceOrdinal[$each]
  play.from = play.cursor
  play.lifted = 1
}

// A put-down: a fresh press on another square, or the release of the lifting press away from the square the piece
// left. A square holding a piece of the side to move takes nothing.
rule "chess-play-put" {
  local press = (play.pickEdge == 1) and (play.lifted == 0)
  local drop = (play.releaseEdge == 1) and (play.lifted == 1)
  local open = (play.cursor != play.from) and (board[play.cursor] * (1 - 2 * turn) <= 0)
  when play.held >= 0 and (press or drop) and open and pieceOrdinal[$each] == play.held
  mode: Level
  forEach: pieceCode
  // The held piece is one ordinal, and a firing lets go of it.
  maxFirings: 1
  pieceCell[$each] = play.from
  ai.from = play.from
  ai.to = play.cursor
  ai.mover = pieceCode[$each]
  ai.pending = 1
  play.held = -1
  play.judging = 1
}

// What the put-down is judged against, captured the tick it is made.
rule "chess-play-before" {
  when play.judging == 1 and ai.pending == 1
  mode: Level
  forEach: pieceCode
  playBefore[$each] = pieceCell[$each]
  playBeforeCode[$each] = pieceCode[$each]
}

// Putting the piece back: the cancel button, a press on the square it left, or standing up from the table.
rule "chess-play-cancel" {
  local back = (play.pickEdge == 1) and (play.lifted == 0) and (play.cursor == play.from)
  when play.held >= 0 and (play.cancelEdge == 1 or back or board(engaged, board, 1) == 0)
  mode: Level
  play.returning = play.held
  play.held = -1
}

rule "chess-play-release" {
  when play.releaseEdge == 1
  mode: Level
  play.lifted = 0
}

// The verdict on a put-down: an illegal arrangement is put back as it stood before it.
rule "chess-play-judged" {
  when play.judging == 1 and ai.pending == 0 and settleHold == chessSettleTicks
  mode: Level
  play.judging = 0
  play.revert = verdict == 0
}

rule "chess-play-revert-codes" {
  when play.revert == 1
  mode: Level
  forEach: pieceCode
  pieceCode[$each] = playBeforeCode[$each]
}

for i in range(0, 32) {
  // The held piece hovers over the cursor, out of the board's band, so the board never rests while it is up.
  rule $"chess-play-hold-{i}" {
    when play.held == i
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: play.cursor, offset: [0, 0.6, 0])
  }
  rule $"chess-play-return-{i}" {
    when play.returning == i
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: play.from, offset: [0, 0.3, 0])
  }
  rule $"chess-play-revert-{i}" {
    when play.revert == 1 and playBefore[$"piece{i}"] >= 0 and pieceCell[$"piece{i}"] != playBefore[$"piece{i}"]
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: playBefore[$"piece{i}"], offset: [0, 0.3, 0])
  }
}

rule "chess-play-settled" {
  mode: Level
  play.returning = -1
  play.revert = 0
}

// The cursor stands on its square while the seat sits at the table, and rests inside the tabletop otherwise.
rule "chess-play-cursor-shown" {
  when board(engaged, board, 1) == 1
  mode: Level
  poseCell(key: `placement:boardCursor`, topology: chessBoard, expression: play.cursor, offset: [0, 0.066, 0])
}

rule "chess-play-cursor-parked" {
  when board(engaged, board, 1) == 0
  mode: Level
  poseCell(key: `placement:boardCursor`, topology: chessBoard, expression: play.cursor, offset: [0, 0, 0])
}

// The board consumes shared movement, confirm, cancel, and leave actions.


// The board page, which the seat's controls switch to while it sits at a tabletop.
bindingOverlays [
  {
    id: "tabletop"
    document {
      version: "puck.input.bindings.v1"
      modifiers []
      contexts [
        { family: "engagement", state: "tabletop", group: "tabletop" }
      ]
      chords [
        {
          chord []
          group: "tabletop"
          page {
            id: "board"
            label: "Board"
            entries [
              {
                channel: "forward"
                id: "boardUp"
                scale: 1
                sources ["keyboard.w", "keyboard.arrowUp", "gamepad.dpadUp"]
              }
              {
                channel: "forward"
                id: "boardDown"
                scale: -1
                sources ["keyboard.s", "keyboard.arrowDown", "gamepad.dpadDown"]
              }
              {
                channel: "strafe"
                id: "boardLeft"
                scale: -1
                sources ["keyboard.a", "keyboard.arrowLeft", "gamepad.dpadLeft"]
              }
              {
                channel: "strafe"
                id: "boardRight"
                scale: 1
                sources ["keyboard.d", "keyboard.arrowRight", "gamepad.dpadRight"]
              }
              { command: "player.move.strafe", id: "boardStick", sources ["gamepad.leftStick"] }
              {
                channel: "confirm"
                id: "confirm"
                label: "Pick"
                scale: 1
                sources ["keyboard.space", "keyboard.enter", "mouse.button1", "gamepad.buttonSouth"]
              }
              {
                channel: "cancel"
                id: "cancel"
                label: "Cancel"
                scale: 1
                sources ["keyboard.escape", "keyboard.backspace", "mouse.button2", "gamepad.buttonEast"]
              }
              {
                channel: "interact"
                id: "boardLeave"
                label: "Leave"
                scale: 1
                sources ["keyboard.e", "gamepad.rightShoulder"]
              }
            ]
          }
        }
      ]
    }
  }
]

chessSearch()

state {
  // The rules' vocabularies (../games/chess.puck), declared here so the rules fold their members and every document
  // built on this table reads them by name.
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }

  chessBoardGrid(cellSize: 0.2, origin: [-0.8, 1.25, -0.8], band: 0.3)

  world {
    chessGameState(settleTicks: chessSettleTicks)

    table chessDemo {
      enabled = 1
      ready = 0
      playing = 0
      near = 0
      lastTurn = 0
      idleDue = 0
      holdDue = 0
      loops = 0
      matches = 0
      cancelled = 0
      // The live debug world's authored 30 Hz, in seconds at the authoring boundary.
      idleTicks = chessDemoIdleSeconds * 30
      holdTicks = chessDemoHoldSeconds * 30
    }
    table chessTape {
      request = 0
      status = 0
      cursor = 0
      completed = 0
    }
    table chessDemoInk {
      recorded = "#000000"
      match = "#000000"
      mismatch = "#000000"
      result = "#000000"
    }

    // Seat 1 at the table: the cursor's square, the piece it holds (its ordinal, -1 for none) and the square it
    // left, the last pointed square, this tick's presses (the *Edge and step keys) and last tick's buttons (*Down),
    // whether the held piece was lifted by the press still down, whether a put-down awaits its verdict, and the piece
    // being put back or the arrangement being restored this tick.
    table play capacity(25) {
      cursor = 11
      held = -1
      from = -1
      pointer = -1
      pickNow = 0
      cancelNow = 0
      aheadNow = 0
      behindNow = 0
      rightNow = 0
      leftNow = 0
      pickEdge = 0
      releaseEdge = 0
      cancelEdge = 0
      stepAhead = 0
      stepRight = 0
      pickDown = 0
      cancelDown = 0
      aheadDown = 0
      behindDown = 0
      rightDown = 0
      leftDown = 0
      lifted = 0
      judging = 0
      returning = -1
      revert = 0
    }
    row {
      name: "playBefore"
      kind: "Int"
      capacity: 32
      min: -1
      max: 63
      cells: map(range(0, 32), i => { key: $"piece{i}", value: -1 })
    }
    row {
      name: "playBeforeCode"
      kind: "Int"
      capacity: 32
      min: -6
      max: 6
      cells: map(initialPieceCodes, (code, i) => { key: $"piece{i}", value: code })
    }

    table pieceSetColors {
      white = "#F2E9D8"
      black = "#2B2420"
    }

    table boardColors {
      light = "#F0D9B5"
      dark = "#8B5A2B"
      cursor = "#3FA9F5"
    }
  }
}

// ---- The idle historical demonstration ---------------------------------------------------------------
// Deep Blue (White) - Garry Kasparov, New York, 11 May 1997, game 6, 1-0.
// chess.md cites the public score. The source authors inputs, never boards or expected hashes.
// The first idle run derives the tape through the live move door; later loops compare against that recording.
replays [
  {
    name: "chess-demo"
    control: chessTape
    rows [
      board, lastLegal, plan, ai, aiEnabled, aiRevision, aiBest, aiBefore,
      pieceOrdinal, pieceCode, pieceCell, play, playBefore, playBeforeCode,
      turn, verdict, illegalCount, settleHold, gameStarted, move,
      promotionPending, enPassantTarget, inCheck, previousInCheck,
      boardHistory0, boardHistory1, boardHistory2, boardHistory3, boardHistoryRights,
      historyAges, enPassantProbe, enPassantProbeCheck, repetitionEnPassant,
      historyPending, historyReset, historyLength, halfmoveClock, repetitionCount,
      shapeLegal, castleLegal, castleRights, castleTransitAttacked,
      boardMismatch, boardChanged, boardCollisions, chessInput
    ]
    bodies: range(8, 33)
    seats ["seat1"]
    durationTicks: 37 * chessDemoPlyTicks
    inputs: map(
      [
        [11, 27],
        [53, 45],
        [12, 28],
        [52, 36],
        [6, 21],
        [36, 27],
        [21, 27],
        [62, 52],
        [27, 33],
        [57, 42],
        [2, 20],
        [51, 43],
        [1, 18],
        [48, 40],
        [33, 43],
        [60, 51],
        [3, 1],
        [50, 43],
        [20, 41],
        [59, 60],
        [5, 26],
        [54, 38],
        [15, 31],
        [61, 54],
        [2, 3],
        [42, 36],
        [26, 17],
        [60, 61],
        [31, 38],
        [45, 38],
        [4, 20],
        [54, 45],
        [41, 34],
        [43, 34],
        [3, 51],
        [58, 51],
        [13, 29]
      ],
      (move, i) => {
        tick: i * chessDemoPlyTicks
        principal: "seat1"
        cells [
          { row: chessInput, key: from, value: move[0] }
          { row: chessInput, key: to, value: move[1] }
          { row: chessInput, key: request, value: 1 }
        ]
      }
    )
  }
]

// A scope that holds no starting state (status -2: an edit re-declared one of its rows) gives up the loop it was in and
// lets the fresh-start rule below capture again. A diverged replay (status -1) still holds its start and loops on.
rule "chess-demo-lost-start" {
  when chessTape.status == -2
  mode: Level
  chessDemo.ready = 0
  chessDemo.playing = 0
  chessDemo.holdDue = 0
  chessDemoInk.recorded = "#000000"
  chessDemoInk.match = "#000000"
  chessDemoInk.mismatch = "#000000"
  chessDemoInk.result = "#000000"
}

rule "chess-demo-fresh-start" {
  when chessDemo.ready == 0 and gameStarted == 1 and settleHold == chessSettleTicks
  mode: Level
  chessTape.request = 4
  chessDemo.ready = 1
  chessDemo.idleDue = $tick + chessDemo.idleTicks
}

rule "chess-demo-near-reset" {
  mode: Level
  chessDemo.near = 0
}
for seat in range(0, 8) {
  rule $"chess-demo-near-{seat}" {
    local dx = bodyPosition(body, seat, x) - 56.5
    local dy = bodyPosition(body, seat, y) - 9.05
    local dz = bodyPosition(body, seat, z) - 22.6
    when (dx * dx + dy * dy + dz * dz) < 9
    mode: Level
    chessDemo.near = 1
  }
}

rule "chess-demo-engaged" {
  when board(engaged, board, 1) == 1
  mode: Level
  chessDemo.near = 1
}

rule "chess-demo-idle-reset" {
  when chessDemo.near == 1 or turn != chessDemo.lastTurn
  mode: Level
  chessDemo.idleDue = $tick + chessDemo.idleTicks
}
rule "chess-demo-remember-turn" {
  mode: Level
  chessDemo.lastTurn = turn
}

rule "chess-demo-cancel" {
  when chessDemo.playing == 1 and (chessDemo.near == 1 or chessDemo.enabled == 0)
  mode: Level
  chessTape.request = 2
  chessDemo.playing = 0
  chessDemo.holdDue = 0
  chessDemo.cancelled += 1
  chessDemoInk.recorded = "#000000"
  chessDemoInk.match = "#000000"
  chessDemoInk.mismatch = "#000000"
  chessDemoInk.result = "#000000"
}

rule "chess-demo-idle-start" {
  when (chessDemo.ready == 1 and
    chessDemo.enabled == 1 and
    chessDemo.playing == 0 and
    chessDemo.near == 0 and
    $tick >= chessDemo.idleDue)
  mode: Level
  chessTape.request = 1
  chessDemo.playing = 1
  chessDemo.holdDue = 0
}

rule "chess-demo-result" {
  when chessDemo.playing == 1 and chessTape.status >= 3 and chessDemo.holdDue == 0
  mode: Level
  chessDemo.loops += 1
  chessDemo.holdDue = $tick + chessDemo.holdTicks
  chessDemoInk.result = "#F2E9D8"
  if chessTape.status == 4 {
    chessDemo.matches += 1
    chessDemoInk.match = "#58D68D"
  } else {
    chessDemoInk.recorded = "#F0C674"
  }
}
rule "chess-demo-diverged" {
  when chessDemo.playing == 1 and chessTape.status == -1 and chessDemo.holdDue == 0
  mode: Level
  chessDemo.loops += 1
  chessDemo.holdDue = $tick + chessDemo.holdTicks
  chessDemoInk.mismatch = "#FF6655"
}

rule "chess-demo-loop" {
  when chessDemo.playing == 1 and chessDemo.holdDue > 0 and $tick >= chessDemo.holdDue
  mode: Level
  chessTape.request = 1
  chessDemo.holdDue = 0
  chessDemoInk.recorded = "#000000"
  chessDemoInk.match = "#000000"
  chessDemoInk.mismatch = "#000000"
  chessDemoInk.result = "#000000"
}

// The table's slim display sits beyond Black's back rank, facing White. Each line is a text screen;
// state-backed ink lights the verdict that actually occurred. No engine screen knows this game's vocabulary.
screens [
  {
    index: 12
    origin [56.5, 10.55, 23.65]
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.09
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["DEEP BLUE - KASPAROV", "NEW YORK 1997 - GAME 6"] }
  }
  {
    index: 8
    origin [56.5, 10.36, 23.65]
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["19.c4  1-0  BLACK RESIGNED"], foreground: "state.chessDemoInk.result" }
  }
  {
    index: 9
    origin [56.5, 10.22, 23.65]
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["SCOPE TAPE RECORDED"], foreground: "state.chessDemoInk.recorded" }
  }
  {
    index: 10
    origin [56.5, 10.08, 23.65]
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["SCOPE HASH MATCH"], foreground: "state.chessDemoInk.match" }
  }
  {
    index: 11
    origin [56.5, 9.94, 23.65]
    right [-1, 0, 0]
    up [0, 1, 0]
    halfWidth: 0.8
    halfHeight: 0.055
    halfDepth: 0.01
    round: 0
    luminance: 100nit
    route { engageable: false }
    source { $type: "text", lines ["SCOPE HASH MISMATCH"], foreground: "state.chessDemoInk.mismatch" }
  }
]

commands [
  {
    name: "chess.move"
    help: "Requests a move through the table's real apply and settled-board judge. Cells count 8 * rank + 7 - file from a1."
    parameters [
      { name: "from", kind: Integer }
      { name: "to", kind: Integer }
    ]
    lines [
      "world.state.cell.set chessInput from {from}"
      "world.state.cell.set chessInput to {to}"
      "world.state.cell.set chessInput request 1"
    ]
  }
]
