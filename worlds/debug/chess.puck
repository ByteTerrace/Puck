import "inputs"
// Physical chess: a table of 32 rigid piece bodies whose every settled arrangement is judged against the last legal
// board (the tabletop primitive), with captures, promotion, castling, en passant, check, the draw limits and a
// one-ply computer opponent. The debug world imports this file whole. The table stands in the gallery hall's lobby
// (hall.puck), in the games corner west of the entrance with the desktop computer (desktop.puck): its board's centre
// at (12.2, 0.85, 20) on the level 0 floor, White's back rank on its -Z side, toward the entrance, and Black's on +Z,
// toward the desk. chess.md beside this file says how to move a piece,
// read the game and set the opponent.

// The Moth basis seats eight bodies; the 32 pieces and the board cursor take the rest.
bodies {
  capacity: 41
}

// The pieces are bodies 8 to 39, piece n body 39 - n, and the seat drives each of them: a seat's `body.pose <x> <y>
// <z> 0 0 0 <body>` lifts a piece onto a square (chess.md).
grants: map(range(8, 32), body => { capability: Drive, grantee: "seat1", subject: $"body:{body}" })

// The table's placement, its creation's floor 0.5 m under its origin on the lobby's floor (y 0.05), and the ticks the
// physics must stay at rest before an arrangement is judged (0.3 s at the debug world's 30 Hz). The rigid solver's own
// resting latch has already held each piece still before `physics(quiescent)` reads 1, so the hold only has to outlast
// a piece that is touched, knocked or dropped beside another settling.
let chessTable = [12.2, -0.45, 20]
let chessSettleTicks = 9

let pieceTypes = ["pawn", "knight", "bishop", "rook", "queen", "king"]
let pieceLooks = concat(
  map(pieceTypes, kind => $"piece_white_{kind}"),
  map(pieceTypes, kind => $"piece_black_{kind}")
)

looks: map(concat(pieceLooks, ["boardCursor"]), name => {
  motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
  name: name
  scale: 1
  source: creation(prototypeId: name)
})

// The board reads as a real one from each side. The `chessBoard` grid is world-axis-aligned, cell = 8 * row + column,
// its rows running +Z and its columns +X; a rank is a row (rank 1 on the -Z side, White's), and a file runs the other
// way, column = 7 - file, so the a-file lies on +X. Seated at White's -Z edge and looking +Z, the camera's right is -X
// (forward crossed with up), so a1 is dark at White's left, h1 light at her right, and the queen on her colour (d1,
// light) left of the king; from Black's +Z edge a8 is light at Black's right and h8 dark at his left. The kings start
// in column 3 and the queens in column 4, so the castling rules below name kingside by a falling column. Piece n
// stands on file n % 8 (piece 4 the white king on e1, piece 12 the e2 pawn), at column 7 - n % 8.
let boardCoords = [-0.7, -0.5, -0.3, -0.1, 0.1, 0.3, 0.5, 0.7]
let backRankTypes = ["rook", "knight", "bishop", "queen", "king", "bishop", "knight", "rook"]
// Cell (row, column) is light when row + column is even: column 0 of rank 1 is h1.
let squareTypes = ["boardSquareLight", "boardSquareDark"]
let backRankCodes = [4, 2, 3, 5, 6, 3, 2, 4]
let backRankByColumn = map(range(0, 8), column => backRankCodes[7 - column])
let initialBoard = concat(
  backRankByColumn,
  map(range(0, 8), i => 1),
  map(range(0, 32), i => 0),
  map(range(0, 8), i => -1),
  map(backRankByColumn, code => -code)
)
let initialPieceCodes = concat(
  backRankCodes,
  map(range(0, 8), i => 1),
  map(range(0, 8), i => -1),
  map(backRankCodes, code => -code)
)

template piecePlacement(name, prototypeName, x, z) {
  placement name {
    prototype: prototypeName
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "piece"
      look: prototypeName
      source: "Idle"
    }
    parent: "chessTable"
    position [x, 1.8, z]
  }
}

template pieceProto(color, name, sx, sy, sz) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        scale [sx, sy, sz]
      }
    }
  }
}

template crownedPieceProto(color, name, sx, sy, sz, csx, csy, csz, crownY) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v1"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        scale [sx, sy, sz]
      }
      shape Sphere "crown" {
        blend: "SmoothUnion"
        material: 0
        position [0, crownY, 0]
        scale [csx, csy, csz]
        smooth: 0.01
      }
    }
  }
}

template squareProto(name, colorKey) {
  prototype name {
    document {
      name: name
      palette [
        {
          color: $"state.boardColors.{colorKey}"
          roughness: 0.846
          specular: 0.05
        }
      ]
      schema: "puck.creation.v1"
      shape Box "square" {
        material: 0
        position [0, 0, 0]
        scale [0.095, 0.004, 0.095]
      }
    }
  }
}

kits [
  {
    bodyContact: Solid
    bodyMotionProgram: "walk"
    collider: box(halfExtents: [0.045, 0.12, 0.045], rotation: [0, 0, 0, 1])
    motion {
      facingSnap: true
      holds [
        {
          bond: Free
          envelope {
            sinkSpeed: 40
          }
          gravity {
            fall: 46
            rise: 28
          }
          hold: Gravity
          name: "air"
        }
      ]
      shaping [
        {
          along {}
        }
      ]
      speed {
        value: 0.001
      }
      turn {
        rate: 0.001
      }
    }
    name: "piece"
    rigid {
      angularDamping: 0.05
      friction: 0.5
      linearDamping: 0.05
      mass: 0.12
      restitution: 0.1
      rollingFriction: 0.15
    }
  }
  // The board cursor: volumeless and overlapping, so it touches no piece, and posed by the rules every tick.
  {
    bodyContact: Overlap
    bodyMotionProgram: "walk"
    motion {
      facingSnap: true
      holds [
        {
          bond: Free
          hold: None
          name: "held"
        }
      ]
      shaping [
        {
          along {}
        }
      ]
      speed {
        value: 0.001
      }
      turn {
        rate: 0.001
      }
    }
    name: "boardCursor"
  }
]

pattern chessRayEmpty: Int {
  symbols {
    vacant = 0
  }
  match: vacant*
}

placements {
  // The table's top stands 0.8 m above the ground; its leg runs on below it.
  placement "chessTable" {
    prototype: "chessTable"
    board {
      move: "move"
      occupancy: "board"
      plan: "plan"
      topology: "chessBoard"
      turn: "turn"
      verdict: "verdict"
      // The context button within 2.5 m of the board's centre sits the seat down at the table and the next press
      // stands it up; seated, the camera looks down on the board from the seat's side and the pointer picks squares
      // on their tops, 6 cm above the board's frame.
      engage {
        channel: "interact"
        radius: 2.5
        pitch: 62
        margin: 0.12
        surface: 0.06
      }
    }
    position: chessTable
    solid
  }

  // The square cursor a seated player moves (body 40 in the debug world, before the pieces so they keep 8 to 39): the
  // rules pose it on the cursor's square while the seat sits at the table and park it inside the tabletop otherwise.
  placement "boardCursor" {
    prototype: "boardCursor"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "boardCursor"
      look: "boardCursor"
      source: "Idle"
    }
    parent: "chessTable"
    position [0, 1.25, 0]
  }

  for i in range(0, 8) {
    piecePlacement($"piece{i}", $"piece_white_{backRankTypes[i]}", boardCoords[7 - i], -0.7)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{8 + i}", "piece_white_pawn", boardCoords[7 - i], -0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{16 + i}", "piece_black_pawn", boardCoords[7 - i], 0.5)
  }

  for i in range(0, 8) {
    piecePlacement($"piece{24 + i}", $"piece_black_{backRankTypes[i]}", boardCoords[7 - i], 0.7)
  }

  for r in range(0, 8) {
    for c in range(0, 8) {
      placement $"boardSquare-{r * 8 + c}" {
        prototype: squareTypes[(r + c) % 2]
        parent: "chessTable"
        position [boardCoords[c], 1.305, boardCoords[r]]
      }
    }
  }
}

prototypes {
  prototype "chessTable" {
    document {
      name: "chessTable"
      palette [
        {
          color: "#8A6A45"
        }
      ]
      schema: "puck.creation.v1"
      shape Box "top" {
        material: 0
        position [0, 1.25, 0]
        scale [1, 0.05, 1]
      }

      // The pedestal stands on the floor 0.5 m under the creation's origin.
      shape Cylinder "leg" {
        material: 0
        position [0, 0.855, 0]
        scale [0.08, 0.355, 0.08]
      }

      shape Cylinder "foot" {
        material: 0
        position [0, 0.52, 0]
        scale [0.45, 0.02, 0.45]
      }
    }
  }

  for color in ["white", "black"] {
    pieceProto(color, "pawn", 0.035, 0.09, 0.035)
    pieceProto(color, "knight", 0.04, 0.12, 0.04)
    pieceProto(color, "bishop", 0.04, 0.15, 0.04)
    pieceProto(color, "rook", 0.05, 0.11, 0.05)
    crownedPieceProto(color, "queen", 0.045, 0.17, 0.045, 0.055, 0.055, 0.055, 0.203)
    crownedPieceProto(color, "king", 0.045, 0.19, 0.045, 0.06, 0.06, 0.06, 0.226)
  }

  squareProto("boardSquareLight", "light")
  squareProto("boardSquareDark", "dark")

  // A square's outline, one cell across: four flat bars around the square the cursor stands on.
  prototype "boardCursor" {
    document {
      name: "boardCursor"
      palette [
        {
          color: "state.boardColors.cursor"
          roughness: 0.4
          specular: 0.3
        }
      ]
      schema: "puck.creation.v1"
      shape Box "near" {
        material: 0
        position [0, 0, -0.088]
        scale [0.1, 0.004, 0.012]
      }
      shape Box "far" {
        material: 0
        position [0, 0, 0.088]
        scale [0.1, 0.004, 0.012]
      }
      shape Box "left" {
        material: 0
        position [-0.088, 0, 0]
        scale [0.012, 0.004, 0.1]
      }
      shape Box "right" {
        material: 0
        position [0.088, 0, 0]
        scale [0.012, 0.004, 0.1]
      }
    }
  }
}

rule "tabletop-settle-hold-advance" {
  when physics(quiescent) == 1 and settleHold < chessSettleTicks
  mode: Level
  settleHold += 1
}

rule "tabletop-settle-hold-reset" {
  when physics(quiescent) != 1
  mode: Level
  settleHold = 0
}

// Keep the established rule names while sharing the settled-board gate and edge mode.
rules "" when settleHold == chessSettleTicks {
  mode: "Edge"
  rule "tabletop-derive-cell-upright" {
    when upright(placement, $each) >= 0.5
    forEach: pieceCode
    pieceCell[$each] = board(cellOf, board, placement, $each)
  }

  rule "tabletop-derive-cell-tilted" {
    when not upright(placement, $each) >= 0.5
    forEach: pieceCode
    pieceCell[$each] = -1
  }

  rule "tabletop-board-collisions" {
    boardCollisions = count(pieceCell, atLeast: 0, atMost: 63) + setBitCount(board(mask, board, 0, 0)) - 64
  }

  rule "tabletop-game-start-snapshot" {
    when gameStarted == 0 and boardCollisions == 0
    transform boardCombine(left: board, operation: Copy, row: lastLegal)
  }

  rule "tabletop-candidate-cells" {
    local ownBefore = turn == 0 ? board(mask, lastLegal, 1, 6) : board(mask, lastLegal, -6, -1)
    local ownAfter = turn == 0 ? board(mask, board, 1, 6) : board(mask, board, -6, -1)
    local sources = ownBefore & ~(board(mask, board, 1, 6) | board(mask, board, -6, -1))
    local destinations = ownAfter & ~ownBefore
    local kingBefore = turn == 0 ? board(mask, lastLegal, 6, 6) : board(mask, lastLegal, -6, -6)
    local kingAfter = turn == 0 ? board(mask, board, 6, 6) : board(mask, board, -6, -6)
    local target = (sources & kingBefore) != 0 ? destinations & kingAfter : destinations
    move[from] = sources == 0 ? -1 : trailingZeroCount((sources & kingBefore) != 0 ? sources & kingBefore : sources)
    move[to] = target == 0 ? -1 : trailingZeroCount(target)
  }

  rule "tabletop-candidate-move" {
    local mover = lastLegal[move[from]]
    local kind = (
      (move[from] < 0) | (move[to] < 0) | (move[to] > 63) ? MoveKind.Illegal :
      (absolute(mover) == PieceKind.King) & (absolute(move[to] - move[from]) == 2) ? MoveKind.Castle :
      (absolute(mover) == PieceKind.Pawn) & (((move[from] ^ move[to]) & 7) != 0) & (lastLegal[move[to]] == 0) ?
        MoveKind.EnPassant :
      lastLegal[move[to]] != 0 ? MoveKind.Capture :
      MoveKind.Quiet
    )
    move[mover] = mover
    move[kind] = kind
    move[captured] = kind == MoveKind.EnPassant ? lastLegal[move[to] - 8 * (1 - 2 * turn)] : lastLegal[move[to]]
  }

  // Search relocates the primary token; these hypothetical-only rules complete
  // the compound move before the same validator used for physical play judges it.
  rule "tabletop-search-en-passant" {
    when ((
      (search(ply) > 0) &
      (move[kind] == MoveKind.EnPassant) &
      (move[to] == enPassantTarget) &
      (pieceCell[$each] == move[to] - 8 * (1 - 2 * turn))
    ) == 1 : Int)
    forEach: pieceCode
    pieceCell[$each] = -1
  }

  rule "tabletop-search-castle" {
    when ((
      (search(ply) > 0) &
      (move[kind] == MoveKind.Castle) &
      (pieceCell[$each] == (move[from] & 56) + (move[to] > move[from] ? 7 : 0)) &
      (pieceCode[$each] == 4 * (1 - 2 * turn))
    ) == 1 : Int)
    forEach: pieceCode
    pieceCell[$each] = (move[from] + move[to]) >> 1
  }

  rule "tabletop-search-promotion" {
    when ((
      (search(ply) > 0) &
      (absolute(move[mover]) == PieceKind.Pawn) &
      (pieceCell[$each] == move[to]) &
      (move[to] / 8 == (turn == TurnColor.White ? 7 : 0))
    ) == 1 : Int)
    forEach: pieceCode
    pieceCode[$each] = PieceKind.Queen * (1 - 2 * turn)
  }

  rule "tabletop-candidate-match" {
    local changed = (
      (
        (board(mask, board, -3, -2) | board(mask, board, 1, 2) | board(mask, board, 5, 6)) ^
        (board(mask, lastLegal, -3, -2) | board(mask, lastLegal, 1, 2) | board(mask, lastLegal, 5, 6))
      ) |
      (
        (board(mask, board, -5, -3) | board(mask, board, 2, 5)) ^
        (board(mask, lastLegal, -5, -3) | board(mask, lastLegal, 2, 5))
      ) |
      ((board(mask, board, -4, 3)) ^ (board(mask, lastLegal, -4, 3))) |
      ((board(mask, board, 0, 7)) ^ (board(mask, lastLegal, 0, 7)))
    )
    local from = move[from]
    local to = move[to]
    local sign = 1 - 2 * turn
    local clear = (
      move[kind] == MoveKind.Castle ? (from & 56) + (to > from ? 7 : 0) :
      move[kind] == MoveKind.EnPassant ? to - 8 * local(sign) :
      -1
    )
    local rook = move[kind] == MoveKind.Castle ? ((from + to) >> 1) : -1
    local clearUnique = (clear >= 0) & (clear < 64) & (clear != from) & (clear != to)
    local rookUnique = (rook >= 0) & (rook < 64) & (rook != from) & (rook != to) & (rook != clear)
    local footprint = (
      ((from >= 0) * (1 << maximum(from, 0))) |
      ((to >= 0) * (1 << maximum(to, 0))) |
      (clearUnique * (1 << clamp(clear, 0, 63))) |
      (rookUnique * (1 << clamp(rook, 0, 63)))
    )
    local landed = (
      (absolute(move[mover]) == PieceKind.Pawn) & (to / 8 == (turn == TurnColor.White ? 7 : 0)) ? board[move[to]] :
      move[mover]
    )
    boardMismatch = (
      setBitCount(changed & ~footprint) +
      (from >= 0) * (board[move[from]] != 0) +
      (to >= 0) * (board[move[to]] != landed) +
      clearUnique * (board[(clear)] != 0) +
      rookUnique * (board[(rook)] != 4 * local(sign))
    )
    boardChanged = setBitCount(changed)
  }

  // The square a castling king passes over, f1 (cell 2) or d1 (cell 4), or f8 (58) or d8 (60), attacked by a pawn,
  // knight or king standing on the mask's cells or by a slider; kingside runs toward column 0.
  rule "tabletop-castle-transit-attacked" {
    when move[kind] == MoveKind.Castle
    castleTransitAttacked[wk] = 0
    castleTransitAttacked[wq] = 0
    castleTransitAttacked[bk] = 0
    castleTransitAttacked[bq] = 0
    if turn == TurnColor.White and move[to] < move[from] {
      castleTransitAttacked[wk] = (
        ((board(mask, lastLegal, -1, -1) & 0xA00) != 0) |
        ((board(mask, lastLegal, -2, -2) & 0xA1100) != 0) |
        ((board(mask, lastLegal, -6, -6) & 0xE0A) != 0) |
        board(attacks, lastLegal, -5, -4, "N,S,E,W")[2] |
        board(attacks, lastLegal, -3, -3, "NE,SE,SW,NW")[2] |
        board(attacks, lastLegal, -5, -5, "NE,SE,SW,NW")[2]
      )
    } else if turn == TurnColor.White {
      castleTransitAttacked[wq] = (
        ((board(mask, lastLegal, -1, -1) & 0x2800) != 0) |
        ((board(mask, lastLegal, -2, -2) & 0x284400) != 0) |
        ((board(mask, lastLegal, -6, -6) & 0x3828) != 0) |
        board(attacks, lastLegal, -5, -4, "N,S,E,W")[4] |
        board(attacks, lastLegal, -3, -3, "NE,SE,SW,NW")[4] |
        board(attacks, lastLegal, -5, -5, "NE,SE,SW,NW")[4]
      )
    } else if move[to] < move[from] {
      castleTransitAttacked[bk] = (
        ((board(mask, lastLegal, 1, 1) & byteSwap(0xA00)) != 0) |
        ((board(mask, lastLegal, 2, 2) & byteSwap(0xA1100)) != 0) |
        ((board(mask, lastLegal, 6, 6) & byteSwap(0xE0A)) != 0) |
        board(attacks, lastLegal, 4, 5, "N,S,E,W")[58] |
        board(attacks, lastLegal, 3, 3, "NE,SE,SW,NW")[58] |
        board(attacks, lastLegal, 5, 5, "NE,SE,SW,NW")[58]
      )
    } else {
      castleTransitAttacked[bq] = (
        ((board(mask, lastLegal, 1, 1) & byteSwap(0x2800)) != 0) |
        ((board(mask, lastLegal, 2, 2) & byteSwap(0x284400)) != 0) |
        ((board(mask, lastLegal, 6, 6) & byteSwap(0x3828)) != 0) |
        board(attacks, lastLegal, 4, 5, "N,S,E,W")[60] |
        board(attacks, lastLegal, 3, 3, "NE,SE,SW,NW")[60] |
        board(attacks, lastLegal, 5, 5, "NE,SE,SW,NW")[60]
      )
    }
  }

  // The king starts in column 3; a rising column (direction 1) castles queenside with the column-7 rook, a falling one
  // kingside with the column-0 rook. A right's bit names its rook's column: 1 column 0, 2 column 7, Black's two above.
  rule "tabletop-castle-legal" {
    local sign = 1 - 2 * turn
    local home = 3 + 56 * turn
    local direction = move[to] > move[from] ? 1 : -1
    local rook = home + (direction == 1 ? 4 : -3)
    local right = (direction == 1 ? 2 : 1) << (2 * turn)
    local attacked = (
      turn == TurnColor.White ? (direction == 1 ? castleTransitAttacked[wq] : castleTransitAttacked[wk]) :
      (direction == 1 ? castleTransitAttacked[bq] : castleTransitAttacked[bk])
    )
    castleLegal = 0
    if move[kind] == MoveKind.Castle {
      castleLegal = (
        (move[kind] == MoveKind.Castle) &
        (move[from] == home) &
        (move[to] == home + 2 * direction) &
        ((castleRights & right) == 0) &
        (lastLegal[(rook)] == PieceKind.Rook * local(sign)) &
        (
          (
            direction == 1 ? match(chessRayEmpty, lastLegal, E, cell)[move[from]] :
            match(chessRayEmpty, lastLegal, W, cell)[move[from]]
          ) == rook
        ) &
        (previousInCheck[turn[$value]] == 0) &
        (attacked == 0)
      )
    }
  }

  rule "tabletop-shape-final" {
    local piece = absolute(move[mover])
    local dx = absolute(move[to] % 8 - move[from] % 8)
    local dy = (move[to] / 8 - move[from] / 8) * (1 - 2 * turn)
    local middle = move[from] + 8 * (1 - 2 * turn)
    shapeLegal = 0
    if piece == PieceKind.Pawn {
      shapeLegal = (
        (dx == 0) &
          (lastLegal[move[to]] == 0) &
          maximum(
            dy == 1,
            (dy == 2) & (move[from] / 8 == (turn == TurnColor.White ? 1 : 6)) & (lastLegal[(middle)] == 0)
          ) |
        (dx == 1) &
          (dy == 1) &
          maximum(
            move[kind] == MoveKind.Capture,
            (move[kind] == MoveKind.EnPassant) & (move[to] == enPassantTarget) & (move[captured] == 2 * turn - 1)
          )
      )
    } else if piece == PieceKind.Knight {
      shapeLegal = dx * absolute(dy) == 2
    } else if piece == PieceKind.King {
      shapeLegal = maximum((maximum(dx, absolute(dy)) == 1) & (move[kind] != MoveKind.Castle), castleLegal)
    } else {
      if piece == PieceKind.Rook or piece == PieceKind.Queen {
        shapeLegal = maximum(
          maximum(
            maximum(
              match(chessRayEmpty, lastLegal, N, cell)[move[to]] == move[from],
              match(chessRayEmpty, lastLegal, S, cell)[move[to]] == move[from]
            ),
            match(chessRayEmpty, lastLegal, E, cell)[move[to]] == move[from]
          ),
          match(chessRayEmpty, lastLegal, W, cell)[move[to]] == move[from]
        )
      }
      if piece == PieceKind.Bishop or piece == PieceKind.Queen {
        shapeLegal = (
          shapeLegal |
          (
            maximum(
              maximum(
                maximum(
                  match(chessRayEmpty, lastLegal, NE, cell)[move[to]] == move[from],
                  match(chessRayEmpty, lastLegal, SE, cell)[move[to]] == move[from]
                ),
                match(chessRayEmpty, lastLegal, SW, cell)[move[to]] == move[from]
              ),
              match(chessRayEmpty, lastLegal, NW, cell)[move[to]] == move[from]
            )
          )
        )
      }
    }
  }

  rule "tabletop-check-white" {
    local kingMask = lowestSetBit(board(mask, board, 6, 6))
    local kingSquare = kingMask == 0 ? -1 : trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    local closeHit = (
      (boardShift(nearFiles, chessBoard, S) & board(mask, board, -1, -1)) |
      (
        (kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) &
        board(mask, board, -6, -6)
      )
    ) != 0
    local knightHit = (
      (
        boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) |
        boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) |
        boardShift(farFiles, chessBoard, S) |
        boardShift(farFiles, chessBoard, N)
      ) &
      board(mask, board, -2, -2)
    ) != 0
    local slideHit = (
      (kingMask != 0) &
      (
        board(attacks, board, -5, -4, "N,S,E,W")[(kingSquare)] |
        board(attacks, board, -3, -3, "NE,SE,SW,NW")[(kingSquare)] |
        board(attacks, board, -5, -5, "NE,SE,SW,NW")[(kingSquare)]
      )
    )
    inCheck[0] = closeHit | knightHit | slideHit
  }

  rule "tabletop-check-black" {
    local kingMask = lowestSetBit(board(mask, board, -6, -6))
    local kingSquare = kingMask == 0 ? -1 : trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    local closeHit = (
      (boardShift(nearFiles, chessBoard, N) & board(mask, board, 1, 1)) |
      (
        (kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) &
        board(mask, board, 6, 6)
      )
    ) != 0
    local knightHit = (
      (
        boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) |
        boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) |
        boardShift(farFiles, chessBoard, S) |
        boardShift(farFiles, chessBoard, N)
      ) &
      board(mask, board, 2, 2)
    ) != 0
    local slideHit = (
      (kingMask != 0) &
      (
        board(attacks, board, 4, 5, "N,S,E,W")[(kingSquare)] |
        board(attacks, board, 3, 3, "NE,SE,SW,NW")[(kingSquare)] |
        board(attacks, board, 5, 5, "NE,SE,SW,NW")[(kingSquare)]
      )
    )
    inCheck[1] = closeHit | knightHit | slideHit
  }

  rule "tabletop-game-start-check" {
    when gameStarted == 0 and boardCollisions == 0
    previousInCheck[0] = inCheck[0]
    previousInCheck[1] = inCheck[1]
    gameStarted = 1
    historyPending = 1
    historyReset = 1
  }

  rule "tabletop-verdict" {
    local sign = 1 - 2 * turn
    local promotes = (absolute(move[mover]) == PieceKind.Pawn) & (move[to] / 8 == (turn == TurnColor.White ? 7 : 0))
    local replacement = (
      promotes ?
        (board[move[to]] * local(sign) >= PieceKind.Knight) & (board[move[to]] * local(sign) <= PieceKind.Queen) :
      board[move[to]] == move[mover]
    )
    local kings = (setBitCount(board(mask, board, 6, 6)) == 1) & (setBitCount(board(mask, board, -6, -6)) == 1)
    verdict = (
      (halfmoveClock < 150) &
      (move[kind] >= MoveKind.Quiet) &
      (move[kind] <= MoveKind.Castle) &
      (boardMismatch == 0) &
      (boardCollisions == 0) &
      shapeLegal &
      replacement &
      (move[mover] * local(sign) > 0) &
      (move[captured] * local(sign) <= 0) &
      (inCheck[turn[$value]] == 0) &
      kings
    )
    promotionPending[0] = boardChanged == 0 ? -1 : promotionPending[0]
    promotionPending[1] = boardChanged == 0 ? -1 : promotionPending[1]
  }

  rule "tabletop-promotion-pending" {
    when verdict == 0 and ((
        (absolute(move[mover]) == PieceKind.Pawn) &
        (move[to] / 8 == (turn == TurnColor.White ? 7 : 0)) &
        (board[move[to]] == move[mover]) &
        shapeLegal &
        (boardMismatch == 0) &
        (boardCollisions == 0) &
        (inCheck[turn[$value]] == 0) &
        (setBitCount(board(mask, board, 6, 6)) == 1) &
        (setBitCount(board(mask, board, -6, -6)) == 1)
      ) == 1 : Int)
    promotionPending[turn[$value]] = move[to]
  }

  rule "tabletop-advance-turn" {
    when verdict == 1 and move[kind] != MoveKind.Illegal
    local lostRooks = (
      ((board(mask, lastLegal, 4, 4) & ~board(mask, board, 4, 4)) & 0x81) |
      ((board(mask, lastLegal, -4, -4) & ~board(mask, board, -4, -4)) & (0x81 << 56))
    )
    local lostKings = (
      ((board(mask, lastLegal, 6, 6) & ~board(mask, board, 6, 6)) & (1 << 3)) |
      ((board(mask, lastLegal, -6, -6) & ~board(mask, board, -6, -6)) & (1 << 59))
    )
    local lostRights = (
      parallelBitExtract(lostRooks, 0x81 | (0x81 << 56)) |
      (parallelBitDeposit(parallelBitExtract(lostKings, (1 << 3) | (1 << 59)), 5) * 3)
    )
    transaction {
      // A pawn move, capture or lost castling right makes every earlier position unreachable.
      historyReset = (
        (absolute(move[mover]) == PieceKind.Pawn) | (move[captured] != 0) | ((lostRights & ~castleRights) != 0)
      )
      halfmoveClock = (absolute(move[mover]) == PieceKind.Pawn) | (move[captured] != 0) ? 0 : halfmoveClock + 1
      historyPending = 1
      castleRights = castleRights | lostRights
      transform boardCombine(left: board, operation: Copy, row: lastLegal)
      previousInCheck[0] = inCheck[0]
      previousInCheck[1] = inCheck[1]
      enPassantTarget = (
        (absolute(move[mover]) == PieceKind.Pawn) & (absolute(move[to] - move[from]) == 16) ?
          ((move[from] + move[to]) >> 1) :
        -1
      )
      turn = 1 - turn
      promotionPending[0] = -1
      promotionPending[1] = -1
    }
  }

  // Exact position identity: four injective piece-code bitplanes, plus side to
  // move, castling rights, and an en-passant target only when a legal capture exists.
  // The 75-move limit ends play after 150 reversible plies, so 151 positions
  // include the initial position and every possible repetition without eviction.
  rule "tabletop-history-prepare" {
    when historyPending == 1
    repetitionEnPassant = -1
    if historyReset == 1 {
      historyLength = 0
    }
  }

  rule "tabletop-history-en-passant-west" {
    when historyPending == 1 and enPassantTarget >= 0
    local sign = 1 - 2 * turn
    local source = enPassantTarget - 8 * local(sign) + (-1)
    local victim = enPassantTarget - 8 * local(sign)
    local kingMask = turn == TurnColor.White ? board(mask, board, 6, 6) : board(mask, board, -6, -6)
    local kingSquare = trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    if ((
      (source >= 0) &
      (source < 64) &
      (source / 8 == victim / 8) &
      (enPassantTarget / 8 == (turn == TurnColor.White ? 5 : 2)) &
      (board[(source)] == local(sign)) &
      (board[(victim)] == -local(sign)) &
      (board[enPassantTarget[$value]] == 0) &
      (setBitCount(kingMask) == 1)
    ) == 1 : Int) {
      transform boardCombine(left: board, operation: Copy, row: enPassantProbe)
      enPassantProbe[(source)] = 0
      enPassantProbe[(victim)] = 0
      enPassantProbe[enPassantTarget[$value]] = local(sign)
      if turn == TurnColor.White {
        enPassantProbeCheck = (
          (boardShift(nearFiles, chessBoard, S) & board(mask, enPassantProbe, -1, -1)) |
          (
            (kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) &
            board(mask, enPassantProbe, -6, -6)
          )
        ) != 0
        enPassantProbeCheck = (
          enPassantProbeCheck |
          (
            (
              (
                boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) |
                boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) |
                boardShift(farFiles, chessBoard, S) |
                boardShift(farFiles, chessBoard, N)
              ) &
              board(mask, enPassantProbe, -2, -2)
            ) != 0
          )
        )
        enPassantProbeCheck = (
          enPassantProbeCheck |
          board(attacks, enPassantProbe, -5, -4, "N,S,E,W")[(kingSquare)] |
          board(attacks, enPassantProbe, -3, -3, "NE,SE,SW,NW")[(kingSquare)] |
          board(attacks, enPassantProbe, -5, -5, "NE,SE,SW,NW")[(kingSquare)]
        )
      } else {
        enPassantProbeCheck = (
          (boardShift(nearFiles, chessBoard, N) & board(mask, enPassantProbe, 1, 1)) |
          (
            (kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) &
            board(mask, enPassantProbe, 6, 6)
          )
        ) != 0
        enPassantProbeCheck = (
          enPassantProbeCheck |
          (
            (
              (
                boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) |
                boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) |
                boardShift(farFiles, chessBoard, S) |
                boardShift(farFiles, chessBoard, N)
              ) &
              board(mask, enPassantProbe, 2, 2)
            ) != 0
          )
        )
        enPassantProbeCheck = (
          enPassantProbeCheck |
          board(attacks, enPassantProbe, 4, 5, "N,S,E,W")[(kingSquare)] |
          board(attacks, enPassantProbe, 3, 3, "NE,SE,SW,NW")[(kingSquare)] |
          board(attacks, enPassantProbe, 5, 5, "NE,SE,SW,NW")[(kingSquare)]
        )
      }
      if enPassantProbeCheck == 0 {
        repetitionEnPassant = enPassantTarget
      }
    }
  }

  rule "tabletop-history-en-passant-east" {
    when historyPending == 1 and enPassantTarget >= 0
    local sign = 1 - 2 * turn
    local source = enPassantTarget - 8 * local(sign) + (1)
    local victim = enPassantTarget - 8 * local(sign)
    local kingMask = turn == TurnColor.White ? board(mask, board, 6, 6) : board(mask, board, -6, -6)
    local kingSquare = trailingZeroCount(kingMask)
    local nearFiles = boardShift(kingMask, chessBoard, E) | boardShift(kingMask, chessBoard, W)
    local farFiles = (boardShift(nearFiles, chessBoard, E) | boardShift(nearFiles, chessBoard, W)) & ~kingMask
    local kingBand = kingMask | nearFiles
    if ((
      (source >= 0) &
      (source < 64) &
      (source / 8 == victim / 8) &
      (enPassantTarget / 8 == (turn == TurnColor.White ? 5 : 2)) &
      (board[(source)] == local(sign)) &
      (board[(victim)] == -local(sign)) &
      (board[enPassantTarget[$value]] == 0) &
      (setBitCount(kingMask) == 1)
    ) == 1 : Int) {
      transform boardCombine(left: board, operation: Copy, row: enPassantProbe)
      enPassantProbe[(source)] = 0
      enPassantProbe[(victim)] = 0
      enPassantProbe[enPassantTarget[$value]] = local(sign)
      if turn == TurnColor.White {
        enPassantProbeCheck = (
          (boardShift(nearFiles, chessBoard, S) & board(mask, enPassantProbe, -1, -1)) |
          (
            (kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) &
            board(mask, enPassantProbe, -6, -6)
          )
        ) != 0
        enPassantProbeCheck = (
          enPassantProbeCheck |
          (
            (
              (
                boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) |
                boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) |
                boardShift(farFiles, chessBoard, S) |
                boardShift(farFiles, chessBoard, N)
              ) &
              board(mask, enPassantProbe, -2, -2)
            ) != 0
          )
        )
        enPassantProbeCheck = (
          enPassantProbeCheck |
          board(attacks, enPassantProbe, -5, -4, "N,S,E,W")[(kingSquare)] |
          board(attacks, enPassantProbe, -3, -3, "NE,SE,SW,NW")[(kingSquare)] |
          board(attacks, enPassantProbe, -5, -5, "NE,SE,SW,NW")[(kingSquare)]
        )
      } else {
        enPassantProbeCheck = (
          (boardShift(nearFiles, chessBoard, N) & board(mask, enPassantProbe, 1, 1)) |
          (
            (kingBand | boardShift(kingBand, chessBoard, S) | boardShift(kingBand, chessBoard, N)) &
            board(mask, enPassantProbe, 6, 6)
          )
        ) != 0
        enPassantProbeCheck = (
          enPassantProbeCheck |
          (
            (
              (
                boardShift(boardShift(nearFiles, chessBoard, S), chessBoard, S) |
                boardShift(boardShift(nearFiles, chessBoard, N), chessBoard, N) |
                boardShift(farFiles, chessBoard, S) |
                boardShift(farFiles, chessBoard, N)
              ) &
              board(mask, enPassantProbe, 2, 2)
            ) != 0
          )
        )
        enPassantProbeCheck = (
          enPassantProbeCheck |
          board(attacks, enPassantProbe, 4, 5, "N,S,E,W")[(kingSquare)] |
          board(attacks, enPassantProbe, 3, 3, "NE,SE,SW,NW")[(kingSquare)] |
          board(attacks, enPassantProbe, 5, 5, "NE,SE,SW,NW")[(kingSquare)]
        )
      }
      if enPassantProbeCheck == 0 {
        repetitionEnPassant = enPassantTarget
      }
    }
  }

  rule "tabletop-board-history" {
    when historyPending == 1
    push boardHistory0 = board(mask, board, -3, -2) | board(mask, board, 1, 2) | board(mask, board, 5, 6)
    push boardHistory1 = board(mask, board, -5, -3) | board(mask, board, 2, 5)
    push boardHistory2 = board(mask, board, -4, 3)
    push boardHistory3 = board(mask, board, 0, 6)
    push boardHistoryRights = turn | (castleRights << 1) | ((repetitionEnPassant + 1) << 5)
    historyLength += 1
    repetitionCount = 1
  }

  rule "tabletop-history-count" {
    when historyPending == 1 and historyAges[$each] < historyLength
    forEach: historyAges
    if (history(boardHistoryRights, 0) == history(boardHistoryRights, historyAges[$each]) : Int) and (history(
        boardHistory0,
        0
      ) == history(boardHistory0, historyAges[$each]) : Int) and (history(boardHistory1, 0) == history(
        boardHistory1,
        historyAges[$each]
      ) : Int) and (history(boardHistory2, 0) == history(boardHistory2, historyAges[$each]) : Int) and (history(
        boardHistory3,
        0
      ) == history(boardHistory3, historyAges[$each]) : Int) {
      repetitionCount += 1
    }
  }

  rule "tabletop-history-finish" {
    when historyPending == 1
    historyPending = 0
  }

  rule "tabletop-apply-illegal" {
    when verdict == 0 and
      move[kind] != MoveKind.Illegal and
      boardMismatch == 0 and
      promotionPending[0] == -1 and
      promotionPending[1] == -1
    illegalCount += 1
  }
}

rule "chess-ai-evaluate" {
  when search(ply) > 0
  mode: Level
  ai[evaluation] = 100 * (setBitCount(board(mask, board, 1, 1)) - setBitCount(board(mask, board, -1, -1)))
  ai[evaluation] += 320 * (setBitCount(board(mask, board, 2, 2)) - setBitCount(board(mask, board, -2, -2)))
  ai[evaluation] += 330 * (setBitCount(board(mask, board, 3, 3)) - setBitCount(board(mask, board, -3, -3)))
  ai[evaluation] += 500 * (setBitCount(board(mask, board, 4, 4)) - setBitCount(board(mask, board, -4, -4)))
  ai[evaluation] += 900 * (setBitCount(board(mask, board, 5, 5)) - setBitCount(board(mask, board, -5, -5)))
  ai[evaluation] += (
    12 *
    (
      setBitCount(board(mask, board, 1, 3) & 0x00003C3C3C3C0000) -
      setBitCount(board(mask, board, -3, -1) & 0x00003C3C3C3C0000)
    )
  )
  ai[evaluation] += (
    8 *
    (
      setBitCount(board(mask, board, 1, 1) & 0x00FFFFFF00000000) -
      setBitCount(board(mask, board, -1, -1) & 0x00000000FFFFFF00)
    )
  )
}

// The computer opponent: aiSide 1 (the default) plays Black, 0 plays White and -1 leaves both sides to people.
// A completed answer belongs to exactly one settled physical position. Search
// never moves bodies; the live apply path acts once, then lets physics settle
// and the ordinary validator accept the resulting board.
rule "chess-ai-revision" {
  // Keep identity as well as geometry: exchanging two same-kind pieces still
  // invalidates a token-indexed answer. A saved piece packs square + 1 in
  // seven bits and code + 6 above it; metadata also fits in one exact Int.
  local metadata = (
    turn |
    (castleRights << 1) |
    ((enPassantTarget + 1) << 5) |
    (halfmoveClock << 12) |
    (repetitionCount << 20) |
    (previousInCheck[0] << 27) |
    (previousInCheck[1] << 28)
  )
  local pieceState = (pieceCell[$each] + 1) | ((pieceCode[$each] + 6) << 7)
  when settleHold == chessSettleTicks and physics(quiescent) == 1 and (pieceState != aiBefore[$each] or
      metadata != ai[metadata])
  mode: Level
  forEach: pieceCode
  aiBefore[$each] = pieceState
  ai[metadata] = metadata
  aiRevision += 1
}

rule "chess-ai-enable" {
  mode: Level
  aiEnabled = (
    (aiSide == turn) &
    (physics(quiescent) == 1) &
    (settleHold == chessSettleTicks) &
    (gameStarted == 1) &
    (boardCollisions == 0) &
    ((verdict == 1) | (boardChanged == 0)) &
    (halfmoveClock < 150) &
    (repetitionCount < 5)
  )
}

rule "chess-ai-request" {
  when ((
    (aiEnabled == 1) &
    (aiBest[revision] == aiRevision) &
    (aiBest[token] == pieceOrdinal[$each]) &
    (aiBest[to] >= 0) &
    (aiBest[to] < 64) &
    (physics(quiescent) == 1)
  ) == 1 : Int)
  mode: Level
  forEach: pieceCode
  ai[from] = pieceCell[$each]
  ai[to] = aiBest[to]
  ai[mover] = pieceCode[$each]
  ai[pending] = 1
}

rule "chess-ai-relocate" {
  when (((ai[pending] == 1)) == 1 : Int)
  mode: Level
  forEach: pieceCode
  if (((pieceCell[$each] == ai[to])) == 1 : Int) {
    pieceCell[$each] = -1
  } else if (((pieceCell[$each] == ai[from])) == 1 : Int) {
    pieceCell[$each] = ai[to]
    if (((absolute(ai[mover]) == PieceKind.Pawn) & (ai[to] / 8 == (turn == TurnColor.White ? 7 : 0))) == 1 : Int) {
      pieceCode[$each] = PieceKind.Queen * (1 - 2 * turn)
    }
  } else if ((
    (absolute(ai[mover]) == PieceKind.Pawn) &
    (ai[to] == enPassantTarget) &
    ((ai[from] & 7) != (ai[to] & 7)) &
    (pieceCell[$each] == ai[to] - 8 * (1 - 2 * turn))
  ) == 1 : Int) {
    pieceCell[$each] = -1
  } else if ((
    (absolute(ai[mover]) == PieceKind.King) &
    (absolute(ai[to] - ai[from]) == 2) &
    (pieceCell[$each] == (ai[from] & 56) + (ai[to] > ai[from] ? 7 : 0))
  ) == 1 : Int) {
    pieceCell[$each] = (ai[from] + ai[to]) >> 1
  }
}

for i in range(0, 32) {
  rule $"chess-ai-place-{i}" {
    gate: compareValue(
      kind: Int,
      comparison: Equal,
      left: (ai[pending] == 1) & (pieceCell[$"piece{i}"] != ((aiBefore[$"piece{i}"] & 127) - 1)) & (pieceCell[$"piece{i}"] >= 0),
      right: 1
    )
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: pieceCell[$"piece{i}"], offset: [0, 0.08, 0])
  }
  rule $"chess-ai-capture-{i}" {
    gate: compareValue(
      kind: Int,
      comparison: Equal,
      left: (ai[pending] == 1) & (pieceCell[$"piece{i}"] != ((aiBefore[$"piece{i}"] & 127) - 1)) & (pieceCell[$"piece{i}"] < 0),
      right: 1
    )
    mode: Level
    // Each captured piece gets its own place beside the board.
    poseCell(
      key: $"placement:piece{i}",
      topology: chessBoard,
      expression: 0,
      offset: [-0.4 - 0.15 * (i % 4), 0.3, 0.18 * (i / 4)]
    )
  }
}

rule "chess-ai-finish" {
  when (((ai[pending] == 1)) == 1 : Int)
  mode: Level
  aiBest[token] = -1
  ai[pending] = 0
  aiEnabled = 0
  settleHold = 0
}

// ---- Playing at the table --------------------------------------------------------------------------------------
// Seat 1 sits down with the context button (the board's engage block) and plays with the board page below: the cursor
// follows the pointer, the movement keys, the d-pad or the stick, one square a press, up the board being away from the
// side the seat sits on. The pick button lifts the side to move's piece under the cursor, which then hovers over the
// cursor; the next press puts it down there, or a release away from the square it left does (a drag). Pressing on the
// square it left, the cancel button or standing up puts it back. A put-down hands the move to the computer's own apply
// path (ai[from], ai[to], ai[pending]): it takes a captured piece beside the board, moves a castling rook, lifts the
// pawn an en-passant capture takes and queens a pawn on the last rank, then the settled arrangement is judged as ever.
// An arrangement judged illegal is put back as it stood before the put-down.

// The seated seat's buttons this tick, each 1 while held past half way.
rule "chess-play-buttons" {
  mode: Level
  play[pickNow] = 0
  play[cancelNow] = 0
  play[aheadNow] = 0
  play[behindNow] = 0
  play[rightNow] = 0
  play[leftNow] = 0
  if board(engaged, board, 1) == 1 and channel(1, confirm) >= 0.5 {
    play[pickNow] = 1
  }
  if board(engaged, board, 1) == 1 and channel(1, cancel) >= 0.5 {
    play[cancelNow] = 1
  }
  if board(engaged, board, 1) == 1 and channel(1, forward) >= 0.5 {
    play[aheadNow] = 1
  }
  if board(engaged, board, 1) == 1 and channel(1, forward) <= -0.5 {
    play[behindNow] = 1
  }
  if board(engaged, board, 1) == 1 and channel(1, strafe) >= 0.5 {
    play[rightNow] = 1
  }
  if board(engaged, board, 1) == 1 and channel(1, strafe) <= -0.5 {
    play[leftNow] = 1
  }
}

// The press images: each binary is this tick's press on a rising edge, and each step is +1 or -1 on a rising edge.
rule "chess-play-edges" {
  mode: Level
  local pick = play[pickNow]
  local cancel = play[cancelNow]
  local ahead = play[aheadNow]
  local behind = play[behindNow]
  local rightward = play[rightNow]
  local leftward = play[leftNow]
  play[pickEdge] = pick & (play[pickDown] == 0)
  play[releaseEdge] = (pick == 0) & (play[pickDown] == 1)
  play[cancelEdge] = cancel & (play[cancelDown] == 0)
  play[stepAhead] = (ahead & (play[aheadDown] == 0)) - (behind & (play[behindDown] == 0))
  play[stepRight] = (rightward & (play[rightDown] == 0)) - (leftward & (play[leftDown] == 0))
  play[pickDown] = pick
  play[cancelDown] = cancel
  play[aheadDown] = ahead
  play[behindDown] = behind
  play[rightDown] = rightward
  play[leftDown] = leftward
}

// The pointer moves the cursor whenever it moves onto another square.
rule "chess-play-point" {
  local pointed = board(pointer, board, 1)
  when board(engaged, board, 1) == 1
  mode: Level
  if pointed >= 0 and pointed != play[pointer] {
    play[cursor] = pointed
  }
  play[pointer] = pointed
}

// A step moves the cursor one square in the seat's own frame: from the -Z side up the board is +row and right is
// -column, toward the h-file (the camera's right is its forward crossed with up), and each other side turns both a
// quarter.
rule "chess-play-step" {
  when play[stepAhead] != 0 or play[stepRight] != 0
  mode: Level
  local seatSide = board(side, board, 1)
  local cursorColumn = (
    play[cursor] % 8 +
    play[stepAhead] * (seatSide == 3 ? 1 : seatSide == 1 ? -1 : 0) +
    play[stepRight] * (seatSide == 2 ? 1 : seatSide == 0 ? -1 : 0)
  )
  local cursorRow = (
    play[cursor] / 8 +
    play[stepAhead] * (seatSide == 0 ? 1 : seatSide == 2 ? -1 : 0) +
    play[stepRight] * (seatSide == 3 ? 1 : seatSide == 1 ? -1 : 0)
  )
  play[cursor] = clamp(cursorRow, 0, 7) * 8 + clamp(cursorColumn, 0, 7)
}

// A press lifts the side to move's piece under the cursor, once the board has rested and while no answer is moving.
rule "chess-play-lift" {
  when ((
    (play[pickEdge] == 1) &
    (play[held] < 0) &
    (play[judging] == 0) &
    (pieceCell[$each] == play[cursor]) &
    (pieceCode[$each] * (1 - 2 * turn) > 0) &
    (aiSide != turn) &
    (ai[pending] == 0) &
    (settleHold == chessSettleTicks)
  ) == 1 : Int)
  mode: Level
  forEach: pieceCode
  play[held] = pieceOrdinal[$each]
  play[from] = play[cursor]
  play[lifted] = 1
}

// A put-down: a fresh press on another square, or the release of the lifting press away from the square the piece
// left. A square holding a piece of the side to move takes nothing.
rule "chess-play-put" {
  local press = (play[pickEdge] == 1) & (play[lifted] == 0)
  local drop = (play[releaseEdge] == 1) & (play[lifted] == 1)
  local open = (play[cursor] != play[from]) & (board[play[cursor]] * (1 - 2 * turn) <= 0)
  when (((play[held] >= 0) & (press | drop) & open & (pieceOrdinal[$each] == play[held])) == 1 : Int)
  mode: Level
  forEach: pieceCode
  pieceCell[$each] = play[from]
  ai[from] = play[from]
  ai[to] = play[cursor]
  ai[mover] = pieceCode[$each]
  ai[pending] = 1
  play[held] = -1
  play[judging] = 1
}

// What the put-down is judged against, captured the tick it is made.
rule "chess-play-before" {
  when play[judging] == 1 and ai[pending] == 1
  mode: Level
  forEach: pieceCode
  playBefore[$each] = pieceCell[$each]
  playBeforeCode[$each] = pieceCode[$each]
}

// Putting the piece back: the cancel button, a press on the square it left, or standing up from the table.
rule "chess-play-cancel" {
  local back = (play[pickEdge] == 1) & (play[lifted] == 0) & (play[cursor] == play[from])
  when (((play[held] >= 0) & ((play[cancelEdge] == 1) | back | (board(engaged, board, 1) == 0))) == 1 : Int)
  mode: Level
  play[returning] = play[held]
  play[held] = -1
}

rule "chess-play-release" {
  when play[releaseEdge] == 1
  mode: Level
  play[lifted] = 0
}

// The verdict on a put-down: an illegal arrangement is put back as it stood before it.
rule "chess-play-judged" {
  when play[judging] == 1 and ai[pending] == 0 and settleHold == chessSettleTicks
  mode: Level
  play[judging] = 0
  play[revert] = verdict == 0
}

rule "chess-play-revert-codes" {
  when play[revert] == 1
  mode: Level
  forEach: pieceCode
  pieceCode[$each] = playBeforeCode[$each]
}

for i in range(0, 32) {
  // The held piece hovers over the cursor, out of the board's band, so the board never rests while it is up.
  rule $"chess-play-hold-{i}" {
    when play[held] == i
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: play[cursor], offset: [0, 0.6, 0])
  }
  rule $"chess-play-return-{i}" {
    when play[returning] == i
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: play[from], offset: [0, 0.3, 0])
  }
  rule $"chess-play-revert-{i}" {
    when play[revert] == 1 and playBefore[$"piece{i}"] >= 0 and pieceCell[$"piece{i}"] != playBefore[$"piece{i}"]
    mode: Level
    poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: playBefore[$"piece{i}"], offset: [0, 0.3, 0])
  }
}

rule "chess-play-settled" {
  mode: Level
  play[returning] = -1
  play[revert] = 0
}

// The cursor stands on its square while the seat sits at the table, and rests inside the tabletop otherwise.
rule "chess-play-cursor-shown" {
  when board(engaged, board, 1) == 1
  mode: Level
  poseCell(key: `placement:boardCursor`, topology: chessBoard, expression: play[cursor], offset: [0, 0.066, 0])
}

rule "chess-play-cursor-parked" {
  when board(engaged, board, 1) == 0
  mode: Level
  poseCell(key: `placement:boardCursor`, topology: chessBoard, expression: play[cursor], offset: [0, 0, 0])
}

// The board consumes shared movement, confirm, cancel, and leave actions.


// The board page, which the seat's controls switch to while it sits at a tabletop.
bindingOverlays [
  {
    id: "tabletop"
    document {
      version: "puck.input.bindings.v1"
      modifiers []
      contexts [
        { family: "engagement", state: "tabletop", group: "tabletop" }
      ]
      chords [
        {
          chord []
          group: "tabletop"
          page {
            id: "board"
            label: "Board"
            entries [
              {
                channel: "forward"
                id: "boardUp"
                scale: 1
                sources ["keyboard.w", "keyboard.arrowUp", "gamepad.dpadUp"]
              }
              {
                channel: "forward"
                id: "boardDown"
                scale: -1
                sources ["keyboard.s", "keyboard.arrowDown", "gamepad.dpadDown"]
              }
              {
                channel: "strafe"
                id: "boardLeft"
                scale: -1
                sources ["keyboard.a", "keyboard.arrowLeft", "gamepad.dpadLeft"]
              }
              {
                channel: "strafe"
                id: "boardRight"
                scale: 1
                sources ["keyboard.d", "keyboard.arrowRight", "gamepad.dpadRight"]
              }
              { command: "player.move.strafe", id: "boardStick", sources ["gamepad.leftStick"] }
              {
                channel: "confirm"
                id: "confirm"
                label: "Pick"
                scale: 1
                sources ["keyboard.space", "keyboard.enter", "mouse.button1", "gamepad.buttonSouth"]
              }
              {
                channel: "cancel"
                id: "cancel"
                label: "Cancel"
                scale: 1
                sources ["keyboard.escape", "keyboard.backspace", "mouse.button2", "gamepad.buttonEast"]
              }
              {
                channel: "interact"
                id: "boardLeave"
                label: "Leave"
                scale: 1
                sources ["keyboard.e", "gamepad.rightShoulder"]
              }
            ]
          }
        }
      ]
    }
  }
]

// Where each piece could move, as (column, row) steps on the `chessBoard` grid: the search tries only these cells and
// the judging rules still decide every move. A pawn steps, double-steps and takes (en passant included) forward, the
// king steps and castles two columns, and the bishop, rook and queen slide to the edge or the first piece. Each side's
// patterns apply only on its own turn, so the side not to move offers no candidate.
let orthogonalSteps = [[1, 0], [-1, 0], [0, 1], [0, -1]]
let diagonalSteps = [[1, 1], [1, -1], [-1, 1], [-1, -1]]
let knightSteps = [[1, 2], [2, 1], [2, -1], [1, -2], [-1, -2], [-2, -1], [-2, 1], [-1, 2]]
let kingSteps = concat(orthogonalSteps, diagonalSteps, [[2, 0], [-2, 0]])
let chessMoves = concat(
  map(
    [1, -1],
    sign => { codes [sign], turn: (1 - sign) / 2, offsets [[0, sign], [0, 2 * sign], [1, sign], [-1, sign]] }
  ),
  map([1, -1], sign => { codes [2 * sign], turn: (1 - sign) / 2, offsets: knightSteps }),
  map([1, -1], sign => { codes [3 * sign, 5 * sign], turn: (1 - sign) / 2, offsets: diagonalSteps, range: 0 }),
  map([1, -1], sign => { codes [4 * sign, 5 * sign], turn: (1 - sign) / 2, offsets: orthogonalSteps, range: 0 }),
  map([1, -1], sign => { codes [6 * sign], turn: (1 - sign) / 2, offsets: kingSteps })
)

search {
  jobs [
    {
      name: "chessAI"
      tokens: pieceCell
      board: board
      turn: turn
      verdict: verdict
      enabled: aiEnabled
      revision: aiRevision
      depth: 1
      best: aiBest
      shapes [
        relocate(displace: true, codes: pieceCode, moves: chessMoves)
      ]
      // The score is from the side that just moved. One ply, automatic queen
      // promotion, material first, then central occupation and pawn progress.
      score: (2 * turn - 1) * ai[evaluation]
    }
  ]
}

state {
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }

  lattices [
    grid(band: 0.3, cellSize: 0.2, depth: 8, directions: [
      {
        name: "N"
        x: 0
        y: -1
        z: 0
      }
      {
        name: "NE"
        x: 1
        y: -1
        z: 0
      }
      {
        name: "E"
        x: 1
        y: 0
        z: 0
      }
      {
        name: "SE"
        x: 1
        y: 1
        z: 0
      }
      {
        name: "S"
        x: 0
        y: 1
        z: 0
      }
      {
        name: "SW"
        x: -1
        y: 1
        z: 0
      }
      {
        name: "W"
        x: -1
        y: 0
        z: 0
      }
      {
        name: "NW"
        x: -1
        y: -1
        z: 0
      }
    ], name: "chessBoard", origin: [-0.8, 1.25, -0.8], width: 8, wrap: None)
  ]

  world {
    row {
      capacity: 64
      domain: cellsOf(topology: chessBoard)
      kind: "Int"
      max: 6
      min: -6
      name: "board"
      inverse {
        tokens: "pieceCell"
        codes: "pieceCode"
      }
    }

    row {
      capacity: 64
      cells: map(initialBoard, (code, i) => { key: $"{i}", value: code })
      domain: cellsOf(topology: chessBoard)
      kind: "Int"
      max: 6
      min: -6
      name: "lastLegal"
    }

    row {
      capacity: 64
      domain: cellsOf(topology: chessBoard)
      kind: "Int"
      name: "plan"
    }

    table ai {
      evaluation = 0
      metadata = -1
      pending = 0
      from = -1
      to = -1
      mover = 0
    }
    slot aiSide = 1 bounds(-1..1)
    slot aiEnabled = 0 bounds(0..1)
    slot aiRevision = 0
    table aiBest {
      token = -1
      to = -1
      score = 0
      revision = -1
    }
    row {
      name: "pieceOrdinal"
      kind: "Int"
      cells: map(range(0, 32), i => { key: $"piece{i}", value: i })
    }
    row {
      name: "aiBefore"
      kind: "Int"
      capacity: 32
      cells: map(range(0, 32), i => { key: $"piece{i}", value: -1 })
    }

    // Seat 1 at the table: the cursor's square, the piece it holds (its ordinal, -1 for none) and the square it
    // left, the last pointed square, this tick's presses (the *Edge and step keys) and last tick's buttons (*Down),
    // whether the held piece was lifted by the press still down, whether a put-down awaits its verdict, and the piece
    // being put back or the arrangement being restored this tick.
    table play {
      cursor = 11
      held = -1
      from = -1
      pointer = -1
      pickNow = 0
      cancelNow = 0
      aheadNow = 0
      behindNow = 0
      rightNow = 0
      leftNow = 0
      pickEdge = 0
      releaseEdge = 0
      cancelEdge = 0
      stepAhead = 0
      stepRight = 0
      pickDown = 0
      cancelDown = 0
      aheadDown = 0
      behindDown = 0
      rightDown = 0
      leftDown = 0
      lifted = 0
      judging = 0
      returning = -1
      revert = 0
    }
    row {
      name: "playBefore"
      kind: "Int"
      capacity: 32
      min: -1
      max: 63
      cells: map(range(0, 32), i => { key: $"piece{i}", value: -1 })
    }
    row {
      name: "playBeforeCode"
      kind: "Int"
      capacity: 32
      min: -6
      max: 6
      cells: map(initialPieceCodes, (code, i) => { key: $"piece{i}", value: code })
    }

    slot turn = 0 bounds(0..1)

    slot verdict = 1 bounds(0..1)

    slot illegalCount = 0 bounds(0..50400)

    slot settleHold = 0 bounds(0..chessSettleTicks)

    slot gameStarted = 0 bounds(0..1)

    table pieceSetColors {
      white = "#F2E9D8"
      black = "#2B2420"
    }

    table move capacity(5) bounds(-6..63) {
      captured = 0
      from = -1
      kind = 0
      mover = 0
      to = -1
    }

    row {
      name: "pieceCode"
      kind: "Int"
      capacity: 32
      min: -6
      max: 6
      cells: map(initialPieceCodes, (code, i) => { key: $"piece{i}", value: code })
    }

    row {
      name: "pieceCell"
      kind: "Int"
      capacity: 32
      min: -1
      max: 63
      cells: map(range(0, 32), i => { key: $"piece{i}", value: -1 })
    }

    table promotionPending capacity(2) bounds(-1..63) {
      "0" = -1
      "1" = -1
    }

    slot enPassantTarget = -1 bounds(-1..63)

    table inCheck capacity(2) bounds(0..1) {
      "0" = 0
      "1" = 0
    }

    for name in ["boardHistory0", "boardHistory1", "boardHistory2", "boardHistory3", "boardHistoryRights"] {
      row {
        name: name
        kind: "Int"
        domain: ring(capacity: 151, empty: 0)
      }
    }

    row {
      name: "historyAges"
      kind: "Int"
      cells: map(range(0, 75), i => { key: $"{i}", value: 2 * (i + 1) })
    }

    row {
      name: "enPassantProbe"
      kind: "Int"
      capacity: 64
      min: -6
      max: 6
      domain: cellsOf(topology: chessBoard)
    }

    slot enPassantProbeCheck = 0 bounds(0..1)
    slot repetitionEnPassant = -1 bounds(-1..63)
    slot historyPending = 0 bounds(0..1)
    slot historyReset = 0 bounds(0..1)
    slot historyLength = 0 bounds(0..151)
    slot halfmoveClock = 0 bounds(0..150)
    slot repetitionCount = 0 bounds(0..76)

    slot shapeLegal = 0 bounds(0..1)

    slot castleLegal = 0 bounds(0..1)

    table boardColors {
      light = "#F0D9B5"
      dark = "#8B5A2B"
      cursor = "#3FA9F5"
    }

    slot castleRights = 0 bounds(0..15)

    table previousInCheck capacity(2) bounds(0..1) {
      "0" = 0
      "1" = 0
    }

    table castleTransitAttacked capacity(4) bounds(0..1) {
      wk = 0
      wq = 0
      bk = 0
      bq = 0
    }

    slot boardMismatch = 0 bounds(0..64)

    slot boardChanged = 0 bounds(0..64)

    slot boardCollisions = 0 bounds(0..64)
  }
}
