// The debug world set's game stations: the catalog every station of the set offers, the module instance each station
// holds its games in, and what the world holds for all of them. A module library over the standard's game station
// (../standard/game-station.puck): the gallery's board game room stands twelve (gallery/games.puck, which gallery-root.puck
// imports), the debug world its first (game-station-deck.puck), the board games lab one (labs/board-games.puck) and its
// stress mode twelve (labs/board-games-stress.puck), and the isolated root one (game-station-root.puck). game-station.md says how to play and drive them.
//
// Every station is a game table that swaps games through its menu, the way a display station swaps shapes, and holds its
// own game of each. Its board is a holodeck (../standard/holodeck.puck): the game shown stands its tokens on the glass as
// real bodies (chess's pieces, chess-station.puck; patience's cards, patience-station.puck) and the station releases them
// when it shows another. A world stands a station by
//
//   - expanding the world's part over its list of stations, `gameStationSet` at its top level where its body order
//     wants the cards (or its pieces one by one: `gameStationSetPrototypes`, `gameStationSetPlacements`,
//     `gameStationSetGrids` and `gameStationSetState` in their blocks, `gameStationSetRules` and `chessStationSet` at its
//     top level, `gameStationSetCommands` as its commands, and the deck, `patienceDeck` and `patienceStationCards`);
//   - declaring the chess game's three vocabularies (`PieceKind`, `MoveKind`, `TurnColor`, chess.puck's header) in its
//     own `state` block, since a template cannot carry them;
//   - and making one instance a station, `use gameStationGames as <id>(station: <station>, index: <i>)`, with the
//     station's id as the alias, so every row and rule the instance declares is `<id>$<name>` and the console commands
//     reach it, and `i` the station's place in the list, which keys its cells in the rules one set plays for every
//     station (`klondikeRequest[i]`, `freecellPile8Of<i>`). A world with other than `gameStationSeats` local seats
//     passes its count as `seats: <n>`, which the chairs read, and a station that plays chess against itself passes
//     `autoplay` (chess-station.puck's `chessStationPlay`);
//   - and sizing its population for every body its stations may stand at once: `gameStationBodies` a station.
import "../standard/game-station"
import "../games/chess"
import "../games/chess-station"
import "../games/solitaire"
import "../games/klondike"
import "../games/freecell"
import "../games/patience-station"

// The catalog, in the order the menu lists it: chess, then the two patience games, each a game of its own as the shape
// catalog lists each exhibit as its own row.
let gameStationCatalog = [
  { id: "chess", title: "CHESS" }
  { id: "klondike", title: "KLONDIKE" }
  { id: "freecell", title: "FREECELL" }
]

// The ticks the pieces must stay at rest after a move before the board is judged.
let chessGameSettleTicks = 9

// A station's bodies at most: its cursor and held outlines, and its largest token game's tokens, the patience deck's 52
// cards (patience-station.puck), since its holodeck stands one game's tokens at a time (chess's 32 pieces,
// chess-station.puck, are fewer). A world whose cards stand always (`holodeck: false`) adds the chess pieces' 32.
let gameStationBodies = 54
let gameStationChessBodies = 32

// The station the isolated root stands: at the origin, its creation's floor on the root's floor.
let rootStation = { id: "station", at [0, -0.5, 0] }

// One station's games: chess (chess.puck, its pieces stood by chess-station.puck's holodeck) and the patience collection
// (solitaire.puck over klondike.puck and freecell.puck, laid out by patience-station.puck), with the station's menu and
// chairs (the standard's gameStationRules). Every name it declares is the instance's own, so a station's games, bodies
// and presses never touch another's; it reads and writes the world's rows only by its own station's key. The rules run
// in the order below: the chairs' presses first, then chess (the judge reads the settled pieces, the doors and the play
// write the cells, and the holodeck stands the bodies where the cells say), then patience.
module gameStationGames(station, index, seats = gameStationSeats, autoplay = null) {
  state {
    chessStationGrid()
    world {
      gameStationSeatState()
      chessGameState(settleTicks: chessGameSettleTicks, placed: true)
      chessStationState(station: station)
      patienceStationState(station: station)
    }
  }
  placements {
    chessStationBoard(station: station)
    patienceStationSpots(station: station, index: index)
  }

  gameStationRules(station: station, catalog: gameStationCatalog, seats: seats)

  chessSearch(name: $"chessAI-{station.id}")
  chessJudge(settleTicks: chessGameSettleTicks, scope: "pieceCode")
  chessComputer(settleTicks: chessGameSettleTicks)
  chessMoveDoor(settleTicks: chessGameSettleTicks)
  chessMoveDone()
  chessStationPlay(station: station, game: 0, settleTicks: chessGameSettleTicks, autoplay: autoplay)
  chessPutDown(settleTicks: chessGameSettleTicks)
  chessPutJudged(settleTicks: chessGameSettleTicks, restoresCells: true)
  chessFreshGame()
  chessStationHolodeck(station: station, game: 0)
  chessPutSettled()
  chessStationGlass(station: station, game: 0)

  patienceStationRules(station: station, index: index, klondike: 1, freecell: 2)
}

// The world's part, over every station it stands. Prototypes: each station's table (its paints read the world's rows by
// its key), and the chess pieces and patience outlines every station shares.
template gameStationSetPrototypes(stations) {
  for station in stations {
    gameStationPrototype(station: station, catalog: gameStationCatalog, boardPanels: chessStationPanels(station))
  }
  chessStationPrototypes()
  patienceStationPrototypes()
}

// Each station's table, inside the world's `placements` block.
template gameStationSetPlacements(stations) {
  for station in stations {
    gameStationPlacement(station: station)
  }
}

// Each station's pick grid, inside the world's `state` block.
template gameStationSetGrids(stations) {
  for station in stations {
    gameStationGrid(station: station)
  }
  patienceSlotsGraph()
}

// What the stations' paints, the console and every station's rules read, inside the world's `state.world` block.
template gameStationSetState(stations, holodeck = true) {
  gameStationState(stations: stations, catalog: gameStationCatalog)
  chessStationDisplayState(stations: stations)
  patienceDisplayState(stations: stations, holodeck: holodeck)
  solitaireState(count: length(stations))
}

// The rules the world holds once for every station, at the world's top level: the patience games' and the patience
// layout's, each sweeping the stations' tables (`solitaireTable`, keyed by a station's place in the list, the `index`
// its instance is made with) or a family a member a station (`patienceCardNoOf`, `klondikePile2Of`). `holodeck` is
// patience-station.puck's: whether the cards are a holodeck pool.
template gameStationSetRules(holodeck = true) {
  solitaireGame()
  patienceSetRules(holodeck: holodeck)
}

// The world's part of every station it stands, in one call at the world's top level: the stations' commands, the deck
// and each station's cards (`holodeck`: whether the cards are a holodeck pool or stand always, patience-station.puck),
// the chess pieces' looks and kit, each station's table and pick grid, the rows the stations' paints and rules read, and
// the rules one set plays for every station. The world still declares the chess vocabularies and makes one instance a
// station itself (this file's header), and sizes its population for `gameStationBodies` a station.
template gameStationSet(stations, holodeck = true) {
  commands: gameStationSetCommands(stations)

  patienceDeck()
  for (station, index) in stations {
    patienceStationCards(station: station, index: index, holodeck: holodeck)
  }
  chessStationSet(stations: stations)

  placements {
    gameStationSetPlacements(stations: stations)
  }

  prototypes {
    gameStationSetPrototypes(stations: stations)
  }

  state {
    gameStationSetGrids(stations: stations)
    world {
      gameStationSetState(stations: stations, holodeck: holodeck)
    }
  }

  gameStationSetRules(holodeck: holodeck)
}

// A small room holding `stations` on their own: a floor, `seats` local seats and visitors with room above them for every
// station's bodies, a spawn at the first station's near chair (`hero`) and at its far chair (`rival`), the glass's font,
// and the world's part of every station (`gameStationSet`). game-station-root.puck, the board games labs and the
// stations' test worlds stand on it; each still declares the chess vocabularies and makes one instance a station itself
// (this file's header). A world standing more bodies beside the stations names their count in `extraBodies`.
template gameStationRoom(stations, seats = gameStationSeats, extraBodies = 0) {
  bodies {
    capacity: (12 + (gameStationBodies * length(stations)) + extraBodies)
    localSeats: seats
    networkPlayers: 8
    seatSpawns [hero, rival]
  }

  spawnPoints [
    { id: "hero", position: gameStationChairAt(stations[0], "near"), yawDegrees: 180 }
    { id: "rival", position: gameStationChairAt(stations[0], "far"), yawDegrees: 0 }
  ]

  text {
    defaultFont: "inter"
    fonts [
      {
        name: "inter"
        source: "fonts/inter-regular.ttf"
        hash: "sha256/40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82"
        codePointRanges ["U+0020-U+007E"]
      }
    ]
  }

  placements {
    placement "floor" {
      prototype: "floor"
      position [0, 0, 0]
      solid
    }
  }

  prototypes {
    prototype "floor" {
      document {
        name: "floor"
        schema: "puck.creation.v2"
        palette [{ color: "#B9AE9C", roughness: 0.8, specular: 0.03 }]
        shape Box "floor" {
          material: 0
          position [0, -0.2, 0]
          scale [12, 0.2, 12]
        }
      }
    }
  }

  gameStationSet(stations: stations)
}

// The console's commands over every station: `station.game`, a chess move, and the patience games' deals and moves.
function gameStationSetCommands(stations) = concat(
  gameStationCommands(stations, gameStationCatalog),
  [
    {
      name: "station.chess"
      help: "Requests a chess move on a game station through its game's apply and judge: the station, then the cells from and to, counting 8 * rank + 7 - file from a1."
      parameters [
        { name: "station", kind: Choice, values: map(stations, station => station.id) }
        { name: "from", kind: Integer }
        { name: "to", kind: Integer }
      ]
      lines [
        "world.state.cell.set {station}$chessInput from {from}"
        "world.state.cell.set {station}$chessInput to {to}"
        "world.state.cell.set {station}$chessInput request 1"
      ]
    }
  ],
  patienceCommands(stations)
)
