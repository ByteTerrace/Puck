// The debug world set's game stations: the catalog every station of the set offers, and what a world holds for all of
// them. A module library over the standard's game station (../standard/game-station.puck): the gallery's board game room
// stands twelve (gallery/games.puck, which gallery-root.puck imports), the debug world its first
// (game-station-deck.puck), the board games lab one (labs/board-games.puck) and its stress mode twelve
// (labs/board-games-stress.puck), and the isolated root one (game-station-root.puck). game-station.md says how to play
// and drive them.
//
// Every station is a game table that swaps games through its menu, the way a display station swaps shapes, and holds its
// own game of each. Its board is a holodeck (../standard/holodeck.puck): the game shown stands its tokens on the glass as
// real bodies (chess's pieces, chess-station.puck; patience's cards, patience-station.puck) and the station releases them
// when it shows another. Every station plays one set of rules: each rule sweeps the stations, `$member` (or a patience
// rule's `$each`) a station's place in the world's list, and each station's state is a cell under its place or its member
// of a family of rows, so a move at one station wakes and costs that station alone, its computer's search
// (`chessAI-<id>`) judges its own game alone, and twelve stations price as one set and each station's change. A world
// stands its stations by
//
//   - expanding the world's part over its list of stations, `gameStationSet(stations: …)` at its top level where its
//     body order wants the cards; a world with other than `gameStationSeats` local seats passes its count as
//     `seats: <n>`, which the chairs read, and a world whose stations play chess against themselves passes each station's
//     `autoplay` (chess-station.puck's `chessStationState`);
//   - declaring the chess game's three vocabularies (`PieceKind`, `MoveKind`, `TurnColor`, chess.puck's header) in its
//     own `state` block, since a template cannot carry them;
//   - and sizing its population for every body its stations may stand at once: `gameStationBodies` a station.
//
// The console names a station by its place in the list, 0 for the first: `station.game 0 klondike`,
// `station.chess 0 11 27`, `klondike.deal 0`.
import "../standard/game-station"
import "../games/chess"
import "../games/chess-station"
import "../games/solitaire"
import "../games/klondike"
import "../games/freecell"
import "../games/patience-station"

// The catalog, in the order the menu lists it: chess, then the two patience games, each a game of its own as the shape
// catalog lists each exhibit as its own row.
let gameStationCatalog = [
  { id: "chess", title: "CHESS" }
  { id: "klondike", title: "KLONDIKE" }
  { id: "freecell", title: "FREECELL" }
]

// The ticks the pieces must stay at rest after a move before the board is judged.
let chessGameSettleTicks = 9

// A station's bodies at most: its cursor and held outlines, and its largest token game's tokens, the patience deck's 52
// cards (patience-station.puck), since its holodeck stands one game's tokens at a time (chess's 32 pieces,
// chess-station.puck, are fewer). A world whose cards stand always (`holodeck: false`) adds the chess pieces' 32.
let gameStationBodies = 54
let gameStationChessBodies = 32

// The station the isolated root stands: at the origin, its creation's floor on the root's floor.
let rootStation = { id: "station", at [0, -0.5, 0] }

// The world's part of every station it stands, in one call at the world's top level: the stations' commands, the deck
// and each station's cards (`holodeck`: whether the cards are a holodeck pool or stand always, patience-station.puck),
// the chess pieces' looks and kit, each station's table, chess board and piles' outlines, its prototype and its grids,
// every row the stations' paints and rules read, each station's computer search, and the rules one set plays for every
// station: the patience games' and the patience layout's, then the chairs' presses first, then chess (the judge reads the
// settled pieces, the doors and the play write the cells, and the holodeck stands the bodies where the cells say), then
// patience's chair and status line. The world still declares the chess vocabularies itself (this file's header) and sizes
// its population for `gameStationBodies` a station.
template gameStationSet(stations, holodeck = true, autoplay = null, seats = gameStationSeats) {
  commands: gameStationSetCommands(stations)

  patienceDeck()
  for (station, index) in stations {
    patienceStationCards(station: station, index: index, holodeck: holodeck)
  }
  chessStationSet(stations: stations)

  placements {
    for (station, index) in stations {
      gameStationPlacement(station: station, index: index)
      chessStationBoard(station: station, index: index)
      patienceStationSpots(station: station, index: index)
    }
  }

  prototypes {
    for (station, index) in stations {
      gameStationPrototype(station: station, index: index, catalog: gameStationCatalog, boardPanels: chessStationPanels(station, index))
    }
    chessStationPrototypes()
    patienceStationPrototypes()
  }

  state {
    chessStationGrids(count: length(stations))
    patienceSlotsGraph()
    world {
      gameStationState(stations: stations, catalog: gameStationCatalog)
      chessGameState(keys: map(stations, station => chessStationKeys(station)), settleTicks: chessGameSettleTicks, placed: true)
      chessStationState(stations: stations, autoplay: autoplay)
      chessStationDisplayState(stations: stations)
      patienceDisplayState(stations: stations, holodeck: holodeck)
      solitaireState(count: length(stations))
    }
  }

  for (station, index) in stations {
    chessSearch(name: $"chessAI-{station.id}", index: index)
  }

  solitaireGame()
  patienceSetRules(holodeck: holodeck)

  gameStationRules(catalog: gameStationCatalog, seats: seats)

  chessJudge(settleTicks: chessGameSettleTicks)
  chessComputer(settleTicks: chessGameSettleTicks)
  chessMoveDoor(settleTicks: chessGameSettleTicks)
  chessMoveDone()
  chessStationPlay(game: 0, settleTicks: chessGameSettleTicks, autoplay: (autoplay != null))
  chessPutDown(settleTicks: chessGameSettleTicks)
  chessPutJudged(settleTicks: chessGameSettleTicks, restoresCells: true)
  chessFreshGame()
  chessStationHolodeck(game: 0)
  chessPutSettled()
  chessStationGlass(game: 0)

  patienceStationRules(klondike: 1, freecell: 2)
}

// A small room holding `stations` on their own: a floor, `seats` local seats and visitors with room above them for every
// station's bodies, a spawn at the first station's near chair (`hero`) and at its far chair (`rival`), the glass's font,
// and the world's part of every station (`gameStationSet`, `autoplay` its). game-station-root.puck, the board games labs
// and the stations' test worlds stand on it; each still declares the chess vocabularies itself (this file's header). A
// world standing more bodies beside the stations names their count in `extraBodies`.
template gameStationRoom(stations, seats = gameStationSeats, extraBodies = 0, autoplay = null) {
  bodies {
    capacity: (12 + (gameStationBodies * length(stations)) + extraBodies)
    localSeats: seats
    networkPlayers: 8
    seatSpawns [hero, rival]
  }

  spawnPoints [
    { id: "hero", position: gameStationChairAt(stations[0], "near"), yawDegrees: gameStationChairYaw(stations[0], "near") }
    { id: "rival", position: gameStationChairAt(stations[0], "far"), yawDegrees: gameStationChairYaw(stations[0], "far") }
  ]

  text {
    defaultFont: "inter"
    fonts [
      {
        name: "inter"
        source: "fonts/inter-regular.ttf"
        hash: "sha256/40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82"
        codePointRanges ["U+0020-U+007E"]
      }
    ]
  }

  placements {
    placement "floor" {
      prototype: "floor"
      position [0, 0, 0]
      solid
    }
  }

  prototypes {
    prototype "floor" {
      document {
        name: "floor"
        schema: "puck.creation.v2"
        palette [{ color: "#B9AE9C", roughness: 0.8, specular: 0.03 }]
        shape Box "floor" {
          material: 0
          position [0, -0.2, 0]
          scale [12, 0.2, 12]
        }
      }
    }
  }

  gameStationSet(stations: stations, autoplay: autoplay, seats: seats)
}

// The console's commands over every station: `station.game`, a chess move, and the patience games' deals and moves.
function gameStationSetCommands(stations) = concat(
  gameStationCommands(stations, gameStationCatalog),
  [
    {
      name: "station.chess"
      help: "Requests a chess move on a game station through its game's apply and judge: the station's number (0 for the world's first station), then the cells from and to, counting 8 * rank + 7 - file from a1."
      parameters [
        { name: "station", kind: Choice, values: map(range(0, length(stations)), i => $"{i}") }
        { name: "from", kind: Integer }
        { name: "to", kind: Integer }
      ]
      lines [
        "world.state.cell.set chessInputOf{station} from {from}"
        "world.state.cell.set chessInputOf{station} to {to}"
        "world.state.cell.set chessInputOf{station} request 1"
      ]
    }
  ],
  patienceCommands(stations)
)
