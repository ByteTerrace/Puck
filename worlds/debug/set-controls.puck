// The controls every world of the debug world set shares (the debug world, the garden, the night field, the moon and
// the worlds built on their avatar): the standard's context sets (../standard/controls.puck) with what this set adds
// to them. It opts into swimming. On foot, Backspace returns a seat to the debug world's stage. The avatar's inspection
// views take the number keys and the View page's plates, and her jetpack's isolation F4 (the layouts and the parts are
// stage.puck's). The play wheel gains the set's Respawn and Suit sectors and a View ring of those layouts
// (pad-kit.puck). It imports the standard and refines its rows by overlay, page, wheel and table key, so a world of
// the set imports it in the standard's place; the debug world's own pages refine it in turn (controls.puck).
import "../standard/standard"
import "../standard/contexts/swimming"
import "pad-kit"

// The standard's screen material, re-exported so a world importing these controls names it.
export binding crt

// The avatar swims wherever a world of the set has water (her kit leads with the swim hold), so the set opts into the
// swimming context.
swimPlay()

bindingOverlays [
  // The bar shows the keys this set binds beside the standard's.
  {
    id: "bar"
    bindingBar {
      slotSet: concat(barSlots, [
        "keyboard.1"
        "keyboard.2"
        "keyboard.3"
        "keyboard.4"
        "keyboard.5"
        "keyboard.f4"
      ])
    }
  }
  {
    id: "set-controls"
    document {
      version: "puck.input.bindings.v1"
      modifiers: padModifiers
      chords [
        {
          chord []
          group: "play"
          page {
            id: "base"
            entries [
              {
                command: "body.pose"
                id: "respawn"
                label: "Respawn"
                text: "spawn:stage"
                sources ["keyboard.backspace"]
              }
              // The avatar's views by their layout's place in her basis's views.layouts (1 the chase, then her
              // inspection cameras).
              for n in range(1, 6) {
                {
                  command: "view.override"
                  id: $"camera{n}"
                  sources [$"keyboard.{n}"]
                  value { kind: "Axis1D", raw [n, 0, 0, 0] }
                }
              }
              {
                command: "view.isolate"
                id: "jetpackAlone"
                label: "Jetpack alone"
                sources ["keyboard.f4"]
                text: "toggle moth pod* nozzle*"
              }
            ]
          }
        }
        {
          chord ["lt"]
          group: "play"
          page {
            id: "pad-lt"
            inherits: "base"
            label: "View"
            entries [
              {
                command: "view.override"
                id: "viewPlay"
                label: "Chase"
                text: "layout play"
                value: neverRead
                sources: padUp
              }
              {
                command: "view.override"
                id: "viewQuarter"
                label: "Three-quarter"
                text: "layout three-quarter"
                value: neverRead
                sources: padRight
              }
              {
                command: "view.override"
                id: "viewFront"
                label: "Front"
                text: "layout front"
                value: neverRead
                sources: padDown
              }
              {
                command: "view.override"
                id: "viewRear"
                label: "Rear"
                text: "layout rear"
                value: neverRead
                sources: padLeft
              }
              {
                command: "view.override"
                id: "viewWide"
                label: "Wide"
                text: "layout flight-stage"
                value: neverRead
                sources: padLeftShoulder
              }
              {
                command: "view.isolate"
                id: "viewIsolate"
                label: "Jetpack alone"
                text: "toggle moth pod* nozzle*"
                sources: padWest
              }
              {
                command: "view.override"
                id: "viewFace"
                label: "Face"
                text: "layout face"
                value: neverRead
                sources: padSouth
              }
            ]
          }
        }
      ]
      wheels [playWheel(rings: setRings)]
    }
  }
]

icons [
  { name: "act.respawn", glyph { font: "jetbrains-mono-regular", glyph: "U+23CE" } }
  { name: "act.isolate", glyph { font: "jetbrains-mono-regular", glyph: "U+25C9" } }
  { name: "act.play", glyph { font: "jetbrains-mono-regular", glyph: "U+25A0" } }
  { name: "act.camera1", label: "C1" }
  { name: "act.camera2", label: "C2" }
  { name: "act.camera3", label: "C3" }
  { name: "act.camera4", label: "C4" }
  { name: "act.camera5", label: "C5" }
  // The View page and ring: the chase view and the inspection layouts.
  { name: "view.play", label: "PL" }
  { name: "view.quarter", label: "3Q" }
  { name: "view.front", label: "FR" }
  { name: "view.rear", label: "RE" }
  { name: "view.wide", label: "WD" }
  { name: "view.face", label: "FC" }
  // The debug view, which the gallery's keys and wheel step (gallery/gallery.puck).
  { name: "act.view", label: "DV" }
  { name: "dbg.suit", label: "SU" }
]

state {
  world {
    table barIcons {
      respawn = "act.respawn"
      camera1 = "act.camera1"
      camera2 = "act.camera2"
      camera3 = "act.camera3"
      camera4 = "act.camera4"
      camera5 = "act.camera5"
      jetpackAlone = "act.isolate"
      viewPlay = "view.play"
      viewQuarter = "view.quarter"
      viewFront = "view.front"
      viewRear = "view.rear"
      viewWide = "view.wide"
      viewIsolate = "act.isolate"
      viewFace = "view.face"
      // suit.puck's Debug-page plate.
      dbgSuit = "dbg.suit"
    }
    table wheelLabels {
      respawn = "Respawn"
      suit = "Suit"
      play = "Play"
      threeQuarter = "Three-quarter"
      front = "Front"
      rear = "Rear"
      wide = "Wide"
      face = "Face"
    }
    table wheelIcons {
      respawn = "act.respawn"
      suit = "dbg.suit"
      play = "act.play"
      threeQuarter = "view.quarter"
      front = "view.front"
      rear = "view.rear"
      wide = "view.wide"
      face = "view.face"
    }
  }
}
