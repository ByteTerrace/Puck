// Which actions the debug world accepts in which context: the standard's families for the contexts it has
// (../standard/contexts/modes.puck's engagement, the instrument, the typing bench, the terminals, a conversation) beside
// the two that follow its avatar's own registers, her form and her jetpack. Eligibility follows body registers and
// engagement, independently of binding pages.
import "../standard/contexts/modes"
import "../standard/instrument"
import "../standard/typing"
import "../standard/contexts/terminal"
import "../standard/contexts/terminal-console"
import "../standard/contexts/conversation"

let movement = movementChannels
// The lock-on and marks keys (targeting.puck) are hers in every form she walks or flies in.
let controls = ["jump", "suit", "noclip", "lock", "lockCycle", "ping", "mark", "markClear"]
let flyingRise = [{ keep ["rise"], from { flight: "flying" }, to { flight: "flying" } }]
let talking = { family: "conversation", states ["talking"] }
// A seat engaged anywhere, at a bench, at a terminal or talking with a steward, has none of the families that move her
// or play an instrument.
let engagedAnywhere = [
  whileEngaged
  { family: "typing", states ["seated"] }
  { family: "terminal", states ["engaged"] }
  talking
]

inputModes {
  // A tap reaches a pointer surface in every mode, as the context button reaches what is beside her.
  global ["interact", "tap", "scroll"]
  families [
    {
      name: "form"
      selector { kind: BodyState, name: "form" }
      default: "suited"
      states [
        { name: "pilot", values ["0"], channels: concat(movement, controls) }
        { name: "suited", values ["1"], channels: concat(movement, controls, ["rise", "flight", "dash"]) }
        { name: "pilot-noclip", values ["2"], channels: concat(movement, controls, ["rise"]) }
        { name: "suited-noclip", values ["3"], channels: concat(movement, controls, ["rise", "flight", "dash"]) }
        // A craft (the launch field's ship): a body no seat is, which flies on the movement and rise channels.
        { name: "craft", values ["4", "5"], channels: concat(movement, ["rise"]) }
      ]
      suspendedBy: engagedAnywhere
      transitions [
        { from: "pilot", to: "suited", keep: movement }
        { from: "suited", to: "pilot", keep: movement }
        { from: "pilot", to: "pilot-noclip", keep: movement }
        { from: "pilot-noclip", to: "pilot", keep: movement }
        { from: "pilot", to: "suited-noclip", keep: movement }
        { from: "suited-noclip", to: "pilot", keep: movement }
        { from: "suited", to: "pilot-noclip", keep: movement, conditionalKeep: flyingRise }
        { from: "pilot-noclip", to: "suited", keep: movement, conditionalKeep: flyingRise }
        { from: "suited", to: "suited-noclip", keep: movement, conditionalKeep: flyingRise }
        { from: "suited-noclip", to: "suited", keep: movement, conditionalKeep: flyingRise }
        { from: "pilot-noclip", to: "suited-noclip", keep: concat(movement, ["rise"]) }
        { from: "suited-noclip", to: "pilot-noclip", keep: concat(movement, ["rise"]) }
      ]
    }
    {
      name: "flight"
      selector { kind: BodyState, name: "flightFuel" }
      default: "walking"
      states [
        { name: "walking", ranges [{ minimum: 0, maximum: 0 }], channels [] }
        { name: "flying", ranges [{ minimum: 1 / 65536, maximum: 1000 }], channels [] }
      ]
      transitions [
        { from: "walking", to: "flying", keep: concat(movement, ["rise"]) }
        { from: "flying", to: "walking", keep: movement }
      ]
    }
    engagementFamily()
    // The instrument's vents are offered while the breath holds it up (bard.puck), and a seat engaged anywhere has none.
    instrumentFamily(suspendedBy: engagedAnywhere)
    // The press's typed text is offered while the seat sits at its bench (press.puck), in place of her movement.
    typingFamily(suspendedBy: [whileEngaged, { family: "terminal", states ["engaged"] }, talking])
    // A gallery display's console takes the seat's taps and its step back while she uses it (gallery/gallery.puck).
    terminalFamily(suspendedBy: [whileEngaged, { family: "typing", states ["seated"] }, talking])
    // Its typed console offers the console key there, and the typed line, Enter and Backspace while it is open.
    terminalConsoleFamily(suspendedBy: [whileEngaged, { family: "typing", states ["seated"] }, talking])
    // A steward's conversation takes the step keys, the pick button and the step back while she talks (gallery/stewards.puck).
    conversationFamily(
      suspendedBy: [whileEngaged, { family: "typing", states ["seated"] }, { family: "terminal", states ["engaged"] }]
    )
  ]
}
