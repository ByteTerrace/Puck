// The faerie: a 24 cm seed of warm light in a continuous ivory eye. Its character lives in these world sources
// and companion.wat. The engine supplies ordinary colliding free flight, Drive and Observe.
// Its body (creation, kit) is companion-body.puck, which every world it may visit imports; this file is its home: the
// placement it lives in, the glowing look its senses pulse, its role and the driver that role names.
// Imported before hall.puck: body 42 remains the companion and the lift keeps its own population slot.
import "inputs"
import "companion-body"
import "companion-senses"

exports {
  reads [companion]
}

looks [
  {
    name: "companion"
    scale: 1
    source: creation(prototypeId: companion)
    motion {
      cues []
      gaitAmplitude: 0
      replayFrames: false
      secondsPerFrame: 0
      lanes [companionGlow.level]
    }
  }
]

// The faerie follows the first seat's player across worlds. Its home re-adopts it into this placement whatever slot
// its trip back lands it at, and counts it present while it is away.
placements {
  placement "companion" {
    prototype: "companion"
    position [-1.2, 1.52, 1]
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "companion-flight"
      look: "companion"
      source: "Idle"
      role: "companion"
      follows: 0
    }
  }
}

// The world that imports this file names this addon as its companion role's driver (debug.puck). Its Drive and
// Observe come from that role, over each companion and the player it follows, wherever they stand.
addon "companion" {
  modulePath: "addons/companion.wat"
  hash: auto
  fuel: 0
  enabled: true
  requests [
    { capability: Drive, subject: "all" }
    { capability: Observe, subject: "all" }
    { capability: Observe, subject: "state:companionSense" }
  ]
}

// The role confines Drive to the companion and Observe to it and its player; this grant discloses the world's sensory
// projection. The guest has no pose, edit, teleport or document mutation authority.
grants [
  { grantee: "addon:companion", capability: Observe, subject: "state:companionSense", budget: 24 }
]
