// The Moth's companion: the standard companion (standard/companion.puck) for seat 0, with the gallery's exhibits,
// lights, screens and portals as its interests and the gallery's own cues as the sounds it turns toward.
// Imported before gallery/gallery.puck: body (galleryPopulation - 1) is the companion's, and the lift keeps its own
// population slot.
import "../standard/inputs"
import "../standard/companion"
import "../standard/lockon"
import "../standard/marks"
import "shapes"

let companionBody = (galleryPopulation - 1)

exports {
  reads [companionGlow0]
}

// Each display's exhibit, the middle of the one its turntable shows, comes from the gallery layout, shared with its
// plinth and guide region. Kind 1 is an exhibit, 2 a screen, 3 a light and 4 a portal.
let companionAttractions = concat(
  map(galleryDisplays, display => {
    x: gallerySite[0] + display.x
    y: displayFloor(display) + displayExhibitDrop + (1.2 * displayExhibitScale)
    z: gallerySite[2] + display.z
    kind: 1
  }),
  [
    { x: brickPlayAt[0], y: 0.17, z: brickPlayAt[2], kind: 2 }
    { x: advancedPlayAt[0], y: 0.96, z: advancedPlayAt[2], kind: 2 }
    { x: deckPlayAt[0], y: 1.15, z: deckPlayAt[2], kind: 2 }
    { x: 11.2 + galleryWestShift, y: 1.35, z: 23.7, kind: 2 }
    { x: 11, y: 2.5, z: 35, kind: 3 }
    { x: 52.2, y: 1.65, z: 34.5, kind: 4 }
    { x: 68.5, y: 1.65, z: 34.5, kind: 4 }
    { x: 57, y: 1.65, z: 38.5, kind: 4 }
    { x: 64, y: 1.65, z: 38.5, kind: 4 }
  ]
)

companionDesign(
  population: (galleryPopulation + 2 + boardRoomBodies + cardBodies),
  interests: companionAttractions
)
// Her companion wears whichever kind of her roster is active (avatars/moth.puck's companionRoster).
companion(owner: 0, slot: companionBody, position: [-1.2, 1.52, 1], roster: true)
// The garden's obelisk teaches the Moth's companion sight (garden.puck); here it reaches farther once she carries it.
companionSight(owner: 0)
// It flies to whatever she locks onto, and to her group's pings (targeting.puck).
companionLock(owner: 0)
companionMarks(owner: 0, capacity: seatPopulation)

state {
  world [
    // The cue edges the gallery's sounds are heard at: the guide's spoken arrival and the lift's door.
    { name: "companionCue", kind: "Int", cells [{ key: "guide", value: -1 }, { key: "door", value: 1 }] }
  ]
}

// The guide's spoken arrival and the lift's moving door are authored cue edges. Their points use the same sensory
// input as a future in-world sound source, never an unrecorded hardware audio callback.
rule "companion-hears-guide" {
  when guideAt != companionCue.guide
  mode: Level
  companionCue.guide = guideAt
  companionSound.x = bodyPosition(body, 0, x)
  companionSound.y = bodyPosition(body, 0, y) + 1.7
  companionSound.z = bodyPosition(body, 0, z)
  companionSound.level = 1
  schedule companionSoundUntil in 0.4s
}
rule "companion-hears-door" {
  when liftDoors.car != companionCue.door
  mode: Level
  companionCue.door = liftDoors.car
  companionSound.x = 16
  companionSound.y = bodyPosition(body, 41, y) + 1.5
  companionSound.z = 36.4
  companionSound.level = 0.8
  schedule companionSoundUntil in 0.4s
}
