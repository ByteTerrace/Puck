// A physical chess table as a module library: 32 rigid piece bodies on a tabletop board, whose every settled arrangement
// is judged against the last legal board (the rules are ../games/chess.puck's), a one-ply computer opponent, and a seat
// that sits at the board and plays with the board page. The debug world stands one (chess.puck, `use physicalChessTable(…)`
// without an alias, so its rows keep their plain names); the stress world stands twelve (labs/board-games-stress.puck, each
// `use physicalChessTable as <id>(…)`, so every row, rule, placement and topology an instance declares is `<id>$<name>`
// and no table reads another's rows). chess.md says how to play a table, read its game and set its opponent.
//
// A world standing tables also:
//
//   - expands `physicalChessSet()` once at its top level: the pieces' and squares' prototypes, looks and kits, and the
//     colour rows their paints read, which every table shares, so twelve tables bake each piece once;
//   - declares the chess game's three vocabularies (`PieceKind`, `MoveKind`, `TurnColor`, ../games/chess.puck's header)
//     in its own `state` block, since a module cannot carry them;
//   - imports ../standard/inputs, whose `interact` channel the board's engage block reads;
//   - and reserves the table's 33 bodies (32 pieces and the board cursor) in its `bodies` capacity. Inhabitants number
//     from the top of the capacity down, the first inhabited placement highest, so a table's cursor stands above its
//     pieces and piece n is the cursor's body less n + 1.
//
// A piece's placement is `piece<n>`, piece n starting on `initialPieceCodes[n]`'s square (../games/chess.puck), and the
// game's rows key each piece by that same id: a roster's key names its placement, so an aliased instance's keys are
// qualified with its placements (`t0$piece4`), and the judge's `placement:$each` reads stay the table's own.
import "../standard/kits"
import "../standard/contexts/tabletop"
import "../games/chess"

let pieceTypes = ["pawn", "knight", "bishop", "rook", "queen", "king"]
let pieceLooks = concat(
  map(pieceTypes, kind => $"piece_white_{kind}"),
  map(pieceTypes, kind => $"piece_black_{kind}")
)

// The board reads as a real one from each side. The `chessBoard` grid is axis-aligned in the table's frame, cell =
// 8 * row + column, its rows running +Z and its columns +X; a rank is a row (rank 1 on the -Z side, White's), and a file
// runs the other way, column = 7 - file, so the a-file lies on +X. Seated at White's -Z edge and looking +Z, the
// camera's right is -X (forward crossed with up), so a1 is dark at White's left, h1 light at her right, and the queen on
// her colour (d1, light) left of the king; from Black's +Z edge a8 is light at Black's right and h8 dark at his left. The
// kings start in column 3 and the queens in column 4, so the castling rules name kingside by a falling column. Piece n
// stands on file n % 8 (piece 4 the white king on e1, piece 12 the e2 pawn), at column 7 - n % 8.
let boardCoords = [-0.7, -0.5, -0.3, -0.1, 0.1, 0.3, 0.5, 0.7]
let backRankTypes = ["rook", "knight", "bishop", "queen", "king", "bishop", "knight", "rook"]
// Cell (row, column) is light when row + column is even: column 0 of rank 1 is h1.
let squareTypes = ["boardSquareLight", "boardSquareDark"]

// A captured piece stands on the table's own margin (the top is 2 m across, the board 1.6 m, so a margin is 0.2 m wide),
// one column of 16 places 0.1 m apart per colour: White's along the -X margin (x -0.9 in the table's frame), Black's
// along the +X margin (0.9), each running +Z from -0.75 to 0.75. The offsets are from cell 0's centre (-0.7, -0.7).
let captureColumnX = [-0.2, 1.6]

template piecePlacement(name, prototypeName, x, z) {
  placement name {
    prototype: prototypeName
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "piece"
      look: prototypeName
      source: "Idle"
    }
    parent: "chessTable"
    position [x, 1.8, z]
  }
}

template pieceProto(color, name, sx, sy, sz) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v2"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        scale [sx, sy, sz]
      }
    }
  }
}

template crownedPieceProto(color, name, sx, sy, sz, csx, csy, csz, crownY) {
  prototype $"piece_{color}_{name}" {
    document {
      name: $"piece_{color}_{name}"
      palette [
        {
          color: $"state.pieceSetColors.{color}"
          roughness: 0.64
          specular: 0.25
        }
      ]
      schema: "puck.creation.v2"
      shape Capsule "body" {
        material: 0
        position [0, 0, 0]
        scale [sx, sy, sz]
      }
      shape Sphere "crown" {
        blend: "SmoothUnion"
        material: 0
        position [0, crownY, 0]
        scale [csx, csy, csz]
        smooth: 0.01
      }
    }
  }
}

template squareProto(name, colorKey) {
  prototype name {
    document {
      name: name
      palette [
        {
          color: $"state.boardColors.{colorKey}"
          roughness: 0.846
          specular: 0.05
        }
      ]
      schema: "puck.creation.v2"
      shape Box "square" {
        material: 0
        position [0, 0, 0]
        scale [0.095, 0.004, 0.095]
      }
    }
  }
}

// What every table of a world shares, expanded once at the world's top level: the looks, the pieces' and the cursor's
// kits, the prototypes of the table, the pieces, the squares and the cursor, and the colour rows their paints read.
template physicalChessSet() {
  looks: map(concat(pieceLooks, ["boardCursor"]), name => {
    motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
    name: name
    scale: 1
    source: creation(prototypeId: name)
  })

  pieceKit(
    name: "piece",
    collider: box(halfExtents: [0.045, 0.12, 0.045], rotation: [0, 0, 0, 1]),
    mass: 0.12,
    friction: 0.5,
    restitution: 0.1,
    rollingResistance: 0.0015
  )
  heldKit(name: "boardCursor")

  prototypes {
    prototype "chessTable" {
      document {
        name: "chessTable"
        palette [
          {
            color: "#8A6A45"
          }
        ]
        schema: "puck.creation.v2"
        shape Box "top" {
          material: 0
          position [0, 1.25, 0]
          scale [1, 0.05, 1]
        }

        // The pedestal stands on the floor 0.5 m under the creation's origin.
        shape Cylinder "leg" {
          material: 0
          position [0, 0.855, 0]
          scale [0.08, 0.355, 0.08]
        }

        shape Cylinder "foot" {
          material: 0
          position [0, 0.52, 0]
          scale [0.45, 0.02, 0.45]
        }
      }
    }

    for color in ["white", "black"] {
      pieceProto(color, "pawn", 0.035, 0.09, 0.035)
      pieceProto(color, "knight", 0.04, 0.12, 0.04)
      pieceProto(color, "bishop", 0.04, 0.15, 0.04)
      pieceProto(color, "rook", 0.05, 0.11, 0.05)
      crownedPieceProto(color, "queen", 0.045, 0.17, 0.045, 0.055, 0.055, 0.055, 0.203)
      crownedPieceProto(color, "king", 0.045, 0.19, 0.045, 0.06, 0.06, 0.06, 0.226)
    }

    squareProto("boardSquareLight", "light")
    squareProto("boardSquareDark", "dark")

    // A square's outline, one cell across: four flat bars around the square the cursor stands on.
    prototype "boardCursor" {
      document {
        name: "boardCursor"
        palette [
          {
            color: "state.boardColors.cursor"
            roughness: 0.4
            specular: 0.3
          }
        ]
        schema: "puck.creation.v2"
        shape Box "near" {
          material: 0
          position [0, 0, 0.088]
          scale [0.1, 0.004, 0.012]
        }
        shape Box "far" {
          material: 0
          position [0, 0, -0.088]
          scale [0.1, 0.004, 0.012]
        }
        shape Box "left" {
          material: 0
          position [0.088, 0, 0]
          scale [0.012, 0.004, 0.1]
        }
        shape Box "right" {
          material: 0
          position [-0.088, 0, 0]
          scale [0.012, 0.004, 0.1]
        }
      }
    }
  }

  state {
    world {
      table pieceSetColors {
        white = "#F2E9D8"
        black = "#2B2420"
      }

      table boardColors {
        light = "#F0D9B5"
        dark = "#8B5A2B"
        cursor = "#3FA9F5"
      }
    }
  }
}

// One table. `at` is the table's placement, its creation's floor 0.5 m over its origin; `settleTicks` the ticks the
// physics must stay at rest before an arrangement is judged; `scope` the bodies whose rest gates the judge (a replay
// scope, or by default the pieces' own roster, `pieceCode`); `search` the computer's search job, which a world standing
// several tables names apart, since a job's name is the search section's own, never an instance's. `demo` holds the
// computer and the doors off while the world's idle demonstration plays (chess.puck's `chessDemo`).
//
// `autoplay`, when given, has the computer play both sides from its own start: `{ start, stall, opening }` opens with
// White's move `opening` ([from, to] cells) through the move door the console's `chess.move` uses, once the board has
// first rested and `start` ticks have passed, then hands each side to the computer as its turn comes (`aiSide` follows
// `turn`). A game that passes no turn for `stall` ticks (a draw limit, a mate, an arrangement judged illegal) is set up
// afresh: every piece is posed back over its starting square and drops onto the board, and the game starts again.
module physicalChessTable(at, settleTicks = 9, scope = "pieceCode", search = "chessAI", demo = false, autoplay = null) {
  placements {
    // The table's top stands 0.8 m above the ground; its leg runs on below it.
    placement "chessTable" {
      prototype: "chessTable"
      board {
        move: "move"
        occupancy: "board"
        plan: "plan"
        topology: "chessBoard"
        turn: "turn"
        verdict: "verdict"
        // The context button within 2.5 m of the board's centre sits the seat down in the nearer chair, White's at the
        // -Z edge or Black's at the +Z edge, and the next press stands it up; seated, the camera looks down on the
        // board from the chair and the pointer picks squares on their tops, 6 cm above the board's frame.
        engage {
          channel: "interact"
          radius: 2.5
          pitch: 62
          margin: 0.12
          surface: 0.06
          seats [{ yawDegrees: 180 }, { yawDegrees: 0 }]
        }
      }
      position: at
      solid
    }

    // The square cursor a seated player moves, above the pieces in body order: the rules pose it on the cursor's square
    // while a seat sits at the table and park it inside the tabletop otherwise.
    placement "boardCursor" {
      prototype: "boardCursor"
      inhabit {
        count: 1
        distribution {
          fill {
            name: "additive"
            offset: 0
            step: 0.001
          }
          region: disc(radius: 0.01)
        }
        kit: "boardCursor"
        look: "boardCursor"
        source: "Idle"
      }
      parent: "chessTable"
      position [0, 1.25, 0]
    }

    for i in range(0, 8) {
      piecePlacement($"piece{i}", $"piece_white_{backRankTypes[i]}", boardCoords[7 - i], -0.7)
    }

    for i in range(0, 8) {
      piecePlacement($"piece{8 + i}", "piece_white_pawn", boardCoords[7 - i], -0.5)
    }

    for i in range(0, 8) {
      piecePlacement($"piece{16 + i}", "piece_black_pawn", boardCoords[7 - i], 0.5)
    }

    for i in range(0, 8) {
      piecePlacement($"piece{24 + i}", $"piece_black_{backRankTypes[i]}", boardCoords[7 - i], 0.7)
    }

    for r in range(0, 8) {
      for c in range(0, 8) {
        placement $"boardSquare-{r * 8 + c}" {
          prototype: squareTypes[(r + c) % 2]
          parent: "chessTable"
          position [boardCoords[c], 1.305, boardCoords[r]]
        }
      }
    }
  }

  chessJudge(settleTicks: settleTicks, scope: scope)

  // The idle demonstration holds the computer and the doors off while it plays. The hold is live bookkeeping, so a
  // search candidate never runs it: the computer's judge takes in every rule that writes a row its rules read, and
  // through `chessHold` this rule would draw in the demonstration's rules, which read the clock, so the search would
  // restart every tick and never answer.
  if demo {
    rule "chess-demo-hold" {
      when search(ply) == 0 and chessHold != chessDemo.playing
      mode: Level
      chessHold = chessDemo.playing
    }
  }

  // Self-play, each rule live bookkeeping a search candidate never runs (as the demonstration's hold above): the
  // opening through the move door, the side to move handed to the computer, the turns counted, and a stalled game set
  // up afresh.
  if autoplay != null {
    rule "chess-autoplay-open" {
      when (search(ply) == 0 and
        selfOpened == 0 and
        gameStarted == 1 and
        settleHold == settleTicks and
        $tick >= autoplay.start)
      mode: Level
      chessInput.from = autoplay.opening[0]
      chessInput.to = autoplay.opening[1]
      chessInput.request = 1
      selfOpened = 1
      selfDue = $tick + autoplay.stall
    }

    rule "chess-autoplay-side" {
      when search(ply) == 0 and selfOpened == 1 and aiSide != turn
      mode: Level
      aiSide = turn
    }

    rule "chess-autoplay-ply" {
      when search(ply) == 0 and turn != selfTurn
      mode: Level
      selfTurn = turn
      selfPlies += 1
      selfDue = $tick + autoplay.stall
    }

    for i in range(0, 32) {
      rule $"chess-autoplay-reset-{i}" {
        when search(ply) == 0 and selfOpened == 1 and $tick >= selfDue
        mode: Level
        poseCell(
          key: $"placement:piece{i}",
          topology: chessBoard,
          expression: pieceStartCell[$"piece{i}"],
          offset: [0, 0.3, 0]
        )
      }
    }

    rule "chess-autoplay-stalled" {
      when search(ply) == 0 and selfOpened == 1 and $tick >= selfDue
      mode: Level
      chessFresh.request = 1
      selfGames += 1
      selfOpened = 0
      selfTurn = 0
      aiSide = 1
    }

    chessFreshGame()
  }

  chessComputer(settleTicks: settleTicks)

  chessMoveDoor(settleTicks: settleTicks)

  for side in range(0, 2) {
    for slot in range(0, 16) {
      rule $"chess-ai-capture-{16 * side + slot}" {
        when ai.pending == 1 and pieceCell[$"piece{16 * side + slot}"] != (
            (aiBefore[$"piece{16 * side + slot}"] & 127) - 1
          ) and pieceCell[$"piece{16 * side + slot}"] < 0
        mode: Level
        poseCell(
          key: $"placement:piece{16 * side + slot}",
          topology: chessBoard,
          expression: 0,
          offset: [captureColumnX[side], 0.3, 0.1 * slot - 0.05]
        )
      }
    }
  }

  for i in range(0, 32) {
    rule $"chess-ai-place-{i}" {
      when (ai.pending == 1 and
        pieceCell[$"piece{i}"] != ((aiBefore[$"piece{i}"] & 127) - 1) and
        pieceCell[$"piece{i}"] >= 0)
      mode: Level
      poseCell(
        key: $"placement:piece{i}",
        topology: chessBoard,
        expression: pieceCell[$"piece{i}"],
        offset: [0, 0.08, 0]
      )
    }
  }

  chessMoveDone()

  // ---- Playing at the table ------------------------------------------------------------------------------------
  // A seat sits down with the context button (the board's engage block) and plays with the board page below: the cursor
  // follows the pointer, the movement keys, the d-pad or the stick, one square a press, up the board being away from the
  // side the seat sits on. The pick button lifts the side to move's piece under the cursor, which then hovers over the
  // cursor; the next press puts it down there, or a release away from the square it left does (a drag). Pressing on the
  // square it left, the cancel button or standing up puts it back. A put-down hands the move to the computer's own apply
  // path (ai[from], ai[to], ai[pending]): it stands a captured piece on the table margin, moves a castling rook, lifts
  // the pawn an en-passant capture takes and queens a pawn on the last rank, then the settled arrangement is judged as
  // ever. An arrangement judged illegal is put back as it stood before the put-down.

  // The seated seat's buttons this tick, each 1 while held past half way.
  rule "chess-play-buttons" {
    mode: Level
    for button in seatButtons {
      play[$"{button.name}Now"] = 0
    }
    for button in seatButtons {
      if seatHeld(board, button.channel, button.sign) {
        play[$"{button.name}Now"] = 1
      }
    }
  }

  // The press images: each binary is this tick's press on a rising edge, and each step is +1 or -1 on a rising edge.
  rule "chess-play-edges" {
    local pick = play.pickNow
    local cancel = play.cancelNow
    local ahead = play.aheadNow
    local behind = play.behindNow
    local rightward = play.rightNow
    local leftward = play.leftNow
    mode: Level
    play.pickEdge = pick & (play.pickDown == 0)
    play.releaseEdge = (pick == 0) and (play.pickDown == 1)
    play.cancelEdge = cancel & (play.cancelDown == 0)
    play.stepAhead = (ahead & (play.aheadDown == 0)) - (behind & (play.behindDown == 0))
    play.stepRight = (rightward & (play.rightDown == 0)) - (leftward & (play.leftDown == 0))
    play.pickDown = pick
    play.cancelDown = cancel
    play.aheadDown = ahead
    play.behindDown = behind
    play.rightDown = rightward
    play.leftDown = leftward
  }

  // The pointer moves the cursor whenever it moves onto another square.
  rule "chess-play-point" {
    local pointed = board(pointer, board, 1)
    when board(engaged, board, 1) == 1
    mode: Level
    if pointed >= 0 and pointed != play.pointer {
      play.cursor = pointed
    }
    play.pointer = pointed
  }

  // A step moves the cursor one square in the seat's own frame (the standard seat library's step): from White's chair
  // ahead is toward Black and right is toward the h-file.
  rule "chess-play-step" {
    when play.stepAhead or play.stepRight
    mode: Level
    play.cursor = seatStepCell(board, play.cursor, 8, 8, play.stepAhead, play.stepRight)
  }

  // A press lifts the side to move's piece under the cursor, once the board has rested and while no answer is moving.
  rule "chess-play-lift" {
    when play.pickEdge == 1 and play.held < 0 and putDown.judging == 0 and pieceCell[$each] == play.cursor and (
        pieceCode[$each] * (1 - 2 * turn)
      ) > 0 and aiSide != turn and ai.pending == 0 and settleHold == settleTicks
    mode: Level
    forEach: pieceCode
    // A firing holds a piece, which closes the gate for every later binding.
    maxFirings: 1
    play.held = pieceOrdinal[$each]
    play.from = play.cursor
    play.lifted = 1
  }

  // A put-down: a fresh press on another square, or the release of the lifting press away from the square the piece
  // left. A square holding a piece of the side to move takes nothing.
  rule "chess-play-put" {
    local press = (play.pickEdge == 1) and (play.lifted == 0)
    local drop = (play.releaseEdge == 1) and (play.lifted == 1)
    local open = (play.cursor != play.from) and (board[play.cursor] * (1 - 2 * turn) <= 0)
    when play.held >= 0 and (press or drop) and open and pieceOrdinal[$each] == play.held
    mode: Level
    forEach: pieceCode
    // The held piece is one ordinal, and a firing lets go of it.
    maxFirings: 1
    pieceCell[$each] = play.from
    ai.from = play.from
    ai.to = play.cursor
    ai.mover = pieceCode[$each]
    ai.pending = 1
    play.held = -1
    putDown.judging = 1
  }

  // The display door and the capture of what a put-down is judged against (../games/chess.puck), which the seated
  // player's put-down above and a game station's glass share.
  chessPutDown(settleTicks: settleTicks)

  // Putting the piece back: the cancel button, a press on the square it left, or standing up from the table.
  rule "chess-play-cancel" {
    local back = (play.pickEdge == 1) and (play.lifted == 0) and (play.cursor == play.from)
    when play.held >= 0 and (play.cancelEdge == 1 or back or board(engaged, board, 1) == 0)
    mode: Level
    play.returning = play.held
    play.held = -1
  }

  // While a piece is up the board is the seated player's: the game's display door takes no move (`chessPut`).
  rule "chess-play-grip" {
    local held = play.held >= 0
    when chessGrip != held
    mode: Level
    chessGrip = held
  }

  rule "chess-play-release" {
    when play.releaseEdge == 1
    mode: Level
    play.lifted = 0
  }

  // The verdict on a put-down: an illegal arrangement is put back as it stood before it, its pieces posed back below.
  chessPutJudged(settleTicks: settleTicks)

  for i in range(0, 32) {
    // The held piece hovers over the cursor, out of the board's band, so the board never rests while it is up.
    rule $"chess-play-hold-{i}" {
      when play.held == i
      mode: Level
      poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: play.cursor, offset: [0, 0.6, 0])
    }
    rule $"chess-play-return-{i}" {
      when play.returning == i
      mode: Level
      poseCell(key: $"placement:piece{i}", topology: chessBoard, expression: play.from, offset: [0, 0.3, 0])
    }
    rule $"chess-play-revert-{i}" {
      when putDown.revert == 1 and putBefore[$"piece{i}"] >= 0 and pieceCell[$"piece{i}"] != putBefore[$"piece{i}"]
      mode: Level
      poseCell(
        key: $"placement:piece{i}",
        topology: chessBoard,
        expression: putBefore[$"piece{i}"],
        offset: [0, 0.3, 0]
      )
    }
  }

  rule "chess-play-settled" {
    mode: Level
    play.returning = -1
  }

  chessPutSettled()

  // The cursor stands on its square while a seat sits at the table, and rests inside the tabletop otherwise.
  rule "chess-play-cursor-shown" {
    when board(engaged, board, 1) == 1
    mode: Level
    poseCell(key: `placement:boardCursor`, topology: chessBoard, expression: play.cursor, offset: [0, 0.066, 0])
  }

  rule "chess-play-cursor-parked" {
    when board(engaged, board, 1) == 0
    mode: Level
    poseCell(key: `placement:boardCursor`, topology: chessBoard, expression: play.cursor, offset: [0, 0, 0])
  }

  chessSearch(name: search)

  state {
    chessBoardGrid(cellSize: 0.2, origin: [-0.8, 1.25, -0.8], band: 0.3)

    world {
      chessGameState(settleTicks: settleTicks)

      // The seat at the table: the cursor's square, the piece it holds (its ordinal, -1 for none) and the square it
      // left, the last pointed square, this tick's presses (the *Edge and step keys) and last tick's buttons (*Down),
      // whether the held piece was lifted by the press still down, and the piece being put back this tick. A put-down's
      // verdict and an arrangement being restored are the library's `putDown` (../games/chess.puck).
      table play capacity(auto) {
        cursor = 11
        held = -1
        from = -1
        pointer = -1
        pickNow = 0
        cancelNow = 0
        aheadNow = 0
        behindNow = 0
        rightNow = 0
        leftNow = 0
        pickEdge = 0
        releaseEdge = 0
        cancelEdge = 0
        stepAhead = 0
        stepRight = 0
        pickDown = 0
        cancelDown = 0
        aheadDown = 0
        behindDown = 0
        rightDown = 0
        leftDown = 0
        lifted = 0
        returning = -1
      }

      // Self-play's bookkeeping: whether this game has opened, the turn last counted, the tick a game that passes no
      // turn by is stalled, and the turns and games played.
      if autoplay != null {
        slot selfOpened = 0 bounds(0..1)
        slot selfTurn = 0 bounds(0..1)
        slot selfDue = 0
        slot selfPlies = 0
        slot selfGames = 0
      }
    }
  }
}
