// The debug world's named places and the console command that goes to them. Each place is a spawn point a few metres
// from one of the world's features, standing so the seat's chase camera, which keeps its place behind the body, frames
// the feature beside her rather than behind her; `debug.go <place>` poses a body there and hands the view back to that
// camera, so one line reaches any feature from anywhere. The debug world imports this file whole, and
// debug.md beside it lists the places. The painting wing's own places (painting-room, portals, portal-garden,
// portal-night, portal-city, portal-link, portal-fall) are authored beside the paintings (paintings.puck), and
// the valley's (overlook, glacier, valley-<sector>) beside the valley (valley.puck).
//
// `debug.go` is an authored command: a `commands` row composing existing verbs, which the console answers beside the
// engine's own (help, help --names, a binding row or wheel sector naming it). It runs each line under the caller's
// own authority, as though the caller had typed it.
//
// The world's rooms and areas are regions here too: each `place-*` placement below carries a region facet, a box over
// a room, a corridor or an area of the valley floor, drawing nothing. `body.place` names the regions a body stands in,
// innermost first, so a scripted walk or the benchmark reads which room it is in from the world's own documents; rules
// read the same occupancy as `$region:place-<name>`. A box is a centre and half-extents. The gallery's rooms are given
// in the building's frame and stand under its root placement (gallery/layout.puck, gallery.md): a level's rooms reach
// from half a metre under its floor to the underside of the slab above. The valley's are world coordinates. Nested
// places list smallest first: a display's guide region (guide.puck) inside the nave, inside the gallery's level 0,
// inside the hall, inside the valley.

import "shapes"
import "gallery/layout"
import "../standard/place"
import "labs/lab-kit"
import "../standard/game-station"

// One storey's room box: x and z spans and a level index, from 0.5 m under the level's floor to the slab above.
function storeyPlace(name, level, x0, x1, z0, z1) = {
  id: name
  at [((x0 + x1) / 2), (galleryFloor[level] + 1.6), ((z0 + z1) / 2)]
  half [((x1 - x0) / 2), 2.1, ((z1 - z0) / 2)]
}
// An area of open ground: x and z spans, from 1 m under the floor to 4 m over it.
function groundPlace(name, x0, x1, z0, z1) = {
  id: name
  at [((x0 + x1) / 2), 1.5, ((z0 + z1) / 2)]
  half [((x1 - x0) / 2), 2.5, ((z1 - z0) / 2)]
}

// The gallery's places, in the building's frame.
let galleryPlaces = concat(
  [
    // The building as one, its forecourt's doorway outside and in, and the lobby inside the entrance.
    {
      id: "hall"
      at [(galleryWidth / 2), 9.2, ((wingSouth + galleryDepth) / 2)]
      half [(galleryWidth / 2), 9.7, ((galleryDepth - wingSouth) / 2)]
    }
    { id: "hall-entrance", at [((entranceWest + entranceEast) / 2), 1.5, 0], half [3, 2, 2.5] }
    storeyPlace("lobby", 0, wingWest, courtWest, galleryWall, naveSouth)
    // Level 0: the nave between its arcades, the north aisle behind the north one, the west hall under the bridge
    // (the map of the lobby's old furniture: the desktop, the press, the painting into Wonderland), and the painting
    // wing east of the lobby (paintings.puck).
    storeyPlace("nave", 0, naveWest, galleryEast, naveSouth, naveNorth)
    // The lab wing's stretch of the north aisle (lab-wing.puck), from its first door's bay to its last's.
    storeyPlace(
      "lab-wing",
      0,
      pierX(minimum(map(labWingPlan, lab => lab.bay))),
      pierX((maximum(map(labWingPlan, lab => lab.bay)) + 1)),
      naveNorth,
      galleryNorth
    )
    storeyPlace("north-aisle", 0, galleryWestIn, galleryEast, naveNorth, galleryNorth)
    storeyPlace("west-hall", 0, galleryWestIn, naveWest, galleryWall, naveNorth)
    storeyPlace("painting-room", 0, courtWest, galleryEast, galleryWall, naveSouth)
    // Before each painting of the wing: the looping pair facing each other across the east court, the garden, the
    // night field and the city on the south wall, and the endless fall in the floor, its column up to the ceiling twin.
    storeyPlace("loop-portal-west", 0, (courtFin + galleryWall), ((courtFin + galleryWall) + 2), 1.2, 3.6)
    storeyPlace("loop-portal-east", 0, (courtStairFin - 2), courtStairFin, 1.2, 3.6)
    storeyPlace("garden-painting", 0, 33.2, 35.6, galleryWall, 2.3)
    storeyPlace("night-painting", 0, 36.8, 39.2, galleryWall, 2.3)
    storeyPlace("city-painting", 0, 40.4, 42.8, galleryWall, 2.3)
    { id: "endless-fall", at [fallPlan[0], 1.6, fallPlan[1]], half [1.5, 2.6, 1.5] }
    // The west wall: the desktop computer before it, the typesetter's bench south of that (press.puck), and the big
    // painting into Wonderland (wonderland.puck).
    storeyPlace("desktop", 0, galleryWestIn, (galleryWestIn + 3), 10.4, 13)
    storeyPlace("press", 0, galleryWestIn, (galleryWestIn + 4.2), 5.4, 9.6)
    storeyPlace("wonderland-threshold", 0, galleryWestIn, (galleryWestIn + 2), 17, 20)
    // The south-west stair's well (`stairs`), each corner stair's (`stairs-<corner>`) and the lift's tower, every storey.
    {
      id: "stairs"
      at [stairCentreX(galleryStair("south-west")), 9.2, stairCentreZ(galleryStair("south-west"))]
      half [2.7, 9.7, 3.2]
    }
    for stair in galleryStairs {
      {
        id: $"stairs-{stair.id}"
        at [stairCentreX(stair), 9.2, stairCentreZ(stair)]
        half [(((stair.well.x1 - stair.well.x0) / 2) + 0.2), 9.7, ((stair.well.z1 - stair.well.z0) / 2)]
      }
    }
    { id: "lift", at [liftX, 9.2, liftZ], half [1.7, 9.7, 1.9] }
    // The board game room: level 2's south gallery and the wing that projects over the forecourt.
    storeyPlace("board-room", wingLevel, wingWest, galleryEast, (wingSouth + galleryWall), naveSouth)
    // The climbing wall (gallery/climbing-wall.puck): the column of the nave over its pad and up its face to the ledge,
    // and its top, the ledge and the doorway behind it onto level 3, which a climb reaches only by its mantle.
    {
      id: "climbing-wall"
      at [climbWallX, ((galleryFloor[0] + climbWallTop) / 2), ((climbWallFace - climbWallPad.depth) + naveNorth) / 2]
      half [
        (climbWallPad.width / 2),
        (((climbWallTop - galleryFloor[0]) / 2) + 0.5),
        ((naveNorth - (climbWallFace - climbWallPad.depth)) / 2)
      ]
    }
    storeyPlace(
      "climbing-wall-top",
      climbWallLevel,
      (climbWallX - 2.2),
      (climbWallX + 2.2),
      climbWallFace,
      climbWallLanding[2]
    )
  ],
  // Each gallery level whole, and the lift landing before the tower's door on it.
  map(
    range(0, 4),
    level => storeyPlace(
      $"gallery-level-{level}",
      level,
      galleryWestIn,
      galleryEast,
      (wingSouth + galleryWall),
      galleryNorth
    )
  ),
  map(
    range(0, 4),
    level => storeyPlace($"lift-landing-{level}", level, (towerWest + 0.2), (towerEast - 0.2), galleryWall, 3.4)
  )
)

// The valley's places, in world coordinates.
let regionPlaces = [
  // The caldera's floor out to the walls' feet (valley.puck).
  { id: "valley", at [0, 10, 0], half [232, 60, 232] }
  // The spawn's open ground.
  groundPlace("stage", -6, 6, -6, 6)
  // Wonderland: the room beyond the gallery's west wall, the device row along its west side, and the mouse hole in
  // its east wall back to the gallery.
  { id: "wonderland", at [(5.2 + galleryWestShift), 2, 29], half [4.5, 2.5, 5.3] }
  { id: "machines", at [(4.8 + galleryWestShift), 2, 30.5], half [4.1, 2.5, 3] }
  { id: "mouse-hole", at [(8.9 + galleryWestShift), 1, 30.5], half [0.5, 1.5, 1] }
  // The valley floor's places (valley.puck lists what stands where).
  groundPlace("studio", 24, 72, -80, -24)
  groundPlace("camera-course", -26, -13, 16, 44)
  groundPlace("pool", -66, -46, -22, -2)
  groundPlace("meadow", 90, 140, -85, -35)
  groundPlace("forest", -95, 110, -190, -88)
  groundPlace("range", -106, -88, -52, 118)
]

placements {
  for place in galleryPlaces {
    placement $"place-{place.id}" {
      prototype: "place"
      parent: "gallery"
      position: place.at
      region {
        halfExtents: place.half
      }
    }
  }
  for place in regionPlaces {
    placement $"place-{place.id}" {
      prototype: "place"
      position: place.at
      region {
        halfExtents: place.half
      }
    }
  }
}


spawnPoints [
  // In Wonderland (wonderland.puck), 2.3 m in front of the deck's television on the west wall (devices.puck), facing
  // it, with the Advanced Brick on her right and the Humble Brick on her left: posed here, she keeps whatever size she
  // was.
  { id: "devices", position [(4 + galleryWestShift), 0.05, 30.5], yawDegrees: 90 }
  // At the near chair of the gallery's game station (gallery/games.puck), White's side of its holodeck chess board,
  // inside its engage radius: the context button sits her down. The board game room's tables have places of their own
  // beside them (go.puck, reversi.puck, alchemy.puck, granaries.puck), and the room's own place is `boardroom`
  // (gallery/gallery.puck).
  { id: "chess", position: gameStationChairAt(galleryGameStations[0], "near"), yawDegrees: 180 }
  // Behind the chair at the desktop computer against the gallery's west wall (desktop.puck), facing its monitor, inside
  // the screen's engage radius.
  { id: "desktop", position [(12.4 + galleryWestShift), 0.05, 23.7], yawDegrees: 90 }
  // On the nave's floor 2.5 m before the climbing wall's pad (gallery/climbing-wall.puck), between the displays either
  // side of it and facing the wall, in the building's frame: walk on and she takes the face.
  {
    id: "climbing-wall"
    parent: gallery
    position [climbWallX, galleryFloor[0], ((climbWallFace - climbWallPad.depth) - 2.5)]
    yawDegrees: 180
  }
  // On the valley floor in line with the gallery's entrance, 32 m south of it and 4 m short of the avatar studio's north
  // wall (studio.puck, world z -24), facing it: the benchmark's valley seam (benchmark-route.puck) starts here and walks
  // into the lobby. The gallery's own places (`gallery`, outside its entrance; `lift`; `stairs`) are the module's
  // (gallery/gallery.puck).
  { id: "seam-valley", position: galleryWorld(((entranceWest + entranceEast) / 2), 0.05, -32), yawDegrees: 180 }
]

commands [
  goCommand(
    help: "Poses a body at one of the debug world's places (stage, devices, boardroom, chess, go, reversi, alchemy, granaries, cards, auction, shedding, deduction, skirmish, desktop, climbing-wall, painting-room, portals, portal-garden, portal-night, portal-city, portal-link, portal-fall, lab-wing, lab-<lab> before each lab's door, gallery, wonderland, the camera tests lift, stairs, camera-course, camera-tunnel, camera-colonnade and camera-bays, the valley's overlook, glacier and valley-<sector> floor spots, the pool, forest and forest-inside, or any spawn point) and returns the view to the play layout's chase camera.",
    home: "stage"
  )
]
