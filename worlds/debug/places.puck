// The debug world's named places and the console command that goes to them. Each place is a spawn point a few metres
// from one of the world's features, facing it; `debug.go <place>` poses a body there and hands the view back to the
// seat's chase camera, so one line reaches any feature from anywhere. The debug world imports this file whole, and
// debug.md beside it lists the places.
//
// `debug.go` is an authored command: a `commands` row composing existing verbs, which the console answers beside the
// engine's own (help, help --names, a binding row or wheel sector naming it). It runs each line under the caller's
// own authority, as though the caller had typed it.

spawnPoints [
  // Five metres in front of the device row's middle plinth (devices.puck), its screens facing this way.
  { id: "devices", position [-13, 0, -1], yawDegrees: 0 }
  // Four and a half metres from the chess table's centre (chess.puck), on Black's side.
  { id: "chess", position [-6, 0, -7.5], yawDegrees: 0 }
  // Five metres short of the loop shaft's floor glass (loop.puck); walk ahead to drop in.
  { id: "loop", position [-20, 0, -15], yawDegrees: 0 }
  // Five metres in front of the wall screen (desktop.puck).
  { id: "screen", position [8, 0, -3], yawDegrees: 0 }
  // The shape gallery's near corner (shapes.puck), facing up its rows; the first row's labels face this way.
  { id: "gallery", position [14, 0, 9], yawDegrees: 180 }
]

commands [
  {
    name: "debug.go"
    help: "Poses a body at one of the debug world's places (stage, devices, chess, loop, screen, gallery, or any spawn point) and returns the view to the play layout's chase camera."
    parameters [
      { name: "place", kind: Spawn, default: "stage" }
      { name: "body", kind: Body, default: "0" }
    ]
    lines [
      "body.pose spawn:{place} {body}"
      "view.override camera auto"
      "view.override layout play"
    ]
  }
]
