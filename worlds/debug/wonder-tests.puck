// Level 1's size (gallery/wonder.puck), each scenario booted in the whole debug world: `puck test
// worlds/debug/wonder-tests.puck --reproduce`. A body's size is a function of where it stands: Alice's (look.puck's
// `lookWonderSize`, 0.15) on level 1, following its height over a corner stair's flights and in the lift's shaft, and
// full wherever it holds the `wonderPass` identity fact. At Alice's size a toybox cabinet's screen stands out of her
// engage reach, and at full size within it.
//
// Positions are world coordinates with the building at layout.puck's `gallerySite` (9.825, 0, 12.575). The south-west
// stair's half landings stand 2.25 m over levels 0 and 1, so a body on one is halfway up its flight and takes the
// geometric mean of full size and Alice's, the square root of 0.15 (0.387). The first toybox cabinet (screen 20) stands
// at (34.5, 4.55, 16.0), facing north; a body 1.2 m before it is within a full body's 3 m reach and far outside a small
// one's 0.45 m. The scenarios spell the shortcuts by what they run (gallery.go toybox poses at `spawn:toybox`, and
// gallery.wonder pass on writes `wonderpass`, whose `on` is 2), since a test step takes no authored command.

schema: "puck.world.definition.v1"
basis: "debug"
// Keep same-world portals in this fixture's boot instance instead of opening another live debug world.
documentId: "debug"
import "stopped-machines"

test "level 1 makes her Alice's size" {
  when {
    seat1: body.pose spawn:toybox 0
    ticks 10
  }
  expect {
    bodyPosition(body, 0, y) > 4.5
    bodyState(body, 0, size) == 0.15
  }
}

test "halfway up the stair from level 0 she is halfway to Alice's size" {
  when {
    seat1: body.pose spawn:stairs 0
    ticks 20
  }
  expect {
    bodyState(body, 0, size) > 0.37
    bodyState(body, 0, size) < 0.40
  }
}

test "halfway down the stair from level 2 she is halfway to Alice's size, and grows back at the flight's foot on level 0" {
  when {
    seat1: body.pose spawn:toybox 0
    ticks 10
    seat1: body.pose 10.475 7.0 13.875 0 0 0 0
    ticks 20
    seat1: body.pose 8.875 0.3 19.025 0 0 0 0
    ticks 20
  }
  expect {
    bodyState(body, 0, size) > 0.85
  }
}

test "on the upper flight her size follows her height" {
  when {
    seat1: body.pose 10.475 7.0 13.875 0 0 0 0
    ticks 20
  }
  expect {
    bodyState(body, 0, size) > 0.37
    bodyState(body, 0, size) < 0.40
  }
}

test "the lift's ride to level 1 shrinks her, and the ride on to level 2 grows her" {
  when {
    seat1: body.pose spawn:lift 0
    ticks 30
    seat1: world.state.cell.set liftCall $value 1
    ticks 200
  }
  expect {
    liftLevel == 1
    bodyState(body, 0, size) == 0.15
  }
}

test "the lift's ride on to level 2 grows her again" {
  when {
    seat1: body.pose spawn:lift 0
    ticks 30
    seat1: world.state.cell.set liftCall $value 1
    ticks 200
    seat1: world.state.cell.set liftCall $value 2
    ticks 200
  }
  expect {
    liftLevel == 2
    bodyState(body, 0, size) == 1
  }
}

test "the pass keeps her full size on level 1" {
  when {
    seat1: world.state.cell.set wonderpass 0 2
    ticks 2
    seat1: body.pose spawn:toybox 0
    ticks 10
  }
  expect {
    bodyState(body, 0, size) == 1
  }
}

test "small, a toybox cabinet's screen is out of her reach" {
  when {
    seat1: body.pose 34.5 4.6 17.2 0 0 0 0
    ticks 10
    seat1: body.engage 20
    ticks 5
  }
  expect {
    bodyState(body, 0, size) == 0.15
    engaged(body, 0, 20) == 0
  }
}

test "with the pass she reaches a toybox cabinet's screen" {
  when {
    seat1: world.state.cell.set wonderpass 0 2
    ticks 2
    seat1: body.pose 34.5 4.6 17.2 0 0 0 0
    ticks 10
    seat1: body.engage 20
    ticks 5
  }
  expect {
    bodyState(body, 0, size) == 1
    engaged(body, 0, 20) == 1
  }
}
