    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $ops) (i32.const 3) (i64.extend_i32_u (local.get $key)) (select (i64.const 6) (i64.const 5) (local.get $eject)) (i64.const 16) (i32.const 701)))
