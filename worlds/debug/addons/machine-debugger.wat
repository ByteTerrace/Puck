  (func $readOperation (param $eject i32) (local $key i32)
    (local.set $key (select (i32.const 36972) (i32.const 36979) (local.get $eject)))
    (i32.store8 (i32.add (local.get $key) (select (i32.const 5) (i32.const 4) (local.get $eject))) (i32.add (i32.const 48) (i32.wrap_i64 (call $cfg (i32.const 1)))))
