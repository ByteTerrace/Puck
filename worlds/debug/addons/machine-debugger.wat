;; Generic machine debugger. Authored source; no imports or compiled companion.
;; Configuration, input encoding, phases and verdicts are documented in ../addons.md.
;; Rings: 0x1000 output, 0x2000 input, 0x3000 correlation tags. Configuration 0x3200,
;; baseline/first-run hash traces 0x4000/0x4800 (240 samples each), JSON 0x6000,
;; operation text 0x7000. All execution and host work use the mounted fuel budget.
(module
  (memory (export "memory") 1)
  (data (i32.const 0x100)
    "\01\00\06\00\00\02\00\00\00\00\00\00\00\00\00\00"
    "\02\00\0b\00\00\00\00\00\00\00\00\00\00\00\00\00"
    "\03\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00")
  (data (i32.const 0x200) "\07forward\06strafe\04jump\06flight\05start\06select")
  (global $out (mut i32) (i32.const 0))
  (global $phase (mut i32) (i32.const 0))
  (global $cfgHandle (mut i32) (i32.const 0))
  (global $mutate (mut i32) (i32.const 0))
  (global $observe (mut i32) (i32.const 0))
  (global $control (mut i32) (i32.const 0))
  (global $drive (mut i32) (i32.const 0))
