    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36942) (i64.const 8) (i64.const -1) (i32.const 117)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36951) (i64.const 6) (i64.const -1) (i32.const 118)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36958) (i64.const 6) (i64.const -1) (i32.const 119)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36965) (i64.const 6) (i64.const -1) (i32.const 120)))
