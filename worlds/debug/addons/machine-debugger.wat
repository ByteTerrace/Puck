  (global $trace1 (mut i64) (i64.const 0))
  (global $trace2 (mut i64) (i64.const 0))
  (global $violations (mut i64) (i64.const 0))
  (global $firstViolation (mut i64) (i64.const -1))
  (global $lastViolation (mut i64) (i64.const -1))
  (func (export "puck_abi_version") (result i32) (i32.const 1))
  (func (export "puck_out_ptr") (result i32) (i32.const 4096))
  (func (export "puck_out_cap") (result i32) (i32.const 32))
  (func (export "puck_in_ptr") (result i32) (i32.const 8192))
  (func (export "puck_in_cap") (result i32) (i32.const 64))
  (func (export "puck_channels_ptr") (result i32) (i32.const 256))
  (func (export "puck_channels_count") (result i32) (i32.const 3))

  (func $cfg (param $i i32) (result i64) (i64.load (i32.add (i32.const 12800) (i32.shl (local.get $i) (i32.const 3)))))
  (func $emit (param $kind i32) (param $channel i32) (param $handle i32) (param $verb i32)
      (param $a i64) (param $b i64) (param $c i64) (param $tag i32) (result i32)
    (local $at i32) (local $n i32)
    (local.set $n (global.get $out))
    (local.set $at (i32.add (i32.const 4096) (i32.shl (local.get $n) (i32.const 5))))
    (i32.store8 (local.get $at) (local.get $kind))
    (i32.store8 offset=1 (local.get $at) (local.get $channel))
    ;; Stored handles are biased by one: index 0, generation 0 is a valid handle, not absence.
    (i32.store offset=2 (local.get $at) (select (i32.sub (local.get $handle) (i32.const 1)) (local.get $handle) (i32.eq (local.get $kind) (i32.const 1))))
    (i32.store16 offset=6 (local.get $at) (local.get $verb))
    (i64.store offset=8 (local.get $at) (local.get $a))
    (i64.store offset=16 (local.get $at) (local.get $b))
    (i64.store offset=24 (local.get $at) (local.get $c))
    (i32.store (i32.add (i32.const 12288) (i32.shl (local.get $n) (i32.const 2))) (local.get $tag))
    (global.set $out (i32.add (local.get $n) (i32.const 1))) (local.get $n))
  (func $puts (param $at i32)
    (block $done (loop $next
      (br_if $done (i32.eqz (i32.load8_u (local.get $at))))
      (i32.store8 (global.get $cursor) (i32.load8_u (local.get $at)))
      (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
      (local.set $at (i32.add (local.get $at) (i32.const 1))) (br $next))))
  (func $int (param $v i64)
    (local $at i32)
    (if (i64.lt_s (local.get $v) (i64.const 0)) (then
      (i32.store8 (global.get $cursor) (i32.const 45)) (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
      (local.set $v (i64.sub (i64.const 0) (local.get $v)))))
    (local.set $at (i32.const 24560))
    (loop $digits
      (local.set $at (i32.sub (local.get $at) (i32.const 1)))
      (i32.store8 (local.get $at) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10)))))
      (local.set $v (i64.div_u (local.get $v) (i64.const 10))) (br_if $digits (i64.ne (local.get $v) (i64.const 0))))
    (memory.copy (global.get $cursor) (local.get $at) (i32.sub (i32.const 24560) (local.get $at)))
    (global.set $cursor (i32.add (global.get $cursor) (i32.sub (i32.const 24560) (local.get $at)))) )
  (func $verdict (param $value i32) (result i32)
    (if (i32.lt_s (local.get $value) (i32.const 0)) (then
      (global.set $violations (i64.add (global.get $violations) (i64.const 1)))
      (global.set $lastViolation (i64.sub (global.get $tick) (i64.const 1)))
      (if (i64.lt_s (global.get $firstViolation) (i64.const 0)) (then (global.set $firstViolation (global.get $lastViolation))))))
    (global.set $dirty (i32.const 1)) (local.get $value))
  ;; Pcg32XshRr, stream 0: the same multiplier, odd increment, seeding and output transform as Puck.Maths.
  (func $random (result i32) (local $old i64) (local $x i32)
    (local.set $old (global.get $rng))
    (global.set $rng (i64.add (i64.mul (local.get $old) (i64.const 6364136223846793005)) (i64.const 1)))
    (local.set $x (i32.wrap_i64 (i64.shr_u (i64.xor (i64.shr_u (local.get $old) (i64.const 18)) (local.get $old)) (i64.const 27))))
    (i32.rotr (local.get $x) (i32.wrap_i64 (i64.shr_u (local.get $old) (i64.const 59)))))
  (func $seed
    (global.set $rng (i64.const 1)) (global.set $rng (i64.add (global.get $rng) (call $cfg (i32.const 5)))) (drop (call $random)))
  (func $program (param $n i32) (result i32) (local $i i32) (local $v i64) (local $duration i32)
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (i32.const 8)))
      (local.set $v (call $cfg (i32.add (i32.const 9) (local.get $i))))
      (local.set $duration (i32.wrap_i64 (i64.shr_u (local.get $v) (i64.const 8))))
      (if (i32.lt_u (local.get $n) (local.get $duration)) (then (return (i32.and (i32.wrap_i64 (local.get $v)) (i32.const 255)))))
      (local.set $n (i32.sub (local.get $n) (local.get $duration)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (global.set $programDone (i32.const 1)) (i32.const 0))
  (func $pad (param $mask i32) (local $x i64) (local $y i64)
    (local.set $x (i64.mul (i64.const 65536) (i64.sub (i64.extend_i32_u (i32.ne (i32.and (local.get $mask) (i32.const 16)) (i32.const 0)))
      (i64.extend_i32_u (i32.ne (i32.and (local.get $mask) (i32.const 32)) (i32.const 0))))))
    (local.set $y (i64.mul (i64.const 65536) (i64.sub (i64.extend_i32_u (i32.ne (i32.and (local.get $mask) (i32.const 64)) (i32.const 0)))
      (i64.extend_i32_u (i32.ne (i32.and (local.get $mask) (i32.const 128)) (i32.const 0))))))

    (drop (call $emit (i32.const 1) (i32.const 0) (global.get $drive) (i32.const 0) (local.get $y) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $emit (i32.const 1) (i32.const 0) (global.get $drive) (i32.const 4) (local.get $x) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $emit (i32.const 1) (i32.const 0) (global.get $drive) (i32.const 8) (select (i64.const 65536) (i64.const 0) (i32.and (local.get $mask) (i32.const 1))) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $emit (i32.const 1) (i32.const 0) (global.get $drive) (i32.const 12) (select (i64.const 65536) (i64.const 0) (i32.and (local.get $mask) (i32.const 2))) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $emit (i32.const 1) (i32.const 0) (global.get $drive) (i32.const 16) (select (i64.const 65536) (i64.const 0) (i32.and (local.get $mask) (i32.const 4))) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $emit (i32.const 1) (i32.const 0) (global.get $drive) (i32.const 20) (select (i64.const 65536) (i64.const 0) (i32.and (local.get $mask) (i32.const 8))) (i64.const 0) (i64.const 0) (i32.const 0)))
  )
  (func $hashQuery (drop (call $emit (i32.const 1) (i32.const 1) (global.get $observe) (i32.const 5) (call $cfg (i32.const 7)) (call $cfg (i32.const 8)) (i64.const 0) (i32.const 500))))
  (func $snapshot (param $op i64) (drop (call $emit (i32.const 1) (i32.const 1) (global.get $control) (i32.const 6) (local.get $op) (i64.const 0) (i64.const 0) (i32.const 501))) (call $hashQuery))
  (func $statusQuery (drop (call $emit (i32.const 1) (i32.const 1) (global.get $observe) (i32.const 10) (i64.const 0) (i64.const 0) (i64.const 0) (i32.const 502))))
  (func $loadConfig

    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36864) (i64.const 3) (i64.const -1) (i32.const 100)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36868) (i64.const 6) (i64.const -1) (i32.const 101)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36875) (i64.const 4) (i64.const -1) (i32.const 102)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36880) (i64.const 6) (i64.const -1) (i32.const 103)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36887) (i64.const 4) (i64.const -1) (i32.const 104)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36892) (i64.const 4) (i64.const -1) (i32.const 105)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36897) (i64.const 5) (i64.const -1) (i32.const 106)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36903) (i64.const 7) (i64.const -1) (i32.const 107)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36911) (i64.const 6) (i64.const -1) (i32.const 108)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36918) (i64.const 2) (i64.const -1) (i32.const 109)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36921) (i64.const 2) (i64.const -1) (i32.const 110)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36924) (i64.const 2) (i64.const -1) (i32.const 111)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36927) (i64.const 2) (i64.const -1) (i32.const 112)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36930) (i64.const 2) (i64.const -1) (i32.const 113)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36933) (i64.const 2) (i64.const -1) (i32.const 114)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $cfgHandle) (i32.const 3) (i64.const 36936) (i64.const 2) (i64.const -1) (i32.const 115)))
