    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $ops) (i32.const 3) (i64.extend_i32_u (local.get $key)) (select (i64.const 6) (i64.const 5) (local.get $eject)) (i64.const 48) (i32.const 703)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $ops) (i32.const 3) (i64.extend_i32_u (local.get $key)) (select (i64.const 6) (i64.const 5) (local.get $eject)) (i64.const 64) (i32.const 704)))
    (drop (call $emit (i32.const 1) (i32.const 1) (global.get $ops) (i32.const 3) (i64.extend_i32_u (local.get $key)) (select (i64.const 6) (i64.const 5) (local.get $eject)) (i64.const 80) (i32.const 705)))
