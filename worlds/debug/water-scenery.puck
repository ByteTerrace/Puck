// What the water looks like in the debug world, from the standard's scenery (../standard/water.puck): the falls and the
// glacier on the north-west wall, the lake in its bowl on the rim, the stream from the falls' foot to the pool, and the
// stone bridge over it. Everything here is a look bound to the gauges water.puck keeps: the glacier contracts about its
// cradle as the melt clock runs, the lake rises and falls with its level, the falls park when the melt runs dry. The
// stream and the falls stand still; their shading flows (the standard's flow layers).
import "../standard/water"
import "valley-form"
import "water-site"

let compassRadians = 3.141592653589793 / 180

// The wall's own sector frame: a placement of yaw (compass + 180) turns the creation's +Z out from the ring's centre.
let wallYaw = wallSector.compass + 180

// The glacier contracts about its cradle's centre, following the authored linear melt fraction.
let glacierOrigin = [0, 300, sectorFace(wallSector, 300)]
let glacierLateral = [-30, -16, -2, 12, 26, 40]
let glacierHeights = [300, 309, 316, 308, 298, 292]
let glacierLumps = map(range(0, 6), i => {
  position [glacierLateral[i], glacierHeights[i], sectorFace(wallSector, glacierHeights[i]) - 6]
  radii [12 + (i % 3) * 2, 8 + (i % 2) * 2, 9]
})

// The stream leaves the falls' foot, 205 m from the centre toward compass 315, and runs in legs, each a bearing from compass
// north: it winds east then south to the pool's north bank. Every leg is a placement of one 24 m segment; a shorter leg
// ends where it should and starts back along the leg before it.
let streamLegs = [
  { bearing: 100, length: 24 }
  { bearing: 120, length: 24 }
  { bearing: 140, length: 24 }
  { bearing: 164, length: 24 }
  { bearing: 188, length: 24 }
  { bearing: 171, length: 24 }
  { bearing: 154, length: 24 }
  { bearing: 154, length: 18 }
]
// The length of the one stream segment every leg places.
let streamSegmentLength = 24
// A leg's start point, and where its segment is centred: half a segment back from the leg's end.
function legStart(i) = [
  -143 + reduce(range(0, i), 0, (sum, k) => sum + sine(streamLegs[k].bearing * compassRadians) * streamLegs[k].length),
  144 + reduce(range(0, i), 0, (sum, k) => sum + cosine(streamLegs[k].bearing * compassRadians) * streamLegs[k].length)
]
function legCentre(i) = [
  legStart(i)[0] + sine(streamLegs[i].bearing * compassRadians) * (streamLegs[i].length - streamSegmentLength / 2),
  legStart(i)[1] + cosine(streamLegs[i].bearing * compassRadians) * (streamLegs[i].length - streamSegmentLength / 2)
]

// The bridge crosses the stream at the start of the fifth leg, its length across the flow.
let bridgeLeg = 5

prototypes {
  fallsRibbon(id: "falls", profile: fallsProfile, width: 8, standoff: 8)
  glacierMass(id: "glacier", lumps: glacierLumps, origin: glacierOrigin)
  lakeSurface(id: "lake", radius: lakeSite.radius)
  streamSegment(id: "stream", length: streamSegmentLength)
  stoneBridge(id: "bridge")
  floatGauge(id: "reservoir-gauge", height: 1.8)
  waterBasin(id: "plunge-basin", half: [10, 10], floorY: -2.4)
  waterBasin(id: "reservoir-basin", half: [5, 6], floorY: -1.9, stepTops: [], openings: [{ position [5, -1.3, 0], half [0.6, 0.6, 1] }])
  waterBasin(id: "reservoir-passage", half: [1.2, 1], floorY: -1.9, rimY: -0.7, stepTops: [], openings: [{ position [-1.35, -1.3, 0], half [0.6, 0.6, 1] }, { position [1.35, -1.3, 0], half [0.6, 0.6, 1] }])
  reservoirPavilion(id: "reservoir-pavilion")
  impactSpray(id: "falls-spray")
}

placements {
  placement "falls" {
    prototype: "falls"
    position [0, 0, 0]
    yawDegrees: wallYaw
  }
  placement "glacier" {
    prototype: "glacier"
    position [
      glacierOrigin[2] * sine(wallSector.compass * compassRadians),
      glacierOrigin[1],
      glacierOrigin[2] * cosine(wallSector.compass * compassRadians)
    ]
    yawDegrees: wallYaw
  }
  placement "lake" {
    prototype: "lake"
    position [
      lakeSite.radial * sine(wallSector.compass * compassRadians),
      lakeSite.surface,
      lakeSite.radial * cosine(wallSector.compass * compassRadians)
    ]
  }
  // Alternate legs ride 2 cm higher, so the overlapping ends at each bend never share a plane.
  for (leg, i) in streamLegs {
    placement $"stream-{i}" {
      prototype: "stream"
      position [legCentre(i)[0], (i % 2) * 0.02, legCentre(i)[1]]
      yawDegrees: leg.bearing + 180
    }
  }
  // The reservoir's float gauge beside the pool's steps, its ticks facing the path: the aquifer's fill read off the bank.
  placement "reservoir-gauge" {
    prototype: "reservoir-gauge"
    position [-35, -1.9, -18]
    yawDegrees: 270
  }
  placement "plunge-basin" {
    prototype: "plunge-basin"
    position [-143, 0, 144]
    solid
  }
  placement "falls-spray" {
    prototype: "falls-spray"
    position [-143, 1.5, 144]
  }
  placement "reservoir-basin" {
    prototype: "reservoir-basin"
    position [-39, 0, -18]
    solid
  }
  placement "reservoir-passage" {
    prototype: "reservoir-passage"
    position [-45, 0, -18]
    solid
  }
  placement "reservoir-pavilion" {
    prototype: "reservoir-pavilion"
    position [-39, 0, -18]
    solid
  }
  placement "bridge" {
    prototype: "bridge"
    position [legStart(bridgeLeg)[0], 0, legStart(bridgeLeg)[1]]
    yawDegrees: streamLegs[bridgeLeg].bearing + 90 + 180
    solid
  }
}

waterViews(views: [
  { name: "reservoir-passage", rowName: "passageWater", gauge: "aquiferFill", hole [-46, -19, -44, -17], floorY: -1.9, initial: 0, maximumDepth: 1, heightScale: 1.8, cell: 0.5 }
  { name: "plunge", rowName: "plungeWater", gauge: "poolLevel", hole: plungeHole, floorY: -2.4, initial: 1.65, maximumDepth: 2.35, heightScale: 1, cell: 1 }
  { name: "reservoir", rowName: "reservoirWater", gauge: "aquiferFill", hole: reservoirHole, floorY: -1.9, initial: 0, maximumDepth: 1, heightScale: 1.8, cell: 1 }
])