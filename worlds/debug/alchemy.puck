import "elements"
import "inputs"
import "shapes"

// Physical Alchemy at the board room's north-east table on level 2 (hall.puck): 31 element tokens, four starters (Air,
// Earth, Fire, Water), a cauldron with two hand wells (left and right), and a lectern recipe-book screen showing
// discoveries, open hints and the latest mix. The debug world imports this file whole. The table stands east of the Go
// table, its workbench centred at (65, 9.905, 30.6) on level 2. alchemy.md beside this file says how to play, read the
// book and reset the table.
//
// Each element is an ordinal in the Element enum: Nothing is 0, Air is 1, and House, the last, is 31. A recipe is an
// unordered pair stored once, smaller element first, in cell minimum(a, b) * 32 + maximum(a, b) of the 32x32 `pairs`
// grid. Bit `e` of `known` is set when element `e` is discovered. When both hands (`left` and `right`) hold elements,
// `mix` looks up their pair if both are known (discovering a new result on first sight, or counting a fizzle when the
// cell holds Nothing), while `refuse-unknown` refuses the pair if either hand holds an undiscovered element. Either
// way, both hands empty for the next pair.
//
// Over the rules lies the tabletop layer (`alchemyGrid`, 8 columns by 5 rows of 0.14 m cells): cells 1 to 31 hold the 31
// element tokens in ordinal order (starters discovered-face up, undiscovered elements sealed-face up), cell 0 resets a
// partial hand, and row 4 holds the cauldron between the left hand well (cell 34) and right hand well (cell 37). A
// seated player moves the cursor across the grid and picks two elements with confirm; a player moving physical tokens
// drops them into the hand wells, and once the table settles for `alchemySettleTicks` the rules read the wells, run the
// mix, flip newly discovered tokens face-up on their shelf cells, and return displaced tokens home.

let alchemyTable = [65, 8.55, 30.6]
let alchemySettleTicks = 9
let alchemyColumns = 8
let alchemyRows = 5
let alchemyCells = (alchemyColumns * alchemyRows)
let alchemyCellSize = 0.14
let alchemySurface = 1.355
let alchemyOriginX = (0 - ((alchemyColumns * alchemyCellSize) / 2))
let alchemyOriginZ = (0 - ((alchemyRows * alchemyCellSize) / 2))
let alchemyLeftCell = 34
let alchemyRightCell = 37

let alchemyWoodColor = "#8A6A45"
let alchemySlateColor = "#141816"
let alchemyIronColor = "#24282E"
let alchemyBrassColor = "#D6A13E"
let alchemyBrewColor = "#38E08C"
let alchemyLecternColor = "#3E2B1D"
let alchemyIvoryColor = "#F7E7B4"
let alchemyCursorColor = "#3FA9F5"
let alchemyBookInkColor = "#F4E8C8"
let alchemyBookPaperColor = "#231A14"

// House is the last Element member.
let size = (House + 1)
let totalElements = House
let starters = [Air, Earth, Fire, Water]
let starterCount = length(starters)
let initialKnown = reduce(starters, 0, (mask, e) => (mask | (1 << e)))

// [first, second, makes]. Some results have several recipes, so a stuck player has more than one way on.
let recipes = [
  [Fire, Water, Steam]
  [Earth, Water, Mud]
  [Earth, Fire, Lava]
  [Air, Earth, Dust]
  [Air, Fire, Energy]
  [Air, Steam, Cloud]
  [Cloud, Water, Rain]
  [Water, Water, Sea]
  [Lava, Water, Stone]
  [Air, Lava, Stone]
  [Air, Stone, Sand]
  [Fire, Sand, Glass]
  [Lightning, Sand, Glass]
  [Fire, Stone, Metal]
  [Earth, Rain, Plant]
  [Mud, Plant, Swamp]
  [Energy, Swamp, Life]
  [Energy, Sea, Life]
  [Lightning, Swamp, Life]
  [Cloud, Energy, Lightning]
  [Earth, Plant, Tree]
  [Metal, Tree, Wood]
  [Fire, Plant, Ash]
  [Fire, Wood, Ash]
  [Life, Swamp, Bacteria]
  [Earth, Life, Animal]
  [Life, Sea, Fish]
  [Air, Animal, Bird]
  [Mud, Sand, Clay]
  [Clay, Life, Human]
  [Human, Metal, Tool]
  [Tool, Wood, House]
]

let elementIds = range(1, totalElements)
let alchemyTokenHomeColumn = map(elementIds, e => (e % alchemyColumns))
let alchemyTokenHomeRow = map(elementIds, e => ((e - (e % alchemyColumns)) / alchemyColumns))
let alchemyOpening = map(range(0, alchemyCells), i => ((i >= 1) and (i <= starterCount)) ? 1 : 0)

// The bodies: debug.puck imports this file ahead of Go and Reversi, so its cursor and 31 element tokens take the top 32
// slots (`shapes.puck`'s `alchemyBodies`): `alchemyCursor` is `alchemyTop` and `alchemyToken{e}` is `alchemyTop - e`.
let alchemyTop = ((galleryPopulation + 2 + boardRoomBodies) - 1)
grants: map(
  range(0, totalElements),
  i => { capability: Drive, grantee: "seat1", subject: $"body:{alchemyTop - 1 - i}" }
)

looks: map(["alchemyToken", "alchemyCursor"], name => {
  motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
  name: name
  scale: 1
  source: creation(prototypeId: name)
})

kits [
  {
    bodyContact: Solid
    bodyMotionProgram: "walk"
    collider: box(halfExtents: [0.048, 0.014, 0.048], rotation: [0, 0, 0, 1])
    motion {
      facingSnap: true
      holds [
        {
          bond: Free
          envelope {
            sinkSpeed: 40
          }
          gravity {
            fall: 46
            rise: 28
          }
          hold: Gravity
          name: "air"
        }
      ]
      shaping [
        {
          along {}
        }
      ]
      speed {
        value: 0.001
      }
      turn {
        rate: 0.001
      }
    }
    name: "alchemyToken"
    rigid {
      angularDamping: 0.05
      friction: 0.6
      linearDamping: 0.05
      mass: 0.04
      restitution: 0.05
      rollingFriction: 0.2
    }
  }
]

placements {
  placement "alchemyTable" {
    prototype: "alchemyTable"
    board {
      occupancy: "alchemyBoard"
      topology: "alchemyGrid"
      turn: "alchemyTurn"
      verdict: "alchemyVerdict"
      engage {
        channel: "interact"
        radius: 2.5
        pitch: 62
        margin: 0.12
        surface: 0.02
      }
    }
    position: alchemyTable
    solid
  }

  placement "alchemyShelf" {
    prototype: "alchemyShelf"
    parent: "alchemyTable"
    position [0, 0, 0]
  }

  placement "alchemyCauldron" {
    prototype: "alchemyCauldron"
    parent: "alchemyTable"
    position [0, 0, 0]
  }

  placement "alchemyCursor" {
    prototype: "alchemyCursor"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "boardCursor"
      look: "alchemyCursor"
      source: "Idle"
    }
    parent: "alchemyTable"
    position [0, 1.33, 0]
  }

  // Each element token starts 6 cm over its shelf cell: starters discovered-face up, the rest sealed-face up.
  for e in elementIds {
    placement $"alchemyToken{e}" {
      prototype: "alchemyToken"
      inhabit {
        count: 1
        distribution {
          fill {
            name: "additive"
            offset: 0
            step: 0.001
          }
          region: disc(radius: 0.01)
        }
        kit: "alchemyToken"
        look: "alchemyToken"
        source: "Idle"
      }
      parent: "alchemyTable"
      position [
        (alchemyOriginX + (alchemyCellSize * (alchemyTokenHomeColumn[(e - 1)] + 0.5))),
        (alchemySurface + 0.06),
        (alchemyOriginZ + (alchemyCellSize * (alchemyTokenHomeRow[(e - 1)] + 0.5)))
      ]
    }
  }
}

// The recipe book on the lectern at the north (+Z) edge of the table, tilted back 30 degrees toward the seated player.
screens [
  {
    index: 7
    origin [alchemyTable[0], (alchemyTable[1] + 1.592), (alchemyTable[2] + 0.58)]
    right [-1, 0, 0]
    up [0, 0.866025, 0.5]
    halfWidth: 0.35
    halfHeight: 0.19
    halfDepth: 0.004
    round: 0
    luminance: 180nit
    source: text(
      columns: 30,
      rows: 8,
      foreground: alchemyBookInkColor,
      background: alchemyBookPaperColor,
      lines: [
        "ALCHEMY RECIPE BOOK"
        "FOUND   {state.discovered}/31"
        "HINTS   {state.hints}"
        "LEFT    {state.left}"
        "RIGHT   {state.right}"
        "MADE    {state.made}"
        "NEWEST  {state.newest}"
        "DONE    {state.complete}"
      ]
    )
    route {
      engageable: false
      engageRadius: 0
    }
  }
]

spawnPoints [
  { id: "alchemy", position [alchemyTable[0], galleryFloor[2], (alchemyTable[2] - 1.6)], yawDegrees: 180 }
]

