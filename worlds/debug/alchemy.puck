// ---- Reading the physical table ----------------------------------------------------------------------------------
// Whenever the physics has rested for `alchemySettleTicks`, the rules read each token's cell and face off the board. A
// token dropped into the left hand well (cell 34) or right hand well (cell 37) loads that hand and triggers a sync back
// to its shelf cell; any other displacement or collision is counted as illegal and synced back.

rule "alchemy-settle-hold-advance" {
  when physics(quiescent) == 1 and alchemyHold < alchemySettleTicks
  mode: Level
  alchemyHold += 1
}

rule "alchemy-settle-hold-reset" {
  when physics(quiescent) != 1
  mode: Level
  alchemyHold = 0
}

rules "" when alchemyHold == alchemySettleTicks {
  mode: "Edge"
  rule "alchemy-read-tokens" {
    local square = board(cellOf, alchemyBoard, placement, $each)
    local home = alchemyElement[$each]
    local face = upright(placement, $each) >= 0 ? 1 : 0
    forEach: alchemyElement
    alchemyCell[$each] = square >= 0 ? square : -home
    alchemyFace[$each] = face
    alchemyStray[$each] = ((square != home) and (square != alchemyLeftCell) and (square != alchemyRightCell)) ? 1 : 0
  }

  rule "alchemy-read-board" {
    alchemyCollisions = count(alchemyCell, atLeast: 0, atMost: 39) - count(alchemySeen, c -> c != 0)
    alchemyMisplaced = count(alchemyStray, c -> c != 0)
  }

  rule "alchemy-read-hands" {
    when alchemyCollisions == 0 and alchemyMisplaced == 0 and (alchemySeen[alchemyLeftCell] > 0 or
        alchemySeen[alchemyRightCell] > 0)
    if alchemySeen[alchemyLeftCell] > 0 {
      left = alchemySeen[alchemyLeftCell]
    }
    if alchemySeen[alchemyRightCell] > 0 {
      right = alchemySeen[alchemyRightCell]
    }
    alchemySync = 1
  }

  rule "alchemy-read-illegal" {
    when alchemyCollisions > 0 or alchemyMisplaced > 0
    alchemyIllegal += 1
    alchemyVerdict = 0
    alchemySync = 1
  }
}

// ---- Seated play at the table ------------------------------------------------------------------------------------
// Seat 1 sits down with the context button (the board's engage block) and plays with the shared tabletop page
// (chess.puck): moving the cursor across the 8x5 grid and pressing confirm on two elements in a row loads `left` then
// `right`. Pressing cancel (or confirm on cell 0) clears a partial hand.

rule "alchemy-seat-presses" {
  mode: Level
  if board(engaged, alchemyBoard, 1) == 1 and channel(1, confirm) >= 0.5 {
    alchemySeat.pickEdge = alchemySeat.pickDown == 0
    alchemySeat.pickDown = 1
  } else {
    alchemySeat.pickEdge = 0
    alchemySeat.pickDown = 0
  }
  if board(engaged, alchemyBoard, 1) == 1 and channel(1, cancel) >= 0.5 {
    alchemySeat.cancelEdge = alchemySeat.cancelDown == 0
    alchemySeat.cancelDown = 1
  } else {
    alchemySeat.cancelEdge = 0
    alchemySeat.cancelDown = 0
  }
  if board(engaged, alchemyBoard, 1) == 1 and channel(1, forward) >= 0.5 {
    alchemySeat.aheadEdge = alchemySeat.aheadDown == 0
    alchemySeat.aheadDown = 1
  } else {
    alchemySeat.aheadEdge = 0
    alchemySeat.aheadDown = 0
  }
  if board(engaged, alchemyBoard, 1) == 1 and channel(1, forward) <= -0.5 {
    alchemySeat.behindEdge = alchemySeat.behindDown == 0
    alchemySeat.behindDown = 1
  } else {
    alchemySeat.behindEdge = 0
    alchemySeat.behindDown = 0
  }
  if board(engaged, alchemyBoard, 1) == 1 and channel(1, strafe) >= 0.5 {
    alchemySeat.rightEdge = alchemySeat.rightDown == 0
    alchemySeat.rightDown = 1
  } else {
    alchemySeat.rightEdge = 0
    alchemySeat.rightDown = 0
  }
  if board(engaged, alchemyBoard, 1) == 1 and channel(1, strafe) <= -0.5 {
    alchemySeat.leftEdge = alchemySeat.leftDown == 0
    alchemySeat.leftDown = 1
  } else {
    alchemySeat.leftEdge = 0
    alchemySeat.leftDown = 0
  }
}

rule "alchemy-seat-point" {
  local pointed = board(pointer, alchemyBoard, 1)
  when board(engaged, alchemyBoard, 1) == 1
  mode: Level
  if pointed >= 0 and pointed != alchemySeat.pointer {
    alchemySeat.cursor = pointed
  }
  alchemySeat.pointer = pointed
}

rule "alchemy-seat-step" {
  local seatSide = board(side, alchemyBoard, 1)
  local cursorColumn = (
    alchemySeat.cursor % alchemyColumns +
    (alchemySeat.aheadEdge - alchemySeat.behindEdge) * (seatSide == 3 ? 1 : seatSide == 1 ? -1 : 0) +
    (alchemySeat.rightEdge - alchemySeat.leftEdge) * (seatSide == 2 ? 1 : seatSide == 0 ? -1 : 0)
  )
  local cursorRow = (
    alchemySeat.cursor / alchemyColumns +
    (alchemySeat.aheadEdge - alchemySeat.behindEdge) * (seatSide == 0 ? 1 : seatSide == 2 ? -1 : 0) +
    (alchemySeat.rightEdge - alchemySeat.leftEdge) * (seatSide == 3 ? 1 : seatSide == 1 ? -1 : 0)
  )
  when (alchemySeat.aheadEdge - alchemySeat.behindEdge) or (alchemySeat.rightEdge - alchemySeat.leftEdge)
  mode: Level
  alchemySeat.cursor = (
    clamp(cursorRow, 0, alchemyRows - 1) * alchemyColumns + clamp(cursorColumn, 0, alchemyColumns - 1)
  )
}

rule "alchemy-seat-cancel" {
  when board(engaged, alchemyBoard, 1) == 1 and alchemySeat.cancelEdge == 1
  mode: Level
  left = Nothing
  right = Nothing
}

rule "alchemy-seat-pick" {
  when board(engaged, alchemyBoard, 1) == 1 and alchemySeat.pickEdge == 1
  mode: Level
  if alchemySeat.cursor == 0 {
    left = Nothing
    right = Nothing
  }
  if alchemySeat.cursor >= 1 and alchemySeat.cursor <= totalElements and left != Nothing and right == Nothing {
    right = alchemySeat.cursor
  }
  if alchemySeat.cursor >= 1 and alchemySeat.cursor <= totalElements and left == Nothing {
    left = alchemySeat.cursor
  }
}

rule "alchemy-seat-cursor-shown" {
  when board(engaged, alchemyBoard, 1) == 1
  mode: Level
  poseCell(
    key: `placement:alchemyCursor`,
    topology: alchemyGrid,
    expression: alchemySeat.cursor,
    offset: [0, 0.004, 0]
  )
}

rule "alchemy-seat-cursor-parked" {
  when board(engaged, alchemyBoard, 1) == 0
  mode: Level
  poseCell(
    key: `placement:alchemyCursor`,
    topology: alchemyGrid,
    expression: alchemySeat.cursor,
    offset: [0, -0.035, 0]
  )
}

// ---- The rules of Alchemy ----------------------------------------------------------------------------------------

rule "mix" {
  local result = recipe[minimum(left, right) * size + maximum(left, right)]
  local isNew = (result != Nothing) * (1 - ((known >> result) & 1))
  when left != Nothing and right != Nothing and ((known >> left) & (known >> right) & 1) == 1
  mode: Level
  if result == Nothing {
    fizzles += 1
  } else if isNew == 1 {
    known = known | (1 << result)
    newest = result
    alchemyBoard[result] = 1
    alchemySync = 1
  }
  made = result
  fresh = isNew
  mixes += 1
  alchemyVerdict = (result != Nothing) ? 1 : 0
  discovered = setBitCount(known)
  complete = setBitCount(known) == size - 1
  left = Nothing
  right = Nothing
}

rule "refuse-unknown" {
  when left != Nothing and right != Nothing and ((known >> left) & (known >> right) & 1) == 0
  mode: Level
  refused += 1
  made = Nothing
  fresh = 0
  alchemyVerdict = 0
  left = Nothing
  right = Nothing
}

rule "count-hints" {
  when hintsFor != known
  mode: Level
  hints = 0
  for r in recipes {
    hints += ((known >> r[0]) & (known >> r[1]) & 1) * (1 - ((known >> r[2]) & 1))
  }
  hintsFor = known
}

// ---- Keeping the table to the book -------------------------------------------------------------------------------

rule "alchemy-reset" {
  when alchemyReset == 1
  mode: Level
  transform boardCombine(row: alchemyBoard, operation: Copy, left: alchemyStart)
  known = initialKnown
  discovered = starterCount
  left = Nothing
  right = Nothing
  made = Nothing
  newest = Nothing
  fresh = 0
  hints = 0
  hintsFor = 0
  mixes = 0
  fizzles = 0
  refused = 0
  complete = 0
  alchemyVerdict = 1
  alchemySync = 1
  alchemyReset = 0
}

rule "alchemy-sync-discovered" {
  when alchemySync == 1 and alchemyBoard[alchemyElement[$each]] == 1 and (alchemyCell[$each] != alchemyElement[$each] or
      alchemyFace[$each] != 1)
  mode: Level
  forEach: alchemyElement
  poseCell(
    key: `placement:$each`,
    topology: alchemyGrid,
    expression: alchemyElement[$each],
    offset: [0, 0.05, 0]
  )
  alchemyCell[$each] = alchemyElement[$each]
  alchemyFace[$each] = 1
}

rule "alchemy-sync-locked" {
  when alchemySync == 1 and alchemyBoard[alchemyElement[$each]] == 0 and (alchemyCell[$each] != alchemyElement[$each] or
      alchemyFace[$each])
  mode: Level
  forEach: alchemyElement
  poseCell(
    key: `placement:$each`,
    topology: alchemyGrid,
    expression: alchemyElement[$each],
    offset: [0, 0.05, 0],
    rollDegrees: 180
  )
  alchemyCell[$each] = alchemyElement[$each]
  alchemyFace[$each] = 0
}

rule "alchemy-sync-done" {
  when alchemySync == 1
  mode: Level
  alchemySync = 0
}

commands [
  {
    name: "alchemy.reset"
    help: "Resets the Alchemy table and recipe book to the four starter elements (Air, Earth, Fire, Water)."
    lines [
      "world.state.cell.set alchemyReset $value 1"
    ]
  }
  {
    name: "alchemy.mix"
    help: "Places two elements into the Alchemy cauldron's left and right hands so the next tick mixes them."
    parameters [
      {
        name: "first"
        kind: Choice
        values: map(elementIds, e => alchemyElementStyles[e].name)
        default: "Fire"
      }
      {
        name: "second"
        kind: Choice
        values: map(elementIds, e => alchemyElementStyles[e].name)
        default: "Water"
      }
    ]
    lines [
      "world.state.cell.set left $value {first}"
      "world.state.cell.set right $value {second}"
    ]
  }
]

state {
  enum Element {
    Nothing
    Air
    Earth
    Fire
    Water
    Steam
    Mud
    Lava
    Dust
    Energy
    Cloud
    Rain
    Sea
    Stone
    Sand
    Glass
    Metal
    Plant
    Swamp
    Life
    Lightning
    Tree
    Wood
    Ash
    Bacteria
    Animal
    Fish
    Bird
    Clay
    Human
    Tool
    House
  }

  lattices [
    grid(name: "pairs", origin: [0, 0, 0], cellSize: 1, width: size, depth: size, wrap: None)
    grid(name: "elements", origin: [0, 0, 0], cellSize: 1, width: size, depth: 1, wrap: None)
    grid(
      band: 0.11,
      cellSize: alchemyCellSize,
      depth: alchemyRows,
      width: alchemyColumns,
      origin: [alchemyOriginX, alchemySurface, alchemyOriginZ],
      name: "alchemyGrid",
      wrap: None
    )
  ]

  world {
    row {
      name: "recipe"
      kind: "Int"
      enum: Element
      domain: cellsOf(topology: pairs)
      cells: map(
        recipes,
        r => {
          key: $"{minimum(r[0], r[1]) * size + maximum(r[0], r[1])}"
          value: r[2]
        }
      )
    }

    // 1 for an element no recipe takes as an ingredient: discovering it opens nothing new.
    row {
      name: "final"
      kind: "Int"
      domain: cellsOf(topology: elements)
      cells: map(
        range(1, size - 1),
        e => {
          key: $"{e}"
          value: length(filter(recipes, r => (r[0] == e) + (r[1] == e))) == 0
        }
      )
    }

    slot known = initialKnown
    slot discovered = starterCount bounds(0..size - 1)

    // The two hands, the last mix's result, and the newest discovery.
    slot left: Element = Nothing
    slot right: Element = Nothing
    slot made: Element = Nothing
    slot newest: Element = Nothing

    // 1 when the last mix discovered what it made.
    slot fresh = 0 bounds(0..1)

    // Recipes whose ingredients are known and whose result is not: how many ways forward remain.
    slot hints = 0 bounds(0..)

    // The `known` the hint count was last taken over.
    slot hintsFor = 0

    slot mixes = 0 bounds(0..)
    slot fizzles = 0 bounds(0..)
    slot refused = 0 bounds(0..)
    slot complete = 0 bounds(0..1)

    // The tabletop board over `alchemyGrid`: cell `e` (1..31) holds 1 once element `e` is discovered and 0 while it
    // remains sealed.
    row {
      name: "alchemyBoard"
      kind: "Int"
      capacity: alchemyCells
      min: 0
      max: 1
      domain: cellsOf(topology: alchemyGrid)
      cells: map(range(0, alchemyCells), i => { key: $"{i}", value: alchemyOpening[i] })
    }
    row {
      name: "alchemyStart"
      kind: "Int"
      capacity: alchemyCells
      min: 0
      max: 1
      domain: cellsOf(topology: alchemyGrid)
      cells: map(range(0, alchemyCells), i => { key: $"{i}", value: alchemyOpening[i] })
    }
    row {
      name: "alchemySeen"
      kind: "Int"
      capacity: alchemyCells
      min: 0
      max: totalElements
      domain: cellsOf(topology: alchemyGrid)
      inverse {
        tokens: "alchemyCell"
        codes: "alchemyElement"
      }
    }

    row {
      name: "alchemyElement"
      kind: "Int"
      capacity: totalElements
      min: 1
      max: totalElements
      cells: map(elementIds, e => { key: $"alchemyToken{e}", value: e })
    }
    row {
      name: "alchemyFace"
      kind: "Int"
      capacity: totalElements
      min: 0
      max: 1
      cells: map(elementIds, e => { key: $"alchemyToken{e}", value: 1 })
    }
    row {
      name: "alchemyCell"
      kind: "Int"
      capacity: totalElements
      min: (-1 - totalElements)
      max: (alchemyCells - 1)
      cells: map(elementIds, e => { key: $"alchemyToken{e}", value: e })
    }
    row {
      name: "alchemyStray"
      kind: "Int"
      capacity: totalElements
      min: 0
      max: 1
      cells: map(elementIds, e => { key: $"alchemyToken{e}", value: 0 })
    }

    slot alchemyTurn = 1 bounds(0..1)
    slot alchemyVerdict = 1 bounds(0..1)
    slot alchemyHold = 0 bounds(0..alchemySettleTicks)
    slot alchemyCollisions = 0 bounds(0..totalElements)
    slot alchemyMisplaced = 0 bounds(0..totalElements)
    slot alchemyIllegal = 0 bounds(0..50400)
    slot alchemySync = 1 bounds(0..1)
    slot alchemyReset = 0 bounds(0..1)

    table alchemySeat {
      cursor = 1
      pointer = -1
      pickEdge = 0
      cancelEdge = 0
      aheadEdge = 0
      behindEdge = 0
      rightEdge = 0
      leftEdge = 0
      pickDown = 0
      cancelDown = 0
      aheadDown = 0
      behindDown = 0
      rightDown = 0
      leftDown = 0
    }
  }
}
