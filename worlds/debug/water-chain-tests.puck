// The water's whole arc over the chain alone, the inner loop of the scenario in `water-arc.puck`: the debug world's
// numbers (`water-chain.puck`) with nothing around them, so the 3 h run takes seconds. `water-arc-tests.puck` runs the same
// scenario on the debug world.
schema: "puck.world.definition.v1"
basis: "water-chain"
documentId: "water-chain-tests"
import "water-arc"
test "the water arc: glacier, lake at its sill, falls, aquifer, river" {
  when {
    ticks 405040
  }
  expect {
    // The glacier against (1 - t/T)^3 at each eighth: 1, 0.670, 0.422, 0.244, 0.125, 0.053, 0.016, 0.002, 0.
    glacierAt[0] > 0.99
    glacierAt[1] > 0.66 and glacierAt[1] < 0.68
    glacierAt[2] > 0.41 and glacierAt[2] < 0.43
    glacierAt[3] > 0.235 and glacierAt[3] < 0.255
    glacierAt[4] > 0.12 and glacierAt[4] < 0.13
    glacierAt[5] > 0.045 and glacierAt[5] < 0.06
    glacierAt[6] > 0.01 and glacierAt[6] < 0.02
    glacierAt[7] > 0.0 and glacierAt[7] < 0.005
    glacierAt[8] == 0
    // The falls carry the melt as it melts: the discharge over the sill is the fraction of the melt's peak, (1 - t/T)^2 at
    // each eighth within a thirtieth (0.766, 0.563, 0.391, 0.25, 0.141, 0.063, 0.016), still running at 7T/8, and dry
    // (under 0.01) at T and every reading after, the first of them a quarter hour after T.
    fallsAt[0] > 0.95
    (fallsAt[1] - 0.766) < 0.03 and (0.766 - fallsAt[1]) < 0.03
    (fallsAt[2] - 0.563) < 0.03 and (0.563 - fallsAt[2]) < 0.03
    (fallsAt[3] - 0.391) < 0.03 and (0.391 - fallsAt[3]) < 0.03
    (fallsAt[4] - 0.25) < 0.03 and (0.25 - fallsAt[4]) < 0.03
    (fallsAt[5] - 0.141) < 0.03 and (0.141 - fallsAt[5]) < 0.03
    (fallsAt[6] - 0.063) < 0.03 and (0.063 - fallsAt[6]) < 0.03
    fallsAt[7] > 0.005
    fallsAt[8] < 0.01 and fallsAt[9] < 0.01 and fallsAt[10] < 0.01 and fallsAt[11] < 0.01
    // The lake stands within a few centimetres of its sill (0.4 m of water) from the first reading to the last, and rests on
    // it once the melt has ended.
    lakeAt[0] > 0.399 and lakeAt[1] > 0.399 and lakeAt[2] > 0.399 and lakeAt[3] > 0.399 and lakeAt[4] > 0.399 and lakeAt[5] > 0.399
    lakeAt[6] > 0.399 and lakeAt[7] > 0.399 and lakeAt[8] > 0.399 and lakeAt[9] > 0.399 and lakeAt[10] > 0.399 and lakeAt[11] > 0.399
    lakeAt[0] < 0.5 and lakeAt[1] < 0.5 and lakeAt[2] < 0.5
    lakeAt[8] < 0.401 and lakeAt[9] < 0.401 and lakeAt[10] < 0.401 and lakeAt[11] < 0.401
    // The aquifer fills over the melt, is full by 3T/4 while the falls still run, and holds full after it.
    aquiferAt[0] < aquiferAt[1] and aquiferAt[1] < aquiferAt[2] and aquiferAt[2] < aquiferAt[3] and aquiferAt[3] < aquiferAt[4] and aquiferAt[4] < aquiferAt[5]
    aquiferAt[6] >= 0.95
    aquiferAt[11] > 0.999
    // Its cells are capped, so the river takes what the melt still sends and rises past the head the aquifer holds (the
    // river's bed at 1 m plus 0.6 m of water is the aquifer's full head of 1.6 m).
    riverAt[8] > riverAt[6]
    riverAt[11] > 0.6
    // The river is settled by T + 15 min: its drift over the quarter hours ending at T + 30 and T + 45 min stays under 5 mm.
    (riverAt[10] - riverAt[9]) < 0.005 and (riverAt[9] - riverAt[10]) < 0.005
    (riverAt[11] - riverAt[10]) < 0.005 and (riverAt[10] - riverAt[11]) < 0.005
    poolAt[11] > poolAt[0] and poolAt[11] < 2.35
    // Ice plus water is conserved: the chain's total at each later reading is its first reading's.
    (totalAt[4] - totalAt[0]) < 0.01 and (totalAt[0] - totalAt[4]) < 0.01
    (totalAt[8] - totalAt[0]) < 0.01 and (totalAt[0] - totalAt[8]) < 0.01
    (totalAt[11] - totalAt[0]) < 0.01 and (totalAt[0] - totalAt[11]) < 0.01
  }
}
