schema: "puck.cartridge.v1"

target: "agb"

title: "PIP"

gameCode: "PIPA"

palettes {
  background [
    [4195, 28069, 5467, 10983, 4761, 28606, 9383, 0, 0, 0, 0, 0, 0, 0, 0, 0]
  ]
  object [
    [4195, 28069, 5467, 10983, 4761, 28606, 9383, 0, 0, 0, 0, 0, 0, 0, 0, 0]
  ]
}

tiles [
  {
    name: "floor"
    pixels: map(range(0, 8), row => "00000000")
  }
  {
    name: "wall-dive"
    pixels: map(range(0, 8), row => "11111111")
  }
  {
    name: "wall-kart"
    pixels: map(range(0, 8), row => "22222222")
  }
  {
    name: "wall-jump"
    pixels: map(range(0, 8), row => "33333333")
  }
  {
    name: "wall-studio"
    pixels: map(range(0, 8), row => "44444444")
  }
  {
    name: "pip"
    pixels [
      "00555500"
      "05555550"
      "05655650"
      "05555550"
      "00555500"
      "05555550"
      "05500550"
      "05500550"
    ]
  }
]

map: concat(
  map(range(0, 30), i => 1),
  [0, 0, 4],
  flatMap(range(0, 17), r => concat(map(range(0, 28), i => 0), [2, 0, 0, 4])),
  map(range(0, 28), i => 0),
  [2, 0, 0],
  map(range(0, 30), i => 3),
  map(range(0, 386), i => 0)
)

variables [
  {
    initial: 116
    name: "x"
  }
  {
    initial: 76
    name: "y"
  }
  {
    initial: 0
    name: "steps"
  }
]

arrays []

screens []

sprites [
  {
    name: "pip"
    tile: "5"
    visible: "1"
    x: "x"
    y: "y"
  }
]

layers []

raster []

sounds []

scrollX: "0"

scrollY: "0"

rule "walk-west" {
  when key(left, held)
  x -= 1
}

rule "walk-east" {
  when key(right, held)
  x += 1
}

rule "walk-north" {
  when key(up, held)
  y -= 1
}

rule "walk-south" {
  when key(down, held)
  y += 1
}

rule "wall-west" {
  when x < 8
  x = 8
}

rule "wall-east" {
  when x > 224
  x = 224
}

rule "wall-north" {
  when y < 8
  y = 8
}

rule "wall-south" {
  when y > 144
  y = 144
}

rule "count-steps" {
  when steps < 255 and key(a, pressed)
  steps += 1
}
