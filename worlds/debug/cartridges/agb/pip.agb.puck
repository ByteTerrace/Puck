variables [
  {
    initial: 116
    name: "x"
  }
  {
    initial: 76
    name: "y"
  }
  {
    initial: 0
    name: "steps"
  }
]

arrays []

screens []

sprites [
  {
    name: "pip"
    tile: "5"
    visible: "1"
    x: "x"
    y: "y"
  }
]

layers []

raster []

sounds []

scrollX: "0"

scrollY: "0"

rule "walk-west" {
  when key(left, held)
  x -= 1
}

rule "walk-east" {
  when key(right, held)
  x += 1
}

rule "walk-north" {
  when key(up, held)
  y -= 1
}

rule "walk-south" {
  when key(down, held)
  y += 1
}

rule "wall-west" {
  when x < 8
  x = 8
}

rule "wall-east" {
  when x > 224
  x = 224
}

rule "wall-north" {
  when y < 8
  y = 8
}

rule "wall-south" {
  when y > 144
  y = 144
}

rule "count-steps" {
  when steps < 255 and key(a, pressed)
  steps += 1
}
