let names = map(tileList, entry => entry.name)

tiles: tileList

// Each cell's place in the valley: 0 sky, 1 lighter moon, 2 darker moon, 3 star, 4 cliff ledge, 5 cliff strata,
// 6 canopy, 7 trunk, 8 meadow edge, 9 meadow, 10 below the picture. The wall's top changes only on even rows and
// columns, so no 16-pixel attribute quadrant straddles the sky and the rock.
let wallTop = [12, 12, 10, 10, 12, 12, 14, 14, 12, 12, 14, 14, 14, 14, 14, 14, 14, 14, 14, 14, 12, 12, 10, 10, 12, 12, 14, 14, 12, 12, 10, 10]
let places = flatMap(range(0, 32), r => map(range(0, 32), c =>
  r >= 30 ? 10
  : r >= 21 ? 9
  : r == 20 ? 8
  : (r >= 12 and r <= 15 and c >= 10 and c <= 19) ? 6
  : (r >= 16 and c >= 14 and c <= 15) ? 7
  : r > wallTop[c] ? 5
  : r == wallTop[c] ? 4
  : (r >= 2 and r <= 3 and c >= 4 and c <= 5) ? 1
  : (r >= 4 and r <= 5 and c >= 22 and c <= 23) ? 2
  : (r < 9 and (r * 7 + c * 13) % 23 == 0) ? 3
  : 0
))

let cells = map(places, (place, i) =>
  let r = floor(i / 32) in
  let c = i % 32 in
  place == 1 ? indexOf(names, "moon-light-tl") + (r - 2) * 2 + (c - 4)
  : place == 2 ? indexOf(names, "moon-dark-tl") + (r - 4) * 2 + (c - 22)
  : place == 3 ? indexOf(names, "star")
  : place == 4 ? indexOf(names, "ledge")
  : place == 5 ? indexOf(names, r % 2 == 0 ? "strata-a" : "strata-b")
  : place == 6 ? indexOf(names,
      r == 12 ? (c == 10 ? "canopy-top-l" : c == 19 ? "canopy-top-r" : "canopy-top")
      : r == 13 ? (c == 10 ? "canopy-l" : c == 19 ? "canopy-r" : (c % 2 == 0 ? "canopy-a" : "canopy-b"))
      : r == 15 ? "canopy-under"
      : (c % 2 == 1 ? "canopy-a" : "canopy-b"))
  : place == 7 ? indexOf(names, c == 14 ? "trunk-l" : "trunk-r")
  : place == 8 ? indexOf(names, "grass-edge")
  : place == 9 ? indexOf(names, (r * 5 + c * 3) % 7 == 0 ? "tuft" : (r * 3 + c * 7) % 11 == 0 ? "pebble" : "grass")
  : 0
)

map: cells

mapPalettes: map(places, place => [0, 0, 0, 0, 1, 1, 2, 2, 2, 2, 0][place])

// The question box: six rows of 22 cells over the sky, rows 2 to 7. Its text is glyph names; a space is the paper.
let lines = [
  [" ", "h", "o", "w", " ", "m", "a", "n", "y", " ", "l", "e", "g", "s", " ", "d", "o", "e", "s", " "]
  [" ", "a", " ", "d", "r", "a", "g", "o", "n", "f", "l", "y", " ", "h", "a", "v", "e", "qm", " ", " "]
  [" ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " "]
  [" ", " ", " ", "4", " ", " ", " ", " ", " ", "6", " ", " ", " ", " ", " ", "8", " ", " ", " ", " "]
]
let boxTiles = concat(
  [indexOf(names, "box-tl")], map(range(0, 20), i => indexOf(names, "box-t")), [indexOf(names, "box-tr")],
  flatMap(lines, line => concat(
    [indexOf(names, "box-l")],
    map(line, ch => ch == " " ? indexOf(names, "box-fill") : indexOf(names, $"glyph-{ch}")),
    [indexOf(names, "box-r")]
  )),
  [indexOf(names, "box-bl")], map(range(0, 20), i => indexOf(names, "box-b")), [indexOf(names, "box-br")]
)

let mothTop = indexOf(names, "moth-tl")
let mothLegs = indexOf(names, "moth-bl-a")
let fly = indexOf(names, "fly-up-l")
let paper = indexOf(names, "box-fill")
let pointer = indexOf(names, "cursor")
let starIcon = indexOf(names, "star-icon")
let digitZero = indexOf(names, "digit-0")

variables [
  // 0 walking, 1 drawing the box, 2 asking, 3 clearing the box, 4 starting, 5 fading in.
  { name: "phase", initial: 4 }
  { name: "fadeamt", initial: 16 }
  { name: "prow", initial: 0 }
  { name: "base", initial: 0 }
  { name: "k", initial: 0 }
  { name: "idx", initial: 0 }
  { name: "tv", initial: 0 }
  { name: "col", initial: 0 }
  // The Moth: world x, screen y, the camera, her screen x, facing (1 left), stride and leg frame.
  { name: "mx", initial: 120 }
  { name: "my", initial: 184 }
  { name: "cam", initial: 0 }
  { name: "sx", initial: 120 }
  { name: "face", initial: 0 }
  { name: "step", initial: 0 }
  { name: "legs", initial: 0 }
  { name: "moved", initial: 0 }
  { name: "t", initial: 0 }
  // The dragonfly: world x, flight height, bobbed y, heading (1 left), turn timer, screen x, shown, fleeing, return
  // timer and wing frame.
  { name: "dx", initial: 210 }
  { name: "dy", initial: 168 }
  { name: "dyy", initial: 168 }
  { name: "ddir", initial: 1 }
  { name: "dturn", initial: 90 }
  { name: "dsx", initial: 90 }
  { name: "dvis", initial: 1 }
  { name: "away", initial: 0 }
  { name: "respawn", initial: 0 }
  { name: "wings", initial: 0 }
  { name: "ex", initial: 0 }
  { name: "ey", initial: 0 }
  { name: "pick", initial: 0 }
  { name: "redraw", initial: 0 }
  { name: "stars", initial: 0 }
]

scene: "phase"

arrays [
  { name: "box", initial: boxTiles }
  // The sky the box covers, to put back when it closes.
  { name: "under", initial: slice(cells, 64, 256) }
  // The dragonfly's hover, one height a step.
  { name: "bob", initial: [0, 1, 2, 3, 3, 4, 4, 4, 3, 3, 2, 1, 0, 0, 0, 0] }
]

screens []

save {
  version: 1
  variables ["stars"]
  arrays []
}

sprites [
  // The Moth, 16 by 16 in four sprites; facing left mirrors each and swaps the columns.
  { name: "moth-tl", tile: "mothTop + face", x: "sx", y: "my", visible: "1", palette: "0", flipX: "face" }
  { name: "moth-tr", tile: "mothTop + 1 - face", x: "sx + 8", y: "my", visible: "1", palette: "0", flipX: "face" }
  { name: "moth-bl", tile: "mothLegs + legs + face", x: "sx", y: "my + 8", visible: "1", palette: "0", flipX: "face" }
  { name: "moth-br", tile: "mothLegs + legs + 1 - face", x: "sx + 8", y: "my + 8", visible: "1", palette: "0", flipX: "face" }
  // The dragonfly, 16 by 8, its wings beating between two frames.
  { name: "fly-l", tile: "fly + wings + ddir", x: "dsx", y: "dyy", visible: "dvis & (dsx < 240)", palette: "1", flipX: "ddir" }
  { name: "fly-r", tile: "fly + wings + 1 - ddir", x: "dsx + 8", y: "dyy", visible: "dvis & (dsx < 232)", palette: "1", flipX: "ddir" }
  // The star count.
  { name: "star", tile: "starIcon", x: "8", y: "8", visible: "1", palette: "2" }
  { name: "count", tile: "digitZero + stars", x: "18", y: "8", visible: "1", palette: "2" }
]

layers []

raster []

sounds [
  {
    name: "valley"
    music [
      {
        voice: "pulse2"
        part {
          schema: "puck.tune.v1"
          name: "valley-lead"
          tempo: 10
          effects: null
          order [0, 1, 2, 3]
          patterns: map(
            [
              ["E4", "---", "G4", "---", "A4", "---", "G4", "E4", "D4", "---", "E4", "---", "G4", "---", "---", "---"]
              ["A4", "---", "C5", "---", "D5", "---", "C5", "A4", "G4", "---", "E4", "---", "D4", "---", "---", "---"]
              ["E4", "G4", "A4", "C5", "D5", "---", "C5", "---", "A4", "---", "G4", "A4", "E4", "---", "---", "---"]
              ["D4", "---", "E4", "G4", "A4", "---", "G4", "---", "E4", "D4", "C4", "---", "---", "---", "---", "---"]
            ],
            pattern => map(pattern, note => { duty: 2, envelope: 147, note: note })
          )
        }
      }
      {
        voice: "wave"
        part {
          schema: "puck.tune.v1"
          name: "valley-bass"
          tempo: 10
          effects: null
          order [0, 1, 2, 3]
          patterns: map(
            [
              ["C3", "---", "G3", "---", "C3", "---", "G3", "---", "A3", "---", "E3", "---", "A3", "---", "E3", "---"]
              ["F3", "---", "C4", "---", "F3", "---", "C4", "---", "C3", "---", "G3", "---", "C3", "---", "G3", "---"]
              ["A3", "---", "E3", "---", "F3", "---", "C4", "---", "C3", "---", "G3", "---", "E3", "---", "G3", "---"]
              ["G3", "---", "D4", "---", "G3", "---", "D4", "---", "C3", "---", "G3", "---", "C3", "---", "---", "---"]
            ],
            pattern => map(pattern, note => { duty: null, envelope: 1, note: note })
          )
        }
      }
    ]
  }
  {
    name: "chime"
    frames: 5
    effect {
      voice: "pulse1"
      rows: map(["C5", "E5", "G5", "C6", "OFF"], note => { duty: 2, envelope: 194, note: note })
    }
  }
  {
    name: "buzz"
    frames: 4
    effect {
      voice: "noise"
      rows: map(["C3", "C3", "OFF"], note => { duty: null, envelope: 161, note: note })
    }
  }
]

scrollX: "cam"

scrollY: "0"

// Starting: the kept star count comes back, the music starts, and the valley fades in from black.
rule "start" {
  when phase == 4
  load()
  play(sound: "valley")
  phase = 5
}

rule "fade-in" {
  when phase == 5
  fade(amount: "fadeamt", toward: "black")
  if fadeamt == 0 {
    phase = 0
  } else {
    fadeamt -= 1
  }
}

rule "clock" {
  t += 1
}

// The pad walks her across the meadow; the camera follows once she leaves the middle of the picture.
rule "walk" {
  when phase == 0
  moved = 0
  if key(left, held) {
    mx -= 1
    face = 1
    moved = 1
  }
  if key(right, held) {
    mx += 1
    face = 0
    moved = 1
  }
  if key(up, held) and my > 152 {
    my -= 1
    moved = 1
  }
  if key(down, held) and my < 212 {
    my += 1
    moved = 1
  }
  if moved {
    step += 1
  }
  legs = ((step >> 3) & 1) * 2
  sx = mx - cam
  if sx < 64 {
    cam = mx - 64
  }
  if sx > 176 {
    cam = mx - 176
  }
  sx = mx - cam
}

// The dragonfly drifts back and forth over the meadow, bobbing, until a right answer sends it up and away.
rule "dragonfly" {
  wings = ((t >> 2) & 1) * 2
  if away {
    dy -= 2
    if dy < 24 {
      away = 0
      dvis = 0
      respawn = 240
    }
  } else {
    if (t & 1) == 1 {
      if ddir {
        dx -= 1
      } else {
        dx += 1
      }
    }
    dturn -= 1
    if dturn == 0 {
      ddir ^= 1
      dturn = 120
    }
  }
  if respawn {
    respawn -= 1
    if respawn == 0 {
      dvis = 1
      dx = mx + 128
      dy = 168
    }
  }
  dyy = dy + bob[(t >> 2) & 15]
  dsx = dx - cam
}

// Close enough, and the question opens.
rule "meet" {
  when phase == 0
  ex = sx - dsx
  if ex >= 128 {
    ex = 0 - ex
  }
  ey = my - dyy
  if ey >= 128 {
    ey = 0 - ey
  }
  if dvis and away == 0 and ex < 14 and ey < 14 {
    phase = 1
    prow = 0
    pick = 0
    base = ((cam >> 3) + 5) & 30
  }
}

// The box draws a row a frame, over whatever the camera shows.
rule "draw-box" {
  when phase == 1
  idx = prow * 22
  repeat 22 as k {
    tv = box[idx]
    col = base + k
    map(row: "2 + prow", column: "col", tile: "tv", palette: "3")
    idx += 1
  }
  prow += 1
  if prow == 6 {
    phase = 2
    redraw = 1
  }
}

// Left and right move the pointer between the answers; A answers. Six is right.
rule "ask" {
  when phase == 2
  if key(left, pressed) and pick > 0 {
    pick -= 1
    redraw = 1
  }
  if key(right, pressed) and pick < 2 {
    pick += 1
    redraw = 1
  }
  if redraw {
    repeat 3 as k {
      col = base + 3 + k * 6
      tv = paper
      if k == pick {
        tv = pointer
      }
      map(row: "6", column: "col", tile: "tv", palette: "3")
    }
    redraw = 0
  }
  if key(a, pressed) {
    if pick == 1 {
      play(sound: "chime")
      if stars < 9 {
        stars += 1
      }
      save()
      away = 1
      prow = 0
      phase = 3
    } else {
      play(sound: "buzz")
    }
  }
}

// The box clears a row a frame, the sky put back under it.
rule "clear-box" {
  when phase == 3
  repeat 22 as k {
    col = (base + k) & 31
    idx = prow * 32 + col
    tv = under[idx]
    map(row: "2 + prow", column: "col", tile: "tv", palette: "0")
  }
  prow += 1
  if prow == 6 {
    phase = 0
  }
}
