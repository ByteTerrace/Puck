// Moth Valley, the first scene of an original edutainment game for the Humble Gaming Deck. The Moth walks the floor of
// the valley's caldera, under the ochre canyon walls, the great gallery tree and the two moons, one lighter and one
// darker. A dragonfly from the garden pond wanders the meadow; meet it and it asks a question in a box drawn over the
// sky, the answers picked with the pad and A. A right answer chimes, earns a star the cartridge keeps on its battery,
// and sends the dragonfly off; it comes back later to ask again.
//
// The background is 32 columns, 256 pixels, so it wraps as the camera follows her and her world x wraps with it.
schema: "puck.cartridge.v1"

target: "hgd"

// MMC3: banked PRG ROM, and battery-backed PRG-RAM for the star count.
board: "mmc3"

title: "MOTH VALLEY"

gameCode: "MTHV"

// Master-palette indices. Colour zero of every palette is the sky, the backdrop.
palettes {
  background [
    // Sky and moons: white, grey, dark grey.
    [33, 48, 16, 0]
    // Canyon walls: ochre, rust, dark brown.
    [33, 39, 23, 7]
    // The tree and the meadow: light green, green, bark.
    [33, 42, 26, 7]
    // The question box: cream paper, lavender border, ink.
    [33, 55, 19, 15]
  ]
  object [
    // The Moth: lavender plates, ivory, charcoal joints.
    [33, 36, 55, 45]
    // The dragonfly: wing shimmer, teal body, highlight.
    [33, 44, 27, 48]
    // The star count: gold, pale gold, orange.
    [33, 40, 56, 22]
    [33, 36, 55, 45]
  ]
}

