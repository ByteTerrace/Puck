schema: "puck.cartridge.v1"

import "../../../standard/learning/text"
import "../../../standard/learning/questions"
import "../../../standard/learning/clues"
import "../../../standard/learning/finds"
import "../../../standard/learning/places"

// Field Notes on the humble brick: the Moth walks the valley floor, befriends the critters that wander it by
// answering their questions, follows the clue a right answer gives to the spot hiding the key, opens the chest and
// walks through the gallery door to the next place. The questions, clues, critters, treasures, places and the notes
// record are the standard learning content (worlds/standard/learning); this module draws them and plays them. A
// target's own source imports it, declares `target` and `palettes`, and calls fieldNotes().

// Background palettes, by what they colour; a target declares them in this order.
let grassPalette = 0
let earthPalette = 1
let waterPalette = 2
let firPalette = 3
let stonePalette = 4
let flowerPalette = 5
let woodPalette = 6
let panelPalette = 7
// Object palettes: the Moth's hood and face, her suit, then each critter's and the key's.
let headPalette = 0
let suitPalette = 1
let critterPalettes = [2, 3, 4]
let keyPalette = 5

// Every tile after the font, each with the background palette its cells draw through. Sprite tiles carry the
// palette of the sprites that show them only for completeness; a sprite names its own.
let art = [
  {
    name: "frame-tl"
    palette: panelPalette
    pixels ["00000000", "01111111", "01222222", "01200000", "01200000", "01200000", "01200000", "01200000"]
  }
  {
    name: "frame-t"
    palette: panelPalette
    pixels ["00000000", "11111111", "22222222", "00000000", "00000000", "00000000", "00000000", "00000000"]
  }
  {
    name: "frame-tr"
    palette: panelPalette
    pixels ["00000000", "11111110", "22222210", "00000210", "00000210", "00000210", "00000210", "00000210"]
  }
  { name: "frame-l", palette: panelPalette, pixels: map(range(0, 8), r => "01200000") }
  { name: "frame-r", palette: panelPalette, pixels: map(range(0, 8), r => "00000210") }
  {
    name: "frame-bl"
    palette: panelPalette
    pixels ["01200000", "01200000", "01200000", "01200000", "01200000", "01222222", "01111111", "00000000"]
  }
  {
    name: "frame-b"
    palette: panelPalette
    pixels ["00000000", "00000000", "00000000", "00000000", "00000000", "22222222", "11111111", "00000000"]
  }
  {
