    pixels ["11112111", "11111111", "22222222", "00000000", "00010000", "11111111", "22222122", "33333333"]
  }
  {
    name: "cliff-foot"
    palette: earthPalette
    pixels ["11111111", "22222222", "33333333", "33333333", "01000100", "00000000", "00100010", "00000000"]
  }
  {
    name: "moth-down-head-l"
    palette: headPalette
    pixels ["00000111", "00011111", "00111333", "01113222", "11132322", "11132222", "01133222", "00113333"]
  }
  {
    name: "moth-down-head-r"
    palette: headPalette
    pixels ["11100000", "11111000", "33311100", "22231110", "22323111", "22223111", "22233110", "33331100"]
  }
  {
    name: "moth-down-body-l"
    palette: suitPalette
    pixels ["01111222", "11112111", "11112111", "03312222", "01100331", "02200110", "00000110", "00003330"]
  }
  {
