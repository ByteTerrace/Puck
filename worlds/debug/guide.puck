  { title: "SMOOTH SUBTRACT", note: "The carve's rim rounded over 0.1 m." }
  { title: "SMOOTH INTERSECT", note: "The intersection's edges rounded over 0.1 m." }
  { title: "CHAMFER UNION", note: "A flat 45 degree bevel along the seam." }
  { title: "CHAMFER SUBTRACT", note: "The carve's rim bevelled at 45 degrees." }
  { title: "CHAMFER INTERSECT", note: "The intersection's edges bevelled at 45 degrees." }
  { title: "GROOVE UNION", note: "A round groove cut along the seam." }
  { title: "PIPE UNION", note: "A round bead laid along the seam." }
  { title: "GROOVE SUBTRACT", note: "A groove cut along the carve's rim." }
  { title: "PIPE SUBTRACT", note: "A bead laid along the carve's rim." }
  { title: "SYMMETRY", note: "A tilted capsule mirrored across x = 0: a V." }
  { title: "REPEAT 5", note: "One sphere repeated 0.25 m apart: five copies." }
  { title: "REPEAT 3X3", note: "One box on a 3 by 3 lattice in x and z." }
  { title: "REPEAT EVEN", note: "A symmetry over a repeat: four spheres." }
  { title: "REPEAT CLIPPED", note: "An unbounded lattice of spheres clipped by a box." }
  { title: "POLAR MIRROR", note: "Five mirrored sectors: a kaleidoscope." }
  { title: "POLAR Z", note: "Eight copies about Z through an origin: a wheel." }
  { title: "POLAR STRIDE", note: "Six sectors, each a palette row: six colours." }
  { title: "WALLPAPER PMM", note: "A tile mirrored across both cell axes." }
  { title: "WALLPAPER P4M", note: "Square symmetry: eight images per cell." }
  { title: "WALLPAPER P3M1", note: "A hex lattice of mirrors, clipped by a hexagon." }
  { title: "WALLPAPER P6M", note: "The richest hex group: twelve images per cell." }
  { title: "WALLPAPER STRIDE", note: "P4M with a material stride: a checkerboard." }
  { title: "ERODE", note: "A lane erodes the sphere, here halfway through." }
  { title: "NOISE", note: "Noise lumps the sphere; the plinth stays clean." }
  { title: "SUPER EXP 2", note: "A superellipsoid at exponent 2." }
  { title: "SUPER EXP 8", note: "A superellipsoid at exponent 8, nearly a box." }
  { title: "TAPER 0", note: "A prism at taper 0." }
  { title: "TAPER 1", note: "A prism at taper 1." }
  { title: "POLYGON 3", note: "A triangle profile, extruded." }
  { title: "PRISM ROUNDING", note: "An extruded prism with rounded edges." }
  { title: "PRISM CHAMFER", note: "An extruded prism with chamfered edges." }
  { title: "CYLINDER CHAMFER", note: "A cylinder with chamfered rims." }
  { title: "REV SOLID", note: "A profile revolved at offset 0: a solid." }
  { title: "PATH HOLES", note: "An even-odd fill: a cubic edge, a round hole." }
  { title: "PATH SHEAR", note: "An extruded path, sheared." }
  { title: "PATH CLOSED", note: "A closed cubic stroke." }
  { title: "PATH RAMP", note: "A stroke whose radius ramps along an arc." }
  { title: "SWEEP BRAID", note: "Four strands braided along a sweep." }
  { title: "METAL", note: "The palette's metal channel." }
  { title: "COAT", note: "A clear coat over the base colour." }
  { title: "SHEEN", note: "The sheen channel: a soft rim like cloth." }
  { title: "EMISSIVE", note: "An emissive surface, lit from within." }
  { title: "WRAP SOFTEN", note: "Wrap and soften on cells relief." }
  { title: "FILL BLEED", note: "Fill, bleed and receive between palette slots." }
  { title: "WEAR EDGE", note: "Edge weathering in two stages." }
  { title: "WEAR LINES", note: "Line weathering across the surface." }
  { title: "WEAR SETTLE", note: "Settle weathering: a deposit on the upper faces." }
  { title: "PANEL RECESS", note: "A recessed panel set into the face." }
  { title: "PANEL RAISE", note: "A raised panel standing off the face." }
  { title: "TRIMS", note: "A trim band round the box's equator." }
  { title: "PAINT WORLD", note: "A world-space paint on a static placement." }
  { title: "TEXT ENGRAVE", note: "Text engraved into the surface." }
  { title: "TEXT ON SHAPE", note: "Text riding a shape, wrapped to a width." }
  { title: "VOLUME FLOW", note: "A flow volume pulsing from a nozzle." }
  { title: "VOLUME CLOUD", note: "A cloud volume." }
  { title: "STATE COLOR", note: "A colour bound to state: galleryInputs.tint." }
  { title: "DOMAIN WARP", note: "A sphere warped by sines: a smooth wobble." }
  { title: "SINE RELIEF", note: "A sine product added to a box's field." }
  { title: "ELONGATE", note: "A sphere elongated into an exact rounded slab." }
  { title: "JITTER", note: "Each cell moves and recolours its sphere by hash." }
  { title: "JITTER TUMBLE", note: "Boxes tumbled on a blue-noise lattice." }
  { title: "LOG SPHERE", note: "Self-similar shells spiralling inward." }
  { title: "STAIRS UNION", note: "A seam that climbs four steps." }
  { title: "STAIRS SUBTRACT", note: "A carve whose rim steps three times." }
  { title: "MORPH", note: "The box's and sphere's fields averaged: a soft cube." }
  { title: "SPIN", note: "A rigid rotation on a linear wave." }
  { title: "ROCK", note: "A sine swing about a pivot." }
  { title: "SLIDE", note: "A translation on the gallery clock." }
  { title: "PARENT CHAIN", note: "A chain of parented swings." }
  { title: "MOVING BLEND", note: "A sphere sliding through a smooth union." }
  { title: "STATE BLEND", note: "The blend placed by state; each write rebakes." }
  { title: "MOVING CUT", note: "A cutter sliding across a still box." }
  { title: "MOVING MIRROR", note: "A mirrored shape riding a yawing hinge." }
  { title: "MOVING POLAR", note: "A polar-folded blade spinning on its hub." }
  { title: "MOVING PAINT", note: "Paints riding a swinging panel." }
  { title: "MOVING INSET", note: "An eye inset that turns with its shape." }
  { title: "TWIST", note: "A twist, drawn on the stamp-pool path." }
  { title: "BEND", note: "A bend, drawn on the stamp-pool path." }
  { title: "RADIAL PULSE", note: "Six petals sliding out from a core and back." }
  { title: "MOVING CELLS", note: "Cells relief on a swinging shape." }
  { title: "MOVING VOLUME", note: "A plume riding a tilting nozzle." }
  { title: "IK REACH", note: "A two-bone arm reaching for a state point." }
  { title: "FRAMES", note: "Timeline frames stepped on the render clock." }
  { title: "GLASS", note: "Tinted, thin, thick and frosted glass." }
]
let guideRadius = 1.29
let guideVoice = { patchId: "gallery-guide", cadenceTicks: 16, pitchThousandths: 1100, formantThousandths: 1150, paceThousandths: 1250 }

// The existing synth patch supplies the oscillator and envelope. The HUD voice supplies the speaker's articulation.
patches [{ name: "gallery-guide", source: "patches/guide-voice.patch.json", hash: "405ee9583477d64a47e99762ed96d22b97b0542650154d3b60cda55b00f243c0" }]
audio {
  masterGain: 0.65
  defaultSpeakerRadius: 8
  defaultCurve: "linear"
  defaultBedFadeSeconds: 0.1
  listener: "focus"
  cues []
}

// `guide` holds the shown exhibit's title and note, both empty while she stands at none; `guideAt` its position in
// walking order, or -1.
state {
  world {
    row {
      name: "guideExhibits"
      kind: Text
      capacity: (length(guideCopy) * 2)
      cells: reduce(range(0, length(guideCopy)), [], (cells, index) => concat(cells, [
        { key: $"{index}-title", value: guideCopy[index].title }
        { key: $"{index}-note", value: guideCopy[index].note }
      ]
      )
      )
    }
    table guide {
      title = ""
      note = ""
    }
    slot guideAt = -1
  }
}

hud {
  panels [
    {
      id: "guide"
      rect { x: 0.02, y: 0.02, width: 0.56, height: 0.075 }
      layer: Over
      style: Panel
      // Shown only with the addon HUD toggle on (addon-hud.puck) and an exhibit in front of her.
      visible {
        $type: "all"
        predicates [
          { $type: "state", binding: "state.addonHud", comparison: Equal, value: 1 }
          { $type: "state", binding: "state.guide.title", comparison: NotEqual, text: "" }
        ]
      }
      elements [
        { id: "title", kind: Text, rect { x: 0.03, y: 0.08, width: 0.94, height: 0.46 }, style: Primary, "template": "{state.guide.title}" }
        { id: "note", kind: Text, rect { x: 0.03, y: 0.56, width: 0.94, height: 0.36 }, style: Dim, "template": "{state.guide.note}", voice: guideVoice }
      ]
    }
    {
      id: "gallery-sign"
      rect { x: 0.02, y: 0.02, width: 0.68, height: 0.05 }
      layer: Over
      style: Panel
      visible {
        $type: "all"
        predicates [
          { $type: "state", binding: "state.addonHud", comparison: Equal, value: 1 }
          { $type: "near", subject { $type: "placement", placementId: `gallery-map` }, distance: 2.5 }
        ]
      }
      elements [
        { id: "directions", kind: Text, rect { x: 0.02, y: 0.1, width: 0.96, height: 0.8 }, style: Primary, text: galleryMapDirections, voice { sampleSet: "voices/gallery.sample-set.json", cadenceTicks: 18, pitchThousandths: 800, paceThousandths: 1100 } }
      ]
    }
  ]
}

prototypes {
  // A region's carrier draws nothing.
  prototype "guide-region" {
    document {
      name: "guide-region"
      schema: "puck.creation.v1"
      palette [{ color: "#000000" }]
    }
  }
}

placements {
  for exhibit in guideExhibits {
    placement $"guide-{exhibit.name}" {
      prototype: "guide-region"
      position [exhibit.x, exhibit.y, exhibit.z]
      region {
        radius: guideRadius
      }
    }
  }
}

// The requests list the regions in walking order, matching the keys in the authored guideExhibits row.
addon "guide" {
  modulePath: "addons/guide.wat"
  hash: "auto"
  fuel: 0
  enabled: true
  requests: concat(
    [
      { capability: Observe, subject: "state:guideExhibits" }
      { capability: Edit, subject: "state:guide" }
      { capability: Edit, subject: "state:guideAt" }
    ],
    map(guideExhibits, exhibit => { capability: Observe, subject: $"region:guide-{exhibit.name}" })
  )
}

// Region edges and bounded Set writes to the guide cells.
grants: concat(
  [
    { grantee: "addon:guide", capability: Observe, subject: "state:guideExhibits", budget: 2 }
    { grantee: "addon:guide", capability: Edit, subject: "state:guide", budget: 16, writeMask: "Set" }
    { grantee: "addon:guide", capability: Edit, subject: "state:guideAt", budget: 16, writeMask: "Set" }
  ],
  map(guideExhibits, exhibit => { grantee: "addon:guide", capability: Observe, subject: $"region:guide-{exhibit.name}", budget: 1, eventBudget: 4 })
)
