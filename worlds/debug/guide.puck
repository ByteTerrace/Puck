// The gallery guide: a WebAssembly addon (addons/guide.wat) that shows an exhibit's name and a one-line note on a HUD
// panel while the Moth stands in front of it in the gallery hall, and hides the panel when she walks away. Each exhibit
// has a region here, a sphere over the floor in front of its plinth where its spawn point stands, and the guide
// observes every one of them. It writes the `guide` state row the panel reads; addons.md beside this file says more.

import "shapes"

// Every exhibit in walking order, with the centre of the region in front of it: 1.7 m out from the plinth on the
// label's side, on the level's floor. Regions 2.6 m apart with a 1.29 m radius never overlap.
let guideExhibits = reduce(galleryRows, [], (all, row) => concat(all, map(row.names, (name, index) => { name: name, x: (galleryX + (gallerySpacing * index)), y: galleryFloor[row.level], z: (row.z - 1.7) })))
// Titles and notes are authored here, in the regions' walking order; the guest contains no exhibit copy.
let guideCopy = [
  { title: "SPHERE", note: "The sphere primitive at a uniform scale." }
  { title: "BOX", note: "The box primitive at a uniform scale." }
  { title: "TORUS", note: "The torus primitive at a uniform scale." }
  { title: "CYLINDER", note: "The cylinder primitive at a uniform scale." }
  { title: "CAPSULE", note: "The capsule primitive at a uniform scale." }
  { title: "ELLIPSOID", note: "The ellipsoid primitive at a uniform scale." }
  { title: "ROUND CONE", note: "The round cone primitive at a uniform scale." }
  { title: "CONE", note: "The cone primitive at a uniform scale." }
  { title: "SUPERELLIPSOID", note: "A superellipsoid at exponent 4." }
  { title: "PLANE CUT", note: "A sphere intersected with a tilted plane." }
  { title: "SPHERE XYZ", note: "A sphere scaled unevenly on all three axes." }
  { title: "BOX XYZ", note: "A box scaled unevenly on all three axes." }
  { title: "TORUS XZ", note: "A torus with X and Z scaled differently." }
  { title: "TORUS Y", note: "A torus with Y alone stretched." }
  { title: "CYLINDER XZ", note: "A cylinder with X and Z scaled differently." }
  { title: "CAPSULE XZ", note: "A capsule with X and Z scaled differently." }
  { title: "ELLIPSOID XYZ", note: "An ellipsoid scaled unevenly." }
  { title: "ROUND CONE XYZ", note: "A round cone scaled unevenly." }
  { title: "CONE XZ", note: "A cone with X and Z scaled differently." }
  { title: "SUPER XYZ", note: "A superellipsoid at exponent 3, scaled unevenly." }
  { title: "TRAPEZOID", note: "A trapezoid profile, extruded." }
  { title: "ROUNDED RECT", note: "A rounded rectangle profile, extruded." }
  { title: "POLYGON 6", note: "A hexagon profile, extruded." }
  { title: "POLYGON 12", note: "A twelve-sided polygon profile, extruded." }
  { title: "POLYGON 12 XY", note: "The twelve-gon extruded with X and Y unequal." }
  { title: "ELLIPSE", note: "An ellipse profile, extruded." }
  { title: "CHAMFER RECT", note: "A chamfered rectangle profile, extruded." }
  { title: "CONVEX", note: "A convex pentagon profile, extruded." }
  { title: "PATH FILL", note: "A filled path of lines and curves, extruded." }
  { title: "PATH STROKE", note: "An open stroked path, extruded." }
  { title: "PATH STROKE XY", note: "The stroked path extruded with X and Y unequal." }
  { title: "REV TRAPEZOID", note: "A trapezoid profile revolved into a ring." }
  { title: "REV ROUND RECT", note: "A rounded rectangle revolved into a ring." }
  { title: "REV POLYGON 6", note: "A hexagon revolved into a ring." }
  { title: "REV ELLIPSE", note: "An ellipse revolved into a ring." }
  { title: "REV CHAMFER", note: "A chamfered rectangle revolved into a ring." }
  { title: "REV CONVEX", note: "A convex pentagon revolved into a ring." }
  { title: "SWEEP", note: "A round tube of one radius along a quadratic curve." }
  { title: "SWEEP TAPER", note: "A swept tube tapering, with a mid-span bulge." }
  { title: "SWEEP STRANDS", note: "Three strands twisted round a curve: a rope." }
  { title: "ROUNDING", note: "A cylinder with its rim rounded 0.12 m." }
  { title: "CHAMFER", note: "A box bevelled 0.1 m on every edge." }
  { title: "ONION", note: "A 4 cm shell of a sphere, a window cut in it." }
  { title: "DILATE", note: "A box inflated 0.1 m: rounded, no creases." }
  { title: "FLARE", note: "A cylinder whose section scales along its height." }
  { title: "SHEAR", note: "A box sheared into a curving lean." }
  { title: "BUMPS", note: "Two gaussian pushes: a swelling and a dent." }
  { title: "CELLS F1", note: "Worley F1 relief: raised cells with creased walls." }
  { title: "CELLS F2 F1", note: "F2 minus F1 relief: ridges along the cell walls." }
  { title: "POLAR FOLD", note: "One box folded into six sectors about Y." }
  { title: "UNION", note: "Box and sphere unioned: a hard crease at the seam." }
  { title: "SUBTRACTION", note: "The sphere carved out of the box." }
  { title: "INTERSECTION", note: "Only where the box and the sphere overlap." }
  { title: "XOR", note: "Either but not both: the overlap cut away." }
