// The gallery guide: a WebAssembly addon (addons/guide.wat) that shows a display's name and a one-line note on a HUD
// panel while the Moth stands at its console in the gallery hall, and hides the panel when she walks away. Each display
// has a region here, a sphere over the floor before its console where its spawn point stands, and the guide observes
// every one of them. It writes the `guide` state row the panel reads; addons.md beside this file says more. The
// display's own screen shows the exhibit on its turntable (shapes.puck).

import "shapes"
// The companion can attend to the same arrival that triggers the guide's spoken note.
exports {
  reads [guideAt]
}

// Every display in walking order, with the centre of the region before its console, where a body stands to work it,
// on the level's floor, in the building's frame. The displays stand far apart, so no two regions overlap.
let guideExhibits = map(
  galleryDisplays,
  display => {
    name: display.id
    x: displayPoint(display, displayStand)[0]
    y: displayFloor(display)
    z: displayPoint(display, displayStand)[2]
    title: display.title
    note: $"{display.what}: tap the console to show any shape"
  }
)
let guideRadius = 1.29
let guideVoice = {
  patchId: "gallery-guide"
  cadenceTicks: 16
  pitchThousandths: 1100
  formantThousandths: 1150
  paceThousandths: 1250
}

// The existing synth patch supplies the oscillator and envelope. The HUD voice supplies the speaker's articulation.
patches [
  {
    name: "gallery-guide"
    source: "patches/guide-voice.patch.json"
    hash: "sha256/405ee9583477d64a47e99762ed96d22b97b0542650154d3b60cda55b00f243c0"
  }
]
audio {
  masterGain: 0.65
  defaultSpeakerRadius: 8
  defaultCurve: "linear"
  defaultBedFadeSeconds: 0.1
  listener: "focus"
  // The press's keys (press.puck): a dry tick for a struck letter and a dull knock for a wrong one.
  cues [
    { event: "typing.hit", patchId: "press-tick", placement: "listener", gainThousandths: 350 }
    { event: "typing.miss", patchId: "press-knock", placement: "listener", gainThousandths: 600 }
  ]
}

// `guide` holds the display's title and note, both empty while she stands at none; `guideAt` its position in walking
// order, or -1.
state {
  world {
    row {
      name: "guideExhibits"
      kind: Text
      capacity: (length(guideExhibits) * 2)
      cells: flatMap(range(0, length(guideExhibits)), index => [
        { key: $"{index}-title", value: guideExhibits[index].title }
        { key: $"{index}-note", value: guideExhibits[index].note }
      ])
    }
    table guide {
      title = ""
      note = ""
    }
    slot guideAt = -1
  }
}

hud {
  panels [
    {
      id: "guide"
      rect { x: 0.02, y: 0.02, width: 0.56, height: 0.075 }
      layer: Over
      style: Panel
      // Shown only with the addon HUD toggle on (addon-hud.puck) and an exhibit in front of her.
      visible {
        $type: "all"
        predicates [
          { $type: "state", binding: "state.addonHud", comparison: Equal, value: 1 }
          { $type: "state", binding: "state.guide.title", comparison: NotEqual, text: "" }
        ]
      }
      elements [
        {
          id: "title"
          kind: Text
          rect { x: 0.03, y: 0.08, width: 0.94, height: 0.46 }
          style: Primary
          template: "{state.guide.title}"
        }
        {
          id: "note"
          kind: Text
          rect { x: 0.03, y: 0.56, width: 0.94, height: 0.36 }
          style: Dim
          template: "{state.guide.note}"
          voice: guideVoice
        }
      ]
    }
    {
      id: "gallery-sign"
      rect { x: 0.02, y: 0.02, width: 0.68, height: 0.05 }
      layer: Over
      style: Panel
      visible {
        $type: "all"
        predicates [
          { $type: "state", binding: "state.addonHud", comparison: Equal, value: 1 }
          { $type: "near", subject { $type: "placement", placementId: `gallery-map` }, distance: 2.5 }
        ]
      }
      elements [
        {
          id: "directions"
          kind: Text
          rect { x: 0.02, y: 0.1, width: 0.96, height: 0.8 }
          style: Primary
          text: galleryMapDirections
          voice {
            sampleSet: "voices/gallery.sample-set.json"
            hash: auto
            cadenceTicks: 18
            pitchThousandths: 800
            paceThousandths: 1100
          }
        }
      ]
    }
  ]
}

prototypes {
  // A region's carrier draws nothing.
  prototype "guide-region" {
    document {
      name: "guide-region"
      schema: "puck.creation.v1"
      palette [{ color: "#000000" }]
    }
  }
}

placements {
  for exhibit in guideExhibits {
    placement $"guide-{exhibit.name}" {
      prototype: "guide-region"
      parent: "gallery"
      position [exhibit.x, exhibit.y, exhibit.z]
      region {
        radius: guideRadius
      }
    }
  }
}

// The requests list the regions in walking order, matching the keys in the authored guideExhibits row.
addon "guide" {
  modulePath: "addons/guide.wat"
  hash: auto
  fuel: 0
  enabled: true
  requests: concat(
    [
      { capability: Observe, subject: "state:guideExhibits" }
      { capability: Edit, subject: "state:guide" }
      { capability: Edit, subject: "state:guideAt" }
    ],
    map(guideExhibits, exhibit => { capability: Observe, subject: $"region:guide-{exhibit.name}" })
  )
}

// Region edges and bounded Set writes to the guide cells.
grants: concat(
  [
    { grantee: "addon:guide", capability: Observe, subject: "state:guideExhibits", budget: 2 }
    { grantee: "addon:guide", capability: Edit, subject: "state:guide", budget: 16, writeMask: "Set" }
    { grantee: "addon:guide", capability: Edit, subject: "state:guideAt", budget: 16, writeMask: "Set" }
  ],
  map(
    guideExhibits,
    exhibit => {
      grantee: "addon:guide"
      capability: Observe
      subject: $"region:guide-{exhibit.name}"
      budget: 1
      eventBudget: 4
    }
  )
)
