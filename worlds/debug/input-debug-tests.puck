// Real debug bindings and authoritative form/flight/engagement selectors.
schema: "puck.world.definition.v1"
basis: "debug"
documentId: "input-debug-tests"

test "a forbidden kit mode transition leaves the whole firing unapplied" {
  when {
    ticks 30
    seat1: world.row.set inputModes {"global":["flight"],"families":[{"name":"flight","selector":{"kind":"BodyState","name":"flightFuel"},"default":"walking","states":[{"name":"walking","ranges":[{"minimum":0,"maximum":0}],"channels":[]},{"name":"flying","ranges":[{"minimum":0.0000152587890625,"maximum":1000}],"channels":[]}]}],"combinations":[{"flight":"walking"}]}
    ticks 3
    seat1: player.signal keyboard.f press
    ticks 9
  }
  expect {
    bodyState(body, 0, flightFuel) == 0
    bodyState(body, 0, flightPress) == 1
  }
}

test "autorun and run survive a suit switch after their buttons are released" {
  when {
    ticks 30
    seat1: player.signal keyboard.n press
    ticks 2
    seat1: player.signal keyboard.n release
    seat1: player.signal keyboard.z press
    ticks 2
    seat1: player.signal keyboard.n press
    ticks 2
    seat1: player.signal keyboard.n release
    seat1: player.signal keyboard.z release
    ticks 2
    seat1: body.press suit 1 0.2 0
    ticks 15
  }
  expect {
    bodyState(body, 0, suit) == 0
    channel(1, forward) == 1
    channel(1, run) == 1
  }
}

test "autofly survives flight entry and a flying noclip switch" {
  when {
    ticks 30
    seat1: player.signal keyboard.z press
    ticks 2
    seat1: player.signal keyboard.m press
    ticks 2
    seat1: player.signal keyboard.m release
    seat1: player.signal keyboard.z release
    ticks 15
    seat1: body.press noclip 1 0.2 0
    ticks 15
  }
  expect {
    bodyState(body, 0, flightFuel) > 0
    bodyState(body, 0, noclip) == 1
    channel(1, rise) == 1
    bodyPosition(body, 0, y) > 1
  }
}

test "leaving flight cancels autofly and it does not restart on reentry" {
  when {
    ticks 30
    seat1: player.signal keyboard.z press
    ticks 2
    seat1: player.signal keyboard.m press
    ticks 2
    seat1: player.signal keyboard.m release
    seat1: player.signal keyboard.z release
    ticks 15
    seat1: body.press flight 1 0.2 0
    ticks 15
    seat1: body.press flight 1 0.2 0
    ticks 15
  }
  expect {
    bodyState(body, 0, flightFuel) > 0
    channel(1, rise) == 0
  }
}

test "a board engagement cancels autorun without moving its cursor" {
  given {
    aiSide = -1
  }
  when {
    ticks 30
    seat1: body.pose 56.5 9.25 21.1 0 0 0 0
    ticks 150
    seat1: player.signal keyboard.z press
    ticks 2
    seat1: player.signal keyboard.n press
    ticks 2
    seat1: body.press interact
    ticks 3
    seat1: player.signal keyboard.n release
    seat1: player.signal keyboard.z release
    ticks 10
  }
  expect {
    board(engaged, board, 1) == 1
    channel(1, forward) == 0
    play.held == -1
  }
}

test "leaving a board releases its held direction before locomotion resumes" {
  given {
    aiSide = -1
  }
  when {
    seat1: body.pose 56.5 9.25 21.1 0 0 0 0
    ticks 150
    seat1: body.press interact
    ticks 5
    seat1: player.signal keyboard.w press
    ticks 3
    seat1: body.press interact
    ticks 10
  }
  expect {
    board(engaged, board, 1) == 0
    channel(1, forward) == 0
  }
}

test "entering a machine screen cancels autorun" {
  when {
    ticks 30
    seat1: body.pose 7.6 0.05 29.4 90 0 0
    ticks 5
    seat1: player.signal keyboard.z press
    ticks 2
    seat1: player.signal keyboard.n press
    ticks 2
    seat1: body.press interact
    ticks 3
    seat1: player.signal keyboard.n release
    seat1: player.signal keyboard.z release
    ticks 10
  }
  expect {
    engaged(body, 0, 0) == 1
    channel(1, forward) == 0
  }
}

test "leaving a machine screen releases its held direction" {
  when {
    ticks 30
    seat1: body.pose 7.6 0.05 29.4 90 0 0
    ticks 5
    seat1: body.press interact
    ticks 5
    seat1: player.signal keyboard.w press
    ticks 3
    seat1: body.press interact
    ticks 10
  }
  expect {
    engaged(body, 0, 0) == 0
    channel(1, forward) == 0
  }
}
