// The debug world's benchmark routes: `world.benchmark run debug` (or `puck benchmark --route debug`) plays the walk, and
// `seams` the three crossings at each pace. Each chapter is a list of places to go to and how, played by the standard's
// `walker` seat program (standard/benchmark.puck) through seat 1's own controls: the left stick toward the next corner of
// the navigation path, the right stick turning the camera onto the way ahead, Left Shift held to run and the dash tapped on
// its cooldown, the context button pressed where a step presses `interact`. A step that strays plans its path again from
// where the body stands, so a shed tick, a Wonderland-sized body or a nudge does not carry the rest of the chapter off
// course, and a chapter fails, naming the place and the tick, on a stick held against a wall or on leaving the places its path
// crosses.
//
// The walk is the owner's: from the stage into the hall and its lobby, along the east wing into the painting room,
// through the looping pair, back to the lobby, into Wonderland through the big painting to the machines and out
// through the mouse hole. Then the seams: the valley into the lobby and back, the garden painting, the city painting, and
// the lift ridden by its buttons. Places are places.puck's regions (`place-*`); headings are yaws (0 faces -Z, 90 faces
// -X, 180 faces +Z, 270 faces +X); points are world coordinates on the floor.

// A floor's height in the hall (shapes.puck's galleryFloor).
let floor0 = 0.05
let floor3 = 13.55

// The lift (hall.puck): the landing's call plate reach box before the car's door, the car's door, and the car's panel,
// whose buttons for levels 0 to 3 stand left to right from the viewer facing it (+Z).
let liftPad = 17
let liftPadZ = 35.4
let liftDoorX = 15.9
let liftPanelZ = 38.85
function liftButton(level) = (16.85 - ((1.9 / 6) * (level + 0.5)))

// Steps the chapters share.
function stand(seconds) = { $type: "rest", seconds: seconds }
function face(heading, seconds) = { $type: "rest", seconds: seconds, faceDegrees: heading }
function go(place, pace) = { $type: "go", place: place, pace: pace }
function goTo(point, pace, within = 0.5) = { $type: "go", point: point, pace: pace, within: within }
function step(point, within = 0.3) = { $type: "go", point: point, pace: "walk", direct: true, within: within }
function press(action, seconds) = { $type: "press", action: action, seconds: seconds }

// Riding the lift from the landing a body stands on to another: call the car at the landing's plate, step in through
// the door, press the level's button on the panel, ride until the car reaches that level, and step out as its doors
// open. Inside the car every step walks.
function ride(from, to, level, pace) = [
  goTo([liftPad, from, liftPadZ], pace, 0.15)
  face(180, 0.5)
  press("interact", 3)
  step([liftDoorX, from, 35.2])
  step([liftDoorX, from, 37.6])
  step([liftButton(level), from, liftPanelZ], 0.12)
  face(180, 0.5)
  { $type: "press", action: "interact", until: $"place-gallery-level-{level}", seconds: 40 }
  stand(4)
  step([liftDoorX, to, 37])
  step([liftDoorX, to, 34.8])
]

// The seams (docs/plans/streaming-and-memory.md#the-seam-walk), each from its own spawn so a chapter fails alone. The
// valley floor from 36 m out into the lobby and back out, then in again; the garden painting, eight metres into the
// garden and back through its arrival frame; the lift from level 0 to level 3 and back.
function valleySeam(name, pace) = {
  name: name
  steps [
    { $type: "pose", spawn: `seam-valley` }
    stand(1)
    goTo([16, floor0, 20], pace)
    goTo([16, floor0, -14], pace)
    go("place-lobby", pace)
    stand(1)
  ]
}
function gardenSeam(name, pace) = {
  name: name
  steps [
    { $type: "pose", spawn: `portal-garden` }
    stand(1)
    { $type: "cross", headingDegrees: 180, pace: pace, metres: 11 }
    stand(1)
    { $type: "cross", headingDegrees: 180, relative: true, until: "place-garden-painting", pace: pace, metres: 14 }
    stand(1)
  ]
}
// The city painting (city.puck): through the canvas on the wing's south wall onto the avenue, into the market, down a
// terrace lane, along the quay and up the works road, then back to the arrival frame and through it into the wing. The
// points stand in the open between buildings: the lane at x -106 between two columns of houses, the quay's edge before
// the river, the works road's middle.
function citySeam(name, pace) = {
  name: name
  steps [
    { $type: "pose", spawn: `portal-city` }
    stand(1)
    { $type: "cross", headingDegrees: 0, pace: pace, metres: 11 }
    stand(1)
    goTo([0, 0, -40], pace)
    goTo([-106, 0, -80], pace)
    goTo([60, 0, -200], pace)
    goTo([95, 0, -50], pace)
    goTo([0, 0, -9], pace, 0.15)
    face(180, 0.5)
    { $type: "cross", headingDegrees: 180, until: "place-city-painting", pace: pace, metres: 8 }
    stand(1)
  ]
}
function liftSeam(name, pace) = {
  name: name
  steps: concat(
    [{ $type: "pose", spawn: `gallery-level-0` }, stand(1)],
    ride(floor0, floor3, 3, pace),
    [stand(1)],
    ride(floor3, floor0, 0, pace),
    [go("place-lobby", pace)]
  )
}

// The paces the seams route plays each crossing at, the walker program's words: 5 m/s, 10 m/s with Left Shift held, and
// the run with the dash on each cooldown.
let seamPaces = ["walk", "run", "dash"]

routes [
  {
    name: "debug"
    program: "walker"
    chapters: concat(
      [
        {
          name: "the stage into the hall"
          steps [
            { $type: "pose", spawn: stage }
            { $type: "line", text: "player.camera.view first" }
            stand(1)
            go("place-hall-entrance", "run")
            go("place-lobby", "run")
            goTo([16, floor0, 20], "walk")
          ]
        }
        {
          name: "the east wing and the looping pair"
          steps [
            go("place-east-wing", "run")
            go("place-painting-room", "run")
            go("place-loop-portal-east", "walk")
            goTo([68.4, floor0, 34.5], "walk", 0.1)
            face(270, 0.5)
            { $type: "cross", headingDegrees: 270, until: "place-loop-portal-west", pace: "walk", metres: 6 }
            stand(1)
            { $type: "rest", seconds: 2, lookAt [57, 1.5, 39.4] }
            go("place-east-wing", "run")
            go("place-lobby", "run")
          ]
        }
        {
          name: "Wonderland's machines"
          steps [
            go("place-wonderland-threshold", "walk")
            goTo([11.6, floor0, 30.5], "walk", 0.15)
            face(90, 0.5)
            { $type: "cross", headingDegrees: 90, until: "place-wonderland", pace: "walk", metres: 4 }
            goTo([3.6, floor0, 30.5], "walk", 0.2)
            { $type: "rest", seconds: 4, lookAt [1.4, 0.6, 30.5] }
            goTo([8.7, floor0, 30.5], "walk", 0.08)
            face(270, 0.5)
            { $type: "cross", headingDegrees: 270, until: "place-lobby", pace: "walk", metres: 3 }
            goTo([16, floor0, 26], "walk")
          ]
        }
      ],
      [
        valleySeam("the valley's seam", "run")
        gardenSeam("the garden painting", "walk")
        citySeam("the city painting", "run")
        liftSeam("the lift", "walk")
      ]
    )
  }
  {
    name: "seams"
    program: "walker"
    chapters: concat(
      [{ name: "first person", steps [{ $type: "line", text: "player.camera.view first" }] }],
      map(seamPaces, pace => valleySeam($"the valley, {pace}", pace)),
      map(seamPaces, pace => gardenSeam($"the garden painting, {pace}", pace)),
      map(seamPaces, pace => liftSeam($"the lift, {pace}", pace))
    )
  }
]
