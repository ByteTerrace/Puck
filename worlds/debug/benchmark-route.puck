// The benchmark's baseline route through the debug world, played by `puck benchmark --route
// worlds/debug/benchmark-route.puck` and `world.benchmark run worlds/debug/benchmark-route.puck -`. Each test block is a
// chapter: it sets the body down at its start, then a controller program runs or walks legs between waypoints taken from
// the owner's own walks of the world, so the line goes where a player goes and never into a wall.
//
// The seat steers as a player does. The left stick moves the body relative to the camera and the seat turns the body to
// the camera's heading every tick, so a pose's yaw does not hold; every turn is the right stick, which turns the camera
// 6.68 degrees a tick at full deflection and in proportion below it. Turns are relative, so the chapters chain: each
// starts at the heading the one before ended on, and the first at the stage's (0). Headings are yaws: 0 faces -Z,
// 90 faces -X, 180 faces +Z and 270 faces +X; the right stick's +X turns clockwise, lowering the yaw.
//
// Paces are the standard package's: a walk is 5 m/s (six ticks a metre at 30 Hz), a run 10 m/s with Left Shift held
// (three ticks a metre). A leg re-asserts the stick every fifteen ticks, as a player holding it does across a crossing.
let stickForward = "player.signal gamepad.leftStick 0 1"
let stickRest = "player.signal gamepad.leftStick 0 0"
let shiftPress = "player.signal keyboard.shiftLeft press"
let shiftRelease = "player.signal keyboard.shiftLeft release"
let walk = { ticksPerMetre: 6, shift: shiftRelease }
let run = { ticksPerMetre: 3, shift: shiftPress }
let routeChunk = 15
let degreesPerTick = 6.68

function step(line, wait) = { line: line, wait: wait }

// The signed turn from one heading to another, in -180 .. 180 (positive raises the yaw: counter-clockwise).
function turnDegrees(from, to) = (((to - from) > 180) ? ((to - from) - 360) : ((((to - from) < -180) ? ((to - from) + 360) : (to - from))))
function turnMagnitude(from, to) = ((turnDegrees(from, to) < 0) ? (0 - turnDegrees(from, to)) : turnDegrees(from, to))
function turnSign(from, to) = ((turnDegrees(from, to) < 0) ? 1 : -1)
function turnTicks(from, to) = floor(turnMagnitude(from, to) / degreesPerTick)
function turnRest(from, to) = ((turnMagnitude(from, to) / degreesPerTick) - turnTicks(from, to))
// A turn: the right stick at full deflection for the whole ticks, one tick at the remainder's deflection, then centred.
function turn(from, to) = concat(
  [step(stickRest, 1)],
  ((turnTicks(from, to) > 0) ? [step($"player.signal gamepad.rightStick {turnSign(from, to)} 0", turnTicks(from, to))] : []),
  ((turnRest(from, to) > 0) ? [step($"player.signal gamepad.rightStick {(turnSign(from, to) * turnRest(from, to))} 0", 1)] : []),
  [step("player.signal gamepad.rightStick 0 0", 3)]
)

// A leg: turn from the heading the body faces to the leg's, then hold the stick for the leg's ticks at its pace.
function legTicks(pace, metres) = floor((metres * pace.ticksPerMetre) + 0.5)
function leg(pace, from, to, metres) = concat(
  turn(from, to),
  [step(pace.shift, 0)],
  map(range(0, floor(legTicks(pace, metres) / routeChunk)), chunk => step(stickForward, routeChunk)),
  (((legTicks(pace, metres) % routeChunk) > 0) ? [step(stickForward, (legTicks(pace, metres) % routeChunk))] : [])
)
// Standing: turn to a heading and hold the stick at rest for a number of ticks (a player looking at something).
function stand(from, to, ticks) = concat(turn(from, to), [step(stickRest, ticks)])

// A chapter's start: the body set down at a point (its heading held), first person, and a second standing.
function start(x, y, z) = [step($"body.pose {x} {y} {z} - - - 0", 1), step("player.camera.view first", 9), step(stickRest, 30)]
let finish = [step(stickRest, 10), step(shiftRelease, 20)]
function lines(program) = map(program, s => s.line)
function waits(program) = map(program, s => s.wait)

// Chapter 1: from the stage spawn across the valley floor and through the hall's south entrance (x 14 .. 18 at z 12)
// into the gallery hall, running. Starts facing 0, ends facing 202.
let stageToHall = concat(
  start(0, 0.02, 0),
  leg(run, 0, 235, 18),
  leg(run, 235, 202, 9.2),
  finish
)
test "baseline: the stage into the gallery hall" {
  when {
    for (line, index) in lines(stageToHall) {
      seat1: {line}
      repeat waits(stageToHall)[index] {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: inside the hall past the entrance, about (18.1, 18.9) on the owner's walk, standing.
    bodyPosition(body, 0, x) > 15.5
    bodyPosition(body, 0, x) < 21
    bodyPosition(body, 0, z) > 16
    bodyPosition(body, 0, z) < 22
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    fact(body, 0, Grounded) == 1
  }
}

// Chapter 2: east along the hall, then north-east through the east wing's portal (about x 66.7, z 33.8), which carries
// the body back to about x 40 on the wing's far side; the run carries on east through the arrival. Starts facing 202,
// ends facing 270.
let eastWingPortal = concat(
  start(18.1, 0.07, 18.9),
  leg(run, 202, 270, 24.3),
  leg(run, 270, 238, 28.7),
  leg(run, 238, 270, 10),
  finish
)
test "baseline: the east wing's portal" {
  when {
    for (line, index) in lines(eastWingPortal) {
      seat1: {line}
      repeat waits(eastWingPortal)[index] {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: past the portal's far side, heading east along z 34.7, about (50.5, 34.7) on the owner's walk.
    bodyPosition(body, 0, x) > 44
    bodyPosition(body, 0, x) < 59
    bodyPosition(body, 0, z) > 32.5
    bodyPosition(body, 0, z) < 37
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    fact(body, 0, Grounded) == 1
  }
}

// Chapter 3: back west along the hall to the lobby, running; then walking to the machines by the wonderland portal,
// standing at them for eight seconds, stepping up to a metre short of the portal's threshold (about x 2, z 30.8, where
// wonderland shrinks the body) for four, and walking back east into the lobby. Starts facing 270, ends facing 270.
let lobbyAndWonderland = concat(
  start(59.2, 0.07, 29.3),
  leg(run, 270, 76, 15.6),
  leg(run, 76, 91, 19.9),
  leg(run, 91, 100, 9.5),
  leg(walk, 100, 126, 7.2),
  leg(walk, 126, 120, 2.4),
  stand(120, 64, 240),
  leg(walk, 64, 104, 4),
  stand(104, 104, 120),
  leg(walk, 104, 270, 13.5),
  finish
)
test "baseline: the lobby and the wonderland portal" {
  when {
    for (line, index) in lines(lobbyAndWonderland) {
      seat1: {line}
      repeat waits(lobbyAndWonderland)[index] {
        ticks 1
      }
    }
  }
  expect {
    // Arrival: back in the lobby, about (16.5, 30.9) on the owner's walk, standing.
    bodyPosition(body, 0, x) > 13.5
    bodyPosition(body, 0, x) < 19.5
    bodyPosition(body, 0, z) > 28.5
    bodyPosition(body, 0, z) < 33.5
    bodyPosition(body, 0, y) > 0
    bodyPosition(body, 0, y) < 0.2
    fact(body, 0, Grounded) == 1
  }
}
