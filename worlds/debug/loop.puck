// The loop shaft: a portal in the floor and its counterpart in the ceiling directly above, both in the debug world
// itself, so a body that steps onto the floor glass drops out of the ceiling glass still falling, and falls through
// the floor again, forever. The debug world imports this file whole. The shaft stands on the open ground south-west of
// the spawn, clear of the device row (z -6) and the portal frame (3, 0, -8):
//
//   (-20, 0, -20)   the floor glass, facing up
//   (-20, 6, -20)   the ceiling glass, facing down
//
// Both faces name the destination `loop`, which references the debug world's own document, so the transfer resolves
// to the running World rather than a second copy of it. loop.md beside this file says how to get in, what to watch
// and how to get out.

let loopX = -20
let loopZ = -20
let loopHeight = 6

let loopGold = "#C9A43A"
let loopPost = "#3A3F47"
// What a glass shows past the deepest level of windows inside windows.
let loopFallback = "#FF00FF"

// Shape rotations, as authored quaternions [x, y, z, w]: a quarter turn about +X lays a pad's glass (its +Z face) flat.
// The floor turns it to face up and the ceiling to face down; the ceiling placement's half turn about up then lines
// its right and up axes with the floor's, so a crossing keeps the traveller's heading.
let faceUp = [-0.707107, 0, 0, 0.707107]
let faceDown = [0.707107, 0, 0, 0.707107]

// A gilt square rim round an open aperture, laid flat by `rotation`. Face 0, the rim, carries the glass.
template loopPad(label, rotation) {
  behavior {
    faces [{ name: "glass", shapeId: 0 }]
  }
  name: label
  palette [{ color: loopGold, roughness: 0.4, specular: 0.4 }]
  schema: "puck.creation.v1"
  shape Box "rim" {
    material: 0
    position [0, 0, 0]
    rotation: rotation
    scale [1.25, 1.25, 0.06]
  }
  shape Box "opening" {
    blend: Subtraction
    material: 0
    position [0, 0, 0]
    rotation: rotation
    scale [1.1, 1.1, 0.3]
  }
}

// The debug world names its own document, so a door can lead back into the world that stands it.
references [
  {
    document: "debug"
    name: "self"
  }
]

destinations [
  {
    durability: persisted
    name: "loop"
    reference: "self"
    scope: global
  }
]

placements {
  placement "loop-floor" {
    prototype: "loop-floor"
    position [loopX, 0, loopZ]
    // Either glass is a door onto the other and a window showing what lies past it, through the debug world's own
    // `loop` destination.
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "loop-ceiling/glass"
          destination: "loop"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "loop"
          fallback: loopFallback
          projection: window
        }
      }
    ]
  }

  placement "loop-ceiling" {
    prototype: "loop-ceiling"
    position [loopX, loopHeight, loopZ]
    yawDegrees: 180
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "loop-floor/glass"
          destination: "loop"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "loop"
          fallback: loopFallback
          projection: window
        }
      }
    ]
  }

  placement "loop-posts" {
    prototype: "loop-posts"
    position [loopX, 0, loopZ]
  }
}

prototypes {
  prototype "loop-floor" {
    document {
      loopPad(label: "loop-floor", rotation: faceUp)
    }
  }

  prototype "loop-ceiling" {
    document {
      loopPad(label: "loop-ceiling", rotation: faceDown)
    }
  }

  // Four corner posts from the floor glass to the ceiling glass, so the shaft reads as one from outside and its
  // height shows while falling. They are not solid: a body falls between them untouched.
  prototype "loop-posts" {
    document {
      name: "loop-posts"
      palette [{ color: loopPost, roughness: 0.85 }]
      schema: "puck.creation.v1"
      shape Box "post-ne" {
        material: 0
        position [1.4, (loopHeight / 2), 1.4]
        scale [0.08, (loopHeight / 2), 0.08]
      }
      shape Box "post-nw" {
        material: 0
        position [-1.4, (loopHeight / 2), 1.4]
        scale [0.08, (loopHeight / 2), 0.08]
      }
      shape Box "post-se" {
        material: 0
        position [1.4, (loopHeight / 2), -1.4]
        scale [0.08, (loopHeight / 2), 0.08]
      }
      shape Box "post-sw" {
        material: 0
        position [-1.4, (loopHeight / 2), -1.4]
        scale [0.08, (loopHeight / 2), 0.08]
      }
    }
  }
}
