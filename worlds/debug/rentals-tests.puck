// The toybox's handheld rentals (gallery/rentals.puck), booted in the whole debug world: `puck test
// worlds/debug/rentals-tests.puck --reproduce`. Seat 1's body (body 0) rents the brick before it on the south-east
// stall's west arm, which puts the device on loan to it and starts its pool brick (`rental-hgb-0`, through the
// machine's `runsWhen`), then returns it at the stall's tray, which clears the loan and stops the brick where it stood.
// Which brick it rents is whichever reach the body settles in, so the claims read the device it holds.
// The brick's divider register (DIV, 0xFF04) counts while it runs and holds still while it does not, read through the
// pool brick's own screen (screen 40, body 0's brick, which its device carries).
//
// Positions are world coordinates with the building at layout.puck's `gallerySite`: the south-east stall's corner
// stands at (66.725, 18.775), the west arm's bricks run south of it, and the tray's floor is at (65.975, 19.525), on
// level 1's floor (4.55).
schema: "puck.world.definition.v1"
basis: "debug"
// Keep same-world portals in this fixture's boot instance instead of opening another live debug world.
documentId: "debug"
import "stopped-machines"

// Every other machine stays stopped; seat 1's pool brick runs whenever its runsWhen holds.
machines [
  { name: "rental-hgb-0", running: true }
]

state {
  world {
    table rentalProbe {
      running0 = 0
      running1 = 0
      stopped0 = 0
      stopped1 = 0
      loan = 0
      held = 0
      model = 0
      returned = -1
    }
  }
}

rule "probe-running-0" {
  when $tick == 50
  mode: Edge
  rentalProbe.running0 = machine(40, 65284)
  rentalProbe.loan = rentalLoan[rentalHeld["0"]]
  rentalProbe.held = rentalHeld["0"]
  rentalProbe.model = rentalModel["0"]
}
rule "probe-running-1" {
  when $tick == 60
  mode: Edge
  rentalProbe.running1 = machine(40, 65284)
}
rule "probe-stopped-0" {
  when $tick == 100
  mode: Edge
  rentalProbe.stopped0 = machine(40, 65284)
  rentalProbe.returned = rentalLoan[rentalProbe.held]
}
rule "probe-stopped-1" {
  when $tick == 110
  mode: Edge
  rentalProbe.stopped1 = machine(40, 65284)
}

test "a rented brick runs while held and stops back in its cubby" {
  when {
    seat1: body.pose 65.975 4.6 17.45 0 0 0 0
    ticks 30
    seat1: body.press interact 1 0.2 0
    ticks 40
    seat1: body.pose 65.975 4.6 19.525 0 0 0 0
    ticks 10
    seat1: body.press interact 1 0.2 0
    ticks 50
  }
  expect {
    rentalProbe.loan == 1
    rentalProbe.held > 0
    rentalProbe.model == 1
    rentalProbe.running0 != rentalProbe.running1
    rentalProbe.stopped0 == rentalProbe.stopped1
    rentalProbe.returned == 0
    rentalHeld["0"] == 0
    rentalModel["0"] == 0
  }
}
