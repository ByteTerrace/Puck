// The valley: the debug world's floor is the flat bottom of a caldera whose walls rise close around it. Eight
// sectors ring the floor, one creation and one solid placement each, so each is edited and baked on its own: a main
// mass and two shoulders from the standard terrain library (../standard/terrain.puck), with fBm relief seeded per
// sector. The floor (lawn.puck's "floor") runs on under the walls, so no slab edge shows. An overlook deck stands
// near the summit of the south-west sector, and a body that falls out of the world is stood back up on the floor
// below the sector it fell from, not at one global spawn. docs/plans/valley-and-moons.md records the bake, contact
// and audit numbers it was measured at.
//
//   compass 0 is world +Z (north), 90 world +X (east)
//   the floor is clear to the walls' feet, 205 to 230 m from the origin: every exhibit, the hall, the studio, the
//   camera course, the devices and the rate range (x -112, z 118 at its far corner, 163 m out) stand inside 170 m
//   the combat yard (north, x 24 .. 50, z 40 .. 66) and the climate wing (east, x 72 .. 122, z 12 .. 28) are
//   reserved on the floor; nothing here stands there

import "../standard/terrain"
import "valley-form"
import "water-site"
import "glacier-site"

let valleyRock = 0
let valleyDeck = 1

// The walls' rock (valley.md): Study B's warm stratified canyon, from the standard's terrain program. A terracotta face
// deepens toward the foot, so the walls hold value from the floor to the rim; every 23 m a pale stratum caps a dark one;
// and turf holds every ledge and top flat enough for it. The strata and the ledges' edges wander with the breakup, so no
// line runs ruler-straight round the ring. No band reads curvature: it comes from the baked normals, and at the
// sectors' 2 to 4 m bake cell it changes per triangle, scattering a curvature band into flecks (valley.md).
let valleyRockBase = { color: "#C06A43", roughness: 0.95, specular: 0.02 }
let valleyRockBands = [
  terrainBand("#8E4730", amount: 0.55, altitude: [0 - terrainOpen, 60], altitudeWidth: 80)
  terrainBand("#7A3A28", amount: 0.45, period: 23, altitude: [5, 14], altitudeWidth: 4)
  terrainBand("#E0A072", amount: 0.5, period: 23, altitude: [14, 16.5], altitudeWidth: 1.5)
  terrainBand("#6E8A36", amount: 0.95, roughness: 0.98, specular: 0.015, slope: [0 - terrainOpen, 31], slopeWidth: 8)
]
let valleyRockBreakup = { scale: 0.06, jitter [10, 7, 0], variation: 0.14, seed: 6151 }

// The overlook: a deck at deckHeight on the south-west sector's inner face, standing out over the floor. The face's
// distance from the centre at that height follows the main mass's ellipse (terrainMass, exponent 2).
let overlookSector = { compass: 225, foot: 215, peak: 360, radial: 280 }
let deckHeight = 345
let overlookHalfHeight = (overlookSector.peak / (1 - valleySink))
let overlookCentre = (overlookSector.foot + (overlookSector.radial * squareRoot((1 - (valleySink * valleySink)))))
let overlookRise = ((deckHeight + (overlookHalfHeight * valleySink)) / overlookHalfHeight)
let overlookFace = (overlookCentre - (overlookSector.radial * squareRoot((1 - (overlookRise * overlookRise)))))
// The deck's radial half-depth, its across half-width, and how far its inner edge stands out from the face.
let deckDepth = 14
let deckWidth = 18
let deckReach = 10
// The parapet's half thickness: the bake refines a plate to its half thickness (mesh-bake.md), so a thin rail refines
// the whole overlook union to it.
let parapetHalf = 0.3

// One degree of compass in radians, pi / 180.
let compassRadians = 3.141592653589793 / 180

// Each sector's recovery wedge, compass - 22.5 .. compass + 22.5: a point (x, z) lies in it where
// x·cos(a) − z·sin(a) ≥ 0 at the wedge's first edge a and < edge at its second, the north wedge's edge a hair over 0 so
// that the origin itself lies in exactly one wedge.
let valleyWedges = map(
  valleySectors,
  (sector, index) => {
    name: sector.name
    c1: cosine(((sector.compass - 22.5) * compassRadians))
    s1: sine(((sector.compass - 22.5) * compassRadians))
    c2: cosine(((sector.compass + 22.5) * compassRadians))
    s2: sine(((sector.compass + 22.5) * compassRadians))
    edge: ((index == 0) ? 0.001 : 0)
  }
)

// The floor spot a fallen body is stood back on: 190 m out toward its sector, facing the centre. The north-west's spot
// stands 15 degrees round toward north, still inside its wedge, since on the sector's own bearing the spot lies in the
// falls' plunge basin (water-site.puck's plungeHole) and would stand a recovered body in the water.
let recoveryRadius = 190
function recoveryCompass(sector) = ((sector.name == "north-west") ? (sector.compass + 15) : sector.compass)
// Where the `glacier` place stands: metres up the glacier's ramp from the lake, metres beside the trough's axis, and a
// height at or over the moraine's crest there.
let glacierWatch = { s: 40, across: 25, ground: 361.2 }

spawnPoints: concat(
  map(
    valleySectors,
    sector => {
      id: $"valley-{sector.name}"
      position [
        (recoveryRadius * sine((recoveryCompass(sector) * compassRadians)))
        0.05,
        (recoveryRadius * cosine((recoveryCompass(sector) * compassRadians)))
      ]
      yawDegrees: recoveryCompass(sector)
    }
  ),
  [
    {
      id: "overlook"
      position [
        (((overlookFace - deckReach) + 4) * sine((overlookSector.compass * compassRadians))),
        (deckHeight + 0.05),
        (((overlookFace - deckReach) + 4) * cosine((overlookSector.compass * compassRadians)))
      ]
      yawDegrees: overlookSector.compass
    }
    // The glacier (glacier-site.puck): on the moraine's crest `glacierWatch.across` metres beside the trough's axis,
    // `glacierWatch.s` metres up its ramp from the lake, facing across the trough, so the chase camera behind her looks
    // down onto the ice with the trough running left and right of her. The height stands at or a little over the moraine's
    // heaps there, so a body set on it settles onto the drawn relief.
    {
      id: "glacier"
      position [
        ((rampPoint(glacierWatch.s, 0, 0)[2] * sine((wallSector.compass * compassRadians))) +
          (glacierWatch.across * cosine((wallSector.compass * compassRadians)))),
        glacierWatch.ground,
        ((rampPoint(glacierWatch.s, 0, 0)[2] * cosine((wallSector.compass * compassRadians))) -
          (glacierWatch.across * sine((wallSector.compass * compassRadians))))
      ]
      yawDegrees: (wallSector.compass - 270)
    }
  ]
)

placements {
  for sector in valleySectors {
    placement $"valley-{sector.name}" {
      prototype: $"valley-{sector.name}"
      position [0, 0, 0]
      yawDegrees: (sector.compass + terrainYaw)
      solid
    }
  }

  placement "valley-overlook" {
    prototype: "valley-overlook"
    position [0, 0, 0]
    yawDegrees: (overlookSector.compass + terrainYaw)
    solid
  }
}

// The relief masks of the sector named `name`: one over every bowl and cut it carves, or none when it carves nothing.
function sectorCarveMasks(name) = length(filter(valleyBasins, b => b.sector == name)) +
  length(filter(valleyCuts, c => c.sector == name)) >
  0 ? [terrainCarveMask(filter(valleyBasins, b => b.sector == name), filter(valleyCuts, c => c.sector == name))] : []

prototypes {
  for sector in valleySectors {
    prototype $"valley-{sector.name}" {
      document {
        name: $"valley-{sector.name}"
        schema: "puck.creation.v1"
        palette: concat(
          [terrainMaterial(valleyRockBase, valleyRockBands, valleyRockBreakup)],
          sector.name == "north-west" ? wallPalette : []
        )
        // The relief stays out of the bowls and cuts the sector carves (water-site.puck's valleyBasins, glacier-site.puck's
        // valleyCuts), so the lake's water, lining and stones and the glacier's ice, placed from the analytic carves, sit
        // on the rock the bake draws and contact reads.
        terrainRelief(seed: sector.seed, masks: sectorCarveMasks(sector.name))
        terrainMass(
          label: "main",
          foot: sector.foot,
          peak: sector.peak,
          radial: sector.radial,
          across: sector.across,
          sink: valleySink,
          material: valleyRock
        )
        terrainMass(
          label: "shoulder-left",
          foot: (sector.foot + 40),
          peak: (sector.peak * 0.78),
          radial: (sector.radial * 0.8),
          across: (sector.across * 0.6),
          offset: (sector.across * 0.75),
          sink: valleySink,
          material: valleyRock
        )
        terrainMass(
          label: "shoulder-right",
          foot: (sector.foot + 25),
          peak: (sector.peak * 0.86),
          radial: (sector.radial * 0.75),
          across: (sector.across * 0.55),
          offset: (0 - (sector.across * 0.75)),
          sink: valleySink,
          material: valleyRock
        )
        for ridge in filter(valleyRidges, r => r.sector == sector.name) {
          terrainMass(
            label: ridge.label,
            foot: ridge.foot,
            peak: ridge.peak,
            radial: ridge.radial,
            across: ridge.across,
            offset: ridge.offset,
            sink: valleySink,
            material: valleyRock
          )
        }
        for basin in filter(valleyBasins, b => b.sector == sector.name) {
          terrainBasin(label: basin.label, lateral: basin.lateral, radial: basin.radial, y: basin.y, radii: basin.radii)
        }
        for cut in filter(valleyCuts, c => c.sector == sector.name) {
          terrainCut(cut: cut)
        }
        for mound in filter(valleyMounds, m => m.sector == sector.name) {
          shape Superellipsoid $"{mound.label}" {
            exponent: mound.exponent
            material: mound.material
            position: mound.position
            scale: mound.radii
            rotation: mound.rotation
          }
        }
        terrainFloorCut(top: (maximum(sector.peak, sector.name == "north-west" ? glacierRidge.peak : 0) + 30))
      }
    }
  }

  // The overlook's deck and its parapet, cantilevered from the south-west face, in the sector's frame (author +Z
  // out from the centre). No relief, so the deck collides where it is drawn.
  prototype "valley-overlook" {
    document {
      name: "valley-overlook"
      schema: "puck.creation.v1"
      palette [
        {
          color: "#7D7366"
          roughness: 0.95
          specular: 0.02
        }
        {
          color: "#9A958B"
          roughness: 0.85
          specular: 0.03
        }
      ]
      shape Box "deck" {
        material: valleyDeck
        position [0, (deckHeight - 1), ((overlookFace - deckReach) + deckDepth)]
        scale [deckWidth, 1, deckDepth]
      }
      shape Box "parapet-front" {
        material: valleyDeck
        position [0, (deckHeight + 0.55), ((overlookFace - deckReach) + parapetHalf)]
        scale [deckWidth, 0.55, parapetHalf]
      }
      shape Box "parapet-left" {
        material: valleyDeck
        position [(deckWidth - parapetHalf), (deckHeight + 0.55), ((overlookFace - deckReach) + deckDepth)]
        scale [parapetHalf, 0.55, deckDepth]
      }
      shape Box "parapet-right" {
        material: valleyDeck
        position [(parapetHalf - deckWidth), (deckHeight + 0.55), ((overlookFace - deckReach) + deckDepth)]
        scale [parapetHalf, 0.55, deckDepth]
      }
    }
  }
}

// Forty metres under the floor a body is out of the world, whichever way it got there (a wall's outer face, a
// seam): the rule stands it back up on the floor below the sector it fell from.
let recoveryFloor = -40

rule "fall-recovery" {
  when bodyPosition(each, y) < recoveryFloor
  mode: Level
  forEach: $bodies
  for wedge in valleyWedges {
    if ((bodyPosition(each, x) * wedge.c1) - (bodyPosition(each, z) * wedge.s1)) >= 0 and (
        (bodyPosition(each, x) * wedge.c2) - (bodyPosition(each, z) * wedge.s2)
      ) < wedge.edge {
      pose(key: $each, spawnPoint: $"valley-{wedge.name}")
    }
  }
}
