// The on-screen controls of the worlds the Moth walks: the drawn cursor, the icons every badge and action draws, the
// standard controller bar over the Moth's own controls (`avatars/moth.puck`'s `bare` overlay), its five pages, and the
// play wheel with its rings. The debug world, the garden and the night field import it beside the theme, so a seat keeps
// its bar and wheel through the portal:
//
//   import "theme"
//   import "controls"
//
// The bar shows the page the seat holds. Nothing held is the Moth's own controls (Move); holding the left trigger (Z) is
// the View page, the right trigger (X) the Debug page, the left then the right trigger the Go page and the right then the
// left trigger the Tour page, pressed in that order: the press order picks the page, so the two double squeezes are two
// pages. Every page binds the bar's twelve controls; the Go and Tour pages bind the debug world's places and gallery
// (pad.puck) and read empty elsewhere. The View page is the old look modifier's: camera layouts, autorun and autofly on the
// stick presses, recenter, free look and the engaged screen's frame toggle. The suit toggle sits on the Debug page
// (suit.puck). The Debug page also holds the capture to the state root's screenshots folder, the history switch and the
// inspector; the render levers (quality, update rates) sit on the Tour page. LB on Move opens the play wheel and wears its
// icon; RB on Move is the context button.
//
// Hold Tab (or LB) to open the play wheel, aim it with the mouse (or the right stick) and release to run the sector
// under the pointer; releasing at the hub cancels. The wheel has three rings, Act, View and Places (Places in the debug
// world alone): the arrow keys or the d-pad's up and down, or the mouse wheel, step the ring while it is open. Every action
// icon is ordinary state: a plate's icon is `state.barIcons.<entry id>`, a sector's label and icon
// `state.wheelLabels.<sector id>` and `state.wheelIcons.<sector id>`, each naming a row of `icons`.

import "pad-kit"

// What an importer binds: the rows the play wheel reads its sectors' labels and icons from, which pad.puck's wheel names.
exports {
  bindings [wheelLabels, wheelIcons]
}

let mono = "jetbrains-mono-regular"

let standardAnchor = { edge: "Bottom", inset: 3.6 }

let standardPieces = [
  { table: "left", at [0, 0] }
  { table: "right", at [0, 0] }
]

// The cursor and the bar stay up while the seat is playing and fade a second after six seconds without input. Both
// step aside while the seat's view frames an engaged screen, so the framed screen shows its picture alone (the held view
// of a carried screen shows the bar, whose Frame control switches to the picture), and the bar steps aside
// while a wheel is open, whose hold page is no page of the bar's.
let shownWhilePlaying = {
  $type: "all"
  predicates [
    {
      $type: "recently"
      fact: SeatInput
      windowSeconds: 6
      fadeSeconds: 1
    }
    { $type: "not", predicate { $type: "now", fact: ScreenFramed } }
    { $type: "not", predicate { $type: "now", fact: WheelOpen } }
  ]
}

hud {
  defaults {
    enabled: true
    // A small ring drawn at the pointer for three seconds after it moves, lit in the accent while it hovers something
    // within 48 m.
    cursor {
      hoverRadius: 48
      sizePx: 7
      role: TextPrimary
      visible {
        $type: "all"
        predicates [
          {
            $type: "recently"
            fact: PointerMotion
            windowSeconds: 3
            fadeSeconds: 0.5
          }
          { $type: "not", predicate { $type: "now", fact: ScreenFramed } }
        ]
      }
    }
  }
}

icons {
  rows [
    // Key caps.
    { name: "key.w", label: "W" }
    { name: "key.a", label: "A" }
    { name: "key.s", label: "S" }
    { name: "key.d", label: "D" }
    { name: "key.e", label: "E" }
    { name: "key.f", label: "F" }
    { name: "key.g", label: "G" }
    { name: "key.q", label: "Q" }
    { name: "key.v", label: "V" }
    { name: "key.b", label: "B" }
    { name: "key.equals", label: "=" }
    { name: "key.minus", label: "-" }
    { name: "key.1", label: "1" }
    { name: "key.2", label: "2" }
    { name: "key.3", label: "3" }
    { name: "key.4", label: "4" }
    { name: "key.5", label: "5" }
    { name: "key.f2", label: "F2" }
    { name: "key.f3", label: "F3" }
    { name: "key.f4", label: "F4" }
    { name: "key.z", label: "Z" }
    { name: "key.x", label: "X" }
    { name: "key.space", glyph { font: mono, glyph: "U+2423" } }
    { name: "key.ctrl", glyph { font: mono, glyph: "U+2303" } }
    { name: "key.tab", glyph { font: mono, glyph: "U+21E5" } }
    { name: "mouse.left", label: "LM" }
    { name: "mouse.right", label: "RM" }

    // Pad buttons: the Xbox letters by default, with the PlayStation shapes and the Switch's swapped letters.
    { name: "pad.a", label: "A" }
    { name: "pad.b", label: "B" }
    { name: "pad.x", label: "X" }
    { name: "pad.y", label: "Y" }
    { name: "pad.cross", glyph { font: mono, glyph: "U+2715" } }
    { name: "pad.circle", glyph { font: mono, glyph: "U+25CB" } }
    { name: "pad.square", glyph { font: mono, glyph: "U+25A1" } }
    { name: "pad.triangle", glyph { font: mono, glyph: "U+25B3" } }
    { name: "pad.lb", label: "LB" }
    { name: "pad.l1", label: "L1" }
    { name: "pad.l", label: "L" }
    { name: "pad.rb", label: "RB" }
    { name: "pad.r1", label: "R1" }
    { name: "pad.r", label: "R" }
    { name: "pad.l3", label: "L3" }
    { name: "pad.r3", label: "R3" }
    { name: "pad.back", label: "BK" }
    { name: "pad.minus", label: "-" }
    { name: "pad.lt", label: "LT" }
    { name: "pad.l2", label: "L2" }
    { name: "pad.zl", label: "ZL" }
    { name: "pad.rt", label: "RT" }
    { name: "pad.r2", label: "R2" }
    { name: "pad.zr", label: "ZR" }

    // Arrows, for the d-pad and for movement.
    { name: "arrow.up", glyph { font: mono, glyph: "U+2191" } }
    { name: "arrow.down", glyph { font: mono, glyph: "U+2193" } }
    { name: "arrow.left", glyph { font: mono, glyph: "U+2190" } }
    { name: "arrow.right", glyph { font: mono, glyph: "U+2192" } }

    // Actions.
    { name: "act.turnLeft", glyph { font: mono, glyph: "U+21A9" } }
    { name: "act.turnRight", glyph { font: mono, glyph: "U+21AA" } }
    { name: "act.move", glyph { font: mono, glyph: "U+2295" } }
    { name: "act.look", glyph { font: mono, glyph: "U+25CE" } }
    { name: "act.recenter", glyph { font: mono, glyph: "U+2302" } }
    { name: "act.orbit", glyph { font: mono, glyph: "U+25CC" } }
    { name: "act.steer", glyph { font: mono, glyph: "U+279C" } }
    { name: "act.flight", glyph { font: mono, glyph: "U+26A1" } }
    { name: "act.rise", glyph { font: mono, glyph: "U+25B2" } }
    { name: "act.descend", glyph { font: mono, glyph: "U+25BC" } }
    { name: "act.jump", glyph { font: mono, glyph: "U+21A5" } }
    { name: "act.camera1", label: "C1" }
    { name: "act.camera2", label: "C2" }
    { name: "act.camera3", label: "C3" }
    { name: "act.camera4", label: "C4" }
    { name: "act.camera5", label: "C5" }
    { name: "act.annotate", glyph { font: mono, glyph: "U+22A1" } }
    { name: "act.isolate", glyph { font: mono, glyph: "U+25C9" } }
    { name: "act.build", glyph { font: mono, glyph: "U+229E" } }
    { name: "act.console", label: ">_" }
    { name: "act.where", glyph { font: mono, glyph: "U+25C8" } }
    { name: "act.channels", glyph { font: mono, glyph: "U+2261" } }
    { name: "act.respawn", glyph { font: mono, glyph: "U+23CE" } }
    { name: "act.interact", glyph { font: mono, glyph: "U+25C7" } }
    { name: "act.desktop", glyph { font: mono, glyph: "U+25E8" } }
    { name: "act.play", glyph { font: mono, glyph: "U+25A0" } }
    // The gallery's keys (hall.puck): the next and previous exhibit, flagging and slicing the one at hand, the debug view.
    { name: "act.next", label: ">" }
    { name: "act.prev", label: "<" }
    { name: "act.flag", label: "!" }
    { name: "act.view", label: "DV" }
    { name: "act.slice", label: "SL" }
    { name: "act.wheel", label: "WH" }
    { name: "act.run", glyph { font: mono, glyph: "U+00BB" } }
    { name: "act.autorun", label: "AR" }
    { name: "act.fly", glyph { font: mono, glyph: "U+21D1" } }
    { name: "act.autofly", label: "AF" }
    { name: "act.frame", label: "FM" }
    // The View page and ring: the chase view and the inspection layouts, the camera, the close-ups.
    { name: "view.play", label: "PL" }
    { name: "view.quarter", label: "3Q" }
    { name: "view.front", label: "FR" }
    { name: "view.rear", label: "RE" }
    { name: "view.wide", label: "WD" }
    { name: "view.auto", label: "AU" }
    { name: "view.face", label: "FC" }
    // The Debug page: the inspector panel, the frame comparison, stopping, the suit.
    { name: "dbg.inspect", label: "IN" }
    { name: "dbg.inspectOff", label: "IO" }
    { name: "dbg.hold", label: "HO" }
    { name: "dbg.split", label: "SP" }
    { name: "dbg.clear", label: "CL" }
    { name: "dbg.stop", label: "ST" }
    { name: "dbg.suit", label: "SU" }
    { name: "dbg.capture", label: "CP" }
    { name: "dbg.history", label: "HI" }
    { name: "dbg.quality", label: "QU" }
    { name: "dbg.rates", label: "RA" }
    // The Go page and the Places ring: the debug world's places.
    { name: "go.stage", label: "SG" }
    { name: "go.hero", label: "HR" }
    { name: "go.gallery", label: "GL" }
    { name: "go.portals", label: "PT" }
    { name: "go.wonderland", label: "WL" }
    { name: "go.devices", label: "DE" }
    { name: "go.chess", label: "CS" }
    { name: "go.desktop", label: "DK" }
    { name: "go.level0", label: "L0" }
    { name: "go.level1", label: "L1" }
    { name: "go.level2", label: "L2" }
    { name: "go.level3", label: "L3" }
    // The Tour page: the gallery's lights and motion, and the paintings.
    { name: "tour.lightsOff", label: "L-" }
    { name: "tour.lightsOn", label: "L+" }
    { name: "tour.motionOff", label: "M0" }
    { name: "tour.motionOn", label: "M1" }
    { name: "tour.garden", label: "PG" }
    { name: "tour.night", label: "PN" }
  ]

  // Which cap each physical control wears on the bar, its modifier row and the build bar.
  badges [
    { source: "keyboard.w", icon: "key.w" }
    { source: "keyboard.a", icon: "key.a" }
    { source: "keyboard.s", icon: "key.s" }
    { source: "keyboard.d", icon: "key.d" }
    { source: "keyboard.e", icon: "key.e" }
    { source: "keyboard.f", icon: "key.f" }
    { source: "keyboard.g", icon: "key.g" }
    { source: "keyboard.q", icon: "key.q" }
    { source: "keyboard.v", icon: "key.v" }
    { source: "keyboard.b", icon: "key.b" }
    { source: "keyboard.equals", icon: "key.equals" }
    { source: "keyboard.minus", icon: "key.minus" }
    { source: "keyboard.1", icon: "key.1" }
    { source: "keyboard.2", icon: "key.2" }
    { source: "keyboard.3", icon: "key.3" }
    { source: "keyboard.4", icon: "key.4" }
    { source: "keyboard.5", icon: "key.5" }
    { source: "keyboard.f2", icon: "key.f2" }
    { source: "keyboard.f3", icon: "key.f3" }
    { source: "keyboard.f4", icon: "key.f4" }
    { source: "keyboard.space", icon: "key.space" }
    { source: "keyboard.controlLeft", icon: "key.ctrl" }
    { source: "keyboard.tab", icon: "key.tab" }
    { source: "keyboard.z", icon: "key.z" }
    { source: "keyboard.x", icon: "key.x" }
    {
      source: "gamepad.leftTrigger"
      icon: "pad.lt"
      overrides [{ family: "PlayStation5", icon: "pad.l2" }, { family: "SwitchPro", icon: "pad.zl" }]
    }
    {
      source: "gamepad.rightTrigger"
      icon: "pad.rt"
      overrides [{ family: "PlayStation5", icon: "pad.r2" }, { family: "SwitchPro", icon: "pad.zr" }]
    }
    { source: "mouse.button1", icon: "mouse.left" }
    { source: "mouse.button2", icon: "mouse.right" }
    {
      source: "gamepad.buttonSouth"
      icon: "pad.a"
      overrides [{ family: "PlayStation5", icon: "pad.cross" }, { family: "SwitchPro", icon: "pad.b" }]
    }
    {
      source: "gamepad.buttonEast"
      icon: "pad.b"
      overrides [{ family: "PlayStation5", icon: "pad.circle" }, { family: "SwitchPro", icon: "pad.a" }]
    }
    {
      source: "gamepad.buttonWest"
      icon: "pad.x"
      overrides [{ family: "PlayStation5", icon: "pad.square" }, { family: "SwitchPro", icon: "pad.y" }]
    }
    {
      source: "gamepad.buttonNorth"
      icon: "pad.y"
      overrides [{ family: "PlayStation5", icon: "pad.triangle" }, { family: "SwitchPro", icon: "pad.x" }]
    }
    {
      source: "gamepad.leftShoulder"
      icon: "pad.lb"
      overrides [{ family: "PlayStation5", icon: "pad.l1" }, { family: "SwitchPro", icon: "pad.l" }]
    }
    {
      source: "gamepad.rightShoulder"
      icon: "pad.rb"
      overrides [{ family: "PlayStation5", icon: "pad.r1" }, { family: "SwitchPro", icon: "pad.r" }]
    }
    { source: "gamepad.leftStickPress", icon: "pad.l3" }
    { source: "gamepad.rightStickPress", icon: "pad.r3" }
    {
      source: "gamepad.back"
      icon: "pad.back"
      overrides [{ family: "SwitchPro", icon: "pad.minus" }]
    }
    { source: "gamepad.dpadUp", icon: "arrow.up" }
    { source: "gamepad.dpadDown", icon: "arrow.down" }
    { source: "gamepad.dpadLeft", icon: "arrow.left" }
    { source: "gamepad.dpadRight", icon: "arrow.right" }
  ]
}

state {
  world {
    // The icon each Moth control's plate shows, by its binding entry id.
    table barIcons {
      forward = "arrow.up"
      back = "arrow.down"
      left = "arrow.left"
      right = "arrow.right"
      turnLeft = "act.turnLeft"
      turnRight = "act.turnRight"
      move = "act.move"
      look = "act.look"
      recenter = "act.recenter"
      orbit = "act.orbit"
      steer = "act.steer"
      flight = "act.flight"
      rise = "act.rise"
      run = "act.run"
      runToggle = "act.run"
      fly = "act.fly"
      frame = "act.frame"
      descend = "act.descend"
      jump = "act.jump"
      interact = "act.interact"
      camera1 = "act.camera1"
      camera2 = "act.camera2"
      camera3 = "act.camera3"
      camera4 = "act.camera4"
      camera5 = "act.camera5"
      annotate = "act.annotate"
      jetpackAlone = "act.isolate"
      build = "act.build"
      respawn = "act.respawn"
      galleryNext = "act.next"
      galleryPrev = "act.prev"
      galleryFlag = "act.flag"
      galleryView = "act.view"
      gallerySlice = "act.slice"

      // A wheel's opener, keyed by the page it opens: a plate whose hold opens that page wears the icon (LB opens the play
      // wheel).
      "wheel-pad" = "act.wheel"

      // The View page.
      viewPlay = "view.play"
      viewQuarter = "view.quarter"
      viewFront = "view.front"
      viewRear = "view.rear"
      viewWide = "view.wide"
      autorun = "act.autorun"
      viewRecenter = "act.recenter"
      viewIsolate = "act.isolate"
      viewFace = "view.face"
      viewFrame = "act.frame"
      viewFreeLook = "act.look"
      autofly = "act.autofly"

      // The Debug page.
      dbgWhere = "act.where"
      dbgConsole = "act.console"
      dbgCapture = "dbg.capture"
      dbgHistory = "dbg.history"
      dbgInspect = "dbg.inspect"
      dbgInspectOff = "dbg.inspectOff"
      dbgDebugView = "act.view"
      dbgHold = "dbg.hold"
      dbgSplit = "dbg.split"
      dbgClear = "dbg.clear"
      dbgStop = "dbg.stop"
      dbgSuit = "dbg.suit"

      // The Go page.
      goStage = "go.stage"
      goHero = "go.hero"
      goGallery = "go.gallery"
      goPortals = "go.portals"
      goWonderland = "go.wonderland"
      goDevices = "go.devices"
      goChess = "go.chess"
      goDesktop = "go.desktop"
      goLevel0 = "go.level0"
      goLevel1 = "go.level1"
      goLevel2 = "go.level2"
      goLevel3 = "go.level3"

      // The Tour page.
      tourNext = "act.next"
      tourPrev = "act.prev"
      tourFlag = "act.flag"
      tourQuality = "dbg.quality"
      tourRates = "dbg.rates"
      tourSlice = "act.slice"
      tourLightsOff = "tour.lightsOff"
      tourLightsOn = "tour.lightsOn"
      tourMotionOff = "tour.motionOff"
      tourMotionOn = "tour.motionOn"
      tourGarden = "tour.garden"
      tourNight = "tour.night"
    }

    // The bar draws one bar that swaps its page in place as a trigger is held, rather than every page's bank at once.
    table barModel {
      model = "single"
    }

    // The play wheel's sector labels and icons, by sector id; `cancel` is the hub's label while nothing is hovered.
    table wheelLabels {
      console = "Console"
      build = "Build"
      where = "Where"
      channels = "Channels"
      annotate = "Annotate"
      respawn = "Respawn"
      desktop = "Desktop"
      play = "Play"
      suit = "Suit"
      stop = "Stop"
      threeQuarter = "Three-quarter"
      front = "Front"
      rear = "Rear"
      wide = "Wide"
      face = "Face"
      autoCamera = "Chase camera"
      goStage = "Stage"
      goHero = "Hero"
      goGallery = "Gallery"
      goPortals = "Portals"
      goChess = "Chess"
      goDesktop = "Computer"
      goDevices = "Devices"
      goWonderland = "Wonderland"
      cancel = "Cancel"
    }

    table wheelIcons {
      console = "act.console"
      build = "act.build"
      where = "act.where"
      channels = "act.channels"
      annotate = "act.annotate"
      respawn = "act.respawn"
      desktop = "act.desktop"
      play = "act.play"
      suit = "dbg.suit"
      stop = "dbg.stop"
      threeQuarter = "view.quarter"
      front = "view.front"
      rear = "view.rear"
      wide = "view.wide"
      face = "view.face"
      autoCamera = "view.auto"
      goStage = "go.stage"
      goHero = "go.hero"
      goGallery = "go.gallery"
      goPortals = "go.portals"
      goChess = "go.chess"
      goDesktop = "go.desktop"
      goDevices = "go.devices"
      goWonderland = "go.wonderland"
    }
  }
}

bindingOverlays [
  // The bar rides the Moth's own overlay: it shows the page that overlay rests on.
  {
    id: "bare"
    bindingBar {
      slotSet [
        "gamepad.dpadUp"
        "gamepad.dpadRight"
        "gamepad.dpadDown"
        "gamepad.dpadLeft"
        "gamepad.leftShoulder"
        "gamepad.leftStickPress"
        "gamepad.buttonNorth"
        "gamepad.buttonWest"
        "gamepad.buttonSouth"
        "gamepad.buttonEast"
        "gamepad.rightShoulder"
        "gamepad.rightStickPress"
      ]
      // One bank a page, in the order of the pages: Move, then the left trigger, the right trigger, left then right and
      // right then left.
      banks [
        { id: "move", pageId: "base", alpha: 1 }
        { id: "view", pageId: "pad-lt", alpha: 1 }
        { id: "debug", pageId: "pad-rt", alpha: 1 }
        { id: "go", pageId: "pad-lt-rt", alpha: 1 }
        { id: "tour", pageId: "pad-rt-lt", alpha: 1 }
      ]
      iconRow: "state.barIcons"
      // The modifier row on the anchor line lights the page-holding triggers (the two the pad-pages row declares) held, and
      // the page's name sits under it; the wheel's openers and the mouse chord stay off it.
      modifiers: true
      declaredModifiersOnly: true
      pageLabel: true
      modelCell: "state.barModel.model"
      layout: "standard"
      visible: shownWhilePlaying
      layouts {
        // The standard controller cluster, in pitches from the bottom-centre anchor (x right, y up): the d-pad diamond
        // left of centre with the left stick's press at its heart and LB above its outer point, and the face diamond
        // mirrored on the right with the right stick's press and RB; the two diamonds stand 1.33 pitches off centre.
        standard {
          // The old engine bar's size: a 0.075 plate at 0.72 scale. Its plates stand 0.14 of the height above the bottom
          // edge (each bank's own anchor), and the modifier row and the page's name hang below them on the layout's.
          buttonSize: 0.054
          anchor {
            edge: Bottom
            inset: 1.5
          }
          tables {
            left [
              { source: "gamepad.dpadUp", x: -4.333, y: 1, badge [0, 1] }
              { source: "gamepad.dpadRight", x: -3.333, y: 0, badge [1, 0] }
              { source: "gamepad.dpadDown", x: -4.333, y: -1, badge [0, -1] }
              { source: "gamepad.dpadLeft", x: -5.333, y: 0, badge [-1, 0] }
              { source: "gamepad.leftShoulder", x: -5.333, y: 1, badge [-1, 1] }
              { source: "gamepad.leftStickPress", x: -4.333, y: 0, badge [-1, -1] }
            ]
            right [
              { source: "gamepad.buttonNorth", x: 4.333, y: 1, badge [0, 1] }
              { source: "gamepad.buttonWest", x: 3.333, y: 0, badge [-1, 0] }
              { source: "gamepad.buttonSouth", x: 4.333, y: -1, badge [0, -1] }
              { source: "gamepad.buttonEast", x: 5.333, y: 0, badge [1, 0] }
              { source: "gamepad.rightShoulder", x: 5.333, y: 1, badge [1, 1] }
              { source: "gamepad.rightStickPress", x: 4.333, y: 0, badge [1, -1] }
            ]
          }
          // Every page's bank stands in the same place: the bar swaps pages in place.
          banks {
            move { pieces: standardPieces, anchor: standardAnchor }
            view { pieces: standardPieces, anchor: standardAnchor }
            debug { pieces: standardPieces, anchor: standardAnchor }
            go { pieces: standardPieces, anchor: standardAnchor }
            tour { pieces: standardPieces, anchor: standardAnchor }
          }
        }
      }
    }
  }

  // The play wheel, held open on Tab or LB over the Moth's resting page so the seat keeps walking while it aims; and
  // the keyboard's build toggle and respawn, whose pad doors are the wheel's Build and Respawn sectors (the pad's Back is
  // a device's select, and the left stick's press is run). While it is open the arrow keys (Tab) or the d-pad (LB) step
  // its ring, Up to the next and Down to the previous, and the mouse wheel steps it too.
  {
    id: "play-wheel"
    document {
      version: "puck.input.bindings.v1"
      modifiers []
      chords [
        {
          chord []
          group: "play"
          page {
            id: "base"
            label: "Move"
            entries [
              {
                command: "player.build"
                id: "build"
                label: "Build"
                sources ["keyboard.f2"]
              }
              // Back to the spawn from anywhere, a fall or a portal loop included.
              {
                command: "body.pose"
                id: "respawn"
                label: "Respawn"
                text: "spawn:stage"
                sources ["keyboard.backspace"]
              }
            ]
          }
        }
        {
          chord ["keyboard.tab"]
          group: "play"
          page {
            id: "wheel-keys"
            inherits: "base"
            label: "Wheel"
            entries [
              {
                command: "player.wheel.select"
                sources ["mouse.motion"]
              }
              {
                command: "player.wheel.commit"
                activateOn: Completed
                sources ["keyboard.tab"]
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Next ring"
                sources ["keyboard.arrowUp"]
                value { kind: "Axis1D", raw [1, 0, 0, 0] }
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Previous ring"
                sources ["keyboard.arrowDown"]
                value { kind: "Axis1D", raw [-1, 0, 0, 0] }
              }
            ]
          }
        }
        {
          chord ["gamepad.leftShoulder"]
          group: "play"
          page {
            id: "wheel-pad"
            inherits: "base"
            label: "Wheel"
            entries [
              {
                command: "player.wheel.select"
                sources ["gamepad.rightStick"]
              }
              {
                command: "player.wheel.commit"
                activateOn: Completed
                sources ["gamepad.leftShoulder"]
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Next ring"
                sources ["gamepad.dpadUp"]
                value { kind: "Axis1D", raw [1, 0, 0, 0] }
              }
              {
                command: "player.wheel.ring"
                activateOn: Started
                label: "Previous ring"
                sources ["gamepad.dpadDown"]
                value { kind: "Axis1D", raw [-1, 0, 0, 0] }
              }
            ]
          }
        }
      ]
      wheels [
        {
          id: "play-primary"
          group: "play"
          holdPages ["wheel-keys", "wheel-pad"]
          labelRow: "state.wheelLabels"
          iconRow: "state.wheelIcons"
          style {
            placement: ViewportCenter
          }
          rings: mothRings
        }
      ]
    }
  }

  // The bar's four trigger pages, each the Moth's resting page with the bar's twelve controls rebound: the left trigger
  // (or Z) holds View, the right trigger (or X) holds Debug, and the two together hold Go when the left went down first
  // and Tour when the right did. The debug world's places and gallery fill Go and Tour (pad.puck); the suit toggle joins
  // Debug (suit.puck). A page inherits `base`, so the sticks and the keyboard's movement keep working while it is held.
  // Close-ups the View page has no plate for (head, boots, shoulder) are `view.override layout <name>`, and the chase
  // camera and annotation are the play wheel's.
  {
    id: "pad-pages"
    document {
      version: "puck.input.bindings.v1"
      modifiers: padModifiers
      chords [
        {
          chord ["lt"]
          group: "play"
          page {
            id: "pad-lt"
            inherits: "base"
            label: "View"
            entries [
              { command: "view.override", id: "viewPlay", label: "Chase", text: "layout play", value: neverRead, sources: padUp }
              { command: "view.override", id: "viewQuarter", label: "Three-quarter", text: "layout three-quarter", value: neverRead, sources: padRight }
              { command: "view.override", id: "viewFront", label: "Front", text: "layout front", value: neverRead, sources: padDown }
              { command: "view.override", id: "viewRear", label: "Rear", text: "layout rear", value: neverRead, sources: padLeft }
              { command: "view.override", id: "viewWide", label: "Wide", text: "layout flight-stage", value: neverRead, sources: padLeftShoulder }
              // Autorun and autofly: each press switches her walking forward, or flying (flight mode on and climbing), on or
              // off, and the latch outlives the page, so she keeps going with the trigger released.
              { channel: "forward", id: "autorun", label: "Autorun", mode: Toggle, scale: 1, sources: padLeftStick }
              { command: "player.look.recenter", id: "viewRecenter", label: "Recenter", sources: padNorth }
              { command: "view.isolate", id: "viewIsolate", label: "Jetpack alone", text: "toggle moth pod* nozzle*", sources: padWest }
              { command: "view.override", id: "viewFace", label: "Face", text: "layout face", value: neverRead, sources: padSouth }
              { command: "player.frame", id: "viewFrame", label: "Frame", sources: padEast }
              { command: "player.look.free", id: "viewFreeLook", label: "Free look", sources: padRightShoulder }
              { channel: "rise", id: "autofly", label: "Autofly", mode: Toggle, scale: 1, sources: padRightStick }
            ]
          }
        }
        {
          chord ["rt"]
          group: "play"
          page {
            id: "pad-rt"
            inherits: "base"
            label: "Debug"
            entries [
              { command: "body.where", id: "dbgWhere", label: "Where", sources: padUp }
              { command: "world.history", id: "dbgHistory", label: "History on", text: "on", sources: padRight }
              { command: "console", id: "dbgConsole", label: "Console", sources: padDown }
              { command: "world.screenshot", id: "dbgCapture", label: "Capture", sources: padLeft }
              { command: "world.inspect", id: "dbgInspect", label: "Inspector on", text: "on", sources: padLeftShoulder }
              { command: "world.inspect", id: "dbgInspectOff", label: "Inspector off", text: "off", sources: padLeftStick }
              { command: "world.debug-view", id: "dbgDebugView", label: "Debug view", text: "next", sources: padNorth }
              { command: "world.compare", id: "dbgHold", label: "Hold frame", text: "hold", value: neverRead, sources: padWest }
              { command: "world.compare", id: "dbgSplit", label: "Compare", text: "split", value: neverRead, sources: padEast }
              { command: "world.compare", id: "dbgClear", label: "Clear hold", text: "off", value: neverRead, sources: padRightShoulder }
              { command: "body.stop", id: "dbgStop", label: "Stop", sources: padRightStick }
            ]
          }
        }
        {
          chord ["lt", "rt"]
          group: "play"
          page {
            id: "pad-lt-rt"
            inherits: "base"
            label: "Go"
            entries []
          }
        }
        {
          chord ["rt", "lt"]
          group: "play"
          page {
            id: "pad-rt-lt"
            inherits: "base"
            label: "Tour"
            entries []
          }
        }
      ]
    }
  }
]
