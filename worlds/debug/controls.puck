// Debug-only Go and Tour pages, gallery icons and Places ring refine the standard.
import "../standard/standard"
import "pad-kit"

commands [
  {
    name: "gallery.lights.all"
    help: "Switches every level's room lights in the gallery hall on or off, as the four wall switches do."
    parameters [
      { name: "state", kind: Choice, values ["On", "Off"] }
    ]
    lines [
      "gallery.lights 0 {state}"
      "gallery.lights 1 {state}"
      "gallery.lights 2 {state}"
      "gallery.lights 3 {state}"
    ]
  }
  {
    name: "gallery.motion"
    help: "Runs the shape gallery's motion exhibits (1) or eases them all to rest (0): the gate every driver reads (shapes.md)."
    parameters [
      { name: "state", kind: Choice, values ["1", "0"] }
    ]
    lines [
      "world.state.cell.set galleryMotion all {state}"
    ]
  }
]

bindingOverlays [
  {
    id: "pad-places"
    document {
      version: "puck.input.bindings.v1"
      modifiers: padModifiers
      chords [
        {
          chord ["lt", "rt"]
          group: "play"
          page {
            id: "pad-lt-rt"
            inherits: "base"
            label: "Go"
            entries [
              { command: "debug.go", id: "goStage", label: "Stage", text: "stage", sources: padUp }
              { command: "debug.go", id: "goGallery", label: "Gallery", text: "gallery", sources: padRight }
              { command: "debug.go", id: "goPortals", label: "Portals", text: "portals", sources: padDown }
              { command: "debug.go", id: "goWonderland", label: "Wonderland", text: "wonderland", sources: padLeft }
              { command: "debug.go", id: "goHero", label: "Hero studio", text: "hero", sources: padLeftShoulder }
              { command: "debug.go", id: "goDevices", label: "Devices", text: "devices", sources: padLeftStick }
              { command: "debug.go", id: "goChess", label: "Chess", text: "chess", sources: padNorth }
              { command: "debug.go", id: "goDesktop", label: "Computer", text: "desktop", sources: padWest }
              { command: "debug.go", id: "goLevel0", label: "Level 0", text: "gallery-level-0", sources: padSouth }
              { command: "debug.go", id: "goLevel1", label: "Level 1", text: "gallery-level-1", sources: padEast }
              {
                command: "debug.go"
                id: "goLevel2"
                label: "Level 2"
                text: "gallery-level-2"
                sources: padRightShoulder
              }
              { command: "debug.go", id: "goLevel3", label: "Level 3", text: "gallery-level-3", sources: padRightStick }
            ]
          }
        }
        {
          chord ["rt", "lt"]
          group: "play"
          page {
            id: "pad-rt-lt"
            inherits: "base"
            label: "Tour"
            entries [
              {
                command: "world.toon"
                id: "tourToon"
                label: "Toon shading"
                text: "toggle"
                sources ["gamepad.back", "keyboard.f6"]
              }
              { command: "gallery.next", id: "tourNext", label: "Next exhibit", sources: padUp }
              { command: "gallery.flag", id: "tourFlag", label: "Flag exhibit", sources: padRight }
              { command: "gallery.prev", id: "tourPrev", label: "Previous exhibit", sources: padDown }
              { command: "world.quality", id: "tourQuality", label: "Quality", text: "next", sources: padLeft }
              { command: "gallery.slice", id: "tourSlice", label: "Slice exhibit", sources: padLeftShoulder }
              { command: "world.rates", id: "tourRates", label: "Update rates", text: "toggle", sources: padLeftStick }
              {
                command: "gallery.lights.all"
                id: "tourLightsOff"
                label: "Lights off"
                text: "Off"
                sources: padNorth
              }
              { command: "gallery.lights.all", id: "tourLightsOn", label: "Lights on", text: "On", sources: padWest }
              { command: "gallery.motion", id: "tourMotionOff", label: "Motion off", text: "0", sources: padSouth }
              { command: "gallery.motion", id: "tourMotionOn", label: "Motion on", text: "1", sources: padEast }
              {
                command: "debug.go"
                id: "tourGarden"
                label: "Garden painting"
                text: "portal-garden"
                sources: padRightShoulder
              }
              {
                command: "debug.go"
                id: "tourNight"
                label: "Night painting"
                text: "portal-night"
                sources: padRightStick
              }
            ]
          }
        }
      ]
      // The play wheel again with its third ring: a later layer's wheel replaces the earlier one whole.
      wheels [
        {
          id: "play-primary"
          group: "play"
          holdPages ["wheel-keys", "wheel-pad"]
          labelRow: "state.wheelLabels"
          iconRow: "state.wheelIcons"
          style {
            placement: ViewportCenter
          }
          rings: debugRings
        }
      ]
    }
  }
]

icons [
  { name: "act.next", label: ">" }
  { name: "act.prev", label: "<" }
  { name: "act.flag", label: "!" }
  { name: "act.slice", label: "SL" }
  { name: "go.stage", label: "SG" }
  { name: "go.hero", label: "HR" }
  { name: "go.gallery", label: "GL" }
  { name: "go.portals", label: "PT" }
  { name: "go.wonderland", label: "WL" }
  { name: "go.devices", label: "DE" }
  { name: "go.chess", label: "CS" }
  { name: "go.desktop", label: "DK" }
  { name: "go.level0", label: "L0" }
  { name: "go.level1", label: "L1" }
  { name: "go.level2", label: "L2" }
  { name: "go.level3", label: "L3" }
  { name: "tour.lightsOff", label: "L-" }
  { name: "tour.lightsOn", label: "L+" }
  { name: "tour.motionOff", label: "M0" }
  { name: "tour.motionOn", label: "M1" }
  { name: "tour.garden", label: "PG" }
  { name: "tour.night", label: "PN" }
  { name: "tour.toon", label: "CE" }
]

state {
  world {
    table barIcons {
      galleryNext = "act.next"
      galleryPrev = "act.prev"
      galleryFlag = "act.flag"
      galleryView = "act.view"
      gallerySlice = "act.slice"
      goStage = "go.stage"
      goHero = "go.hero"
      goGallery = "go.gallery"
      goPortals = "go.portals"
      goWonderland = "go.wonderland"
      goDevices = "go.devices"
      goChess = "go.chess"
      goDesktop = "go.desktop"
      goLevel0 = "go.level0"
      goLevel1 = "go.level1"
      goLevel2 = "go.level2"
      goLevel3 = "go.level3"
      tourNext = "act.next"
      tourPrev = "act.prev"
      tourFlag = "act.flag"
      tourQuality = "dbg.quality"
      tourRates = "dbg.rates"
      tourSlice = "act.slice"
      tourLightsOff = "tour.lightsOff"
      tourLightsOn = "tour.lightsOn"
      tourMotionOff = "tour.motionOff"
      tourMotionOn = "tour.motionOn"
      tourGarden = "tour.garden"
      tourNight = "tour.night"
      tourToon = "tour.toon"
    }
    table wheelLabels {
      goStage = "Stage"
      goHero = "Hero"
      goGallery = "Gallery"
      goPortals = "Portals"
      goChess = "Chess"
      goDesktop = "Computer"
      goDevices = "Devices"
      goWonderland = "Wonderland"
    }
    table wheelIcons {
      goStage = "go.stage"
      goHero = "go.hero"
      goGallery = "go.gallery"
      goPortals = "go.portals"
      goChess = "go.chess"
      goDesktop = "go.desktop"
      goDevices = "go.devices"
      goWonderland = "go.wonderland"
    }
  }
}

bindingOverlays [
  {
    id: "bare"
    bindingBar {
      banks [
        { id: "go", pageId: "pad-lt-rt", alpha: 1 }
        { id: "tour", pageId: "pad-rt-lt", alpha: 1 }
      ]
      layouts {
        standard {
          tables {
            toon [{ source: "gamepad.back", x: 0, y: 0, badge [0, 1] }]
          }
          banks {
            go { pieces [{ table: "left" }, { table: "right" }], anchor { edge: Bottom, inset: 3.6 } }
            tour {
              pieces [{ table: "left" }, { table: "right" }, { table: "toon" }]
              anchor { edge: Bottom, inset: 3.6 }
            }
          }
        }
        keys {
          banks {
            go {
              pieces [
                { table: "move", at [-6, 0] }
                { table: "act", at [-3, 0] }
                { table: "mouse", at [4, 0] }
                { table: "cameras", at [-3, 1] }
                { table: "functions", at [3, 1] }
              ]
            }
            tour {
              pieces [
                { table: "move", at [-6, 0] }
                { table: "act", at [-3, 0] }
                { table: "mouse", at [4, 0] }
                { table: "cameras", at [-3, 1] }
                { table: "functions", at [3, 1] }
              ]
            }
          }
        }
        pad {
          banks {
            go { pieces [{ table: "left", at [-5, 0] }, { table: "right", at [-1, 0] }, { table: "face", at [4, 0] }] }
            tour {
              pieces [{ table: "left", at [-5, 0] }, { table: "right", at [-1, 0] }, { table: "face", at [4, 0] }]
            }
          }
        }
        wings {
          // Five banks bottom at -4 pitches, keeping the primary at the standard 220/600 lift.
          banks {
            move { anchor { edge: Bottom, inset: 0.3888889 } }
            view { anchor { edge: Bottom, inset: 0.3888889 } }
            debug { anchor { edge: Bottom, inset: 0.3888889 } }
            go {
              pieces [{ table: "left", at [-9, -2.25] }, { table: "right", at [9, -2.25] }]
              anchor { edge: Bottom, inset: 0.3888889 }
            }
            tour {
              pieces [{ table: "left", at [-12, -3] }, { table: "right", at [12, -3] }]
              anchor { edge: Bottom, inset: 0.3888889 }
            }
          }
        }
        sidebars {
          banks {
            go { pieces [{ table: "column", at [1.2, 0] }], anchor { edge: Left, inset: 1.5 } }
            tour { pieces [{ table: "column", at [-1.2, 0] }], anchor { edge: Right, inset: 1.5 } }
          }
        }

      }
    }
  }
]
