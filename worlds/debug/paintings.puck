// The painting wing: paintings in the gallery's level 0, east of the entrance lobby, each a framed canvas that is a
// door. Walk or jump into the canvas and you pass through it, as into a Mario 64 painting; its glass shows where it
// leads while you stand outside. The debug world imports this file whole, and paintings.md beside it says how to get
// in, what each painting does and how to get out.
//
// The wing is the south aisle from x 30 to the east wall, in the building's frame (gallery/layout.puck, gallery.md),
// open to the nave through the arcade. Two fins stand out from the south wall and make it two courts:
//
//   west fin, east face         the bottle world (globe.puck), its lever before it
//   south wall, west court      the garden (garden.puck), the night field (night.puck), the city (city.puck)
//   east fin, east face         one of two paintings facing each other: step into either and step out of the other
//   south wall, east court      the moon (moon.puck, hung by moon-door.puck), the planetoids (galaxy.puck)
//   east wall                   the other of the facing pair, and the sun (sun.puck)
//   floor and ceiling           the endless fall, at layout.puck's `fallPlan`: a painting in the floor under its twin
//                               in the ceiling, in this world itself, so a body that steps onto the floor glass drops
//                               out of the ceiling glass still falling, and falls through the floor again, forever;
//                               level 1's floor is holed over the ceiling twin and railed (gallery/shell.puck)
//
// Every painting stands under the building's root placement. A wall painting hangs on its wall's face and its canvas
// reaches the floor, so a body's feet cross the glass. The wall behind the glass holds nothing back while the body
// stands in the opening (Puck.World.Server.WorldPortalHoleContactField). Both faces of a same-world pair name the
// destination `self`, which references the debug world's own document, so the transfer resolves to the running World
// rather than a second copy of it.

import "../standard/bounds"
import "painting-kit"
import "shapes"

// The wing's floor and the slab above it (gallery/layout.puck).
let wingFloor = galleryFloor[0]
let wingTop = galleryCeiling[0]
// The faces paintings hang on: the south wall's inner face, each fin's east face and the east wall's inner face.
let wingSouth = galleryWall
let wingFins = [courtWest, courtFin]
let wingEast = galleryEast

// The canvas of a wall painting: a thin rim box 2.24 m wide and 2.84 m tall whose centre is carved away, so the glass,
// which fills the face shape a centimetre short of its faces, shows through. Its lower 0.12 m is below the floor so a
// body's feet stand within the opening. `canvasRim` is the rim's width, and the carve leaves the rest.
let canvasHalfWidth = 1.12
let canvasHalfHeight = 1.42
let canvasCenter = 1.3
let canvasRim = 0.02
let canvasProud = 0.03

// What a glass shows past the deepest level of windows inside windows, by destination.
let fallbackGarden = "#FF9A4D"
let fallbackNight = "#070B16"
let fallbackCity = "#E8C48A"
let fallbackMoon = "#CFC8BC"
let fallbackGalaxy = "#02030A"
let fallbackGlobe = "#1B2330"
let fallbackSun = "#02030A"

// Shape rotations, as authored quaternions [x, y, z, w]: a quarter turn about +X lays a canvas (its +Z face) flat. The
// floor turns it to face up and the ceiling to face down; the ceiling placement's half turn about up then lines its right
// and up axes with the floor's, so a crossing keeps the traveller's heading.
let faceUp = [-0.707107, 0, 0, 0.707107]
let faceDown = [0.707107, 0, 0, 0.707107]

// Palette slots every painting prototype shares.
let paintGilt = 0
let paintLip = 1
let paintBlack = 2
let paintMat = 3
let paintBrass = 4
let paintBoard = 5
let paintInk = 6
let paintingPalette = [
  paintingGiltRow
  paintingLipRow
  paintingBlackRow
  { color: "#EDEAE3", roughness: 0.7 }
  { color: "#B58F4F", roughness: 0.35, specular: 0.5 }
  paintingBoardRow
  paintingInkRow
]

// The frames: a dark lip against the canvas, an optional mat, then the border, each a ring of the given width.
let ornate = { lip: paintLip, lipWidth: 0.05, mat: paintMat, matWidth: 0, border: paintGilt, borderWidth: 0.22 }
let modern = { lip: paintBlack, lipWidth: 0, mat: paintMat, matWidth: 0.14, border: paintBlack, borderWidth: 0.07 }
let brass = { lip: paintBlack, lipWidth: 0.03, mat: paintMat, matWidth: 0, border: paintBrass, borderWidth: 0.12 }

// The wall paintings. `x` and `z` stand the painting's foot on the wall it hangs on, in the building's frame, `yaw`
// turns its front (yaw 0 faces -Z, 180 faces +Z, 90 faces -X, 270 faces +X), and `counterpart` is the face a crossing
// arrives out of.
let wallPaintings = [
  {
    name: "garden", x: 34.4, z: wingSouth, yaw: 180, frame: ornate, destination: "garden", counterpart: "arrival/glass", fallback: fallbackGarden
    title: "THE GARDEN", note: "A sunset plot beyond the glass. Walk or jump in; the frame behind you leads back."
  }
  {
    name: "night", x: 38, z: wingSouth, yaw: 180, frame: modern, destination: "night", counterpart: "arrival/glass", fallback: fallbackNight
    title: "THE NIGHT FIELD", note: "A snowfield under the stars. Step in; turn round to come back."
  }
  {
    name: "city", x: 41.6, z: wingSouth, yaw: 180, frame: ornate, destination: "city", counterpart: "arrival/glass", fallback: fallbackCity
    title: "THE CITY", note: "A town on a river bend, its market, terraces, works and quay. Step in; the frame behind you leads back."
  }
  {
    name: "moon", x: 48.5, z: wingSouth, yaw: 180, frame: modern, destination: "moon", counterpart: "moon-socket/glass", fallback: fallbackMoon
    title: "THE MOON", note: "The pale moon over the valley, the same one a ship from the launch field lands on. Knock and wait for the moon to answer; the frame it opens leads back."
  }
  {
    name: "galaxy", x: 52.5, z: wingSouth, yaw: 180, frame: brass, destination: "galaxy", counterpart: "arrival/glass", fallback: fallbackGalaxy
    title: "THE PLANETOIDS", note: "Six small worlds in open space, each with gravity of its own shape. Step in; the glowing pads launch you from one to the next."
  }
  {
    name: "sun", x: wingEast, z: 6.6, yaw: 90, frame: brass, destination: "sun", counterpart: "arrival/glass", fallback: fallbackSun
    title: "PERIHELION", note: "A rock the sun passes once a day, the same sun that lights the valley. Step in and watch it come; keep to the rock while it passes, and do not fly to it."
  }
  {
    name: "globe", x: (wingFins[0] + galleryWall), z: 2.4, yaw: 270, frame: ornate, destination: "globe", counterpart: "arrival/glass", fallback: fallbackGlobe
    title: "THE BOTTLE WORLD", note: "A room whose gravity this gallery owns. Press the lever before it and watch which way the marbles fall; step in and someone out here can turn you over."
  }
  {
    name: "link-west", x: (wingFins[1] + galleryWall), z: 2.4, yaw: 270, frame: brass, destination: "self", counterpart: "painting-link-east/glass", fallback: fallbackSelf
    title: "ACROSS THE ROOM", note: "Step in and you step out of its twin on the far wall, facing out."
  }
  {
    name: "link-east", x: wingEast, z: 2.4, yaw: 90, frame: brass, destination: "self", counterpart: "painting-link-west/glass", fallback: fallbackSelf
    title: "ACROSS THE ROOM", note: "Step in and you step out of its twin on the far wall, facing out."
  }
]

// The floor and ceiling paintings of the endless fall (layout.puck's `fallPlan`) stand over the same point; the ceiling
// one hangs under the slab, in the hole level 1's floor leaves over it, and a balustrade rings that hole
// (gallery/shell.puck).
let fallHalf = 1.12

// A wall painting: face 0, the rim, names the glass, which stands `canvasProud` out from the wall; the frame is the
// rings round it and the plaque stands on the wall to its right.
template wallPainting(label, frame, title, note) {
  behavior {
    faces [{ name: "glass", shapeId: 0 }]
  }
  name: label
  schema: "puck.creation.v1"
  palette: paintingPalette
  shape Box "rim" {
    material: paintBlack
    position [0, canvasCenter, canvasProud]
    scale [canvasHalfWidth, canvasHalfHeight, 0.04]
  }
  shape Box "opening" {
    blend: Subtraction
    material: paintBlack
    position [0, canvasCenter, canvasProud]
    scale [(canvasHalfWidth - canvasRim), (canvasHalfHeight - canvasRim), 0.3]
  }
  for width in ((frame.lipWidth > 0) ? [frame.lipWidth] : []) {
    barRing(
      label: "lip",
      ix: canvasHalfWidth,
      y0: (canvasCenter - canvasHalfHeight),
      y1: (canvasCenter + canvasHalfHeight),
      w: width,
      depth: 0.08,
      slot: frame.lip
    )
  }
  for width in ((frame.matWidth > 0) ? [frame.matWidth] : []) {
    barRing(
      label: "mat",
      ix: (canvasHalfWidth + frame.lipWidth),
      y0: (canvasCenter - canvasHalfHeight),
      y1: (canvasCenter + canvasHalfHeight + frame.lipWidth),
      w: width,
      depth: 0.05,
      slot: frame.mat
    )
  }
  barRing(
    label: "border",
    ix: (canvasHalfWidth + frame.lipWidth + frame.matWidth),
    y0: (canvasCenter - canvasHalfHeight),
    y1: (canvasCenter + canvasHalfHeight + frame.lipWidth + frame.matWidth),
    w: frame.borderWidth,
    depth: 0.11,
    slot: frame.border
  )
  // The plaque: a cream board on the wall, a hand's width beyond the frame.
  localBox(
    label: "plaque",
    x0: (canvasHalfWidth + frame.lipWidth + frame.matWidth + frame.borderWidth + 0.15),
    x1: (canvasHalfWidth + frame.lipWidth + frame.matWidth + frame.borderWidth + 1.15),
    y0: 1.0,
    y1: 1.4,
    z0: 0,
    z1: 0.025,
    slot: paintBoard
  )
  textRuns [
    {
      text: title
      position [(canvasHalfWidth + frame.lipWidth + frame.matWidth + frame.borderWidth + 0.65), 1.31, 0.025]
      rotation [0, 0, 0, 1]
      emHeight: 0.06
      depth: 0.004
      mode: "emboss"
      material: paintInk
      align: "center"
      maxWidth: 0.94
    }
    {
      text: note
      position [(canvasHalfWidth + frame.lipWidth + frame.matWidth + frame.borderWidth + 0.65), 1.22, 0.025]
      rotation [0, 0, 0, 1]
      emHeight: 0.028
      depth: 0.003
      mode: "emboss"
      material: paintInk
      align: "center"
      maxWidth: 0.94
      lineSpacing: 1.15
    }
  ]
}

// The wing's shell: a partition wall with a doorway, and a lining over the south, north and east walls, up to the slab
// above. Every piece is a box rather than a subtraction, so a visitor in the doorway meets analytic boxes rather than a
// carve's field solve (hall.puck). The walls are a warm stone a shade under the hall's cream, so the wing reads as its own
// room and still carries its fixtures' light (hall.puck's wingDownlights and wingWashes) about each canvas.
let wingWall = 0
let wingTrim = 1
let wingBoard = 2
let wingInk = 3
let wingPalette = [
  { color: "#D8D2C6", roughness: 0.85, specular: 0.04 }
  { color: "#1B1F25", roughness: 0.6, specular: 0.15 }
  { color: "#F2EEE4", roughness: 0.6 }
  { color: "#3A3F47", roughness: 0.6 }
]

references [
  {
    document: "debug"
    name: "self"
  }
]

destinations [
  {
    durability: persisted
    name: "self"
    reference: "self"
    scope: global
  }
]

prototypes {
  // The wing's two fins, each a wall standing out from the south wall to the slab above, and the board that names the
  // wing where the lobby meets it.
  prototype "wing-fins" {
    document {
      name: "wing-fins"
      schema: "puck.creation.v1"
      palette: wingPalette
      for (x, n) in wingFins {
        boundsBox(
          label: $"fin-{n}",
          x0: x,
          x1: (x + galleryWall),
          y0: wingFloor,
          y1: wingTop,
          z0: galleryWall,
          z1: (galleryWall + courtFinLength),
          slot: wingWall
        )
        boundsBox(
          label: $"fin-skirting-{n}",
          x0: (x - 0.02),
          x1: ((x + galleryWall) + 0.02),
          y0: wingFloor,
          y1: 0.2,
          z0: galleryWall,
          z1: ((galleryWall + courtFinLength) + 0.02),
          slot: wingTrim
        )
      }
    }
  }
  sectionSign(name: "wing-sign", title: "PAINTING WING", what: "walk or jump into a canvas")

  for painting in wallPaintings {
    prototype $"painting-{painting.name}" {
      document {
        wallPainting(
          label: $"painting-{painting.name}",
          frame: painting.frame,
          title: painting.title,
          note: painting.note
        )
      }
    }
  }

  // The floor painting of the endless fall: a gilt square lying flat, its canvas a hand proud of the floor, with a
  // plaque lying on the floor before it, read from the south.
  prototype "painting-fall-floor" {
    document {
      behavior {
        faces [{ name: "glass", shapeId: 0 }]
      }
      name: "painting-fall-floor"
      schema: "puck.creation.v1"
      palette: paintingPalette
      shape Box "rim" {
        material: paintBlack
        position [0, 0, 0]
        rotation: faceUp
        scale [fallHalf, fallHalf, 0.04]
      }
      shape Box "opening" {
        blend: Subtraction
        material: paintBlack
        position [0, 0, 0]
        rotation: faceUp
        scale [(fallHalf - canvasRim), (fallHalf - canvasRim), 0.3]
      }
      flatRing(label: "lip", ix: fallHalf, w: 0.05, y0: 0, y1: 0.05, slot: paintLip)
      flatRing(label: "border", ix: (fallHalf + 0.05), w: 0.22, y0: 0, y1: 0.07, slot: paintGilt)
      localBox(label: "plaque", x0: -0.5, x1: 0.5, y0: 0, y1: 0.02, z0: 1.55, z1: 2.15, slot: paintBoard)
      textRuns [
        {
          text: "THE ENDLESS FALL"
          position [0, 0.02, 1.98]
          rotation: faceUp
          emHeight: 0.07
          depth: 0.004
          mode: "emboss"
          material: paintInk
          align: "center"
          maxWidth: 0.94
        }
        {
          text: "Step onto the glass and you fall, out of the ceiling and through the floor again. Backspace or L3 gets you out."
          position [0, 0.02, 1.86]
          rotation: faceUp
          emHeight: 0.03
          depth: 0.003
          mode: "emboss"
          material: paintInk
          align: "center"
          maxWidth: 0.94
          lineSpacing: 1.15
        }
      ]
    }
  }

  // The rail round the hole over the ceiling painting on level 1: a black parapet with a gilt cap, so nobody drops into
  // the wing by accident, and a line of text on its south face. Written in world bounds (boundsBox), solid.
  prototype "painting-fall-ceiling" {
    document {
      behavior {
        faces [{ name: "glass", shapeId: 0 }]
      }
      name: "painting-fall-ceiling"
      schema: "puck.creation.v1"
      palette: paintingPalette
      shape Box "rim" {
        material: paintBlack
        position [0, 0, 0]
        rotation: faceDown
        scale [fallHalf, fallHalf, 0.04]
      }
      shape Box "opening" {
        blend: Subtraction
        material: paintBlack
        position [0, 0, 0]
        rotation: faceDown
        scale [(fallHalf - canvasRim), (fallHalf - canvasRim), 0.3]
      }
      flatRing(label: "lip", ix: fallHalf, w: 0.05, y0: -0.05, y1: 0, slot: paintLip)
      flatRing(label: "border", ix: (fallHalf + 0.05), w: 0.22, y0: -0.07, y1: 0, slot: paintGilt)
    }
  }
}

placements {
  placement "wing-fins" {
    prototype: "wing-fins"
    parent: "gallery"
    position [0, 0, 0]
    solid
  }
  placement "wing-sign" {
    prototype: "wing-sign"
    parent: "gallery"
    position [(courtWest + 1.4), wingFloor, 6.4]
    yawDegrees: 90
  }

  for painting in filter(wallPaintings, p => (p.name != "moon")) {
    placement $"painting-{painting.name}" {
      prototype: $"painting-{painting.name}"
      parent: "gallery"
      position [painting.x, wingFloor, painting.z]
      yawDegrees: painting.yaw
      paintingFace(destination: painting.destination, counterpart: painting.counterpart, fallback: painting.fallback)
    }
  }

  placement "painting-fall-floor" {
    prototype: "painting-fall-floor"
    parent: "gallery"
    position [fallPlan[0], wingFloor, fallPlan[1]]
    paintingFace(destination: "self", counterpart: "painting-fall-ceiling/glass", fallback: fallbackSelf)
  }

  placement "painting-fall-ceiling" {
    prototype: "painting-fall-ceiling"
    parent: "gallery"
    position [fallPlan[0], (wingTop - 0.03), fallPlan[1]]
    yawDegrees: 180
    paintingFace(destination: "self", counterpart: "painting-fall-floor/glass", fallback: fallbackSelf)
  }
}

// A spawn point before each painting, facing it, and two that frame several at once for the chase camera, which keeps
// its place behind the body (4 m back along its heading): `painting-room` where the lobby meets the wing, looking east
// along the south wall's paintings, and `portals` before the west court's three. Each is in the building's frame.
spawnPoints [
  { id: "painting-room", parent: gallery, position [(courtWest + 1.5), wingFloor, 6.8], yawDegrees: 300 }
  { id: "portals", parent: gallery, position [38, wingFloor, 6], yawDegrees: 18 }
  { id: "portal-garden", parent: gallery, position [34.4, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-night", parent: gallery, position [38, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-city", parent: gallery, position [41.6, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-moon", parent: gallery, position [48.5, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-galaxy", parent: gallery, position [52.5, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-sun", parent: gallery, position [(wingEast - 3.1), wingFloor, 6.6], yawDegrees: 270 }
  { id: "portal-globe", parent: gallery, position [((wingFins[0] + galleryWall) + 3.1), wingFloor, 2.4], yawDegrees: 90 }
  { id: "portal-link", parent: gallery, position [((wingFins[1] + galleryWall) + 3.2), wingFloor, 2.4], yawDegrees: 90 }
  { id: "portal-fall", parent: gallery, position [fallPlan[0], wingFloor, (fallPlan[1] + 3.2)], yawDegrees: 0 }
  // Eleven metres north of the garden painting, facing it: the seam walk's second crossing (walkthrough-tests.puck).
  { id: "seam-painting", parent: gallery, position [34.4, wingFloor, 11.3], yawDegrees: 0 }
]
