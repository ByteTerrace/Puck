// The painting wing: paintings in the gallery's level 0, east of the entrance lobby, each a framed canvas that is a
// door. Walk or jump into the canvas and you pass through it, as into a Mario 64 painting; its glass shows where it
// leads while you stand outside. The debug world imports this file whole, and paintings.md beside it says how to get
// in, what each painting does and how to get out.
//
// Every wall painting is the standard's portal module (../standard/portal.puck) hung on a wall, as level 3's routed
// portals (gallery/portals.puck) and the lab wing's doors (lab-wing.puck) are the same module standing free: a row of
// `wallPaintings` names where it hangs, its frame and where it leads, and the module builds its canvas, frame, plaque and
// face. A painting leads to one world for good, so it stands no panel; its route is an entry of the debug world's
// destinations (destinations.puck), which this file declares, or, for the pair that faces each other, a door into this
// world itself.
//
// The wing is the south aisle from x 30 to the east wall, in the building's frame (gallery/layout.puck, gallery.md),
// open to the nave through the arcade. Two fins stand out from the south wall and make it two courts:
//
//   west fin, east face         the bottle world (globe.puck), its lever before it
//   south wall, west court      the garden (garden.puck), the night field (night.puck), the city (city.puck)
//   east fin, east face         one of two paintings facing each other: step into either and step out of the other
//   south wall, east court      the moon (moon.puck, hung by moon-door.puck), the planetoids (galaxy.puck)
//   east wall                   the other of the facing pair, and the sun (sun.puck)
//   floor and ceiling           the endless fall, at layout.puck's `fallPlan`: a painting in the floor under its twin
//                               in the ceiling, in this world itself, so a body that steps onto the floor glass drops
//                               out of the ceiling glass still falling, and falls through the floor again, forever;
//                               level 1's floor is holed over the ceiling twin and railed (gallery/shell.puck)
//
// Every painting stands under the building's root placement. A wall painting hangs on its wall's face and its canvas
// reaches the floor, so a body's feet cross the glass. The wall behind the glass holds nothing back while the body
// stands in the opening (Puck.World.Server.WorldPortalHoleContactField). Both faces of a same-world pair name the
// destination `self`, which references the debug world's own document, so the transfer resolves to the running World
// rather than a second copy of it.

import "../standard/bounds"
import "../standard/portal"
import "destinations"
import "shapes"

// The wing's floor and the slab above it (gallery/layout.puck).
let wingFloor = galleryFloor[0]
let wingTop = galleryCeiling[0]
// The faces paintings hang on: the south wall's inner face, the first two fins' east faces, the last fin's west face
// (it screens the south-east stair, layout.puck's `courtStairFin`) and the east wall's inner face north of that stair.
let courtWall = galleryWall
let courtFins = [courtWest, courtFin, courtStairFin]
let courtEast = galleryEast

// The frames: rings round a canvas that stands `proud` out from its wall, each ring `width` wide and reaching `front` out
// from the wall in its palette row, from the canvas out: a dark lip, a mat or not, then the border.
let canvasProud = 0.03
let matRow = { color: "#EDEAE3", roughness: 0.7 }
let brassRow = { color: "#B58F4F", roughness: 0.35, specular: 0.5 }
let ornate = {
  proud: canvasProud
  rings [{ width: 0.05, front: 0.08, back: 0, row: portalLipRow }, { width: 0.22, front: 0.11, back: 0, row: portalGiltRow }]
  plaque: "wall"
}
let modern = {
  proud: canvasProud
  rings [{ width: 0.14, front: 0.05, back: 0, row: matRow }, { width: 0.07, front: 0.11, back: 0, row: portalBlackRow }]
  plaque: "wall"
}
let brass = {
  proud: canvasProud
  rings [{ width: 0.03, front: 0.08, back: 0, row: portalBlackRow }, { width: 0.12, front: 0.11, back: 0, row: brassRow }]
  plaque: "wall"
}

// The two faces of the pair that leads across the room, each into the other in this world itself.
function selfRoute(counterpart) = {
  destination: "self"
  counterpart: counterpart
  fallback: portalFallbackSelf
  title: "ACROSS THE ROOM"
  note: "Step in and you step out of its twin on the far wall, facing out."
}

// The wall paintings. `x` and `z` stand the painting's foot on the wall it hangs on, in the building's frame, `yaw`
// turns its front (yaw 0 faces -Z, 180 faces +Z, 90 faces -X, 270 faces +X), `to` is where it leads and `title` and
// `note` its plaque, the route's own unless the painting says otherwise. The moon painting's door opens only while the
// moon agrees to it, so moon-door.puck hangs it, on the frame this file builds.
let wallPaintings = [
  { name: "garden", x: courtWallDoors[0], z: courtWall, yaw: 180, look: ornate, to: debugRoute("garden") }
  { name: "night", x: courtWallDoors[1], z: courtWall, yaw: 180, look: modern, to: debugRoute("night") }
  { name: "city", x: courtWallDoors[2], z: courtWall, yaw: 180, look: ornate, to: debugRoute("city") }
  {
    name: "moon", x: courtWallDoors[3], z: courtWall, yaw: 180, look: modern, to: debugRoute("moon")
    title: "THE MOON", note: "The pale moon over the valley, the same one a ship from the launch field lands on. Knock and wait for the moon to answer; the frame it opens leads back."
  }
  { name: "galaxy", x: courtWallDoors[4], z: courtWall, yaw: 180, look: brass, to: debugRoute("galaxy") }
  {
    name: "sun", x: courtEast, z: 6.6, yaw: 90, look: brass, to: debugRoute("sun")
    title: "PERIHELION", note: "A rock the sun passes once a day, the same sun that lights the valley. Step in and watch it come; keep to the rock while it passes, and do not fly to it."
  }
  {
    name: "globe", x: (courtFins[0] + galleryWall), z: 2.4, yaw: 270, look: ornate, to: debugRoute("globe")
    title: "THE BOTTLE WORLD", note: "A room whose gravity this gallery owns. Press the lever before it and watch which way the marbles fall; step in and someone out here can turn you over."
  }
  { name: "link-west", x: (courtFins[1] + galleryWall), z: 2.4, yaw: 270, look: brass, to: selfRoute("painting-link-east/glass") }
  { name: "link-east", x: courtFins[2], z: 2.4, yaw: 90, look: brass, to: selfRoute("painting-link-west/glass") }
]
// Each painting as a portal of the module, hung under the building's root on the wing's floor.
let paintingPortals = map(wallPaintings, painting => portalOf(
  id: $"painting-{painting.name}",
  x: painting.x,
  y: wingFloor,
  z: painting.z,
  yaw: painting.yaw,
  site: gallerySite,
  parent: "gallery",
  look: painting.look,
  to: painting.to,
  plaque: ({ title: painting.to.title, note: painting.to.note } with painting)
))

// The floor and ceiling paintings of the endless fall (layout.puck's `fallPlan`) stand over the same point; the ceiling
// one hangs under the slab, in the hole level 1's floor leaves over it, and a balustrade rings that hole
// (gallery/shell.puck). Each is a canvas lying flat rather than hung, so each is a creation of its own here, wearing
// the module's face.
let fallHalf = 1.12
let canvasRim = portalCanvasRim
// Shape rotations, as authored quaternions [x, y, z, w]: a quarter turn about +X lays a canvas (its +Z face) flat. The
// floor turns it to face up and the ceiling to face down; the ceiling placement's half turn about up then lines its right
// and up axes with the floor's, so a crossing keeps the traveller's heading.
let faceUp = [0.707107, 0, 0, 0.707107]
let faceDown = [-0.707107, 0, 0, 0.707107]
// The fall paintings' palette slots.
let paintGilt = 0
let paintLip = 1
let paintBlack = 2
let paintBoard = 3
let paintInk = 4
let fallPalette = [portalGiltRow, portalLipRow, portalBlackRow, portalBoardRow, portalInkRow]

// The wing's shell: a partition wall with a doorway, and a lining over the south, north and east walls, up to the slab
// above. Every piece is a box rather than a subtraction, so a visitor in the doorway meets analytic boxes rather than a
// carve's field solve (gallery/gallery.puck). The walls are a warm stone a shade under the hall's cream, so the wing reads as its own
// room and still carries its fixtures' light (gallery/gallery.puck's wingDownlights and wingWashes) about each canvas.
let wingWall = 0
let wingTrim = 1
let wingPalette = [
  { color: "#D8D2C6", roughness: 0.85, specular: 0.04 }
  { color: "#1B1F25", roughness: 0.6, specular: 0.15 }
]

// The showcase worlds the paintings open, and the debug world itself, which the pair across the room leads into.
references: concat([{ document: "debug", name: "self" }], portalReferences(debugShowcase))

destinations: concat(
  [{ durability: persisted, name: "self", reference: "self", scope: global }],
  portalDestinations(debugShowcase)
)

state {
  world {
    portalState(portals: filter(paintingPortals, portal => (portal.id != "painting-moon")))
  }
}

prototypes {
  // The wing's three fins, each a wall standing out from the south wall to the slab above.
  prototype "wing-fins" {
    document {
      name: "wing-fins"
      schema: "puck.creation.v2"
      palette: wingPalette
      for (x, n) in courtFins {
        boundsBox(
          label: $"fin-{n}",
          x0: x,
          x1: (x + galleryWall),
          y0: wingFloor,
          y1: wingTop,
          z0: galleryWall,
          z1: (galleryWall + courtFinLength),
          slot: wingWall
        )
        boundsBox(
          label: $"fin-skirting-{n}",
          x0: (x - 0.02),
          x1: ((x + galleryWall) + 0.02),
          y0: wingFloor,
          y1: 0.2,
          z0: galleryWall,
          z1: ((galleryWall + courtFinLength) + 0.02),
          slot: wingTrim
        )
      }
    }
  }

  portalPrototypes(portals: paintingPortals)

  // The floor painting of the endless fall: a gilt square lying flat, its canvas a hand proud of the floor, with a
  // plaque lying on the floor before it, read from the south.
  prototype "painting-fall-floor" {
    document {
      behavior {
        faces [{ name: "glass", shapeId: 0 }]
      }
      name: "painting-fall-floor"
      schema: "puck.creation.v2"
      palette: fallPalette
      shape Box "rim" {
        material: paintBlack
        position [0, 0, 0]
        rotation: compose(faceUp, rotate([0, 1, 0], 180))
        scale [fallHalf, fallHalf, 0.04]
      }
      shape Box "opening" {
        blend: Subtraction
        material: paintBlack
        position [0, 0, 0]
        rotation: faceUp
        scale [(fallHalf - canvasRim), (fallHalf - canvasRim), 0.3]
      }
      flatRing(label: "lip", ix: fallHalf, w: 0.05, y0: 0, y1: 0.05, slot: paintLip)
      flatRing(label: "border", ix: (fallHalf + 0.05), w: 0.22, y0: 0, y1: 0.07, slot: paintGilt)
      boundsBox(label: "plaque", x0: -0.5, x1: 0.5, y0: 0, y1: 0.02, z0: -2.15, z1: -1.55, slot: paintBoard)
      textRuns [
        {
          text: "THE ENDLESS FALL"
          position [0, 0.02, -1.98]
          rotation: compose(faceUp, rotate([0, 1, 0], 180))
          emHeight: 0.07
          depth: 0.004
          mode: "emboss"
          material: paintInk
          align: "center"
          maxWidth: 0.94
        }
        {
          text: "Step onto the glass and you fall, out of the ceiling and through the floor again. Backspace or L3 gets you out."
          position [0, 0.02, -1.86]
          rotation: compose(faceUp, rotate([0, 1, 0], 180))
          emHeight: 0.03
          depth: 0.003
          mode: "emboss"
          material: paintInk
          align: "center"
          maxWidth: 0.94
          lineSpacing: 1.15
        }
      ]
    }
  }

  // The ceiling painting of the endless fall: the floor's twin hung face down under the slab.
  prototype "painting-fall-ceiling" {
    document {
      behavior {
        faces [{ name: "glass", shapeId: 0 }]
      }
      name: "painting-fall-ceiling"
      schema: "puck.creation.v2"
      palette: fallPalette
      shape Box "rim" {
        material: paintBlack
        position [0, 0, 0]
        rotation: compose(faceDown, rotate([0, 1, 0], 180))
        scale [fallHalf, fallHalf, 0.04]
      }
      shape Box "opening" {
        blend: Subtraction
        material: paintBlack
        position [0, 0, 0]
        rotation: faceDown
        scale [(fallHalf - canvasRim), (fallHalf - canvasRim), 0.3]
      }
      flatRing(label: "lip", ix: fallHalf, w: 0.05, y0: -0.05, y1: 0, slot: paintLip)
      flatRing(label: "border", ix: (fallHalf + 0.05), w: 0.22, y0: -0.07, y1: 0, slot: paintGilt)
    }
  }
}

placements {
  placement "wing-fins" {
    prototype: "wing-fins"
    parent: "gallery"
    position [0, 0, 0]
    solid
  }

  portalPlacements(portals: filter(paintingPortals, portal => (portal.id != "painting-moon")))

  placement "painting-fall-floor" {
    prototype: "painting-fall-floor"
    parent: "gallery"
    position [fallPlan[0], wingFloor, fallPlan[1]]
    portalFace(destination: "self", counterpart: "painting-fall-ceiling/glass", fallback: portalFallbackSelf)
  }

  placement "painting-fall-ceiling" {
    prototype: "painting-fall-ceiling"
    parent: "gallery"
    position [fallPlan[0], (wingTop - 0.03), fallPlan[1]]
    yawDegrees: 180
    portalFace(destination: "self", counterpart: "painting-fall-floor/glass", fallback: portalFallbackSelf)
  }
}

// A spawn point before each painting, facing it, and two that frame several at once for the chase camera, which keeps
// its place behind the body (4 m back along its heading): `painting-room` where the lobby meets the wing, looking east
// along the south wall's paintings, and `portals` before the west court's three. Each is in the building's frame.
spawnPoints [
  { id: "painting-room", parent: gallery, position [(courtWest + 1.5), wingFloor, 6.8], yawDegrees: 300 }
  { id: "portals", parent: gallery, position [38, wingFloor, 6], yawDegrees: 18 }
  { id: "portal-garden", parent: gallery, position [34.4, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-night", parent: gallery, position [38, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-city", parent: gallery, position [41.6, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-moon", parent: gallery, position [48.5, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-galaxy", parent: gallery, position [52.5, wingFloor, 3.4], yawDegrees: 0 }
  { id: "portal-sun", parent: gallery, position [(courtEast - 3.1), wingFloor, 6.6], yawDegrees: 270 }
  {
    id: "portal-globe"
    parent: gallery
    position [((courtFins[0] + galleryWall) + 3.1), wingFloor, 2.4]
    yawDegrees: 90
  }
  {
    id: "portal-link"
    parent: gallery
    position [((courtFins[1] + galleryWall) + 3.2), wingFloor, 2.4]
    yawDegrees: 90
  }
  { id: "portal-fall", parent: gallery, position [fallPlan[0], wingFloor, (fallPlan[1] + 3.2)], yawDegrees: 0 }
  // Eleven metres north of the garden painting, facing it: the seam walk's second crossing (walkthrough-tests.puck).
  { id: "seam-painting", parent: gallery, position [34.4, wingFloor, 11.3], yawDegrees: 0 }
]
