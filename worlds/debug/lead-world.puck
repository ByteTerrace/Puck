// A creation whose state driver may lead on an input channel, on a world with nothing else (pose-clips step 8), a library.
// Key U is the `press` channel and key O the `switch` channel. A rule takes a press into the `pressPose` cell unless `refuse`
// is 1, and the seat wears a creation whose `finger` driver reads that cell. With `led` the driver names `press` as its
// `lead`, so the seat's own client may draw the press before the authority's answer arrives; without it the driver is the
// same and the authority computes the same. O toggles the `mode` register, whose family offers `press` in mode 0 and nothing
// in mode 1: a switch in the middle of a press ends it and publishes a new input epoch.

import "../standard/rig"

let pressDriver = {
  name: "finger"
  signal: "state.pressPose.$body"
  cadence: 1
  when ["always"]
}

template leadWorld(led) {
  channels [
    { name: "press", shape: Binary, composition: true }
    { name: "switch", shape: Binary, composition: true }
  ]
  state {
    body [{ name: "mode", kind: Counter, initial: 0, envelope { $type: "set", values [0, 1] } }]
    world {
      row {
        name: "pressPose"
        kind: "Fixed"
        capacity: 1
        cells [{ key: "0", value: "0" }]
      }
      // 1 while the rule is to refuse a press, as a stunned body would.
      row {
        name: "refuse"
        kind: Int
        value: 0
      }
    }
  }
  inputModes {
    global ["switch"]
    families [{
        name: "mode"
        selector { kind: BodyState, name: "mode" }
        default: "open"
        states [
          { name: "open", values ["0"], channels ["press"] }
          { name: "shut", values ["1"], channels [] }
        ]
        transitions [
          { from: "open", to: "shut", keep [] }
          { from: "shut", to: "open", keep [] }
        ]
      }
    ]
  }
  bindingOverlays [{
      id: "lead-fixture"
      document {
        version: "puck.input.bindings.v1"
        modifiers []
        chords [{chord [], group: "play", page {id: "base", entries [
                { id: "press", channel: "press", sources ["keyboard.u"] }
                { id: "switch", channel: "switch", sources ["keyboard.o"] }
              ]
            }
          }
        ]
      }
    }
  ]

  rule "take-press" {
    when channel(1, press) >= 1 and refuse == 0
    mode: Level
    pressPose["0"] = 1
  }
  rule "drop-press" {
    when channel(1, press) < 1
    mode: Level
    pressPose["0"] = 0
  }
  rule "switch-mode" {
    when inputEdge(1, switch, Press, 0)
    mode: Level
    setBodyState(key: 0, state: "mode", expression: 1 - bodyState(body, 0, mode))
  }

  looks {
    assignment {
      rows ["lead"]
      sequence {
        name: "r1"
        offset: 0
        step: 0
      }
    }
    rows [{
        name: "lead", scale: 1, source: creation(prototypeId: leadBody)
        motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
      }
    ]
  }
  prototypes {
    prototype "leadBody" {
      document {
        schema: "puck.creation.v1"
        name: "leadBody"
        palette [{ color: "#B8B0A8", emissive: 0, specular: 0.02, roughness: 0.85 }]
        drivers [led ? (pressDriver with { lead: "press" }) : pressDriver]
        shape Box "hand" {
          material: 0
          position [0, 1, 0]
          scale [0.12, 0.3, 0.06]
        }
        shape Box "finger" {
          material: 0
          parent: "hand"
          position [0, 1.4, 0]
          scale [0.03, 0.12, 0.03]
          swings [swing("finger", [1, 0, 0], 1.2, [0, 1.3, 0]) with { wave: "linear" }]
        }
      }
    }
  }
}
