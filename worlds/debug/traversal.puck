// Optional development route runner, body galleryPopulation. The sealed studio and gallery are independent passes.
import "shapes"
import "stand-in"
let traversalBody = galleryPopulation
// Route coordinates are WORLD coordinates. The studio course is offset (48, 0, -48).
let traversalStudioGoals = [
  { x: 60.0, y: 0.01, z: -30.0 } // approach
  { x: 60.0, y: 0.16, z: -34.5 } // 15 cm step
  { x: 60.0, y: 0.01, z: -37.0 }
  { x: 60.0, y: 0.31, z: -41.5 } // 30 cm step
  { x: 60.0, y: 0.01, z: -44.0 }
  { x: 60.0, y: 1.05, z: -50.9 } // 15 degree crest
  { x: 60.0, y: 0.01, z: -55.0 }
  { x: 60.0, y: 1.51, z: -59.6 } // 30 degree crest
  { x: 60.0, y: 0.01, z: -62.7 }
  { x: 60.0, y: 1.03, z: -66.3 } // six risers and landing
  { x: 60.0, y: 0.01, z: -69.5 }
  { x: 54.0, y: 0.01, z: -60.0 }
  { x: 54.0, y: 0.01, z: -48.0 }
  { x: 48.0, y: 0.31, z: -48.0 } // round studio dais
  { x: 48.0, y: 0.01, z: -30.0 }
]
// A goal at the lift on a level's floor, in the building's frame (gallery/layout.puck's `galleryWorld`).
function traversalLiftGoal(x, z, level) = { x: galleryWorld(x, 0, 0)[0], y: galleryFloor[level], z: galleryWorld(0, 0, z)[2] }
// The host places the idle stand-in at this pass's first goal before selecting start=15, count=26. The stairs are the
// south-west switchback (gallery/layout.puck): its first flight climbs the east half, its second the west half.
let traversalGalleryGoals = [
  { x: 10.175, y: 0.05, z: 19.875 } // south-west stair approach, before the first flight's foot
  { x: 10.175, y: 2.3, z: 13.5 } // first flight and half landing
  { x: 7.575, y: 2.3, z: 13.5 } // cross the landing round the spine
  { x: 8.525, y: 4.55, z: 21.175 } // second flight to level 1, out past the end pier onto the bridge
  { x: 14.5, y: 4.55, z: 21.175 } // north of the first arcade pier
  { x: 14.5, y: 4.55, z: 18.575 } // into the south gallery between the first two piers
  { x: 19.325, y: 4.55, z: 18.575 } // east along the gallery, clear of the bench
  traversalLiftGoal((liftX + 1), 1, 1) // call lift on level 1, before its plate
  traversalLiftGoal(liftX, liftZ, 1) // enter car, then request ground
  traversalLiftGoal(liftX, liftZ, 0) // ride down
  traversalLiftGoal(liftX, 2.5, 0) // leave car
]
let traversalGoals = concat(traversalStudioGoals, traversalGalleryGoals)

state {
  world {
    table traversal {
      run = 0
      start = 0
      count = length(traversalStudioGoals)
      timeout = 600
      tolerance = 32768 // raw Q16: half a metre
      waypoint = 0
      reached = 0
      missed = 0
      falls = 0
      done = 0
      tick = -1
    }
    row {
      name: "traversalRoute"
      kind: "Fixed"
      cells: flatMap(range(0, length(traversalGoals)), i => [
        { key: $"{i}x", value: traversalGoals[i].x }
        { key: $"{i}y", value: traversalGoals[i].y }
        { key: $"{i}z", value: traversalGoals[i].z }
      ])
    }
    table traversalFailures {
      "0" = 0
    }
    table traversalFalls
  }
}

prototypes {
  prototype "traversal-marker" {
    document {
      schema: "puck.creation.v2"
      name: "traversal-marker"
      palette [{ color: "#FF5845" }]
      shape Sphere "failure" {
        material: 0
        position [0, 0.12, 0]
        scale [0.09, 0.09, 0.09]
      }
    }
  }
}

placements {
  placement "traversal-stand-in" {
    prototype: "standIn"
    position [60, 0.05, -30]
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "walker"
      look: "standIn"
      source: "Idle"
    }
  }
}

addon "traversal" {
  modulePath: "addons/traversal.wat"
  hash: auto
  fuel: 0
  enabled: true
  requests [
    { capability: Observe, subject: "state:traversal" }
    { capability: Observe, subject: "state:traversalRoute" }
    { capability: Observe, subject: "state:liftAt" }
    { capability: Observe, subject: $"body:{traversalBody}" }
    { capability: Drive, subject: $"body:{traversalBody}" }
    { capability: Mutate, subject: "section:State" }
    { capability: Mutate, subject: "section:Placements" }
    { capability: Edit, subject: "state:traversal" }
    { capability: Edit, subject: "state:traversalFailures" }
    { capability: Edit, subject: "state:traversalFalls" }
    { capability: Edit, subject: "state:liftCall" }
  ]
}

grants [
  { grantee: "addon:traversal", capability: Observe, subject: "state:traversal", budget: 5 }
  { grantee: "addon:traversal", capability: Observe, subject: "state:traversalRoute", budget: 3 }
  { grantee: "addon:traversal", capability: Observe, subject: "state:liftAt", budget: 1 }
  { grantee: "addon:traversal", capability: Observe, subject: $"body:{traversalBody}", budget: 2 }
  { grantee: "addon:traversal", capability: Drive, subject: $"body:{traversalBody}", budget: 3 }
  { grantee: "addon:traversal", capability: Mutate, subject: "section:State", kindMask: "UpsertStateCell", budget: 10 }
  {
    grantee: "addon:traversal"
    capability: Mutate
    subject: "section:Placements"
    kindMask: "UpsertPlacement"
    budget: 2
  }
  {
    grantee: "addon:traversal"
    capability: Edit
    subject: "state:traversal"
    budget: 8
    writeMask: "Set,Add"
    kindMask: "UpsertStateCell"
  }
  { grantee: "addon:traversal", capability: Edit, subject: "state:traversalFailures", kindMask: "UpsertStateCell" }
  { grantee: "addon:traversal", capability: Edit, subject: "state:traversalFalls", kindMask: "UpsertStateCell" }
  {
    grantee: "addon:traversal"
    capability: Edit
    subject: "state:liftCall"
    budget: 1
    writeMask: "Set"
    kindMask: "UpsertStateCell"
  }
]
