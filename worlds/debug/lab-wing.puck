// The lab wing: a door in the gallery's level-0 north aisle for each lab (labs/README.md), the small worlds that each test
// one behaviour or a set of behaviours together, so a player debugs a feature as the team does: walk into a door's glass
// and you stand in its lab; turn round and its `arrival` frame brings you back out of the same door. Each door is the
// standard's portal module (../standard/portal.puck) standing free in the labs' teal, its plaque on a post at its right,
// and its glass shows the lab live while you stand outside. The debug world imports this file whole.
//
// The doors are layout.puck's `labWingPlan`, one row a lab: its bay along the aisle, its document and its plaque. An open
// lab's door leads to its entry of the portal library (portal-library.puck), which declares its destination; a row whose
// `open` is false stands its door and plaque with OPENING SOON on the glass and no portal, and names no destination, so
// a lab whose document has not landed costs nothing and opens by setting `open` alone.

import "../standard/portal"
import "labs/lab-kit"
import "portal-library"
import "gallery/layout"

// Each lab's door as a portal, on its bay's centre and the wing's tile row, its glass facing -z.
let labDoors = map(labWingPlan, lab => portalOf(
  id: $"lab-{lab.id}",
  x: bayX(lab.bay),
  y: galleryFloor[0],
  z: tileZ(labWingRow),
  yaw: 0,
  site: gallerySite,
  parent: "gallery",
  look: portalStanding(color: labFrameColor, roughness: 0.4, specular: 0.3, post: labFramePost),
  to: (lab.open ? galleryRoute($"lab-{lab.id}") : null),
  plaque: { title: lab.title, note: lab.note }
))

prototypes {
  portalPrototypes(portals: labDoors)
}

placements {
  portalPlacements(portals: labDoors)
}

// `lab-wing` stands at the aisle's west end looking east down the doors; `lab-<id>` stands before each door, facing it.
spawnPoints: concat(
  [
    {
      id: "lab-wing"
      parent: gallery
      position [bayX(1), galleryFloor[0], tileZ((arcadeRowNorth + 2))]
      yawDegrees: 250
    }
  ],
  portalSpawns(labDoors)
)
