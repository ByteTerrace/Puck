// The debug world's small system, shared by its worlds' documents: where the moon stands against the debug world
// (moon.puck, and everything in the debug world that shows it or leads to it), and the sun all of them see, which is
// a place of its own (sun.puck). A library: it emits no document.
//
// The two worlds' axes are the same and their origins differ by `moonCentre`: a point at `p` in the moon's world is the
// point `p + moonCentre` of the debug world. One relation places the moon's image in the valley's sky, the valley's
// image in the moon's, and both sides of the seam, so what a traveller sees ahead is where the crossing puts it.

import "../standard/skies"
import "../standard/stars"

// The moon's centre in the debug world's coordinates: about 5 km from the valley floor, 55 degrees up toward the
// north-east, over the lowest of the caldera's walls.
let moonCentre = [1840, 4100, 2200]
// The same point seen from the moon: the debug world's origin in the moon's coordinates.
let debugOrigin = [(0 - moonCentre[0]), (0 - moonCentre[1]), (0 - moonCentre[2])]

// The moon's radius, the distance from its centre inside which it pulls, and that pull.
let moonRadius = 600
let moonReach = 1500
let moonGravity = 6

// The planet under the valley: the pull a body feels on the valley floor and how far under the floor the planet's
// centre lies, which together are its mass as the moon's gravity and radius are the moon's. A small, dense world: the
// two are a double planet.
let planetGravity = 18
let planetRadius = 614
let planetCentre = [0, (0 - planetRadius), 0]
let planetMass = (planetGravity * planetRadius * planetRadius)
let moonMass = (moonGravity * moonRadius * moonRadius)

// The seam between the two authorities: a level plane over the valley floor, that wide and deep. Under it a body is
// the debug world's, over it the moon's. Its height is derived, never placed: on the line between the two centres the
// pulls balance `moonHold` metres from the moon's centre (the distance apart over one plus the root of the masses'
// ratio), and the seam is level with that point. Editing either world's gravity or radius moves it.
let centresApart = squareRoot(
  ((moonCentre[0] * moonCentre[0]) + ((moonCentre[1] + planetRadius) * (moonCentre[1] + planetRadius))) +
    (moonCentre[2] * moonCentre[2])
)
let moonHold = (centresApart / (1 + squareRoot(planetMass / moonMass)))
let skySeamAltitude = (moonCentre[1] - ((moonHold * (moonCentre[1] + planetRadius)) / centresApart))
let skySeamSpan = 20000

// One sun lights every world of the system, since they share a frame: the day all of them run, so the moon's lit side
// in the valley's sky is the side the valley's sun is on, its phase tells the hour, and a ship crossing the seam keeps
// its light. The debug world owns the day; the moon's and the sun's `day` rows follow it (moon.puck, sun.puck), from
// the same start at the same rate.
let sharedDaySeconds = 1440
let sharedDayStart = 10
let sharedNoonElevation = 46
let sharedSunHeading = 37

// The sun: a small star that circles the double planet once a day, `sunStar.distance` metres from the valley floor.
// The day is that orbit: every world of the system places the star where the shared `day` clock puts it on `sunTurn`,
// about the valley floor's place in its own coordinates, and lights itself from there (day.puck, moon.puck). The
// star's own world (sun.puck) rides a body on the same turn, so the sun in the valley's sky is the place a traveller
// stands beside.
let sunStar = star(radius: 140, distance: 15000, pull: 30)
let sunTurn = dayTurn(clock: "day", distance: sunStar.distance, heading: sharedSunHeading, noonElevation: sharedNoonElevation)

// The sun's companion: a small red star that circles it once every `pairSeconds`, `pairSeparation` metres out, in the
// plane of the day's turn. Every line from the valley floor to the sun lies in that plane, so from the valley the
// companion swings across the sun's disc and behind it twice a turn. The two make the system a binary: every world of
// it lights itself from both, the sun's world rides a body on the companion's turn about the sun's, and that world
// owns the pair's clock (`pair`), which the valley and the moon follow.
let companionStar = star(radius: 60, distance: 15000, illuminance: 12000, color: "#FF9A66", light: "companion", surface: "#FFB088", spots: "#7A2408", pull: 14)
let pairSeparation = 2000
let pairSeconds = 600
let companionTurn = pairTurn(clock: "pair", separation: pairSeparation, inclination: sharedNoonElevation, node: (0 - sharedSunHeading))

// How fast the sun's light and its pull cross the system. Each world reads the sun's rows that long after the sun
// wrote them (sun.puck, a followed row's `delaySeconds`), from where the sun stands at the day's start, so the moon,
// then the nearer of the two, meets a change first.
let influenceSpeed = 2500
let sunAtStart = map(sunDirection(sharedDayStart, sharedSunHeading, sharedNoonElevation), axis => axis * sunStar.distance)
let sunToPlanet = sunStar.distance
let sunToMoon = squareRoot(
  (((sunAtStart[0] - moonCentre[0]) * (sunAtStart[0] - moonCentre[0])) +
    ((sunAtStart[1] - moonCentre[1]) * (sunAtStart[1] - moonCentre[1]))) +
    ((sunAtStart[2] - moonCentre[2]) * (sunAtStart[2] - moonCentre[2]))
)
// The delays, rounded to a thirtieth of a second so each is a whole number of both worlds' ticks.
let sunDelayPlanet = (round((sunToPlanet / influenceSpeed) * 30) / 30)
let sunDelayMoon = (round((sunToMoon / influenceSpeed) * 30) / 30)

// The sun's own world (sun.puck) is centred on an outpost the star passes once a day: a rock `sunPassGap` metres
// inside the star's path, where the star stands at `sunPassHour`. `sunOutpost` is that rock in the debug world's
// coordinates, and `sunSystemCentre` the valley floor in the sun's.
let sunPassHour = 15
let sunPassGap = 520
let sunOutpost = map(
  sunDirection(sunPassHour, sharedSunHeading, sharedNoonElevation),
  axis => axis * (sunStar.distance - sunPassGap)
)
let sunSystemCentre = map(sunOutpost, axis => 0 - axis)

// The seam over the moon into the sun's world: a level plane `sunSeamHeight` metres above the moon's centre, clear of
// the moon's reach and of the moon trip's crossing (moon-route.puck flies 300 m over the reach), that wide and deep.
// Under it a body is the moon's, over it the sun's, so a ship climbing away from the moon flies on toward the star.
// The span keeps the plane clear of the star's own path, which no seam may hand on. `moonInSun` is the moon's centre
// in the sun's coordinates: a point at `p` in the moon's world stands at `p + moonInSun` in the sun's.
let sunSeamHeight = (moonReach + 600)
let sunSeamSpan = 12000
let moonInSun = [(moonCentre[0] - sunOutpost[0]), (moonCentre[1] - sunOutpost[1]), (moonCentre[2] - sunOutpost[2])]

// The launch field's pad on the valley floor (launch.puck), where the trip starts and ends: its centre over the ground,
// the height of its top, and the heading the ship on it faces.
let launchPad = [84, 86]
let launchPadTop = 0.35
let launchHeading = 220

// Space as both worlds draw it, so the sky is the same on either side of the seam: a near-black void and its stars.
let spaceColor = "#02030A"
let spaceLuminance = 1
let spaceStarLuminance = 3000
let spaceStarDensity = 90
let spaceStarBrightness = 1.3
let spaceStarSeed = 7
