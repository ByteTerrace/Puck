// The debug world's time of day: the standard's day cycle (skies.puck) on the hall's `key` sun, a 24-minute day that
// starts at ten in the morning, with the noon sun 46 degrees up toward +x and -z. A 24-minute day turns the sun a
// quarter of a degree a second, slow enough to watch the shadows creep and fast enough that a session sees a sunset.
// At night a deep-blue moon of 6 lux, brighter than a real full moon so the valley reads, lights it opposite the sun,
// under a night sky of 1 nit and its stars; the hall's exposure floor drops with the day to meet it (hall.puck). The
// moon that hangs in that sky is the moon's own world (moon.puck), which a painting and the launch field's ship reach.
// debug.md's "Time of day" gives the levers: write `day` to move the time, and its advance to hold the sun.

import "../standard/skies"
import "moon-frame"
// The hall keys its exposure floor on the day.
exports {
  reads [day]
}

// The air thins as the viewer climbs toward the sky seam (launch.puck's `altitude` clock, a view clock over the seam's
// height): the day's gradient gives way to the void and stars the moon's own sky draws (moon.puck), and the clouds
// drop out below, so the sky at the seam is the sky past it.
let airFade = {
  clock: altitude
  keys [
    { at: 0, value: 1 }
    { at: 250, value: 1 }
    { at: 1500, value: 0.25 }
    { at: 2250, value: 0, ease: Step }
  ]
}
let cloudFade = {
  clock: altitude
  keys [
    { at: 0, value: 1 }
    { at: 500, value: 1 }
    { at: 1400, value: 0, ease: Step }
  ]
}
// One star field answers the night and the height: the hour brings it out at night, and the climb brings it out by day,
// the greater of the two, at the night sky's luminance on the ground and space's at the seam.
let starsByHeight = {
  clock: altitude
  combine: Maximum
  keys [
    { at: 0, value: 0 }
    { at: 700, value: 0 }
    { at: 2250, value: 1, ease: Step }
  ]
}
let starLuminanceByHeight = {
  clock: altitude
  keys [
    { at: 0, value: 3 }
    { at: 700, value: 3 }
    { at: 2250, value: spaceStarLuminance, ease: Step }
  ]
}

dayCycle(
  daySeconds: sharedDaySeconds,
  start: sharedDayStart,
  noonElevation: sharedNoonElevation,
  heading: sharedSunHeading,
  airOpacity: airFade,
  cloudOpacity: cloudFade,
  space: [
    gradient(name: "void", luminance: spaceLuminance, stops: [
      { elevation: -1, color: spaceColor }
      { elevation: 1, color: spaceColor }
    ])
  ],
  cloudiness: 0.3,
  moonPeak: 6,
  moonColor: "#7088E8",
  nightLuminance: 1,
  starLuminance: starLuminanceByHeight,
  starDensity: spaceStarDensity,
  starBrightness: spaceStarBrightness,
  starSeed: spaceStarSeed,
  starOpacity: starsByHeight,
  // The moon: the moon's own world, seen from where the viewer stands in the frame the two worlds share, so it hangs
  // where the sky seam will put a ship and grows as the ship climbs toward it. Only its ground is drawn, so the
  // valley's air, stars and sun show round it and the clouds drift across it.
  bodies: [
    {
      $type: "view"
      name: "moon"
      destination: "moon"
      anchor: debugOrigin
      follow: true
      coverage: true
      bound { center [0, 0, 0], radius: (moonRadius + 30) }
      farDistance: 7000
      scale: 1
      refresh: 1
      shadows: false
      fallback: "#00000000"
    }
  ]
)
