// The size walk: a size field (standard/size-field.puck) along level 1's north gallery, where a body walking east shrinks
// from her full size to Alice's and walking back west grows again. It is the gallery's proving stretch for the shrinking
// level the corner staircases will lead into: the same field, laid along a flat corridor, so the curve and its feel are
// tuned here and carried onto the stairs unchanged. The debug world and the gallery root import it after size.puck,
// whose `size` register it writes.
//
//   plan (40, 4.55, northAisleMid)   the west end: full size
//   plan (52, 4.55, northAisleMid)   the east end: Alice's size
//
// The field reaches 3 m either side of the gallery's middle line, the gallery's whole floor short of its walls. Every
// value here is a plan position in the building's frame (layout.puck), placed in the world by `galleryWorld`.
//
// `sizeWalkAlice` is the size at the east end, a look and feel: chosen for how small the gallery's displays and benches
// read beside her, never derived. Retune it live with `world.state.cell.set sizeField-gallery-walk end <size>`, or edit
// it here and let the watch reload (gallery.md, "The size walk").
import "../standard/size-field"
import "gallery/layout"

let sizeWalkFloor = galleryFloor[1]
let sizeWalkWest = 40
let sizeWalkEast = 52
let sizeWalkAlice = 0.15

sizeField(
  name: "gallery-walk",
  from: galleryWorld(sizeWalkWest, sizeWalkFloor, northAisleMid),
  to: galleryWorld(sizeWalkEast, sizeWalkFloor, northAisleMid),
  start: 1,
  end: sizeWalkAlice,
  reach: 3
)

spawnPoints [
  // Two metres short of the walk's west end, facing east along it: walk ahead to shrink.
  { id: "size-walk", position: galleryWorld((sizeWalkWest - 2), sizeWalkFloor, northAisleMid), yawDegrees: 270 }
]
