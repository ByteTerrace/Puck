// What a rule fault does at every deciding place: `puck test worlds/debug/rule-faults-tests.puck --reproduce`.
// A fault in an evaluated gate conjunct closes the whole gate, under negation and disjunction too; a fault is not a
// false, so anything that remembers a verdict keeps the last one it read successfully; an effect that faults refuses
// the whole firing and everything the firing decided with it. With `a` at zero, `1 / a` divides by zero, so each
// faulting rule's gate closes on the arithmetic and each faulting effect refuses its firing. The control beside each
// reads or writes through an address that names no cell (`b` keys nothing the rows hold), an absence that converts to
// false at a gate and skips an effect, so its negation fires and its increment commits: the gates are evaluated, and
// only the fault keeps the others shut.
//
// Each block is one finding of the rule-faults design, named W1 to W16 (L1, its nested-scope law, is a C# law beside
// the latch laws). Every block is green: W1 to W9, W12 and W13 pin what the interpreter and the gate's verdict provide,
// W10 and W11 pin that a firing's latch bit and decision state rewind with its scope (W11 for its option, no-choice and
// neighbour effects, and for the liveness step reading the population its firing installs), and W14 and W15 that a
// decision's common and option effects are one firing. W16 distinguishes an absent body target from a stored zero.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "rule-faults-tests"

import "stand-in"

let faultAlphabet = [
  { name: "one", min: 1, max: 1 }
]
let zeroAlphabet = [
  { name: "zero", min: 0, max: 0 }
]

// A token pattern spells each token's letter through its value expression: a faulting letter faults the match, an
// absent letter leaves the match absent, and a genuine zero is a letter like any other.
patterns [
  { name: "faultRun", kind: Int, symbols: faultAlphabet, pattern: star(item: symbol(name: "one")) }
  { name: "tokenFault", kind: Int, value: cards[1 / a], symbols: zeroAlphabet, pattern: symbol(name: "zero") }
  { name: "tokenZero", kind: Int, value: cards[1] - 3, symbols: zeroAlphabet, pattern: symbol(name: "zero") }
  {
    name: "tokenAbsent"
    kind: Int
    value: tokens[zone(emptyDeck, last)]
    symbols: zeroAlphabet
    pattern: symbol(name: "zero")
  }
]

state {
  lattices [
    grid(name: "faultGrid", origin: [0, 0, 0], cellSize: 1, width: 2, depth: 2, wrap: None, directions: [
      { name: "N", x: 0, y: -1 }
      { name: "E", x: 1, y: 0 }
      { name: "S", x: 0, y: 1 }
      { name: "W", x: -1, y: 0 }
    ])
    grid(name: "searchGrid", origin: [0, 0, 0], cellSize: 1, width: 4, depth: 1, wrap: None)
  ]
  spaces {
    space faultSpace {
      model: "gate-fault-fixture"
      revision: "1"
      dimensions: 8
    }
  }
  world {
    // W16: topology cell 0 has never held a target. Cell 1 stores body index 0; the keyed row loses its cell at tick 19.
    row {
      name: "bodyTargets"
      kind: "Int"
      domain: cellsOf(topology: faultGrid)
      cells [{ key: "1", value: 0 }]
    }
    row {
      name: "removedBodyTarget"
      kind: "Int"
      cells [{ key: "target", value: 0 }]
    }
    table bodyTargetWitness {
      emptyLanded = 0
      removedLanded = 0
      zeroLanded = 0
      emptyFact = 0
      zeroFact = 0
    }
    row {
      name: "a"
      kind: "Int"
      value: 0
    }
    row {
      name: "b"
      kind: "Int"
      value: 5
    }
    row {
      name: "cards"
      kind: "Int"
      cells [{ key: "1", value: 3 }]
    }
    row {
      name: "nodes"
      kind: "Int"
      cells [{ key: "1", value: 5 }]
    }
    row {
      name: "labels"
      kind: "Text"
      cells [{ key: "1", value: "yes" }]
    }
    row {
      name: "hist"
      kind: "Int"
      domain: ring(capacity: 4, empty: -1)
    }
    row {
      name: "tiles"
      kind: "Int"
      capacity: 4
      domain: cellsOf(topology: faultGrid)
    }
    table vecs capacity(4) space(faultSpace)
    row {
      name: "keyFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "ageFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "vectorFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "originFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "offsetFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "symmetryFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "boardPatternFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "wordPatternFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "textFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "removeFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "keyControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "ageControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "vectorControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "originControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "offsetControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "symmetryControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "boardPatternControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "wordPatternControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "textControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "removeControl"
      kind: "Int"
      value: 0
    }
    row {
      name: "tokens"
      kind: "Int"
      capacity: 4
      cells [{ key: "1", value: 7 }]
    }
    pile deck of tokens capacity(4) {
      "1"
    }
    pile emptyDeck of tokens capacity(4)
    // One on every tick but tick 4, where every `1 / divisor` faults for that tick alone.
    row {
      name: "divisor"
      kind: "Int"
      value: 1
    }
    table fired {
      cue = 0
      token = 0
      absentLeft = 0
      edge = 0
      decisionPicked = 0
      decisionEmpty = 0
    }
    table control {
      cue = 0
      token = 0
      tokenAbsent = 0
      absentLeft = 0
      edge = 0
      decisionPicked = 0
      decisionEmpty = 0
    }

    // W8: the gate folds a sum over `cards` and then divides it by zero; the control divides it by a live row.
    row {
      name: "nestedFired"
      kind: "Int"
      value: 0
    }
    row {
      name: "nestedControl"
      kind: "Int"
      value: 0
    }

    // W10: an Edge rule whose effect divides by `crossingDivisor`, zero until tick 3, and how often it landed.
    row {
      name: "crossingDivisor"
      kind: "Int"
      value: 1
    }
    row {
      name: "crossingSink"
      kind: "Int"
      value: 0
    }
    row {
      name: "crossingLanded"
      kind: "Int"
      value: 0
    }

    // W11: a decision whose option effect divides by `choiceDivisor`, zero until tick 3, and how often it landed.
    row {
      name: "choiceDivisor"
      kind: "Int"
      value: 1
    }
    row {
      name: "choiceSink"
      kind: "Int"
      value: 0
    }
    row {
      name: "choiceLanded"
      kind: "Int"
      value: 0
    }

    // W14 and W15: decisions whose common effects and option effects are one firing, each with one half that faults until
    // tick 3 (`choiceDivisor`), and how often the half that does not fault landed.
    row {
      name: "pairCommonLanded"
      kind: "Int"
      value: 0
    }
    row {
      name: "pairOptionSink"
      kind: "Int"
      value: 0
    }
    row {
      name: "pairCommonSink"
      kind: "Int"
      value: 0
    }
    row {
      name: "pairOptionLanded"
      kind: "Int"
      value: 0
    }

    // W11's no-choice and neighbour cases. The observer is body 6 (`rule-faults-observer`), with body 5
    // (`rule-faults-kept`) a metre east and body 4 (`rule-faults-removed`) a metre south: the inhabited placements take
    // the numbers from the top of the capacity down, in document order. `meetScore` scores only body 5 and
    // `removedScore` only body 4, so every other neighbour's score is absent and declines.
    row {
      name: "observer"
      kind: "Int"
      capacity: 1
      cells [{ key: "6", value: 1 }]
    }
    row {
      name: "meetScore"
      kind: "Int"
      cells [{ key: "5", value: 1 }]
    }
    row {
      name: "removedScore"
      kind: "Int"
      cells [{ key: "4", value: 1 }]
    }
    // W11's cell-driven cases. Body 3 is `rule-faults-unrelated`; the cell-driven counts are admitted after every
    // literal one, so `rule-faults-counted` (its count `countedSize`) is body 2 and `rule-faults-counted-alone` (its
    // count `aloneSize`) is body 1.
    row {
      name: "countedScore"
      kind: "Int"
      cells [{ key: "2", value: 1 }]
    }
    row {
      name: "aloneScore"
      kind: "Int"
      cells [{ key: "1", value: 1 }]
    }
    row {
      name: "countedSize"
      kind: "Int"
      value: 1
    }
    row {
      name: "aloneSize"
      kind: "Int"
      value: 1
    }
    table decided {
      noChoicePicked = 0
      noChoiceLanded = 0
      noChoiceSink = 0
      emptyLanded = 0
      emptySink = 0
      scoreLanded = 0
      scoreEmpty = 0
      effectLanded = 0
      effectSink = 0
      untakenLanded = 0
      removedCommon = 0
      removedOption = 0
      countedCommon = 0
      countedOption = 0
      aloneCommon = 0
      aloneOption = 0
    }

    // W12: a one-token search whose judge faults while `searchFault` holds (before tick 30). `searchBest.score`
    // stays -1 until the job lands an answer, and `searchAtTwenty` is what it held at tick 20.
    row {
      name: "searchBoard"
      kind: "Int"
      domain: cellsOf(topology: searchGrid)
    }
    table searchPieces bounds(-1..3) {
      first = 0
      second = 3
    }
    slot searchTurn = 0 bounds(0..1)
    slot searchVerdict = 0 bounds(0..1)
    slot searchFault = 1 bounds(0..1)
    slot searchAtTwenty = -1
    table searchBest {
      token = -1
      to = -1
      score = -1
    }

    // W9: the active population as the tick's rules began reading it, until tick 12, and how far tick 12 lowered it.
    row {
      name: "populationSeen"
      kind: "Int"
      value: 0
    }
    row {
      name: "populationDrop"
      kind: "Int"
      value: 0
    }
    row {
      name: "afterInstall"
      kind: "Int"
      value: 0
    }
  }
}

// An idle stand-in placement inhabited by `count` bodies, a literal or a count cell.
template standIns(name, at, count) {
  placement name {
    prototype: "standIn"
    position: at
    inhabit {
      count: count
      distribution {
        fill { name: "additive", offset: 0, step: 0.001 }
        region: disc(radius: 0.01)
      }
      kit: "walker"
      look: "standIn"
      source: "Idle"
    }
  }
}

placements {
  standIns("rule-faults-inhabited", [0, 0.05, 0], 1)
  standIns("rule-faults-observer", [4, 0.05, 0], 1)
  standIns("rule-faults-kept", [5, 0.05, 0], 1)
  standIns("rule-faults-removed", [4, 0.05, 1], 1)
  standIns("rule-faults-unrelated", [3, 0.05, 0], 1)
  standIns("rule-faults-counted", [5, 0.05, 1], { row: "countedSize" })
  standIns("rule-faults-counted-alone", [5, 0.05, -1], { row: "aloneSize" })
}

search {
  jobs [
    {
      name: "searchOne"
      tokens: searchPieces
      board: searchBoard
      turn: searchTurn
      verdict: searchVerdict
      depth: 1
      nodes: 64
      best: searchBest
      score: searchPieces.first + searchPieces.second
    }
  ]
}

// Rules run in document order, so every rule below reads this tick's divisors.
rule "divisor-pulse" {
  mode: Level
  divisor = 1 - ($tick == 4)
}
rule "crossing-divisor" {
  mode: Level
  crossingDivisor = ($tick >= 3)
}
rule "choice-divisor" {
  mode: Level
  choiceDivisor = ($tick >= 3)
}
rule "search-fault-window" {
  mode: Level
  searchFault = ($tick < 30)
}
rule "search-at-twenty" {
  when $tick == 20
  mode: Level
  searchAtTwenty = searchBest.score
}

// W3: a faulting dynamic key or ring age closes its gate; an absent one converts to false.
rule "dynamic-key-fault" {
  when not cards[1 / a] == 3
  mode: Level
  keyFired += 1
}
rule "ring-age-fault" {
  when not history(hist, 1 / a) > 5
  mode: Level
  ageFired += 1
}
rule "dynamic-key-absent" {
  when not cards[b] == 3
  mode: Level
  keyControl += 1
}
rule "ring-age-absent" {
  when not history(hist, b) > 5
  mode: Level
  ageControl += 1
}

// W2: a faulting vector, board-origin, symmetry, pattern or text address closes its gate.
rule "vector-key-fault" {
  when not identical(vecs[1 / a], vector("fwAAAAAAAAA")) == 1
  mode: Level
  vectorFired += 1
}
rule "board-origin-fault" {
  when not board(neighbour, tiles, E)[1 / a] == 99
  mode: Level
  originFired += 1
}
rule "board-offset-fault" {
  when not board(offset, tiles, 1, 0)[1 / a] == 99
  mode: Level
  offsetFired += 1
}
rule "symmetry-key-fault" {
  when not symmetry(ring, nodes)[1 / a] == 99
  mode: Level
  symmetryFired += 1
}
rule "board-pattern-fault" {
  when not match(faultRun, tiles, E)[1 / a] == 99
  mode: Level
  boardPatternFired += 1
}
rule "word-pattern-fault" {
  when not match(faultRun, cards)[1 / a] == 99
  mode: Level
  wordPatternFired += 1
}
rule "text-key-fault" {
  when not labels[1 / a] == "yes"
  mode: Level
  textFired += 1
}
rule "vector-key-absent" {
  when not identical(vecs[b], vector("fwAAAAAAAAA")) == 1
  mode: Level
  vectorControl += 1
}
rule "board-origin-absent" {
  when not board(neighbour, tiles, E)[b] == 99
  mode: Level
  originControl += 1
}
rule "board-offset-absent" {
  when not board(offset, tiles, 1, 0)[b] == 99
  mode: Level
  offsetControl += 1
}
rule "symmetry-key-absent" {
  when not symmetry(ring, nodes)[b] == 99
  mode: Level
  symmetryControl += 1
}
rule "board-pattern-absent" {
  when not match(faultRun, tiles, E)[b] == 99
  mode: Level
  boardPatternControl += 1
}
rule "word-pattern-absent" {
  when not match(faultRun, cards)[b] == 99
  mode: Level
  wordPatternControl += 1
}
rule "text-key-absent" {
  when not labels[b] == "yes"
  mode: Level
  textControl += 1
}

// W1: a faulting remove key refuses its whole firing, so the increment before it never lands.
rule "remove-key-fault" {
  mode: Level
  removeFired += 1
  remove cards[1 / a]
}
rule "remove-key-absent" {
  mode: Level
  removeControl += 1
  remove cards[b]
}

// W5: a computed body key is resolved like a literal one: faulting, it refuses the firing; naming body 0, it fires.
rule "cue-key-fault" {
  mode: Level
  fired.cue += 1
  emitCue(name: "gateFaultProbe", key: 1 / a)
}
rule "cue-key-computed" {
  mode: Level
  control.cue += 1
  emitCue(name: "gateFaultProbe", key: b - 5)
}

// W6: a faulting token letter faults the match; an absent letter names none; a genuine zero is a letter.
rule "token-fault" {
  when match(tokenFault, deck) == 1
  mode: Level
  fired.token += 1
}
rule "token-zero" {
  when match(tokenZero, deck) == 1
  mode: Level
  control.token += 1
}
rule "token-absent" {
  when not match(tokenAbsent, deck) == 1
  mode: Level
  control.tokenAbsent += 1
}

// W7: the left side reads an empty pile's endpoint, absent; the right side is still read, and its fault wins.
rule "absent-left-fault" {
  when not (tokens[zone(emptyDeck, last)] + 0) == cards[1 / a]
  mode: Level
  fired.absentLeft += 1
}
rule "absent-left-absent" {
  when not (tokens[zone(emptyDeck, last)] + 0) == cards[b]
  mode: Level
  control.absentLeft += 1
}

// W4: a fault holds the last decided gate. The faulting Edge rule fires once and the faulting decision keeps its
// choice and runs no onNoChoice, while the controls, whose gates truly close on tick 4 (labels holds no cell "2"),
// re-arm and fire again, clear the choice, run onNoChoice and pick again when the gate reopens.
rule "edge-fault" {
  when labels[1 / divisor] == "yes"
  mode: Edge
  fired.edge += 1
}
rule "edge-closed" {
  when labels[2 - divisor] == "yes"
  mode: Edge
  control.edge += 1
}
rule "decision-fault" {
  when labels[1 / divisor] == "yes"
  mode: Level
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Fixed
    option "only" {
      score: 1
      fired.decisionPicked += 1
    }
    onNoChoice {
      fired.decisionEmpty += 1
    }
  }
}
rule "decision-closed" {
  when labels[2 - divisor] == "yes"
  mode: Level
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Fixed
    option "only" {
      score: 1
      control.decisionPicked += 1
    }
    onNoChoice {
      control.decisionEmpty += 1
    }
  }
}

// W8: a fold that succeeds before the arithmetic that fails after it. The failure is the gate's fault, whatever the
// fold before it answered.
rule "nested-success-fault" {
  when not (sum(cards, c -> c) / a) == 3
  mode: Level
  nestedFired += 1
}
rule "nested-success-control" {
  when not (sum(cards, c -> c) / b) == 3
  mode: Level
  nestedControl += 1
}

// W10: the crossing is consumed only by a firing that lands. The effect faults on tick 2, the tick the gate first
// opens, so the Edge rule has not fired; it fires on tick 3, when the effect no longer faults.
rule "crossing-effect-fault" {
  when $tick >= 2
  mode: Edge
  crossingLanded += 1
  crossingSink = 1 / crossingDivisor
}

// W11: a decision's choice is installed only by a firing that lands. The option effect faults on tick 1 and 2, so no
// choice stands and the decision picks again on tick 3, when the effect no longer faults.
rule "choice-effect-fault" {
  mode: Level
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Fixed
    option "only" {
      score: 1
      choiceLanded += 1
      choiceSink = 1 / choiceDivisor
    }
  }
}

// W14: the common effects and the option effects are one firing. The option effect faults on tick 0 to 2, so the common
// increment that precedes it is rewound with it and the choice stands for no tick; both land together on tick 3.
rule "common-lands-option-faults" {
  mode: Level
  pairCommonLanded += 1
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Fixed
    option "only" {
      score: 1
      pairOptionSink = 1 / choiceDivisor
    }
  }
}

// W15: the common effect faults on tick 0 to 2, so the option's increment does not land beside it and the choice is not
// installed; both land together on tick 3.
rule "common-faults-option-lands" {
  mode: Level
  pairCommonSink = 1 / choiceDivisor
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Fixed
    option "only" {
      score: 1
      pairOptionLanded += 1
    }
  }
}

// W11, no-choice: the gate closes on tick 2 and the onNoChoice effect faults until tick 3. Clearing the choice and
// running onNoChoice are one firing, so the faulted firing keeps the choice and onNoChoice runs again, landing once.
rule "no-choice-effect-fault" {
  when $tick < 2
  mode: Level
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Fixed
    option "only" {
      score: 1
      decided.noChoicePicked += 1
    }
    onNoChoice {
      decided.noChoiceLanded += 1
      decided.noChoiceSink = 1 / choiceDivisor
    }
  }
}

// W11, no option offered: the first evaluation has no choice to make and runs onNoChoice, which faults until tick 3. The
// faulted firing leaves the decision unevaluated, so it evaluates again and onNoChoice lands once.
rule "empty-choice-effect-fault" {
  mode: Level
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Fixed
    option "never" {
      when b == 0
      score: 1
      decided.emptySink = 0
    }
    onNoChoice {
      decided.emptyLanded += 1
      decided.emptySink = 1 / choiceDivisor
    }
  }
}

// W11, a neighbour whose score faults: the decision holds, so it neither picks another nor runs onNoChoice, and picks
// the neighbour once its score stops faulting.
rule "neighbour-score-fault" {
  mode: Level
  forEach: observer
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Int
    option "meet" {
      score: meetScore[$right] / choiceDivisor
      decided.scoreLanded += 1
      neighbors {
        candidateBudget: 8
        halfAngleDegrees: 180
        maxCandidates: 4
        range: 10
        requiresLineOfSight: false
        retainCurrent: true
      }
    }
    onNoChoice {
      decided.scoreEmpty += 1
    }
  }
}

// W11, a neighbour whose option effect faults: the pair's firing rewinds with its choice, and lands once.
rule "neighbour-effect-fault" {
  mode: Level
  forEach: observer
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Int
    option "meet" {
      score: meetScore[$right]
      decided.effectLanded += 1
      decided.effectSink = meetScore[$right] / choiceDivisor
      neighbors {
        candidateBudget: 8
        halfAngleDegrees: 180
        maxCandidates: 4
        range: 10
        requiresLineOfSight: false
        retainCurrent: true
      }
    }
  }
}

// W11, liveness read against the proposed population: a removal under a branch the common effects do not take leaves
// the neighbour in the population the firing installs, so the option runs.
rule "liveness-untaken-removal" {
  mode: Level
  forEach: observer
  if b == 0 {
    removePlacement(id: `rule-faults-kept`)
  }
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Int
    option "meet" {
      score: meetScore[$right]
      decided.untakenLanded += 1
      neighbors {
        candidateBudget: 8
        halfAngleDegrees: 180
        maxCandidates: 4
        range: 10
        requiresLineOfSight: false
        retainCurrent: true
      }
    }
  }
}

// W11, a common effect that removes the chosen neighbour: the option is not proposed and the common effects stand.
rule "liveness-removal" {
  mode: Level
  forEach: observer
  decided.removedCommon += 1
  removePlacement(id: `rule-faults-removed`)
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Int
    option "meet" {
      score: removedScore[$right]
      decided.removedOption += 1
      neighbors {
        candidateBudget: 8
        halfAngleDegrees: 180
        maxCandidates: 4
        range: 10
        requiresLineOfSight: false
        retainCurrent: true
      }
    }
  }
}

// W11, a common effect that zeroes the chosen neighbour's count cell with no document row: the counts settle from the
// firing's writes, which retire the neighbour, so the option is not proposed and the common effects stand.
rule "liveness-count-alone" {
  when $tick == 2
  mode: Level
  forEach: observer
  decided.aloneCommon += 1
  aloneSize = 0
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Int
    option "meet" {
      score: aloneScore[$right]
      decided.aloneOption += 1
      neighbors {
        candidateBudget: 8
        halfAngleDegrees: 180
        maxCandidates: 4
        range: 10
        requiresLineOfSight: false
        retainCurrent: true
      }
    }
  }
}

// W11, a common effect that zeroes the chosen neighbour's count cell and removes another placement: the install
// rebuilds the population and its cell-driven reconcile retires the neighbour, so the option is not proposed.
rule "liveness-count-install" {
  when $tick == 2
  mode: Level
  forEach: observer
  decided.countedCommon += 1
  countedSize = 0
  removePlacement(id: `rule-faults-unrelated`)
  decision {
    periodSeconds: 1s
    mode: HighestScore
    scoreKind: Int
    option "meet" {
      score: countedScore[$right]
      decided.countedOption += 1
      neighbors {
        candidateBudget: 8
        halfAngleDegrees: 180
        maxCandidates: 4
        range: 10
        requiresLineOfSight: false
        retainCurrent: true
      }
    }
  }
}

// W12: the judge accepts every relocation, then faults while the window holds. A candidate whose judge faults is a
// faulted candidate and not a scored one, so the step restarts and no answer lands until the window closes.
rule "search-accept" {
  when search(ply) >= 1
  mode: Level
  searchVerdict = 1
  searchTurn = 1 - searchTurn
}
rule "search-judge-fault" {
  when search(ply) >= 1 and searchFault == 1
  mode: Level
  searchVerdict = 1 / a
}

// W9: a delivery runs after its firing's commit, and a firing whose rows change the document installs that document
// before any delivery. Here the firing removes an inhabited placement, so the install leaves the active population one
// smaller. The cue key divides by one with the population the firing proposed, and the evaluator reads it once, with
// the firing: the delivery after the install evaluates nothing, so the smaller population cannot make it divide by
// zero, and the committed firing stands. The install rule reads the population the tick began with because rules run
// in document order.
rule "population-drop" {
  when $tick == 14
  mode: Level
  populationDrop = populationSeen - $population
}
rule "population-seen" {
  when $tick < 13
  mode: Level
  populationSeen = $population
}
rule "install-delivery-fault" {
  when $tick == 12
  mode: Level
  afterInstall += 1
  removePlacement(id: `rule-faults-inhabited`)
  emitCue(name: "ruleFaultProbe", key: 1 / ($population - populationSeen + 1))
}

// W16: both body-reference paths read the same live absence. An absent pose refuses its whole firing, including
// the preceding increment. A stored zero still selects body 0, in both an effect and a fact.
// Start after the population witnesses settle, so moving the seat cannot change their neighbour selection.
rule "body-target-remove" {
  when $tick == 19
  mode: Level
  remove removedBodyTarget.target
}
rule "body-target-zero" {
  when $tick >= 20
  mode: Level
  bodyTargetWitness.zeroLanded += 1
  poseCell(key: `cell:bodyTargets:1`, topology: faultGrid, expression: 0, offset: [2, 0.05, 0])
}
rule "body-target-empty" {
  when $tick >= 20
  mode: Level
  bodyTargetWitness.emptyLanded += 1
  poseCell(key: `cell:bodyTargets:0`, topology: faultGrid, expression: 3, offset: [20, 0.05, 0])
}
rule "body-target-removed" {
  when $tick >= 20
  mode: Level
  bodyTargetWitness.removedLanded += 1
  poseCell(key: `cell:removedBodyTarget:target`, topology: faultGrid, expression: 3, offset: [30, 0.05, 0])
}
rule "body-target-empty-fact" {
  when $tick >= 20 and not bodyPosition(cell, bodyTargets, 0, x) == bodyPosition(body, 0, x)
  mode: Level
  bodyTargetWitness.emptyFact += 1
}
rule "body-target-zero-fact" {
  when $tick >= 20 and bodyPosition(cell, bodyTargets, 1, x) == bodyPosition(body, 0, x)
  mode: Level
  bodyTargetWitness.zeroFact += 1
}

test "W16 an empty body target refuses its firing and a stored zero still names body 0" {
  when {
    ticks 30
  }
  expect {
    bodyTargetWitness.emptyLanded == 0
    bodyTargetWitness.removedLanded == 0
    bodyTargetWitness.zeroLanded > 0
    bodyTargetWitness.emptyFact > 0
    bodyTargetWitness.zeroFact > 0
    bodyPosition(body, 0, x) == 2.5
  }
}

test "W1 a faulting remove key refuses its whole firing and the write before it" {
  when {
    ticks 10
  }
  expect {
    removeFired == 0
    cards[1] == 3
    removeControl > 0
  }
}

test "W2 a faulting vector, board, symmetry, pattern or text address closes its gate" {
  when {
    ticks 10
  }
  expect {
    vectorFired == 0
    originFired == 0
    offsetFired == 0
    symmetryFired == 0
    boardPatternFired == 0
    wordPatternFired == 0
    textFired == 0
    vectorControl > 0
    originControl > 0
    offsetControl > 0
    symmetryControl > 0
    boardPatternControl > 0
    wordPatternControl > 0
    textControl > 0
  }
}

test "W3 a faulting dynamic key or ring age closes its gate" {
  when {
    ticks 10
  }
  expect {
    keyFired == 0
    ageFired == 0
    keyControl > 0
    ageControl > 0
  }
}

test "W4 a fault holds the last decided gate" {
  when {
    ticks 10
  }
  expect {
    fired.edge == 1
    control.edge == 2
    fired.decisionPicked == 1
    fired.decisionEmpty == 0
    control.decisionPicked == 2
    control.decisionEmpty == 1
  }
}

test "W5 a faulting effect key refuses its firing and a valid computed key keeps its body" {
  when {
    ticks 10
  }
  expect {
    fired.cue == 0
    control.cue > 0
  }
}

test "W6 a faulting token letter faults its match, and an absent one names none" {
  when {
    ticks 10
  }
  expect {
    fired.token == 0
    control.token > 0
    control.tokenAbsent > 0
  }
}

test "W7 an absent left side never hides a faulting right side" {
  when {
    ticks 10
  }
  expect {
    fired.absentLeft == 0
    control.absentLeft > 0
  }
}

test "W8 a failure after a nested success is still the gate's fault" {
  when {
    ticks 10
  }
  expect {
    nestedFired == 0
    nestedControl > 0
  }
}

test "W9 a delivery after a firing installs a document evaluates nothing" {
  when {
    ticks 16
  }
  expect {
    afterInstall == 1
    populationDrop == 1
  }
}

test "W10 an effect that faults leaves the Edge crossing unconsumed" {
  when {
    ticks 10
  }
  expect {
    crossingLanded == 1
  }
}

test "W11 a decision firing that faults decides nothing, and an option reads the population its firing installs" {
  when {
    ticks 10
  }
  expect {
    choiceLanded == 1
    decided.noChoicePicked == 1
    decided.noChoiceLanded == 1
    decided.emptyLanded == 1
    decided.scoreLanded == 1
    decided.scoreEmpty == 0
    decided.effectLanded == 1
    decided.untakenLanded == 1
    decided.removedCommon == 1
    decided.removedOption == 0
    decided.aloneCommon == 1
    decided.aloneOption == 0
    aloneSize == 0
    decided.countedCommon == 1
    decided.countedOption == 0
    countedSize == 0
  }
}

test "W14 an option effect that faults rewinds the common effects with it" {
  when {
    ticks 10
  }
  expect {
    pairCommonLanded == 1
  }
}

test "W15 a common effect that faults lands no option effect" {
  when {
    ticks 10
  }
  expect {
    pairOptionLanded == 1
  }
}

test "W12 a candidate whose judge faults lands no answer" {
  when {
    ticks 90
  }
  expect {
    searchAtTwenty == -1
    searchBest.score >= 0
  }
}
