import "layout"
import "../game-stations"
// The gallery's game floor on level 3 (layout.puck's galleryGameStations plans twelve stations, six on each gallery).
// It stands the plan's first, south3, the debug world set's station (../game-stations.puck) holding its own games: chess,
// whose pieces its holodeck stands on the glass as bodies while chess is shown, and Klondike and FreeCell. The rest of
// the plan waits on the rule work sheet beside the rest of the debug world (../game-station.md, "Cost"); the board
// games lab's stress mode stands twelve. The gallery imports this file, so the station stands in the debug world and
// gallery-root alike, and each root imports its card bodies from ../game-station-deck.puck where its body order wants
// them: the debug world numbers its bodies below the deck from it, so its cards stand always (`holodeck: false`) rather
// than as a pool, and its chess pieces take the free slots the population keeps for them (../shapes.puck's
// galleryPopulation). ../game-station.md says how to play and drive it.

let stations = [galleryGameStations[0]]

prototypes {
  gameStationSetPrototypes(stations: stations)
}

placements {
  gameStationSetPlacements(stations: stations)
}

// At the first station's near chair (south3), 1.5 m from its centre at its -Z edge and facing +Z across the glass,
// inside the engage radius: the context button sits her down.
spawnPoints [
  { id: "cards", position: gameStationChairAt(stations[0], "near"), yawDegrees: 180 }
]

state {
  // The chess game's vocabularies (../game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }

  gameStationSetGrids(stations: stations)
  world {
    gameStationSetState(stations: stations, holodeck: false)
  }
}

commands: gameStationSetCommands(stations)

gameStationSetRules(holodeck: false)
chessStationSet(stations: stations)

// One instance a station, aliased by the station's id.
use gameStationGames as south3(station: stations[0], index: 0)
