import "../../standard/game-station"
import "../../games/chess-station"
import "../../games/solitaire"
import "../../games/patience-station"
import "../game-stations"
// The board game room's game station: the standard's station (../../standard/game-station.puck) with the debug world
// set's catalog (../game-stations.puck), where the card table stood. Its glass plays chess (chess-station.puck, over the
// chess game the root composes: the debug world's physical table, chess.puck, or a drawn board, chess-game.puck) and the
// patience collection (patience-station.puck, over solitaire.puck, with the deck a root imports from
// ../game-station-deck.puck). The gallery imports this file, so the station stands in the debug world and gallery-root
// alike. ../game-station.md says how to play and drive it.

prototypes {
  gameStationPrototype(station: boardRoomStation, catalog: gameStationCatalog, boardPanels: chessStationPanels(boardRoomStation))
  chessStationPrototypes()
  patienceStationPrototypes()
}

placements {
  gameStationPlacement(station: boardRoomStation)
  chessStationTokens(station: boardRoomStation, game: 0)
  patienceStationSpots(station: boardRoomStation)
}

// At the station's chair, its -Z edge, 1.5 m from its centre and facing +Z across the glass, inside the engage radius:
// the context button sits her down.
spawnPoints [
  { id: "cards", position [boardRoomStation.at[0], (boardRoomStation.at[1] + gameStationFloor), (boardRoomStation.at[2] - 1.5)], yawDegrees: 180 }
]

state {
  gameStationGrid(station: boardRoomStation)
  patienceStationSlots(station: boardRoomStation)
  world {
    gameStationState(stations: [boardRoomStation], catalog: gameStationCatalog)
    chessStationState(stations: [boardRoomStation])
    patienceStationState()
  }
}

gameStationRules(station: boardRoomStation, catalog: gameStationCatalog)
chessStationRules(station: boardRoomStation, game: 0, ordinal: 0)
patienceStationRules(station: boardRoomStation, klondike: 1, freecell: 2)

commands: gameStationCommands([boardRoomStation], gameStationCatalog)
