import "layout"
import "../game-stations"
// The gallery's game floor on level 3 (layout.puck's galleryGameStations plans twelve stations, six on each gallery).
// It stands the plan's first, south3, the debug world set's station (../game-stations.puck) in its shared-chess form:
// its Klondike and FreeCell are its own, and its chess is the world's (the debug world's chess table, or
// ../../games/chess-game.puck's drawn board in gallery-root), so a move at the glass moves the table's pieces too. The
// rest of the plan waits on the rule work sheet: each station holding its own chess adds about 0.26 million work units a
// tick, so twelve beside the rest of the debug world exceed the tick's 4.2 million (../game-station.md, "Cost"). The
// gallery imports this file, so the
// station stands in the debug world and gallery-root alike, and each root imports its card bodies from
// ../game-station-deck.puck where its body order wants them. ../game-station.md says how to play and drive it.

let stations = [galleryGameStations[0]]

prototypes {
  gameStationSetPrototypes(stations: stations)
}

placements {
  gameStationSetPlacements(stations: stations)
}

// At the first station's near chair (south3), 1.5 m from its centre at its -Z edge and facing +Z across the glass,
// inside the engage radius: the context button sits her down.
spawnPoints [
  { id: "cards", position: gameStationChairAt(stations[0], "near"), yawDegrees: 180 }
]

state {
  // The chess game's vocabularies (../game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }

  gameStationSetGrids(stations: stations)
  world {
    gameStationSetState(stations: stations)
  }
}

commands: gameStationSetCommands(stations)

gameStationSetRules()

// One instance a station, aliased by the station's id.
use gameStationSharedChess as south3(station: stations[0], index: 0)
