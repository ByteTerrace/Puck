import "layout"
import "../game-stations"
// The gallery's board game room on level 2 (layout.puck's galleryGameStations: twelve stations in two rows of six), as
// the gallery booted alone stands it (gallery-root.puck imports this file), all twelve (`galleryRoomStations`): each the
// debug world set's station (../game-stations.puck) holding its own games, chess, whose pieces its holodeck stands on the
// glass as bodies while chess is shown, and Klondike and FreeCell, whose cards it stands the same way. Every station
// plays one set of rules, each station's game its own, so a move at one station never touches another. The debug world
// stands only the first (../game-station-deck.puck). ../game-station.md says how to play and drive them.

gameStationSet(stations: galleryRoomStations)

// At the first station's near chair (a1), 1.5 m from its centre at its -Z edge and facing +Z across the glass, inside
// the engage radius: the context button sits her down.
spawnPoints [
  { id: "cards", position: gameStationChairAt(galleryRoomStations[0], "near"), yawDegrees: 180 }
  { id: "chess", position: gameStationChairAt(galleryRoomStations[0], "near"), yawDegrees: 180 }
]

state {
  // The chess game's vocabularies (../game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}
