// The gallery's plan, every dimension the building and what stands in it are placed by (gallery.md beside this file
// draws it). A module library: it hands its importers lets and functions and emits no document.
//
// Positions are in the building's own frame, metres: x runs east from the hall's old west face (the west wall now stands at `galleryWestOut`, -3.75), z north
// from the south wall's outer face (0 .. 36.85), y up from the ground. The building's rows are placed under one root
// placement, `gallery` (gallery.puck), so a world stands the building by giving that row a position and a turn; the
// yaw of a row here is the row's own, with yaw 0 facing -z (south) and yaw 180 facing +z, as a placement's does.

import "../../standard/paths"
import "../../standard/limbs"

// Where the debug world stands the building: its root placement's position. A document that stands something in the
// building by world coordinates (a table's lattice, a painting's door) adds it to a plan position with `galleryWorld`.
// The site keeps the nave's west arcade at world x 22 and its south edge at world z 20.375 however the aisles are sized.
let gallerySite = [(22 - naveWest), 0, (20.375 - naveSouth)]
function galleryWorld(x, y, z) = [(gallerySite[0] + x), (gallerySite[1] + y), (gallerySite[2] + z)]

// Four storeys 4.5 m apart: level k's floor top stands at 4.5k + 0.05, on a slab 0.3 m thick, under a ceiling 4.2 m up.
let galleryStorey = 4.5
let galleryFloor = map(range(0, 4), k => ((galleryStorey * k) + 0.05))
let galleryCeiling = map(range(0, 4), k => ((galleryStorey * (k + 1)) - 0.25))
let galleryRoof = 18.05
let galleryParapet = 19.1

// The footprint's walls, 0.3 m thick; its depth follows the nave (below).
let galleryWall = 0.3

// The grid. The hall's floor is a whole number of 1.25 m tiles, and every dimension of the plan is a count of them:
// along x, thirteen arcade bays of four tiles and the last pier's tile (53 tiles); along z, six tiles of aisle, the
// nave's seventeen and six more (29 tiles). Tile (i, j) counts from the south-west corner of the walls' inner faces, so
// a wall's inner face always lies on a tile's edge, and the piers, displays and furniture stand on tile centres. The
// floor's tile paint, the ceiling's coffers, the piers and the displays all share this one module.
let galleryTile = 1.25
let galleryBays = 13
let galleryBayTiles = 4
let galleryAisleTiles = 6
let galleryNaveTiles = 17
let gridTilesX = ((galleryBays * galleryBayTiles) + 1)
let gridTilesZ = ((2 * galleryAisleTiles) + galleryNaveTiles)
// The grid's south-west corner in the plan's frame. The plan's x 0 is the hall's old west face, three tiles east of
// the grid's west edge; z 0 is the south wall's outer face.
let gridX0 = (galleryWall - (3 * galleryTile))
let gridZ0 = galleryWall
// A tile's centre, a tile's west or south edge, along x and z.
function tileX(i) = (gridX0 + ((i + 0.5) * galleryTile))
function tileZ(j) = (gridZ0 + ((j + 0.5) * galleryTile))
function tileEdgeX(i) = (gridX0 + (i * galleryTile))
function tileEdgeZ(j) = (gridZ0 + (j * galleryTile))
// The arcades: a pier on every fourth tile from the west wall's, fourteen of them, the first and last against the end
// walls; bay b lies between piers b and b + 1, its centre on the middle tile of its four.
function pierX(b) = tileX((galleryBayTiles * b))
function bayX(b) = tileX(((galleryBayTiles * b) + (galleryBayTiles / 2)))
let arcadeXs = map(range(0, (galleryBays + 1)), b => pierX(b))
let arcadePitch = (galleryBayTiles * galleryTile)
// The bays alternate: the odd ones are the showcase's, each holding a pair of displays across the nave (six bays, twelve
// stations), and the even ones are for rest, each holding a bench against each long wall (seven bays).
let showcaseBays = map(range(0, ((galleryBays - 1) / 2)), n => ((2 * n) + 1))
let restBays = map(range(0, ((galleryBays + 1) / 2)), n => (2 * n))
// The rows: each long wall's first tile row, the arcades' rows (a pier's tile, behind each balcony edge), and the two
// showcase rows, mirrored about the nave's centre row.
let wallRowSouth = 0
let wallRowNorth = (gridTilesZ - 1)
let arcadeRowSouth = (galleryAisleTiles - 1)
let arcadeRowNorth = (galleryAisleTiles + galleryNaveTiles)
let naveRowMid = ((gridTilesZ - 1) / 2)
let showcaseRowSouth = (naveRowMid - 5)
let showcaseRowNorth = (naveRowMid + 5)
// The hall's edges in metres, for the documents that build walls and floors from them: the nave's balcony edges, its
// west end (the void starts at the fourth pier; the bridge spans the three bays west of it), and the walls' inner faces.
let naveSouth = tileEdgeZ(galleryAisleTiles)
let naveNorth = tileEdgeZ((galleryAisleTiles + galleryNaveTiles))
let naveMid = tileZ(naveRowMid)
let arcadeSouth = tileZ(arcadeRowSouth)
let arcadeNorth = tileZ(arcadeRowNorth)
let arcadeWestBays = 3
let naveWest = pierX(arcadeWestBays)
let galleryNorth = tileEdgeZ(gridTilesZ)
let galleryDepth = (galleryNorth + galleryWall)
let galleryWestIn = tileEdgeX(0)
let galleryWestOut = (galleryWestIn - galleryWall)
let galleryEast = tileEdgeX(gridTilesX)
let galleryWidth = (galleryEast + galleryWall)
// How far east, in metres, the west wall's inner face now stands of world x 10.3, where the rooms against it were
// authored: Wonderland's room and its devices behind it, the desktop and the press before it.
let galleryWestShift = ((22 - naveWest) + galleryWestIn - 10.3)
// Where Wonderland's three devices stand on its floor (devices.puck), in world coordinates, each facing +x, and where a
// body stands to play each one: in front of it, inside its screen's engage radius. The devices' rows and spawn points,
// the companion's senses and the benchmark route all read these, so they move with the wall together.
let deckAt = [(1.4 + galleryWestShift), galleryFloor[0], 30.5]
let advancedAt = [(5 + galleryWestShift), galleryFloor[0], 31.6]
let brickAt = [(6.6 + galleryWestShift), galleryFloor[0], 29.4]
let deckPlayAt = (deckAt + [0.6, 0, 0])
let advancedPlayAt = (advancedAt + [0.5, 0, 0])
let brickPlayAt = (brickAt + [0.4, 0, 0])
// The centre of the tile nearest a plan position, along x or z.
function galleryTileX(x) = tileX(floor(((x - gridX0) / galleryTile)))
function galleryTileZ(z) = tileZ(floor(((z - gridZ0) / galleryTile)))
// The north aisle's middle, where its ceiling strip, its downlights and its galleries' displays stand.
let northAisleMid = ((naveNorth + galleryNorth) / 2)
// How far inside a balcony's edge its balustrade (or level 1's lattice) stands, in metres.
let balconyInset = 0.08

// The stairs: one in each corner of the aisles, in the end rest bays (0 and 12) between the end wall and the first
// arcade bay, inside the aisle's first five tile rows, every dimension a count of tiles. Switchbacks stand in the
// south-west and north-east corners and spiral stairs in the south-east and north-west, so the plan reads the same
// turned half round. Each serves every storey in eighteen 0.25 m risers to the storey. A row's `well` is the stair's
// footprint in the plan, which every upper floor leaves open over it; the stair's kit piece (the standard's
// `switchbackStair` and `spiralStair`, architecture.puck) stands at the well's centre, one copy a storey, turned by
// `yaw` so the piece's front (+Z: where a switchback's first flight starts and its second arrives, and where a spiral
// starts and arrives) faces the nave. Both forms fill four tiles by four, so every stair arrives on the aisle's tile row
// in front of the arcade's (`arcadeRowSouth` and its north twin) and the end pier standing in that row is clear of its
// head: a switchback, two flights two tiles wide less a spine, each a run of three tiles, and a half landing a tile deep
// against the long wall; a spiral, one turn round its newel to the storey.
let stairRisers = 18
let stairTiles = galleryBayTiles
let switchbackTiles = stairTiles
let switchbackLanding = galleryTile
let spiralRadius = ((stairTiles * galleryTile) / 2)
let spiralNewel = 0.5
function stairWell(i, j, across, deep) = {
  x0: tileEdgeX(i)
  x1: tileEdgeX((i + across))
  z0: tileEdgeZ(j)
  z1: tileEdgeZ((j + deep))
}
let galleryStairs = [
  { id: "south-west", form: "switchback", yaw: 180, well: stairWell(0, 0, stairTiles, switchbackTiles) }
  { id: "south-east", form: "spiral", yaw: 180, well: stairWell((gridTilesX - stairTiles), 0, stairTiles, stairTiles) }
  { id: "north-west", form: "spiral", yaw: 0, well: stairWell(0, (gridTilesZ - stairTiles), stairTiles, stairTiles) }
  {
    id: "north-east"
    form: "switchback"
    yaw: 0
    well: stairWell((gridTilesX - stairTiles), (gridTilesZ - switchbackTiles), stairTiles, switchbackTiles)
  }
]
let galleryStairWells = map(galleryStairs, stair => stair.well)
function galleryStair(id) = filter(galleryStairs, stair => (stair.id == id))[0]
function stairCentreX(stair) = ((stair.well.x0 + stair.well.x1) / 2)
function stairCentreZ(stair) = ((stair.well.z0 + stair.well.z1) / 2)
// Whether something `halfX` by `halfZ` about (x, z) keeps clear of every stair's well: the opening the benches and
// planters on every level yield to.
function galleryStairClear(x, z, halfX, halfZ) = (count(
  galleryStairWells,
  well => ((((x + halfX) > well.x0) and ((x - halfX) < well.x1)) and
    (((z + halfZ) > well.z0) and ((z - halfZ) < well.z1)))
) == 0)

// The entrance: one wide doorway in the west wall on the nave's centre line (the owner's ruling), so a visitor walks in
// under a canopy and looks straight down the hall to the climbing wall on the east wall, like a giant hallway. Its
// opening is `entranceTiles` floor tiles wide, centred on the nave's middle tile row, and `entranceTop` high under the
// bridge's slab; the canopy reaches `entranceCanopy` out over a forecourt of paving `entranceCourt` deep.
let entranceTiles = 5
let entranceSouth = (naveMid - ((entranceTiles * galleryTile) / 2))
let entranceNorth = (naveMid + ((entranceTiles * galleryTile) / 2))
let entranceTop = 3.4
let entranceCanopy = 3.4
let entranceCourt = 12
// Where a visitor stands outside the doorway, facing in (yaw 270 faces +x), and just inside it.
let entranceOutside = [(galleryWestOut - 4), galleryFloor[0], naveMid]
let entranceInside = [(galleryWestIn + 2.5), galleryFloor[0], naveMid]

// The east wing's upper two storeys project 4 m south of the wall from the terrace's edge, carried on arches over the
// forecourt, so level 3's south outer wall runs straight from the terrace to the east wall; the west wing's top storey
// stops at the nave, leaving a roof terrace over its south aisle that runs east to the third pier's tile.
let terraceEast = tileEdgeX(((galleryBayTiles * arcadeWestBays) + 1))
let terraceNorth = (naveSouth - galleryWall)
let wingWest = terraceEast
let wingSouth = -4
let wingLevel = 2
let archZ = -3.4
let archSpan = 3.75
let archXs = map(range(0, 7), i => (15 + ((2 * archSpan) * i)))

// The glass lifts (the owner's ruling): two cars at the nave's east end, flanking the climbing wall, each in a glass
// shaft standing in the void against a balcony edge in the last arcade bay, its landing door opening onto that edge's
// balcony on every level, from the hall's floor to level 3. The shaft fills the bay between its two piers' feet
// (`liftShaftHalf` either side of the bay's centre) and reaches `liftShaftBack` behind the car's centre; the car's
// centre stands `liftCarFromEdge` in from the edge, so its platform's front lies a few centimetres short of the landing's
// sill. Each row is a car: `key` its cells' key in the lift's rows (gallery.puck), `edge` and `out` the balcony edge it
// opens onto and the way out across it (+1 north, -1 south), and `yaw` the car's turn, which faces its door out.
// Riding to level 1 shrinks a rider and riding away grows it back: each shaft is a stretch of level 1's size field
// (wonder.puck). A point of a car's own frame (x across the cab, z toward its back, y up from the ground) is stood in
// the plan by `liftPoint`.
let liftShaftHalf = ((3 * galleryTile) / 2)
let liftCarFromEdge = 1.74
let liftShaftBack = 2.01
let liftBay = (galleryBays - 1)
let galleryLifts = [
  { id: "north", key: 0, x: bayX(liftBay), z: (naveNorth - liftCarFromEdge), edge: naveNorth, out: 1, yaw: 180 }
  { id: "south", key: 1, x: bayX(liftBay), z: (naveSouth + liftCarFromEdge), edge: naveSouth, out: -1, yaw: 0 }
]
function liftPoint(car, p) = [(car.x - (car.out * p[0])), p[1], (car.z - (car.out * p[2]))]
// A shaft's plan rectangle, the size field's zone over it.
function liftShaftBox(car) = {
  x0: (car.x - liftShaftHalf)
  x1: (car.x + liftShaftHalf)
  z0: minimum(liftPoint(car, [0, 0, (0 - liftCarFromEdge)])[2], liftPoint(car, [0, 0, liftShaftBack])[2])
  z1: maximum(liftPoint(car, [0, 0, (0 - liftCarFromEdge)])[2], liftPoint(car, [0, 0, liftShaftBack])[2])
}
// The controls' hooks: one control point a car and landing, where a lift's panel stands and a press calls the car
// there. Each is in the car's own frame beside its landing door, on the shaft's front facing the landing, at
// `liftPanelHeight` over the floor: `at` its plan point, `yaw` the way it faces, and `reach` the box before it a body
// stands in to press it. Inside each car the panel is the rail across its back (gallery.puck's `carPads`). A panel that
// calls a car writes `liftHallOf<key>[level]`, one that sends it `liftCarCallOf<key>[level]` (gallery.puck).
let liftPanelAcross = -1.35
let liftPanelHeight = 1.2
let liftFront = (0 - liftCarFromEdge)
let galleryLiftLandings = flatMap(galleryLifts, car => map(range(0, 4), k => {
  car: car.id
  key: car.key
  level: k
  at: liftPoint(car, [liftPanelAcross, (galleryFloor[k] + liftPanelHeight), (liftFront - 0.04)])
  yaw: car.yaw
  reach {
    x0: minimum(liftPoint(car, [(liftPanelAcross - 0.45), 0, 0])[0], liftPoint(car, [(liftPanelAcross + 0.45), 0, 0])[0])
    x1: maximum(liftPoint(car, [(liftPanelAcross - 0.45), 0, 0])[0], liftPoint(car, [(liftPanelAcross + 0.45), 0, 0])[0])
    y0: (galleryFloor[k] - 0.5)
    y1: (galleryFloor[k] + 1)
    z0: minimum(liftPoint(car, [0, 0, liftFront])[2], liftPoint(car, [0, 0, (liftFront - 1.3)])[2])
    z1: maximum(liftPoint(car, [0, 0, liftFront])[2], liftPoint(car, [0, 0, (liftFront - 1.3)])[2])
  }
}))
// Where a body stands on a landing before a car's door, facing it, and inside the car, facing its door.
function liftLandingStand(car, level) = liftPoint(car, [0, galleryFloor[level], (liftFront - 1.6)])
function liftLandingYaw(car) = ((car.yaw + 180) % 360)

// The painting portals' places (the owner's ruling, placed by the portal lane): twelve against level 3's outer walls,
// six on the projecting wing's south wall and six on the north wall, one in each of the middle arcade bays, clear of the
// corner stairs, the lifts' bay and the bays either side that carry windows. Each row is one portal's place: `side`,
// `bay`, `at` the point on the wall's inner face at its bay's centre on level 3's floor, `yaw` the way it faces into the
// gallery (180 faces +z, 0 faces -z), and `wall` the face's plane along z. Level 3 leaves these faces bare: no window,
// switch, bench or planter stands in them.
let galleryPortalLevel = 3
let galleryPortalBayList = [5, 6, 7, 8, 9, 10]
let galleryPortalBays = concat(
  map(galleryPortalBayList, b => {
    side: "south"
    bay: b
    at [bayX(b), galleryFloor[galleryPortalLevel], (wingSouth + galleryWall)]
    yaw: 180
    wall: (wingSouth + galleryWall)
  }),
  map(galleryPortalBayList, b => {
    side: "north"
    bay: b
    at [bayX(b), galleryFloor[galleryPortalLevel], galleryNorth]
    yaw: 0
    wall: galleryNorth
  })
)
// Whether a window bay centred at `at` along a level-3 outer face keeps clear of every portal bay.
function galleryPortalClear(at) = (count(
  galleryPortalBayList,
  b => (((at + (bayWidth / 2)) > pierX(b)) and ((at - (bayWidth / 2)) < pierX((b + 1))))
) == 0)

// A window bay's opening: 3.2 m wide and 3.1 m tall, from 0.6 m over its floor, one every 4 m along a face.
let bayWidth = 3.2
let bayHeight = 3.1
let baySill = 0.6
// The nave's end wall is the tallest, most glazed wall (the owner's ruling): the climbing wall rises up its middle bay
// from the floor to the ceiling, and either side of it a wide, tall bay of clear glass passes through levels 0 and 1
// and a stained-glass bay through levels 2 and 3, a slim pier between each lower pair.
let tallBayWidth = 5
let tallBayHeight = 7.3
// The end wall is an arcade of its own: three bays of six tiles span it exactly from the south arcade's row to the
// north's, the middle one on the nave's axis and the climbing wall's, so its corner piers are the side arcades' last.
// `tallBayZs` are the two side bays' centres, and `tallBayTiers` the levels each tier of them starts on: clear glass
// on level 0 and stained glass on level 2.
let tallBayPitch = ((arcadeNorth - arcadeSouth) / 3)
let tallBayZs = [(naveMid - tallBayPitch), (naveMid + tallBayPitch)]
let tallBayTiers = [{ level: 0, stained: false }, { level: 2, stained: true }]

// The bays of each face by level, as the centre of each along its face. The south face's are the west wing's (the
// terrace takes level 3's), level 1's along the old lobby and the painting wing, and the projecting wing's on levels 2
// and 3, which stand in its own south face. Level 3 keeps its outer faces' portal bays bare (`galleryPortalBays`).
let southBaysWest = [4, 8, 12]
let southBaysEast = map(range(0, 10), i => (19.5 + (4 * i)))
function wingBays(level) = filter(map(range(0, 11), i => (15.5 + (4 * i))), at => ((level != galleryPortalLevel) or galleryPortalClear(at)))
function northBays(level) = filter(map(range(0, 15), i => (2 + (4 * i))), at => ((level != galleryPortalLevel) or galleryPortalClear(at)))
// The west face's level 0 holds the entrance across the nave's middle; above it the bridge's bays run the nave's width.
let bridgeBays = map(range(0, 4), i => (naveSouth + 2.5 + (5 * i)))
let westBays = [
  [3.2, (naveNorth - 2.5), northAisleMid]
  concat([3.2], bridgeBays, [northAisleMid])
  concat([3.2], bridgeBays, [northAisleMid])
  concat(bridgeBays, [northAisleMid])
]
let eastBays = [[northAisleMid], [4.4, northAisleMid], [4.4, northAisleMid], [4.4, northAisleMid]]

// The painting wing: level 0's south aisle from x 30 to the east wall. Three fins stand out from
// the south wall, each 4.2 m long: at x 30, at x 44.3, and against the west side of the south-east stair's well, which
// fills the wing's last bay, so the east court ends at that fin; the fall's well is at (52.5, 6.2), under a hole in
// level 1's floor.
let courtWest = 30
let courtFin = 44.3
let courtStairFin = (galleryStair("south-east").well.x0 - galleryWall)
let courtFinLength = 4.2
let fallPlan = [52.5, 6.2]
// The paintings that hang on the painting wing's south wall, as the centre of each along it (paintings.puck hangs them;
// the floor's furniture keeps clear of their doors).
let courtWallDoors = [34.4, 38, 41.6, 48.5, 52.5]
let fallHole = 1
// Whether level 1's floor opens over the fall, railed round: tabled by the owner until the fall is revisited, so the
// floor is whole over it and the wing's fall paintings below stand as they are.
let fallOpen = false

// The lab wing (../lab-wing.puck, labs/README.md): level 0's north aisle, where a door stands for each lab, a small world
// that tests one behaviour or a set of behaviours together and boots alone in minutes. Each row is one lab: `id` names
// its door (`lab-<id>`), its spawn point before the door and its destination; `bay` is the arcade bay the door stands
// in, on the aisle's tile row `labWingRow`, its glass facing the nave; `document` is the lab's world document, named as
// the debug world's entry names it; `title` and `note` are its plaque. `open` says whether the door leads anywhere: a
// closed door's glass reads OPENING SOON and its plaque still stands, so a lab whose document lands later opens by
// setting `open` alone. Adding a lab is one row. The doors keep clear of the corner stairs (bays 0 and 12), and the
// tree's bay (6) stays open across the aisle, so the wing is a court either side of it.
let labWingRow = (wallRowNorth - 1)
let labWingPlan = [
  {
    id: "climbing", bay: 2, open: true, document: "labs/climbing"
    title: "CLIMBING LAB", note: "The Moth's climb on holdable faces, the gallery's rope net, and its climbing wall from the floor to a ledge."
  }
  {
    id: "light", bay: 3, open: true, document: "labs/light"
    title: "LIGHT LAB", note: "A room a subject: occluders, a dark room of bulbs, a screen and a glowing console, stained glass, the magic barrier, haze."
  }
  {
    id: "surface", bay: 4, open: true, document: "labs/surface"
    title: "SURFACE LAB", note: "Relief panels near, middle and far, each filtered beside unfiltered, down a long fogged sight line toward a low sun."
  }
  {
    id: "moth", bay: 5, open: true, document: "labs/moth"
    title: "MOTH LAB", note: "The Moth on a grey stage, then her run, turns, steps, slopes, jumps, dash, climb and flight, and a tight corridor for her camera."
  }
  {
    id: "shapes", bay: 8, open: true, document: "labs/shapes"
    title: "SHAPE LAB", note: "One display station holding the whole catalog: every exhibit, the blends and the cubic blends among them, a tap away."
  }
  {
    id: "tree", bay: 9, open: false, document: "labs/tree"
    title: "TREE LAB", note: "The gallery's tree on its own, its treads and branches to walk."
  }
  {
    id: "board-games", bay: 10, open: true, document: "labs/board-games"
    title: "BOARD GAME LAB", note: "The physical chess table beside a game station playing chess, Klondike and FreeCell, on one floor."
  }
  {
    id: "portals", bay: 11, open: true, document: "labs/portals"
    title: "PORTAL LAB", note: "One portal and the panel that points it: walk in, step back out, and repoint it at another world."
  }
]
// Whether level 0's north wall keeps its bench or planter at plan x `x`: none stands behind a lab's door.
function labWingClear(x) = (count(labWingPlan, lab => (bayX(lab.bay) == x)) == 0)

// The flaw's route (flaw.puck): the corners of one closed polyline in the building's frame, metres, which the flaw
// follows with each corner rounded (look.puck's `lookFlaw.bend`). It is one loop that rises through the building and
// returns down the tree:
//
//   from its source at the tree's foot, a straight line inlaid down the middle of the nave's floor to the west end
//   into the south gallery and up its wall, then a switchback up the storeys: along each storey's ceiling, `flawDrop`
//     under it, it snakes across the gallery bay by bay (arcade side, wall side, in turn) from bay `flawFrom` to bay
//     `flawTo`, rising a storey through the slab at each end, east on level 0, west on 1, east on 2, west on 3
//   on level 3 it leaves the gallery over the void and weaves through the canopy (`flawCanopy`, points round the
//     trunk's axis among the crown's clusters), lighting the tree from within
//   it comes out on level 3's north side at that level's branch doorway, dives to the floor and runs back along the
//     branch's walking line to the trunk (the exit)
//   and spirals down the trunk inlaid in the tree's walkway, along the middle of its treads, to its source
//
// It keeps clear of the corner stair bays (0 and 12), the fall's well (bay 11) and the bridge. Every slab it passes
// through in a gallery is opened and collared (`flawCrossings`); the nave has no slabs.
// Whether the gallery builds the flaw at all: tabled by the owner while simpler work comes first, so its route, look and
// lights stay authored here and in flaw.puck, and turning this on restores the tube, its collars, its slab openings and
// its lights together.
let flawEnabled = false
let flawDrop = 0.6
function flawRun(level) = (galleryCeiling[level] - flawDrop)
let flawFrom = 2
let flawTo = 10
let flawArcadeZ = tileZ((arcadeRowSouth - 1))
let flawWallZ = tileZ((wallRowSouth + 1))
// One storey's snake along the south gallery's ceiling, from pier `a` to pier `b` (either way): a corner on each pier's
// line, on the arcade side and the wall side in turn, starting on the arcade side.
function flawSnake(level, a, b) = map(
  range(0, (absolute((b - a)) + 1)),
  n => [pierX((a + (n * sign((b - a))))), flawRun(level), (((n % 2) == 0) ? flawArcadeZ : flawWallZ)]
)
// The canopy's weave: points round the trunk's axis, `r` metres out at plan bearing `angle`, `y` over the hall's floor.
let flawCanopy = [
  { r: 6.2, angle: 250, y: 15.6 }
  { r: 4.4, angle: 200, y: 14.4 }
  { r: 5.4, angle: 140, y: 15.3 }
  { r: 3.6, angle: 95, y: 14.2 }
]
function flawCanopyAt(c) = ([treeX, galleryFloor[0], treeZ] + polarPoint(c.r, c.angle, c.y))
// The exit: level 3's north branch (treeLimbs), its walking line sampled from its tip back to the trunk, a hair over
// its walking face, and the walkway's middle line from that branch's tread down to the foot, a point every
// `flawTreadStep` treads.
let flawExit = filter(treeLimbs, b => ((b.level == 3) and (b.side == "north")))[0]
let flawInlay = 0.03
let flawTreadStep = 4
function flawBranchAt(b, t) = (treeBranchAt(b, t) + [0, flawInlay, 0])
function flawTreadAt(k) = (treeTreadWalk(k) + [0, flawInlay, 0])
let flawWalkway = map(
  range(0, (floor((flawExit.tread / flawTreadStep)) + 1)),
  n => flawTreadAt((flawExit.tread - (n * flawTreadStep)))
)
let flawRoute = concat(
  [
    (flawTreadAt(0) + [0, -0.02, 0])
    [naveWest, flawInlay, treeZ]
    [naveWest, flawInlay, flawArcadeZ]
    [pierX(flawFrom), flawInlay, flawArcadeZ]
  ],
  flawSnake(0, flawFrom, flawTo),
  flawSnake(1, flawTo, flawFrom),
  flawSnake(2, flawFrom, flawTo),
  filter(flawSnake(3, flawTo, flawFrom), c => (c[0] > treeX)),
  map(flawCanopy, c => flawCanopyAt(c)),
  [
    [(flawBranchAt(flawExit, 1)[0] + 1.6), flawRun(3), (naveNorth + 2.2)]
    [(flawBranchAt(flawExit, 1)[0] + 1.6), flawBranchAt(flawExit, 1)[1], (naveNorth + 2.2)]
  ],
  map([1, 0.75, 0.5, 0.25, 0.04], t => flawBranchAt(flawExit, t)),
  flawWalkway
)
// The heights the flaw is cut at, each slab's middle: its lights are cut there so every stretch of light lies in one
// storey and the irradiance volume shuts it out of the storeys the slabs close off, and each place it passes through a
// slab (`flawCrossings`, each { point, height, segment }: `height` 0 is level 1's slab) is opened and collared; the nave
// has no slabs, so the tree's riser crosses none.
let flawCuts = map(range(1, 4), k => ((galleryStorey * k) - 0.1))
let flawCrossings = filter(
  loopCrossings(flawRoute, flawCuts),
  c => ((c.point[2] < naveSouth) or (c.point[2] > naveNorth))
)

// The display stations: the showcase's twelve stand in its bays (shapes.puck's galleryDisplays), a pair to each bay
// across the nave on the two showcase rows, each console toward the centre aisle (yaw 180 faces +z, yaw 0 faces -z).
// A display is the standard's display plinth (architecture.puck) stamped at `displayScale`, so its cap spans about four
// fifths of its pad's width (look.puck's lookPadTiles) with a cream margin round it, and the exhibit on its turntable
// stands at `displayExhibitScale`, in proportion, set down so the plinth's cap of the exhibits' own frame (0.75 m) meets
// the turntable.
let displayScale = 1.75
let displayExhibitScale = 2.5
// How far, in metres, an exhibit floats clear of its turntable: the exhibits were authored resting on the old plinths'
// cap, some dipping a little under it, so each stands this much higher and reads as a specimen held over the light.
let displayExhibitLift = 0.3

// Level 1's toybox (toybox.puck): twelve Humble Gaming Deck stations, six on each gallery, mirrored about the nave so
// each north station stands across the void from its south twin. Along each gallery, in bays 2, 3, 5, 6, 7 and 8, a
// living-room television set and a two-player arcade cabinet alternate. The plan keeps clear of the corner bays and the
// walls beside them (0 and 12: the corner stairs, the lifts' landings and the handhelds' corners to come), bay 4, and
// the endless fall's well (bay 11). A cabinet
// stands on a gallery's second tile row in from its wall, as a television set's stand does, so a set's rug and
// beanbags reach no nearer than 2.8 m to the balcony edge; each faces the nave, a south one +z (yaw 180), a north one -z
// (yaw 0). `look` is the colourway a station wears (look.puck's lookCabinets and lookTelevisions) and `cartridge` the
// shipped deck program it boots.
let toyboxLevel = 1
// The body registers that let a body into level 1 at its full size (wonder.puck): the full-size pass a puzzle grants,
// and the wonder key a body carries switched on (rentals.puck). Level 1's size field gives a holder its full size, and
// the magic barrier filling each level-1 branch's arch (shell.puck) lets a holder through and holds every other body.
let wonderPasses = ["wonderPass", "wonderKey"]
let toyboxSides = [
  { name: "south", cabinetRow: (wallRowSouth + 1), televisionRow: (wallRowSouth + 1), yaw: 180, facing: 1 }
  { name: "north", cabinetRow: (wallRowNorth - 1), televisionRow: (wallRowNorth - 1), yaw: 0, facing: -1 }
]
let toyboxPlan = [
  { bay: 2, kind: "television", look: 0, cartridge: "moving-sprite" }
  { bay: 3, kind: "cabinet", look: 0, cartridge: "moving-sprite" }
  { bay: 5, kind: "television", look: 1, cartridge: "colour-bars" }
  { bay: 6, kind: "cabinet", look: 1, cartridge: "moving-sprite" }
  { bay: 7, kind: "television", look: 2, cartridge: "moving-sprite" }
  { bay: 8, kind: "cabinet", look: 2, cartridge: "moving-sprite" }
]
// Every station, south then north, with the name of the deck it hosts, its side's row for its kind and its facing.
let toyboxStations = flatMap(toyboxSides, side => map(toyboxPlan, s => (s with {
  id: $"{s.kind}-{side.name}-{s.bay}"
  machine: $"toybox-{s.kind}-{side.name}-{s.bay}"
  row: ((s.kind == "cabinet") ? side.cabinetRow : side.televisionRow)
  yaw: side.yaw
  facing: side.facing
})))
let toyboxMachines = map(toyboxStations, s => s.machine)
// The stations' screen indices: the debug world's other screens hold 0 to 17 (devices.puck, range.puck, alchemy.puck,
// desktop.puck, granaries.puck), so the toybox's start at 20, one to a station in toyboxStations' order.
let toyboxScreen = 20
// Where a station stands in the building's frame, on its tile.
function toyboxAt(s) = [bayX(s.bay), galleryFloor[toyboxLevel], tileZ(s.row)]

// The board game room (the owner's ruling): level 2's south gallery and the wing projecting over the forecourt, holding
// twelve game stations (../game-stations.puck), each one table that plays every game of the set's catalog on a holodeck
// board. They stand in two rows of six, one station to an arcade bay from bay 5 to bay 10: the front row on the south
// gallery's fourth tile row, its far chairs a tile short of the arcade's piers, and the back row out in the wing, its
// near chairs a tile and a half short of the wing's south wall, so every chair keeps 2 m of aisle behind it. Each
// station's near chair faces north (+z) across its glass and its far chair south. A station's id is its row and column
// (`a1` to `a6` the front row west to east, `b1` to `b6` the back), and is the alias of its instance (games.puck).
let gameStationLevel = wingLevel
let galleryGameBays = range(5, 11)
let galleryGameRows = [
  { name: "a", z: tileZ(3) }
  { name: "b", z: tileZ(-1) }
]
// Every station in the world's frame, front row then back, each west to east. A station's creation's floor lies 0.5 m
// under its origin (the standard's gameStationFloor), so it stands on level 2.
let galleryGameStations = flatMap(galleryGameRows, row => map(range(0, length(galleryGameBays)), n => {
  id: $"{row.name}{n + 1}"
  at: galleryWorld(bayX(galleryGameBays[n]), (galleryFloor[gameStationLevel] - 0.5), row.z)
}))
// The stations the gallery booted alone stands (games.puck): the plan's first `galleryRoomStood`. The rule work sheet
// admits eleven beside the rest of the building; the twelfth, b6, waits on the stations' rules becoming one set over
// every station (game-station.md, "Cost").
let galleryRoomStood = 11
let galleryRoomStations = map(range(0, galleryRoomStood), i => galleryGameStations[i])

// Level 1's handheld rentals (rentals.puck): a pool of one brick and one advanced brick for each seat's body (bodies 0
// to 11, shapes.puck's four local seats and eight visitors), each run only while its body holds a rented device of that
// model.
let rentalBodies = range(0, 12)
let rentalMachines = flatMap(rentalBodies, b => [$"rental-hgb-{b}", $"rental-agb-{b}"])

// The visitor every small door is sized for: the Moth's capsule, 0.35 m round and 2.06 m tall at full size
// (avatars/moth/contract.puck's mech suit capsule; a change there moves these).
let galleryVisitorRadius = 0.35
let galleryVisitorHeight = 2.06

// The stewards (stewards.puck): four of the Moth's crew who stand in the gallery and, asked, give a visitor its normal
// size back. Each stands on level 0, where a visitor that left level 1 small comes down (the tree's walkway ends at its
// foot) or goes looking for help: at the tree's foot, east of the trunk where the walkway comes in; in the west hall,
// beside the way in from the entrance and facing it; in the north aisle under the toybox's north gallery; and in the painting wing, against
// its south wall between its first two paintings, before a small visitor walks into one and clear of the way along the
// wing past its fins. Each keeps its reach clear of a display's terminal reach, and of the holiday firs
// (holiday.puck). None stands on level 1's floor: there the toybox's stairs and lifts give a body
// its size back as it leaves, and its games stay a pass holder's (gallery.md, "The size of level 1"). A steward faces
// its heading `yaw` (0 faces -z, 90 -x, 180 +z, 270 +x) with its slate `stewardSlateOut` before it, and is talked to
// from within `stewardReach` of the slate; `crew` is the crew member it is (stewards.puck's `stewardCrew`).
let stewardPlan = [
  { id: "tree", crew: "vector", x: (treeX + 6.5), z: treeZ, yaw: 90 }
  { id: "lobby", crew: "skylark", x: tileX(3), z: tileZ((naveRowMid - 4)), yaw: 90 }
  { id: "north", crew: "bulwark", x: bayX(treeBay), z: tileZ((wallRowNorth - 2)), yaw: 0 }
  { id: "wing", crew: "forge", x: ((courtWallDoors[0] + courtWallDoors[1]) / 2), z: tileZ((wallRowSouth + 1)), yaw: 180 }
]
let stewardSlateOut = 0.85
let stewardReach = 1.5
// The way a steward faces, and its slate's place, in the plan on level 0's floor.
function stewardFacing(s) = rotatePoint(rotate([0, 1, 0], s.yaw), [0, 0, -1])
function stewardSlate(s) = ([s.x, galleryFloor[0], s.z] + (stewardFacing(s) * stewardSlateOut))

// The little house (mouse-house.puck): a toy house standing free on level 1's north gallery in bay 10, its front toward
// the nave (-z), whose door only a body the toybox has made small fits through, and inside it the cake that grants the
// full-size pass. Its door admits the visitor up to `admits` of its full size, with `room` to spare (the standard's
// sizedDoorway). Points in it are given in its own frame (x across its front, y up from level 1's floor, z from front
// to back) and stood in the world by `mouseHousePoint`.
let mouseHouse = { x: bayX(10), z: tileZ((wallRowNorth - 2)), width: 1.8, depth: 1.4, admits: 0.2, room: 1.4 }
function mouseHousePoint(p) = galleryWorld(
  (mouseHouse.x + p[0]),
  (galleryFloor[toyboxLevel] + p[1]),
  (mouseHouse.z + p[2])
)
// Before its door, in its doorway, inside it, and at the cake's table at its back.
let mouseHouseBefore = [0, 0, ((0 - (mouseHouse.depth / 2)) - 0.6)]
let mouseHouseDoorway = [0, 0, (0 - (mouseHouse.depth / 2))]
let mouseHouseInside = [0, 0, ((0 - (mouseHouse.depth / 2)) + 0.3)]
let mouseHouseCake = [0, 0, ((mouseHouse.depth / 2) - 0.3)]

// Level 1's lattice (shell.puck): a toy construction panel along every edge level 1 shares with the nave's void,
// standing on the floor and reaching into the fascia (or the slab) above, so no body flies or jumps into the toybox
// from the void or drops out of it. Its uprights stand a
// sixteenth of a tile apart, so a four-tile bay holds 63 of them, one fold's worth, and the gap between two is narrower
// than the smallest body the world sizes: the Moth's capsule is 0.7 m across, a tenth of that at the bottom of the size
// envelope (size.puck), and Alice's 0.15 is wider still. The panels stand on the balustrades' line (`balconyInset`).
let toyLatticePitch = (galleryTile / 16)
let toyLatticeBar = 0.025
// The toybox's net: the lattice's bars and rails give way to a diamond net of rope strands threaded through a clear pane
// that holds every body (architecture.puck's `lattice` net): 3.5 cm rope, knot to knot every 30 cm, a climbing net's
// mesh rather than a fence's.
let toyLatticeNet = { strand: 0.035, pitch: 0.3 }
// The loose panels: one panel on each edge that a rule can open, move or swap (gallery.md, "The lattice"), each named
// `gallery-lattice-loose-<edge>` and following its `toyboxSlats` cell: a south and a north bay, and the bridge's middle
// tile on the nave's axis.
let toyLatticeLooseBay = 8
// The rope net panel: the north edge's bay whose frame holds a net that gives and climbs (architecture.puck's `latticeNet`
// facet, gallery.md "The lattice") rather than a net drawn over a pane. Its frame and its net still close the edge to
// every body. Kept clear of the toybox's stairs, lifts, stations and house and of every tree branch's landing: bay 9
// has none of them, standing between the tree's gate (bay 8) and the little house (bay 10), its aisle open to walk up
// to the net from.
let toyLatticeNetBay = 9

// The central tree (tree.puck): a giant tree at the hall's exact centre, bay 6 (the middle rest bay) on the nave's
// centre row, its trunk filling the nine tiles a display's pad does. A spiral of treads climbs its trunk, and two
// branches reach each of levels 1 to 3, one to each balcony edge in the tree's bay: level 1's through a gate in that
// bay's lattice panel (shell.puck), level 2's through a gap in its balustrade, level 3's onto its open edge.
// Each branch lands at its own place along its edge (`x` in each `treeLimbs` row), so the canopy reaches out across the
// hall instead of every branch meeting the trunk's bay: a symmetric asymmetry, each level's pair a half turn of the
// other about the tree (one lands west of the trunk on one side, the other as far east on the other), and the levels
// alternating which side reaches west, so the canopy spirals. Level 2's land on a balustrade length's middle (shell.puck's
// 4 m lengths centre on 14 + 4i), so each gap leaves a tile of balustrade either side.
let treeBay = 6
let treeX = bayX(treeBay)
let treeZ = naveMid
// The trunk: a taper `base` metres in radius at the floor that would close `apex` metres up, ending at `top` inside the
// canopy. Its treads climb from `treeTreadStart` degrees round it (from +x toward +z in the plan, so the first stands just
// south of east, facing the hall's long axis), one every `treeTreadStep` degrees and `treeTreadRise` metres, a storey a
// turn in risers under the Moth's 0.3 m step.
let treeTrunk = { base: 2.1, apex: 34, top: 17.1 }
let treeTreadStart = -12
let treeTreadStep = 18
let treeTreadRise = 0.225
// The walkway round the trunk is a helix of constant radius: every tread is a timber board from inside the bark out to
// `treeRim` metres from the trunk's axis, whatever the taper, so the guard along its rim climbs one even helix, and a body
// walks it `treeWalkRadius` from the axis, clear of the bark's strands and of the guard. Each riser is a radial line half a
// step either side of its tread's bearing (limbs.puck's spiralTreads), so a tread's walkable top spans its whole step at
// every radius, and a board is `treeTreadThickness` thick, more than a riser, so each riser is closed under the next.
let treeRim = 4
let treeWalkRadius = 3.05
let treeTreadThickness = 0.32
// Where a branch leaves the spiral, its tread opens onto a level timber pad from `treePadFrom` metres from the axis (just
// past a walker on the spiral, so the pad never raises the tread before it under her feet) out to `treePadReach`,
// `treePadWidth` wide; the branch's deck leaves from the pad's outer edge.
let treePadFrom = 3.55
let treePadReach = 5.6
let treePadWidth = 2.8
// The branches: each leaves the spiral from a tread's pad and walks out to its level's edge, a pair to each level, the
// pairs turning round the trunk as they climb, so the canopy turns too; a level's south branch leaves from below its
// floor and rises to it, its north branch from higher and falls to it. Level 1's pads stand between the four displays
// round the trunk (bays 5 and 7 on both showcase rows), whose exhibits stand taller than a pad over the hall's floor.
// Each branch's tread is the one whose bearing points within about 25 degrees of its landing, so its deck leaves the
// pad nearly straight on: a deck that leaves sideways crosses its own pad and the walk across it, and one that turns
// back passes over the treads below. A
// branch's deck ends at its balcony's edge, its top flush with the floor, and the walk goes on `treeOverhang` metres onto
// the balcony (`treeDoorOverhang` through a doorway).
let treeLimbs = [
  { level: 1, side: "south", tread: 16, x: bayX(6) }
  { level: 1, side: "north", tread: 24, x: bayX(8) }
  { level: 2, side: "south", tread: 38, x: bayX(8) }
  { level: 2, side: "north", tread: 48, x: bayX(4) }
  { level: 3, side: "south", tread: 54, x: bayX(5) }
  { level: 3, side: "north", tread: 64, x: bayX(7) }
]
// Where a level's branch lands on one side, and the arcade bay that x stands in.
function treeLanding(level, side) = filter(treeLimbs, b => ((b.level == level) and (b.side == side)))[0].x
function bayOf(x) = floor(((x - pierX(0)) / arcadePitch))
// Every branch lands at a bay's centre, midway between two piers, so it never meets a pier and its doorway (levels 2 and
// 3) or magic barrier (level 1) fills the bay. A doorway's clear opening, metres, and the balustrade either side of it.
let treeDoorWidth = 2
let treeDoorPost = 0.22
let treeDoorSide = (((arcadePitch - 1) - (treeDoorWidth + (2 * treeDoorPost))) / 2)
let treeTreadCount = (treeLimbs[(length(treeLimbs) - 1)].tread + 1)
// Level 1's walk ends on the balcony strip between the edge and the branch's magic barrier in the arcade's plane
// (shell.puck), which holds a body without a pass; levels 2 and 3 walk on through their doorways into the aisle.
let treeOverhang = 0.2
let treeDoorOverhang = 1.5
function treeOverhangOf(b) = ((b.level >= 2) ? treeDoorOverhang : treeOverhang)
// A tread's angle round the trunk in degrees and its top's height over the hall's floor, the plan point on its middle
// line `out` metres from the bark, and the point on it where a body walks the spiral.
function treeTreadAngle(k) = (treeTreadStart + (treeTreadStep * k))
function treeTreadTop(k) = treadTop(treeTreadRise, k)
function treeBarkAt(k) = trunkRadius(treeTrunk.base, treeTrunk.apex, treeTreadTop(k))
function treeTreadPlan(k, out) = ([treeX, galleryFloor[0], treeZ] +
  treadPoint(treeTreadStart, treeTreadStep, treeTreadRise, treeTrunk.base, treeTrunk.apex, k, out))
function treeTreadWalk(k) = treeTreadPlan(k, (treeWalkRadius - treeBarkAt(k)))
// Where a branch's walking line starts (on its pad's outer edge, level with its tread) and ends (on its balcony's edge,
// level with the floor), and where the walk across its landing ends, in the plan.
function treeBranchFrom(b) = treeTreadPlan(b.tread, (treePadReach - treeBarkAt(b.tread)))
function treePadCentre(b) = treeTreadPlan(b.tread, (((treePadFrom + treePadReach) / 2) - treeBarkAt(b.tread)))
function treeBranchTo(b) = [b.x, galleryFloor[b.level], ((b.side == "south") ? naveSouth : naveNorth)]
function treeBranchLanding(b) = (treeBranchTo(b) +
  [0, 0, ((b.side == "south") ? (0 - treeOverhangOf(b)) : treeOverhangOf(b))])
// The tree creation (tree.puck) is authored in a frame turned a half turn about up from the plan's, its origin at the
// trunk's foot; the flaw (flaw.puck) reads the branches' walking lines too, so they live here.
// A plan point as the creation's author-frame point.
function treeAuthor(p) = [(treeX - p[0]), (p[1] - galleryFloor[0]), (treeZ - p[2])]
let treeAuthorTurn = 180

// A branch's walking line: from its pad's outer edge, bending round to its landing, arching a little as it goes. Its
// control point lies halfway between a point out along its tread's bearing (so it leaves the pad as a limb leaves a
// trunk) and a point straight back from its landing across the edge (so it meets the balcony nearly square and walks
// onto its balcony square).
function treeBranchA(b) = treeAuthor(treeBranchFrom(b))
function treeBranchC(b) = treeAuthor(treeBranchTo(b))
function treeBranchReach(b) = vectorLength((treeBranchC(b) - treeBranchA(b)) * [1, 0, 1])
// How high a branch's control point stands over the straight rise from its pad to its landing: level 1's branches cross
// the hall low beside the showcase's displays, so they arch enough to leave the exhibits breathing room and no more, a
// gentle walk up and down (a quadratic's middle rises half its control point's height over the line).
function treeBranchArch(b) = ((b.level == toyboxLevel) ? (0.12 * treeBranchReach(b)) : 0.35)
function treeBranchOut(b) = (treeBranchA(b) + polarPoint(
  (0.45 * treeBranchReach(b)),
  (treeTreadAngle(b.tread) + treeAuthorTurn),
  (((treeBranchC(b)[1] - treeBranchA(b)[1]) / 2) + treeBranchArch(b))
))
// A branch that meets a doorway (levels 2 and 3) puts its control point straight back from the landing, so its last run
// crosses the doorway square, through the middle of the opening.
function treeBranchB(b) = ((b.level >= 2) ? [
  treeBranchC(b)[0]
  treeBranchOut(b)[1],
  ((treeBranchA(b)[2] + treeBranchC(b)[2]) / 2)
] : ((treeBranchOut(b) + [treeBranchC(b)[0], treeBranchOut(b)[1], ((treeBranchA(b)[2] + treeBranchC(b)[2]) / 2)]) / 2))
// The plan point on a branch's walking line `t` of the way from its pad (0) to its balcony's edge (1): the quadratic the
// creation draws the branch along (treeBranchA, treeBranchB, treeBranchC), carried back from the creation's frame into
// the plan's. The walkway's route (tree-walk.puck) and the flaw read the branches here.
function treeBranchAt(b, t) = (let p = quadraticPoint(treeBranchA(b), treeBranchB(b), treeBranchC(b), t) in
[
  (treeX - p[0]),
  (p[1] + galleryFloor[0]),
  (treeZ - p[2])
])

// The climbing wall (climbing-wall.puck): a face `climbWallWidth` across in the middle bay of the nave's east end wall
// (the owner's ruling), on the nave's axis, facing west down the hall with the whole nave open before it, so a visitor
// walking in at the entrance looks straight at it. It rises from the nave's floor to level `climbWallLevel`, where its
// ledge is the east walkway, and its sandstone carries on above the ledge to the ceiling as a headwall nothing holds. The
// lifts' shafts stand either side of it at the balcony edges, and the stained-glass bays high either side of it.
//
// The wall stands `climbWallDepth` deep in front of the east wall, its back against it, so its ledge (the frame's
// coping, level with the floor it tops out at) is deep enough for a mantle to set a body down on it whole: the climb's
// mantle carries a body 0.8 m in from where it hangs, one body radius off the face, so it lands 0.45 m past the face
// with its capsule reaching 0.35 m either side, all of it on the ledge and clear of the headwall. Before the face a pad
// `climbWallPad.depth` deep catches a fall, reaching past the frame on each side; the face stands on the pad, and the
// frame on the floor. A point on the face is `u` metres across from its middle toward the face's own right (south, as a
// climber facing the wall sees it on the left) and `v` up from its foot.
let climbWallLevel = 3
let climbWallZ = naveMid
let climbWallYaw = 90
let climbWallWidth = 4
let climbWallDepth = 1.1
let climbWallThickness = 0.2
let climbWallCoping = 0.3
let climbWallPad = { width: 5, depth: 2.5, height: 0.25 }
// The climbing plane's line in the plan (the face's front along x, where a climber's hands go), the pad's top, the
// ledge's top and the face's height from the pad to the coping.
let climbWallFace = (galleryEast - climbWallDepth)
let climbWallFoot = (galleryFloor[0] + climbWallPad.height)
let climbWallTop = galleryFloor[climbWallLevel]
let climbWallFaceHeight = ((climbWallTop - climbWallFoot) - climbWallCoping)
// The headwall over the ledge, from the ledge to level 3's ceiling, flat against the east wall.
let climbWallHeadwall = (galleryCeiling[climbWallLevel] - climbWallTop)
// The frame's half width across the face: the face, its cheeks and the coping's nose (the standard's climbingFrame).
let climbWallFrameHalf = ((climbWallWidth / 2) + 0.26)
// A point `out` metres in front of the face at face coordinate (u, v), in the plan.
function climbWallOff(u, v, out) = [(climbWallFace - out), (climbWallFoot + v), (climbWallZ - u)]
function climbWallAt(u, v) = climbWallOff(u, v, 0)
// Where a climb starts and ends: on the pad before the face's middle, a step out from it; on the ledge, a body's stance
// in from the face where the climb's mantle sets it down; and on level 3's north gallery, along the walkway past the
// north lift's shaft.
let climbWallStart = climbWallOff(0, 0, 0.7)
let climbWallSummit = [(climbWallFace + 0.5), climbWallTop, climbWallZ]
let climbWallLanding = [(galleryEast - (climbWallDepth / 2)), climbWallTop, (naveNorth + 1.2)]
// The east walkway on level 3 the ledge belongs to: a strip `climbWallDepth` deep along the east wall across the nave's
// end, from the south gallery to the north one behind the lifts' shafts, its void edge railed but where the climb tops
// out over the frame's coping. `climbWalkPieces` are its two stretches either side of the frame, and `climbWalkRails`
// its balustrade's lengths along them, laid from the frame outward, the last a tile's length at the gallery's edge.
let climbWalkPieces = [
  { id: "walk-south", x0: climbWallFace, x1: galleryEast, z0: naveSouth, z1: (climbWallZ - climbWallFrameHalf) }
  { id: "walk-north", x0: climbWallFace, x1: galleryEast, z0: (climbWallZ + climbWallFrameHalf), z1: naveNorth }
]
let climbWalkRails = flatMap([-1, 1], side => concat(
  map(range(0, 2), i => {
    id: $"walk-{side}-{i}"
    z: (climbWallZ + (side * (climbWallFrameHalf + 2 + (4 * i))))
    short: 0
  }),
  [{ id: $"walk-{side}-end", z: (climbWallZ + (side * ((((naveNorth - naveSouth) / 2) - (galleryTile / 2))))), short: 3 }]
))

// The doorways in the balustrades of levels 2 and 3, each filling a bay's balcony edge where something meets the floor
// from over the void: the tree's branches on those levels (`treeLimbs`). Each is { level, side, x }, `x` the bay's
// centre; the balustrade leaves the bay to the doorway and a short length either side.
let galleryEdgeDoors = map(filter(treeLimbs, b => (b.level >= 2)), b => { level: b.level, side: b.side, x: b.x })
function galleryEdgeDoorsOn(level, side) = filter(galleryEdgeDoors, d => ((d.level == level) and (d.side == side)))
// Whether the balcony edge at `x` on a level's side is a plain length of balustrade, with no doorway in its bay.
function galleryEdgeRailed(level, side, x) = (count(galleryEdgeDoorsOn(level, side), d => (d.x == x)) == 0)
