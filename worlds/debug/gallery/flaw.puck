// The flaw: one continuous glowing tube that runs through every floor of the gallery and is the building's light.
// A module library: it hands gallery.puck the flaw's creations, their placements and its lights, and emits no document.
//
// The route is layout.puck's `flawRoute`, a closed polyline of level runs and plumb risers; the look is look.puck's
// `lookFlaw`, `lookFlawTint` and `lookFlawCollar`. The tube follows the route with every corner rounded to
// `lookFlaw.bend` (the standard's `closedRoundedPolyline`): a sweep per piece, a neon core inside a frosted glass sleeve,
// each piece the tint of where it stands round the loop. The light is a chain of tube lights along the route's runs
// (`loopStretches`), cut at the slabs (layout.puck's `flawCuts`) so every light lies in one storey. Where the route
// passes through a slab a brass collar fills the slab's opening (shell.puck cuts it). The sweeps are solid nowhere: a
// body passes through the flaw.

import "../../standard/paths"
import "../../standard/colors"
import "layout"
import "look"

let flawPieces = closedRoundedPolyline(flawRoute, lookFlaw.bend, lookFlaw.stretch)
let flawStretches = loopStretches(flawRoute, flawCuts, lookFlaw.stretch)

// The tints: the keys of lookFlawTint stand evenly round the loop, and the tint eases linearly between them in steps,
// one a palette slot, as many as a creation's palette holds beside the sleeve's slot; a piece or light at the fraction
// `at` of the way round wears step `flawStep(at)`.
let flawSteps = 31
function flawStep(at) = minimum((flawSteps - 1), floor((at * flawSteps)))
function flawTint(step) = rgbHex(loopGradient(lookFlawTint, (step / flawSteps)))

// The storey a height stands in, 0 to 3.
function flawStorey(y) = floor((((y < 0) ? 0 : ((y > 17.9) ? 17.9 : y)) + 0.1) / galleryStorey)

// A point of the building's frame in a creation's author frame, which is turned 180 degrees about up from its
// placement's, the placement standing at the building's origin.
function flawAuthor(p) = [(0 - p[0]), p[1], (0 - p[2])]

// The collar's sleeve reaches just past the corners of the slab's square opening.
let flawCollarSleeve = ((lookFlawCollarCut * 1.4143) + 0.01)
let flawSlab = 0.3

// The flaw's creation: slot s is the core of the pieces of tint step s, lit at the core's luminance, and the last slot the
// frosted sleeve every piece shares. The collar is a creation of its own, so it bakes at its own fine detail and is
// stamped at every crossing: in its frame the slab's middle stands at 0.
template flawPrototype() {
  prototype "gallery-flaw" {
    document {
      name: "gallery-flaw"
      schema: "puck.creation.v2"
      palette: concat(
        map(range(0, flawSteps), step => { color: flawTint(step), roughness: 0.5, emissive: lookFlaw.coreNits }),
        [{ color: lookFlaw.glass, roughness: lookFlaw.frost, glass { depth: lookFlaw.depth, ior: 1.5 } }]
      )
      // Each sweep stands at its piece's start, its curve relative to that point.
      for q in flawPieces {
        shape Sweep $"core-{q.index}" {
          position: (flawAuthor(q.a) * [-1, 1, -1])
          rotation: rotate([0, 1, 0], 180)
          material: flawStep(q.at)
          curve {
            a [0, 0, 0]
            b: (flawAuthor(q.b) - flawAuthor(q.a))
            c: (flawAuthor(q.c) - flawAuthor(q.a))
            radiusStart: lookFlaw.core
            radiusEnd: lookFlaw.core
          }
        }
        shape Sweep $"sleeve-{q.index}" {
          position: (flawAuthor(q.a) * [-1, 1, -1])
          rotation: rotate([0, 1, 0], 180)
          material: flawSteps
          curve {
            a [0, 0, 0]
            b: (flawAuthor(q.b) - flawAuthor(q.a))
            c: (flawAuthor(q.c) - flawAuthor(q.a))
            radiusStart: lookFlaw.sleeve
            radiusEnd: lookFlaw.sleeve
          }
        }
      }
    }
  }
  prototype "gallery-flaw-collar" {
    document {
      name: "gallery-flaw-collar"
      schema: "puck.creation.v2"
      palette [{ color: lookFlawCollar.color, roughness: lookFlawCollar.roughness, metal: 1 }]
      shape Cylinder "sleeve" {
        rotation: rotate([0, 1, 0], 180)
        material: 0
        scale [flawCollarSleeve, (flawSlab / 2), flawCollarSleeve]
      }
      for side in [-1, 1] {
        shape Cylinder $"ring-{side}" {
          material: 0
          position [0, (side * ((flawSlab + lookFlawCollar.lip) / 2)), 0]
          rotation: rotate([0, 1, 0], 180)
          scale [lookFlawCollar.rim, (lookFlawCollar.lip / 2), lookFlawCollar.rim]
          chamfer: lookFlawCollar.bevel
        }
      }
      shape Cylinder "bore" {
        rotation: rotate([0, 1, 0], 180)
        blend: Subtraction
        material: 0
        scale [lookFlawCollar.bore, (flawSlab + lookFlawCollar.lip), lookFlawCollar.bore]
      }
    }
  }
}
// The flaw stands at the building's origin; a collar stands at each crossing, at its slab's middle (layout.puck's
// `flawCuts`), and is solid like the slab it finishes.
template flawPlacement() {
  placement "gallery-flaw" {
    prototype: "gallery-flaw"
    parent: "gallery"
    position [0, 0, 0]
  }
  for (c, n) in flawCrossings {
    placement $"gallery-flaw-collar-{n}" {
      prototype: "gallery-flaw-collar"
      parent: "gallery"
      position [c.point[0], flawCuts[c.height], c.point[2]]
      solid
    }
  }
}
// The flaw's light: a tube light along each stretch, in the tint of where it stands, its intensity per metre the
// storey's `hallLamps` cell, so a level's switch quiets the stretches that storey holds. Each is anchored to the
// building's root, so it stands still and the irradiance volume traces it: its light bounces about its storey and stops
// at the slabs.
function flawLights(anchor) = map(
  flawStretches,
  s => tube(
    name: $"flaw-{s.index}",
    anchor: anchor,
    from: s.from,
    to: s.to,
    radius: lookFlaw.sleeve,
    color: flawTint(flawStep(s.at)),
    intensity: $"state.hallLamps.level{flawStorey(((s.from[1] + s.to[1]) * 0.5))}"
  )
)
