// Holiday trees for the owner to judge on level 0: the standard's firs (conifer.puck), two strung with classic bulbs (one
// taller and fuller), bright enough to read lit indoors, and one fibre-optic fir on the world's shared fibre lanes
// (fir-fiber.puck). Each stands on a showcase row in a rest bay, between two displays, so the nave's centre line stays
// open from the entrance to the climbing wall. Its prototypes and placements join the gallery.
import "../../standard/conifer"
import "../fir-fiber"
import "layout"

// A holiday bulb's glow in nits: the standard's default is a meadow's at dusk, and the gallery is exposed for daylight,
// so its lights must outshine the station screens (3000) to read as lit.
let holidayBulbGlow = 4000

// Where each tree stands, by bay and showcase row, and which fir it is.
let holidayTrees = [
  { id: "lit", bay: 4, row: showcaseRowNorth, prototype: "gallery-fir-lit", yaw: 0 }
  { id: "tall", bay: 10, row: showcaseRowSouth, prototype: "gallery-fir-tall-lit", yaw: 40 }
  { id: "fiber", bay: 10, row: showcaseRowNorth, prototype: "gallery-fir-fiber", yaw: 200 }
]

prototypes {
  firTree(id: "gallery-fir-lit", lights: true, bulbGlow: holidayBulbGlow)
  firTree(id: "gallery-fir-tall-lit", lights: true, height: 1.3, spread: 0.9, bulbCount: 64, bulbGlow: holidayBulbGlow)
  firTree(id: "gallery-fir-fiber", fiber: true, fiberGlow: holidayBulbGlow)
}

placements {
  for tree in holidayTrees {
    placement $"gallery-holiday-{tree.id}" {
      prototype: tree.prototype
      parent: "gallery"
      position [bayX(tree.bay), galleryFloor[0], tileZ(tree.row)]
      yawDegrees: tree.yaw
      solid
    }
  }
}
