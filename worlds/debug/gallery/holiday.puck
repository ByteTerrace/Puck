// Holiday trees for the owner to judge on level 0: the standard's firs (conifer.puck) on the nave's centre line, two
// strung with classic bulbs (one taller and fuller), bright enough to read lit indoors, and one fibre-optic fir on the
// world's shared fibre lanes (fir-fiber.puck). Its prototypes and placements join the gallery.
import "../../standard/conifer"
import "../fir-fiber"
import "layout"

// A holiday bulb's glow in nits: the standard's default is a meadow's at dusk, and the gallery is exposed for daylight,
// so its lights must outshine the station screens (3000) to read as lit.
let holidayBulbGlow = 4000

// Where each tree stands on the nave's centre line, by bay, and which fir it is.
let holidayTrees = [
  { id: "lit", bay: 3, prototype: "gallery-fir-lit", yaw: 0 }
  { id: "tall", bay: 9, prototype: "gallery-fir-tall-lit", yaw: 40 }
  { id: "fiber", bay: 11, prototype: "gallery-fir-fiber", yaw: 200 }
]

prototypes {
  firTree(id: "gallery-fir-lit", lights: true, bulbGlow: holidayBulbGlow)
  firTree(id: "gallery-fir-tall-lit", lights: true, height: 1.3, spread: 0.9, bulbCount: 64, bulbGlow: holidayBulbGlow)
  firTree(id: "gallery-fir-fiber", fiber: true, fiberGlow: holidayBulbGlow)
}

placements {
  for tree in holidayTrees {
    placement $"gallery-holiday-{tree.id}" {
      prototype: tree.prototype
      parent: "gallery"
      position [bayX(tree.bay), galleryFloor[0], naveMid]
      yawDegrees: tree.yaw
      solid
    }
  }
}
