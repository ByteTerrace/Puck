// Holiday trees for the owner to judge on level 0: the standard's firs (conifer.puck) on the nave's centre line, two
// strung with classic bulbs (one taller and fuller) and one plain. The fibre-optic fir needs render lanes of its own,
// and the debug world's are spent, so it stays in the meadow's grove. Its prototypes and placements join the gallery.
import "../../standard/conifer"
import "layout"

// Where each tree stands on the nave's centre line, by bay, and which fir it is.
let holidayTrees = [
  { id: "lit", bay: 3, prototype: "gallery-fir-lit", yaw: 0 }
  { id: "tall", bay: 9, prototype: "gallery-fir-tall-lit", yaw: 40 }
  { id: "plain", bay: 11, prototype: "gallery-fir", yaw: 200 }
]

prototypes {
  firTree(id: "gallery-fir")
  firTree(id: "gallery-fir-lit", lights: true)
  firTree(id: "gallery-fir-tall-lit", lights: true, height: 1.3, spread: 0.9, bulbCount: 64)
}

placements {
  for tree in holidayTrees {
    placement $"gallery-holiday-{tree.id}" {
      prototype: tree.prototype
      parent: "gallery"
      position [bayX(tree.bay), galleryFloor[0], naveMid]
      yawDegrees: tree.yaw
      solid
    }
  }
}
