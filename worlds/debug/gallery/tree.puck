// The central tree: a giant old broadleaf growing at the hall's exact centre (layout.puck's treeX, treeZ), the gallery's
// diegetic tutorial in climbing and the hall's great staircase. A timber walkway spirals up the trunk at the stairs'
// riser, and two broad branches carry decks out to each of levels 1 to 3, so a player who walks up the trunk learns
// they can climb it, and walking out along a branch learns the branches lead to the other floors. A module library:
// `galleryTree(frame)` grows it, and building.puck expands it on a floor that enables `tree`.
//
// It is two creations on one spot and the foliage placed about them. `gallery-tree` is the wood and the walkway, solid:
// the trunk and its buttress roots, the treads round it on their bark brackets, the level pads where the branches leave
// the spiral, each branch's bark limb and the timber deck along its top, and a low rail of living branch along every
// edge a body could fall from, rising from a stub here and there. A rail collides exactly as it is drawn: a body can
// stand on it or jump over it, and what keeps a walker on the walkway is the walkway's width, not the rail. It sets
// `contact: Shapes`, so a body collides with the hard union of what it stands on and climbs (the trunk's stacked drums,
// the boards, the rails, the limbs and roots): analytic primitives, inside the solid the smooth blends draw, with no
// field solve. The trunk's braided strands, the boughs under the pads, the rails' stubs, the forks, knots, burls,
// brackets, lanterns and nests are drawn only. `gallery-tree-canopy` is
// what a body never touches, with no collision: the boughs that carry the foliage under the skylights and the dark mass
// that closes the crown over the trunk's top. The foliage itself is leafy clumps (foliage.puck's leafyClump), one
// creation a colour family, placed once for every clump of the crown, of the tiers under it and of each branch's fork
// (leafyClumps): every copy draws its family's one baked mesh at its own size and turn, and shades as one soft volume,
// so a change to the leaves bakes one clump. No clump stands where a body walks, and every bough crosses the spiral
// between two of its turns, so the walk keeps its headroom from the floor to the last landing.
//
// Every dimension of the walkway is layout.puck's (the trunk, the treads, the pads and the branches' walking lines),
// every colour and look value look.puck's (lookTree). Its points are written in the tree frame (limbs.puck,
// foliage.puck's treePoint), a half turn about up from the plan's, so a plan offset (dx, y, dz) from the tree's centre
// is tree-frame (-dx, y, -dz) (layout.puck's treeAuthor), and a plan angle a round the trunk is tree-frame angle a + 180.

import "../../standard/foliage"
import "../../standard/limbs"
import "../shapes"
import "layout"
import "look"

// A branch's deck: boards `treeDeck` thick, full widths at the pad and at the balcony, narrow enough at the tip to pass
// level 1's open bay and level 2's and 3's doorways. The bark limb under it, widths and depths at the pad and at the
// balcony, swelled where it leaves the bough that carries it.
let treeDeck = 0.2
let treeDeckWidth = [1.8, 1.6]
let treeBranchWidth = [1.7, 1.25]
let treeBranchDepth = [1, 0.5]
let treeBranchSegments = 8
// Each branch forks a share `at` along it, to its left on even branches and its right on odd ones: the fork leaves the
// limb's flank `drop` under the deck, reaches `reach` metres out and `rise` up, clear of the guard, `radius` thick at
// its root and tip.
let treeFork = { at: 0.5, reach: 2.8, rise: 2.8, drop: 0.85, radius [0.3, 0.1] }
function treeForkSide(i) = (((i % 2) == 0) ? 1 : -1)
function treeForkTip(b, i) = limbForkTip(
  treeBranchA(b),
  treeBranchB(b),
  treeBranchC(b),
  treeFork.at,
  treeForkSide(i),
  treeFork.reach,
  treeFork.rise,
  treeFork.drop
)
// Two knots on each limb's flanks, `size` metres across, a share `at` along it and on the side `side` names relative to
// its fork.
let treeKnots = [{ at: 0.27, side: -1, size: 0.5 }, { at: 0.8, side: 1, size: 0.38 }]

// The buttress roots, each a fin that leaves the trunk `top` metres up at plan bearing `angle` and flares out and down to
// the floor `reach` metres from the bark, concave like a root spreading its load. They stand where the walkway above them
// has already climbed well past their tops, and one flanks the walkway's foot, so the way in reads between a root and the
// first riser.
let treeRootRows = [
  { angle: 125, top: 0.75, reach: 2.6 }
  { angle: 175, top: 1, reach: 3 }
  { angle: 222, top: 1.25, reach: 3.3 }
  { angle: 268, top: 1.3, reach: 3.5 }
  { angle: 305, top: 0.9, reach: 3.1 }
]
let treeRootWidth = [1.1, 0.35]
// The trunk's contact core and drawn taper: drums stacked to the trunk's top, blended into one smooth taper.
let treeCoreCount = 28
// The trunk's strands (limbs.puck's braidedTrunk): five stems winding a little under half a turn up the taper, standing
// a little proud of it so its silhouette reads as grown strands with crevices between them, and no further than the
// walkway's walking radius leaves room for.
let treeStems = { count: 5, segments: 4, turn: 160, out [1.5, 0.72], radius [0.72, 0.36], bow: 0.1, smooth: 0.1 }
// Shelf fungus brackets every `treeFungusEvery`-th tread; burls swell the bark between the spiral's turns at
// golden-angle bearings.
let treeFungusEvery = 5
let treeBurlCount = 7
// The guard along every edge a body could fall from: one low rail of living branch `treeGuardHeight` over the walking
// surface, about the Moth's hip, so the tree's silhouette reads before its rails. The spiral's rim takes one from its
// third tread, leaving its foot open, to its last, except across each pad's opening.
let treeGuardHeight = 0.75
let treeGuardFrom = 2
let treeGuarded = filter(range(treeGuardFrom, treeTreadCount), k => all(treeLimbs, b => (absolute((k - b.tread)) > 1)))
// The lanterns: one on a brass arm out of the bark over every `treeLanternEvery`-th tread from `treeLanternFrom`,
// `treeLanternLift` metres over its tread (over a walker's head), and one hung from a crook of branch that grows from
// the forward outer corner of every pad, `treeLampHeight` over the pad.
let treeLanternEvery = 4
let treeLanternFrom = 2
let treeLanternLift = 2.35
let treeLampHeight = 2.4
// The nests: woven bowls in the crooks of these branches' forks, a share `at` along the fork, one with eggs.
let treeNests = [{ branch: 1, at: 0.62, eggs: true }, { branch: 4, at: 0.6, eggs: false }]

// The canopy: rings of leafy clumps on domes in the void (where foliage.puck's leafClusterAt stands each, `size` its
// radii, wandering `wander` metres in height), each of one colour family, with a bough from the trunk into every
// `every`-th clump that stands, `limb` its radii from the trunk to the clump (none at 0). The crown is the broad ring
// high in the void; the canopy is a flat ring of small clumps just under the roof, which alone can stand over level 3's
// decks with a walker's headroom under it; the two tiers step down and out over the branches, so the foliage reads as
// layered with depth instead of one cap, and light falls through between them.
let treeRings = [
  {
    name: "crown", family: "crown", centre [0, 15.6, 0], radius: 9, height: 1.2, count: 48, size [1.5, 1.0, 1.44], turn: 20
    wander: 0.7, every: 4, limb [0.34, 0.24, 0.08]
  }
  {
    name: "canopy", family: "crown", centre [0, 17, 0], radius: 9.5, height: 0.1, count: 36, size [0.7, 0.47, 0.67]
    turn: 61, wander: 0.2, every: 0, limb [0, 0, 0]
  }
  {
    name: "tier-0", family: "deep", centre [0, 13.2, 0], radius: 9.6, height: 1.2, count: 48, size [1.2, 0.8, 1.15], turn: 47
    wander: 0.7, every: 3, limb [0.2, 0.14, 0.05]
  }
  {
    name: "tier-1", family: "warm", centre [0, 11, 0], radius: 10.6, height: 0.9, count: 44, size [0.95, 0.63, 0.91]
    turn: 83, wander: 0.7, every: 3, limb [0.2, 0.14, 0.05]
  }
]
// Each fork's foliage: a loose cluster of small clumps round its tip rather than one spray, and a twig to every
// `every`-th clump.
let treeForkFoliage = { radius: 1.4, height: 0.7, count: 6, size [0.8, 0.53, 0.77], every: 3 }
let treeCrownCore = { at [0, 17.2, 0], r [2.4, 0.5, 2.4] }

// Where a body walks, as a leafy clump `size` in radii standing at `at` (tree frame, from the trunk's foot) may not reach:
// the walkway's annulus up to a walker's head over its last tread, and the space over every branch's deck from under its
// limb to over a walker's head. A clump reaches about 1.4 of its radii out (its scale's spread) and its leaves a little
// further. The decks are read at `treeDeckSamples` points each, plan points taken once.
let treeDeckSamples = 10
let treeDeckPoints = flatMap(
  treeLimbs,
  b => map(range(0, (treeDeckSamples + 1)), n => treeBranchAt(b, (n / treeDeckSamples)))
)
let treeWalkTop = (treeTreadTop((treeTreadCount - 1)) + 2.4)
function treeClumpClear(at, size) = (let p = [(treeX - at[0]), (galleryFloor[0] + at[1]), (treeZ - at[2])] in
let rh = ((1.4 * size[0]) + 0.3) in
let rv = ((1.4 * size[1]) + 0.3) in
(((vectorLength((at * [1, 0, 1])) - rh) > (treeRim + 0.3)) or ((at[1] - rv) > treeWalkTop)) and
  all(treeDeckPoints, q => ((vectorLength(((p - q) * [1, 0, 1])) > (rh + 1.1)) or
    ((p[1] - rv) > (q[1] + 2.3)) or
    ((p[1] + rv) < (q[1] - 1.4)))))
function treeRingAt(ring, i) = leafClusterAt(
  ring.centre,
  ring.radius,
  ring.height,
  ring.count,
  i,
  ring.turn,
  ring.wander
)
let treeRingsKept = map(
  treeRings,
  ring => filter(range(0, ring.count), i => treeClumpClear(treeRingAt(ring, i), ring.size))
)
// A fork's foliage as a ring about its tip.
function treeForkRing(b, i) = (treeForkFoliage with {
  centre: (treeForkTip(b, i) + [0, 0.3, 0])
  turn: (31 * i)
  wander: 0.7
})
let treeForksKept = map(range(0, length(treeLimbs)), i => (let ring = treeForkRing(treeLimbs[i], i) in
filter(range(0, ring.count), n => treeClumpClear(treeRingAt(ring, n), ring.size))))

// A bough crosses the walkway's annulus level, between two of its turns: `treeBoughGap` over the tread at its bearing
// (over a walker's head and under the brackets of the turn above), in the highest turn whose crossing stands under the
// clump it reaches, and out to `treeBoughCross` metres from the axis before it rises to its clump.
let treeBoughGap = 3
let treeBoughCross = 4.7
let treeTurnTreads = (360 / treeTreadStep)
// The tread of turn `n` at the plan bearing of a tree-frame point.
function treeTurnTread(at, n) = (let u = ((((atan2((0 - at[2]), (0 - at[0])) * 180) / pi) - treeTreadStart) /
  treeTreadStep) in
(floor(((u - (treeTurnTreads * floor((u / treeTurnTreads)))) + 0.5)) + (treeTurnTreads * n)))
function treeBoughLevel(at) = first(
  [3, 2, 1, 0],
  n => ((treeTurnTread(at, n) < treeTreadCount) and
    ((treeTreadTop(treeTurnTread(at, n)) + treeBoughGap) <= (at[1] - 0.4))),
  n => (treeTreadTop(treeTurnTread(at, n)) + treeBoughGap),
  (at[1] - 0.4)
)

// Materials.
let treeBark = 0
let treeTimber = 1
let treeFungus = 2
let treeGlow = 3
let treeBrass = 4
let treeWicker = 5
let treeEgg = 6
function treeBranchBark(i) = (7 + i)
let treeLeaf = 0
let treeTwig = 1
// The families of leafy clump (look.puck's lookTree.foliage) and the creation each is.
let treeFamilies = ["crown", "deep", "warm", "blossom"]
function treeClump(family) = $"gallery-tree-clump-{family}"
// Every third fork's foliage is golden.
function treeForkFamily(i) = (((i % 3) == 2) ? "blossom" : "crown")
// Bark whose grain runs along `frame` (limbs.puck's barkAlong, barkUpright), twisting `twist` radians a metre about the
// trunk's axis.
function treeBarkSurface(color, under, seed, frame, twist = 0) = galleryCel(landscapeSurface(
  { color: color, roughness: 0.94, specular: 0.025 },
  under: under,
  deposit: lookTree.moss,
  seed: seed,
  scale: 1,
  lines: 0,
  settle: 0.12,
  noise: 1,
  patternScale: lookTree.streak,
  threshold: 0.6,
  softness: 0.25,
  grain: 1,
  frame: frame,
  origin: [treeX, galleryFloor[0], treeZ],
  twist: twist
))

// A pad's tree-frame point `r` metres out from the axis along its tread's bearing and `lat` metres across it (positive
// round the way the spiral climbs), at its top.
function treePadAngle(b) = (treeTreadAngle(b.tread) + treeAuthorTurn)
function treePadPoint(b, r, lat) = (polarPoint(r, treePadAngle(b), treeTreadTop(b.tread)) +
  polarPoint(lat, (treePadAngle(b) + 90), 0))
function treeDeckLine(b) = [treeBranchA(b), treeBranchB(b), treeBranchC(b)]

// A lantern hanging at tree-frame point `at` (its globe's middle): a brass cap over a glowing globe and a finial under it.
template treeLantern(label, at) {
  shape Cylinder $"{label}-cap" {
    detail: true
    material: treeBrass
    position: ((at + [0, 0.2, 0]) * [-1, 1, -1])
    scale [0.12, 0.04, 0.12]
    rounding: 0.02
  }
  shape Ellipsoid $"{label}-globe" {
    detail: true
    material: treeGlow
    position: (at * [-1, 1, -1])
    scale [0.13, 0.17, 0.13]
  }
  shape Sphere $"{label}-finial" {
    detail: true
    material: treeBrass
    position: ((at - [0, 0.19, 0]) * [-1, 1, -1])
    scale [0.035, 0.035, 0.035]
  }
}

// A bough of the canopy from inside the trunk out to the clump at `into` (tree frame): level across the walkway's annulus
// at its crossing height (treeBoughLevel), then rising to the clump, tapering through `radius`.
template treeBoughInto(label, into, radius) {
  let level = treeBoughLevel(into)
  let out = vectorUnit((into * [1, 0, 1]))
  let far = vectorLength((into * [1, 0, 1]))
  shape Sweep $"{label}-cross" {
    rotation: rotate([0, 1, 0], 180)
    material: treeTwig
    blend: SmoothUnion
    smooth: 0.2
    curve {
      a: ((out * 0.3) + [0, level, 0])
      b: ((out * ((0.3 + treeBoughCross) / 2)) + [0, level, 0])
      c: ((out * treeBoughCross) + [0, level, 0])
      radiusStart: radius[0]
      radiusEnd: radius[1]
    }
  }
  shape Sweep $"{label}-reach" {
    rotation: rotate([0, 1, 0], 180)
    material: treeTwig
    blend: SmoothUnion
    smooth: 0.15
    curve {
      a: ((out * treeBoughCross) + [0, level, 0])
      b: ((out * ((treeBoughCross + far) / 2)) + [0, level, 0])
      c: (into - [0, 0.1, 0])
      radiusStart: radius[1]
      radiusEnd: radius[2]
    }
  }
}

template galleryTree(frame) {

  prototypes {
    prototype "gallery-tree" {
      document {
        name: "gallery-tree"
        schema: "puck.creation.v2"
        contact: Shapes
        palette: concat(
          [
            treeBarkSurface(lookTree.bark, lookTree.barkUnder, 6113, barkUpright, lookTree.twist)
            galleryCel(
              {
                color: lookTree.deck
                roughness: 0.62
                specular: 0.04
                shade: brushed(0.08, 1.6, [1, 0.86, 0.62], 6114)
              }
            )
            galleryCel(canopySurface(lookTree.fungus, 6118))
            { color: lookTree.lantern, roughness: 0.5, emissive: lookTree.lanternGlow }
            { color: lookTree.brass, roughness: 0.3, metal: 1 }
            galleryCel({ color: lookTree.wicker, roughness: 0.85, specular: 0.03 })
            galleryCel({ color: lookTree.egg, roughness: 0.4, specular: 0.05 })
          ],
          map(
            treeLimbs,
            (b, i) => treeBarkSurface(
              lookTree.branch,
              lookTree.branchUnder,
              (6120 + i),
              barkAlong((treeBranchC(b) - treeBranchA(b)))
            )
          )
        )
        // No creation relief and no blend but the unions: a relief can carry the surface inside the shapes, so it would
        // collide as drawn, a field solve over the whole tree, and a carving blend would scope the whole creation into one
        // instance every bake sample walks. The bark's texture is its grain (treeBarkSurface) and its form the strands,
        // burls, knots and forks below.
        //
        // The trunk: drums blended into one taper, which it collides as, a stack of cylinders a little inside the drawn
        // taper, under the braided strands that stand proud of it.
        trunkCore(
          label: "trunk",
          base: treeTrunk.base,
          apex: treeTrunk.apex,
          top: treeTrunk.top,
          count: treeCoreCount,
          material: treeBark,
          smooth: 0.4
        )
        braidedTrunk(
          label: "stem",
          count: treeStems.count,
          foot: -0.05,
          top: (treeTrunk.top + 0.4),
          out: treeStems.out,
          radius: treeStems.radius,
          material: treeBark,
          turn: treeStems.turn,
          segments: treeStems.segments,
          bow: treeStems.bow,
          smooth: treeStems.smooth
        )
        for (root, i) in treeRootRows {
          limb(
            label: $"root-{i}",
            a: polarPoint((treeTrunk.base - 0.3), (root.angle + treeAuthorTurn), root.top),
            b: polarPoint((treeTrunk.base + (0.3 * root.reach)), (root.angle + treeAuthorTurn), (0.32 * root.top)),
            c: polarPoint((treeTrunk.base + root.reach), (root.angle + treeAuthorTurn), 0.03),
            width: treeRootWidth,
            thickness: [(root.top + 0.5), 0.28],
            material: treeBark,
            segments: 5,
            exponent: 2.3,
            smooth: 0.4
          )
        }
        // Burls between the spiral's turns, spread up the trunk from its second turn, each two metres under the tread
        // above it at a bearing the Weyl sequence wanders.
        for n in range(0, treeBurlCount) {
          let k = (22 + floor(((n + weylShare(n)) * ((treeTreadCount - 26) / treeBurlCount))))
          shape Superellipsoid $"burl-{n}" {
            detail: true
            material: treeBark
            exponent: 2.1
            position: (polarPoint(
              trunkRadius(treeTrunk.base, treeTrunk.apex, (treeTreadTop(k) - 2)),
              (treeTreadAngle(k) + treeAuthorTurn),
              (treeTreadTop(k) - 2)
            ) * [-1, 1, -1])
            scale [
              (0.42 + (0.2 * weylShare(n, 0.7548776662))),
              (0.55 + (0.2 * weylShare(n))),
              (0.42 + (0.2 * weylShare(n, 0.7548776662)))
            ]
            blend: SmoothUnion
            smooth: 0.35
          }
        }
        // The walkway: timber treads round the trunk on their bark brackets, and the guard along its rim.
        spiralTreads(
          label: "tread",
          count: treeTreadCount,
          start: (treeTreadStart + treeAuthorTurn),
          step: treeTreadStep,
          rise: treeTreadRise,
          base: treeTrunk.base,
          apex: treeTrunk.apex,
          rim: treeRim,
          material: treeTimber,
          bracket: treeBark,
          thickness: treeTreadThickness,
          accent: treeFungus,
          accentEvery: treeFungusEvery
        )
        spiralGuard(
          label: "guard",
          treads: treeGuarded,
          start: (treeTreadStart + treeAuthorTurn),
          step: treeTreadStep,
          rise: treeTreadRise,
          rim: treeRim,
          material: treeBark,
          height: treeGuardHeight
        )
        // The last tread has no tread over its forward run, so a guard closes its leading edge from the bark to the rim
        // and on round the rim to its pad's guard.
        let last = (treeTreadCount - 1)
        let lastBack = ((treeTreadAngle(last) + treeAuthorTurn) - (treeTreadStep / 2))
        let lastHalf = (((treeRim * sine(((treeTreadStep * pi) / 180))) / 2) + 0.02)
        let lastAcross = polarPoint((2 * lastHalf), (lastBack + 90), 0)
        guardRun(
          label: "guard-end",
          from: (polarPoint((treeBarkAt(last) + 0.15), lastBack, treeTreadTop(last)) + lastAcross),
          to: (polarPoint((treeRim - 0.06), lastBack, treeTreadTop(last)) + lastAcross),
          side: -1,
          material: treeBark,
          height: treeGuardHeight
        )
        guardRun(
          label: "guard-end-rim",
          from: (polarPoint((treeRim - 0.06), lastBack, treeTreadTop(last)) + lastAcross),
          to: treePadPoint(treeLimbs[(length(treeLimbs) - 1)], treeRim, ((treePadWidth / 2) - 0.06)),
          side: 1,
          material: treeBark,
          height: treeGuardHeight
        )
        // Lanterns on brass arms out of the bark, over a walker's head.
        for k in filter(range(treeLanternFrom, treeTreadCount), k => (((k - treeLanternFrom) % treeLanternEvery) == 0)) {
          let y = (treeTreadTop(k) + treeLanternLift)
          let bark = trunkRadius(treeTrunk.base, treeTrunk.apex, y)
          let angle = (treeTreadAngle(k) + treeAuthorTurn)
          shape Sweep $"lantern-arm-{k}" {
            rotation: rotate([0, 1, 0], 180)
            detail: true
            material: treeBrass
            curve {
              a: polarPoint((bark - 0.1), angle, (y + 0.05))
              b: polarPoint((bark + 0.3), angle, (y + 0.45))
              c: polarPoint((bark + 0.45), angle, (y + 0.24))
              radiusStart: 0.03
              radiusEnd: 0.02
            }
          }
          treeLantern(label: $"lantern-{k}", at: polarPoint((bark + 0.45), angle, y))
        }
        // Each branch: a level pad where it leaves the spiral, on a bough out of the trunk, its bark limb carrying a
        // timber deck out to its balcony, rails along the pad and both sides of the deck, a lamp on a crook at the pad, and
        // its fork and knots.
        for (b, i) in treeLimbs {
          let top = treeTreadTop(b.tread)
          let angle = treePadAngle(b)
          let line = treeDeckLine(b)
          let under = [0, treeDeck, 0]
          let side = ((treePadWidth / 2) - 0.06)
          // The pad is a sharp box, so its outer edge meets the deck's first board flush: a rounded edge would dip under
          // the board's end and leave a lip a walker steps up.
          shape Box $"pad-{i}" {
            material: treeTimber
            position: (polarPoint(((treePadFrom + treePadReach) / 2), angle, (top - (treeTreadThickness / 2))) *
              [-1, 1, -1])
            rotation: rotate([0, 1, 0], (0 - angle))
            scale [((treePadReach - treePadFrom) / 2), (treeTreadThickness / 2), (treePadWidth / 2)]
          }
          shape Sweep $"bough-{i}" {
            rotation: rotate([0, 1, 0], 180)
            material: treeBranchBark(i)
            blend: SmoothUnion
            smooth: 0.3
            curve {
              a: polarPoint((treeBarkAt(b.tread) - 0.5), angle, (top - 1.5))
              b: polarPoint(((treeBarkAt(b.tread) + treePadReach) / 2), angle, (top - 1.1))
              c: (line[0] - [0, (treeDeck + (treeBranchDepth[0] / 2)), 0])
              radiusStart: 0.75
              radiusEnd: 0.5
            }
          }
          limb(
            label: $"branch-{i}",
            a: (line[0] - under),
            b: (line[1] - under),
            c: (line[2] - under),
            width: treeBranchWidth,
            thickness: treeBranchDepth,
            material: treeBranchBark(i),
            segments: treeBranchSegments,
            smooth: 0.3
          )
          deckedLimb(
            label: $"deck-{i}",
            a: line[0],
            b: line[1],
            c: line[2],
            width: treeDeckWidth,
            thickness: treeDeck,
            material: treeTimber,
            segments: treeBranchSegments
          )
          for s in [-1, 1] {
            limbGuard(
              label: $"deck-guard-{i}-{(s + 1) / 2}",
              a: line[0],
              b: line[1],
              c: line[2],
              width: treeDeckWidth,
              side: s,
              material: treeBranchBark(i),
              segments: treeBranchSegments,
              height: treeGuardHeight
            )
            guardRun(
              label: $"pad-guard-{i}-{(s + 1) / 2}",
              from: treePadPoint(b, treeRim, (s * side)),
              to: treePadPoint(b, (treePadReach - 0.06), (s * side)),
              side: (0 - s),
              material: treeBranchBark(i),
              height: treeGuardHeight,
              post: true
            )
          }
          let lamp = treePadPoint(b, (treePadReach - 0.12), ((treePadWidth / 2) + 0.05))
          let reach = polarPoint(0.55, angle, 0)
          shape Sweep $"lamp-crook-{i}" {
            rotation: rotate([0, 1, 0], 180)
            material: treeBranchBark(i)
            blend: SmoothUnion
            smooth: 0.05
            curve {
              a: (lamp - [0, 0.3, 0])
              b: ((lamp + [0, (treeLampHeight + 0.5), 0]) - (reach * 0.2))
              c: ((lamp + reach) + [0, (treeLampHeight + 0.35), 0])
              radiusStart: 0.07
              radiusEnd: 0.03
            }
          }
          treeLantern(label: $"lamp-{i}", at: ((lamp + reach) + [0, (treeLampHeight + 0.05), 0]))
          limbFork(
            label: $"fork-{i}",
            a: line[0],
            b: line[1],
            c: line[2],
            at: treeFork.at,
            side: treeForkSide(i),
            reach: treeFork.reach,
            rise: treeFork.rise,
            radius: treeFork.radius,
            material: treeBranchBark(i),
            drop: treeFork.drop
          )
          for (knot, j) in treeKnots {
            limbKnot(
              label: $"knot-{i}-{j}",
              a: line[0],
              b: line[1],
              c: line[2],
              at: knot.at,
              side: (knot.side * treeForkSide(i)),
              width: limbTaper(treeBranchWidth, 0, knot.at),
              size: knot.size,
              material: treeBranchBark(i),
              depth: (treeDeck + 0.35)
            )
          }
        }
        // Nests in the crooks of forks: a woven rim on a woven bowl, and in one a clutch of eggs.
        for (nest, n) in treeNests {
          let b = treeLimbs[nest.branch]
          let line = treeDeckLine(b)
          let base = limbForkBase(line[0], line[1], line[2], treeFork.at, treeFork.drop)
          let bend = ((base +
            (limbLeft(line[0], line[1], line[2], treeFork.at) * ((treeForkSide(nest.branch) * 0.6) * treeFork.reach))) +
            [0, (0.25 * treeFork.rise), 0])
          let at = (quadraticPoint(base, bend, treeForkTip(b, nest.branch), nest.at) + [0, 0.22, 0])
          shape Torus $"nest-rim-{n}" {
            detail: true
            material: treeWicker
            position: (at * [-1, 1, -1])
            scale [0.42, 0.42, 0.42]
          }
          shape Ellipsoid $"nest-bowl-{n}" {
            detail: true
            material: treeWicker
            position: ((at - [0, 0.1, 0]) * [-1, 1, -1])
            scale [0.46, 0.2, 0.46]
            blend: SmoothUnion
            smooth: 0.06
          }
          if nest.eggs {
            for e in range(0, 3) {
              shape Ellipsoid $"nest-egg-{n}-{e}" {
                detail: true
                material: treeEgg
                position: ((at + polarPoint(0.1, (120 * e), 0.06)) * [-1, 1, -1])
                scale [0.06, 0.08, 0.06]
              }
            }
          }
        }
      }
    }
    prototype "gallery-tree-canopy" {
      document {
        name: "gallery-tree-canopy"
        schema: "puck.creation.v2"
        palette [
          galleryCel(canopySurface(lookTree.foliage.crown.inner, 6115))
          treeBarkSurface(lookTree.branch, lookTree.branchUnder, 6116, barkUpright)
        ]
        shape Superellipsoid "crown-core" {
          material: treeLeaf
          exponent: landscapeExponent
          position: (treeCrownCore.at * [-1, 1, -1])
          scale: treeCrownCore.r
        }
        // Boughs from the trunk into every `every`-th clump that stands of each ring: a few boughs a ring, as a tree
        // carries, with the clumps between them massed on them, each crossing the walkway between two of its turns
        // (treeBoughInto).
        for (ring, r) in treeRings {
          for (k, m) in treeRingsKept[r] {
            if ((ring.every > 0) and ((m % maximum(ring.every, 1)) == 0)) {
              treeBoughInto(label: $"{ring.name}-limb-{k}", into: treeRingAt(ring, k), radius: ring.limb)
            }
          }
        }
        // A few twigs from each fork's tip into its clumps.
        for (b, i) in treeLimbs {
          for (n, m) in treeForksKept[i] {
            if ((m % treeForkFoliage.every) == 0) {
              let into = treeRingAt(treeForkRing(b, i), n)
              shape Sweep $"fork-twig-{i}-{n}" {
                rotation: rotate([0, 1, 0], 180)
                material: treeTwig
                blend: SmoothUnion
                smooth: 0.1
                curve {
                  a: (treeForkTip(b, i) - [0, 0.2, 0])
                  b: (((treeForkTip(b, i) * 0.55) + (into * 0.45)) + [0, 0.35, 0])
                  c: (into - [0, 0.15, 0])
                  radiusStart: 0.12
                  radiusEnd: 0.04
                }
              }
            }
          }
        }
      }
    }
    for (family, k) in treeFamilies {
      leafyClump(
        id: treeClump(family),
        tones: map(
          lookTree.foliage[family].tones,
          (leaves, j) => galleryCel(leafySurface(leaves, ((6130 + (10 * k)) + j), soft: lookTree.soft))
        ),
        inner: galleryCel(leafySurface(lookTree.foliage[family].inner, (6139 + (10 * k)), soft: lookTree.soft))
      )
    }
  }

  placements {
    // The tree can be climbed: its trunk and limbs hold a climber, and its treads and branch tops are ground she walks.
    placement "gallery-tree" {
      prototype: "gallery-tree"
      parent: "gallery"
      position [treeX, galleryFloor[0], treeZ]
      grip {
        holdable: true
      }
      solid
    }
    placement "gallery-tree-canopy" {
      prototype: "gallery-tree-canopy"
      parent: "gallery"
      position [treeX, galleryFloor[0], treeZ]
    }
    // The foliage: a leafy clump for every clump of each ring and of each fork that stands clear of where bodies walk
    // (treeClumpClear).
    for (ring, r) in treeRings {
      leafyClumps(
        label: $"gallery-tree-{ring.name}",
        prototype: treeClump(ring.family),
        origin: [treeX, galleryFloor[0], treeZ],
        parent: "gallery",
        centre: ring.centre,
        radius: ring.radius,
        height: ring.height,
        count: ring.count,
        size: ring.size,
        turn: ring.turn,
        wander: ring.wander,
        only: treeRingsKept[r]
      )
    }
    for (b, i) in treeLimbs {
      let ring = treeForkRing(b, i)
      leafyClumps(
        label: $"gallery-tree-fork-{i}",
        prototype: treeClump(treeForkFamily(i)),
        origin: [treeX, galleryFloor[0], treeZ],
        parent: "gallery",
        centre: ring.centre,
        radius: ring.radius,
        height: ring.height,
        count: ring.count,
        size: ring.size,
        turn: ring.turn,
        wander: ring.wander,
        only: treeForksKept[i]
      )
    }
  }

  // On the floor at the walkway's foot, just short of its first riser, facing up the spiral (yaw 0 faces -z, the bearing
  // turns from +x toward +z).
  spawnPoints [
    { id: "tree", parent: gallery, position: treeTreadWalk(-1), yawDegrees: (180 - treeTreadAngle(-1)) }
  ]
}
