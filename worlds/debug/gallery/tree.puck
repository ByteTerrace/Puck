// The central tree: a giant old broadleaf growing at the hall's exact centre (layout.puck's treeX, treeZ), the gallery's
// diegetic tutorial in climbing. Shelves of bark and fungus spiral up the trunk at the stairs' riser, and two broad
// branches reach each of levels 1 to 3, so a player who walks up the trunk learns they can climb it, and walking out along
// a branch learns the branches lead to the other floors. The gallery module imports this, so the gallery booted alone
// (gallery-root.puck) and the debug world both grow it.
//
// It is two creations on one spot. `gallery-tree` is the wood, solid: the trunk with its flare and buttress roots, the
// shelves grown out of its bark, and the branches, which taper from collars at the trunk, fork and carry knots. It sets
// `contact: Shapes`, so a body collides with the hard union of the masses it stands on and climbs (a stack of cylinders
// inside the drawn cone, the shelves, the branch masses, the roots): analytic primitives, inside the solid the smooth
// blends draw, with no field solve. The cone itself, the forks, knots, burls and fungus brackets are drawn only.
// `gallery-tree-canopy` is what a body never touches, with no collision: a crown of separate leaf clusters high in the
// void under the skylights, the limbs that carry them, and a spray of leaves at the end of each branch's fork.
//
// Every dimension is layout.puck's (the trunk, the shelves, the branches and where they land), every colour and look
// value look.puck's (lookTree). Shapes are authored in the creation's frame, a half turn about up from the plan's, so a
// plan offset (dx, y, dz) from the tree's centre stands at author (-dx, y, -dz), and a plan angle a round the trunk is
// author angle a + 180.

import "../../standard/foliage"
import "../../standard/limbs"
import "../shapes"
import "layout"
import "look"

// A plan point as the creation's author-frame point.
function treeAuthor(p) = [(treeX - p[0]), (p[1] - galleryFloor[0]), (treeZ - p[2])]
let treeAuthorTurn = 180

// A branch's walking line: from just inside the bark over its shelf, bending round to its landing, arching a little as
// it goes. Its control point lies halfway between a point out along its shelf's bearing (so it leaves the trunk as a
// limb does) and a point straight back from its landing across the edge (so it meets the balcony nearly square and
// walks through level 1's gate rather than across it).
function treeBranchA(b) = treeAuthor(treeBranchFrom(b))
function treeBranchC(b) = treeAuthor(treeBranchTo(b))
function treeBranchReach(b) = vectorLength((treeBranchC(b) - treeBranchA(b)) * [1, 0, 1])
function treeBranchOut(b) = (treeBranchA(b) + polarPoint(
  (0.45 * treeBranchReach(b)),
  (treeTreadAngle(b.tread) + treeAuthorTurn),
  (((treeBranchC(b)[1] - treeBranchA(b)[1]) / 2) + 0.35)
))
// A branch that meets a doorway (levels 2 and 3) puts its control point straight back from the landing, so its last run
// crosses the doorway square, through the middle of the opening.
function treeBranchB(b) = ((b.level >= 2) ? [treeBranchC(b)[0], treeBranchOut(b)[1], ((treeBranchA(b)[2] + treeBranchC(b)[2]) / 2)] : ((treeBranchOut(b) + [treeBranchC(b)[0], treeBranchOut(b)[1], ((treeBranchA(b)[2] + treeBranchC(b)[2]) / 2)]) / 2))
// Branch widths and depths, full, metres, at the trunk and at the balcony: broad enough at the tip to walk, narrow enough
// to pass level 1's gate and level 2's balustrade gap, swelled by `treeBranchCollar` where each leaves the trunk.
let treeBranchWidth = [1.9, 1.3]
let treeBranchDepth = [1.7, 0.6]
let treeBranchCollar = 0.35
let treeBranchSegments = 8
// Each branch forks a share `at` along it, to its left on even branches and its right on odd ones: the fork reaches
// `reach` metres out and `rise` up, `radius` thick at its root and tip, and ends in a spray of leaves `spray` in radii.
let treeFork = { at: 0.5, reach: 2.4, rise: 2.6, radius [0.34, 0.1], spray [1.2, 0.62, 1.05] }
function treeForkSide(i) = (((i % 2) == 0) ? 1 : -1)
function treeForkTip(b, i) = limbForkTip(treeBranchA(b), treeBranchB(b), treeBranchC(b), treeFork.at, treeForkSide(i), treeFork.reach, treeFork.rise, 0.35)
// Two knots on each branch's flanks, `size` metres across, a share `at` along it and on the side `side` names relative to
// its fork.
let treeKnots = [{ at: 0.27, side: -1, size: 0.55 }, { at: 0.8, side: 1, size: 0.42 }]

// The buttress roots, each a fin that climbs the trunk to `top` metres at plan bearing `angle` and arches out and down
// to the floor `reach` metres from the bark. The tall ones stand where the shelves above them have already climbed well
// past their tops; the low ones, under the shelves' first quarter turn, lie along the floor below them.
let treeRootRows = [
  { angle: 30, top: 0.45, reach: 2.4 }
  { angle: 100, top: 0.75, reach: 2.8 }
  { angle: 185, top: 1.85, reach: 3.3 }
  { angle: 228, top: 1.9, reach: 2.9 }
  { angle: 268, top: 1.75, reach: 3.5 }
  { angle: 318, top: 1.9, reach: 3.1 }
]
let treeRootThickness = [0.62, 0.22]
// How far under the floor the trunk reaches, so its cut never lies in the floor's own surface, and how many cylinders
// its contact core stacks.
let treeBuried = 0.05
let treeCoreCount = 28

// Shelf fungus grows on every `treeFungusEvery`-th shelf, which takes the fungus's material, with smaller brackets
// stepping down the bark beneath it; burls swell the bark between the spiral's turns at golden-angle bearings.
let treeFungusEvery = 5
let treeShelfWander = 0.28
let treeBurlCount = 7
// The trunk's strands (limbs.puck's braidedTrunk): five stems winding a little under half a turn up the cone, standing
// proud of its taper so its silhouette reads as grown strands, swelling between crossings, blended tightly so the
// crevices between them stay deep.
let treeStems = { count: 5, segments: 4, turn: 160, out [2.05, 1.15], radius [0.85, 0.42], bow: 0.22, smooth: 0.1 }

// The crown: separate leaf clusters on a dome high in the void (foliage.puck's leafClusters), a broad mass closing it
// over the trunk's top, and limbs from the trunk's top into every `treeCrownLimbEvery`-th cluster.
let treeCrown = { centre [0, 15.25, 0], radius: 6.4, height: 1.55, count: 34, size [1.2, 0.8, 1.15], turn: 20 }
// The crown's lower tiers: wider, sparser rings of smaller clusters stepping down and out over the branches, so the
// canopy reads as layered foliage with depth instead of one cap, and light falls through between the tiers.
let treeCrownTiers = [
  { centre [0, 13.2, 0], radius: 8.6, height: 1.2, count: 40, size [0.95, 0.62, 0.9], turn: 47 }
  { centre [0, 11.0, 0], radius: 10.4, height: 0.9, count: 30, size [0.75, 0.5, 0.72], turn: 83 }
]
// Each fork's foliage: a loose cluster of small clumps round its tip rather than one spray.
let treeForkFoliage = { radius: 1.5, height: 0.7, count: 9, size [0.62, 0.42, 0.58] }
let treeCrownCore = { at [0, 16.35, 0], r [2.8, 1.05, 2.8] }
let treeCrownLimbEvery = 4

// Materials.
let treeBark = 0
let treeShelf = 1
let treeFungus = 2
function treeBranchBark(i) = (3 + i)
let treeLeaf = 0
let treeTwig = 1
let treeBlossom = 2
// The lower tiers' leaves, a shade apart from the crown's so the canopy reads in depth: the first tier deeper, the second
// warmer.
function treeTierLeaf(k) = (3 + k)
// Bark whose grain runs along `frame` (limbs.puck's barkAlong, barkUpright), twisting `twist` radians a metre about the
// trunk's axis.
function treeBarkSurface(color, under, seed, frame, twist = 0) = galleryCel(landscapeSurface(
  { color: color, roughness: 0.94, specular: 0.025 },
  under: under,
  deposit: lookTree.moss,
  seed: seed,
  scale: 1,
  lines: 0,
  settle: 0.12,
  noise: 1,
  patternScale: lookTree.streak,
  threshold: 0.6,
  softness: 0.25,
  grain: 1,
  frame: frame,
  origin: [treeX, galleryFloor[0], treeZ],
  twist: twist
))

prototypes {
  prototype "gallery-tree" {
    document {
      name: "gallery-tree"
      schema: "puck.creation.v1"
      contact: Shapes
      palette: concat(
        [
          treeBarkSurface(lookTree.bark, lookTree.barkUnder, 6113, barkUpright, lookTree.twist)
          treeBarkSurface(lookTree.tread, lookTree.treadUnder, 6114, barkUpright, lookTree.twist)
          galleryCel(canopySurface(lookTree.fungus, 6118))
        ],
        map(treeLimbs, (b, i) => treeBarkSurface(lookTree.branch, lookTree.branchUnder, (6120 + i), barkAlong((treeBranchC(b) - treeBranchA(b)))))
      )
      // No creation relief: a relief can carry the surface inside the shapes, so it would collide as drawn, a field solve
      // over the whole tree. The bark's texture is its grain (treeBarkSurface) and its form the burls, knots, forks and
      // shelves below.
      // The drawn trunk: a cone whose taper would close far above the roof, cut off inside the crown and just under the
      // floor. The cut follows the cone at once, so it trims the cone alone.
      shape Cone "trunk" {
        detail: true
        material: treeBark
        position [0, (treeTrunk.apex / 2), 0]
        scale [treeTrunk.base, (treeTrunk.apex / 2), treeTrunk.base]
      }
      shape Box "trunk-cut" {
        detail: true
        material: treeBark
        position [0, ((treeTrunk.top - treeBuried) / 2), 0]
        scale [(treeTrunk.base + 0.5), ((treeTrunk.top + treeBuried) / 2), (treeTrunk.base + 0.5)]
        blend: Intersection
      }
      trunkCore(label: "core", base: treeTrunk.base, apex: treeTrunk.apex, top: treeTrunk.top, count: treeCoreCount, material: treeBark)
      braidedTrunk(
        label: "stem",
        count: treeStems.count,
        foot: (0 - treeBuried),
        top: (treeTrunk.top + 0.6),
        out: treeStems.out,
        radius: treeStems.radius,
        material: treeBark,
        turn: treeStems.turn,
        segments: treeStems.segments,
        bow: treeStems.bow,
        smooth: treeStems.smooth
      )
      shape Superellipsoid "flare" {
        material: treeBark
        exponent: 2.2
        position [0, -0.35, 0]
        scale [(treeTrunk.base + 0.7), 0.8, (treeTrunk.base + 0.7)]
        blend: SmoothUnion
        smooth: 0.5
      }
      for (root, i) in treeRootRows {
        limb(
          label: $"root-{i}",
          a: polarPoint((treeTrunk.base - 0.35), (root.angle + treeAuthorTurn), root.top),
          b: polarPoint((treeTrunk.base + (0.3 * root.reach)), (root.angle + treeAuthorTurn), (0.55 * root.top)),
          c: polarPoint((treeTrunk.base + root.reach), (root.angle + treeAuthorTurn), 0.05),
          width: treeRootThickness,
          thickness: [(root.top + 0.5), 0.3],
          material: treeBark,
          segments: 4,
          exponent: 2.2,
          smooth: 0.45
        )
      }
      spiralTreads(
        label: "shelf",
        count: treeTreadCount,
        start: (treeTreadStart + treeAuthorTurn),
        step: treeTreadStep,
        rise: treeTreadRise,
        base: treeTrunk.base,
        apex: treeTrunk.apex,
        material: treeShelf,
        depth: 1.9,
        thickness: 0.7,
        inset: 0.5,
        exponent: 2.7,
        smooth: 0.3,
        wander: treeShelfWander,
        accent: treeFungus,
        accentEvery: treeFungusEvery
      )
      // Smaller fungus brackets stepping down the bark under each fungus shelf, drawn only.
      for k in filter(range(0, treeTreadCount), k => ((k % treeFungusEvery) == (treeFungusEvery - 1))) {
        for j in range(0, 2) {
          shape Superellipsoid $"bracket-{k}-{j}" {
            detail: true
            material: treeFungus
            exponent: 2.4
            position: polarPoint(
              (trunkRadius(treeTrunk.base, treeTrunk.apex, treeTreadTop(k)) + 0.1),
              ((treeTreadAngle(k) + treeAuthorTurn) + ((j == 0) ? -7 : 6)),
              (treeTreadTop(k) - (0.85 + (0.45 * j)))
            )
            rotation: rotate([0, 1, 0], (0 - ((treeTreadAngle(k) + treeAuthorTurn) + ((j == 0) ? -7 : 6))))
            scale [(0.42 - (0.1 * j)), 0.07, (0.5 - (0.12 * j))]
            blend: SmoothUnion
            smooth: 0.06
          }
        }
      }
      // Burls between the spiral's turns, spread up the trunk from its second turn, each two metres under the shelf above
      // it at a bearing the Weyl sequence wanders.
      for n in range(0, treeBurlCount) {
        let k = (22 + floor(((n + weylShare(n)) * ((treeTreadCount - 26) / treeBurlCount))))
        shape Superellipsoid $"burl-{n}" {
          detail: true
          material: treeBark
          exponent: 2.1
          position: polarPoint(trunkRadius(treeTrunk.base, treeTrunk.apex, (treeTreadTop(k) - 2)), (treeTreadAngle(k) + treeAuthorTurn), (treeTreadTop(k) - 2))
          scale [(0.42 + (0.2 * weylShare(n, 0.7548776662))), (0.55 + (0.2 * weylShare(n))), (0.42 + (0.2 * weylShare(n, 0.7548776662)))]
          blend: SmoothUnion
          smooth: 0.35
        }
      }
      for (b, i) in treeLimbs {
        limb(
          label: $"branch-{b.level}-{b.side}",
          a: treeBranchA(b),
          b: treeBranchB(b),
          c: treeBranchC(b),
          width: treeBranchWidth,
          thickness: treeBranchDepth,
          material: treeBranchBark(i),
          segments: treeBranchSegments,
          collar: treeBranchCollar,
          smooth: 0.3
        )
        limbFork(
          label: $"fork-{b.level}-{b.side}",
          a: treeBranchA(b),
          b: treeBranchB(b),
          c: treeBranchC(b),
          at: treeFork.at,
          side: treeForkSide(i),
          reach: treeFork.reach,
          rise: treeFork.rise,
          radius: treeFork.radius,
          material: treeBranchBark(i)
        )
        for (knot, j) in treeKnots {
          limbKnot(
            label: $"knot-{b.level}-{b.side}-{j}",
            a: treeBranchA(b),
            b: treeBranchB(b),
            c: treeBranchC(b),
            at: knot.at,
            side: (knot.side * treeForkSide(i)),
            width: limbTaper(treeBranchWidth, treeBranchCollar, knot.at),
            size: knot.size,
            material: treeBranchBark(i)
          )
        }
      }
    }
  }
  prototype "gallery-tree-canopy" {
    document {
      name: "gallery-tree-canopy"
      schema: "puck.creation.v1"
      palette [
        galleryCel(canopySurface(lookTree.leaves, 6115))
        treeBarkSurface(lookTree.branch, lookTree.branchUnder, 6116, barkUpright)
        galleryCel(canopySurface(lookTree.blossom, 6117))
        galleryCel(canopySurface(lookTree.leavesDeep, 6119))
        galleryCel(canopySurface(lookTree.leavesWarm, 6121))
      ]
      // The leaf masses' breakup, one relief over the whole canopy.
      noise {
        frequency: lookTree.clumpGrain
        amplitude: lookTree.clump
        octaves: 3
        gain: 0.45
        seed: 6115
      }
      leafClusters(
        label: "crown",
        centre: treeCrown.centre,
        radius: treeCrown.radius,
        height: treeCrown.height,
        count: treeCrown.count,
        size: treeCrown.size,
        material: treeLeaf,
        smooth: 0.35,
        turn: treeCrown.turn
      )
      for (tier, k) in treeCrownTiers {
        leafClusters(
          label: $"crown-tier-{k}",
          centre: tier.centre,
          radius: tier.radius,
          height: tier.height,
          count: tier.count,
          size: tier.size,
          material: treeTierLeaf(k),
          smooth: 0.25,
          turn: tier.turn
        )
      }
      shape Superellipsoid "crown-core" {
        material: treeLeaf
        exponent: landscapeExponent
        position: treeCrownCore.at
        scale: treeCrownCore.r
        blend: SmoothUnion
        smooth: 0.5
      }
      // The limbs from the trunk's top out into the crown's clusters.
      for n in range(0, floor((treeCrown.count / treeCrownLimbEvery))) {
        let into = leafClusterAt(treeCrown.centre, treeCrown.radius, treeCrown.height, treeCrown.count, ((n * treeCrownLimbEvery) + 2), treeCrown.turn)
        shape Sweep $"crown-limb-{n}" {
          material: treeTwig
          blend: SmoothUnion
          smooth: 0.3
          curve {
            a: leanLocal([0, (treeTrunk.top - 1.6), 0], 0)
            b: leanLocal([(into[0] * 0.35), (into[1] - 0.9), (into[2] * 0.35)], 0)
            c: leanLocal([(into[0] * 0.85), (into[1] - 0.2), (into[2] * 0.85)], 0)
            radiusStart: 0.36
            radiusEnd: 0.08
          }
        }
      }
      // Limbs from the trunk out into every cluster of each lower tier, each leaving the trunk below its cluster
      // and rising to it, so no clump floats.
      for (tier, k) in treeCrownTiers {
        for n in range(0, tier.count) {
          let into = leafClusterAt(tier.centre, tier.radius, tier.height, tier.count, n, tier.turn)
          shape Sweep $"tier-limb-{k}-{n}" {
            material: treeTwig
            blend: SmoothUnion
            smooth: 0.2
            curve {
              a: leanLocal([(into[0] * 0.08), (into[1] - 2.2), (into[2] * 0.08)], 0)
              b: leanLocal([(into[0] * 0.5), (into[1] - 1.1), (into[2] * 0.5)], 0)
              c: leanLocal([(into[0] * 0.92), (into[1] - 0.15), (into[2] * 0.92)], 0)
              radiusStart: 0.2
              radiusEnd: 0.05
            }
          }
        }
      }
      // A cluster of leaves round each branch's fork, every third in blossom.
      for (b, i) in treeLimbs {
        leafClusters(
          label: $"fork-{i}",
          centre: (treeForkTip(b, i) + [0, 0.3, 0]),
          radius: treeForkFoliage.radius,
          height: treeForkFoliage.height,
          count: treeForkFoliage.count,
          size: treeForkFoliage.size,
          material: (((i % 3) == 2) ? treeBlossom : treeLeaf),
          smooth: 0.22,
          turn: (31 * i)
        )
        // A twig from the fork's tip into each of its clumps, so none floats.
        for n in range(0, treeForkFoliage.count) {
          let into = leafClusterAt((treeForkTip(b, i) + [0, 0.3, 0]), treeForkFoliage.radius, treeForkFoliage.height, treeForkFoliage.count, n, (31 * i))
          shape Sweep $"fork-twig-{i}-{n}" {
            material: treeTwig
            blend: SmoothUnion
            smooth: 0.1
            curve {
              a: (treeForkTip(b, i) - [0, 0.2, 0])
              b: (((treeForkTip(b, i) + into) / 2) - [0, 0.15, 0])
              c: into
              radiusStart: 0.12
              radiusEnd: 0.04
            }
          }
        }
      }
    }
  }
}

placements {
  placement "gallery-tree" {
    prototype: "gallery-tree"
    parent: "gallery"
    position [treeX, galleryFloor[0], treeZ]
    solid
  }
  placement "gallery-tree-canopy" {
    prototype: "gallery-tree-canopy"
    parent: "gallery"
    position [treeX, galleryFloor[0], treeZ]
  }
}

// At the foot of the shelves, on the floor just short of the first, facing up the spiral (north, round the trunk's east
// side).
spawnPoints [
  { id: "tree", parent: gallery, position: treeTreadPlan(-1, 1), yawDegrees: 180 }
]
