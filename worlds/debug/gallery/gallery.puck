// The gallery as the debug world stands it: the building (building.puck) at layout.puck's `galleryFrame`, full size and
// unturned, with every module the debug world's floors enable (layout.puck's `galleryFloorsDebug`: all of them but level
// 2's game stations, since the debug world stands its own station, ../game-station-deck.puck). debug.puck imports this
// document; gallery-root.puck, gallery-shell.puck and the scaled roots expand the building themselves, each with its own
// frame and floors.

import "../../standard/place"
import "../fir-fiber"
import "layout"
import "building"

galleryBuilding(frame: galleryFrame, floors: galleryFloorsDebug)

// The companion hears the lifts' authored door edges through its read-only sensory projection, and the debug world binds
// its camera to the inspection lever's cells (exposure.puck). Its lamp over the context button reads which display a
// seat stands at (debug.puck), and the exhibits a learn panel scrubs read their size or softness (shapes.puck's
// learnSizeBy and learnSoftness).
exports {
  reads [liftCarDoor, liftAt, gallery]
  bindings [galleryExposure, terminalNear, learnSize, learnAmount]
}
