// The gallery: the building the shape gallery (shapes.puck) stands in, as one module. Four storeys round a nave that
// runs the building's length under skylights, its plan in layout.puck and gallery.md:
//
//   the nave            21 m wide, a void from level 0's floor to the roof, the climbing wall rising up the middle
//                       of its east wall between tall bays of clear and stained glass, a glass lift either side of
//                       it; level 0's display stations flank its centre aisle
//   the aisles          north and south of the nave on level 0, behind arcades of branched piers, and the galleries
//                       over them on levels 1 to 3, their balcony edges round the void and their displays along them
//   the stairs          one in each corner of the aisles: switchbacks south-west and north-east, spirals south-east
//                       and north-west, each serving every storey
//   the entrance        a wide doorway in the west wall on the nave's axis, under a canopy over the west forecourt
//   the painting wing   level 0's south aisle east of x 30 (paintings.puck)
//   the board game room level 2's south gallery and the wing that projects over the forecourt, twelve game
//                       stations in two rows (games.puck)
//   the terrace         the roof of the west wing's south aisle, off level 3
//
// Every row here stands under one root placement, `gallery`: the shell and its kit pieces (shell.puck), the lifts, the
// switches, the signs and the displays are placed in the building's frame with `parent`, the fixtures are anchored to
// the root, the spawn points name it as their parent, and each lift's car is a body the car's own placement spawns,
// which its platform, cab, doors and buttons ride by that placement's name. A world stands the building by placing
// `gallery` (a position and a turn); the debug world's place is layout.puck's `gallerySite`. The building has no sun of
// its own: the importing world's lights it.
//
// The shell is solid, so the Moth walks the floors and climbs the stairs (each riser 0.25 m, under her 0.3 m step
// height) and the chase camera's clearance keeps the eye inside the rooms. shapes.md says how to get around and what
// each level shows.
//
// Creation shapes are authored in a frame turned 180 degrees about up from the world's, so a shape at author position
// (x, y, z) in a placement with no yaw stands at (-x, y, -z) of the placement's frame. `boundsBox`
// (standard/bounds.puck) takes bounds in that frame and writes the author-frame row.

import "../../standard/bounds"
import "../../standard/kits"
import "../../standard/architecture"
import "../../standard/contexts/terminal"
import "../../standard/place"
import "../../standard/reach"
import "../shapes"
import "../shape-station"
import "../portal-library"
import "../../standard/panel"
import "layout"
import "shell"
import "look"
import "flaw"
import "holiday"
import "toybox"
import "tree"
import "climbing-wall"
import "rentals"
import "wonder"
import "mouse-house"
import "stewards"
import "portals"
// The companion hears the lifts' authored door edges through its read-only sensory projection, and the world that stands
// the building binds its camera to the inspection lever's cells (the debug world's exposure.puck).
exports {
  reads [liftCarDoor, liftAt, gallery]
  // The debug world's lamp over the context button reads which display a seat stands at (debug.puck), and the exhibits
  // a learn panel scrubs read their size or softness (shapes.puck's learnSizeBy and learnSoftness).
  bindings [galleryExposure, terminalNear, learnSize, learnAmount]
}

// The exposure `gallery.inspect On` pins the camera at, in EV100 (a lit room is about 7).
let inspectHold = 7

// The lift's panels and displays: a satin steel plate, charcoal legends, chrome bezels and black display glass, with the
// lit and unlit lamps and button faces in the slots after them. The variants of a button or display share their
// geometry and differ only in those slots, so lighting one bakes nothing.
let liftSteel = 0
let liftInk = 1
let liftChrome = 2
let liftGlass = 3
let liftFace = 4
let liftBase = [
  { color: "#B4B8BD", roughness: 0.5, metal: 0.85 }
  { color: "#23262B", roughness: 0.6, specular: 0.15 }
  { color: "#DADDE0", roughness: 0.2, metal: 1 }
  { color: "#0A0C0F", roughness: 0.3, specular: 0.08 }
]
let liftLamps = [
  { color: "#4A3B24", roughness: 0.5, specular: 0.05 }
  { color: "#FFA52E", roughness: 0.5, emissive: 450nit }
]
let liftFaces = [
  { color: "#C9C5BA", roughness: 0.45, specular: 0.1 }
  { color: "#FF9F2E", roughness: 0.4, emissive: 260nit }
]

// A round button standing on its plate: a chrome bezel and a face of the lit or unlit slot, on the +Z side of the origin.
template liftButtonFace() {
  shape Cylinder "bezel" {
    material: liftChrome
    position [0, 0, -0.012]
    rotation [-0.707107, 0, 0, 0.707107]
    scale [0.12, 0.012, 0.12]
  }
  shape Cylinder "face" {
    material: liftFace
    position [0, 0, -0.02]
    rotation [-0.707107, 0, 0, 0.707107]
    scale [0.095, 0.012, 0.095]
  }
}

// The lifts (layout.puck's galleryLifts): two glass cars, one at each balcony edge of the nave's east end, run by one
// set of rules over the cars, every row keyed by a car's `key` (0 the north car, 1 the south) and every per-level row a
// family with a member a car. Each car is a population body (`lift-car-<id>`, kit `lift`) carrying attached solid
// platform, cab and door placements, each riding the body its own placement spawns. A car moves only by the rules
// below: `liftAt` is its height in sixteenths of a metre, `liftTarget` where it is going, and every tick its
// `lift-ride-<id>` poses it at cell `liftAt` of its shaft's box topology (`liftShaft-<id>`), a column of 1/16 m layers
// read in the building's frame, so the car climbs exactly 1/16 m a tick (1.875 m/s at 30 Hz) and stops exactly at each
// floor (level k is cell 72k). The car's body root rides 2.25 m over its floor, clear of the platform and ceiling it
// carries, so its own collider never meets its own platform. Each car stands turned so the cab's own front, its door,
// faces its balcony and its glazed back looks across the nave.
//
// The input panel works as a real lift does, all of it state and rules. A call at a landing (its CALL button) lights in
// `liftHallOf<car>[level]`, a floor button in the car in `liftCarCallOf<car>[level]`, and a button's placement shows its
// lit variant while its cell is 1; a call stays pending until the car stops there. A stopped car waits out its
// `liftDwell` (four seconds after its doors open) and then serves its pending stops in its direction of travel
// (`liftDir`, 1 up, -1 down, 0 idle), nearest first, and only then turns round; a stop that lies ahead of a moving car,
// nearer than its target, is taken on the way. The car's door-open button (`liftOpenReq`) opens or holds the doors and
// starts the dwell afresh, its door-close button (`liftCloseReq`) closes them and ends the dwell. `liftFloor` (the level
// the car is at or last passed) and `liftArrow` (0 none, 1 up, 2 down) pick the variants of each level display.
// `liftCall` stays a mailbox for `gallery.lift` and the traversal addon: a level written to a car's cell becomes a
// landing call there. A panel that replaces the buttons (layout.puck's galleryLiftLandings are its hooks) writes the
// same cells.
let liftRoot = 2.25
let liftCells = 72
let liftCars = length(galleryLifts)
// Button reach boxes in each car, six side by side before its back rail: floors 0 to 3, door open and door close, each
// button drawn at its cell's centre. A cell is given in the car's own frame (x across the cab, z toward its back), where
// the Moth's body can stand between -0.93 and 0.93; the outer two reach to the walls. Each landing's CALL plate reach is
// its control point's (layout.puck's galleryLiftLandings).
let carPadHi = 0.95
let carPadPitch = (1.9 / 6)
let carKeys = ["0", "1", "2", "3", "open", "close"]
let carPads = map(
  range(0, 6),
  j => {
    slot: j
    key: carKeys[j]
    x: (carPadHi - (carPadPitch * (j + 0.5)))
    x0: ((j == 5) ? -1.3 : (carPadHi - (carPadPitch * (j + 1))))
    x1: ((j == 0) ? 1.3 : (carPadHi - (carPadPitch * j)))
  }
)
// Where a car's landing fixtures stand in its own frame: the landing doors in the shaft's front, and the level display
// over its CALL plate.
let landingDoorZ = (liftFront + 0.06)
let landingDisplayHeight = 1.8
// The panel's rail: 1.25 m over the car's floor, 5 cm proud of the back glass's inner face.
let carPanelY = 1.25
let carPanelZ = 1.395

// The room lights. `hallLights` holds each level's state, Off or On, and every level starts On. Off quiets the light of
// the stretch of the flaw that storey holds (`hallLamps`) and the lamps it owns; a lift car's lamp rides the car
// whatever its level. A level's switch stands on the east wall of the north aisle, beside the north lift's landing and
// the north-east stair's foot, 1.1 to 1.46 m over the floor; the context button (`interact`, E or RB on a pad) flips it
// while a body stands in the switch's reach box before it.
let switchZ = tileZ((arcadeRowNorth + 1))
let switchReach = map(
  range(0, 4),
  k => {
    rule: $"hall-switch-{k}"
    level: k
    x0: (galleryEast - 1)
    x1: galleryEast
    z0: (switchZ - 0.5)
    z1: (switchZ + 0.5)
    y0: (galleryFloor[k] - 0.5)
    y1: (galleryFloor[k] + 1)
  }
)
// On and off differ only in the indicator's colour, so the two switches are one geometry and a flip bakes nothing.
let hallSwitchStates = [
  { name: "on", indicator: "#FFC46B", glow: 300 }
  { name: "off", indicator: "#5BE38A", glow: 200 }
]

// The south-west stair's pendant (architecture.puck's pendantLamp): hung over the middle of level 1's half landing
// from the soffit of level 2's, its diffuser 3.6 m over the landing, so it lights the flights between levels 1 and 2,
// where the flaw does not reach. `stairPendantAt` is the ceiling point in the building's frame.
let stairPendantStair = galleryStair("south-west")
let stairPendantAt = [
  stairCentreX(stairPendantStair),
  ((galleryFloor[2] + (galleryStorey / 2)) - 0.3),
  (stairPendantStair.well.z0 + (switchbackLanding / 2))
]
let stairPendantDrop = 0.55
let stairPendantPower = glowSpotPower(lookStairPendant.luminance, pendantGlowArea())
// The pendant's diffuser lit and dark: the two prototypes differ only in that slot, so a flip bakes nothing. The lit one
// carries the pendant's light, so the placement's response to level 1's switch turns the light with the diffuser.
let stairPendantStates = [
  {
    name: "on"
    lit: true
    glow { color: lookStairPendant.color, roughness: 0.5, emissive: lookStairPendant.luminance }
  }
  { name: "off", lit: false, glow { color: lookStairPendant.off, roughness: 0.5, specular: 0.04 } }
]
// The car's luminous ceiling panel, in the cab's frame: its half extents across and along, and its glowing face's
// height over the car's floor.
let carLampHalf = [1.25, 1.4]
let carLampFace = 2.51

// What each `hallLamps` cell holds while its level is On: a storey's stretch of the flaw, its light in candela per metre
// (look.puck's lookFlaw).
let hallLampLevels = map(range(0, 4), k => { key: $"level{k}", level: k, value: lookFlaw.intensity })

// The tour: every exhibit in walking order, level by level and display by display (shapes.puck's galleryCatalog).
// `galleryStop` is the exhibit the tour last showed (-1 before the first step); gallery.next and gallery.prev write
// `galleryStep`, a rule moves the stop, and the stop's own rule stands body 0 before the exhibit's display, facing it,
// and shows the exhibit on its turntable.

// A reach standing in the building's frame: a region a press acts in (../../standard/reach.puck), under the root.
template galleryReach(id, box) {
  placement id {
    prototype: "place"
    parent: "gallery"
    position: boundsCentre(box)
    region {
      halfExtents: boundsHalf(box)
      capacity: reachCapacity
    }
  }
}

// One lift's car and what rides it: the body, its platform, cab and door, the level display and direction arrows over
// its panel, and the panel's buttons and their reaches, all attached to the body by its placement's name.
template galleryLiftCar(car) {
  placement $"lift-car-{car.id}" {
    prototype: "lift-car"
    parent: "gallery"
    position [car.x, liftRoot, car.z]
    yawDegrees: car.yaw
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "lift"
      look: "lift-car"
      source: "Idle"
    }
  }
  placement $"lift-platform-{car.id}" {
    prototype: "lift-platform"
    position [0, 0, 0]
    attach {
      placement: $"lift-car-{car.id}"
      localOffset [0, (0 - liftRoot), 0]
    }
    solid
  }
  placement $"lift-cab-{car.id}" {
    prototype: "lift-car"
    position [0, 0, 0]
    attach {
      placement: $"lift-car-{car.id}"
      localOffset [0, (0 - liftRoot), 0]
    }
    solid
  }
  placement $"lift-car-door-{car.id}" {
    prototype: "lift-door-0"
    position [0, 0, 0]
    attach {
      placement: $"lift-car-{car.id}"
      localOffset [0, (0 - liftRoot), -1.56]
    }
    solid
    respond [
      { when: state(state: liftCarDoor, key: $"{car.key}", comparison: Equal, value: 1), prototypeId: "lift-door-1" }
    ]
  }
  placement $"lift-car-indicator-{car.id}" {
    prototype: "lift-display-0"
    position [0, 0, 0]
    attach {
      placement: $"lift-car-{car.id}"
      localOffset [0, (1.85 - liftRoot), carPanelZ]
    }
    respond: map(
      range(1, 4),
      v => {
        when: state(state: liftFloor, key: $"{car.key}", comparison: Equal, value: v)
        prototypeId: $"lift-display-{v}"
      }
    )
  }
  placement $"lift-car-arrow-{car.id}" {
    prototype: "lift-arrows-0"
    position [0, 0, 0]
    attach {
      placement: $"lift-car-{car.id}"
      localOffset [0, (1.85 - liftRoot), carPanelZ]
    }
    respond: map(
      range(1, 3),
      v => {
        when: state(state: liftArrow, key: $"{car.key}", comparison: Equal, value: v)
        prototypeId: $"lift-arrows-{v}"
      }
    )
  }
  // The rail's buttons, left to right: floors 0 to 3, door open, door close. A floor button lights while its car call
  // is pending, a door button for a moment after its press. Each button's reach rides the car before it.
  for pad in carPads {
    placement $"lift-car-btn-{car.id}-{pad.slot}" {
      prototype: $"lift-btn-{pad.key}-0"
      position [0, 0, 0]
      attach {
        placement: $"lift-car-{car.id}"
        localOffset [pad.x, (carPanelY - liftRoot), carPanelZ]
      }
      respond [
        {
          when: ((pad.slot < 4) ? state(
            state: $"liftCarCallOf{car.key}",
            key: $"{pad.slot}",
            comparison: Equal,
            value: 1
          ) : state(
            state: $"liftLamp{(pad.slot == 4) ? "Open" : "Close"}",
            key: $"{car.key}",
            comparison: Equal,
            value: 1
          ))
          prototypeId: $"lift-btn-{pad.key}-1"
        }
      ]
    }
    placement $"lift-{car.id}-car-reach-{pad.slot}" {
      prototype: "place"
      position [0, 0, 0]
      attach {
        placement: $"lift-car-{car.id}"
        localOffset [((pad.x0 + pad.x1) / 2), (0.15 - liftRoot), 0.95]
      }
      region {
        halfExtents [((pad.x1 - pad.x0) / 2), 0.35, 0.55]
        capacity: reachCapacity
      }
    }
  }
}

// One landing of one lift: its CALL plate at its control point (layout.puck's galleryLiftLandings), lit while its call
// is pending; the landing door's leaves in the shaft's front, open while the car stands open there; the level display
// and arrows over the plate; and the board over the door naming the level.
template galleryLiftLanding(car, landing) {
  placement $"lift-call-{car.id}-{landing.level}" {
    prototype: "lift-call-0"
    parent: "gallery"
    position: landing.at
    yawDegrees: landing.yaw
    respond [
      {
        when: state(state: $"liftHallOf{car.key}", key: $"{landing.level}", comparison: Equal, value: 1)
        prototypeId: "lift-call-1"
      }
    ]
  }
  placement $"lift-door-{car.id}-{landing.level}" {
    prototype: "lift-door-0"
    parent: "gallery"
    position: liftPoint(car, [0, (galleryFloor[landing.level] - 0.05), landingDoorZ])
    yawDegrees: car.yaw
    solid
    respond [
      {
        when: state(state: $"liftDoorsOf{car.key}", key: $"{landing.level}", comparison: Equal, value: 1)
        prototypeId: "lift-door-1"
      }
    ]
  }
  placement $"lift-indicator-{car.id}-{landing.level}" {
    prototype: "lift-display-0"
    parent: "gallery"
    position: liftPoint(
      car,
      [liftPanelAcross, (galleryFloor[landing.level] + landingDisplayHeight), (liftFront - 0.04)]
    )
    yawDegrees: car.yaw
    respond: map(
      range(1, 4),
      v => {
        when: state(state: liftFloor, key: $"{car.key}", comparison: Equal, value: v)
        prototypeId: $"lift-display-{v}"
      }
    )
  }
  placement $"lift-arrow-{car.id}-{landing.level}" {
    prototype: "lift-arrows-0"
    parent: "gallery"
    position: liftPoint(
      car,
      [liftPanelAcross, (galleryFloor[landing.level] + landingDisplayHeight), (liftFront - 0.04)]
    )
    yawDegrees: car.yaw
    respond: map(
      range(1, 3),
      v => {
        when: state(state: liftArrow, key: $"{car.key}", comparison: Equal, value: v)
        prototypeId: $"lift-arrows-{v}"
      }
    )
  }
  placement $"lift-landing-{car.id}-{landing.level}" {
    prototype: $"lift-landing-{landing.level}"
    parent: "gallery"
    position: liftPoint(car, [0, galleryFloor[landing.level], (liftFront - 0.49)])
    yawDegrees: car.yaw
  }
}

// The fan shades ease open and shut over a few seconds and settle without a bounce.
dynamics [
  { name: "gallery-shade", f: 0.35, r: 0, zeta: 1 }
]

prototypes {
  shellPrototypes()
  for on in (flawEnabled ? [1] : []) {
    flawPrototype()
  }

  // A floor's light switch, its plate facing +Z in its own frame. A warm indicator is on; a green locator glow
  // (findable in the dark) is off.
  for state in hallSwitchStates {
    prototype $"hall-switch-{state.name}" {
      document {
        name: $"hall-switch-{state.name}"
        schema: "puck.creation.v2"
        palette [
          { color: "#F2EEE4", roughness: 0.55, specular: 0.08 }
          { color: "#3A3F47", roughness: 0.6, specular: 0.15 }
          { color: state.indicator, roughness: 0.4, emissive: state.glow }
        ]
        boundsBox(label: "plate", x0: -0.13, x1: 0.13, y0: 1.1, y1: 1.46, z0: -0.04, z1: 0, slot: 0)
        boundsBox(label: "rocker", x0: -0.035, x1: 0.035, y0: 1.24, y1: 1.32, z0: -0.09, z1: -0.04, slot: 1)
        boundsBox(label: "indicator", x0: -0.02, x1: 0.02, y0: 1.39, y1: 1.42, z0: -0.055, z1: -0.04, slot: 2)
        textRuns [
          {
            text: "LIGHTS"
            position [0, 1.53, -0.002]
            rotation [0, 1, 0, 0]
            emHeight: 0.06
            depth: 0.004
            mode: "emboss"
            material: 1
            align: "center"
          }
        ]
      }
    }
  }
  // The stair's pendant, lit while level 1's lights are on and dark while they are off.
  for state in stairPendantStates {
    prototype $"stair-pendant-{state.name}" {
      document {
        name: $"stair-pendant-{state.name}"
        schema: "puck.creation.v2"
        palette [
          { color: lookStairPendant.drum, roughness: 0.45, specular: 0.05 }
          { color: lookStairPendant.cord, roughness: 0.6, specular: 0.04 }
          state.glow
        ]
        pendantLamp(base: 0, at: [0, 0, 0], drop: stairPendantDrop)
      }
      // The diffuser faces down under its drum shade, so its light is a spot opening to a hemisphere at the face's
      // centre, in the face's colour, giving what the face shows.
      if state.lit {
        lights [
          spot(
            name: "glow",
            position: pendantGlowAt([0, 0, 0], stairPendantDrop),
            direction: [0, -1, 0],
            angle: 90deg,
            innerAngle: 70deg,
            color: lookStairPendant.color,
            power: stairPendantPower
          )
        ]
      }
    }
  }

  // The car's platform: what the Moth stands on, attached solid to the car's body.
  prototype "lift-platform" {
    document {
      name: "lift-platform"
      schema: "puck.creation.v2"
      palette: shellPlain
      shape Box "floor" {
        material: shellTrim
        position [0, 0, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [1.4, 0.05, 1.55]
      }
    }
  }

  prototype "lift-hidden" {
    document {
      name: "lift-hidden"
      schema: "puck.creation.v2"
      palette: shellPlain
      shapes []
    }
  }

  // The cab, an attached solid placement in the same foot frame as its platform: glass on its back and sides between
  // four teal posts, so a ride looks out through the tower, under a teal ceiling whose whole underside is the car's
  // lamp; a brass handrail down each side and the teal rail across the back that carries the six buttons.
  prototype "lift-car" {
    document {
      name: "lift-car"
      schema: "puck.creation.v2"
      palette: shellPlain
      shape Box "back" {
        material: shellGlass
        position [0, 1.3, 1.5]
        scale [1.3, 1.25, 0.05]
      }
      for side in [-1, 1] {
        shape Box $"side-{side}" {
          material: shellGlass
          position [(side * -1.34), 1.3, 0]
          scale [0.05, 1.25, 1.44]
        }
        shape Box $"rail-{side}" {
          material: shellBrass
          position [(side * -1.24), 1, 0]
          scale [0.03, 0.03, 1.3]
        }
        for end in [-1, 1] {
          shape Box $"post-{side}-{end}" {
            material: shellTrim
            position [(side * -1.33), 1.3, (end * -1.49)]
            rotation: rotate([0, 1, 0], 180)
            scale [0.07, 1.3, 0.07]
          }
        }
      }
      shape Box "ceiling" {
        material: shellTrim
        position [0, 2.61, 0]
        rotation: rotate([0, 1, 0], 180)
        scale [1.4, 0.06, 1.55]
      }
      shape Box "lamp" {
        material: shellCarLight
        position [0, (carLampFace + 0.02), 0]
        scale [carLampHalf[0], 0.02, carLampHalf[1]]
      }
      shape Box "panel" {
        material: shellTrim
        position [0, carPanelY, (carPanelZ + 0.025)]
        rotation: rotate([0, 1, 0], 180)
        scale [1.05, 0.2, 0.025]
      }
    }
  }

  // Two leaves meet at the centre; the open variant retracts into the jambs.
  for open in [0, 1] {
    prototype $"lift-door-{open}" {
      document {
        name: $"lift-door-{open}"
        schema: "puck.creation.v2"
        palette: shellPlain
        for side in [-1, 1] {
          shape Box $"leaf-{side}" {
            material: shellFloor
            position [(0 - (side * ((open == 1) ? 1.16 : 0.45))), 1.33, 0]
            rotation: rotate([0, 1, 0], 180)
            scale [((open == 1) ? 0.24 : 0.44), 1.28, 0.06]
          }
        }
      }
    }
  }
  // A level display: black glass in a chrome bezel with the four levels in a row, the one the car is at lit amber and the
  // rest dim, and a pair of arrows beside them, up and down, one lit while the car has that direction. The variants of
  // each differ only in which slot is lit, so they share one geometry and a variant's first showing bakes nothing:
  // a new text run bakes alone, slowly, so a display that changed its glyphs would show the old ones until it was done.
  // Every landing and the car share them.
  for lit in range(0, 4) {
    prototype $"lift-display-{lit}" {
      document {
        name: $"lift-display-{lit}"
        schema: "puck.creation.v2"
        palette: concat(liftBase, map(range(0, 4), d => liftLamps[d == lit]))
        shape Box "bezel" {
          material: liftChrome
          position [0, 0, -0.015]
          scale [0.32, 0.13, 0.015]
        }
        shape Box "glass" {
          material: liftGlass
          position [0, 0, -0.03]
          scale [0.295, 0.105, 0.01]
        }
        textRuns: map(
          range(0, 4),
          d => {
            text: $"{d}"
            position [(0.09 - (0.1 * d)), 0, -0.04]
            rotation [0, 1, 0, 0]
            emHeight: 0.13
            depth: 0.004
            mode: "emboss"
            material: (4 + d)
            align: "center"
            anchor: "capMiddle"
          }
        )
      }
    }
  }
  for arrow in range(0, 3) {
    prototype $"lift-arrows-{arrow}" {
      document {
        name: $"lift-arrows-{arrow}"
        schema: "puck.creation.v2"
        palette: concat(liftBase, [liftLamps[arrow == 1], liftLamps[arrow == 2]])
        shape Prism "up" {
          material: 4
          taper: 0
          position [0.22, 0.05, -0.04]
          scale [0.035, 0.03, 0.005]
        }
        shape Prism "down" {
          material: 5
          taper: 0
          position [0.22, -0.05, -0.04]
          rotation [0, 0, -1, 0]
          scale [0.035, 0.03, 0.005]
        }
      }
    }
  }

  // The car panel's buttons and the landings' call plate, each unlit (0) or lit (1): a chrome bezel round a face. The
  // door buttons draw their arrows away from the bar (open) or at it (close).
  for lit in [0, 1] {
    for j in range(0, 4) {
      prototype $"lift-btn-{j}-{lit}" {
        document {
          name: $"lift-btn-{j}-{lit}"
          schema: "puck.creation.v2"
          palette: concat(liftBase, [liftFaces[lit]])
          liftButtonFace()
          textRuns [
            {
              text: $"{j}"
              position [0, 0, -0.033]
              rotation [0, 1, 0, 0]
              emHeight: 0.13
              depth: 0.004
              mode: "emboss"
              material: liftInk
              align: "center"
              anchor: "capMiddle"
            }
          ]
        }
      }
    }
    for glyph in [{ key: "open", dir: 1 }, { key: "close", dir: -1 }] {
      prototype $"lift-btn-{glyph.key}-{lit}" {
        document {
          name: $"lift-btn-{glyph.key}-{lit}"
          schema: "puck.creation.v2"
          palette: concat(liftBase, [liftFaces[lit]])
          liftButtonFace()
          shape Box "bar" {
            material: liftInk
            position [0, 0, -0.034]
            scale [0.007, 0.05, 0.004]
          }
          for side in [-1, 1] {
            shape Prism $"arrow-{side}" {
              material: liftInk
              taper: 0
              position [(side * -0.047), 0, -0.034]
              rotation: (((side * glyph.dir) == 1) ? [0, 0, 0.707107, 0.707107] : [0, 0, -0.707107, 0.707107])
              scale [0.032, 0.036, 0.004]
            }
          }
        }
      }
    }
    prototype $"lift-call-{lit}" {
      document {
        name: $"lift-call-{lit}"
        schema: "puck.creation.v2"
        palette: concat(liftBase, [liftFaces[lit]])
        shape Box "plate" {
          material: liftSteel
          position [0, 0, 0.02]
          scale [0.14, 0.22, 0.02]
        }
        liftButtonFace()
        textRuns [
          {
            text: "CALL"
            position [0, -0.17, -0.003]
            rotation [0, 1, 0, 0]
            emHeight: 0.055
            depth: 0.003
            mode: "emboss"
            material: liftInk
            align: "center"
          }
        ]
      }
    }
  }

  // Coplanar text runs keep each sign's bake bound thin; the call plate has its own prototype.
  for level in galleryLevels {
    prototype $"lift-landing-{level.level}" {
      document {
        name: $"lift-landing-{level.level}"
        schema: "puck.creation.v2"
        palette: shellPlain
        shape Box "board" {
          material: shellBoard
          position [0, 3.25, 0.43]
          scale [1.1, 0.3, 0.02]
        }
        textRuns [
          {
            text: level.title
            position [0, 3.33, 0.405]
            rotation [0, 1, 0, 0]
            emHeight: 0.11
            depth: 0.004
            mode: "emboss"
            material: shellTrim
            align: "center"
            maxWidth: 2.1
          }
          {
            text: level.what
            position [0, 3.13, 0.405]
            rotation [0, 1, 0, 0]
            emHeight: 0.06
            depth: 0.004
            mode: "emboss"
            material: shellTrim
            align: "center"
            maxWidth: 2.1
          }
        ]
      }
    }
  }
}

placements {
  // The root every row of the building stands under. A world places the building by placing this row.
  placement "gallery" {
    prototype: "place"
    position: gallerySite
  }
  shellPlacements()
  for on in (flawEnabled ? [1] : []) {
    flawPlacement()
  }

  for k in range(0, 4) {
    placement $"hall-switch-{k}" {
      prototype: "hall-switch-on"
      parent: "gallery"
      position [galleryEast, galleryFloor[k], switchZ]
      yawDegrees: 90
      respond [
        {
          when: state(state: hallLights, key: $"level{k}", comparison: Equal, value: 0)
          prototypeId: "hall-switch-off"
        }
      ]
    }
  }
  placement "stair-pendant" {
    prototype: "stair-pendant-on"
    parent: "gallery"
    position: stairPendantAt
    respond [
      {
        when: state(state: hallLights, key: level1, comparison: Equal, value: 0)
        prototypeId: "stair-pendant-off"
      }
    ]
  }

  // Each lift's car: one body, posed every tick by its `lift-ride-<id>`, starting on level 0. Everything the car carries
  // rides the body its placement spawns.
  for car in galleryLifts {
    galleryLiftCar(car: car)
  }
  // Each landing's fixtures stand on its shaft's front, turned to face the landing: the CALL plate and the level display
  // beside the door, the door's leaves in the front, and a board over the door naming the level.
  for landing in galleryLiftLandings {
    galleryLiftLanding(car: filter(galleryLifts, c => (c.id == landing.car))[0], landing: landing)
  }
  // The reaches a press acts in: each landing's CALL plate and each light switch.
  for landing in galleryLiftLandings {
    galleryReach(id: $"lift-pad-{landing.car}-{landing.level}-reach", box: landing.reach)
  }
  for switch in switchReach {
    galleryReach(id: $"{switch.rule}-reach", box: switch)
  }

  // The display stations (shapes.puck): each plinth, its screen, the buttons before its console and the exhibit on its
  // turntable, worked by the displays' rules below.
  displayPlacements()
}

// The building's lights, each anchored to the root: a light stands where the root puts it and, standing still there,
// is traced into the irradiance volume, which bounces its light and occludes it where the probes about a surface
// cannot see it. The flaw (flaw.puck) lights the inside: its tube lights run the whole of its length, each in one
// storey, reading its power from that storey's `hallLamps` cell. Beside it stand only the two lamps a body can see,
// each light standing at its fixture's glowing face in that face's colour and giving what the face shows (look.puck's
// lookCarLamp and lookStairPendant): the south-west stair's pendant, since the flaw never enters that stair's well,
// which its lit prototype carries (`stair-pendant-on`), and each lift car's luminous ceiling, which rides the car's
// body through its shaft, so it is neither traced nor bounced. Every screen lights what stands before it by its own picture
// (toybox.puck), and the windows' daylight is the world's sun. Nothing else lights the building: the coffers' small
// lamps are paint.
render {
  lighting {
    lights: concat(
      // Each car's panel lights the cab below it and not the ceiling it is set in, in the car body's frame (the cab rides
      // `liftRoot` under the body).
      map(galleryLifts, car => spot(
        name: $"hall-lift-{car.id}",
        anchor: placement(placementId: $"lift-car-{car.id}"),
        position: [0, ((carLampFace - liftRoot) - 0.01), 0],
        direction: [0, -1, 0],
        angle: 90deg,
        innerAngle: 75deg,
        color: lookCarLamp.color,
        power: glowSpotPower(lookCarLamp.luminance, ((4 * carLampHalf[0]) * carLampHalf[1]))
      )),
      (flawEnabled ? flawLights(placement(placementId: gallery)) : [])
    )
  }
}

// A spawn on each level's landing, before the north lift's door and facing it, one before each level's light switch,
// facing it, and one inside the board game room, facing along it. Each is authored in the building's frame.
spawnPoints: concat(
  map(
    galleryLevels,
    level => {
      id: $"gallery-level-{level.level}"
      parent: gallery
      position: liftLandingStand(galleryLifts[0], level.level)
      yawDegrees: liftLandingYaw(galleryLifts[0])
    }
  ),
  map(
    galleryLevels,
    level => {
      id: $"hall-switch-{level.level}"
      parent: gallery
      position [(galleryEast - 1.3), galleryFloor[level.level], switchZ]
      yawDegrees: 270
    }
  ),
  [
    { id: "boardroom", parent: gallery, position [bayX(4), galleryFloor[wingLevel], tileZ(1)], yawDegrees: 270 }
    // Outside the entrance, facing in; in each lift's car, facing its door; and on the south-west stair's first half
    // landing, facing across it to the second flight.
    { id: "gallery", parent: gallery, position: entranceOutside, yawDegrees: 270 }
    {
      id: "lift"
      parent: gallery
      position [galleryLifts[0].x, 0.1, galleryLifts[0].z]
      yawDegrees: galleryLifts[0].yaw
    }
    {
      id: "lift-south"
      parent: gallery
      position [galleryLifts[1].x, 0.1, galleryLifts[1].z]
      yawDegrees: galleryLifts[1].yaw
    }
    {
      id: "stairs"
      parent: gallery
      position [
        (galleryStair("south-west").well.x1 - 0.9),
        ((galleryFloor[0] + (galleryStorey / 2)) + 0.05),
        (galleryStair("south-west").well.z0 + (switchbackLanding / 2))
      ]
      yawDegrees: 90
    }
  ]
)

// A car's kit: a sphere of radius 0.1 m that touches nothing in the cab or shaft, with no gravity, so it stands wherever
// `lift-ride` last posed it.
kits [
  {
    name: "lift"
    bodyMotionProgram: "walk"
    collider: sphere(radius: 0.1)
    motion: stillMotion
  }
]

looks [
  {
    motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
    name: "lift-car"
    scale: 1
    source: creation(prototypeId: `lift-hidden`)
  }
]

state {
  // Each shaft: one 3 m column of 1/16 m layers from the ground to level 3, its car's root riding liftRoot over each. Its
  // origin is in the building's frame, which the car's `lift-ride-<id>` reads its cells in.
  lattices [
    for car in galleryLifts {
      box(
        name: $"liftShaft-{car.id}",
        origin: [(car.x - 1.5), 0, (car.z - 1.5)],
        cellSize: 3,
        width: 1,
        depth: 1,
        layers: ((3 * liftCells) + 1),
        layerHeight: 0.0625
      )
    }
  ]

  enum HallLight {
    Off
    On
  }

  enum HallBlind {
    Up
    Down
  }

  world {
    table hallLights: HallLight {
      level0 = On
      level1 = On
      level2 = On
      level3 = On
    }
    // Each level's fan shades, apart from its lights: Down spreads them over the south and east windows, Up gathers
    // each over its hub. The shades' leaves follow these cells (shell.puck's `gallery-fan-<level>`).
    table hallBlinds: HallBlind {
      level0 = Down
      level1 = Up
      level2 = Down
      level3 = Down
    }
    // The inspection lever (`gallery.inspect`), and the exposure hold in EV100 its rules write (zero releases it).
    table galleryInspect: HallLight {
      mode = Off
    }
    table galleryExposure {
      hold = 0
    }
    // Each level's light by the level that owns it (hallLampLevels): zero while its level is Off.
    table hallLamps {
      level0 = lookFlaw.intensity
      level1 = lookFlaw.intensity
      level2 = lookFlaw.intensity
      level3 = lookFlaw.intensity
    }
    // Each car's state, keyed by its `key`.
    table liftAt capacity(liftCars) bounds(0..(3 * liftCells)) = map(galleryLifts, car => 0)
    table liftTarget capacity(liftCars) bounds(0..(3 * liftCells)) = map(galleryLifts, car => 0)
    // The mailbox gallery.lift and the traversal addon write a level to; -1 while empty.
    table liftCall capacity(liftCars) bounds(-1..3) = map(galleryLifts, car => -1)
    table liftLevel capacity(liftCars) bounds(0..3) = map(galleryLifts, car => 0)
    table liftDir capacity(liftCars) bounds(-1..1) = map(galleryLifts, car => 0)
    table liftFloor capacity(liftCars) bounds(0..3) = map(galleryLifts, car => 0)
    table liftArrow capacity(liftCars) bounds(0..2) = map(galleryLifts, car => 0)
    table liftOpenReq capacity(liftCars) bounds(0..1) = map(galleryLifts, car => 0)
    table liftCloseReq capacity(liftCars) bounds(0..1) = map(galleryLifts, car => 0)
    // Each car's landing calls and floor calls pending, a member a car keyed by level.
    table liftHallOf[liftCars] capacity(4) = [0, 0, 0, 0]
    table liftCarCallOf[liftCars] capacity(4) = [0, 0, 0, 0]
    // Each car's door buttons' lamps, and the ticks its dwell and its lamps are due to end.
    table liftLampOpen capacity(liftCars) = map(galleryLifts, car => 0)
    table liftLampClose capacity(liftCars) = map(galleryLifts, car => 0)
    table liftDwell capacity(liftCars) = map(galleryLifts, car => 0)
    table liftPulse capacity(liftCars) = map(galleryLifts, car => 0)
    // Each car's own door, and its landings' doors, a member a car keyed by level: every car starts open on level 0.
    table liftCarDoor capacity(liftCars) = map(galleryLifts, car => 1)
    table liftDoorsOf[liftCars] capacity(4) = [1, 0, 0, 0]
    // Each display's selection and its screen's cells, and every exhibit's copy (shapes.puck).
    displayState()
    slot galleryStop = -1 bounds(-1..galleryLast)
    slot galleryStep = 0 bounds(-1..1)

    // The gallery wheel's sector labels and icons, by sector id (icons rows in controls.puck).
    table galleryWheelLabels {
      next = "Next"
      prev = "Previous"
      flag = "Flag"
      view = "View"
      slice = "Slice"
      entrance = "Entrance"
      cancel = "Cancel"
    }

    table galleryWheelIcons {
      next = "act.next"
      prev = "act.prev"
      flag = "act.flag"
      view = "act.view"
      slice = "act.slice"
      entrance = "act.respawn"
    }
  }
}

// The lifts' rules run in this order, each one rule over every car (`forEach: liftAt`, `$each` the car's key) and each
// seeing the effects of the ones above it in the same tick: calls arrive, a stopped car serves its floor, opens or shuts
// its doors, then picks its next stop, then moves.

// A level written to a car's mailbox becomes a landing call there.
rule "lift-mailbox" {
  forEach: liftAt
  when liftCall[$each] >= 0
  mode: Level
  liftHallOf[$each][liftCall[$each]] = 1
  liftCall[$each] = -1
}

// The context button on a landing's CALL plate calls its car there: one rule a landing over whoever stands in its
// reach, any seated or visiting human.
for landing in galleryLiftLandings {
  rule $"lift-pad-{landing.car}-{landing.level}" {
    when pressing()
    mode: Edge
    forEach: region($"lift-pad-{landing.car}-{landing.level}-reach")
    $"liftHallOf{landing.key}"[landing.level] = 1
  }
}

// The same press in a car, at the button the body stands before: each button's reach rides the car's floor, so only a
// body on it counts.
for car in galleryLifts {
  for pad in filter(carPads, p => p.slot < 4) {
    rule $"lift-car-pad-{car.id}-{pad.slot}" {
      when pressing()
      mode: Edge
      forEach: region($"lift-{car.id}-car-reach-{pad.slot}")
      $"liftCarCallOf{car.key}"[pad.slot] = 1
    }
  }
  rule $"lift-car-pad-{car.id}-open" {
    when pressing()
    mode: Edge
    forEach: region($"lift-{car.id}-car-reach-4")
    liftLampOpen[car.key] = 1
    schedule liftPulse[car.key] in 0.4s
    liftOpenReq[car.key] = 1
  }
  rule $"lift-car-pad-{car.id}-close" {
    when pressing()
    mode: Edge
    forEach: region($"lift-{car.id}-car-reach-5")
    liftLampClose[car.key] = 1
    schedule liftPulse[car.key] in 0.4s
    liftCloseReq[car.key] = 1
  }
}

// A car stopped at a level with a call pending there serves it: the call clears and the doors are asked to open.
rule "lift-serve" {
  forEach: liftAt
  local floor = liftAt[$each] / liftCells
  when (liftAt[$each] % liftCells) == 0 and liftTarget[$each] == liftAt[$each] and (
      liftHallOf[$each][floor] + liftCarCallOf[$each][floor]
    ) > 0
  mode: Level
  liftHallOf[$each][floor] = 0
  liftCarCallOf[$each][floor] = 0
  liftOpenReq[$each] = 1
}

// Opening the doors, or holding them, starts the dwell afresh.
rule "lift-open" {
  forEach: liftAt
  local floor = liftAt[$each] / liftCells
  when (liftAt[$each] % liftCells) == 0 and liftTarget[$each] == liftAt[$each] and liftOpenReq[$each] == 1
  mode: Level
  liftLevel[$each] = floor
  liftCarDoor[$each] = 1
  liftDoorsOf[$each][floor] = 1
  schedule liftDwell[$each] in 4s
  liftOpenReq[$each] = 0
}
rule "lift-open-moving" {
  forEach: liftAt
  when liftOpenReq[$each] == 1 and liftTarget[$each] != liftAt[$each]
  mode: Level
  liftOpenReq[$each] = 0
}

// Closing the doors ends the dwell; a moving car's doors are shut already.
rule "lift-shut" {
  forEach: liftAt
  when liftCloseReq[$each] == 1 and liftTarget[$each] == liftAt[$each]
  mode: Level
  liftCarDoor[$each] = 0
  for k in range(0, 4) {
    liftDoorsOf[$each][k] = 0
  }
  liftDwell[$each] = $tick
  liftCloseReq[$each] = 0
}
rule "lift-shut-moving" {
  forEach: liftAt
  when liftCloseReq[$each] == 1 and liftTarget[$each] != liftAt[$each]
  mode: Level
  liftCloseReq[$each] = 0
}

// A stopped car whose dwell is over picks its next stop. Going up (or idle) it takes the nearest pending level above
// and then, if none, the nearest below, turning round; going down it does the reverse. `above<k>` is the nearest
// pending level above the car from level k up, `below<k>` the nearest below it under level k, -1 where none is.
rule "lift-pick" {
  forEach: liftAt
  local at = liftAt[$each]
  local floor = at / liftCells
  for k in range(0, 4) {
    local $"pending{k}" = (liftHallOf[$each][k] + liftCarCallOf[$each][k]) > 0
  }
  local above4 = -1
  for k in [3, 2, 1, 0] {
    local $"above{k}" = ((k > floor) and $"pending{k}") ? k : $"above{k + 1}"
  }
  local below0 = -1
  for k in range(0, 4) {
    local $"below{k + 1}" = ((k < floor) and $"pending{k}") ? k : $"below{k}"
  }
  local next = (liftDir[$each] >= 0) ? ((above0 >= 0) ? above0 : below4) : ((below4 >= 0) ? below4 : above0)
  when ((at % liftCells) == 0 and
    liftTarget[$each] == at and
    $tick >= liftDwell[$each] and
    liftOpenReq[$each] == 0 and
    next >= 0)
  mode: Level
  liftDir[$each] = (next > floor) ? 1 : -1
  liftTarget[$each] = next * liftCells
}

// A stopped car with its dwell over and nothing to serve has no direction.
rule "lift-idle" {
  forEach: liftAt
  when liftTarget[$each] == liftAt[$each] and $tick >= liftDwell[$each] and liftOpenReq[$each] == 0 and liftDir[$each]
  mode: Level
  liftDir[$each] = 0
}

// A stop lying ahead of a moving car, nearer than its target, is taken on the way: `up<k>` is the nearest pending level
// between the car and its target from level k up, `down<k>` the nearest under level k between them.
rule "lift-stop-ahead" {
  forEach: liftAt
  local at = liftAt[$each]
  local target = liftTarget[$each]
  for k in range(0, 4) {
    local $"pending{k}" = (liftHallOf[$each][k] + liftCarCallOf[$each][k]) > 0
  }
  local up4 = -1
  for k in [3, 2, 1, 0] {
    local $"up{k}" = (((k * liftCells) > at) and ((k * liftCells) < target) and $"pending{k}") ? k : $"up{k + 1}"
  }
  local down0 = -1
  for k in range(0, 4) {
    local $"down{k + 1}" = (((k * liftCells) < at) and ((k * liftCells) > target) and $"pending{k}") ? k : $"down{k}"
  }
  local stop = (target > at) ? up0 : ((target < at) ? down4 : -1)
  when stop >= 0
  mode: Level
  liftTarget[$each] = stop * liftCells
}

rule "lift-rise" {
  forEach: liftAt
  when liftTarget[$each] > liftAt[$each] and liftCarDoor[$each] == 0
  mode: Level
  liftAt[$each] += 1
}

rule "lift-fall" {
  forEach: liftAt
  when liftTarget[$each] < liftAt[$each] and liftCarDoor[$each] == 0
  mode: Level
  liftAt[$each] = liftAt[$each] - 1
}

for car in galleryLifts {
  rule $"lift-ride-{car.id}" {
    when liftAt[car.key] >= 0
    mode: Level
    poseCell(
      key: $"placement:lift-car-{car.id}",
      topology: $"liftShaft-{car.id}",
      expression: liftAt[car.key],
      offset: [0, liftRoot, 0],
      glide: true,
      frame: gallery
    )
  }
}

// Departure closes the car and every landing before the car moves.
rule "lift-close" {
  forEach: liftAt
  when liftTarget[$each] != liftAt[$each]
  mode: Level
  liftCarDoor[$each] = 0
  for k in range(0, 4) {
    liftDoorsOf[$each][k] = 0
  }
}

// The door buttons' lamps go out after a moment.
rule "lift-lamps-out" {
  forEach: liftAt
  when $tick >= liftPulse[$each] and (liftLampOpen[$each] + liftLampClose[$each]) > 0
  mode: Level
  liftLampOpen[$each] = 0
  liftLampClose[$each] = 0
}

// The displays show the level the car is at or last passed (going down, the level it has not yet reached below), and
// an arrow for its direction.
rule "lift-floor-down" {
  forEach: liftAt
  when liftDir[$each] < 0
  mode: Level
  liftFloor[$each] = (liftAt[$each] + liftCells - 1) / liftCells
}
rule "lift-floor" {
  forEach: liftAt
  when liftDir[$each] >= 0
  mode: Level
  liftFloor[$each] = liftAt[$each] / liftCells
}
rule "lift-arrow" {
  forEach: liftAt
  when liftDir[$each] >= 0
  mode: Level
  liftArrow[$each] = liftDir[$each]
}
rule "lift-arrow-down" {
  forEach: liftAt
  when liftDir[$each] < 0
  mode: Level
  liftArrow[$each] = 2
}

// A press of the context button in a switch's reach flips that level's lights; the reach stands before the plate, so
// standing there puts the plate ahead of the body. The edge fires once a press.
for reach in switchReach {
  rule $"{reach.rule}" {
    when pressing()
    mode: Edge
    forEach: region($"{reach.rule}-reach")
    hallLights[$"level{reach.level}"] = 1 - hallLights[$"level{reach.level}"]
  }
}

// A level's lights follow its state.
for lamp in hallLampLevels {
  rule $"hall-lamp-{lamp.key}-on" {
    when hallLights[$"level{lamp.level}"] == 1
    mode: Edge
    hallLamps[$"{lamp.key}"] = lamp.value
  }
  rule $"hall-lamp-{lamp.key}-off" {
    when hallLights[$"level{lamp.level}"] == 0
    mode: Edge
    hallLamps[$"{lamp.key}"] = 0
  }
}

// The inspection lever: On pins the camera at one exposure, so captures of different exhibits compare at one EV; Off
// releases it to the automatic exposure. It adds no light: every exhibit is lit by the building's own lights alone.
rule "gallery-inspect-on" {
  when galleryInspect[$"mode"] == 1
  mode: Edge
  galleryExposure[$"hold"] = inspectHold
}
rule "gallery-inspect-off" {
  when galleryInspect[$"mode"] == 0
  mode: Edge
  galleryExposure[$"hold"] = 0
}

// One camera per bookmarked viewpoint (look.puck's lookShots), its eye and aim placed from the building's site when the
// document compiles; `gallery.shot` selects one. The displays' station views are the station's own (shapeStation).
cameras: map(lookShots, view => {
  name: $"gallery-shot-{view.name}"
  rig {
    name: $"gallery-shot-{view.name}"
    version: "puck.camera.program.v1"
    operations [
      { $type: "anchor", subject { $type: "worldPoint", point: galleryWorld(view.eye[0], view.eye[1], view.eye[2]) } }
      { $type: "lookAt", subject { $type: "worldPoint", point: galleryWorld(view.aim[0], view.aim[1], view.aim[2]) } }
      { $type: "fieldOfView", fieldOfViewRadians: (view.fov * 0.017453293) }
    ]
  }
  renderWidth: 1672
  renderHeight: 941
})

// The twelve display stations (shape-station.puck): their station views, terminals, console rules and commands, over the
// state and placements shapes.puck gives them. Every display is a terminal, and the backtick turns its screen into its
// hidden console. Level 3's portal panels (portals.puck) are terminals too, numbered after the displays.
shapeStation(terminals: panelTerminals(galleryPanels))

commands [
  {
    name: "gallery.inspect"
    help: "Switches the gallery's inspection exposure On or Off: On pins the camera at EV100 7, so captures of different exhibits compare at one exposure; Off releases it to the automatic exposure. It adds no light; the building's own lights (gallery.lights, gallery.blinds) light every exhibit."
    parameters [
      { name: "state", kind: Choice, values ["On", "Off"], default: "On" }
    ]
    lines [
      "world.state.cell.set galleryInspect mode {state}"
    ]
  }
  {
    name: "gallery.lights"
    help: "Switches a level's room lights in the gallery hall (0 to 3) on or off, as its wall switch does: off quiets the light of the stretch of the flaw that level holds, and its lamps."
    parameters [
      { name: "level", kind: Choice, values ["0", "1", "2", "3"] }
      { name: "state", kind: Choice, values ["On", "Off"] }
    ]
    lines [
      "world.state.cell.set hallLights level{level} {state}"
    ]
  }
  {
    name: "gallery.shot"
    help: "Films the gallery from a bookmarked viewpoint (look.puck's lookShots): hall is the level-zero hall painting's, hall-side its second angle, and the rest face what a kit sheet draws. view.override camera auto returns to the chase camera."
    parameters [
      { name: "shot", kind: Choice, values: map(lookShots, shot => shot.name), default: "hall" }
    ]
    lines [
      "view.override camera gallery-shot-{shot}"
    ]
  }
  {
    name: "gallery.time"
    help: "Moves the day to a fraction, noon by default (look.puck's lookNoon; lookAfternoon is the warmer reading the look is also judged at). The day still advances: hold it with world.row.set state day advance, as debug.md's time of day gives it."
    parameters [
      { name: "day", kind: Number, default: $"{lookNoon}" }
    ]
    lines [
      "world.state.cell.set day $value {day}"
    ]
  }
  {
    name: "gallery.blinds"
    help: "Spreads or gathers a level's fan shades in the gallery (0 to 3): Down spreads them over the south and east windows, Up, the default, gathers each over its hub and lets the windows light the level."
    parameters [
      { name: "level", kind: Choice, values ["0", "1", "2", "3"] }
      { name: "state", kind: Choice, values ["Up", "Down"] }
    ]
    lines [
      "world.state.cell.set hallBlinds level{level} {state}"
    ]
  }
  {
    name: "gallery.lift"
    help: "Calls one of the gallery hall's glass lifts to a level (0 to 3), as its landing's CALL button does: the level, then the car (0 the north lift, the default, 1 the south). Ride it by standing in the car."
    parameters [
      { name: "level", kind: Choice, values ["0", "1", "2", "3"] }
      { name: "car", kind: Choice, values: map(galleryLifts, car => $"{car.key}"), default: "0" }
    ]
    lines [
      "world.state.cell.set liftCall {car} {level}"
    ]
  }
  {
    name: "gallery.level"
    help: "Stands a body on a level's landing in the gallery hall (0 to 3), before the north lift's door."
    parameters [
      { name: "level", kind: Choice, values ["0", "1", "2", "3"], default: "0" }
      { name: "body", kind: Body, default: "0" }
    ]
    lines [
      "body.pose spawn:gallery-level-{level} {body}"
      "view.override camera auto"
      "view.override layout play"
    ]
  }
]

rule "gallery-next" {
  when galleryStep == 1
  mode: Level
  galleryStop = (galleryStop + 1) % (galleryLast + 1)
  galleryStep = 0
}

rule "gallery-prev" {
  when galleryStep == -1 and galleryStop > 0
  mode: Level
  galleryStop = galleryStop - 1
  galleryStep = 0
}

rule "gallery-prev-wrap" {
  when galleryStep == -1 and galleryStop <= 0
  mode: Level
  galleryStop = galleryLast
  galleryStep = 0
}

for entry in galleryCatalog {
  rule $"gallery-stop-{entry.index}" {
    when galleryStop == entry.index
    mode: Edge
    pose(key: 0, spawnPoint: entry.name)
    gallerySelect[$"{galleryGroupOf(entry).id}"] = entry.index
  }
}

commands [
  {
    name: "gallery.next"
    help: "Stands body 0 at the next exhibit of the tour, in walking order (level by level, row by row); after the last it wraps to the first."
    lines [
      "world.state.cell.set galleryStep $value 1"
    ]
  }
  {
    name: "gallery.prev"
    help: "Stands body 0 at the previous exhibit of the tour; before the first it wraps to the last."
    lines [
      "world.state.cell.set galleryStep $value -1"
    ]
  }
]

// The gallery's keys, on the debug world's own resting page: = steps the tour on, - steps it back, G flags the
// exhibit the seat stands at, V steps the debug view and B slices the exhibit at hand. Holding Q opens the gallery
// wheel, aimed with the mouse and committed on release, as Tab opens the play wheel. A pad reaches the tour through the
// bar's Tour page (pad.puck); its right shoulder is the context button. The garden shares the Moth's base page and has
// no gallery, so these live here.
bindingOverlays [
  {
    id: "gallery-keys"
    document {
      version: "puck.input.bindings.v1"
      modifiers []
      chords [
        {
          chord ["keyboard.q"]
          group: "play"
          page {
            id: "gallery-wheel-keys"
            inherits: "base"
            label: "Gallery"
            entries [
              {
                command: "player.wheel.select"
                sources ["mouse.motion"]
              }
              {
                command: "player.wheel.commit"
                activateOn: Completed
                sources ["keyboard.q"]
              }
            ]
          }
        }
        {
          chord []
          group: "play"
          page {
            id: "base"
            entries [
              {
                command: "gallery.next"
                id: "galleryNext"
                label: "Next exhibit"
                sources ["keyboard.equals"]
              }
              {
                command: "gallery.prev"
                id: "galleryPrev"
                label: "Previous exhibit"
                sources ["keyboard.minus"]
              }
              {
                command: "gallery.flag"
                id: "galleryFlag"
                label: "Flag exhibit"
                sources ["keyboard.g"]
              }
              {
                command: "gallery.view"
                id: "galleryView"
                label: "Debug view"
                sources ["keyboard.v"]
              }
              {
                command: "gallery.slice"
                id: "gallerySlice"
                label: "Slice exhibit"
                sources ["keyboard.b"]
              }
            ]
          }
        }
      ]
      wheels [
        {
          id: "gallery"
          group: "play"
          holdPages ["gallery-wheel-keys"]
          labelRow: "state.galleryWheelLabels"
          iconRow: "state.galleryWheelIcons"
          style {
            placement: ViewportCenter
          }
          rings [
            {
              id: "gallery-acts"
              label: "Gallery"
              entries [
                { id: "next", command: "gallery.next", sources: null }
                { id: "prev", command: "gallery.prev", sources: null }
                { id: "flag", command: "gallery.flag", sources: null }
                { id: "view", command: "gallery.view", sources: null }
                { id: "slice", command: "gallery.slice", sources: null }
                { id: "entrance", command: "gallery.go", sources: null }
              ]
            }
          ]
        }
      ]
    }
  }
]
