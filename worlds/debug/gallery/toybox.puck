// Level 1's toybox: arcade cabinets on both galleries, facing the nave across its void, each screen a hosted machine
// running one of the world's shipped cartridges, so a player on any other level looks across into live game screens
// even when the floor is empty. The gallery module imports this, so the gallery booted alone (gallery-root.puck) and
// the debug world both host the machines; their names are this document's own, apart from the Wonderland devices'
// (devices.puck).
//
// The two cabinets in a bay play one game across the nave, each on its own hardware: the tetromino game on a Color
// brick and on a monochrome one, the deck's bouncing ball on two decks, and the drifting test card on an Advanced brick
// and on a monochrome brick. Each cartridge moves by itself on its attract screen, so the screens flicker with no one
// playing: the tetromino game's title chases its colours through PRESS START, the ball bounces and the bars drift. Walk
// up to a cabinet and press the context button (E, or RB on a pad) to play it, as at a Wonderland device.
//
// The bays, rows and facing are layout.puck's (`toyboxBays`, `toyboxRows`), the cabinet's form the standard's
// (architecture.puck's arcadeCabinet), and its colours and the screens' luminance look.puck's.

import "../../standard/architecture"
import "../../standard/machines"
import "layout"
import "look"

// The screens' indices: the debug world's other screens hold 0 to 17 (devices.puck, range.puck, alchemy.puck,
// chess.puck, desktop.puck, granaries.puck), so the toybox's start at 20.
let toyboxScreen = 20

// The games, one colourway (look.puck's lookCabinets) and one marquee each.
let toyboxGames = [
  { id: "tetromino", title: "TETROMINO" }
  { id: "bounce", title: "BOUNCE" }
  { id: "test-card", title: "TEST CARD" }
]

// Each cabinet: its game, the bay it stands in (an index into toyboxBays) and the gallery (an index into toyboxRows,
// south then north), the machine its screen shows, that machine's picture and the route a seat plays it through. A
// machine's content path resolves beside this file.
let toyboxCabinets = [
  {
    id: "tetromino", game: 0, bay: 0, side: 0, video: brickVideo, route: deviceRoute
    machine: brickMachine("toybox-tetromino", "../cartridges/cgb/tetromino.cgb.puck")
  }
  {
    id: "tetromino-mono", game: 0, bay: 0, side: 1, video: brickVideo, route: deviceRoute
    machine: brickMachine("toybox-tetromino-mono", "../cartridges/dmg/tetromino.dmg.puck", "dmg")
  }
  {
    id: "bounce", game: 1, bay: 1, side: 0, video: deckVideo, route: deckRoute
    machine: deckMachine("toybox-bounce", "../cartridges/deck/moving-sprite.deck")
  }
  {
    id: "bounce-north", game: 1, bay: 1, side: 1, video: deckVideo, route: deckRoute
    machine: deckMachine("toybox-bounce-north", "../cartridges/deck/moving-sprite.deck")
  }
  {
    id: "test-card", game: 2, bay: 2, side: 0, video: advancedBrickVideo, route: deviceRoute
    machine: advancedBrickMachine("toybox-test-card", "../cartridges/agb/test-card.agb.puck")
  }
  {
    id: "test-card-mono", game: 2, bay: 2, side: 1, video: brickVideo, route: deviceRoute
    machine: brickMachine("toybox-test-card-mono", "../cartridges/dmg/test-card.dmg.puck", "dmg")
  }
]

// Where a cabinet stands in the building's frame, on its tile.
function toyboxAt(c) = [bayX(toyboxBays[c.bay]), galleryFloor[toyboxLevel], tileZ(toyboxRows[c.side].row)]

prototypes {
  for (game, g) in toyboxGames {
    prototype $"toybox-cabinet-{game.id}" {
      document {
        name: $"toybox-cabinet-{game.id}"
        schema: "puck.creation.v1"
        palette: lookCabinetPalette(lookCabinets[g])
        arcadeCabinet(base: 0, title: game.title)
      }
    }
  }
}

placements {
  for c in toyboxCabinets {
    placement $"toybox-cabinet-{c.id}" {
      prototype: $"toybox-cabinet-{toyboxGames[c.game].id}"
      parent: "gallery"
      position: toyboxAt(c)
      yawDegrees: toyboxRows[c.side].yaw
      solid
    }
  }
}

machines: map(toyboxCabinets, c => c.machine)

// Each picture stands upright in its cabinet's bezel, its glass exactly the machine's picture at the largest size the
// bezel frames. A screen's frame is in the world's, so it is placed from the building's site (galleryWorld), as the
// gallery's other world-space pieces are. A cabinet facing +z (the south gallery's) has the picture's right along +x,
// one facing -z along -x.
screens [
  for (c, i) in toyboxCabinets {
    let at = toyboxAt(c)
    let facing = toyboxRows[c.side].facing
    let half = cabinetPictureHalves(videoAspect(c.video))
    {
      index: (toyboxScreen + i)
      origin: galleryWorld(at[0], (at[1] + cabinetPicture[1]), (at[2] + (facing * cabinetPicture[2])))
      right [facing, 0, 0]
      up [0, 1, 0]
      halfWidth: half[0]
      halfHeight: half[1]
      halfDepth: 0.004
      round: 0
      source: machine(instance: c.machine.name, output: "video")
      luminance: lookCabinetLuminance
      material: crt
      route: c.route
    }
  }
]

kits [devicePadKit]
