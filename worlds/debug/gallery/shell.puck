// The gallery's shell: its walls, floors, roof, stairs, lift tower, forecourt and the kit pieces that stand on them, as
// templates gallery.puck expands in its `prototypes` and `placements` blocks. A module library: it emits no document.
// The plan and its dimensions are layout.puck's; every bound below is in the building's frame, and every placement
// stands under the root placement `gallery`.
//
// A creation bakes on a lattice its own size sets, so the shell is cut where detail needs a finer one: each storey's
// walls and each floor are a flat creation of boxes, and whatever carries small form (a window bay, a pier, a length of
// balustrade, a planter) is a kit piece from the standard's architecture library, baked once and stamped wherever the
// plan repeats it. Solid pieces are unions of boxes, so a body meets each as an exact box.

import "../../standard/bounds"
import "../../standard/architecture"
import "../shapes"
import "layout"
import "look"

// The shell's materials: the hall's warm cream walls and ceiling, terracotta floor and deep teal trim, then the ochre
// cladding and cream bands of the outside, the building's glass, brass and the forecourt's paving. `pads` are the paints
// that inlay a level's cream pads into its floor. The building's light is the flaw's (flaw.puck), so no slab carries a
// fixture of its own.
let shellWall = 0
let shellFloor = 1
let shellTrim = 2
let shellBoard = 3
let shellCeiling = 4
let shellCarLight = 5
let shellOchre = 6
let shellCream = 7
let shellGlass = 8
let shellBrass = 9
let shellPaving = 10
// A floor north of the nave's centre line is a second slot of the same tile, since a slot draws eight paints and a level
// holds more pads than that leaves beside its tiles and joints.
let shellFloorNorth = 11
// The floor is terracotta tiles with a narrow joint (the kit's floor-and-ceiling sheet; look.puck holds the sizes and
// colours): the slot's colour is the grout's, and one box paint a joint smaller than its cell repeats over it, each
// tile's tone varied between two clays. The ceiling is coffered on the same module: a paler square in each cell with a
// small lamp at its centre. Both lattices stand in the world's frame, as a static creation's paints do, with a joint
// down the nave's centre line.
let shellTileHalf = (galleryTile / 2)
let shellTileCell = [galleryTile, 0, galleryTile]
let shellTileCentre = galleryWorld(naveWest, 0, arcadeSouth)
function shellTiles(look) = {
  type: "Box"
  position: shellTileCentre
  scale [(shellTileHalf - (lookTileJoint / 2)), 40, (shellTileHalf - (lookTileJoint / 2))]
  color: look.tile
  repeat { cell: shellTileCell, tone: look.tileTone, seed: 7 }
}
// The joints again, drawn over the pads so a pad reads as tiles of another clay rather than a sheet laid on the floor.
let shellJoints = [
  {
    type: "Box"
    position [(shellTileCentre[0] + shellTileHalf), 0, shellTileCentre[2]]
    scale [(lookTileJoint / 2), 40, shellTileHalf]
    color: lookPadJoint
    repeat { cell: shellTileCell }
  }
  {
    type: "Box"
    position [shellTileCentre[0], 0, (shellTileCentre[2] + shellTileHalf)]
    scale [shellTileHalf, 40, (lookTileJoint / 2)]
    color: lookPadJoint
    repeat { cell: shellTileCell }
  }
]
function shellCoffers(look) = [
  {
    type: "Box"
    position: shellTileCentre
    scale [(shellTileHalf - 0.11), 40, (shellTileHalf - 0.11)]
    rounding: 0.08
    color: look.coffer
    repeat { cell: shellTileCell, tone: look.cofferTone, seed: 3 }
  }
  {
    type: "Cylinder"
    position: shellTileCentre
    scale [0.085, 40, 0.085]
    color: lookCofferLamp
    repeat { cell: shellTileCell }
  }
]
// The building's surfaces are brushed (the standard's `brushed`; look.puck holds the amounts): each large face drifts a
// few hundredths in value over patches a couple of metres across and leans warm where it lifts, so a wall, a pier or a
// floor reads as laid by hand and no face is one flat value. One program serves every row that asks for the same drift.
function shellBrushed(base, amount = lookBrush, scale = lookBrushScale) = galleryCel((base with { shade: brushed(amount, scale, lookBrushLean, lookBrushSeed) }))
// A floor slot's paints: the tiles, the pads on its side of the nave's centre line, and the joints over both.
let shellMidWorld = galleryWorld(0, 0, naveMid)[2]
function shellFloorPaints(pads, north, look) = concat(
  [shellTiles(look)],
  filter(pads, pad => ((north == 1) ? (pad.position[2] >= shellMidWorld) : (pad.position[2] < shellMidWorld))),
  shellJoints
)
// The floor is glazed tile: smooth enough that the windows and the lit ceiling lie on it as the room's reflection.
// A palette's floor, walls and fascia wear `level`'s look (look.puck's lookLevels) and its ceiling `below`'s, since a
// slab's underside is the ceiling of the level under it.
function shellFloorRow(look) = { color: look.grout, roughness: lookFloorRoughness, specular: lookFloorSpecular }
function shellPalette(pads, level = 0, below = 0) = [
  shellBrushed({ color: lookLevels[level].wall, roughness: 0.85, specular: 0.04 })
  shellBrushed((shellFloorRow(lookLevels[level]) with { paints: shellFloorPaints(pads, 0, lookLevels[level]) }), lookBrushFloor, lookBrushFloorScale)
  shellBrushed({ color: lookTeal, roughness: 0.6, specular: 0.04 })
  shellBrushed({ color: lookBoard, roughness: 0.6 })
  shellBrushed({ color: lookLevels[below].ceiling, roughness: 0.9, specular: 0.02, paints: shellCoffers(lookLevels[below]) }, lookBrushCeiling)
  { color: lookCarLamp.color, roughness: 0.5, emissive: lookCarLamp.luminance }
  shellBrushed({ color: lookOchre, roughness: 0.6, specular: 0.04 }, lookBrushCladding)
  shellBrushed({ color: lookLevels[level].cream, roughness: 0.6, specular: 0.04 })
  { color: lookGlass, roughness: 0.03, glass { depth: 0.04, ior: 1.5 } }
  { color: lookBrass, roughness: 0.3, metal: 1 }
  shellBrushed({ color: lookPaving, roughness: 0.6, specular: 0.04 }, lookBrushFloor, lookBrushFloorScale)
  shellBrushed((shellFloorRow(lookLevels[level]) with { paints: shellFloorPaints(pads, 1, lookLevels[level]) }), lookBrushFloor, lookBrushFloorScale)
]
let shellPlain = shellPalette([])
// The kit's palettes in the gallery's cel style; glass and brass keep their own shading.
let shellKit = map(
  range(0, length(kitPalette)),
  i => (((i == kitGlass) or (i == kitBrass)) ? (kitPalette[i] with { color: lookKit[i] }) : shellBrushed((kitPalette[i] with { color: lookKit[i] })))
)
let shellStructure = [shellBrushed((structurePalette[0] with { color: lookTeal }), lookBrushStructure), (structurePalette[1] with { color: lookBrass })]

// A level's cream pads: one under each display on it, a square of `lookPadTiles` by `lookPadTiles` floor tiles
// centred on the display, which stands on a tile's centre, so the pad's edges run down the grout lines. A paint on a
// static creation is placed in the world's frame.
function shellPad(display) = {
  type: "Box"
  position: galleryWorld(display.x, displayFloor(display), display.z)
  scale [((lookPadTiles * galleryTile) / 2), 0.2, ((lookPadTiles * galleryTile) / 2)]
  color: lookPad
}
function shellPads(level) = map(filter(galleryDisplays, display => (display.level == level)), display => shellPad(display))

// The window bays, one row a bay: its level, the face it stands in and its centre along that face. A face's wall leaves
// each its opening, and a kit bay stands in it.
function shellBay(level, face, at) = { level: level, face: face, at: at }
let shellBays = flatMap(range(0, 4), k => concat(
  map(((k < 3) ? southBaysWest : []), at => shellBay(k, "south", at)),
  map(((k == 1) ? concat([((entranceWest + entranceEast) / 2)], southBaysEast) : []), at => shellBay(k, "south", at)),
  map(((k >= wingLevel) ? wingBays : []), at => shellBay(k, "wing", at)),
  map(northBays, at => shellBay(k, "north", at)),
  map(westBays[k], at => shellBay(k, "west", at)),
  map(concat(((k >= wingLevel) ? [-2] : []), eastBays[k]), at => shellBay(k, "east", at))
))
function shellFaceBays(level, face) = map(
  filter(shellBays, bay => ((bay.level == level) and (bay.face == face))),
  bay => bay.at
)
function bayOpening(at) = {
  a0: (at - (bayWidth / 2))
  a1: (at + (bayWidth / 2))
  y0: (baySill + 0.05)
  y1: ((baySill + 0.05) + bayHeight)
}
// A tall bay crosses two storeys: the lower storey's wall opens from the sill to its top, the upper's from its base.
function tallOpening(level, at) = {
  a0: (at - (tallBayWidth / 2))
  a1: (at + (tallBayWidth / 2))
  y0: (((level % 2) == 0) ? (baySill + 0.05) : 0)
  y1: (((level % 2) == 0) ? galleryStorey : (((baySill + 0.05) + tallBayHeight) - galleryStorey))
}
// Where a bay's kit piece stands in plan, `out` metres outside its wall's centre plane, and the yaw that turns its
// outside out of each face.
function shellBayAt(face, at, out) = (
  (face == "south") ? [at, ((galleryWall / 2) - out)] :
  (face == "wing") ? [at, ((wingSouth + (galleryWall / 2)) - out)] :
  (face == "north") ? [at, ((galleryDepth - (galleryWall / 2)) + out)] :
  (face == "west") ? [((galleryWestOut + (galleryWall / 2)) - out), at] :
  [((galleryWidth - (galleryWall / 2)) + out), at]
)
function shellBayYaw(face) = (
  ((face == "south") or (face == "wing")) ? 0 : (face == "north") ? 180 : (face == "west") ? 90 : 270
)
// The faces the sun reaches carry fan shades: the south, the projecting wing's and the east.
let shellShaded = filter(shellBays, bay => ((bay.face != "north") and (bay.face != "west")))

// The openings of the south wall's core: the lift's door and the entrance.
let liftDoorway = { a0: (liftX - 0.9), a1: (liftX + 0.9), y0: 0, y1: 2.7 }
let entranceDoorway = { a0: entranceWest, a1: entranceEast, y0: 0, y1: (entranceTop + 0.05) }

// A wall's two skins: ochre cladding outside and the hall's cream inside, `skin` of the wall's thickness the cladding.
let shellSkin = 0.12
// How far under an upper level's floor the fascia round its balcony edges hangs, in metres.
let shellFascia = 0.6

// One storey's walls. The south face holds the core's openings; on the projecting wing's storeys it stops at the wing,
// whose own south face stands 4 m out, and on the top storey it starts where the terrace ends.
function shellSouthWall(level) = {
  x0: ((level == 3) ? (terraceEast - galleryWall) : galleryWestOut)
  x1: ((level >= wingLevel) ? wingWest : galleryWidth)
}
template shellWalls(level) {
  for skin in [
    { name: "out", near: 0, far: shellSkin, slot: shellOchre }
    { name: "in", near: shellSkin, far: galleryWall, slot: shellWall }
  ] {
    wallAlongX(
      label: $"south-{skin.name}",
      x0: shellSouthWall(level).x0,
      x1: shellSouthWall(level).x1,
      y0: (galleryStorey * level),
      y1: (galleryStorey * (level + 1)),
      z0: skin.near,
      z1: skin.far,
      openings: concat(
        map(filter(shellFaceBays(level, "south"), at => (at < liftX)), at => bayOpening(at)),
        [liftDoorway],
        ((level == 0) ? [entranceDoorway] : []),
        map(filter(shellFaceBays(level, "south"), at => (at > liftX)), at => bayOpening(at))
      ),
      slot: skin.slot
    )
    wallAlongX(
      label: $"north-{skin.name}",
      x0: galleryWestOut,
      x1: galleryWidth,
      y0: (galleryStorey * level),
      y1: (galleryStorey * (level + 1)),
      z0: (galleryDepth - skin.far),
      z1: (galleryDepth - skin.near),
      openings: map(shellFaceBays(level, "north"), at => bayOpening(at)),
      slot: skin.slot
    )
    wallAlongZ(
      label: $"west-{skin.name}",
      x0: (galleryWestOut + skin.near),
      x1: (galleryWestOut + skin.far),
      y0: (galleryStorey * level),
      y1: (galleryStorey * (level + 1)),
      z0: ((level == 3) ? terraceNorth : galleryWall),
      z1: galleryNorth,
      openings: map(shellFaceBays(level, "west"), at => bayOpening(at)),
      slot: skin.slot
    )
    wallAlongZ(
      label: $"east-{skin.name}",
      x0: (galleryWidth - skin.far),
      x1: (galleryWidth - skin.near),
      y0: (galleryStorey * level),
      y1: (galleryStorey * (level + 1)),
      z0: ((level >= wingLevel) ? (wingSouth + galleryWall) : galleryWall),
      z1: galleryNorth,
      openings: concat(
        map(filter(shellFaceBays(level, "east"), at => (at < naveSouth)), at => bayOpening(at)),
        map(((level < 2) ? tallBayZs : []), at => tallOpening(level, at)),
        map(filter(shellFaceBays(level, "east"), at => (at > naveNorth)), at => bayOpening(at))
      ),
      slot: skin.slot
    )
    for wing in ((level >= wingLevel) ? [1] : []) {
      wallAlongX(
        label: $"wing-{skin.name}",
        x0: wingWest,
        x1: galleryWidth,
        y0: (galleryStorey * level),
        y1: (galleryStorey * (level + 1)),
        z0: (wingSouth + skin.near),
        z1: (wingSouth + skin.far),
        openings: map(shellFaceBays(level, "wing"), at => bayOpening(at)),
        slot: skin.slot
      )
      boundsBox(
        label: $"wing-west-{skin.name}",
        x0: (wingWest + skin.near),
        x1: (wingWest + skin.far),
        y0: (galleryStorey * level),
        y1: (galleryStorey * (level + 1)),
        z0: (wingSouth + galleryWall),
        z1: 0,
        slot: skin.slot
      )
    }
    // The top storey's walls round the terrace: one between the nave's bridge and the terrace and one between the
    // terrace and the south gallery, each with a doorway onto it. The bridge's wall stands just north of the south-west
    // stair's well, so a second doorway there takes the stair's last flight on through to the bridge, east of the end
    // pier's tile.
    if (level == 3) {
      wallAlongX(
        label: $"terrace-{skin.name}",
        x0: galleryWestOut,
        x1: terraceEast,
        y0: (galleryStorey * level),
        y1: (galleryStorey * (level + 1)),
        z0: ((terraceNorth - galleryWall) + skin.near),
        z1: ((terraceNorth - galleryWall) + skin.far),
        openings: [
          { a0: tileEdgeX(1), a1: (tileEdgeX(1) + 2), y0: 0, y1: 2.75 }
          { a0: 5, a1: 7.2, y0: 0, y1: 2.75 }
        ],
        slot: skin.slot
      )
      wallAlongZ(
        label: $"terrace-east-{skin.name}",
        x0: ((terraceEast - galleryWall) + skin.near),
        x1: ((terraceEast - galleryWall) + skin.far),
        y0: (galleryStorey * level),
        y1: (galleryStorey * (level + 1)),
        z0: galleryWall,
        z1: (terraceNorth - galleryWall),
        openings: [{ a0: (terraceNorth - 2.7), a1: (terraceNorth - 0.5), y0: 0, y1: 2.75 }],
        slot: skin.slot
      )
    }
  }
}

// A slab or roof piece: the floor finish on top and a ceiling finish under it, two boxes stacked into the one slab, so
// the ceiling bounces the room's light back down.
template shellSlab(label, x0, x1, y0, y1, z0, z1, top = shellFloor) {
  boundsBox(label: $"{label}-ceiling", x0: x0, x1: x1, y0: y0, y1: (y0 + 0.02), z0: z0, z1: z1, slot: shellCeiling)
  boundsBox(label: label, x0: x0, x1: x1, y0: (y0 + 0.02), y1: y1, z0: z0, z1: z1, slot: top)
}

// An upper level's floor as the boxes of its plan: the north gallery, the bridge west of the nave, the south gallery,
// and on the wing's levels the floor of the projection, holed by a well over each stair, on level 1 by one over the
// endless fall's ceiling painting, and by a small square wherever the flaw passes through (layout.puck's
// `flawCrossings`), which the flaw's collar (flaw.puck) fills and rounds.
let fallWell = { x0: (fallPlan[0] - fallHole), x1: (fallPlan[0] + fallHole), z0: (fallPlan[1] - fallHole), z1: (fallPlan[1] + fallHole) }
function flawOpenings(level) = map(filter(flawCrossings, c => (flawEnabled and ((c.height + 1) == level))), c => {
  x0: (c.point[0] - lookFlawCollarCut)
  x1: (c.point[0] + lookFlawCollarCut)
  z0: (c.point[2] - lookFlawCollarCut)
  z1: (c.point[2] + lookFlawCollarCut)
})
function shellFloorPieces(level) = boundsCutAll(
  concat(
    [
      { id: "north", x0: galleryWestIn, x1: galleryEast, z0: naveNorth, z1: galleryNorth }
      { id: "bridge", x0: galleryWestIn, x1: naveWest, z0: naveSouth, z1: naveNorth }
      { id: "south", x0: galleryWestIn, x1: wingWest, z0: galleryWall, z1: naveSouth }
      { id: "east", x0: wingWest, x1: galleryEast, z0: galleryWall, z1: naveSouth }
    ],
    ((level >= wingLevel) ? [{ id: "wing", x0: wingWest, x1: galleryWidth, z0: wingSouth, z1: galleryWall }] : [])
  ),
  concat(galleryStairWells, (((level == 1) and fallOpen) ? [fallWell] : []), flawOpenings(level))
)
// The roof: the same plan without the wells and the terrace, the nave closed over between three skylights, each
// 2.5 m in from the balcony edges.
let skylights = [{ x0: 16, x1: 26 }, { x0: 30, x1: 40 }, { x0: 44, x1: 54 }]
let skylightSouth = (naveSouth + 2.5)
let skylightNorth = (naveNorth - 2.5)
let skylightHalf = ((skylightNorth - skylightSouth) / 2)
let shellRoofPieces = concat(
  [
    { id: "north", x0: galleryWestIn, x1: galleryEast, z0: naveNorth, z1: galleryNorth }
    { id: "bridge", x0: galleryWestIn, x1: skylights[0].x0, z0: naveSouth, z1: naveNorth }
    { id: "core", x0: terraceEast, x1: wingWest, z0: galleryWall, z1: naveSouth }
    { id: "east", x0: wingWest, x1: galleryEast, z0: galleryWall, z1: naveSouth }
    { id: "wing", x0: wingWest, x1: galleryWidth, z0: wingSouth, z1: galleryWall }
    { id: "nave-south", x0: skylights[0].x0, x1: galleryEast, z0: naveSouth, z1: skylightSouth }
    { id: "nave-north", x0: skylights[0].x0, x1: galleryEast, z0: skylightNorth, z1: naveNorth }
    { id: "nave-east", x0: skylights[2].x1, x1: galleryEast, z0: skylightSouth, z1: skylightNorth }
  ],
  map(
    range(0, 2),
    i => { id: $"nave-rib-{i}", x0: skylights[i].x1, x1: skylights[(i + 1)].x0, z0: skylightSouth, z1: skylightNorth }
  )
)

// The stairs: each corner's stair (layout.puck's `galleryStairs`) is the standard's kit piece, one copy a storey from
// level 0 to level 2 standing at its well's centre, the switchbacks' top copy guarding its well on level 3. A spiral's
// well is the square round its turn, so each floor above it rails the well's open sides but for the two tiles of its
// front the stair arrives through, and its back where the south wall stops short of it (the wing's storeys).
// Each storey's piece is its own creation, since the storeys either side of level 1 are shaped for a body changing size
// on them: a body is the toybox's size (look.puck's `lookWonderSize`) on level 1 and full size on every other floor,
// the toybox's size field (wonder.puck) carrying it between on the standard's curve, so a piece's foot and head take
// their floors' sizes and its risers grow finer toward level 1 (architecture.puck's riser schedule) in step with the
// body climbing them. Retuning Alice's size reshapes these flights at the next reload.
let shellStairStoreys = map(range(0, 3), k => k)
function shellLevelSize(level) = ((level == toyboxLevel) ? lookWonderSize : 1)
function shellStairPiece(stair, k) = $"gallery-{stair.form}-{k}"
function shellWellBackOpen(stair, k) = (
  (stair.yaw == 180) and ((stair.well.x0 < shellSouthWall(k).x0) or (stair.well.x1 > shellSouthWall(k).x1))
)
function shellWellRails(stair, k) = concat(
  map(
    filter(range(0, stairTiles), t => ((t < ((stairTiles / 2) - 1)) or (t > (stairTiles / 2)))),
    t => {
      id: $"front-{t}"
      x: (stair.well.x0 + ((t + 0.5) * galleryTile))
      z: ((stair.yaw == 180) ? (stair.well.z1 + 0.08) : (stair.well.z0 - 0.08))
      yaw: ((stair.yaw + 180) % 360)
    }
  ),
  map(range(0, stairTiles), t => {
    id: $"side-{t}"
    x: ((stair.yaw == 180) ? (stair.well.x0 - 0.08) : (stair.well.x1 + 0.08))
    z: (stair.well.z0 + ((t + 0.5) * galleryTile))
    yaw: ((stair.yaw + 90) % 360)
  }),
  map(
    (shellWellBackOpen(stair, k) ? range(0, stairTiles) : []),
    t => { id: $"back-{t}", x: (stair.well.x0 + ((t + 0.5) * galleryTile)), z: (stair.well.z0 - 0.08), yaw: 180 }
  )
)
// The balcony edges' 4 m lengths stop a tile short of the east end's last pier, so a tile of balustrade closes each
// edge's last tile on every upper level, where the eastern stairs arrive beside it.
let shellTileRails = concat(
  flatMap(
    filter(galleryStairs, stair => (stair.form == "spiral")),
    stair => flatMap(range(1, 4), k => map(shellWellRails(stair, k), rail => (rail with { id: $"{stair.id}-{k}-{rail.id}", y: galleryFloor[k] })))
  ),
  flatMap(range(1, 4), k => [
    { id: $"nave-south-end-{k}", x: tileX((gridTilesX - 2)), y: galleryFloor[k], z: (naveSouth - 0.08), yaw: 180 }
    { id: $"nave-north-end-{k}", x: tileX((gridTilesX - 2)), y: galleryFloor[k], z: (naveNorth + 0.08), yaw: 0 }
  ]),
)

// The lift's tower, outside the south wall: four teal posts, a ring beam at each floor, glass between them on the three
// outer sides, and a cream cap over a glazed lantern. The door wall is the south wall itself.
let towerRings = [[-0.05, 0.35], [4.2, 4.55], [8.7, 9.05], [13.2, 13.55], [17.7, 18.05], [20.2, 20.4]]
template shellTower() {
  for post in [
    { name: "sw", x: towerWest, z: towerSouth }
    { name: "se", x: (towerEast - 0.3), z: towerSouth }
    { name: "nw", x: towerWest, z: -0.3 }
    { name: "ne", x: (towerEast - 0.3), z: -0.3 }
  ] {
    boundsBox(
      label: $"post-{post.name}",
      x0: post.x,
      x1: (post.x + 0.3),
      y0: 0,
      y1: 20.4,
      z0: post.z,
      z1: (post.z + 0.3),
      slot: shellTrim,
      bevel: 0.04
    )
  }
  for (ring, n) in towerRings {
    boundsBox(label: $"ring-south-{n}", x0: towerWest, x1: towerEast, y0: ring[0], y1: ring[1], z0: towerSouth, z1: (towerSouth + 0.3), slot: shellTrim)
    boundsBox(label: $"ring-west-{n}", x0: towerWest, x1: (towerWest + 0.3), y0: ring[0], y1: ring[1], z0: towerSouth, z1: 0, slot: shellTrim)
    boundsBox(label: $"ring-east-{n}", x0: (towerEast - 0.3), x1: towerEast, y0: ring[0], y1: ring[1], z0: towerSouth, z1: 0, slot: shellTrim)
  }
  for n in range(0, 5) {
    boundsBox(label: $"glass-south-{n}", x0: (towerWest + 0.3), x1: (towerEast - 0.3), y0: towerRings[n][1], y1: towerRings[(n + 1)][0], z0: (towerSouth + 0.1), z1: (towerSouth + 0.2), slot: shellGlass)
    boundsBox(label: $"glass-west-{n}", x0: (towerWest + 0.1), x1: (towerWest + 0.2), y0: towerRings[n][1], y1: towerRings[(n + 1)][0], z0: (towerSouth + 0.3), z1: -0.3, slot: shellGlass)
    boundsBox(label: $"glass-east-{n}", x0: (towerEast - 0.2), x1: (towerEast - 0.1), y0: towerRings[n][1], y1: towerRings[(n + 1)][0], z0: (towerSouth + 0.3), z1: -0.3, slot: shellGlass)
  }
  boundsBox(label: "pit", x0: towerWest, x1: towerEast, y0: -0.3, y1: -0.06, z0: towerSouth, z1: 0, slot: shellTrim)
  boundsRound(label: "cap", x0: (towerWest - 0.15), x1: (towerEast + 0.15), y0: 20.4, y1: towerTop, z0: (towerSouth - 0.15), z1: 0.15, slot: shellCream, rounding: 0.18)
}

// The cream bands of the outside: a thick rounded band round the building at each upper floor and a deeper one as the
// roof's parapet, each a strip standing proud of a wall face. A strip names the face it lies on (the fixed coordinate
// and the side the outside is on) and its run along it.
// The tall bays pass through level 1, so the east wall's band there stops at the bays' outer jambs.
let tallBaysSouth = ((tallBayZs[0] - (tallBayWidth / 2)) - 0.6)
let tallBaysNorth = ((tallBayZs[2] + (tallBayWidth / 2)) + 0.6)
let shellRings = concat(
  flatMap(range(1, 4), k => concat(
    [
      { id: $"north-{k}", axis: "x", at: galleryDepth, out: 1, a0: galleryWestOut, a1: galleryWidth, y0: ((galleryStorey * k) - 0.5), y1: ((galleryStorey * k) + 0.3) }
      { id: $"west-{k}", axis: "z", at: galleryWestOut, out: -1, a0: 0, a1: galleryDepth, y0: ((galleryStorey * k) - 0.5), y1: ((galleryStorey * k) + 0.3) }
      { id: $"east-{k}", axis: "z", at: galleryWidth, out: 1, a0: ((k >= wingLevel) ? wingSouth : 0), a1: ((k == 1) ? tallBaysSouth : galleryDepth), y0: ((galleryStorey * k) - 0.5), y1: ((galleryStorey * k) + 0.3) }
      { id: $"south-{k}", axis: "x", at: 0, out: -1, a0: galleryWestOut, a1: ((k >= wingLevel) ? wingWest : galleryWidth), y0: ((galleryStorey * k) - 0.5), y1: ((galleryStorey * k) + 0.3) }
    ],
    ((k == 1) ? [
      { id: $"east-north-{k}", axis: "z", at: galleryWidth, out: 1, a0: tallBaysNorth, a1: galleryDepth, y0: ((galleryStorey * k) - 0.5), y1: ((galleryStorey * k) + 0.3) }
    ] : []),
    ((k >= wingLevel) ? [
      { id: $"wing-south-{k}", axis: "x", at: wingSouth, out: -1, a0: wingWest, a1: galleryWidth, y0: ((galleryStorey * k) - 0.5), y1: ((galleryStorey * k) + 0.3) }
      { id: $"wing-west-{k}", axis: "z", at: wingWest, out: -1, a0: wingSouth, a1: 0, y0: ((galleryStorey * k) - 0.5), y1: ((galleryStorey * k) + 0.3) }
    ] : [])
  )),
  [
    { id: "parapet-north", axis: "x", at: galleryDepth, out: 1, a0: galleryWestOut, a1: galleryWidth, y0: 17.5, y1: galleryParapet }
    { id: "parapet-west", axis: "z", at: galleryWestOut, out: -1, a0: (terraceNorth - galleryWall), a1: galleryDepth, y0: 17.5, y1: galleryParapet }
    { id: "parapet-terrace", axis: "x", at: (terraceNorth - galleryWall), out: -1, a0: galleryWestOut, a1: terraceEast, y0: 17.5, y1: galleryParapet }
    { id: "parapet-terrace-east", axis: "z", at: (terraceEast - galleryWall), out: -1, a0: 0, a1: terraceNorth, y0: 17.5, y1: galleryParapet }
    { id: "parapet-core", axis: "x", at: 0, out: -1, a0: (terraceEast - galleryWall), a1: wingWest, y0: 17.5, y1: galleryParapet }
    { id: "parapet-wing-west", axis: "z", at: wingWest, out: -1, a0: wingSouth, a1: 0, y0: 17.5, y1: galleryParapet }
    { id: "parapet-wing", axis: "x", at: wingSouth, out: -1, a0: wingWest, a1: galleryWidth, y0: 17.5, y1: galleryParapet }
    { id: "parapet-east", axis: "z", at: galleryWidth, out: 1, a0: wingSouth, a1: galleryDepth, y0: 17.5, y1: galleryParapet }
  ]
)
let shellBand = 0.16
template shellBands() {
  for strip in filter(shellRings, ring => (ring.axis == "x")) {
    boundsRound(
      label: $"band-{strip.id}",
      x0: (strip.a0 - shellBand),
      x1: (strip.a1 + shellBand),
      y0: strip.y0,
      y1: strip.y1,
      z0: ((strip.out == 1) ? (strip.at - 0.06) : (strip.at - shellBand)),
      z1: ((strip.out == 1) ? (strip.at + shellBand) : (strip.at + 0.06)),
      slot: shellCream,
      rounding: 0.08
    )
  }
  for strip in filter(shellRings, ring => (ring.axis == "z")) {
    boundsRound(
      label: $"band-{strip.id}",
      x0: ((strip.out == 1) ? (strip.at - 0.06) : (strip.at - shellBand)),
      x1: ((strip.out == 1) ? (strip.at + shellBand) : (strip.at + 0.06)),
      y0: strip.y0,
      y1: strip.y1,
      z0: (strip.a0 - shellBand),
      z1: (strip.a1 + shellBand),
      slot: shellCream,
      rounding: 0.08
    )
  }
}

// The forecourt: terracotta paving from the west wing's last bay east to the corner and 11 m out, its top level with the
// hall's floor, inside a cream kerb.
let forecourtWest = 12
let forecourtEast = 62
let forecourtSouth = -11
template shellForecourt() {
  boundsBox(label: "paving", x0: forecourtWest, x1: forecourtEast, y0: -0.3, y1: galleryFloor[0], z0: forecourtSouth, z1: 0, slot: shellPaving)
  boundsRound(label: "kerb-south", x0: (forecourtWest - 0.3), x1: (forecourtEast + 0.3), y0: -0.3, y1: 0.12, z0: (forecourtSouth - 0.3), z1: forecourtSouth, slot: shellCream, rounding: 0.05)
  boundsRound(label: "kerb-west", x0: (forecourtWest - 0.3), x1: forecourtWest, y0: -0.3, y1: 0.12, z0: forecourtSouth, z1: 0, slot: shellCream, rounding: 0.05)
  boundsRound(label: "kerb-east", x0: forecourtEast, x1: (forecourtEast + 0.3), y0: -0.3, y1: 0.12, z0: forecourtSouth, z1: 0, slot: shellCream, rounding: 0.05)
}

// The kit pieces that stand on the plan, each a list gallery.puck stamps: the arcades' piers on every level, the
// balcony edges round the nave's void and round the fall's well, the terrace's edge, and the furniture.
// A pier's prototype: the hall's teal, or on level 1 the toybox's pastel for its place along the arcade.
// The arcade's end piers stand half a tile from the end walls, so their haunch runs that far and half a wall into it on the
// wall's side instead of a full span through it: "-neg" stops the haunch's -x side, "-pos" its +x side. The north row
// stands unturned and the south row turned a half turn, so at the west end (the wall at -x) a north pier stops its -x side
// and a south pier its +x side, and the east end the other way about.
let shellPierWallReach = (shellTileHalf + (galleryWall / 2))
let shellPierEnds = [
  { suffix: "", reach: null }
  { suffix: "-neg", reach: [shellPierWallReach, (arcadePitch / 2)] }
  { suffix: "-pos", reach: [(arcadePitch / 2), shellPierWallReach] }
]
function shellPierEnd(b, yaw) = ((b == 0) ? ((yaw == 0) ? "-neg" : "-pos") : ((b == galleryBays) ? ((yaw == 0) ? "-pos" : "-neg") : ""))
function shellPierKind(k, b) = ((k == 1) ? $"gallery-pier-toy-{(b % length(lookToyPiers))}" : "gallery-pier")
function shellPierPrototype(k, b, yaw) = $"{shellPierKind(k, b)}{shellPierEnd(b, yaw)}"
let shellPiers = flatMap(range(0, 4), k => flatMap(range(0, length(arcadeXs)), b => [
  { id: $"pier-south-{k}-{arcadeXs[b]}", x: arcadeXs[b], y: galleryFloor[k], z: arcadeSouth, yaw: 180, prototype: shellPierPrototype(k, b, 180) }
  { id: $"pier-north-{k}-{arcadeXs[b]}", x: arcadeXs[b], y: galleryFloor[k], z: arcadeNorth, yaw: 0, prototype: shellPierPrototype(k, b, 0) }
]))
// A length of balustrade: its centre, the yaw that turns its drop side to the void, and whether it is the 2 m piece. Level
// 2's balcony edges take them; level 1's are its lattice (below).
// Levels 2 and 3's edges take one length per bay between their piers, centred on the bay, except where a tree branch lands; there
// the bay takes a doorway (below) with a short length either side of it.
let shellBalconyBays = range(arcadeWestBays, galleryBays)
function shellDoorSides(k, side, z, yaw) = map([-1, 1], s => {
  id: $"rail-door-{side}-{k}-{s}", x: (treeLanding(k, side) + (s * (((treeDoorWidth / 2) + treeDoorPost) + (treeDoorSide / 2)))), y: galleryFloor[k], z: z, yaw: yaw, short: 2
})
let shellRails = concat(
  flatMap([2, 3], k => concat(
    map(filter(shellBalconyBays, b => (bayX(b) != treeLanding(k, "south"))), b => {
      id: $"rail-south-{k}-{b}", x: bayX(b), y: galleryFloor[k], z: (naveSouth - balconyInset), yaw: 180, short: 0
    }),
    map(filter(shellBalconyBays, b => (bayX(b) != treeLanding(k, "north"))), b => {
      id: $"rail-north-{k}-{b}", x: bayX(b), y: galleryFloor[k], z: (naveNorth + balconyInset), yaw: 0, short: 0
    }),
    shellDoorSides(k, "south", (naveSouth - balconyInset), 180),
    shellDoorSides(k, "north", (naveNorth + balconyInset), 0),
    map(range(0, 5), i => { id: $"rail-bridge-{k}-{i}", x: (naveWest - balconyInset), y: galleryFloor[k], z: (naveSouth + 2 + (4 * i)), yaw: 270, short: 0 })
  )),
  (fallOpen ? [
    { id: "rail-fall-south", x: fallPlan[0], y: galleryFloor[1], z: ((fallPlan[1] - fallHole) - 0.08), yaw: 180, short: 1 }
    { id: "rail-fall-north", x: fallPlan[0], y: galleryFloor[1], z: ((fallPlan[1] + fallHole) + 0.08), yaw: 0, short: 1 }
    { id: "rail-fall-west", x: ((fallPlan[0] - fallHole) - 0.08), y: galleryFloor[1], z: fallPlan[1], yaw: 270, short: 1 }
    { id: "rail-fall-east", x: ((fallPlan[0] + fallHole) + 0.08), y: galleryFloor[1], z: fallPlan[1], yaw: 90, short: 1 }
  ] : []),
  map(range(0, 4), i => { id: $"rail-terrace-south-{i}", x: ((galleryWestOut + 2.2) + (4 * i)), y: galleryFloor[3], z: 0.15, yaw: 0, short: 0 }),
  map(range(0, 2), i => { id: $"rail-terrace-west-{i}", x: (galleryWestOut + 0.15), y: galleryFloor[3], z: (2.3 + (4 * i)), yaw: 90, short: 0 })
)
// Level 1's lattice (layout.puck's toyLattice values): a four-tile panel in each arcade bay along the void's south and
// north edges, from pier to pier, and a half-tile one from the last pier to the east wall; and the bridge's edge in
// four-tile panels about one tile on the nave's axis. Each panel stands
// on level 1's floor and reaches into the fascia hanging under level 2's balcony edge, and neighbouring panels' posts overlap at every joint and corner. A loose panel (`slat`, its
// `toyboxSlats` cell) shows its `open` prototype while its cell is 1.
let shellLatticeHeight = ((((galleryStorey * 2) - shellFascia) - galleryFloor[1]) + 0.05)
let shellLatticeTileCells = (galleryTile / toyLatticePitch)
let shellLatticeBayCells = (galleryBayTiles * shellLatticeTileCells)
let shellLatticeBays = range(arcadeWestBays, galleryBays)
let shellBridgeMid = ((galleryNaveTiles - 1) / 2)
function shellBridgeZ(tile, tiles) = (tileEdgeZ((galleryAisleTiles + tile)) + ((tiles * galleryTile) / 2))
function shellLatticeBay(b, edge, z) = ((b == toyLatticeLooseBay) ? {
  id: $"loose-{edge}", x: bayX(b), z: z, yaw: 0, prototype: $"gallery-lattice-{(b % 6)}", slat: edge, open: $"gallery-lattice-open-{(b % 6)}"
} : { id: $"{edge}-{b}", x: bayX(b), z: z, yaw: 0, prototype: $"gallery-lattice-{(b % 6)}", slat: "", open: "" })
// Where each level-1 branch lands (layout.puck's treeLimbs), the bay stands open and a magic barrier fills the arch behind
// it (architecture.puck's filmArch, in the arcade's plane): a dead end that sells a way across. Its pane holds
// every body, small or full size, except one holding a wonder pass (layout.puck's `wonderPasses`: the wonder key
// switched on, rentals.puck), which walks through it and onto level 1 at its full size. Each lattice panel
// rises in its own `shellLatticeRails` crossbars so the bars keep one spacing.
// The level-1 arcade's arch opening (architecture.puck's branchedPier): its radius and the height of its spring line.
let shellArchRadius = ((arcadePitch / 2) - 0.42)
let shellArchSpring = (((galleryCeiling[1] - galleryFloor[1]) - 0.3) - shellArchRadius)
function shellLatticeRails(height) = (2 * maximum(1, round((height / (shellLatticeHeight / 3)))))
let shellGateEdges = [
  { edge: "south", z: (naveSouth - balconyInset), arch: arcadeSouth, bay: bayOf(treeLanding(toyboxLevel, "south")) }
  { edge: "north", z: (naveNorth + balconyInset), arch: arcadeNorth, bay: bayOf(treeLanding(toyboxLevel, "north")) }
]
let shellLatticeGates = map(shellGateEdges, e => { id: $"barrier-{e.edge}", x: bayX(e.bay), y: 0, z: e.arch, prototype: "gallery-barrier" })
let shellLattices = concat(
  map(filter(shellLatticeBays, b => (b != shellGateEdges[0].bay)), b => shellLatticeBay(b, "south", (naveSouth - balconyInset))),
  map(filter(shellLatticeBays, b => (b != shellGateEdges[1].bay)), b => shellLatticeBay(b, "north", (naveNorth + balconyInset))),
  [
    { id: "east-south", x: ((pierX(galleryBays) + galleryEast) / 2), z: (naveSouth - balconyInset), yaw: 0, prototype: "gallery-lattice-half", slat: "", open: "" }
    { id: "east-north", x: ((pierX(galleryBays) + galleryEast) / 2), z: (naveNorth + balconyInset), yaw: 0, prototype: "gallery-lattice-half", slat: "", open: "" }
  ],
  map([0, 4, (shellBridgeMid + 1), (shellBridgeMid + 5)], tile => {
    id: $"bridge-{tile}", x: (naveWest - balconyInset), z: shellBridgeZ(tile, 4), yaw: 90, prototype: $"gallery-lattice-{(tile % 6)}", slat: "", open: ""
  }),
  [
    {
      id: "loose-bridge", x: (naveWest - balconyInset), z: shellBridgeZ(shellBridgeMid, 1), yaw: 90, prototype: "gallery-lattice-tile", slat: "bridge"
      open: "gallery-lattice-tile-open"
    }
  ]
)
// The piers of the nave's end wall stand between its tall bays and either side of them.
let naveEndSpan = ((tallBayZs[1] - tallBayZs[0]) / 2)
let naveEndPiers = map(range(0, 4), i => ((tallBayZs[0] - naveEndSpan) + ((2 * naveEndSpan) * i)))
// The planters keep the benches' rhythm on the tile grid: each is two tiles long, centred on a tile, against a long wall
// in the first tile row. On level 0 one stands against each wall in every bay a pair of displays fills, so walking an
// aisle meets a planter across from each display and a bench in each bay between them; a south bay stays bare where
// the entrance, the lift's door, a fin of the painting wing or a painting's door stands. The upper levels keep a
// planter at each end of the bridge's middle, one in each south-west corner beside the stair, and the terrace's along
// its parapet. Furniture on every level yields to the stairs' wells.
function shellFurnitureClear(item) = galleryStairClear(galleryTileX(item.x), galleryTileZ(item.z), galleryTile, (galleryTile / 2))
let shellPlanterBays = map(showcaseBays, b => bayX(b))
let shellPlanterBlocked = concat(
  shellBenchBlocked,
  [[entranceWest, entranceEast], [(courtFin + galleryWall), ((courtFin + galleryWall) + 1)]],
  map(courtWallDoors, door => [(door - 0.6), (door + 0.6)])
)
function shellPlanterClear(x) = (count(shellPlanterBlocked, span => overlaps([(x - galleryTile), (x + galleryTile)], span)) == 0)
let shellPlanters = filter(concat(
  map(filter(shellPlanterBays, x => shellPlanterClear(x)), x => { x: x, y: 0, z: tileZ(wallRowSouth), yaw: 0 }),
  map(shellPlanterBays, x => { x: x, y: 0, z: tileZ(wallRowNorth), yaw: 0 }),
  flatMap(range(1, 4), k => [
    { x: (naveWest - (galleryTile * 1.5)), y: k, z: (naveMid - (galleryTile * 3)), yaw: 90 }
    { x: (naveWest - (galleryTile * 1.5)), y: k, z: (naveMid + (galleryTile * 3)), yaw: 90 }
  ]),
  map(range(1, 3), k => { x: (galleryStair("south-west").well.x1 + (galleryTile * 1.5)), y: k, z: tileZ(wallRowSouth), yaw: 0 }),
  map(range(0, 4), i => { x: ((galleryWestOut + 2) + (4 * i)), y: 3, z: tileZ(wallRowSouth), yaw: 0 })
), planter => shellFurnitureClear(planter))
// The benches stand in the floor's empty bays, each two tiles long and centred on a tile, so its ends lie on the
// centres of the tiles either side (the placements snap each to its nearest tile centre). On level 0 they keep the
// displays' rhythm: the displays' pairs fill every other arcade bay, and in each bay between them a bench stands against
// each long wall, in the first tile row. A south bay is left bare where its bench would stand across the lift's door or
// a fin of the painting wing.
let shellBenchBays = map(restBays, b => bayX(b))
let shellBenchBlocked = [[liftDoorway.a0, liftDoorway.a1], [courtWest, (courtWest + galleryWall)], [courtFin, (courtFin + galleryWall)]]
function shellBenchClear(x) = (count(shellBenchBlocked, span => overlaps([(x - galleryTile), (x + galleryTile)], span)) == 0)
let shellBenches = filter(concat(
  map(filter(shellBenchBays, x => shellBenchClear(x)), x => { x: x, y: 0, z: tileZ(wallRowSouth), yaw: 0 }),
  map(shellBenchBays, x => { x: x, y: 0, z: tileZ(wallRowNorth), yaw: 0 }),
  [
    { x: 6, y: 1, z: 5, yaw: 0 }, { x: 6, y: 1, z: naveMid, yaw: 90 }, { x: 52, y: 1, z: 3, yaw: 0 }
    { x: 6, y: 2, z: 5, yaw: 0 }, { x: 6, y: 2, z: naveMid, yaw: 90 }
    { x: 4, y: 3, z: 5.4, yaw: 0 }, { x: 9, y: 3, z: 5.4, yaw: 0 }, { x: 6, y: 3, z: naveMid, yaw: 90 }, { x: 38, y: 3, z: (arcadeSouth - 1.35), yaw: 0 }
  ]
), bench => shellFurnitureClear(bench))
template shellPrototypes() {
  for k in range(0, 4) {
    prototype $"gallery-walls-{k}" {
      document {
        name: $"gallery-walls-{k}"
        schema: "puck.creation.v2"
        palette: shellPalette([], k, k)
        shellWalls(level: k)
      }
    }
  }
  prototype "gallery-floor-0" {
    document {
      name: "gallery-floor-0"
      schema: "puck.creation.v2"
      palette: shellPalette(shellPads(0))
      boundsBox(label: "ground", x0: galleryWestIn, x1: galleryEast, y0: 0, y1: galleryFloor[0], z0: galleryWall, z1: naveMid, slot: shellFloor)
      boundsBox(label: "ground-north", x0: galleryWestIn, x1: galleryEast, y0: 0, y1: galleryFloor[0], z0: naveMid, z1: galleryNorth, slot: shellFloorNorth)
      boundsBox(label: "threshold", x0: entranceWest, x1: entranceEast, y0: 0, y1: galleryFloor[0], z0: 0, z1: galleryWall, slot: shellFloor)
      boundsBox(label: "lift-threshold", x0: liftDoorway.a0, x1: liftDoorway.a1, y0: 0, y1: galleryFloor[0], z0: 0, z1: galleryWall, slot: shellTrim)
    }
  }
  // Each upper floor: its slab's boxes and the cream fascia that deepens its balcony edges round the void.
  for k in range(1, 4) {
    prototype $"gallery-floor-{k}" {
      document {
        name: $"gallery-floor-{k}"
        schema: "puck.creation.v2"
        palette: shellPalette(shellPads(k), k, (k - 1))
        for piece in shellFloorPieces(k) {
          shellSlab(
            label: $"slab-{piece.id}",
            x0: piece.x0,
            x1: piece.x1,
            y0: ((galleryStorey * k) - 0.25),
            y1: galleryFloor[k],
            z0: piece.z0,
            z1: piece.z1,
            top: ((piece.z0 >= naveMid) ? shellFloorNorth : shellFloor)
          )
        }
        boundsBox(
          label: "lift-threshold",
          x0: liftDoorway.a0,
          x1: liftDoorway.a1,
          y0: ((galleryStorey * k) - 0.25),
          y1: galleryFloor[k],
          z0: 0,
          z1: galleryWall,
          slot: shellTrim
        )
        boundsBox(label: "fascia-south", x0: naveWest, x1: galleryEast, y0: ((galleryStorey * k) - shellFascia), y1: galleryFloor[k], z0: (naveSouth - 0.2), z1: naveSouth, slot: shellCream)
        boundsBox(label: "fascia-north", x0: naveWest, x1: galleryEast, y0: ((galleryStorey * k) - shellFascia), y1: galleryFloor[k], z0: naveNorth, z1: (naveNorth + 0.2), slot: shellCream)
        boundsBox(label: "fascia-bridge", x0: (naveWest - 0.2), x1: naveWest, y0: ((galleryStorey * k) - shellFascia), y1: galleryFloor[k], z0: naveSouth, z1: naveNorth, slot: shellCream)
      }
    }
  }
  prototype "gallery-roof" {
    document {
      name: "gallery-roof"
      schema: "puck.creation.v2"
      palette: shellPalette([], 3, 3)
      for piece in shellRoofPieces {
        shellSlab(label: $"roof-{piece.id}", x0: piece.x0, x1: piece.x1, y0: galleryCeiling[3], y1: galleryRoof, z0: piece.z0, z1: piece.z1, top: shellCream)
      }
    }
  }
  // A skylight: one pane in a teal frame, ribbed across and along, a creation of its own so the pane bakes at its own
  // thickness.
  prototype "gallery-skylight" {
    document {
      name: "gallery-skylight"
      schema: "puck.creation.v2"
      palette: shellPlain
      boundsBox(label: "pane", x0: -5.1, x1: 5.1, y0: 0.04, y1: 0.16, z0: (0 - (skylightHalf + 0.1)), z1: (skylightHalf + 0.1), slot: shellGlass)
      boundsBox(label: "frame-south", x0: -5.2, x1: 5.2, y0: 0, y1: 0.3, z0: (0 - (skylightHalf + 0.2)), z1: (0 - skylightHalf), slot: shellTrim)
      boundsBox(label: "frame-north", x0: -5.2, x1: 5.2, y0: 0, y1: 0.3, z0: skylightHalf, z1: (skylightHalf + 0.2), slot: shellTrim)
      boundsBox(label: "frame-west", x0: -5.2, x1: -5, y0: 0, y1: 0.3, z0: (0 - (skylightHalf + 0.2)), z1: (skylightHalf + 0.2), slot: shellTrim)
      boundsBox(label: "frame-east", x0: 5, x1: 5.2, y0: 0, y1: 0.3, z0: (0 - (skylightHalf + 0.2)), z1: (skylightHalf + 0.2), slot: shellTrim)
      boundsBox(label: "frame-rib", x0: -0.08, x1: 0.08, y0: 0, y1: 0.26, z0: (0 - (skylightHalf + 0.1)), z1: (skylightHalf + 0.1), slot: shellTrim)
      boundsBox(label: "frame-spine", x0: -5, x1: 5, y0: 0, y1: 0.26, z0: -0.08, z1: 0.08, slot: shellTrim)
    }
  }
  // The stairs' kit pieces, one storey each, the top switchback guarding its well.
  for k in shellStairStoreys {
    prototype $"gallery-switchback-{k}" {
      document {
        name: $"gallery-switchback-{k}"
        schema: "puck.creation.v2"
        palette: shellKit
        switchbackStair(
          base: 0,
          width: (stairTiles * galleryTile),
          depth: (switchbackTiles * galleryTile),
          landing: switchbackLanding,
          rise: galleryStorey,
          risers: stairRisers,
          guard: (k == (length(shellStairStoreys) - 1)),
          size0: shellLevelSize(k),
          size1: shellLevelSize((k + 1))
        )
      }
    }
    prototype $"gallery-spiral-{k}" {
      document {
        name: $"gallery-spiral-{k}"
        schema: "puck.creation.v2"
        palette: shellKit
        spiralStair(
          base: 0,
          radius: spiralRadius,
          newel: spiralNewel,
          rise: galleryStorey,
          risers: stairRisers,
          size0: shellLevelSize(k),
          size1: shellLevelSize((k + 1))
        )
      }
    }
  }
  prototype "gallery-tower" {
    document {
      name: "gallery-tower"
      schema: "puck.creation.v2"
      palette: shellPlain
      shellTower()
    }
  }
  prototype "gallery-bands" {
    document {
      name: "gallery-bands"
      schema: "puck.creation.v2"
      palette: shellPlain
      shellBands()
    }
  }
  prototype "gallery-forecourt" {
    document {
      name: "gallery-forecourt"
      schema: "puck.creation.v2"
      palette: shellPlain
      shellForecourt()
    }
  }

  // The kit, each piece one creation however many times the plan stamps it.
  // Each pier comes whole and as the two end variants (shellPierEnds), whose haunch stops inside the end wall on one side.
  for (end, e) in shellPierEnds {
    prototype $"gallery-pier{end.suffix}" {
      document {
        name: $"gallery-pier{end.suffix}"
        schema: "puck.creation.v2"
        palette: shellStructure
        branchedPier(base: 0, height: (galleryCeiling[0] - galleryFloor[0]), span: (arcadePitch / 2), foot: [shellTileHalf, shellTileHalf], reach: end.reach)
      }
    }
    for (tone, n) in lookToyPiers {
      prototype $"gallery-pier-toy-{n}{end.suffix}" {
        document {
          name: $"gallery-pier-toy-{n}{end.suffix}"
          schema: "puck.creation.v2"
          palette [shellBrushed((structurePalette[0] with { color: tone }), lookBrushStructure), (structurePalette[1] with { color: lookBrass })]
          branchedPier(base: 0, height: (galleryCeiling[0] - galleryFloor[0]), span: (arcadePitch / 2), foot: [shellTileHalf, shellTileHalf], reach: end.reach)
        }
      }
    }
  }
  // The nave's end: a slim pier either side of each tall bay, whose branches arch over the bay's head.
  prototype "gallery-nave-pier" {
    document {
      name: "gallery-nave-pier"
      schema: "puck.creation.v2"
      palette: shellStructure
      branchedPier(base: 0, height: (tallBayHeight + 1.1), span: naveEndSpan, depth: 0.26, shaft: 0.22, foot: [shellTileHalf, shellTileHalf])
    }
  }
  prototype "gallery-arch" {
    document {
      name: "gallery-arch"
      schema: "puck.creation.v2"
      palette: shellStructure
      branchedPier(base: 0, height: (galleryCeiling[1] - galleryFloor[0]), span: archSpan, depth: 0.55, shaft: 0.6)
    }
  }
  prototype "gallery-bay" {
    document {
      name: "gallery-bay"
      schema: "puck.creation.v2"
      palette: shellKit
      windowBay(base: 0, width: bayWidth, height: bayHeight, sill: baySill, wall: galleryWall)
    }
  }
  prototype "gallery-bay-tall" {
    document {
      name: "gallery-bay-tall"
      schema: "puck.creation.v2"
      palette: shellKit
      windowBay(base: 0, width: tallBayWidth, height: tallBayHeight, sill: baySill, wall: galleryWall)
    }
  }
  // The middle tall bay of the nave's end wall, which no fan shade covers, glazed with stained glass (look.puck's
  // lookStained) that the morning sun comes through.
  prototype "gallery-bay-stained" {
    document {
      name: "gallery-bay-stained"
      schema: "puck.creation.v2"
      palette: concat(shellKit, stainedGlassPalette(lookStained.colors))
      stainedGlassBay(base: 0, stained: length(shellKit), cells: lookStained.cells, width: tallBayWidth, height: tallBayHeight, sill: baySill, wall: galleryWall)
    }
  }
  // A fan shade for each level's bays: every level's follows its own `hallBlinds` cell, 1 spread and 0 gathered.
  for k in range(0, 4) {
    prototype $"gallery-fan-{k}" {
      document {
        name: $"gallery-fan-{k}"
        schema: "puck.creation.v2"
        palette: shellKit
        fanShade(base: 0, signal: $"state.hallBlinds.level{k}", dynamics: "gallery-shade", radius: lookFan.radius, leaves: lookFan.leaves, spread: lookFan.spread, leaf: lookFan.leaf)
      }
    }
  }
  for k in [0] {
    prototype $"gallery-fan-tall-{k}" {
      document {
        name: $"gallery-fan-tall-{k}"
        schema: "puck.creation.v2"
        palette: shellKit
        fanShade(base: 0, signal: $"state.hallBlinds.level{k}", dynamics: "gallery-shade", radius: lookFanTall.radius, leaves: lookFanTall.leaves, spread: lookFanTall.spread, leaf: lookFanTall.leaf)
      }
    }
  }
  prototype "gallery-rail" {
    document {
      name: "gallery-rail"
      schema: "puck.creation.v2"
      palette: shellKit
      balustrade(base: 0, length: 4, posts: 3)
    }
  }
  prototype "gallery-rail-tile" {
    document {
      name: "gallery-rail-tile"
      schema: "puck.creation.v2"
      palette: shellKit
      balustrade(base: 0, length: galleryTile, posts: 1)
    }
  }
  prototype "gallery-rail-door-side" {
    document {
      name: "gallery-rail-door-side"
      schema: "puck.creation.v2"
      palette: shellKit
      balustrade(base: 0, length: treeDoorSide, posts: 1)
    }
  }
  prototype "gallery-rail-short" {
    document {
      name: "gallery-rail-short"
      schema: "puck.creation.v2"
      palette: shellKit
      balustrade(base: 0, length: 2, posts: 2)
    }
  }
  // Level 1's lattice panels, each in the colours of a pastel `n` (look.puck's lookToyLattice): a bay's four tiles, the
  // half tile at each east end, the bridge's middle tile, the stairs' head, and the open panels a loose one swaps to.
  let latticeKinds = concat(
    map(range(0, length(lookToyPiers)), n => {
      id: $"gallery-lattice-{n}", n: n, cells: shellLatticeBayCells, pitch: toyLatticePitch, height: shellLatticeHeight, upright: 1
    }),
    map(distinct([(toyLatticeLooseBay % 6)]), n => {
      id: $"gallery-lattice-open-{n}", n: n, cells: shellLatticeBayCells, pitch: toyLatticePitch, height: shellLatticeHeight, upright: 0
    }),
    [
      { id: "gallery-lattice-half", n: galleryBays, cells: (shellLatticeTileCells / 2), pitch: toyLatticePitch, height: shellLatticeHeight, upright: 1 }
      { id: "gallery-lattice-tile", n: arcadeWestBays, cells: shellLatticeTileCells, pitch: toyLatticePitch, height: shellLatticeHeight, upright: 1 }
      { id: "gallery-lattice-tile-open", n: arcadeWestBays, cells: shellLatticeTileCells, pitch: toyLatticePitch, height: shellLatticeHeight, upright: 0 }
    ]
  )
  prototype "gallery-barrier" {
    document {
      name: "gallery-barrier"
      schema: "puck.creation.v2"
      palette: filmArchPalette(lookBarrier.film, [0, shellArchSpring, 0], lookBarrier.tints, pane: lookBarrier.pane, glow: lookBarrier.glow, step: lookBarrier.step)
      filmArch(base: 0, radius: shellArchRadius, spring: shellArchSpring, films: length(lookBarrier.tints))
    }
  }
  for kind in latticeKinds {
    prototype $"{kind.id}" {
      document {
        name: kind.id
        schema: "puck.creation.v2"
        palette: map(
          latticePalette(lookToyLattice(kind.n).frame, lookToyLattice(kind.n).bar, lookToyLattice(kind.n).rail),
          entry => ((entry.glass != null) ? entry : shellBrushed(entry, lookBrushStructure))
        )
        lattice(
          base: 0,
          cells: kind.cells,
          pitch: kind.pitch,
          height: kind.height,
          bar: toyLatticeBar,
          rails: shellLatticeRails(kind.height),
          upright: kind.upright,
          sill: kind.upright,
          net: toyLatticeNet
        )
      }
    }
  }
  prototype "gallery-branch-door" {
    document {
      name: "gallery-branch-door"
      schema: "puck.creation.v2"
      palette: shellKit
      edgeDoorway(base: 0, width: treeDoorWidth, post: treeDoorPost)
    }
  }
  prototype "gallery-planter" {
    document {
      name: "gallery-planter"
      schema: "puck.creation.v2"
      palette: shellKit
      planter(base: 0, length: (2 * galleryTile))
    }
  }
  prototype "gallery-bench" {
    document {
      name: "gallery-bench"
      schema: "puck.creation.v2"
      palette: shellKit
      bench(base: 0, length: (2 * galleryTile))
    }
  }
}

template shellPlacements() {
  // The ground floor's walls can be climbed (the standard's climb ability); the upper floors' cannot, level 1's so
  // that the toybox is not reached round its lattice.
  for k in range(0, 4) {
    placement $"gallery-walls-{k}" {
      prototype: $"gallery-walls-{k}"
      parent: "gallery"
      position [0, 0, 0]
      grip {
        holdable: (k == 0)
      }
      solid
    }
  }
  // The central tree (tree.puck) can be climbed: its trunk and limbs hold a climber, and its treads and branch tops
  // are ground she walks. This row adds only the grip to the placement that file declares.
  placement "gallery-tree" {
    grip {
      holdable: true
    }
  }
  placement "gallery-floor-0" {
    prototype: "gallery-floor-0"
    parent: "gallery"
    position [0, 0, 0]
    solid
  }
  for k in range(1, 4) {
    placement $"gallery-floor-{k}" {
      prototype: $"gallery-floor-{k}"
      parent: "gallery"
      position [0, 0, 0]
      solid
    }
  }
  placement "gallery-roof" {
    prototype: "gallery-roof"
    parent: "gallery"
    position [0, 0, 0]
    solid
  }
  for (light, n) in skylights {
    placement $"gallery-skylight-{n}" {
      prototype: "gallery-skylight"
      parent: "gallery"
      position [((light.x0 + light.x1) / 2), (galleryRoof - 0.15), naveMid]
      solid
    }
  }
  for stair in galleryStairs {
    for k in shellStairStoreys {
      placement $"gallery-stair-{stair.id}-{k}" {
        prototype: shellStairPiece(stair, k)
        parent: "gallery"
        position [stairCentreX(stair), galleryFloor[k], stairCentreZ(stair)]
        yawDegrees: stair.yaw
        solid
      }
    }
  }
  for rail in shellTileRails {
    placement $"gallery-rail-{rail.id}" {
      prototype: "gallery-rail-tile"
      parent: "gallery"
      position [rail.x, rail.y, rail.z]
      yawDegrees: rail.yaw
      solid
    }
  }
  for id in ["gallery-tower", "gallery-forecourt"] {
    placement $"{id}" {
      prototype: id
      parent: "gallery"
      position [0, 0, 0]
      solid
    }
  }
  placement "gallery-bands" {
    prototype: "gallery-bands"
    parent: "gallery"
    position [0, 0, 0]
  }
  for pier in shellPiers {
    placement $"gallery-{pier.id}" {
      prototype: pier.prototype
      parent: "gallery"
      position [pier.x, pier.y, pier.z]
      yawDegrees: pier.yaw
      solid
    }
  }
  for tier in [0] {
    for (z, n) in naveEndPiers {
      placement $"gallery-nave-pier-{tier}-{n}" {
        prototype: "gallery-nave-pier"
        parent: "gallery"
        position [(galleryEast - shellTileHalf), galleryFloor[tier], z]
        yawDegrees: 90
      }
    }
  }
  for x in archXs {
    placement $"gallery-arch-{x}" {
      prototype: "gallery-arch"
      parent: "gallery"
      position [x, galleryFloor[0], archZ]
      solid
    }
  }
  for (bay, n) in shellBays {
    placement $"gallery-bay-{n}" {
      prototype: "gallery-bay"
      parent: "gallery"
      position [shellBayAt(bay.face, bay.at, 0)[0], galleryFloor[bay.level], shellBayAt(bay.face, bay.at, 0)[1]]
      yawDegrees: shellBayYaw(bay.face)
      solid
    }
  }
  for (bay, n) in shellShaded {
    placement $"gallery-fan-{n}" {
      prototype: $"gallery-fan-{bay.level}"
      parent: "gallery"
      position [
        shellBayAt(bay.face, bay.at, 0.26)[0],
        (galleryFloor[bay.level] + windowHubHeight(bayHeight, baySill)),
        shellBayAt(bay.face, bay.at, 0.26)[1]
      ]
      yawDegrees: shellBayYaw(bay.face)
    }
  }
  for tier in [0] {
    for (z, n) in tallBayZs {
      placement $"gallery-bay-tall-{tier}-{n}" {
        prototype: ((n == 1) ? "gallery-bay-stained" : "gallery-bay-tall")
        parent: "gallery"
        position [(galleryWidth - (galleryWall / 2)), galleryFloor[tier], z]
        yawDegrees: 270
        solid
      }
    }
    for n in [0, 2] {
      placement $"gallery-fan-tall-{tier}-{n}" {
        prototype: $"gallery-fan-tall-{tier}"
        parent: "gallery"
        position [
          ((galleryWidth - (galleryWall / 2)) + 0.26),
          (galleryFloor[tier] + windowHubHeight(tallBayHeight, baySill)),
          tallBayZs[n]
        ]
        yawDegrees: 270
      }
    }
  }
  // A doorway where each of the tree's level-2 and level-3 branches steps onto its balcony (layout.puck's treeLimbs).
  for (b, n) in filter(treeLimbs, b => (b.level >= 2)) {
    placement $"gallery-branch-door-{n}" {
      prototype: "gallery-branch-door"
      parent: "gallery"
      position [b.x, galleryFloor[b.level], ((b.side == "south") ? (naveSouth - balconyInset) : (naveNorth + balconyInset))]
      yawDegrees: ((b.side == "south") ? 180 : 0)
      solid
    }
  }
  for rail in shellRails {
    placement $"gallery-{rail.id}" {
      prototype: ((rail.short == 2) ? "gallery-rail-door-side" : ((rail.short == 1) ? "gallery-rail-short" : "gallery-rail"))
      parent: "gallery"
      position [rail.x, rail.y, rail.z]
      yawDegrees: rail.yaw
      solid
    }
  }
  for panel in filter(shellLattices, p => (p.slat == "")) {
    placement $"gallery-lattice-{panel.id}" {
      prototype: panel.prototype
      parent: "gallery"
      position [panel.x, galleryFloor[1], panel.z]
      yawDegrees: panel.yaw
      solid
    }
  }
  for panel in shellLatticeGates {
    placement $"gallery-{panel.id}" {
      prototype: panel.prototype
      parent: "gallery"
      position [panel.x, (galleryFloor[1] + panel.y), panel.z]
      solid {
        passes: wonderPasses
      }
    }
  }
  for panel in filter(shellLattices, p => (p.slat != "")) {
    placement $"gallery-lattice-{panel.id}" {
      prototype: panel.prototype
      parent: "gallery"
      position [panel.x, galleryFloor[1], panel.z]
      yawDegrees: panel.yaw
      solid
      respond [
        { when: state(state: toyboxSlats, key: $"{panel.slat}", comparison: Equal, value: 1), prototypeId: panel.open }
      ]
    }
  }
  for (planter, n) in shellPlanters {
    placement $"gallery-planter-{n}" {
      prototype: "gallery-planter"
      parent: "gallery"
      position [galleryTileX(planter.x), galleryFloor[planter.y], galleryTileZ(planter.z)]
      yawDegrees: planter.yaw
      solid
    }
  }
  for (bench, n) in shellBenches {
    placement $"gallery-bench-{n}" {
      prototype: "gallery-bench"
      parent: "gallery"
      position [galleryTileX(bench.x), galleryFloor[bench.y], galleryTileZ(bench.z)]
      yawDegrees: bench.yaw
      solid
    }
  }
}
