// Level 1's handheld rentals: two stalls in the toybox, each lending 12 Humble Gaming Bricks and 12 Advanced Gaming
// Bricks, 48 devices in all, each one of a kind (its stall, its model and its colourway). The world holds only these
// 48, so a device is either in its cubby or on loan to one body, and rules can name any one of them.
//
// The stalls wrap the open corner of the two spiral stairs (layout.puck's `galleryStairs`, south-east and north-west),
// an L-shaped counter whose two arms are the corner's two sides, its corner on the diagonal out from the stair's, so
// the plan reads the same turned half round with the switchbacks. The south-east stall's west arm shows its bricks and
// its north arm its advanced bricks; the north-west stall, turned half round, its east and south arms. A device stands
// on the counter facing whoever walks up to it.
//
// Renting: stand before a device and press the context button (`interact`, E or RB on a pad). The device leaves its
// cubby and rides the renter's hip, and the renter's own handheld machine starts. A body rents one device at a time.
// Returning: press the context button at the stall's corner (the returns tray). A renter who leaves level 1, or leaves
// the world, returns the device to its cubby.
//
// The state a puzzle reads: `rentalLoan[<ordinal>]` is 0 while the device is in its cubby and N + 1 while body N holds
// it; `rentalDevice[<ordinal>]` names the device (`se-hgb-01` .. `nw-agb-12`), `rentalDeviceModel` its model (1 a
// brick, 2 an advanced brick) and `rentalDeviceColour` its colourway's name. `rentalHeld[<body>]` is the ordinal a body
// holds (0 for none) and `rentalModel[<body>]` its model.
//
// Handhelds at scale: a device in its cubby, or riding a hip, is a static creation and runs no machine. The machines
// are a pool, one brick and one advanced brick for each seat's body (`rental-hgb-<body>`, `rental-agb-<body>`), each
// advanced only while its body holds a device of its model (the machine's `runsWhen`), so at most one handheld runs per
// player however many devices the stalls hold, and a pool machine whose body holds nothing costs no emulation. The
// renting interaction is one rule per device over the bodies standing in its reach (../../standard/reach.puck), so its cost is the
// bodies at the counter.
//
// The engage hook: every rent and return gate is `rentalCanRent(each)` and `pressing()`; a size or pass condition
// (another body state a rule can read) is added to `rentalCanRent` once and gates every stall.
//
// The wonder keys: `rentalKeyCount` keys on a stand on level 3, before the tip of the tree's south branch (layout.puck's
// `treeLimbs`), lent through the same loan row and the same press. A body holds one key beside its device and cartridge,
// on a cord at its chest. While it carries its key switched on (`rentalKeyShown` 1) its `wonderKey` register
// (wonder.puck) is 1, a wonder pass: level 1 keeps it its full size, and each level-1 branch's barrier lets it through
// (shell.puck). The key toggle (H, or the pad's North under the right trigger, Debug's free plate) switches the carried
// key off (`rentalKeyShown` 2), dull and passing nothing, and on again. A key goes back to its stand at the stand's
// tray, or when its holder leaves the gallery or the world.

import "../../standard/architecture"
import "../../standard/occlusion"
import "../../standard/machines"
import "../../standard/pad-kit"
import "../../standard/reach"
import "layout"
import "look"

// The stalls, each by its L's corner in the plan and its turn: 0 for the south-east, whose arms run south and east
// from the corner, 180 for the north-west, turned half round. `sign` turns the stall's own frame into the plan's. The
// south-east stall stands a bay west of its stair's open corner, since the south lift's landing (layout.puck's
// galleryLifts) opens onto the strip before that stair.
let rentalStallInset = 0.9
let rentalStalls = [
  {
    id: "se"
    x: ((galleryStair("south-east").well.x0 - rentalStallInset) - arcadePitch)
    z: (galleryStair("south-east").well.z1 + rentalStallInset)
    yaw: 0
    sign: 1
  }
  {
    id: "nw"
    x: (galleryStair("north-west").well.x1 + rentalStallInset)
    z: (galleryStair("north-west").well.z0 - rentalStallInset)
    yaw: 180
    sign: -1
  }
]
// A point of a stall's own frame (x and z from its corner) in the plan.
function rentalPlan(stall, lx, lz) = [(stall.x + (stall.sign * lx)), (stall.z + (stall.sign * lz))]

// The counter: 0.95 m high, 0.5 m deep, each arm 2.6 m from the corner. Arm 0 runs along the stall's -z and faces its
// -x; arm 1 runs along its +x and faces its +z. Each device stands 0.19 m from the next along its arm, the first 0.35 m
// from the corner, near the counter's front edge; the customer stands in the 0.95 m before the counter.
let rentalCounterTop = 0.95
let rentalCounterHalfDepth = 0.25
let rentalArmLength = 2.6
let rentalPitch = 0.19
let rentalFirst = 0.35
let rentalFront = 0.1
let rentalReachDepth = 1.2
function rentalAlong(n) = (rentalFirst + (rentalPitch * n))
// A device's place on its arm, in the stall's frame, and the yaw it faces the customer at.
function rentalSpot(arm, n) = ((arm == 0) ? [(0 - rentalFront), (0 - rentalAlong(n))] : [rentalAlong(n), rentalFront])
// A device's screen faces its creation's +Z, so a placement faces it toward its customer at 270 on arm 0 (customers at
// -x) and 0 on arm 1 (customers at +z).
function rentalArmYaw(arm) = ((arm == 0) ? 270 : 0)

// The models: a brick on arm 0, an advanced brick on arm 1.
let rentalModels = [
  { id: "hgb", model: 1, arm: 0, title: "HUMBLE GAMING BRICK" }
  { id: "agb", model: 2, arm: 1, title: "ADVANCED GAMING BRICK" }
]
// Twelve colourways a model, the same twelve at both stalls: each a shell and the buttons' colour.
let rentalColours = [
  [
    { name: "tangerine", shell: "#F28A2E", key: "#3A2C55" }
    { name: "grape", shell: "#7B4FB8", key: "#2B2340" }
    { name: "kiwi", shell: "#8CC63F", key: "#2E3A22" }
    { name: "berry", shell: "#D83A6B", key: "#3B1C2A" }
    { name: "teal", shell: "#1FA3A0", key: "#173A3A" }
    { name: "dandelion", shell: "#F6CB2F", key: "#4A3A12" }
    { name: "ice", shell: "#BFE6F2", key: "#2F3F55" }
    { name: "smoke", shell: "#6A6E78", key: "#222428" }
    { name: "ivory", shell: "#EDE6D3", key: "#5A2E3F" }
    { name: "jungle", shell: "#3E7D4A", key: "#1E2B20" }
    { name: "cobalt", shell: "#2F6FD6", key: "#F2B52C" }
    { name: "crimson", shell: "#C2262E", key: "#F7F3E8" }
  ]
  [
    { name: "glacier", shell: "#AFC9E6", key: "#2E3A5A" }
    { name: "indigo", shell: "#3E3A8C", key: "#C9C6F0" }
    { name: "fuchsia", shell: "#D9408F", key: "#3A1A2C" }
    { name: "spice", shell: "#E0702F", key: "#3A2414" }
    { name: "black", shell: "#24242A", key: "#8E8E98" }
    { name: "platinum", shell: "#C9CCD2", key: "#3A3E48" }
    { name: "lime", shell: "#B5D936", key: "#2C3A12" }
    { name: "flame", shell: "#E8452F", key: "#F6CB2F" }
    { name: "pearl", shell: "#F2EEE6", key: "#2F6FD6" }
    { name: "midnight", shell: "#1E2A4A", key: "#9ED4F5" }
    { name: "orchid", shell: "#B07CC6", key: "#2E1E38" }
    { name: "jade", shell: "#2FA37A", key: "#F7F3E8" }
  ]
]
let rentalPerModel = length(rentalColours[0])

function rentalNumber(n) = ((n < 10) ? $"0{n}" : $"{n}")
// The 48 devices, each by its ordinal (1 .. 48), stall, model and colourway.
let rentalDevices = flatMap(
  range(0, length(rentalStalls)),
  s => flatMap(
    range(0, length(rentalModels)),
    m => map(
      range(0, rentalPerModel),
      n => {
        ordinal: ((((s * length(rentalModels)) + m) * rentalPerModel) + n + 1)
        stall: s
        model: m
        colour: n
        id: $"{rentalStalls[s].id}-{rentalModels[m].id}-{rentalNumber(n + 1)}"
      }
    )
  )
)
function rentalPrototype(d) = $"rental-{rentalModels[d.model].id}-{rentalColours[d.model][d.colour].name}"
// Where a device stands in the plan, its counter's top under it.
function rentalDeviceAt(d) = rentalPlan(
  rentalStalls[d.stall],
  rentalSpot(rentalModels[d.model].arm, d.colour)[0],
  rentalSpot(rentalModels[d.model].arm, d.colour)[1]
)

// A reach in the plan from two corners of a stall's frame, on level 1's floor, in world coordinates.
function rentalReachBox(stall, lx0, lz0, lx1, lz1) = {
  x0: galleryWorld(minimum(rentalPlan(stall, lx0, lz0)[0], rentalPlan(stall, lx1, lz1)[0]), 0, 0)[0]
  x1: galleryWorld(maximum(rentalPlan(stall, lx0, lz0)[0], rentalPlan(stall, lx1, lz1)[0]), 0, 0)[0]
  z0: galleryWorld(0, 0, minimum(rentalPlan(stall, lx0, lz0)[1], rentalPlan(stall, lx1, lz1)[1]))[2]
  z1: galleryWorld(0, 0, maximum(rentalPlan(stall, lx0, lz0)[1], rentalPlan(stall, lx1, lz1)[1]))[2]
  y0: (galleryFloor[toyboxLevel] - 0.5)
  y1: (galleryFloor[toyboxLevel] + 1)
}
// The floor before a device: its 0.19 m along the arm, the 0.95 m before the counter.
function rentalDeviceReach(d) = ((rentalModels[d.model].arm == 0) ? rentalReachBox(
  rentalStalls[d.stall],
  (0 - rentalReachDepth),
  ((0 - rentalAlong(d.colour)) - (rentalPitch / 2)),
  (0 - rentalCounterHalfDepth),
  ((rentalPitch / 2) - rentalAlong(d.colour))
) : rentalReachBox(
  rentalStalls[d.stall],
  (rentalAlong(d.colour) - (rentalPitch / 2)),
  rentalCounterHalfDepth,
  (rentalAlong(d.colour) + (rentalPitch / 2)),
  rentalReachDepth
))
// The returns tray's floor: the square before the counter's outer corner.
function rentalReturnReach(stall) = rentalReachBox(
  stall,
  (0 - rentalReachDepth),
  rentalCounterHalfDepth,
  (0 - rentalCounterHalfDepth),
  rentalReachDepth
)

// Whether a body may rent or return: one of the seats' bodies. A size or pass condition joins here.
function rentalCanRent() = (rentalHolder[$each] > 0)

// The cartridge rack: the deck library's titles (toybox.puck's `toyboxLibrary`) as cartridges a body rents and inserts
// into a toybox station's deck. A slot is a library title number and the copies of it the rack lends; the shipped titles
// are 1 and 2, and the slots after them hold whatever the owner's local deck folder lists, in its listing order, so their
// labels name the title's number rather than a file. A slot whose title the library does not hold still lends its
// cartridge, and a deck it is inserted into runs its own program.
let rentalCartridgeSlots = [
  { title: 1, label: "COLOUR BARS", copies: 2 }
  { title: 2, label: "MOVING SPRITE", copies: 2 }
  { title: 3, label: "DECK TITLE 3", copies: 1 }
  { title: 4, label: "DECK TITLE 4", copies: 1 }
  { title: 5, label: "DECK TITLE 5", copies: 1 }
  { title: 6, label: "DECK TITLE 6", copies: 1 }
]
// Every cartridge, each by its loan ordinal, which follows the devices' in the one loan row (`rentalLoan`), its slot and
// its place on the rack.
let rentalCartridges = flatMap(
  range(0, length(rentalCartridgeSlots)),
  s => map(range(0, rentalCartridgeSlots[s].copies), c => { slot: s, copy: c })
)
let rentalCartridgeItems = map(
  range(0, length(rentalCartridges)),
  n => (rentalCartridges[n] with { ordinal: (length(rentalDevices) + n + 1), place: n })
)
// A cartridge in a station's deck is on loan to the station: its loan reads `rentalStationLoan` plus the station's place
// in toyboxStations.
let rentalStationLoan = 1000
// The rack stands on level 1's south gallery in bay 9, against the wall, facing the nave (+z); its cartridges stand on
// its top 0.14 m apart, the first at its west end, and the returns tray is its east end.
let rentalRackAt = [bayX(9), tileZ((wallRowSouth + 1))]
let rentalRackTop = 0.9
let rentalRackHalfWidth = (((length(rentalCartridgeItems) + 2) * 0.14) / 2)
function rentalRackX(n) = ((rentalRackAt[0] - rentalRackHalfWidth) + (0.14 * (n + 1)))
function rentalRackReach(x0, x1) = {
  x0: galleryWorld(x0, 0, 0)[0]
  x1: galleryWorld(x1, 0, 0)[0]
  z0: galleryWorld(0, 0, (rentalRackAt[1] + 0.3))[2]
  z1: galleryWorld(0, 0, (rentalRackAt[1] + 1.4))[2]
  y0: (galleryFloor[toyboxLevel] - 0.5)
  y1: (galleryFloor[toyboxLevel] + 1)
}
function rentalCartridgePrototype(slot) = $"rental-cartridge-{slot}"

// The wonder keys, each by its loan ordinal, which follows the cartridges' in the one loan row.
let rentalKeyCount = 4
let rentalKeyItems = map(
  range(0, rentalKeyCount),
  n => { ordinal: (length(rentalDevices) + length(rentalCartridgeItems) + n + 1), place: n }
)
// The key stand stands on level 3's south gallery 3.4 m in from the balcony edge where the tree's south branch lands,
// its front toward the nave (+z); its keys stand on its top `rentalKeyPitch` apart from its west end, and its east end
// is the returns tray.
let rentalKeyAt = [treeLanding(3, "south"), (naveSouth - 3.4)]
let rentalKeyTop = 0.9
let rentalKeyHalfWidth = 0.6
let rentalKeyPitch = 0.2
function rentalKeyX(n) = ((rentalKeyAt[0] - 0.45) + (rentalKeyPitch * n))
// The floor before the stand between two plan x, on level 3, in world coordinates.
function rentalKeyReach(x0, x1) = {
  x0: galleryWorld(x0, 0, 0)[0]
  x1: galleryWorld(x1, 0, 0)[0]
  z0: galleryWorld(0, 0, (rentalKeyAt[1] + 0.25))[2]
  z1: galleryWorld(0, 0, (rentalKeyAt[1] + 1.2))[2]
  y0: (galleryFloor[3] - 0.5)
  y1: (galleryFloor[3] + 1)
}
// Where a lent key may go, in world coordinates: the gallery's whole box, its projecting wing and the canopy over its
// roof included. A holder outside it, or absent from the world (standing at the origin, outside it), gives it back.
let rentalKeyBounds = {
  x0: galleryWorld((galleryWestOut - 1), 0, 0)[0]
  x1: galleryWorld((galleryWidth + 1), 0, 0)[0]
  z0: galleryWorld(0, 0, (wingSouth - 1))[2]
  z1: galleryWorld(0, 0, (galleryDepth + 1))[2]
  y0: (galleryFloor[0] - 1)
  y1: (galleryRoof + 4)
}

state {
  world {
    // The one loan row: a device's, a cartridge's or a key's ordinal is 0 while it is on its stall, rack or stand, N + 1
    // while body N holds it, and `rentalStationLoan` plus a station's place while a cartridge sits in that station's deck.
    row {
      name: "rentalLoan"
      kind: Int
      capacity: ((length(rentalDevices) + length(rentalCartridgeItems)) + length(rentalKeyItems))
      cells: map(
        flatMap([rentalDevices, rentalCartridgeItems, rentalKeyItems], items => items),
        d => { key: $"{d.ordinal}", value: 0 }
      )
    }
    // The key a seat's body holds (its loan ordinal), 0 for none, and how it shows: 0 none, 1 switched on, 2 off.
    row {
      name: "rentalKeyHeld"
      kind: Int
      capacity: length(rentalBodies)
      cells: map(rentalBodies, b => { key: $"{b}", value: 0 })
    }
    row {
      name: "rentalKeyShown"
      kind: Int
      capacity: length(rentalBodies)
      cells: map(rentalBodies, b => { key: $"{b}", value: 0 })
    }
    // The library title each cartridge carries.
    row {
      name: "rentalCartridgeTitle"
      kind: Int
      capacity: length(rentalCartridgeItems)
      cells: map(rentalCartridgeItems, c => { key: $"{c.ordinal}", value: rentalCartridgeSlots[c.slot].title })
    }
    // The cartridge a seat's body holds (its loan ordinal), 0 for none; a body holds one cartridge beside a device.
    row {
      name: "rentalCartridgeHeld"
      kind: Int
      capacity: length(rentalBodies)
      cells: map(rentalBodies, b => { key: $"{b}", value: 0 })
    }
    row {
      name: "rentalDevice"
      kind: Text
      capacity: length(rentalDevices)
      cells: map(rentalDevices, d => { key: $"{d.ordinal}", value: d.id })
    }
    row {
      name: "rentalOrdinal"
      kind: Int
      capacity: length(rentalDevices)
      cells: map(rentalDevices, d => { key: $"{d.ordinal}", value: d.ordinal })
    }
    row {
      name: "rentalDeviceModel"
      kind: Int
      capacity: length(rentalDevices)
      cells: map(rentalDevices, d => { key: $"{d.ordinal}", value: rentalModels[d.model].model })
    }
    row {
      name: "rentalDeviceColour"
      kind: Text
      capacity: length(rentalDevices)
      cells: map(rentalDevices, d => { key: $"{d.ordinal}", value: rentalColours[d.model][d.colour].name })
    }
    row {
      name: "rentalHeld"
      kind: Int
      capacity: length(rentalBodies)
      cells: map(rentalBodies, b => { key: $"{b}", value: 0 })
    }
    row {
      name: "rentalModel"
      kind: Int
      capacity: length(rentalBodies)
      cells: map(rentalBodies, b => { key: $"{b}", value: 0 })
    }
    // Where a body's device shows: its ordinal while it rides the hip, its ordinal plus `rentalPlayed` while the body
    // plays it in its hands (engaged on its screen), 0 while it holds none.
    row {
      name: "rentalShown"
      kind: Int
      capacity: length(rentalBodies)
      cells: map(rentalBodies, b => { key: $"{b}", value: 0 })
    }
    // The number a loan names each seat's body by, its index + 1: fixed.
    row {
      name: "rentalHolder"
      kind: Int
      capacity: length(rentalBodies)
      cells: map(rentalBodies, b => { key: $"{b}", value: (b + 1) })
    }
  }
}

// A device's creation, standing on its base with its face toward -Z (the side a placement's yaw turns to face): a
// brick is 75 x 133 x 27.5 mm upright, an advanced brick 144 x 82 x 25 mm landscape. Each shell is its colourway's
// plastic, its screen dark glass behind a bezel, its pad and buttons the colourway's keys.
let rentalBezel = { color: "#1A1820", roughness: 0.2, specular: 0.05 }
let rentalGlass = { color: "#0E1418", roughness: 0.06, specular: 0.06, coat: 0.6 }
function rentalPalette(c) = [
  { color: c.shell, roughness: 0.3, specular: 0.04, coat: 0.5 }
  rentalBezel
  rentalGlass
  { color: c.key, roughness: 0.35, specular: 0.04 }
]
// Each glass is its model's picture box: the box a carried device's screen shows its game on (`screen-hgb`,
// `screen-agb`, named by the screens below), its half-extents the picture's, 160 by 144 and 240 by 160 pixels.
template rentalBrick(c) {
  shape Box "shell" {
    material: 0
    position [0, 0.0665, 0]
    scale [0.0375, 0.0665, 0.01375]
    rounding: 0.006
  }
  shape Box "bezel" {
    material: 1
    position [0, 0.095, 0.0135]
    scale [0.031, 0.026, 0.0015]
    rounding: 0.0012
  }
  shape Box "screen-hgb" {
    material: 2
    position [0, 0.096, 0.0146]
    scale [0.022, 0.0198, 0.0008]
  }
  shape Box "pad-x" {
    material: 3
    position [-0.019, 0.042, 0.0142]
    scale [0.0095, 0.003, 0.0015]
    rounding: 0.001
  }
  shape Box "pad-y" {
    material: 3
    position [-0.019, 0.042, 0.0142]
    scale [0.003, 0.0095, 0.0015]
    rounding: 0.001
  }
  shape Cylinder "a" {
    material: 3
    position [0.024, 0.046, 0.0142]
    rotation [-0.7071, 0, 0, 0.7071]
    scale [0.0045, 0.0015, 0.0045]
  }
  shape Cylinder "b" {
    material: 3
    position [0.012, 0.04, 0.0142]
    rotation [-0.7071, 0, 0, 0.7071]
    scale [0.0045, 0.0015, 0.0045]
  }
}
template rentalAdvanced(c) {
  shape Box "shell" {
    material: 0
    position [0, 0.041, 0]
    scale [0.072, 0.041, 0.0125]
    rounding: 0.012
  }
  shape Box "bezel" {
    material: 1
    position [0, 0.043, 0.0122]
    scale [0.038, 0.027, 0.0015]
    rounding: 0.0012
  }
  shape Box "screen-agb" {
    material: 2
    position [0, 0.043, 0.0133]
    scale [0.0306, 0.0204, 0.0008]
  }
  shape Box "pad-x" {
    material: 3
    position [-0.054, 0.045, 0.0128]
    scale [0.009, 0.003, 0.0015]
    rounding: 0.001
  }
  shape Box "pad-y" {
    material: 3
    position [-0.054, 0.045, 0.0128]
    scale [0.003, 0.009, 0.0015]
    rounding: 0.001
  }
  shape Cylinder "a" {
    material: 3
    position [0.058, 0.049, 0.0128]
    rotation [-0.7071, 0, 0, 0.7071]
    scale [0.0045, 0.0015, 0.0045]
  }
  shape Cylinder "b" {
    material: 3
    position [0.048, 0.042, 0.0128]
    rotation [-0.7071, 0, 0, 0.7071]
    scale [0.0045, 0.0015, 0.0045]
  }
}

// A wonder key, 15 cm long, standing on its bit with its bow up: a brass shank and bow, the bow ringing a gem in the
// barrier's violet (look.puck's lookBarrier), dark glass while the key is off and glowing while it is on.
let rentalKeyBrass = { color: "#D9A441", roughness: 0.25, metal: 1 }
let rentalKeyKinds = [
  { id: "rental-key", name: "WONDER KEY (off)", gem { color: "#2E2A44", roughness: 0.08, specular: 0.06, coat: 0.6 } }
  { id: "rental-key-lit", name: "WONDER KEY", gem { color: lookBarrier.colors[5], roughness: 0.08, emissive: 320nit } }
]
template rentalKey() {
  shape Cylinder "shank" {
    material: 0
    position [0, 0.06, 0]
    scale [0.006, 0.05, 0.006]
  }
  shape Box "bit" {
    material: 0
    position [0.012, 0.022, 0]
    scale [0.01, 0.012, 0.003]
    rounding: 0.002
  }
  shape Torus "bow" {
    material: 0
    position [0, 0.14, 0]
    rotation [-0.7071068, 0, 0, 0.7071068]
    scale [0.028, 0.028, 0.028]
  }
  shape Cylinder "gem" {
    material: 1
    position [0, 0.14, 0]
    rotation [-0.7071068, 0, 0, 0.7071068]
    scale [0.019, 0.004, 0.019]
  }
}

// The stand and the rack share a plain counter palette: the level's sunflower, cobalt and candy pink, and cream.
let rentalCounterPalette = [
  { color: lookLevelToybox.tileTone, roughness: 0.3, specular: 0.04, coat: 0.5 }
  { color: lookLevelToybox.tile, roughness: 0.35, specular: 0.04 }
  { color: lookLevelToybox.coffer, roughness: 0.25, specular: 0.04, coat: 0.6 }
  { color: lookLevelToybox.grout, roughness: 0.4, specular: 0.04 }
]

// The kiosk: a stall's counter, a creation in the stall's own frame (`rentalPlan`'s lx, lz). Each arm is built once in
// its own terms, `u` along the arm from the corner and `v` out toward its customers (arm 0 runs down the stall's -z with
// its customers at -x, arm 1 along +x with its customers at +z), and `rentalArmPoint` puts a point there in the stall's
// frame (arm 0: x = -v, z = -u; arm 1: x = u, z = v). The arms are mirror images across the L's diagonal, so one
// template builds both.
// The slots of the palette below, by role.
let rentalKiosk = { body: 0, trim: 1, bezel: 2, plate: 3, canopy: 4, neon: 5, back: 7, sign: 9, ink: 10 }
let rentalKioskPalette = [
  { color: lookRentalKiosk.body, roughness: 0.3, specular: 0.04, coat: 0.5 }
  { color: lookRentalKiosk.trim, roughness: 0.3, specular: 0.04, coat: 0.5 }
  { color: lookCabinetBezel, roughness: 0.12, specular: 0.05, coat: 0.6 }
  { color: lookRentalKiosk.plate, roughness: 0.4, specular: 0.04 }
  { color: lookRentalKiosk.canopy, roughness: 0.3, specular: 0.04, coat: 0.5 }
  { color: lookRentalKiosk.neon[0], roughness: 0.4, emissive: lookCabinetNeonGlow }
  { color: lookRentalKiosk.neon[1], roughness: 0.4, emissive: lookCabinetNeonGlow }
  { color: lookRentalKiosk.backlight[0], roughness: 0.4, emissive: lookRentalKioskBackGlow }
  { color: lookRentalKiosk.backlight[1], roughness: 0.4, emissive: lookRentalKioskBackGlow }
  { color: lookRentalKiosk.sign, roughness: 0.4, emissive: lookCabinetGlow }
  { color: lookCabinetInk, roughness: 0.5, specular: 0.04 }
]
function rentalArmPoint(arm, u, y, v) = ((arm == 0) ? [(0 - v), y, (0 - u)] : [u, y, v])
function rentalArmScale(arm, hu, hy, hv) = ((arm == 0) ? [hv, hy, hu] : [hu, hy, hv])
// The turn about +Y that carries a text run's face (its local +Z) onto the arm's customers.
function rentalArmTurn(arm) = ((arm == 0) ? 270 : 0)
// A line of lettering on an arm's customer side, its capitals centred on (u, y) at depth v.
function rentalArmLetters(arm, u, y, v, text, em, width) = {
  text: text
  position: rentalArmPoint(arm, u, y, v)
  rotation: rotate([0, 1, 0], rentalArmTurn(arm))
  emHeight: em
  depth: 0.004
  mode: "emboss"
  material: rentalKiosk.ink
  align: "center"
  anchor: "capMiddle"
  maxWidth: width
}
// The corner's blade sign, its face (local +Z) turned to the diagonal the corner's customers come from (the stall's -x,
// +z), and a point `d` out of its face.
let rentalBladeAt = [-0.1, 2.95, 0.1]
let rentalBladeTurn = 315
function rentalBladePoint(d, y) = [(rentalBladeAt[0] - (0.70711 * d)), y, (rentalBladeAt[2] + (0.70711 * d))]
// The cubbies' clear height over the counter: a brick is 0.133 m tall and an advanced brick 0.082 m.
function rentalCubbyHeight(arm) = ((arm == 0) ? 0.22 : 0.15)

// A box of an arm, from its centre and half-extents along (u, y, v); a fine part is detail unless it is the body a
// player's contact reads.
template rentalKioskBox(label, arm, material, u, y, v, hu, hy, hv, rounding = 0, detail = true) {
  shape Box $"{label}" {
    material: material
    position: rentalArmPoint(arm, u, y, v)
    scale: rentalArmScale(arm, hu, hy, hv)
    rounding: rounding
    detail: detail
  }
}

// One arm. From the floor: a dark kick plate recessed under the cabinet and its underglow, the cobalt body with a lit
// reveal under the sunflower counter lip, and a number plate for each device on its front. On the lip a display shelf:
// a glowing back, a frame post between devices, and a candy-pink lintel with a lit underside. Above, a header naming the
// arm on posts and a canopy with a lit front edge. The body and kick are the solid; every other part is detail.
template rentalKioskArm(arm) {
  let top = rentalCounterTop
  let h = rentalCubbyHeight(arm)
  let neon = (rentalKiosk.neon + arm)
  let mid = (rentalFirst + ((rentalPitch * (rentalPerModel - 1)) / 2))
  let shelfHalf = ((rentalPitch * rentalPerModel) / 2)
  rentalKioskBox(
    label: $"kick-{arm}",
    arm: arm,
    material: rentalKiosk.bezel,
    u: ((rentalArmLength - rentalCounterHalfDepth) / 2),
    y: 0.06,
    v: 0,
    hu: ((rentalArmLength + rentalCounterHalfDepth) / 2),
    hy: 0.06,
    hv: 0.2,
    rounding: 0.012,
    detail: false
  )
  rentalKioskBox(
    label: $"underglow-{arm}",
    arm: arm,
    material: neon,
    u: ((rentalArmLength - rentalCounterHalfDepth) / 2),
    y: 0.135,
    v: 0.2,
    hu: 1.35,
    hy: 0.008,
    hv: 0.008
  )
  rentalKioskBox(
    label: $"body-{arm}",
    arm: arm,
    material: rentalKiosk.body,
    u: ((rentalArmLength - rentalCounterHalfDepth) / 2),
    y: 0.47,
    v: 0,
    hu: ((rentalArmLength + rentalCounterHalfDepth) / 2),
    hy: 0.35,
    hv: rentalCounterHalfDepth,
    rounding: 0.012,
    detail: false
  )
  rentalKioskBox(
    label: $"reveal-{arm}",
    arm: arm,
    material: neon,
    u: ((rentalArmLength - rentalCounterHalfDepth) / 2),
    y: 0.83,
    v: rentalCounterHalfDepth,
    hu: (((rentalArmLength + rentalCounterHalfDepth) / 2) - 0.03),
    hy: 0.01,
    hv: 0.012
  )
  rentalKioskBox(
    label: $"lip-{arm}",
    arm: arm,
    material: rentalKiosk.trim,
    u: ((rentalArmLength - rentalCounterHalfDepth) / 2),
    y: (top - 0.055),
    v: 0,
    hu: (((rentalArmLength + rentalCounterHalfDepth) / 2) + 0.03),
    hy: 0.055,
    hv: (rentalCounterHalfDepth + 0.02),
    rounding: 0.012,
    detail: false
  )
  rentalKioskBox(
    label: $"plate-returns-{arm}",
    arm: arm,
    material: rentalKiosk.plate,
    u: 0,
    y: 0.47,
    v: rentalCounterHalfDepth,
    hu: 0.21,
    hy: 0.04,
    hv: 0.004
  )
  for n in range(0, rentalPerModel) {
    rentalKioskBox(
      label: $"plate-{arm}-{n}",
      arm: arm,
      material: rentalKiosk.plate,
      u: rentalAlong(n),
      y: 0.47,
      v: rentalCounterHalfDepth,
      hu: 0.05,
      hy: 0.035,
      hv: 0.004
    )
  }
  // The shelf behind the devices (their backs stand 0.086 m out of the arm's centre line).
  rentalKioskBox(
    label: $"back-{arm}",
    arm: arm,
    material: (rentalKiosk.back + arm),
    u: mid,
    y: (top + (h / 2)),
    v: 0.051,
    hu: (shelfHalf + 0.006),
    hy: (h / 2),
    hv: 0.021
  )
  for k in range(0, rentalPerModel + 1) {
    rentalKioskBox(
      label: $"post-{arm}-{k}",
      arm: arm,
      material: rentalKiosk.bezel,
      u: (rentalFirst - (rentalPitch / 2) + (rentalPitch * k)),
      y: (top + (h / 2)),
      v: 0.135,
      hu: 0.006,
      hy: (h / 2),
      hv: 0.105
    )
  }
  rentalKioskBox(
    label: $"lintel-{arm}",
    arm: arm,
    material: rentalKiosk.canopy,
    u: mid,
    y: (top + h + 0.02),
    v: 0.135,
    hu: (shelfHalf + 0.03),
    hy: 0.02,
    hv: 0.115,
    rounding: 0.01
  )
  rentalKioskBox(
    label: $"lintel-light-{arm}",
    arm: arm,
    material: neon,
    u: mid,
    y: (top + h - 0.004),
    v: 0.14,
    hu: shelfHalf,
    hy: 0.004,
    hv: 0.09
  )
  // The header and its posts, and the canopy over them reaching out over the customers.
  rentalKioskBox(
    label: $"mast-{arm}",
    arm: arm,
    material: rentalKiosk.bezel,
    u: 2.52,
    y: 1.7,
    v: -0.2,
    hu: 0.03,
    hy: 0.75,
    hv: 0.03,
    rounding: 0.01
  )
  rentalKioskBox(
    label: $"header-{arm}",
    arm: arm,
    material: rentalKiosk.trim,
    u: 1.45,
    y: 2.12,
    v: -0.05,
    hu: 1.15,
    hy: 0.2,
    hv: 0.15,
    rounding: 0.015
  )
  shape Box $"header-sign-{arm}" {
    material: rentalKiosk.sign
    position: rentalArmPoint(arm, 1.45, 2.12, 0.104)
    rotation: rotate([0, 1, 0], 180)
    scale: rentalArmScale(arm, 1.08, 0.15, 0.012)
    lightsAs: Face
    detail: true
  }
  rentalKioskBox(
    label: $"canopy-{arm}",
    arm: arm,
    material: rentalKiosk.canopy,
    u: 1.05,
    y: 2.47,
    v: 0.15,
    hu: 1.65,
    hy: 0.03,
    hv: 0.45,
    rounding: 0.012
  )
  rentalKioskBox(
    label: $"canopy-lip-{arm}",
    arm: arm,
    material: rentalKiosk.trim,
    u: 1.05,
    y: 2.43,
    v: 0.6,
    hu: 1.65,
    hy: 0.06,
    hv: 0.02,
    rounding: 0.01
  )
  rentalKioskBox(
    label: $"canopy-light-{arm}",
    arm: arm,
    material: neon,
    u: 1.05,
    y: 2.43,
    v: 0.625,
    hu: 1.6,
    hy: 0.01,
    hv: 0.008
  )
}

prototypes {
  prototype "rental-counter" {
    occlusion: propOcclusion
    document {
      name: "rental-counter"
      schema: "puck.creation.v2"
      palette: rentalKioskPalette
      for arm in [0, 1] {
        rentalKioskArm(arm)
      }
      // The corner: the returns tray, lit round its slot, the post both headers meet at, and the blade sign on its own
      // post over the canopy.
      shape Box "tray-light" {
        material: rentalKiosk.neon
        position [0, (rentalCounterTop + 0.002), 0]
        scale [0.2, 0.004, 0.2]
        detail: true
      }
      shape Box "tray" {
        material: rentalKiosk.bezel
        position [0, (rentalCounterTop + 0.008), 0]
        scale [0.17, 0.008, 0.17]
        rounding: 0.006
        detail: true
      }
      rentalKioskBox(
        label: "mast-corner",
        arm: 1,
        material: rentalKiosk.bezel,
        u: 0.2,
        y: 1.7,
        v: -0.2,
        hu: 0.03,
        hy: 0.75,
        hv: 0.03,
        rounding: 0.01
      )
      rentalKioskBox(
        label: "blade-mast",
        arm: 1,
        material: rentalKiosk.bezel,
        u: 0.05,
        y: 2.65,
        v: -0.05,
        hu: 0.04,
        hy: 0.2,
        hv: 0.04,
        rounding: 0.012
      )
      shape Box "blade" {
        material: rentalKiosk.trim
        position: rentalBladePoint(0, rentalBladeAt[1])
        rotation: rotate([0, 1, 0], rentalBladeTurn)
        scale [0.74, 0.17, 0.03]
        rounding: 0.02
        detail: true
      }
      shape Box "blade-sign" {
        material: rentalKiosk.sign
        position: rentalBladePoint(0.016, rentalBladeAt[1])
        rotation: rotate([0, 1, 0], rentalBladeTurn)
        scale [0.7, 0.13, 0.03]
        lightsAs: Face
        detail: true
      }
      textRuns [
        for arm in [0, 1] {
          rentalArmLetters(arm, 1.45, 2.12, 0.118, rentalModels[arm].title, 0.15, 2.05)
        }
        for arm in [0, 1] {
          rentalArmLetters(arm, 0, 0.47, 0.256, "RETURNS", 0.045, 0.38)
        }
        for n in flatMap([0, 1], arm => map(range(0, rentalPerModel), n => { arm: arm, n: n })) {
          rentalArmLetters(n.arm, rentalAlong(n.n), 0.47, 0.256, rentalNumber(n.n + 1), 0.05, 0.09)
        }
        {
          text: "HANDHELD RENTALS"
          position: rentalBladePoint(0.05, rentalBladeAt[1])
          rotation: rotate([0, 1, 0], rentalBladeTurn)
          emHeight: 0.14
          depth: 0.004
          mode: "emboss"
          material: rentalKiosk.ink
          align: "center"
          anchor: "capMiddle"
          maxWidth: 1.34
        }
      ]
    }
  }
  // The key stand: a pedestal in the stalls' colours, its top at rentalKeyTop, the returns tray inset at its east end
  // (+x).
  prototype "rental-key-stand" {
    document {
      name: "rental-key-stand"
      schema: "puck.creation.v2"
      palette: rentalCounterPalette
      shape Box "body" {
        material: 0
        position [0, ((rentalKeyTop - 0.04) / 2), 0]
        scale [rentalKeyHalfWidth, ((rentalKeyTop - 0.04) / 2), 0.18]
        rounding: 0.03
      }
      shape Box "top" {
        material: 2
        position [0, (rentalKeyTop - 0.02), 0]
        scale [(rentalKeyHalfWidth + 0.02), 0.02, 0.2]
        rounding: 0.015
      }
      shape Box "tray" {
        material: 3
        position [(rentalKeyHalfWidth - 0.1), (rentalKeyTop + 0.01), 0]
        scale [0.08, 0.012, 0.12]
        rounding: 0.01
      }
    }
  }
  // A wonder key, lit while it is switched on and dull while it is off.
  for kind in rentalKeyKinds {
    prototype $"{kind.id}" {
      document {
        name: kind.name
        schema: "puck.creation.v2"
        palette [rentalKeyBrass, kind.gem]
        rentalKey()
      }
    }
  }
  // The cartridge rack: a counter in the stalls' colours, its top at rentalRackTop, the returns tray inset at its east
  // end (+x). Its front faces -Z, the creation's front.
  prototype "rental-cartridge-rack" {
    occlusion: propOcclusion
    document {
      name: "rental-cartridge-rack"
      schema: "puck.creation.v2"
      palette: rentalCounterPalette
      shape Box "body" {
        material: 0
        position [0, ((rentalRackTop - 0.04) / 2), 0]
        scale [rentalRackHalfWidth, ((rentalRackTop - 0.04) / 2), 0.2]
        rounding: 0.03
      }
      shape Box "top" {
        material: 2
        position [0, (rentalRackTop - 0.02), 0]
        scale [(rentalRackHalfWidth + 0.02), 0.02, 0.22]
        rounding: 0.015
      }
      shape Box "tray" {
        material: 3
        position [(rentalRackHalfWidth - 0.1), (rentalRackTop + 0.01), -0.02]
        scale [0.08, 0.012, 0.12]
        rounding: 0.01
      }
    }
  }
  // A deck cartridge for each rack slot, standing on its base with its label toward +Z: a graphite shell 120 by 135 by
  // 20 mm, its label the slot's.
  for (slot, s) in rentalCartridgeSlots {
    prototype $"rental-cartridge-{s}" {
      document {
        name: slot.label
        schema: "puck.creation.v2"
        palette [
          { color: "#2E2E33", roughness: 0.45, specular: 0.04 }
          { color: "#EDE6D3", roughness: 0.6, specular: 0.03 }
          { color: "#1C1C1E", roughness: 0.5, specular: 0.04 }
        ]
        shape Box "shell" {
          material: 0
          position [0, 0.0675, 0]
          scale [0.06, 0.0675, 0.01]
          rounding: 0.003
        }
        shape Box "label" {
          material: 1
          position [0, 0.08, -0.0098]
          scale [0.048, 0.04, 0.0006]
        }
        textRuns [
          {
            text: slot.label
            position [0, 0.08, -0.0106]
            rotation [0, 1, 0, 0]
            emHeight: 0.011
            depth: 0.0006
            mode: "emboss"
            material: 2
            align: "center"
          }
        ]
      }
    }
  }
  prototype "rental-device-empty" {
    document {
      name: "rental-device-empty"
      schema: "puck.creation.v2"
      palette [rentalBezel]
    }
  }
  for (model, m) in rentalModels {
    for c in rentalColours[m] {
      prototype $"rental-{model.id}-{c.name}" {
        document {
          name: $"{model.title} ({c.name})"
          schema: "puck.creation.v2"
          palette: rentalPalette(c)
          for k in filter([0], k => (m == 0)) {
            rentalBrick(c)
          }
          for k in filter([0], k => (m == 1)) {
            rentalAdvanced(c)
          }
        }
      }
    }
  }
}

placements {
  for stall in rentalStalls {
    placement $"rental-counter-{stall.id}" {
      prototype: "rental-counter"
      parent: "gallery"
      position [stall.x, galleryFloor[toyboxLevel], stall.z]
      yawDegrees: stall.yaw
      solid
    }
    reach(id: $"rental-return-{stall.id}", box: rentalReturnReach(stall))
  }
  // Each device in its cubby, until it is on loan.
  for d in rentalDevices {
    placement $"rental-{d.id}" {
      prototype: rentalPrototype(d)
      parent: "gallery"
      position [rentalDeviceAt(d)[0], (galleryFloor[toyboxLevel] + rentalCounterTop), rentalDeviceAt(d)[1]]
      yawDegrees: ((rentalStalls[d.stall].yaw + rentalArmYaw(rentalModels[d.model].arm)) % 360)
      respond [
        {
          when: state(state: rentalLoan, key: $"{d.ordinal}", comparison: NotEqual, value: 0)
          prototypeId: "rental-device-empty"
        }
      ]
    }
    reach(id: $"rental-reach-{d.ordinal}", box: rentalDeviceReach(d))
  }
  // The cartridge rack, each cartridge on it until it is on loan, the floor before each, and the returns tray's floor.
  placement "rental-cartridge-rack" {
    prototype: "rental-cartridge-rack"
    parent: "gallery"
    position [rentalRackAt[0], galleryFloor[toyboxLevel], rentalRackAt[1]]
    solid
  }
  reach(
    id: "rental-cartridge-return",
    box: rentalRackReach((rentalRackAt[0] + rentalRackHalfWidth - 0.2), (rentalRackAt[0] + rentalRackHalfWidth))
  )
  for c in rentalCartridgeItems {
    placement $"rental-cartridge-{c.ordinal}" {
      prototype: rentalCartridgePrototype(c.slot)
      parent: "gallery"
      position [rentalRackX(c.place), (galleryFloor[toyboxLevel] + rentalRackTop), (rentalRackAt[1] + 0.05)]
      respond [
        {
          when: state(state: rentalLoan, key: $"{c.ordinal}", comparison: NotEqual, value: 0)
          prototypeId: "rental-device-empty"
        }
      ]
    }
    reach(
      id: $"rental-cartridge-reach-{c.ordinal}",
      box: rentalRackReach((rentalRackX(c.place) - 0.07), (rentalRackX(c.place) + 0.07))
    )
  }
  // The cartridge a seat's body holds rides its right hip, its label out.
  for b in rentalBodies {
    placement $"rental-cartridge-carried-{b}" {
      prototype: "rental-device-empty"
      position [0, 0, 0]
      attach {
        bodyIndex: b
        localOffset [0.3, 0.92, -0.38]
      }
      respond: map(
        rentalCartridgeItems,
        c => {
          when: state(state: rentalCartridgeHeld, key: $"{b}", comparison: Equal, value: c.ordinal)
          prototypeId: rentalCartridgePrototype(c.slot)
        }
      )
    }
  }
  // The key stand on level 3, each key on it until it is on loan, the floor before each, and the returns tray's floor.
  placement "rental-key-stand" {
    prototype: "rental-key-stand"
    parent: "gallery"
    position [rentalKeyAt[0], galleryFloor[3], rentalKeyAt[1]]
    solid
  }
  reach(
    id: "rental-key-return",
    box: rentalKeyReach(((rentalKeyAt[0] + rentalKeyHalfWidth) - 0.25), (rentalKeyAt[0] + rentalKeyHalfWidth))
  )
  for k in rentalKeyItems {
    placement $"rental-key-{k.ordinal}" {
      prototype: "rental-key-lit"
      parent: "gallery"
      position [rentalKeyX(k.place), (galleryFloor[3] + rentalKeyTop), (rentalKeyAt[1] + 0.05)]
      respond [
        {
          when: state(state: rentalLoan, key: $"{k.ordinal}", comparison: NotEqual, value: 0)
          prototypeId: "rental-device-empty"
        }
      ]
    }
    reach(
      id: $"rental-key-reach-{k.ordinal}",
      box: rentalKeyReach((rentalKeyX(k.place) - (rentalKeyPitch / 2)), (rentalKeyX(k.place) + (rentalKeyPitch / 2)))
    )
  }
  // The key a seat's body holds hangs on a cord at its chest, a little right of centre, its face out: lit while it is
  // switched on, dull while it is off.
  for b in rentalBodies {
    placement $"rental-key-carried-{b}" {
      prototype: "rental-device-empty"
      position [0, 0, 0]
      attach {
        bodyIndex: b
        localOffset [0.16, 1.3, -0.42]
        localYawDegrees: 180
      }
      respond [
        { when: state(state: rentalKeyShown, key: $"{b}", comparison: Equal, value: 1), prototypeId: "rental-key-lit" }
        { when: state(state: rentalKeyShown, key: $"{b}", comparison: Equal, value: 2), prototypeId: "rental-key" }
      ]
    }
  }
  // The device a seat's body holds rides its left hip (a body faces -Z, so -X is its left), its face out, and while the
  // body plays it, its hands, its face toward the body. Each row shows the device while `rentalShown` names it there.
  for b in rentalBodies {
    placement $"rental-carried-{b}" {
      prototype: "rental-device-empty"
      position [0, 0, 0]
      attach {
        bodyIndex: b
        localOffset [-0.3, 0.92, -0.38]
        localYawDegrees: 180
      }
      respond: map(
        rentalDevices,
        d => {
          when: state(state: rentalShown, key: $"{b}", comparison: Equal, value: d.ordinal)
          prototypeId: rentalPrototype(d)
        }
      )
    }
    placement $"rental-played-{b}" {
      prototype: "rental-device-empty"
      position [0, 0, 0]
      attach {
        bodyIndex: b
        localOffset [0, 1.3, -0.5]
      }
      respond: map(
        rentalDevices,
        d => {
          when: state(state: rentalShown, key: $"{b}", comparison: Equal, value: (d.ordinal + rentalPlayed))
          prototypeId: rentalPrototype(d)
        }
      )
    }
  }
}

// Each seat's two handheld screens, one for each pool machine, their pictures carried by the device their body holds:
// in its hands while it plays, at its hip otherwise (screens' `carry`, the first of the two rows showing the model's
// picture box). Only the holder engages its own device, wherever it stands, with the context button (the standard's
// device route), and the same press leaves. The screen rests where its frame is authored while nobody holds a device of
// its model, and draws nothing there.
let rentalScreen = 40
function rentalScreenOf(b, model) = (rentalScreen + (2 * b) + (model - 1))
let rentalScreenRest = rentalPlan(rentalStalls[0], 0, 0)
screens: flatMap(
  rentalBodies,
  b => map(
    rentalModels,
    m => {
      index: rentalScreenOf(b, m.model)
      origin: galleryWorld(rentalScreenRest[0], (galleryFloor[toyboxLevel] + rentalCounterTop), rentalScreenRest[1])
      right [1, 0, 0]
      up [0, 1, 0]
      halfWidth: ((m.model == 1) ? 0.022 : 0.0306)
      halfHeight: ((m.model == 1) ? 0.0198 : 0.0204)
      halfDepth: 0.0008
      round: 0
      source: machine(instance: $"rental-{m.id}-{b}", output: "video")
      luminance: ((m.model == 1) ? 70nit : 90nit)
      route: deviceRoute
      carry {
        shape: $"screen-{m.id}"
        placements [$"rental-played-{b}", $"rental-carried-{b}"]
      }
    }
  )
)

// Renting: a seat's body before a device in its cubby, holding none, presses the context button.
for d in rentalDevices {
  rule $"rental-rent-{d.ordinal}" {
    when pressing() and rentalCanRent() and rentalLoan[$"{d.ordinal}"] == 0 and rentalHeld[$each] == 0
    mode: Edge
    forEach: region($"rental-reach-{d.ordinal}")
    rentalLoan[$"{d.ordinal}"] = rentalHolder[$each]
    rentalHeld[$each] = d.ordinal
    rentalModel[$each] = rentalModels[d.model].model
  }
}

// Returning at a stall's tray: the device goes back to its cubby and the body lets go. A holder's press engages its own
// device (the context button's first target), so at the tray that engagement returns it, and the authority then
// releases the engagement on the device nobody holds.
for stall in rentalStalls {
  rule $"rental-return-{stall.id}" {
    when (pressing() or rentalShown[$each] > rentalPlayed) and rentalCanRent() and rentalHeld[$each] > 0
    mode: Edge
    forEach: region($"rental-return-{stall.id}")
    rentalLoan[rentalHeld[$each]] = 0
    rentalHeld[$each] = 0
    rentalModel[$each] = 0
  }
}

// Renting a cartridge: a seat's body before a cartridge on the rack, holding none, presses the context button. It goes
// on loan through the same row as a device.
for c in rentalCartridgeItems {
  rule $"rental-cartridge-rent-{c.ordinal}" {
    when pressing() and rentalCanRent() and rentalLoan[$"{c.ordinal}"] == 0 and rentalCartridgeHeld[$each] == 0
    mode: Edge
    forEach: region($"rental-cartridge-reach-{c.ordinal}")
    rentalLoan[$"{c.ordinal}"] = rentalHolder[$each]
    rentalCartridgeHeld[$each] = c.ordinal
  }
}

// Returning a cartridge at the rack's tray: it goes back to its place on the rack.
rule "rental-cartridge-return" {
  when pressing() and rentalCanRent() and rentalCartridgeHeld[$each] > 0
  mode: Edge
  forEach: region("rental-cartridge-return")
  rentalLoan[rentalCartridgeHeld[$each]] = 0
  rentalCartridgeHeld[$each] = 0
}

// Taking a key: a seat's body before a key on the stand, holding none, presses the context button. It goes on loan
// through the same row as a device, switched on.
for k in rentalKeyItems {
  rule $"rental-key-take-{k.ordinal}" {
    when pressing() and rentalCanRent() and rentalLoan[$"{k.ordinal}"] == 0 and rentalKeyHeld[$each] == 0
    mode: Edge
    forEach: region($"rental-key-reach-{k.ordinal}")
    rentalLoan[$"{k.ordinal}"] = rentalHolder[$each]
    rentalKeyHeld[$each] = k.ordinal
    rentalKeyShown[$each] = 1
  }
}

// Returning a key at the stand's tray.
rule "rental-key-return" {
  when pressing() and rentalCanRent() and rentalKeyHeld[$each] > 0
  mode: Edge
  forEach: region("rental-key-return")
  rentalLoan[rentalKeyHeld[$each]] = 0
  rentalKeyHeld[$each] = 0
  rentalKeyShown[$each] = 0
}

// The key toggle: a player's keyToggle channel switches the key that player's own body carries off and on, wherever
// it is.
rule "rental-key-toggle" {
  when channel(each, keyToggle) >= 1 and rentalKeyShown[$each] > 0
  mode: Edge
  forEach: $players
  rentalKeyShown[$each] = 3 - rentalKeyShown[$each]
}

// A key whose holder leaves the gallery, or the world, goes back to its stand.
rule "rental-key-leave" {
  when rentalKeyHeld[$each] > 0 and (bodyPosition(each, x) < rentalKeyBounds.x0 or
      bodyPosition(each, x) > rentalKeyBounds.x1 or
      bodyPosition(each, y) < rentalKeyBounds.y0 or
      bodyPosition(each, y) > rentalKeyBounds.y1 or
      bodyPosition(each, z) < rentalKeyBounds.z0 or
      bodyPosition(each, z) > rentalKeyBounds.z1)
  mode: Level
  forEach: rentalKeyHeld
  rentalLoan[rentalKeyHeld[$each]] = 0
  rentalKeyHeld[$each] = 0
  rentalKeyShown[$each] = 0
}

// The pass a carried key gives: each player's `wonderKey` register (wonder.puck) is 1 while its key shows switched
// on, the one fact every key rule above moves. The gate and the write read one local, so a firing closes its own gate.
rule "rental-key-pass" {
  local target = (rentalKeyShown[$each] == 1) ? 1.0 : 0.0
  when bodyState(each, wonderKey) != target
  mode: Level
  forEach: $players
  setBodyState(key: $each, state: "wonderKey", expression: target)
}

channels [
  { composition: true, name: "keyToggle", shape: Binary }
]

// The key toggle's controls: H on the resting page, and the pad's North under the right trigger (I with X held), the
// Debug page's free plate.
bindingOverlays [
  {
    id: "rental-key-keys"
    document {
      version: "puck.input.bindings.v1"
      modifiers: padModifiers
      chords [
        {
          chord []
          group: "play"
          page {
            id: "base"
            entries [
              {
                channel: "keyToggle"
                id: "keyToggle"
                label: "Key on/off"
                scale: 1
                sources ["keyboard.h"]
              }
            ]
          }
        }
        {
          chord ["rt"]
          group: "play"
          page {
            id: "pad-rt"
            inherits: "base"
            label: "Debug"
            entries [
              {
                channel: "keyToggle"
                id: "dbgKeyToggle"
                label: "Key on/off"
                scale: 1
                sources: padNorth
              }
            ]
          }
        }
      ]
    }
  }
]

// A station's console: the floor beside the station on its +x side, where the deck's cartridge slot is in reach. Engaging
// the station's screen from there (the context button) swaps the cartridge the body holds with the one in the deck: a
// held cartridge goes in and the deck runs its title (toybox.puck's `toyboxTitle`, its machine's `contentBy`), and a
// body with empty hands takes the deck's cartridge out, and the deck runs its own program again. The body plays the deck
// either way, and engaging from before the screen (the pads, the panels) plays it without touching the cartridge.
let toyboxConsoleOffset = 0.9
function toyboxConsoleReach(s) = {
  x0: galleryWorld((toyboxAt(s)[0] + toyboxConsoleOffset - 0.4), 0, 0)[0]
  x1: galleryWorld((toyboxAt(s)[0] + toyboxConsoleOffset + 0.4), 0, 0)[0]
  z0: galleryWorld(0, 0, minimum(toyboxAt(s)[2], (toyboxAt(s)[2] + s.facing)))[2]
  z1: galleryWorld(0, 0, maximum(toyboxAt(s)[2], (toyboxAt(s)[2] + s.facing)))[2]
  y0: (galleryFloor[toyboxLevel] - 0.5)
  y1: (galleryFloor[toyboxLevel] + 1)
}
// Where an inserted cartridge stands out of its deck: the console's top beside the station.
function toyboxSlotAt(s) = [
  (toyboxAt(s)[0] + (toyboxConsoleOffset / 2)),
  (galleryFloor[toyboxLevel] + ((s.kind == "cabinet") ? 0.95 : 0.68)),
  (toyboxAt(s)[2] + (0.15 * s.facing))
]

placements {
  for s in toyboxStations {
    reach(id: $"toybox-console-{s.id}", box: toyboxConsoleReach(s))
    placement $"toybox-slot-{s.id}" {
      prototype: "rental-device-empty"
      parent: "gallery"
      position: toyboxSlotAt(s)
      yawDegrees: s.yaw
      respond: map(
        rentalCartridgeItems,
        c => {
          when: state(state: toyboxCartridge, key: s.id, comparison: Equal, value: c.ordinal)
          prototypeId: rentalCartridgePrototype(c.slot)
        }
      )
    }
  }
}

for (s, i) in toyboxStations {
  rule $"toybox-cartridge-{s.id}" {
    when engaged(each, $"{(toyboxScreen + i)}") == 1 and rentalCanRent()
    mode: Edge
    forEach: region($"toybox-console-{s.id}")
    toyboxSwap[s.id] = toyboxCartridge[s.id]
    toyboxCartridge[s.id] = rentalCartridgeHeld[$each]
    rentalCartridgeHeld[$each] = toyboxSwap[s.id]
    toyboxTitle[s.id] = 0
    if toyboxCartridge[s.id] > 0 {
      rentalLoan[toyboxCartridge[s.id]] = (rentalStationLoan + i)
      toyboxTitle[s.id] = rentalCartridgeTitle[toyboxCartridge[s.id]]
    }
    if rentalCartridgeHeld[$each] > 0 {
      rentalLoan[rentalCartridgeHeld[$each]] = rentalHolder[$each]
    }
  }
}

// Leaving level 1, or the world (an absent body stands at the origin), returns the device.
rule "rental-leave" {
  when rentalHeld[$each] > 0 and (bodyPosition(each, y) < (galleryFloor[toyboxLevel] - 1) or bodyPosition(each, y) > (
        galleryFloor[toyboxLevel] + 3
      ))
  mode: Level
  forEach: rentalHeld
  rentalLoan[rentalHeld[$each]] = 0
  rentalHeld[$each] = 0
  rentalModel[$each] = 0
}
rule "rental-cartridge-leave" {
  when rentalCartridgeHeld[$each] > 0 and (bodyPosition(each, y) < (galleryFloor[toyboxLevel] - 1) or bodyPosition(
        each,
        y
      ) > (galleryFloor[toyboxLevel] + 3))
  mode: Level
  forEach: rentalCartridgeHeld
  rentalLoan[rentalCartridgeHeld[$each]] = 0
  rentalCartridgeHeld[$each] = 0
}

// Playing: while a body is engaged on either of its screens (only one can be, the one its device's model shows) it plays
// the device it holds, which moves from its hip to its hands; leaving puts it back on the hip. One rule a body, which
// writes only when where the device shows moves.
let rentalPlayed = 64
function rentalShows(b) = (rentalHeld[$"{b}"] +
  (rentalPlayed * (engaged($"body:{b}", $"{rentalScreenOf(b, 1)}") + engaged($"body:{b}", $"{rentalScreenOf(b, 2)}"))))
for b in rentalBodies {
  rule $"rental-shown-{b}" {
    when rentalShown[$"{b}"] != rentalShows(b)
    mode: Level
    rentalShown[$"{b}"] = rentalShows(b)
  }
}

// Each seat's handheld pool: a brick and an advanced brick, advanced only while the body holds a device of that model.
// Every brick in the stalls plays the tetromino game and every advanced brick the moth's pip; their paths resolve
// beside this file.
machines: flatMap(
  rentalBodies,
  b => [
    (brickMachine($"rental-hgb-{b}", "../cartridges/cgb/tetromino.cgb.puck") with {
      runsWhen { state: rentalModel, key: $"{b}", comparison: Equal, value: 1 }
    }),
    (advancedBrickMachine($"rental-agb-{b}", "../cartridges/agb/pip.agb.puck") with {
      runsWhen { state: rentalModel, key: $"{b}", comparison: Equal, value: 2 }
    })
  ]
)
