// The gallery on its own: the building (gallery/gallery.puck) and its exhibits (shapes.puck) under the debug world's
// day (day-alone.puck, the day with the clocks it reads), booted alone so a change to the gallery bakes and boots only the gallery. The debug world imports the same
// module; this root exists for iterating on the building. Boot it with `--world worlds/debug/gallery-root.puck`.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "gallery"

import "day-alone"
import "moon-frame"
import "moth-controls"
import "suit"
import "shapes"
import "exposure"
import "gallery/gallery"

metadata {
  title: "Gallery"
  description: "The debug world's gallery and its exhibits alone, for iterating on the building."
}

// The seat boots on the forecourt, facing the entrance; the module declares the building's own spawn points.
spawnPoints: concat(
  [
    { id: "hero", position: galleryWorld(((entranceWest + entranceEast) / 2), 0.05, -7), yawDegrees: 180 }
  ],
  gallerySpawns
)

commands: galleryCommands

bodies {
  capacity: galleryPopulation
  localSeats: seatPopulation
  networkPlayers: visitorPopulation
}

// The font the plinth labels and signs emboss in, as the debug world declares it.
text {
  defaultFont: "inter"
  fonts [
    {
      name: "inter"
      source: "fonts/inter-regular.ttf"
      hash: "sha256/40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82"
      codePointRanges ["U+0020-U+007E"]
    }
  ]
}

// The exhibits, their motion controls and the cells their state-bound exhibits read (shapes.puck).
placements {
  galleryPlacements()
}

state {
  world {
    galleryState()
  }
}

prototypes {
  galleryPrototypes()
}
