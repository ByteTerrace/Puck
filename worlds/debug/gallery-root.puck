// The gallery on its own: the whole building (gallery/building.puck) with every module the owner laid out on its floors
// (gallery/layout.puck's `galleryFloorsAll`, the board game room's twelve stations included), at full size, under the
// debug world's day (day-alone.puck, the day with the clocks it reads), booted alone so a change to the gallery bakes and
// boots only the gallery. gallery-shell.puck boots the shell and its theme alone, and gallery-half.puck and
// gallery-double.puck the whole building at half and twice its size. Boot it with
// `--world worlds/debug/gallery-root.puck`.

schema: "puck.world.definition.v1"
basis: "stage"
documentId: "gallery"

import "day-alone"
import "moon-frame"
import "set-controls"
import "noclip"
import "ship-rows"
import "exposure"
import "../standard/place"
import "fir-fiber"
// Every player's hand torch, switched by 6 (the standard's flashlight.puck).
import "../standard/flashlight"
// A body's size register, which the building's size field writes (gallery/building.puck).
import "size"
import "gallery/layout"
import "gallery/root"

metadata {
  title: "Gallery"
  description: "The debug world's gallery and its exhibits alone, for iterating on the building."
}

galleryRoot(frame: galleryFrame, floors: galleryFloorsAll)

// The board game room's chess vocabularies (game-stations.puck's header), which the stations' rules fold.
state {
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}
