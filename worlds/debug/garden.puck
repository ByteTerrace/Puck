// The garden: a destination of the debug world's painting wing, a small sunset plot with a green floor and a golden
// obelisk, so a window onto it reads at a glance. The debug world's garden painting (`painting-garden`, hung on the
// north wall of the wing, paintings.puck) opens onto the arrival frame here: a body walking +Z into the painting comes
// out of the arrival frame walking -Z. Turn round and the arrival frame is the way back. Walk on and the far frame,
// twelve metres further along the line the painting's window looks along, shows the debug world again, so it is also a
// frame seen through a frame from the wing. Boot the debug world, never this one: it is reached through the debug
// world's painting, and `world.reload` there recompiles only the debug world. See debug.md beside this file.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "garden"

// The debug world's chrome, so a traveller keeps its bar and wheel here, and the Moth's suit toggle and size.
import "moth-controls"
import "suit"
import "size"
import "painting-kit"
import "place-kit"
import "../standard/visitors"
// The pond plot west of the frames: a hound pack, stalking spiders, dragonflies and fish (pond.puck).
import "garden-pond"

// The garden draws no HUD panels; controls.puck supplies its cursor.
hud {
  panels []
}

metadata {
  title: "Garden"
  description: "A destination of the debug world painting wing: a sunset plot with a green floor, a golden obelisk, two frames back to the debug world and one onto the hearth."
}

// Four local seats and four visitor slots fit inside the basis's eight-slot reserve (pond.puck), keeping every creature index.
bodies {
  localSeats: 4
  networkPlayers: 4
  reconnectGraceSeconds: 3
}

// The debug world's window onto the garden observes it whole as a session; arriving visitors receive the standard visitor row.
admission [
  {
    admits: Session
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 8
        capability: Drive
        exclusive: true
      }
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
  }
  visitorAdmissionRow(domain: "*")
]

references [
  {
    document: "debug"
    name: "debug"
  }
  {
    document: "hearth"
    name: "hearth"
  }
]

destinations [
  {
    durability: persisted
    name: "debug"
    reference: "debug"
    scope: global
  }
  {
    durability: persisted
    name: "hearth"
    reference: "hearth"
    scope: global
  }
]

// The debug world's window onto the garden is one level; the far frame's window back onto the debug world is the
// second, so two levels show from the debug world's spawn.
views {
  nestingDepth: 3
}

placements {
  policy {
    authoringHeadroomInstances: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  // The garden's places (place-kit.puck): the plot, the ground before the arrival frame a crossing walks out onto, and
  // the pond plot west of the frames (pond.puck).
  placement "place-garden" {
    prototype: "place"
    position [-5, 1.5, -18]
    region {
      halfExtents [30, 3, 28]
    }
  }
  placement "place-garden-arrival" {
    prototype: "place"
    position [3, 1.5, -10]
    region {
      halfExtents [2, 2, 2]
    }
  }
  placement "place-garden-pond" {
    prototype: "place"
    position [-20, 1.5, -18]
    region {
      halfExtents [11, 3, 16]
    }
  }

  // The garden painting's counterpart, facing -Z like it, so a crossing turns the traveller about. Its glass is the way
  // back: walking +Z into it arrives out of the painting walking -Z, into the wing.
  placement "arrival" {
    prototype: "frame"
    position [3, 0, -8]
    yawDegrees: 0
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "painting-garden/glass"
          destination: "debug"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "debug"
          fallback: "#FF00FF"
          projection: window
        }
      }
    ]
  }

  // The far frame stands on the line the painting's window looks along and faces back along it, so the debug world's
  // window onto the garden shows it. It also maps onto the garden painting, face to face: a body walking -Z into it
  // arrives out of the painting walking -Z, in front of the wing's north wall.
  placement "far" {
    prototype: "frame"
    position [5.5, 0, -20]
    yawDegrees: 180
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "painting-garden/glass"
          destination: "debug"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "debug"
          fallback: "#FF00FF"
          projection: window
        }
      }
    ]
  }

  // The hearth frame: a window, and a way, onto a third world (hearth.puck) that no painting of the debug world
  // shows. It stands off the line the garden painting looks along and faces the plot, so from the debug world it
  // is a window behind a window: the hearth bakes only while something keeps that chain rendering.
  placement "hearth" {
    prototype: "frame"
    position [-6, 0, -16]
    yawDegrees: 90
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "arrival/glass"
          destination: "hearth"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "hearth"
          fallback: "#3A160C"
          projection: window
        }
      }
    ]
  }

  placement "obelisk" {
    prototype: "obelisk"
    position [9, 0, -30]
    solid
  }
}

prototypes {
  prototype "floor" {
    document {
      name: "floor"
      palette [
        {
          color: "#3E8A4F"
          roughness: 0.95
          specular: 0.02
        }
      ]
      schema: "puck.creation.v1"
      shape Box "ground" {
        material: 0
        position [0, -0.2, 0]
        scale [32, 0.2, 32]
      }
    }
  }

  // A gilt frame round a canvas the size of the gallery painting's (2.24 by 2.84 m, its bottom below the ground so a
  // body's feet cross the glass): a mapped pair of two sizes carries a traveller only within one world. Face 0, the
  // rim, names the glass, which shows through the opening carved out of it.
  prototype "frame" {
    document {
      arrivalFrame(color: "#C9A43A", roughness: 0.4, specular: 0.4, post: 0.12)
    }
  }

  prototype "obelisk" {
    document {
      name: "obelisk"
      palette [
        {
          color: "#F2C230"
          emissive: 14000
          roughness: 0.5
          specular: 0.3
        }
      ]
      schema: "puck.creation.v1"
      shape Box "shaft" {
        material: 0
        position [0, 3, 0]
        scale [0.6, 3, 0.6]
      }
      shape Sphere "cap" {
        material: 0
        position [0, 6.6, 0]
        scale [0.9, 0.9, 0.9]
      }
    }
  }
}

// A sunset: a low sun's 2,000 lux under a 400-nit sky, so the garden reads as evening in its own exposure and a painting
// onto it from the dimmer gallery shows its colours rather than a sunlit glare.
render {
  farDistance: 120
  lighting {
    lights [
      directional(
        name: "key",
        direction: [3, 5, -4],
        color: "#FFC27A",
        illuminance: 2000lx,
        shadow: always,
        angularRadius: 0.2
      )
    ]
  }
  sky {
    layers [
      gradient(name: "air", luminance: 400nit, stops: [
        { elevation: -1, color: "#3A2440" }
        { elevation: 0, color: "#FF9A4D" }
        { elevation: 0.25, color: "#D2557A" }
        { elevation: 1, color: "#3B2A6E" }
      ])
      sunDisc(name: "sun", luminance: 400nit, light: 0, radius: 1.2deg, intensity: 10, color: "#FFC27A")
    ]
  }
  atmosphere {
    fog {
      density: 0.008
    }
  }
}
