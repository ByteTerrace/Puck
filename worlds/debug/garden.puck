// The garden: a destination of the debug world's painting wing, a small sunset plot with a green floor and a golden
// obelisk, so a window onto it reads at a glance. The debug world's garden painting (`painting-garden`, hung on the
// north wall of the wing, paintings.puck) opens onto the arrival frame here: a body walking +Z into the painting comes
// out of the arrival frame walking -Z. Turn round and the arrival frame is the way back. Walk on and the far frame,
// twelve metres further along the line the painting's window looks along, shows the debug world again, so it is also a
// frame seen through a frame from the wing. Boot the debug world, never this one: it is reached through the debug
// world's painting, and `world.reload` there recompiles only the debug world. See debug.md beside this file.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "garden"

// The debug world's chrome, so a traveller keeps its bar and wheel here, and the Moth's suit toggle and size.
import "theme"
import "controls"
import "suit"
import "size"

// The garden draws no HUD panels; controls.puck supplies its cursor.
hud {
  panels []
}

// The garden's palette slots.
let frameGold = 0 // #C9A43A

metadata {
  title: "Garden"
  description: "A destination of the debug world painting wing: a sunset plot with a green floor, a golden obelisk and two frames back to the debug world."
}

// A traveller from the debug world arrives here, and the debug world's window onto the garden observes it whole.
admission [
  {
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 8
        capability: Drive
        exclusive: true
      }
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
  }
]

references [
  {
    document: "debug"
    name: "debug"
  }
]

destinations [
  {
    durability: persisted
    name: "debug"
    reference: "debug"
    scope: global
  }
]

// The debug world's window onto the garden is one level; the far frame's window back onto the debug world is the
// second, so two levels show from the debug world's spawn.
views {
  nestingDepth: 3
}

placements {
  // Two derived face screens: the arrival frame's glass and the far frame's.
  policy {
    authoringHeadroomInstances: 0
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    derivedFaceScreens: 2
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  // The garden painting's counterpart, facing -Z like it, so a crossing turns the traveller about. Its glass is the way
  // back: walking +Z into it arrives out of the painting walking -Z, into the wing.
  placement "arrival" {
    prototype: "frame"
    position [3, 0, -8]
    yawDegrees: 0
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "painting-garden/glass"
          destination: "debug"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "debug"
          fallback: "#FF00FF"
          projection: window
        }
      }
    ]
  }

  // The far frame stands on the line the painting's window looks along and faces back along it, so the debug world's
  // window onto the garden shows it. It also maps onto the garden painting, face to face: a body walking -Z into it
  // arrives out of the painting walking -Z, in front of the wing's north wall.
  placement "far" {
    prototype: "frame"
    position [5.5, 0, -20]
    yawDegrees: 180
    faceSources [
      {
        face: "glass"
        filter: linear
        portal {
          arrival: "mapped"
          counterpart: "painting-garden/glass"
          destination: "debug"
          travel: "body"
        }
        source {
          $type: "session"
          destination: "debug"
          fallback: "#FF00FF"
          projection: window
        }
      }
    ]
  }

  placement "obelisk" {
    prototype: "obelisk"
    position [9, 0, -30]
    solid
  }
}

prototypes {
  prototype "floor" {
    document {
      name: "floor"
      palette [
        {
          color: "#3E8A4F"
          roughness: 0.95
          specular: 0.02
        }
      ]
      schema: "puck.creation.v1"
      shape Box "ground" {
        material: 0
        position [0, -0.2, 0]
        scale [32, 0.2, 32]
      }
    }
  }

  // A gilt frame round a canvas the size of the gallery painting's (2.24 by 2.84 m, its bottom below the ground so a
  // body's feet cross the glass): a mapped pair of two sizes carries a traveller only within one world. Face 0, the
  // rim, names the glass, which shows through the opening carved out of it.
  prototype "frame" {
    document {
      behavior {
        faces [
          {
            name: "glass"
            shapeId: 0
          }
        ]
      }
      name: "frame"
      palette [
        {
          color: "#C9A43A"
          roughness: 0.4
          specular: 0.4
        }
      ]
      schema: "puck.creation.v1"
      shape Box "rim" {
        material: frameGold
        position [0, 1.3, 0]
        scale [1.12, 1.42, 0.04]
      }
      shape Box "opening" {
        blend: Subtraction
        material: frameGold
        position [0, 1.3, 0]
        scale [1.1, 1.4, 0.3]
      }
      shape Box "frame-left" {
        material: frameGold
        position [-1.24, 1.42, 0]
        scale [0.12, 1.54, 0.08]
      }
      shape Box "frame-right" {
        material: frameGold
        position [1.24, 1.42, 0]
        scale [0.12, 1.54, 0.08]
      }
      shape Box "frame-top" {
        material: frameGold
        position [0, 2.84, 0]
        scale [1.12, 0.12, 0.08]
      }
    }
  }

  prototype "obelisk" {
    document {
      name: "obelisk"
      palette [
        {
          color: "#F2C230"
          emissive: 14000
          roughness: 0.5
          specular: 0.3
        }
      ]
      schema: "puck.creation.v1"
      shape Box "shaft" {
        material: 0
        position [0, 3, 0]
        scale [0.6, 3, 0.6]
      }
      shape Sphere "cap" {
        material: 0
        position [0, 6.6, 0]
        scale [0.9, 0.9, 0.9]
      }
    }
  }
}

// A sunset: a low sun's 2,000 lux under a 400-nit sky, so the garden reads as evening in its own exposure and a painting
// onto it from the dimmer gallery shows its colours rather than a sunlit glare.
render {
  farDistance: 120
  lighting {
    lights [
      directional(
        name: "key",
        direction: [3, 5, -4],
        color: "#FFC27A",
        illuminance: 2000lx,
        shadow: always,
        angularRadius: 0.2
      )
    ]
  }
  sky {
    layers [
      gradient(name: "air", luminance: 400nit, stops: [
        { elevation: -1, color: "#3A2440" }
        { elevation: 0, color: "#FF9A4D" }
        { elevation: 0.25, color: "#D2557A" }
        { elevation: 1, color: "#3B2A6E" }
      ]
      )
      sunDisc(name: "sun", luminance: 400nit, light: 0, radius: 1.2deg, intensity: 10, color: "#FFC27A")
    ]
  }
  atmosphere {
    fog {
      density: 0.008
    }
  }
}
