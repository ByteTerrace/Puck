// The gallery's portal wiring: the library its portals may lead to, and level 3's twelve portals in the frame the
// building stands in. A module library: it hands its importers lets and functions and emits no document.
// gallery/portals.puck stands the twelve and declares the library's references and destinations; gallery/building.puck
// passes their panels' terminals to the gallery's one `terminalPlay`.
//
// The gallery wires no destination (the owner's ruling): its library is empty, so every portal is a mirror and the
// gallery booted alone (gallery-root.puck) starts no other world. An artist wires the gallery here, as the standard's
// portal module says (../standard/portal.puck): an entry in `galleryPortalLibrary`, and the entry a portal starts on in
// `galleryPortalWiring`. Wiring portal-south-5 to the garden:
//
//   let galleryPortalLibrary = [portalEntry(destination: "garden", document: "garden", title: "THE GARDEN", note: "A sunset plot.")]
//   let galleryPortalWiring = [{ portal: "portal-south-5", route: 0 }]
//
// A portal with a library stands its panel, which lists the library and MIRROR; a portal the wiring leaves out starts
// as a mirror.

import "../standard/portal"
import "../standard/panel"
import "gallery/layout"

// The library: one list of the worlds the gallery's portals may lead to, each a `portalEntry`.
let galleryPortalLibrary = []
// The entry each portal starts on, `{ portal, route }` by its id; a portal it leaves out starts as a mirror.
let galleryPortalWiring = []

// Level 3's portals stand at gallery/layout.puck's `galleryPortalBays`, one a row, `portalStandOff` in from the wall the
// row names, toward the gallery its glass faces, in a freestanding frame of the canyon workshop's teal over a brass lip.
// A portal's id names its gallery and bay.
let portalStandOff = 0.5
let galleryPortalLook = {
  proud: 0
  rings [
    { width: 0.04, front: 0.1, back: 0.1, row { color: "#C8902E", roughness: 0.3, metal: 1 } }
    { width: 0.18, front: 0.08, back: 0.08, row { color: "#245F5C", roughness: 0.4, specular: 0.3 } }
  ]
  plaque: "post"
}
function galleryPortalsIn(frame) = map(galleryPortalBays, place => portalOf(
  id: $"portal-{place.side}-{place.bay}",
  x: place.at[0],
  y: place.at[1],
  z: (place.wall + (((place.yaw == 180) ? 1 : -1) * portalStandOff)),
  yaw: place.yaw,
  site: frame,
  parent: "gallery",
  look: galleryPortalLook,
  library: galleryPortalLibrary,
  route: first(galleryPortalWiring, wired => (wired.portal == $"portal-{place.side}-{place.bay}"), wired => wired.route, null)
))
// The gallery's panel set: level 3's portal panels (panel.puck's `panelSet`).
function galleryPanelsIn(frame) = panelSet(portalPanels(galleryPortalsIn(frame)))
