// The small tables of the board game room's hidden-information games (auction.puck, eights.puck, deduction.puck,
// skirmish.puck): a library each of them imports and expands in its own `prototypes` block. A table is the card
// table's pedestal (cardtable.puck) with a square top in its game's cloth; its creation's floor lies 0.5 m under its
// origin, so a table placed at the board game room's floor height minus 0.5 stands on level 2.

// Level 2's floor, galleryFloor[2] in shapes.puck: these tables' documents boot on their own as harness fixtures, so
// they do not import the gallery to read it.
let boardRoomFloor = 9.05
let gameTableTop = 1.25

template gameTablePrototype(id, cloth, halfWidth = 0.6) {
  prototype id {
    document {
      name: id
      palette [
        { color: "#6B4A2E", roughness: 0.6, specular: 0.15 }
        { color: cloth, roughness: 0.9, specular: 0.03 }
      ]
      schema: "puck.creation.v1"
      shape Box "top" {
        material: 0
        position [0, gameTableTop, 0]
        scale [halfWidth, 0.04, halfWidth]
      }
      shape Box "cloth" {
        material: 1
        position [0, gameTableTop + 0.045, 0]
        scale [halfWidth - 0.05, 0.005, halfWidth - 0.05]
      }
      shape Cylinder "leg" {
        material: 0
        position [0, 0.855, 0]
        scale [0.08, 0.355, 0.08]
      }
      shape Cylinder "foot" {
        material: 0
        position [0, 0.52, 0]
        scale [0.4, 0.02, 0.4]
      }
    }
  }
}
