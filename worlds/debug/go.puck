              color: "#1E1A16"
              position [56.5, 9.905, 31.400000000000002]
              scale [2, 1, 0.08]
              stroke: 0.0007
            }
            { type: Sphere, color: "#1E1A16", position [56.5, 9.905, 31.080000000000002], scale [0.004, 0.03, 0.004] }
          ]
        }
        {color: "#D9B26F", roughness: 0.6, specular: 0.12, paints [
            { type: Box, color: "#1E1A16", position [56.54, 9.905, 30.6], scale [0.04, 1, 2], stroke: 0.0007 }
            { type: Box, color: "#1E1A16", position [56.7, 9.905, 30.6], scale [0.04, 1, 2], stroke: 0.0007 }
            { type: Box, color: "#1E1A16", position [56.86, 9.905, 30.6], scale [0.04, 1, 2], stroke: 0.0007 }
            {
              type: Box
              color: "#1E1A16"
              position [56.5, 9.905, 31.040000000000003]
              scale [2, 1, 0.04]
              stroke: 0.0007
            }
            {
              type: Box
              color: "#1E1A16"
              position [56.5, 9.905, 31.200000000000003]
              scale [2, 1, 0.04]
              stroke: 0.0007
            }
            {
              type: Box
              color: "#1E1A16"
              position [56.5, 9.905, 31.400000000000002]
              scale [2, 1, 0.08]
              stroke: 0.0007
            }
            { type: Sphere, color: "#1E1A16", position [56.5, 9.905, 31.080000000000002], scale [0.004, 0.03, 0.004] }
          ]
        }
        {color: "#D9B26F", roughness: 0.6, specular: 0.12, paints [
            { type: Box, color: "#1E1A16", position [56.94, 9.905, 30.6], scale [0.04, 1, 2], stroke: 0.0007 }
            { type: Box, color: "#1E1A16", position [57.1, 9.905, 30.6], scale [0.04, 1, 2], stroke: 0.0007 }
            { type: Box, color: "#1E1A16", position [57.3, 9.905, 30.6], scale [0.08, 1, 2], stroke: 0.0007 }
            {
              type: Box
              color: "#1E1A16"
              position [56.5, 9.905, 31.040000000000003]
              scale [2, 1, 0.04]
              stroke: 0.0007
            }
            {
              type: Box
              color: "#1E1A16"
              position [56.5, 9.905, 31.200000000000003]
              scale [2, 1, 0.04]
              stroke: 0.0007
            }
            {
              type: Box
              color: "#1E1A16"
              position [56.5, 9.905, 31.400000000000002]
              scale [2, 1, 0.08]
              stroke: 0.0007
            }
            { type: Sphere, color: "#1E1A16", position [56.98, 9.905, 31.080000000000002], scale [0.004, 0.03, 0.004] }
          ]
        }
      ]
      schema: "puck.creation.v1"
      shape Box "top" {
        material: goWood
        position [0, 1.25, 0]
        scale [1.75, 0.05, 0.92]
      }
      for x in [-1.1, 1.1] {
        // The two pedestals stand on the floor 0.5 m under the creation's origin.
        shape Cylinder $"leg-{x}" {
          material: goWood
          position [x, 0.855, 0]
          scale [0.08, 0.355, 0.08]
        }
        shape Cylinder $"foot-{x}" {
          material: goWood
          position [x, 0.52, 0]
          scale [0.35, 0.02, 0.35]
        }
      }
      // Rectangular prisms have sharp edges, so their flush union has no Box fillet grooves.
      // Paints draw the grid without contact ridges on this one flat supporting face.
      for r in range(0, 4) {
        for c in range(0, 4) {
          shape Prism $"face-{r}-{c}" {
            material: 3 + r * 4 + c
            position [(0.6 - c * 0.4), (goSurface - 0.0275), (0.6 - r * 0.4)]
            scale [0.2, 0.0275, 0.2]
            taper: 1
          }
        }
      }
      // The trays: a walnut lid under each side's stones.
      shape Box "lid-west" {
        material: goLid
        position [-1.28, 1.302, 0]
        scale [0.42, 0.002, 0.78]
      }
      shape Box "lid-east" {
        material: goLid
        position [1.28, 1.302, 0]
        scale [0.42, 0.002, 0.78]
      }
    }
  }

  // A stone: a lens of slate or shell.
  for stone in [
    { name: "goStoneBlack", color: "#1A1B1E", roughness: 0.35, specular: 0.3 }
    { name: "goStoneWhite", color: "#EEECE6", roughness: 0.3, specular: 0.35 }
  ] {
    prototype $"{stone.name}" {
      document {
        name: stone.name
        palette [{ color: stone.color, roughness: stone.roughness, specular: stone.specular }]
        schema: "puck.creation.v1"
        shape Sphere "lens" {
          material: 0
          position [0, 0.010, 0]
          scale [0.036, 0.010, 0.036]
        }
      }
    }
  }

  // A point's outline. Its bars must survive the mesh lattice; sub-cell slivers disappear.
  prototype "goCursor" {
    document {
      name: "goCursor"
      palette [{ color: "#3FA9F5", roughness: 0.4, specular: 0.3 }]
      schema: "puck.creation.v1"
      shape Box "near" {
        material: 0
        position [0, 0, -0.038]
        scale [0.04, 0.008, 0.008]
      }
      shape Box "far" {
        material: 0
        position [0, 0, 0.038]
        scale [0.04, 0.008, 0.008]
      }
      shape Box "left" {
        material: 0
        position [-0.038, 0, 0]
        scale [0.008, 0.008, 0.04]
      }
      shape Box "right" {
        material: 0
        position [0.038, 0, 0]
        scale [0.008, 0.008, 0.04]
      }
    }
  }
}

// ---- Reading the board -------------------------------------------------------------------------------------------
// Whenever the physics has rested for goSettleTicks, the rules read each stone's point off the board and compare the
// arrangement with the accepted position.

// Sample readiness before this tick's table reading. The first candidate batch starts on the following tick,
// rather than sharing the physical read, accepted-move report and return-queue work.
rule "go-ai-enable" {
  local enabled = (
    (goAiSide == goTurn) and
    (goOver == 0) and
    (goHold == goSettleTicks) and
    (goJudging == 0) and
    (goReported == goMoves) and
    (goPut < 0) and
    (goSync == 0) and
    (goReseat == 0) and
    (physics(quiescent, goCell) == 1)
  )
  when goAiEnabled != enabled
  mode: Level
  goAiEnabled = enabled
}

rule "go-settle-hold-advance" {
  when goHold < goSettleTicks and physics(quiescent, goCell) == 1
  mode: Level
  goHold += 1
  goReadPulse = 1
}

rule "go-settle-hold-reset" {
  when goHold > 0 and physics(quiescent, goCell) != 1
  mode: Level
  goHold = 0
  goReadPulse = 0
}

// The table is read point by point, not stone by stone: stones of one colour are alike, so what an arrangement says is
// the board it shows (`goSeen`, each stone's colour on the point it stands on) against the accepted one. The points
// where the two differ (`goDiff`) decide: one point holding a stone of the side to move where the position is empty
// is a move; anything else is put right. A stone the position does not hold goes back to its tray, and a point the
// position holds that the table lacks is filled from its colour's tray (`goGap`), one point a reading. A stone's cell
// is the point it stands on, or `-1 - ordinal` off the board, so the lowest-numbered stone a tray holds is the
// greatest of its colour's cells there. The search's hypothetical plies never read the table: they try the door alone.
set goChanged: (board(goSeen, 1..1) & ~board(goBoard, 1..1)) | (board(goBoard, 1..1) & ~board(goSeen, 1..1)) | (board(goSeen, 2..2) & ~board(goBoard, 2..2)) | (board(goBoard, 2..2) & ~board(goSeen, 2..2))
set goMissing: (board(goBoard, 1..1) & ~board(goSeen, 1..1)) | (board(goBoard, 2..2) & ~board(goSeen, 2..2))

// Read one ordinal slice per quiet tick. Every stone has been read when the nine-tick hold completes; motion
// resets the hold and starts a fresh scan, so a verdict still sees one arrangement that stayed quiet throughout.
rule "go-read-stones" {
  local reading = (
    goReadPulse == 1 and
    goReseat == 0 and
    search(ply) == 0 and
    goOrdinal[$each] >= (goHold - 1) * goReadBatch and
    goOrdinal[$each] < goHold * goReadBatch
  )
  local point = reading ? board(cellOf, goBoard, placement, $each) : -1
  local nextCell = point >= 0 ? point : -1 - goOrdinal[$each]
  when reading and goCell[$each] != nextCell
  mode: Level
  forEach: goCode
  goCell[$each] = nextCell
}

rules "" when goReadPulse == 1 and goHold == goSettleTicks and goReseat == 0 and search(ply) == 0 {
  mode: "Edge"

  // Reduce seeded point ordinals under each difference mask; an empty mask reads -1.
  rule "go-read-board" {
    transform boardCombine(row: goDiff, operation: Clear)
    transform writeSet(row: goDiff, set: goChanged, value: 1)
    transform boardCombine(row: goGap, operation: Clear)
    transform writeSet(row: goGap, set: goMissing, value: 1)
    goChangedCount = count(goDiff, c -> c != 0)
    goCollisions = count(goCell, atLeast: 0, atMost: goLastPoint) - count(goSeen, c -> c != 0)
    goNewCell = goChangedCount > 0 ? max(goPointIndex, where: goDiff, atLeast: 0, atMost: goLastPoint) : -1
    goFix = count(goGap, c -> c != 0) > 0 ? max(goPointIndex, where: goGap, atLeast: 0, atMost: goLastPoint) : -1
  }

  // One stone of the side to move, come onto an empty point and alone on it, with nothing else changed: a request
  // through the door.
  rule "go-read-legal" {
    goLegal = (
      (goChangedCount == 1) and
      (goCollisions == 0) and
      (goNewCell >= 0) and
      (goOver == 0) and
      (goBoard[goNewCell] == 0) and
      (goSeen[goNewCell] == goTurn)
    )
  }

  rule "go-read-request" {
    when goLegal == 1 and physics(quiescent, goCell) == 1
    goMove.play = goNewCell
  }

  // Anything else that changed is illegal, and is put right below.
  rule "go-read-illegal" {
    when (goChangedCount > 0 or goCollisions > 0) and goLegal == 0
    goIllegal += 1
  }

  rule "go-read-sync" {
    when goChangedCount > 0 or goCollisions > 0
    goSync = 1
  }

  // A point the table lacks is filled once the strays are back in their trays; a request takes the turn instead.
  rule "go-read-fill" {
    when goFix >= 0 and goLegal == 0 and goCollisions == 0
    goPut = goFix
  }

  rule "go-read-done" {
    goJudging = 0
  }
}

rule "go-read-scan-done" {
  when goReadPulse == 1
  mode: Level
  goReadPulse = 0
}

// ---- The rules of Go -----------------------------------------------------------------------------------------------
// Exact predecessor comparison: fingerprints cannot prove equality. Both colour sets must agree at every point.
set goKoDifferent: (board(goProbe, 1..1) & ~board(goPrevious, 1..1)) | (board(goPrevious, 1..1) & ~board(goProbe, 1..1)) | (board(goProbe, 2..2) & ~board(goPrevious, 2..2)) | (board(goPrevious, 2..2) & ~board(goProbe, 2..2))

// Publish on the tick after acceptance; readiness above waits for this report, so reading, reporting and starting
// the search occupy separate ticks. What the last stone did: the size and liberties of its group, and whether it left an opposing group
// beside it in atari, with one liberty. The search never reads these, so its judge never pays for them.
template goReport(colour, foe) {
  rule $"go-report-{colour}" {
    local north = board(neighbour, goBoard, N)[goPlaced]
    local east = board(neighbour, goBoard, E)[goPlaced]
    local south = board(neighbour, goBoard, S)[goPlaced]
    local west = board(neighbour, goBoard, W)[goPlaced]
    when goReported != goMoves and goBoard[goPlaced] == colour
    mode: Level
    goReported = goMoves
    goGroup = board(component, goBoard, colour, colour, goPoints)[goPlaced]
    goLiberties = board(boundary, goBoard, colour, colour, goEmpty, goEmpty, goPoints)[goPlaced]
    goAtari = (
      ((goBoard[north] ?? goEmpty) == foe) and
        ((board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[north] ?? 0) == 1) or
      ((goBoard[east] ?? goEmpty) == foe) and
        ((board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[east] ?? 0) == 1) or
      ((goBoard[south] ?? goEmpty) == foe) and
        ((board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[south] ?? 0) == 1) or
      ((goBoard[west] ?? goEmpty) == foe) and
        ((board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[west] ?? 0) == 1)
    )
  }
}

goReport(colour: goBlack, foe: goWhite)
goReport(colour: goWhite, foe: goBlack)

// One side's move door. The request is the point the move token was moved to. The door admits it when that point is
// empty and the stone either captures or keeps a liberty. Captures happen before the suicide check. A one-stone
// capture is compared point for point with the predecessor board, so simple ko has no hash collision path.
template goPlay(colour, foe) {
  rule $"go-play-{colour}" {
    local active = goTurn == colour and goMove.play != goPlaced and goMove.play >= 0 and goOver == 0
    local taken = active ? board(enclosedAt, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[goMove.play] : -1
    local breath = active ? board(boundaryAt, goBoard, colour, colour, goEmpty, goEmpty, goPoints)[goMove.play] : 0
    when goMove.play != goPlaced and goMove.play >= 0 and goOver == 0 and goTurn == colour
    mode: Level
    goKo = 0
    if taken == 1 {
      transform boardCombine(row: goProbe, operation: Copy, left: goBoard)
      goProbe[goMove.play] = colour
      transform clearEnclosed(row: goProbe, from: cell(goMove, play), lower: foe, upper: foe)
      transform boardCombine(row: goKoCheck, operation: Clear)
      transform writeSet(row: goKoCheck, set: goKoDifferent, value: 1)
      goKo = count(goKoCheck, c -> c != 0) == 0
    }
    if taken >= 0 and (taken > 0 or breath > 0) and goKo == 0 {
      transform boardCombine(row: goPrevious, operation: Copy, left: goBoard)
      goBoard[goMove.play] = colour
      if taken > 0 {
        transform clearEnclosed(row: goBoard, from: cell(goMove, play), lower: foe, upper: foe)
      }
      goStoneCount[$"{colour}"] += 1
      goStoneCount[$"{foe}"] = goStoneCount[$"{foe}"] - taken
      goPrisoners[$"{colour}"] += taken
      goCaptured = taken
      goPlaced = goMove.play
      goMoves += 1
      goPasses = 0
      goRefusal = 0
      goAiRevision += 1
      goVerdict = 1
      goAccepted = 1
      goTurn = foe
    } else {
      goRefusal = taken < 0 ? goOccupied : goKo == 1 ? goKoRefused : goSuicide
    }
  }
}

goPlay(colour: goBlack, foe: goWhite)
goPlay(colour: goWhite, foe: goBlack)

// A request neither door admitted: an occupied point, a suicide, a ko, or a stone after the game. The token goes back to
// the last stone played, so the next request is a fresh one.
rule "go-refuse" {
  when goMove.play != goPlaced
  mode: Level
  goRejected += 1
  goVerdict = 0
  goMove.play = goPlaced
  goSync = 1
}

// A pass. Two in a row end the game.
rule "go-pass" {
  when goPassRequest != goPassApplied and goOver == 0
  mode: Level
  goPassApplied = goPassRequest
  goPasses += 1
  transform boardCombine(row: goPrevious, operation: Copy, left: goBoard)
  goAiRevision += 1
  goTurn = 3 - goTurn
  goOver = goPasses >= 2
}

// ---- Scoring --------------------------------------------------------------------------------------------------------
// Area scoring: a side's score is its stones plus the empty points that reach its stones and never the other side's.
// Once the game is over each side's reach is flooded outward from its stones through empty points, one step in every
// direction a pass, until a pass reaches nothing new.

set goOpen: board(goBoard, 0..0)
set goBlacks: board(goBoard, 1..1)
set goWhites: board(goBoard, 2..2)
set goBlackArea: board(goBlackReach, 1..1) & ~board(goWhiteReach, 1..1) & board(goBoard, 0..0)
set goWhiteArea: board(goWhiteReach, 1..1) & ~board(goBlackReach, 1..1) & board(goBoard, 0..0)

rule "go-score-open" {
  when goOver == 1 and goScoring == 0
  mode: Level
  transform boardCombine(row: goBlackReach, operation: Copy, left: goBlacks)
  transform boardCombine(row: goWhiteReach, operation: Copy, left: goWhites)
  goScoring = 1
  goGrowing = 1
  goReached = 0
  goScorePasses = 0
}

// One side's reach taking one step each way: its members shifted, kept where the point is empty, and added back.
template goGrow(reach) {
  rule $"go-{reach}" {
    transform boardCombine(row: goFrontier, operation: Shift, left: reach, direction: "N")
    for direction in ["E", "S", "W"] {
      transform boardCombine(row: goStep, operation: Shift, left: reach, direction: direction)
      transform boardCombine(row: goFrontier, operation: Or, left: goFrontier, right: goStep)
    }
    transform boardCombine(row: goFrontier, operation: And, left: goFrontier, right: goOpen)
    transform boardCombine(row: reach, operation: Or, left: reach, right: goFrontier)
  }
}

stabilize goFlood maxPasses(goPoints + 2) until goScoring != 1 {
  goGrow(reach: goBlackReach)
  goGrow(reach: goWhiteReach)

  rule "go-measure" {
    local reach = count(goBlackReach, c -> c != 0) + count(goWhiteReach, c -> c != 0)
    goGrowing = reach != goReached
    goReached = reach
    goScorePasses += 1
  }
}

rule "go-score-tally" {
  when goScoring == 1 and goGrowing == 0
  mode: Level
  transform boardCombine(row: goOwner, operation: Clear)
  transform writeSet(row: goOwner, set: goBlackArea, value: goBlack)
  transform writeSet(row: goOwner, set: goWhiteArea, value: goWhite)
  goTerritory[1] = count(goOwner, c -> c == 1)
  goTerritory[2] = count(goOwner, c -> c == 2)
  goWinner = (
    2 * (goStoneCount[1] + goTerritory[1]) > 2 * (goStoneCount[2] + goTerritory[2]) + goKomiHalves ? goBlack : goWhite
  )
  goScoring = 2
}

// ---- Keeping the table to the position ---------------------------------------------------------------------------------

// A new game: `go.reset` writes goReset, the position empties, and every stone goes back to its tray. Black moves first.
rule "go-reset" {
  when goReset == 1
  mode: Level
  transform boardCombine(row: goBoard, operation: Clear)
  goTurn = goBlack
  goMove.play = -1
  goPlaced = -1
  goPut = -1
  goJudging = 0
  goExhausted = 0
  goPasses = 0
  goOver = 0
  goScoring = 0
  goWinner = 0
  goMoves = 0
  goReported = 0
  goStoneCount[1] = 0
  goStoneCount[2] = 0
  goPrisoners[1] = 0
  goPrisoners[2] = 0
  goTerritory[1] = 0
  goTerritory[2] = 0
  transform boardCombine(row: goPrevious, operation: Clear)
  goScorePasses = 0
  goReseat = 1
  goReturnCursor = 0
  goResetAll = 1
  goReadPulse = 0
  goAiRevision += 1
  goAccepted = 1
  goReset = 0
}

// Once the door has answered, every stone standing on a point the position does not give its colour goes back to its
// tray: a refused stone, a stray, and the stones a move captured.
rule "go-accept-done" {
  when goAccepted == 1
  mode: Level
  goAccepted = 0
  goSync = 1
}

// Queue only bodies that need returning, in ascending ordinal batches. A reset queues every stone.
// On a collision, retain the first stone of the accepted colour at each point. forEach follows the seeded ordinal
// order, so one scratch board selects it deterministically without a per-stone scan of the entire roster.
rule "go-sync-clear-keepers" {
  when goSync == 1 and goCollisions > 0
  mode: Level
  transform boardCombine(row: goKeep, operation: Clear)
}

rule "go-sync-keep" {
  local cell = goCell[$each]
  when goSync == 1 and goCollisions > 0 and cell >= 0 and goBoard[cell] == goCode[$each] and goKeep[cell] == 0
  mode: Level
  forEach: goCode
  goKeep[cell] = goOrdinal[$each] + 1
}

rule "go-sync-mark" {
  local cell = goCell[$each]
  local nextReturn = (
    goSync == 1 and
    (
      goResetAll == 1 or
        (
          cell >= 0 and
            (goBoard[cell] != goCode[$each] or (goCollisions > 0 and goOrdinal[$each] != (goKeep[cell] - 1)))
        )
    )
  )
  when goSync == 1 and goReturn[$each] != nextReturn
  mode: Level
  forEach: goCode
  goReturn[$each] = nextReturn
}

rule "go-sync-start" {
  when goSync == 1
  mode: Level
  goReseat = count(goReturn, c -> c != 0) > 0
  goSync = 0
  goResetAll = 0
}

rule "go-sync-pick" {
  when goReseat == 1
  mode: Level
  goReturnCursor = min(goOrdinal, where: goReturn, atLeast: 0, atMost: goLastStone)
}

rule "go-sync" {
  when (goReseat == 1 and
    search(ply) == 0 and
    goReturn[$each] == 1 and
    goOrdinal[$each] >= goReturnCursor and
    goOrdinal[$each] < (goReturnCursor + goReturnBatch))
  mode: Level
  forEach: goCode
  poseCell(key: `placement:$each`, topology: goTrays, expression: goHomeCell[$each], offset: [0, 0.05, 0])
  goReturn[$each] = 0
}

rule "go-sync-advance" {
  when goReseat == 1
  mode: Level
  goReseat = count(goReturn, c -> c != 0) > 0
  goHold = 0
}

// ---- Putting a stone down ---------------------------------------------------------------------------------------------
// A put (`goPut`, a point) takes the lowest-numbered stone still in its tray and drops it 6 cm onto the point: of the
// side to move onto an empty point, of the position's colour onto a point the table lacks. The settled board is then
// read as ever. The seated player, the computer and a reading that fills a gap all play this way.
rule "go-put-pick" {
  local colour = goBoard[goPut] != 0 ? goBoard[goPut] : goTurn
  when goPut >= 0
  mode: Level
  goPick = (
    -1 -
    (
      colour == goBlack ? max(goCell, where: goIsBlack, atLeast: goTrayLow, atMost: -1) :
      max(goCell, where: goIsWhite, atLeast: goTrayLow, atMost: -1)
    )
  )
}

rule "go-put-pose" {
  when goPut >= 0 and search(ply) == 0 and goOrdinal[$each] == goPick
  mode: Level
  forEach: goCode
  poseCell(key: `placement:$each`, topology: goBan, expression: goPut, offset: [0, 0.06, 0])
}

rule "go-put-done" {
  when goPut >= 0
  mode: Level
  goExhausted = goPick < 0
  goJudging = goPick >= 0
  goPut = -1
}

// ---- The opponent ----------------------------------------------------------------------------------------------------
// goAiSide 2 (the default) plays White, 1 plays Black and 0 leaves both sides to people. On its turn, once the table has
// rested and matches the position, the search job below judges one ply through the move door, and its move is put down
// on the table as a player's is.
rule "go-ai-play" {
  when goAiEnabled == 1 and goAiBest.revision == goAiRevision and goAiBest.to >= 0 and goAiBest.score > 0 and search(
      ply
    ) == 0 and physics(quiescent, goCell) == 1
  mode: Level
  goPut = goAiBest.to
  goAiEnabled = 0
}

rule "go-ai-pass" {
  when goAiEnabled == 1 and goAiBest.revision == goAiRevision and (goAiBest.to < 0 or goAiBest.score <= 0) and search(
      ply
    ) == 0 and physics(quiescent, goCell) == 1
  mode: Level
  goPassRequest += 1
  goAiEnabled = 0
}

template goEvaluate(colour, foe) {
  rule $"go-evaluate-{colour}" {
    local liberties = (
      goTurn == foe and goVerdict == 1 ? board(boundary, goBoard, colour, colour, goEmpty, goEmpty, goPoints)[goPlaced] :
      0
    )
    local north = board(neighbour, goBoard, N)[goPlaced]
    local east = board(neighbour, goBoard, E)[goPlaced]
    local south = board(neighbour, goBoard, S)[goPlaced]
    local west = board(neighbour, goBoard, W)[goPlaced]
    when goTurn == foe and goVerdict == 1
    mode: Level
    goTactic = (liberties == 1 ? -500 : 0) + (liberties == 0 ? -1000 : 0)
    // A non-capturing move wholly inside friendly stones fills an eye; leave it for a pass.
    if goCaptured == 0 and (goBoard[north] ?? colour) == colour and (goBoard[east] ?? colour) == colour and (
        goBoard[south] ?? colour
      ) == colour and (goBoard[west] ?? colour) == colour {
      goTactic -= 200
    }
    if ((goBoard[north] ?? 0) == foe and
      (board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[north] ?? 0) == 1) {
      goTactic += 60
    }
    if (goBoard[east] ?? 0) == foe and (board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[east] ?? 0) == 1 {
      goTactic += 60
    }
    if ((goBoard[south] ?? 0) == foe and
      (board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[south] ?? 0) == 1) {
      goTactic += 60
    }
    if (goBoard[west] ?? 0) == foe and (board(boundary, goBoard, foe, foe, goEmpty, goEmpty, goPoints)[west] ?? 0) == 1 {
      goTactic += 60
    }
  }
}
goEvaluate(colour: goBlack, foe: goWhite)
goEvaluate(colour: goWhite, foe: goBlack)

search {
  jobs [
    {
      name: "goAI"
      tokens: goMove
      board: goBoard
      turn: goTurn
      verdict: goVerdict
      enabled: goAiEnabled
      revision: goAiRevision
      best: goAiBest
      method: Negamax
      nodes: 8
      depth: 1
      shapes [drop(), relocate(displace: false)]
      // The judge evaluates the move just played; captures dominate the small positional score.
      score: goCaptured * 1000 + goTactic + goPointWeight[goMove.play]
    }
  ]
}

// ---- Playing at the table --------------------------------------------------------------------------------------------
// Seat 1 sits down with the context button (the board's engage block) and plays with the board page chess.puck
// declares: the cursor follows the pointer, the movement keys, the d-pad or the stick, one point a press, up the board
// being away from the side the seat sits on. The pick button puts a stone of the side to move on the cursor's point,
// and the cancel button passes. Either acts only on the seat's own turn, once the table has rested and matches the
// position.

// The seated seat's presses this tick: each button's edge is 1 on the tick it goes past half way, and its *Down
// cell remembers whether it was held.
rule "go-seat-presses" {
  when (board(engaged, goBoard, 1) == 1 or
    goSeat.pickDown or
    goSeat.cancelDown or
    goSeat.aheadDown or
    goSeat.behindDown or
    goSeat.rightDown or
    goSeat.leftDown or
    goSeat.pickEdge or
    goSeat.cancelEdge or
    goSeat.aheadEdge or
    goSeat.behindEdge or
    goSeat.rightEdge or
    goSeat.leftEdge)
  mode: Level
  if board(engaged, goBoard, 1) == 1 and channel(1, confirm) >= 0.5 {
    goSeat.pickEdge = goSeat.pickDown == 0
    goSeat.pickDown = 1
  } else {
    goSeat.pickEdge = 0
    goSeat.pickDown = 0
  }
  if board(engaged, goBoard, 1) == 1 and channel(1, cancel) >= 0.5 {
    goSeat.cancelEdge = goSeat.cancelDown == 0
    goSeat.cancelDown = 1
  } else {
    goSeat.cancelEdge = 0
    goSeat.cancelDown = 0
  }
  if board(engaged, goBoard, 1) == 1 and channel(1, forward) >= 0.5 {
    goSeat.aheadEdge = goSeat.aheadDown == 0
    goSeat.aheadDown = 1
  } else {
    goSeat.aheadEdge = 0
    goSeat.aheadDown = 0
  }
  if board(engaged, goBoard, 1) == 1 and channel(1, forward) <= -0.5 {
    goSeat.behindEdge = goSeat.behindDown == 0
    goSeat.behindDown = 1
  } else {
    goSeat.behindEdge = 0
    goSeat.behindDown = 0
  }
  if board(engaged, goBoard, 1) == 1 and channel(1, strafe) >= 0.5 {
    goSeat.rightEdge = goSeat.rightDown == 0
    goSeat.rightDown = 1
  } else {
    goSeat.rightEdge = 0
    goSeat.rightDown = 0
  }
  if board(engaged, goBoard, 1) == 1 and channel(1, strafe) <= -0.5 {
    goSeat.leftEdge = goSeat.leftDown == 0
    goSeat.leftDown = 1
  } else {
    goSeat.leftEdge = 0
    goSeat.leftDown = 0
  }
}

// The pointer moves the cursor whenever it moves onto another point.
rule "go-seat-point" {
  local pointed = board(pointer, goBoard, 1)
  when board(engaged, goBoard, 1) == 1 and pointed != goSeat.pointer
  mode: Level
  if pointed >= 0 and pointed != goSeat.pointer {
    goSeat.cursor = pointed
  }
  goSeat.pointer = pointed
}

// A step moves the cursor one point in the seat's own frame: from the -Z side up the board is +row and right is
// -column (the camera's right is its forward crossed with up), and each other side turns both a quarter.
rule "go-seat-step" {
  local seatSide = board(side, goBoard, 1)
  local cursorColumn = (
    goSeat.cursor % goSize +
    (goSeat.aheadEdge - goSeat.behindEdge) * (seatSide == 3 ? 1 : seatSide == 1 ? -1 : 0) +
    (goSeat.rightEdge - goSeat.leftEdge) * (seatSide == 2 ? 1 : seatSide == 0 ? -1 : 0)
  )
  local cursorRow = (
    goSeat.cursor / goSize +
    (goSeat.aheadEdge - goSeat.behindEdge) * (seatSide == 0 ? 1 : seatSide == 2 ? -1 : 0) +
    (goSeat.rightEdge - goSeat.leftEdge) * (seatSide == 3 ? 1 : seatSide == 1 ? -1 : 0)
  )
  when (goSeat.aheadEdge - goSeat.behindEdge) or (goSeat.rightEdge - goSeat.leftEdge)
  mode: Level
  goSeat.cursor = clamp(cursorRow, 0, goSize - 1) * goSize + clamp(cursorColumn, 0, goSize - 1)
}

// The seat's turn, once the table has rested and matches the position.
rule "go-seat-ready" {
  local ready = (
    (board(engaged, goBoard, 1) == 1) and
    (goAiSide != goTurn) and
    (goOver == 0) and
    (goHold == goSettleTicks) and
    (goJudging == 0) and
    (goPut < 0) and
    (goSync == 0) and
    (goReseat == 0)
  )
  when goSeat.ready != ready
  mode: Level
  goSeat.ready = ready
}

rule "go-seat-put" {
  when goSeat.pickEdge == 1 and goSeat.ready == 1 and goBoard[goSeat.cursor] == 0 and board(engaged, goBoard, 1) == 1
  mode: Level
  goPut = goSeat.cursor
}

rule "go-seat-pass" {
  when goSeat.cancelEdge == 1 and goSeat.ready == 1 and board(engaged, goBoard, 1) == 1
  mode: Level
  goPassRequest += 1
}

// The cursor stands on its point while the seat sits at the table, and rests inside the board otherwise.
rule "go-seat-cursor-shown" {
  when goSeat.shownCursor != goSeat.cursor and board(engaged, goBoard, 1) == 1
  mode: Level
  poseCell(key: `placement:goCursor`, topology: goBan, expression: goSeat.cursor, offset: [0, 0.004, 0])
  goSeat.shownCursor = goSeat.cursor
}

rule "go-seat-cursor-parked" {
  when goSeat.shownCursor != -1 and board(engaged, goBoard, 1) == 0
  mode: Level
  poseCell(key: `placement:goCursor`, topology: goBan, expression: goSeat.cursor, offset: [0, -0.035, 0])
  goSeat.shownCursor = -1
}

commands [
  {
    name: "go.reset"
    help: "Starts a new game at the Go table: the board empties, every stone goes back to its tray and Black moves first."
    lines [
      "world.state.cell.set goReset $value 1"
    ]
  }
  {
    name: "go.opponent"
    help: "Gives the Go table's computer a side: 2 White (the default), 1 Black, or 0 to leave both sides to people."
    parameters [
      { name: "side", kind: Choice, values ["0", "1", "2"], default: "2" }
    ]
    lines [
      "world.state.cell.set goAiSide $value {side}"
    ]
  }
]

state {
  lattices [
    grid(band: 0.12, cellSize: goCellSize, depth: goSize, width: goSize, origin: [goCorner, goSurface, goCorner], name: "goBan", wrap: None, directions: [
      { name: "N", x: 0, y: -1, z: 0 }
      { name: "E", x: 1, y: 0, z: 0 }
      { name: "S", x: 0, y: 1, z: 0 }
      { name: "W", x: -1, y: 0, z: 0 }
    ])
    // The two trays' spots, in world coordinates over the table's lids.
    grid(
      cellSize: goTrayPitch,
      depth: goTrayDeep,
      width: goTrayColumns,
      origin: goTrayOrigin,
      name: "goTrays",
      wrap: None
    )
  ]

  world {
    // Collision reconciliation's selected stone (ordinal + 1, with zero meaning no keeper).
    row {
      name: "goKeep"
      kind: Int
      capacity: goPoints
      min: 0
      max: goStones
      domain: cellsOf(topology: goBan)
    }
    // The play board, the accepted position: 0 empty, 1 black, 2 white.
    row {
      name: "goBoard"
      kind: "Int"
      capacity: goPoints
      min: goEmpty
      max: goWhite
      domain: cellsOf(topology: goBan)
    }

    // A scratch board a capturing move is tried on first, so the ko check reads the position the move would make before
    // the board takes it.
    row {
      name: "goProbe"
      kind: "Int"
      capacity: goPoints
      min: goEmpty
      max: goWhite
      domain: cellsOf(topology: goBan)
    }

    // Scoring's boards: each side's reach, the step a flood pass takes, and the owner of every point.
    for name in ["goBlackReach", "goWhiteReach", "goFrontier", "goStep", "goOwner"] {
      row {
        name: name
        kind: "Int"
        capacity: goPoints
        min: goEmpty
        max: goWhite
        domain: cellsOf(topology: goBan)
      }
    }

    // What the table shows: each stone's colour on the point it stands on, derived from the stones' cells.
    row {
      name: "goSeen"
      kind: "Int"
      capacity: goPoints
      min: goEmpty
      max: goWhite
      domain: cellsOf(topology: goBan)
      inverse {
        tokens: "goCell"
        codes: "goCode"
      }
    }

    for name in ["goPrevious", "goKoCheck"] {
      row {
        name: name
        kind: Int
        capacity: goPoints
        min: 0
        max: 2
        domain: cellsOf(topology: goBan)
      }
    }
    row {
      name: "goPointIndex"
      kind: Int
      domain: cellsOf(topology: goBan)
      cells: map(range(0, goPoints), i => { key: $"{i}", value: i })
    }
    row {
      name: "goPointWeight"
      kind: Int
      domain: cellsOf(topology: goBan)
      cells: map(
        range(0, goPoints),
        i => {
          key: $"{i}"
          value: ((i % goSize >= 2 and
            i % goSize <= 16 and
            (i - i % goSize) / goSize >= 2 and
            (i - i % goSize) / goSize <= 16) ? 20 : 2) + ((i % goSize == 3 or i % goSize == 15 or (i - i % goSize) /
            goSize == 3 or (i - i % goSize) / goSize == 15) ? 5 : 0) + ((i % goSize == 2 or i % goSize == 16 or (i - i %
            goSize) / goSize == 2 or (i - i % goSize) / goSize == 16) ? 3 : 0) + (((i % goSize == 3 or
            i % goSize == 9 or
            i % goSize == 15) and ((i - i % goSize) / goSize == 3 or
            (i - i % goSize) / goSize == 9 or
            (i - i % goSize) / goSize == 15)) ? 3 : 0)
        }
      )
    }
    slot goTactic = 0 bounds(-2000..2000)
    slot goScorePasses = 0 bounds(0..goPoints + 2)
    slot goReseat = 0 bounds(0..1)
    slot goResetAll = 0 bounds(0..1)
    slot goReturnCursor = 0 bounds(0..goStones + goReturnBatch)

    // The move token: the point the last stone was played on, and the point a request moves it to. It is the search
    // job's one token.
    table goMove bounds(-1..goPoints - 1) {
      play = -1
    }

    table goStoneCount bounds(0..goPoints) {
      "1" = 0
      "2" = 0
    }

    table goPrisoners bounds(0..) {
      "1" = 0
      "2" = 0
    }

    table goTerritory bounds(0..goPoints) {
      "1" = 0
      "2" = 0
    }

    slot goPlaced = -1 bounds(-1..goPoints - 1)
    slot goTurn = 1 bounds(1..2)
    slot goVerdict = 0 bounds(0..1)
    slot goKo = 0 bounds(0..1)
    slot goRefusal = 0 bounds(0..3)
    slot goCaptured = 0 bounds(0..goPoints)
    slot goGroup = 0 bounds(0..goPoints)
    slot goLiberties = 0 bounds(0..goPoints)
    slot goAtari = 0 bounds(0..1)
    slot goMoves = 0 bounds(0..)
    slot goReported = 0 bounds(0..)
    slot goRejected = 0 bounds(0..)
    slot goPasses = 0 bounds(0..2)
    slot goPassRequest = 0 bounds(0..)
    slot goPassApplied = 0 bounds(0..)
    slot goOver = 0 bounds(0..1)
    slot goScoring = 0 bounds(0..2)
    slot goGrowing = 0 bounds(0..1)
    slot goReached = 0 bounds(0..2 * goPoints)
    slot goWinner = 0 bounds(0..2)
    slot goAiRevision = 0 bounds(0..)
    slot goAiSide = 2 bounds(0..2)
    slot goAiEnabled = 0 bounds(0..1)
    slot goReset = 0 bounds(0..1)

    table goAiBest {
      token = -1
      to = -1
      score = 0
      revision = -1
    }

    // The stones: each one's colour and its colour as a filter (goIsBlack, goIsWhite), its ordinal, its tray spot (a
    // `goTrays` cell), the point it was last read on (-1 off the board or knocked over), and its place in the accepted
    // position: a point, or `-1 - ordinal` in its tray.
    row {
      name: "goCode"
      kind: "Int"
      capacity: goStones
      min: goBlack
      max: goWhite
      cells: map(range(0, goStones), i => { key: $"goStone{i}", value: goCodes[i] })
    }
    row {
      name: "goIsBlack"
      kind: "Int"
      cells: map(range(0, goStones), i => { key: $"goStone{i}", value: (i < goPerSide) ? 1 : 0 })
    }
    row {
      name: "goIsWhite"
      kind: "Int"
      cells: map(range(0, goStones), i => { key: $"goStone{i}", value: (i < goPerSide) ? 0 : 1 })
    }
    row {
      name: "goOrdinal"
      kind: "Int"
      cells: map(range(0, goStones), i => { key: $"goStone{i}", value: i })
    }
    row {
      name: "goHomeCell"
      kind: "Int"
      cells: map(range(0, goStones), i => { key: $"goStone{i}", value: goHome[i] })
    }
    row {
      name: "goReturn"
      kind: Int
      cells: map(range(0, goStones), i => { key: $"goStone{i}", value: 0 })
    }
    row {
      name: "goCell"
      kind: "Int"
      capacity: goStones
      min: goTrayLow
      max: goLastPoint
      cells: map(range(0, goStones), i => { key: $"goStone{i}", value: (-1 - i) })
    }

    // The points where the table and the accepted position differ, and the points it holds that the table lacks, as
    // the last reading found them.
    for name in ["goDiff", "goGap"] {
      row {
        name: name
        kind: "Int"
        capacity: goPoints
        min: 0
        max: 1
        domain: cellsOf(topology: goBan)
      }
    }

    // The table: the ticks it has rested, what the last reading found (how many points differ from the position, how
    // many stones share a point, the point a stone came onto and the point the table lacks), the arrangements refused,
    // whether the stones are to be set to the position this tick, whether the door has accepted a move, the point a put
    // drops a stone on and the stone it picked (-1 for none), and whether a put awaits its reading.
    slot goHold = 0 bounds(0..goSettleTicks)
    slot goChangedCount = 0 bounds(0..goPoints)
    slot goCollisions = 0 bounds(0..goStones)
    slot goNewCell = -1 bounds(-1..goLastPoint)
    slot goLegal = 0 bounds(0..1)
    slot goFix = -1 bounds(-1..goLastPoint)
    slot goIllegal = 0 bounds(0..50400)
    slot goSync = 0 bounds(0..1)
    slot goAccepted = 0 bounds(0..1)
    slot goPut = -1 bounds(-1..goLastPoint)
    slot goPick = -1 bounds(-1..goStones)
    slot goExhausted = 0 bounds(0..1)
    slot goJudging = 0 bounds(0..1)
    slot goReadPulse = 0 bounds(0..1)

    // Seat 1 at the table: the cursor's point, the last pointed point, this tick's presses (the *Edge keys),
    // last tick's buttons (*Down), and whether the seat may act.
    table goSeat {
      cursor = (goPoints - 1) / 2
      pointer = -1
      shownCursor = -2
      pickEdge = 0
      cancelEdge = 0
      aheadEdge = 0
      behindEdge = 0
      rightEdge = 0
      leftEdge = 0
      pickDown = 0
      cancelDown = 0
      aheadDown = 0
      behindDown = 0
      rightDown = 0
      leftDown = 0
      ready = 0
    }
  }
}
