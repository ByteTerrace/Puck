import "inputs"
import "shapes"
// Physical Go on a 19x19 board: 361 rigid stones on a goban in the gallery hall's board game room (hall.puck), whose every
// settled arrangement is judged against the position the rules last accepted, and a computer opponent. The debug
// world imports this file whole. The table stands north of the chess table, its board's centre at (56.5, 9.905, 30.6)
// on level 2; Black sits at its -Z edge and White at its +Z edge, each with a tray of 181 or 180 stones at their right-hand end.
// go.md beside this file says how to play, read the game and set the opponent.
//
// The game has two layers. The rules of Go are a move door over the logical board `goBoard`, as a headless game has
// them: a request names the point the move token `goMove.play` is moved to, and the door plays it when the point is
// empty and the stone either captures or keeps a liberty (no suicide), refusing a move that remakes the position one
// full turn back (simple ko). Two passes in a row end the game, scored by area. Over it lies the physical layer: each
// stone body is a token whose point (`goCell`) is read off the board whenever the physics has rested. A settled table
// that differs from the accepted position by one stone of the side to move on an empty point is a request through the
// door; any other change is recorded as illegal (`goIllegal`). Either way the table is then put back to the position:
// a refused or stray stone goes back to its tray, as the stones a move captures do, and a point the table lacks is
// filled from its colour's tray.

// The table's placement (its creation's floor 0.5 m under its origin on level 2's floor), the ticks the physics must
// stay at rest before an arrangement is judged (0.3 s at 30 Hz), the board's side and its point count. A point's
// ordinal is 19 * row + column: its column runs along +X and its row along +Z, so point 0 is the -X, -Z corner, the
// corner at Black's right hand.
let goTable = [56.5, 8.55, 30.6]
let goSettleTicks = 9
let goSize = 19
let goPoints = (goSize * goSize)
let goLastPoint = (goPoints - 1)
let goCellSize = 0.08
// The goban's playing surface over the table's origin; the tabletop's own top is at 1.3.
let goSurface = 1.355
let goCorner = (0 - ((goSize * goCellSize) / 2))

// Point values: an empty point, a black stone, a white stone. A stone's value is also the turn of the side that owns
// it.
let goEmpty = 0
let goBlack = 1
let goWhite = 2

// White's compensation for moving second, in half points: 7.5.
let goKomiHalves = 15

// Why the last request was refused: its point was occupied, it would have left its own group without a liberty, or it
// would have remade the position a full turn back.
let goOccupied = 1
let goSuicide = 2
let goKoRefused = 3

// Black has 181 stones, White 180, in single-layer 10 by 19 trays. One lattice derives both trays.
let goPerSide = 181
let goStones = goPoints
let goLastStone = (goStones - 1)
let goTrayLow = (0 - goStones)
let goTrayPitch = 0.08
let goTrayColumns = 42
let goTrayWide = 10
let goTrayDeep = 19
let goReturnBatch = 8
let goTrayOrigin = [
  (goTable[0] - ((goTrayColumns * goTrayPitch) / 2)),
  (goTable[1] + 1.304),
  (goTable[2] - ((goTrayDeep * goTrayPitch) / 2))
]
let goReadBatch = ((goStones - 1 - (goStones - 1) % goSettleTicks) / goSettleTicks) + 1
// Each stone's spot: its column and row in the trays' grid (a compile-time `/` divides exactly, so a row is counted
// down from its column), and the cell they make.
let goHomeColumn = map(
  range(0, goStones),
  i => ((i < goPerSide) ? 0 : (goTrayColumns - goTrayWide)) + (((i < goPerSide) ? i : (i - goPerSide)) % goTrayWide)
)
let goHomeRow = map(
  range(0, goStones),
  i => ((((i < goPerSide) ? i : (i - goPerSide)) - (((i < goPerSide) ? i : (i - goPerSide)) % goTrayWide)) / goTrayWide)
)
let goHome = map(range(0, goStones), i => (goHomeRow[i] * goTrayColumns) + goHomeColumn[i])
let goCodes = map(range(0, goStones), i => (i < goPerSide) ? goBlack : goWhite)

// The bodies: debug.puck imports this file first, so its cursor and stones take the population's top slots (shapes.puck's
// goBodies): the cursor is the highest body and stone i the one `1 + i` below it. Seat 1 drives each stone, so a seat's
// `body.pose` may set one on a point (go.md).
let goTop = ((galleryPopulation + 2 + boardRoomBodies) - 1)
grants: map(range(0, goStones), i => { capability: Drive, grantee: "seat1", subject: $"body:{goTop - 1 - i}" })

looks: map(["goStoneBlack", "goStoneWhite", "goCursor"], name => {
  motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
  name: name
  scale: 1
  source: creation(prototypeId: name)
})

kits [
  {
    bodyContact: Solid
    bodyMotionProgram: "walk"
    collider: fromCreation(prototypeId: goStoneBlack)
    motion {
      facingSnap: true
      holds [
        {
          bond: Free
          envelope {
            sinkSpeed: 40
          }
          gravity {
            fall: 46
            rise: 28
          }
          hold: Gravity
          name: "air"
        }
      ]
      shaping [
        {
          along {}
        }
      ]
      speed {
        value: 0.001
      }
      turn {
        rate: 0.001
      }
    }
    name: "goStone"
    rigid {
      angularDamping: 0.05
      friction: 0.6
      linearDamping: 0.05
      mass: 0.05
      restitution: 0.05
      rollingFriction: 0.2
    }
  }
]

placements {
  placement "goTable" {
    prototype: "goTable"
    board {
      occupancy: "goBoard"
      topology: "goBan"
      turn: "goTurn"
      verdict: "goVerdict"
      // The context button within 2.5 m of the board's centre sits the seat down at the table; seated, the camera
      // looks down on the board from the seat's side and the pointer picks points 2 cm over the board's face.
      engage {
        channel: "interact"
        radius: 2.5
        pitch: 62
        margin: 0.12
        surface: 0.02
      }
    }
    position: goTable
    solid
  }

  // The point cursor a seated player moves, before the stones so it takes the highest of the game's bodies: the rules
  // pose it on the cursor's point while the seat sits at the table and park it inside the board otherwise.
  placement "goCursor" {
    prototype: "goCursor"
    inhabit {
      count: 1
      distribution {
        fill {
          name: "additive"
          offset: 0
          step: 0.001
        }
        region: disc(radius: 0.01)
      }
      kit: "boardCursor"
      look: "goCursor"
      source: "Idle"
    }
    parent: "goTable"
    position [0, 1.33, 0]
  }

  // Each stone starts 6 cm over its tray spot and drops onto it.
  for i in range(0, goStones) {
    placement $"goStone{i}" {
      prototype: (i < goPerSide) ? "goStoneBlack" : "goStoneWhite"
      inhabit {
        count: 1
        distribution {
          fill {
            name: "additive"
            offset: 0
            step: 0.001
          }
          region: disc(radius: 0.01)
        }
        kit: "goStone"
        look: (i < goPerSide) ? "goStoneBlack" : "goStoneWhite"
        source: "Idle"
      }
      parent: "goTable"
      position [
        (((goHomeColumn[i] + 0.5) * goTrayPitch) - ((goTrayColumns * goTrayPitch) / 2))
        1.37,
        (((goHomeRow[i] + 0.5) * goTrayPitch) - ((goTrayDeep * goTrayPitch) / 2))
      ]
    }
  }

}

// At Black's edge of the table, 1.6 m from the board's centre and facing it, inside the engage radius: the context
// button sits her down.
spawnPoints [
  { id: "go", position [goTable[0], galleryFloor[2], (goTable[2] - 1.6)], yawDegrees: 180 }
]

let goWood = 0
let goLine = 1
let goLid = 2
