// One shape station on a bare floor, booted alone so a change to the station, its console or an exhibit boots and bakes
// without the building. It is the station the gallery stands twelve of: shapes.puck's plinth, turntable and console, and
// shape-station.puck's terminal and rules, expanded here for one display whose console lists the whole catalog. Boot it
// with `--world worlds/debug/shape-station-root.puck`; shapes.md says how to iterate on it.
//
// The seat boots at the console, on the `hero` spawn point (one `gallery` too, and one per exhibit, which `gallery.go`
// walks to): stand there, press the context button (E, or the pad's RB) and the camera eases to the station view. Every
// exhibit of the catalog is one tap on the console's list away.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "shape-station"

// A clear, neutral midday that hardly moves.
import "still-noon"
import "../standard/contexts/modes"
import "set-controls"
import "noclip"
import "ship-rows"
import "shapes"
import "shape-station"

metadata {
  title: "Shape Station"
  description: "One of the shape gallery's display stations on a bare floor, for iterating on the station and its exhibits."
}

// The one station: the display the gallery repeats, standing at the floor's centre in the world's own frame (no parent and
// no site), its console facing +z. It is home to every exhibit, so the exhibits that stand a paint or a reach at the place
// they are shown (the paint and IK exhibits) stand them here.
let station = {
  id: "shapes"
  title: "SHAPE STATION"
  level: 0
  default: "shape-sphere"
  homes: map(galleryDisplayRows, group => group.id)
  x: 0
  z: 0
  yaw: 180
  floor: 0
  site [0, 0, 0]
  parent: null
}
let stations = [station]

// The seat boots before the console; `gallery` is the entrance `gallery.go` names, and each exhibit has a spawn point
// of its own at the same place.
spawnPoints: concat(
  [displaySpawn("hero", station), displaySpawn("gallery", station)],
  stationSpawns(stations)
)

commands: galleryCommands

bodies {
  capacity: (seatPopulation + visitorPopulation)
  localSeats: seatPopulation
  networkPlayers: visitorPopulation
  seatSpawns [hero]
}

// What a seat may press: the Moth's movement and forms, the context button that engages the console and the tap that
// presses its glass, and the terminal's own channels while engaged and while its console is open.
inputModes {
  global: concat(movementChannels, ["interact", "tap", "jump", "rise", "flight", "dash", "suit", "noclip"])
  families [
    terminalFamily()
    terminalConsoleFamily()
  ]
}

// The font the plinth labels and the console emboss and draw in, as the debug world declares it.
text {
  defaultFont: "inter"
  fonts [
    {
      name: "inter"
      source: "fonts/inter-regular.ttf"
      hash: "sha256/40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82"
      codePointRanges ["U+0020-U+007E"]
    }
  ]
}

state {
  world {
    galleryState(displays: stations)
    displayState(displays: stations)
  }
}

placements {
  // The floor, a plain slab under the station's pad.
  placement "station-floor" {
    prototype: "station-floor"
    position [0, 0, 0]
    solid
  }
  displayPlacements(displays: stations)
}

prototypes {
  galleryPrototypes(displays: stations)

  // A slab ten metres either way with its top at the floor's height and the station's cream pad under it: a paint on a
  // static creation stands in the world's frame, so the pad is placed at the display.
  prototype "station-floor" {
    document {
      name: "station-floor"
      schema: "puck.creation.v2"
      palette [
        {
          color: "#A9A395"
          roughness: 0.6
          specular: 0.04
          paints [
            {
              type: "Box"
              position: displayWorld(station, [0, 0, 0])
              scale [1.875, 0.2, 1.875]
              color: "#EADBBE"
            }
          ]
        }
      ]
      shape Box "slab" {
        material: 0
        position [0, -0.5, 0]
        scale [10, 0.5, 10]
      }
    }
  }
}

// The station's terminal and its console, one display's worth of rules and cameras.
shapeStation(displays: stations)
