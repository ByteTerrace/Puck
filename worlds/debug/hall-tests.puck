// The gallery hall (hall.puck), each scenario booted in the whole debug world: `puck test worlds/debug/hall-tests.puck
// --reproduce`. The lift's car is an attached solid riding a body that a rule poses along a box topology, and its doors
// and the blinds swap their colliders through `respond`; these scenarios pin the ride's exact floor stop and that a
// collider swap, and its swap back, reproduce from the checkpoint. The car's buttons stand on its back wall, one cell
// of the body's x each: door open at 15.42 and door close at 15.11. Enum members are written as their numbers: the
// rows reach this file only through the debug world's import of hall.puck.

schema: "puck.world.definition.v1"
basis: "debug"
documentId: "hall-tests"
import "stopped-machines"

test "the lift carries a standing Moth from level 0 to level 2" {
  when {
    seat1: body.pose 15.9 0.05 38.05 0 0 0 0
    ticks 30
    seat1: world.state.cell.set liftCall $value 2
    ticks 180
  }
  expect {
    liftAt == 144
    liftLevel == 2
    bodyPosition(body, 0, y) > 9
    bodyPosition(body, 0, y) < 9.15
    fact(body, 0, Grounded) == 1
    liftDoors.car == 1
    liftDoors.level0 == 0
    liftDoors.level1 == 0
    liftDoors.level2 == 1
    liftDoors.level3 == 0
  }
}

test "door open after door close brings the doors back and the lamp goes out" {
  when {
    seat1: body.pose 15.11 0.05 38.8 0 0 0 0
    ticks 30
    seat1: body.press interact 1 0.2 0
    ticks 10
    seat1: body.pose 15.42 0.05 38.8 0 0 0 0
    ticks 10
    seat1: body.press interact 1 0.2 0
    ticks 30
  }
  expect {
    liftDoors.car == 1
    liftDoors.level0 == 1
    liftLamp.open == 0
    liftLamp.close == 0
  }
}

// `hallBlinds` holds each level's blinds (Up 0, Down 1), and every level's start down. Each scenario poses body 0 at
// (27.5, 0.05, 14) in the lobby level's hall and body 8, a chess piece, out on the ground at (27.5, 0.05, 6), so the
// line of sight between them runs through the south window at x = 26 to 29 and reads whether that window's blind is
// down.
test "raising the lobby's blinds, as gallery.blinds does, opens the sight line" {
  when {
    seat1: body.pose 27.5 0.05 14 0 0 0 0
    seat1: body.pose 27.5 0.05 6 0 0 0 8
    seat1: world.state.cell.set hallBlinds level0 0
    ticks 30
  }
  expect {
    hallBlinds.level0 == 0
    hallBlinds.level1 == 1
    los(body, 0, body, 8) == 1
  }
}

test "lowering them again stops it" {
  when {
    seat1: body.pose 27.5 0.05 14 0 0 0 0
    seat1: body.pose 27.5 0.05 6 0 0 0 8
    seat1: world.state.cell.set hallBlinds level0 0
    ticks 30
    seat1: world.state.cell.set hallBlinds level0 1
    ticks 30
  }
  expect {
    hallBlinds.level0 == 1
    los(body, 0, body, 8) == 0
  }
}
