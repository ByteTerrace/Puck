// The card table's scenarios (cardtable.puck, klondike.puck), each booted in the whole debug world:
// `puck test worlds/debug/cardtable-tests.puck --reproduce`. The table deals by itself at boot from the seeded stream,
// so every scenario sees the same deal: the tableau columns (piles 2 to 8) hold 1 to 7 cards and the stock (pile 0)
// 24, and the cards on show are the jack of spades (card 10) on pile 2, the six of hearts (18) on 3, the jack of hearts
// (23) on 4, the five of diamonds (43) on 5, the king of hearts (25) on 6, the nine of spades (9 of 0..12: card 8) on
// 7 and the ace of diamonds (39) on 8. A card is suit * 13 + rank - 1 with suits spades, hearts, clubs, diamonds.

schema: "puck.world.definition.v1"
basis: "debug"
documentId: "debug"
import "stopped-machines"

// The deal: a card a tick gathers, shuffles, then deals the 28 cards of the tableau; the stock keeps 24, and the last
// card of each column shows its face.
test "the seeded deal fills the tableau and leaves 24 in the stock" {
  when {
    ticks 400
  }
  expect {
    solitaireKlondike.deals == 1
    solitaireKlondike.status == 1
    count(solitaireKlondikePile0) == 24
    count(solitaireKlondikePile1) == 0
    count(solitaireKlondikePile2) == 1
    count(solitaireKlondikePile5) == 4
    count(solitaireKlondikePile8) == 7
    solitaireKlondikeFace[10] == 1
    solitaireKlondikeFace[39] == 1
    solitaireKlondikeFace[11] == 0
  }
}

// The ace of diamonds is the last card of pile 8 and diamonds are suit 3, foundation pile 13: a legal move. The console
// plays it through the same mailbox; the column's next card turns face up.
test "a legal move takes the ace to its foundation and turns the next card up" {
  when {
    ticks 400
    seat1: world.state.cell.set solitaireKlondike from 8
    seat1: world.state.cell.set solitaireKlondike to 13
    seat1: world.state.cell.set solitaireKlondike card 39
    seat1: world.state.cell.set solitaireKlondike action 2
    seat1: world.state.cell.set solitaireKlondike request 1 add
    ticks 20
  }
  expect {
    solitaireKlondike.result == 1
    solitaireKlondike.moves == 1
    count(solitaireKlondikePile13) == 1
    count(solitaireKlondikePile8) == 6
    solitaireKlondikeFace[21] == 1
    solitaireKlondike.score == 10
  }
}

// The jack of spades is no card to put on the six of hearts: the door refuses the move, says so in `result`, and the
// piles stay as dealt.
test "an illegal move is refused and the piles stay as dealt" {
  when {
    ticks 400
    seat1: world.state.cell.set solitaireKlondike from 2
    seat1: world.state.cell.set solitaireKlondike to 3
    seat1: world.state.cell.set solitaireKlondike card 10
    seat1: world.state.cell.set solitaireKlondike action 2
    seat1: world.state.cell.set solitaireKlondike request 1 add
    ticks 20
  }
  expect {
    solitaireKlondike.result == -1
    solitaireKlondike.moves == 0
    count(solitaireKlondikePile2) == 1
    count(solitaireKlondikePile3) == 2
  }
}

// The stock draws one card to the waste face up.
test "the stock draws a card to the waste" {
  when {
    ticks 400
    seat1: world.state.cell.set solitaireKlondike action 3
    seat1: world.state.cell.set solitaireKlondike request 1 add
    ticks 20
  }
  expect {
    solitaireKlondike.moves == 1
    count(solitaireKlondikePile0) == 23
    count(solitaireKlondikePile1) == 1
  }
}

// Seat 1 sits in the chair at the -Z edge, moves the cursor six columns right to the ace of diamonds, lifts it, goes up
// to the top row (the diamonds' foundation, over it) and puts it down: the same move through the pick button.
test "a seated player lifts the ace and plays it on its foundation" {
  when {
    ticks 400
    seat1: body.pose 60.8 9.25 34.4 180 0 0 0
    ticks 60
    seat1: body.press interact
    ticks 10
    seat1: body.press strafe 1 0.1
    ticks 8
    seat1: body.press strafe 1 0.1
    ticks 8
    seat1: body.press strafe 1 0.1
    ticks 8
    seat1: body.press strafe 1 0.1
    ticks 8
    seat1: body.press strafe 1 0.1
    ticks 8
    seat1: body.press strafe 1 0.1
    ticks 8
    seat1: body.press confirm 1 0.1
    ticks 8
    seat1: body.press forward 1 0.1
    ticks 8
    seat1: body.press confirm 1 0.1
    ticks 120
  }
  expect {
    board(engaged, kBoard, 1) == 1
    solitaireKlondike.moves == 1
    count(solitaireKlondikePile13) == 1
    count(solitaireKlondikePile8) == 6
    kSeat.heldZone == -1
  }
}
