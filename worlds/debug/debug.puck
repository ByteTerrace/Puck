// The debug world: a flat 256 m ground under a clear day, with axis markers beside the spawn, reference cubes and
// the Moth avatar to walk it, and an open-fronted coloured room beside them for judging indirect light. Its portals
// are paintings in the gallery hall's east wing (paintings.puck): two onto other lands, the garden (garden.puck) and
// the night field (night.puck), two facing each other across the room, and the endless fall's floor and ceiling. It is
// the plain starting point the island is built up from, in engine: boot its package with `--world worlds/debug`, edit
// this source, and `world.reload` recompiles it in place. debug.md beside it says how to demo and inspect the portals.
// The skin (skin.puck) and the on-screen controls (controls.puck: cursor, key hints, binding bar, play
// wheel) are imported documents, as are the gaming devices (devices.puck) in Wonderland, the room a portal pair of two
// sizes shrinks the Moth into (wonderland.puck), the whole desktop as a pane and a screen (desktop.puck), the board
// game room's chess, Go and Reversi tables (chess.puck, go.puck, reversi.puck), the paintings (paintings.puck) and the
// named places with the `debug.go` console command that reaches them (places.puck), each with notes beside it, and the Moth's suit on/off
// toggle (suit.puck) under her noclip toggle (noclip.puck, which imports the suit and replaces its kit selector).

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "debug"

import "skies"
import "shapes"
import "studio"
import "skin"
import "controls"
import "pad"
import "devices"
import "desktop"
// The board game room's Go and Reversi tables, ahead of every other population so their stones and discs take the
// population's top slots (shapes.puck's boardRoomBodies) and every body below keeps its index.
import "go"
import "reversi"
import "fuzzer"
import "traversal"
import "kinematics-scope"
import "companion"
import "hall"
import "chess"
import "paintings"
import "wonderland"
import "camera-course"
import "probe-beacon"
import "places"
import "noclip"
import "size"
import "addon-hud"
import "watchdog"
import "guide"
import "machine-debugger"
import "range"

// The test room's palette slots.
let roomWhite = 0 // #E6E2DA
let roomRed = 1 // #C8322B
let roomGreen = 2 // #2FA84A

metadata {
  title: "Debug"
  description: "A flat 256 m ground under a clear day, with axis markers, 1, 2 and 4 m reference cubes, a coloured test room near the origin and a gallery hall whose east wing holds five portal paintings."
}

// A traveller coming back from the garden or the night field arrives here, and their windows onto this world observe
// it whole.
admission [
  {
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 8
        capability: Drive
        exclusive: true
      }
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
  }
]

references [
  {
    document: "garden"
    name: "garden"
  }
  {
    document: "night"
    name: "night"
  }
]

destinations [
  {
    durability: persisted
    name: "garden"
    reference: "garden"
    scope: global
  }
  {
    durability: persisted
    name: "night"
    reference: "night"
    scope: global
  }
]

// The font the shape gallery's plinth labels emboss in.
text {
  defaultFont: "inter"
  fonts [
    {
      name: "inter"
      source: "fonts/inter-regular.ttf"
      hash: "sha256/40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82"
      codePointRanges ["U+0020-U+007E"]
    }
  ]
}

// How many levels of windows inside windows the presentation draws; a face past it shows its session's fallback colour.
// Six paintings that each show a world holding the six make every level six times the one before, so two levels.
views {
  nestingDepth: 2
  studioLayouts()
}

// The probe's camera (probe-beacon.puck): a small offscreen view of the reference cubes from the south, which the probe
// tints and the camera course's screen shows.
cameras: concat(
  studioCameras,
  motionCameras,
  [
    {
      anchor: null
      name: "beacon-eye"
      renderHeight: 72
      renderWidth: 128
      rig {
        name: "beacon-eye"
        operations [
          anchor(subject: worldPoint(point: [-8, 2.5, 13]))
          lookAt(subject: worldPoint(point: [-8, 1.5, 6]))
          fieldOfView(fieldOfViewRadians: 0.9)
        ]
        version: "puck.camera.program.v1"
      }
    }
  ]
)

// Recovery at the hero spawn lands above the studio platform. The gallery adds a spawn point per exhibit
// (shapes.puck's gallerySpawns) and the gallery.* commands (galleryCommands) that walk, inspect and flag them.
spawnPoints: concat([
  { id: "hero", position [48, 0.33, -48], yawDegrees: 0 }
  { id: "stage", position [0, 0, 0], yawDegrees: 0 }
], gallerySpawns)

commands: galleryCommands

// The board game room's Go and Reversi bodies take the top slots (go.puck, reversi.puck); below them the development
// fuzzer and traversal bot take bodies 44 and 43 and the companion keeps 42. The gallery hall and chess imports keep
// their existing indices. Each import names its population; this body settles the total. The rate range's six
// walkers, imported last, take the free slots below the pieces (range.puck). Each body's size is its `size` register
// (size.puck).
bodies {
  capacity: (galleryPopulation + 2 + boardRoomBodies)
}

placements {
  // Twelve derived face screens: the painting wing's six canvases (paintings.puck), the Wonderland doors' two
  // (wonderland.puck), the rate range's three windows (range.puck) and the probe screen (camera-course.puck).
  policy {
    authoringHeadroomInstances: 4096
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    derivedFaceScreens: 12
    maxPlacementScale: 1
    minPlacementScale: 1
    previewDeadlineFrames: 1
  }

  // The axis markers meet at (2, 0, 0), two metres to the spawn's +X side, so the up pole stands beside the avatar in
  // every spawn and chase view rather than through it.
  placement "axis-x" {
    prototype: "axis-x"
    position [10, 0.02, 0]
  }

  placement "axis-z" {
    prototype: "axis-z"
    position [2, 0.02, 8]
  }

  placement "axis-up" {
    prototype: "axis-up"
    position [2, 2, 0]
  }

  placement "cube-1m" {
    prototype: "cube-1m"
    position [-4, 0.5, 6]
    solid
  }

  placement "cube-2m" {
    prototype: "cube-2m"
    position [-7, 1, 6]
    solid
  }

  placement "cube-4m" {
    prototype: "cube-4m"
    position [-12, 2, 6]
    solid
  }

  placement "gi-corner" {
    prototype: "gi-corner"
    position [-2, 0, 13]
    yawDegrees: -45
    solid
  }

  // The shape gallery (shapes.puck): every authorable construct, and two rows of motion, on the open ground at +X/+Z.
  galleryPlacements()
  studioPlacements()
}

// The shape gallery's motion controls (shapes.md): its clock, the per-exhibit motion gates and the cells its
// state-bound exhibits read.
state {
  world {
    galleryState()
  }
}

prototypes {
  galleryPrototypes()
  studioPrototypes()

  prototype "floor" {
    document {
      name: "floor"
      palette [
        {
          color: "#8C8C8C"
          roughness: 0.9
          specular: 0.02
        }
      ]
      schema: "puck.creation.v1"
      shape Box "ground" {
        material: 0
        position [0, -0.2, 0]
        scale [128, 0.2, 128]
      }
    }
  }

  prototype "axis-x" {
    document {
      name: "axis-x"
      palette [
        {
          color: "#FF3B30"
          roughness: 0.6
        }
      ]
      schema: "puck.creation.v1"
      shape Box "line" {
        material: 0
        position [0, 0, 0]
        scale [8, 0.02, 0.05]
      }
    }
  }

  prototype "axis-z" {
    document {
      name: "axis-z"
      palette [
        {
          color: "#2F6BFF"
          roughness: 0.6
        }
      ]
      schema: "puck.creation.v1"
      shape Box "line" {
        material: 0
        position [0, 0, 0]
        scale [0.05, 0.02, 8]
      }
    }
  }

  prototype "axis-up" {
    document {
      name: "axis-up"
      palette [
        {
          color: "#F2F2F2"
          roughness: 0.6
        }
      ]
      schema: "puck.creation.v1"
      shape Box "pole" {
        material: 0
        position [0, 0, 0]
        scale [0.04, 2, 0.04]
      }
    }
  }

  prototype "cube-1m" {
    document {
      name: "cube-1m"
      palette [
        {
          color: "#E8B341"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [0.5, 0.5, 0.5]
      }
    }
  }

  prototype "cube-2m" {
    document {
      name: "cube-2m"
      palette [
        {
          color: "#5BC98C"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [1, 1, 1]
      }
    }
  }

  // A Cornell-style room for judging indirect light: red and green side walls, a white back wall between them, ceiling
  // and raised floor, two white blocks, and one open side. Bounced light and colour bleed show inside it, where the open
  // sky elsewhere in this world hides them. The plates abut without overlapping, and the copy bakes as their one union
  // mesh.
  prototype "gi-corner" {
    document {
      name: "gi-corner"
      palette [
        {
          color: "#E6E2DA"
          roughness: 0.9
          specular: 0.02
        }
        {
          color: "#C8322B"
          roughness: 0.9
          specular: 0.02
        }
        {
          color: "#2FA84A"
          roughness: 0.9
          specular: 0.02
        }
      ]
      schema: "puck.creation.v1"
      shape Box "floor" {
        material: roomWhite
        position [0, 0.05, 0]
        scale [2.1, 0.05, 2.1]
      }
      shape Box "red-wall" {
        material: roomRed
        position [-2.05, 1.6, 0]
        scale [0.05, 1.5, 2.1]
      }
      shape Box "green-wall" {
        material: roomGreen
        position [2.05, 1.6, 0]
        scale [0.05, 1.5, 2.1]
      }
      shape Box "back-wall" {
        material: roomWhite
        position [0, 1.6, -2.05]
        scale [2, 1.5, 0.05]
      }
      shape Box "ceiling" {
        material: roomWhite
        position [0, 3.15, 0]
        scale [2.1, 0.05, 2.1]
      }
      shape Box "low-block" {
        material: roomWhite
        position [0.8, 0.6, 0.4]
        scale [0.5, 0.5, 0.5]
      }
      shape Box "tall-block" {
        material: roomWhite
        position [-0.7, 1.1, -0.7]
        scale [0.5, 1, 0.5]
      }
    }
  }

  prototype "cube-4m" {
    document {
      name: "cube-4m"
      palette [
        {
          color: "#5EEBE0"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [2, 2, 2]
      }
    }
  }
}

// The world's views boot reconstructing over time, as the shipped `world.quality high` preset renders: the jittered
// samples resolve detail finer than a pixel, such as the shadowed crease under each reference cube's filleted foot,
// which one sample a pixel catches only where the silhouette steps.
render {
  bloom {
    scatter: 0.04
    radius: 0.08
  }
  farDistance: 200
  temporal: true
  sky {
    clearDay(cloudiness: 0.3)
  }
  atmosphere {
    clearDayAir()
  }
}

// The ground is 256 m across with nothing beneath it. Forty metres under the lowest ground a body is out of the world,
// and the rule stands every live body that falls there, a seat's Moth or any other, back up at the hero spawn.
let respawnFloor = -40

rule "fall-respawn" {
  when bodyPosition(each, y) < respawnFloor
  mode: Level
  forEach: $bodies
  pose(key: $each, spawnPoint: "hero")
}
