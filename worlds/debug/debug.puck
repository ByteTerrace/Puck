// The debug world: a caldera's flat floor (valley.puck) under a clear day, with reference
// cubes and the Moth avatar to walk it, and an open-fronted coloured room beside them for judging indirect light. Its
// portals are paintings in the gallery hall's east wing (paintings.puck): three onto other lands, the garden
// (garden.puck), the night field (night.puck) and the city (city.puck), two facing each other across the room, and the
// endless fall's floor and ceiling. It is
// the plain starting point the island is built up from, in engine: boot its package with `--world worlds/debug`, edit
// this source, and `world.reload` recompiles it in place. debug.md beside it says how to demo and inspect the portals.
// The skin (skin.puck) and the on-screen controls (controls.puck: cursor, key hints, binding bar, play
// wheel) are imported documents, as are the gaming devices (devices.puck) in Wonderland, the room a portal pair of two
// sizes shrinks the Moth into (wonderland.puck), the whole desktop as a pane and a screen (desktop.puck), the board
// game room's chess, Go, Reversi and Alchemy tables (chess.puck, go.puck, reversi.puck, alchemy.puck), the paintings
// (paintings.puck) and the named places with the `debug.go` console command that reaches them (places.puck), each with
// notes beside it, and the Moth's suit on/off toggle (suit.puck) under her noclip toggle (noclip.puck, which imports the
// suit and replaces its kit selector).

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "debug"

import "../standard/skies"
import "../standard/free-camera"
import "../standard/benchmark"
import "../standard/visitors"
// The benchmark's route through this world (`world.benchmark run debug`).
import "benchmark-route"
// The trip to the moon as a route (`world.benchmark run moon`).
import "moon-route"
import "shapes"
import "studio"
import "controls"
import "devices"
import "desktop"
// The launch field's ship takes the added highest slot (launch.puck), and the portal's host-mesh witness the one below
// it; every existing body keeps its index.
import "launch"
import "portal-rows"
// The free camera's body, ahead of the remaining inhabitants (free-camera.puck).
import "free-camera"
// The board game room's card, granary board, Alchemy, Go and Reversi tables, ahead of every other population so their
// cards, cursors, tokens, stones and discs take the population's top slots (shapes.puck's cardBodies and
// boardRoomBodies) and every body below keeps its index.
import "cardtable"
import "granaries"
import "alchemy"
import "go"
import "reversi"
import "fuzzer"
import "traversal"
import "kinematics-scope"
import "companion"
import "hall"
import "chess"
// The board game room's hidden-information tables, which hold no bodies: the sealed-bid auction, the shedding card game,
// social deduction and the fog-of-war skirmish (auction.puck, shedding.puck, deduction.puck, skirmish.puck).
import "auction"
import "shedding"
import "deduction"
import "skirmish"
import "paintings"
import "wonderland"
import "camera-course"
import "probe-beacon"
import "places"
import "navigation"
import "noclip"
import "input-modes"
// The seat's instrument and the score its presses are judged against (bard.puck).
import "bard"
import "press"
import "size"
import "addon-hud"
import "watchdog"
import "guide"
import "machine-debugger"
import "range"
import "valley"
import "lawn"
// The water: the chain from glacier to aquifer (water.puck) and the pool the river ends in (pool.puck).
import "water"
import "pool"
import "water-scenery"
import "forest"
// The time of day: the sun and the sky on one clock (day.puck).
import "day"

// The test room's palette slots.
let roomWhite = 0 // #E6E2DA
let roomRed = 1 // #C8322B
let roomGreen = 2 // #2FA84A

metadata {
  title: "Debug"
  description: "The flat floor of a caldera ringed by eight terrain sectors with an overlook, under a clear day, with axis markers, 1, 2 and 4 m reference cubes, a coloured test room near the origin and a gallery hall whose east wing holds five portal paintings."
}

host {
  authorityNamespace: "debug"
}

// Neighbour windows observe the whole world as sessions; arriving visitors receive the standard visitor row (exclusive
// Drive and Observe over the body admission assigns, at presentation disclosure).
admission [
  {
    admits: Session
    disclosure: Replica
    domain: "*"
    grants [
      {
        budget: 8
        capability: Drive
        exclusive: true
      }
      {
        budget: 64
        capability: Observe
        subject: "all"
      }
    ]
    mode: FederatedAuthority
  }
  visitorAdmissionRow(domain: "*")
  {
    algorithm: "ecdsa-p256-sha256"
    domain: "ef477b67ae7304fc7db5d9cc98c101996ca868c4d586a1f267c295bb3aadeac1"
    grants []
    mode: SignsDirectly
    publicKey: "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEK6YHKsnbnPH91j+oBw15qkyQ/GTa/RqSBxwS/hJYIBfFP8U4Nvp/5CgWRByeGqXPrf9KdJ3NSaqXWIfXpptImw=="
    subject: "debug"
  }
]

references [
  {
    document: "garden"
    name: "garden"
  }
  {
    document: "night"
    name: "night"
  }
  {
    document: "city"
    name: "city"
  }
  {
    document: "moon"
    name: "moon"
  }
]

destinations [
  {
    durability: persisted
    name: "garden"
    reference: "garden"
    scope: global
  }
  {
    durability: persisted
    name: "night"
    reference: "night"
    scope: global
  }
  {
    durability: persisted
    name: "city"
    reference: "city"
    scope: global
  }
  {
    durability: persisted
    name: "moon"
    reference: "moon"
    scope: global
  }
]

// The font the shape gallery's plinth labels emboss in.
text {
  defaultFont: "inter"
  fonts [
    {
      name: "inter"
      source: "fonts/inter-regular.ttf"
      hash: "sha256/40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82"
      codePointRanges ["U+0020-U+007E"]
    }
  ]
}

// How many levels of windows inside windows the presentation draws; a face past it shows its session's fallback colour.
// Six paintings that each show a world holding the six make every level six times the one before, so two levels.
views {
  nestingDepth: 2
  studioLayouts()
}

// The probe's camera (probe-beacon.puck): a small offscreen view of the reference cubes from the south, which the probe
// tints and the camera course's screen shows.
cameras: concat(
  studioCameras,
  motionCameras,
  [
    {
      anchor: null
      name: "beacon-eye"
      renderHeight: 72
      renderWidth: 128
      rig {
        name: "beacon-eye"
        operations [
          anchor(subject: worldPoint(point: [-8, 2.5, 13]))
          lookAt(subject: worldPoint(point: [-8, 1.5, 6]))
          fieldOfView(fieldOfViewRadians: 0.9)
        ]
        version: "puck.camera.program.v1"
      }
    }
  ]
)

// Recovery at the hero spawn lands above the studio platform. The gallery adds a spawn point per exhibit
// (shapes.puck's gallerySpawns) and the gallery.* commands (galleryCommands) that walk, inspect and flag them.
spawnPoints: concat(
  [
    { id: "hero", position [48, 0.33, -48], yawDegrees: 0 }
    { id: "stage", position [0, 0, 0], yawDegrees: 0 }
  ],
  gallerySpawns
)

commands: galleryCommands

// The board game room's Go and Reversi bodies take the top slots (go.puck, reversi.puck); below them the development
// fuzzer and traversal bot take bodies 54 and 53 and the companion takes 52. The gallery hall and chess imports keep
// their relative order above the four local-seat and eight visitor slots. Each import names its population; this body
// settles the total, the last one the launch field's ship (launch.puck). The rate range's six
// walkers, imported last, take the slots below the pieces (range.puck). Each body's size is its `size` register
// (size.puck).
bodies {
  capacity: (galleryPopulation + 2 + boardRoomBodies + cardBodies + seatPopulation + 1 + 1)
  localSeats: seatPopulation
  networkPlayers: visitorPopulation
  reconnectGraceSeconds: 3
}

// Extend suit, flight-pack and noclip toggles beyond body 0 to the remaining local seats and admitted visitors.
for b in range(1, (seatPopulation + visitorPopulation)) {
  rule $"suit-toggle-body-{b}" {
    when channel(body, b, suit) >= 1 and fact(body, b, Airborne) == 0
    mode: Edge
    setBodyState(key: $"{b}", state: "suit", expression: 1 - bodyState(body, b, suit))
  }
  rule $"suit-off-flight-body-{b}" {
    when bodyState(body, b, suit) == 0 and bodyState(body, b, flightFuel) > 0
    mode: Level
    setBodyState(key: $"{b}", state: "flightFuel", expression: 0)
  }
  rule $"fly-body-{b}" {
    when channel(body, b, rise) >= 1 and channel(body, b, jump) == 0 and bodyState(body, b, flightFuel) == 0 and bodyState(body, b, suit) == 1
    mode: Level
    setBodyState(key: $"{b}", state: "flightFuel", expression: 1000)
  }
  rule $"noclip-toggle-body-{b}" {
    when channel(body, b, noclip) >= 1
    mode: Edge
    setBodyState(key: $"{b}", state: "noclip", expression: 1 - bodyState(body, b, noclip))
  }
}

placements {
  policy {
    authoringHeadroomInstances: 4096
    authoringHeadroomScreens: 0
    candidateCap: 1
    candidateRadius: 1
    maxPlacementScale: 2.5
    // The shedding table's racks stand the standard deck's cards at 0.06 (shedding.puck).
    minPlacementScale: 0.06
    previewDeadlineFrames: 1
  }

  placement "cube-1m" {
    prototype: "cube-1m"
    position [-4, 0.5, 6]
    solid
  }

  placement "cube-2m" {
    prototype: "cube-2m"
    position [-7, 1, 6]
    solid
  }

  placement "cube-4m" {
    prototype: "cube-4m"
    position [-12, 2, 6]
    solid
  }

  placement "gi-corner" {
    prototype: "gi-corner"
    position [-2, 0, 13]
    yawDegrees: -45
    solid
  }

  // The shape gallery (shapes.puck): every authorable construct, and two rows of motion, on the open ground at +X/+Z.
  galleryPlacements()
  studioPlacements()
}

// The shape gallery's motion controls (shapes.md): its clock, the per-exhibit motion gates and the cells its
// state-bound exhibits read.
state {
  world {
    galleryState()
  }
}

prototypes {
  galleryPrototypes()
  studioPrototypes()

  prototype "cube-1m" {
    document {
      name: "cube-1m"
      palette [
        {
          color: "#E8B341"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [0.5, 0.5, 0.5]
      }
    }
  }

  prototype "cube-2m" {
    document {
      name: "cube-2m"
      palette [
        {
          color: "#5BC98C"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [1, 1, 1]
      }
    }
  }

  // A Cornell-style room for judging indirect light: red and green side walls, a white back wall between them, ceiling
  // and raised floor, two white blocks, and one open side. Bounced light and colour bleed show inside it, where the open
  // sky elsewhere in this world hides them. The plates abut without overlapping, and the copy bakes as their one union
  // mesh.
  prototype "gi-corner" {
    document {
      name: "gi-corner"
      palette [
        {
          color: "#E6E2DA"
          roughness: 0.9
          specular: 0.02
        }
        {
          color: "#C8322B"
          roughness: 0.9
          specular: 0.02
        }
        {
          color: "#2FA84A"
          roughness: 0.9
          specular: 0.02
        }
      ]
      schema: "puck.creation.v1"
      shape Box "floor" {
        material: roomWhite
        position [0, 0.05, 0]
        scale [2.1, 0.05, 2.1]
      }
      shape Box "red-wall" {
        material: roomRed
        position [-2.05, 1.6, 0]
        scale [0.05, 1.5, 2.1]
      }
      shape Box "green-wall" {
        material: roomGreen
        position [2.05, 1.6, 0]
        scale [0.05, 1.5, 2.1]
      }
      shape Box "back-wall" {
        material: roomWhite
        position [0, 1.6, -2.05]
        scale [2, 1.5, 0.05]
      }
      shape Box "ceiling" {
        material: roomWhite
        position [0, 3.15, 0]
        scale [2.1, 0.05, 2.1]
      }
      shape Box "low-block" {
        material: roomWhite
        position [0.8, 0.6, 0.4]
        scale [0.5, 0.5, 0.5]
      }
      shape Box "tall-block" {
        material: roomWhite
        position [-0.7, 1.1, -0.7]
        scale [0.5, 1, 0.5]
      }
    }
  }

  prototype "cube-4m" {
    document {
      name: "cube-4m"
      palette [
        {
          color: "#5EEBE0"
          roughness: 0.7
        }
      ]
      schema: "puck.creation.v1"
      shape Box "cube" {
        material: 0
        position [0, 0, 0]
        scale [2, 2, 2]
      }
    }
  }
}

// The world's views boot reconstructing over time, as the shipped `world.quality high` preset renders: the jittered
// samples resolve detail finer than a pixel, such as the shadowed crease under each reference cube's filleted foot,
// which one sample a pixel catches only where the silhouette steps.
render {
  bloom {
    scatter: 0.04
    radius: 0.08
  }
  farDistance: 6000
  temporal: true
  // As the shipped presets do, the indirect volume's rays take the ray hardware where the device has it.
  rayQueries: true
  // As the shipped high preset does (../standard/quality.puck), the ridges shadow the far walls from a distant map.
  distantShadows {
    reach: 1200
    texels: 2048
    frames: 4
  }
  // A clear day's air (the standard's `clearDayAir` density), thinning with height as air does, so a ship climbing to
  // the sky seam looks down on the valley through less and less of it.
  atmosphere {
    fog {
      density: 0.0006
      height {
        base: 0
        falloff: 900
      }
    }
  }
}
