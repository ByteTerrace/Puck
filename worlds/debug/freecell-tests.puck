// The FreeCell scenarios (../games/freecell.puck, ../games/patience-station.puck) on two game stations of their own
// (game-stations.puck's gameStationRoom), `one` showing FreeCell and `two` showing chess:
// `puck test worlds/debug/freecell-tests.puck --reproduce`. Each station deals by itself, from its own seeded stream, once
// FreeCell is shown. Piles are 0 to 3 the free cells, 4 to 7 the foundations and 8 to 15 the columns. What any one
// card's place is depends on the seeded deal, so these claims read only what every deal shares.

schema: "puck.world.definition.v1"
basis: "avatars/moth"
documentId: "freecell-tests"

import "game-stations"

let stations = [{ id: "one", at [0, -0.5, 0] }, { id: "two", at [4, -0.5, 0] }]

gameStationRoom(stations: stations)

state {
  // The chess game's vocabularies (game-stations.puck's header).
  enum PieceKind {
    None
    Pawn
    Knight
    Bishop
    Rook
    Queen
    King
  }

  enum MoveKind {
    Illegal
    Quiet
    Capture
    EnPassant
    Castle
  }

  enum TurnColor {
    White
    Black
  }
}

use gameStationGames as one(station: stations[0])
use gameStationGames as two(station: stations[1])

// The deal: a card a tick gathers, shuffles, then deals the 52 cards across the eight columns, 7, 7, 7, 7, 6, 6, 6, 6.
test "the seeded deal fills the eight columns and leaves the cells and foundations empty" {
  given {
    gameStationGame.one = 2
  }
  when {
    ticks 400
  }
  expect {
    one.solitaireFreecell.deals == 1
    one.solitaireFreecell.status == 1
    count(one.solitaireFreecellPile8) == 7
    count(one.solitaireFreecellPile11) == 7
    count(one.solitaireFreecellPile12) == 6
    count(one.solitaireFreecellPile15) == 6
    count(one.solitaireFreecellDeck) == 0
    count(one.solitaireFreecellPile0) == 0
    count(one.solitaireFreecellPile4) == 0
  }
}

// A free cell is empty after the deal, so a move out of it is refused and the piles stand as dealt.
test "a move out of an empty free cell is refused" {
  given {
    gameStationGame.one = 2
  }
  when {
    ticks 400
    seat1: world.state.cell.set one$solitaireFreecell from 0
    seat1: world.state.cell.set one$solitaireFreecell to 8
    seat1: world.state.cell.set one$solitaireFreecell card 0
    seat1: world.state.cell.set one$solitaireFreecell action 2
    seat1: world.state.cell.set one$solitaireFreecell request 1 add
    ticks 20
  }
  expect {
    one.solitaireFreecell.result == -1
    one.solitaireFreecell.moves == 0
    count(one.solitaireFreecellPile8) == 7
  }
}

// The stations hold their own games: FreeCell dealt and played at one leaves the other's untouched, its deck whole and
// its chess game where it began.
test "a game at one station never touches another" {
  given {
    gameStationGame.one = 2
  }
  when {
    ticks 400
    seat1: world.state.cell.set one$solitaireFreecell from 0
    seat1: world.state.cell.set one$solitaireFreecell to 8
    seat1: world.state.cell.set one$solitaireFreecell card 0
    seat1: world.state.cell.set one$solitaireFreecell action 2
    seat1: world.state.cell.set one$solitaireFreecell request 1 add
    ticks 20
  }
  expect {
    one.solitaireFreecell.deals == 1
    two.solitaireFreecell.deals == 0
    count(two.solitaireFreecellDeck) == 52
    two.solitaire.table == 0
    two.turn == 0
    two.solitaireFreecell.request == 0
  }
}
