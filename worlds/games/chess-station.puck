// Chess on a game station's glass (../standard/game-station.puck): the board drawn as paints on the glass, the pieces
// as tokens of the standard's chess set (../standard/chess-pieces.puck) on its squares, and the seat's play, all read
// from and written to the one chess game the world composes (chess.puck's rows: a drawn board's chess-game.puck, or a
// physical table's own). A module library: a world expands its templates beside the station's, with the chess game's
// place in the station's catalog (`game`).
//
//   import "chess-station"
//   prototypes { gameStationPrototype(station: s, catalog: c, boardPanels: chessStationPanels(s))  chessStationPrototypes() }
//   placements { chessStationTokens(station: s, game: 0) }
//   state { world { chessStationState(stations [s]) } }
//   chessStationRules(station: s, game: 0, ordinal: 0)
//
// The board is 14 cm squares filling the board area, its columns running +X and its rows +Z from the seat, so a
// square's cell is the chess board's own (8 * row + column): rank 1 nearest the seat and the a-file (column 7) at the
// seat's left, White's side. A square is two paints: its fill, light or dark, whose colour is the station's board ink
// (the bare glass while another game is shown, so the board comes and goes in two writes), and over it a ring whose
// colour is the square's own: the bare glass at rest, so it draws the board's grid, and lit for the cursor, the lifted
// piece and the last move. The seat points at a square or steps the cursor; a pick on a piece of the side to move lifts
// it, a pick on another square asks the game's display door (`chessPut`) for the move, and a pick on the lifted piece or
// the cancel button puts it down. The door judges the move as it judges any other, and the glass draws the board the
// game then holds.
import "../standard/game-station"
import "../standard/chess-pieces"

let chessStationSquare = 0.14
// A square's span in pick cells, the pieces' scale (the standard's set stands on a 10 cm square), and the board's near
// right corner as a pick cell of the station's grid.
let chessStationCells = 5
let chessStationPieceScale = 1.4
let chessStationColumn0 = 0
let chessStationRow0 = 4
let chessStationX0 = (gameStationBoard.x0 + (gameStationCell * chessStationColumn0))
let chessStationZ0 = (gameStationBoard.z0 + (gameStationCell * chessStationRow0))
// A square's centre in the station's frame, [x, z], and whether it is light (row + column even: column 0 of rank 1 is
// h1, so a1 is dark at the seat's left).
function chessStationSquareAt(cell) = [(chessStationX0 + (chessStationSquare * ((cell % 8) + 0.5))), (chessStationZ0 + (chessStationSquare * (floor(cell / 8) + 0.5)))]
let chessStationParity = map(range(0, 64), cell => ((floor(cell / 8) + (cell % 8)) % 2))
// The rings' codes, which name their inks in `chessStationInks`.
let chessStationRings = { last: 2, picked: 3, cursor: 4, rest: 5 }
let chessStationLineTexts = ["WHITE TO MOVE", "BLACK TO MOVE", "WHITE IS IN CHECK", "BLACK IS IN CHECK", "THE COMPUTER IS MOVING", "DRAWN"]

// The pieces' two sides: ivory with amber trim, charcoal with teal trim, each glowing faintly as the glass's content does.
let chessStationPieces = [
  {
    name: "white"
    body { color: "#EFE6D2", roughness: 0.35, specular: 0.3, emissive: 120 }
    trim { color: "#FFC46A", roughness: 0.3, specular: 0.2, emissive: 400 }
  }
  {
    name: "black"
    body { color: "#1C2026", roughness: 0.25, specular: 0.4, coat: 0.5 }
    trim { color: "#8FD8DE", roughness: 0.3, specular: 0.2, emissive: 400 }
  }
]
let chessStationCodes = flatMap(range(0, 2), s => map(range(0, 6), k => {
  value: (1 - (2 * s)) * (k + 1)
  prototype: $"chessStation-{chessStationPieces[s].name}-{chessPieceKinds[k]}"
}))

function chessStationSquarePaints(station, cell) = [
  displayFill(
    gameStationWorld(station, chessStationSquareAt(cell)[0], chessStationSquareAt(cell)[1]),
    [0.068, 0.068],
    ((chessStationParity[cell] == 0) ? $"state.chessStationBoardInk.{station.id}-light" : $"state.chessStationBoardInk.{station.id}-dark"),
    0.004
  )
  displayRing(
    gameStationWorld(station, chessStationSquareAt(cell)[0], chessStationSquareAt(cell)[1]),
    [0.06, 0.06],
    $"state.chessStationRingInk.{station.id}-{cell}",
    0.008
  )
]

// The board area's panels for a station's prototype: two ranks a panel, from the board area's near edge to the glass's
// far edge, so each carries 32 paints.
function chessStationPanels(station) = map([0, 2, 4, 6], first => {
  z0: ((first == 0) ? gameStationBoard.z0 : (chessStationZ0 + (chessStationSquare * first)))
  z1: ((first == 6) ? gameStationGlass.z1 : (chessStationZ0 + (chessStationSquare * (first + 2))))
  paints: flatMap(range((8 * first), (8 * (first + 2))), cell => chessStationSquarePaints(station, cell))
})

template chessStationPrototypes() {
  chessPiecePrototypes(prefix: "chessStation", sides: chessStationPieces)
  gameStationTokenBlank(id: "chessStationBlank")
}

// The pieces on a station's squares, while the station shows chess (its catalog index `game`).
template chessStationTokens(station, game) {
  gameStationTokens(
    prefix: $"{station.id}-chess-",
    station: station,
    game: game,
    row: board,
    keys: map(range(0, 64), cell => $"{cell}"),
    centres: map(range(0, 64), cell => chessStationSquareAt(cell)),
    codes: chessStationCodes,
    blank: "chessStationBlank",
    scale: chessStationPieceScale
  )
}

// One cell a station, keyed by its id.
template chessStationCells(name, stations, value, kind = "Int") {
  row {
    name: name
    kind: kind
    capacity: length(stations)
    cells: map(stations, station => { key: station.id, value: value })
  }
}

// The stations' chess state, keyed by station id: the cursor's square, the lifted piece's square (-1 for none), the last
// pointed pick cell, whether the board was last drawn shown, and the status line's last code; and keyed `<id>-<cell>`
// each square's cell, its station's ordinal, and its ring's code and ink.
template chessStationState(stations, look = gameStationLook) {
  chessStationCells(name: "chessStationCursor", stations: stations, value: 11)
  chessStationCells(name: "chessStationPicked", stations: stations, value: -1)
  chessStationCells(name: "chessStationPointer", stations: stations, value: -1)
  chessStationCells(name: "chessStationShown", stations: stations, value: 1)
  chessStationCells(name: "chessStationStatus", stations: stations, value: -1)
  row {
    name: "chessStationCellNo"
    kind: Int
    capacity: (64 * length(stations))
    cells: flatMap(stations, station => map(range(0, 64), cell => { key: $"{station.id}-{cell}", value: cell }))
  }
  row {
    name: "chessStationOf"
    kind: Int
    capacity: (64 * length(stations))
    cells: flatMap(range(0, length(stations)), s => map(range(0, 64), cell => { key: $"{stations[s].id}-{cell}", value: s }))
  }
  row {
    name: "chessStationRingCode"
    kind: Int
    capacity: (64 * length(stations))
    cells: flatMap(stations, station => map(range(0, 64), cell => { key: $"{station.id}-{cell}", value: chessStationRings.rest }))
  }
  row {
    name: "chessStationRingInk"
    kind: Text
    capacity: (64 * length(stations))
    cells: flatMap(stations, station => map(range(0, 64), cell => { key: $"{station.id}-{cell}", value: look.off }))
  }
  row {
    name: "chessStationBoardInk"
    kind: Text
    capacity: (2 * length(stations))
    cells: flatMap(stations, station => [{ key: $"{station.id}-light", value: look.light }, { key: $"{station.id}-dark", value: look.dark }])
  }
  row {
    name: "chessStationInks"
    kind: Text
    cells [
      { key: "light", value: look.light }
      { key: "dark", value: look.dark }
      { key: "2", value: look.last }
      { key: "3", value: look.picked }
      { key: "4", value: look.cursor }
      { key: "5", value: look.off }
    ]
  }
  row {
    name: "chessStationLines"
    kind: Text
    capacity: length(chessStationLineTexts)
    cells: map(range(0, length(chessStationLineTexts)), code => { key: $"{code}", value: chessStationLineTexts[code] })
  }
}

// The seat's play at a station showing chess (its catalog index `game`; `ordinal` its place in the stations the state
// was declared for).
template chessStationRules(station, game, ordinal) {
  let key = station.id

  // The pointer puts the cursor on the square under it whenever it moves onto another pick cell over the board.
  rule $"chess-station-{key}-point" {
    local pointed = gameStationPointer[key]
    local column = gameStationColumn(pointed) - chessStationColumn0
    local row = gameStationRow(pointed) - chessStationRow0
    local onBoard = (pointed >= 0) and (column >= 0) and (column < 40) and (row >= 0) and (row < 40)
    when gameStationGame[key] == game and pointed != chessStationPointer[key]
    mode: Level
    if onBoard {
      chessStationCursor[key] = 8 * ((row - row % chessStationCells) / chessStationCells) + (column - column % chessStationCells) / chessStationCells
    }
    chessStationPointer[key] = pointed
  }

  // A step moves the cursor a square in the seat's own frame (the standard tabletop context's step): ahead toward Black,
  // right toward the h-file.
  rule $"chess-station-{key}-step" {
    local edges = gameStationEdges[key]
    local ahead = ((edges & gameStationBits.ahead) != 0) - ((edges & gameStationBits.behind) != 0)
    local right = ((edges & gameStationBits.right) != 0) - ((edges & gameStationBits.left) != 0)
    when gameStationGame[key] == game and (ahead or right)
    mode: Level
    chessStationCursor[key] = seatStepCell($"{key}Cells", chessStationCursor[key], 8, 8, ahead, right)
  }

  // A pick lifts a piece of the side to move, lifts another of that side in its place, puts the lifted piece back on its
  // own square, or asks for the move from the lifted piece's square to the cursor's.
  rule $"chess-station-{key}-pick" {
    local cursor = chessStationCursor[key]
    local picked = chessStationPicked[key]
    local own = (board[cursor] * (1 - 2 * turn)) > 0
    local ours = (aiSide != turn) and (chessPut.request == 0)
    when gameStationGame[key] == game and (gameStationEdges[key] & gameStationBits.pick) != 0
    mode: Level
    if picked < 0 {
      if own and ours {
        chessStationPicked[key] = cursor
      }
    } else if cursor == picked {
      chessStationPicked[key] = -1
    } else if own {
      chessStationPicked[key] = cursor
    } else {
      chessPut.from = picked
      chessPut.to = cursor
      chessPut.request = 1
    }
  }

  // The lifted piece is put down by the cancel button, by standing up or by another game taking the glass, and once its
  // square no longer holds a piece of the side to move, as when the move it was lifted for is played.
  rule $"chess-station-{key}-cancel" {
    local picked = chessStationPicked[key]
    when picked >= 0 and ((gameStationEdges[key] & gameStationBits.cancel) != 0 or
        board(engaged, $"{key}Cells", 1) == 0 or
        gameStationGame[key] != game or
        (board[picked] * (1 - 2 * turn)) <= 0)
    mode: Level
    chessStationPicked[key] = -1
  }

  // The chess game's idle demonstration, where its board is a physical table, waits while a seat plays it here.
  rule $"chess-station-{key}-seated" {
    local seated = (gameStationGame[key] == game) and (board(engaged, $"{key}Cells", 1) == 1)
    when chessSeated != seated
    mode: Level
    chessSeated = seated
  }

  // The board's fills show while chess is shown and take the bare glass's colour otherwise: two writes when it changes.
  rule $"chess-station-{key}-board" {
    local shown = gameStationGame[key] == game
    when chessStationShown[key] != shown
    mode: Level
    if shown {
      setState(state: chessStationBoardInk, key: $"{key}-light", fromState: chessStationInks, fromKey: light)
      setState(state: chessStationBoardInk, key: $"{key}-dark", fromState: chessStationInks, fromKey: dark)
    } else {
      setState(state: chessStationBoardInk, key: $"{key}-light", fromState: chessStationInks, fromKey: 5)
      setState(state: chessStationBoardInk, key: $"{key}-dark", fromState: chessStationInks, fromKey: 5)
    }
    chessStationShown[key] = shown
  }

  // The rings: each square's shows, in order of precedence, the lifted piece, the cursor while the seat sits here, the
  // last legal move's two squares, and otherwise the bare glass, as does every ring while chess is not shown. A ring is
  // written only when what it shows changes, at most two a tick, so a cursor's step relights its two squares at once.
  rule $"chess-station-{key}-rings" {
    local cell = chessStationCellNo[$each]
    local shown = gameStationGame[key] == game
    local seated = shown and (board(engaged, $"{key}Cells", 1) == 1)
    local want = (
      (shown == 0) ? chessStationRings.rest :
      (chessStationPicked[key] == cell) ? chessStationRings.picked :
      (seated and (chessStationCursor[key] == cell)) ? chessStationRings.cursor :
      ((verdict == 1) and ((move.from == cell) or (move.to == cell))) ? chessStationRings.last :
      chessStationRings.rest
    )
    when chessStationOf[$each] == ordinal and chessStationRingCode[$each] != want
    mode: Level
    forEach: chessStationRingCode
    maxFirings: 2
    chessStationRingCode[$each] = want
    setState(state: chessStationRingInk, key: $each, fromState: chessStationInks, fromKey: chessStationRingCode[$each])
  }

  // The status line while chess is shown: whose move it is, a check, the computer at work or a draw.
  rule $"chess-station-{key}-status" {
    local code = (
      (gameStationGame[key] != game) ? -1 :
      ((halfmoveClock >= 150) or (repetitionCount >= 5)) ? 5 :
      (aiSide == turn) ? 4 :
      (inCheck[turn] == 1) ? (2 + turn) :
      turn
    )
    when chessStationStatus[key] != code
    mode: Level
    chessStationStatus[key] = code
    if code >= 0 {
      setState(state: gameStationStatus, key: $"{key}", fromState: chessStationLines, fromKey: $"$cell:chessStationStatus:{key}")
    }
  }
}
