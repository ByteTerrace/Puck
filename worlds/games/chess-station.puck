// Chess on a game station (../standard/game-station.puck) as a holodeck: the board is drawn on the glass, and while the
// station shows chess its pieces stand on the squares as real bodies of the standard's chess set
// (../standard/chess-pieces.puck), materialized from the station's own chess game (chess.puck) by the station's
// holodeck pool (../standard/holodeck.puck) and released when the station shows another game. A player lifts a piece,
// sets it down on another square, or knocks pieces over; the game is judged from where they settle, by chess.puck's
// physical judge, never by a second implementation. A module library: what the world holds per station (each station's
// board placement and piece bodies, its board's paints) and the one set of rules every station plays, which sweep the
// stations (`$member` a station's place in the world's list) as chess.puck's do:
//
//   import "chess-station"
//   chessStationSet(stations: ss)                  // at the world's top level: the looks and the pieces' kit
//   prototypes { gameStationPrototype(station: s, index: i, catalog: c, boardPanels: chessStationPanels(s, i))  chessStationPrototypes() }
//   placements { chessStationBoard(station: s, index: i) }   // each station's
//   state {
//     chessStationGrids(count: length(ss))
//     world { chessGameState(keys: map(ss, chessStationKeys), settleTicks: 9, placed: true)  chessStationState(stations: ss)  chessStationDisplayState(stations: ss) }
//   }
//   chessJudge(settleTicks: 9)  …  chessStationPlay(game: 0, settleTicks: 9)
//   chessPutDown(settleTicks: 9)  chessPutJudged(settleTicks: 9, restoresCells: true)  chessFreshGame()
//   chessStationHolodeck(game: 0)  chessPutSettled()  chessStationGlass(game: 0)
//
// The game's cells are the truth and the bodies follow them, so the order of the rules matters: the judge reads the
// settled bodies into the cells, the play and the doors write the cells, and the holodeck runs after every writer of a
// cell, standing each body where its cell says. ../../debug/game-stations.puck is the worked order.
//
// The board is 15 cm squares centred on the board area, its columns running the station's +X and its rows its +Z from
// the near chair (its board placement takes the station's yaw, so the board turns with the table), so
// a square's cell is the chess board's own (8 * row + column): rank 1 nearest the near chair and the a-file (column 7)
// at its left, White's side. The near chair plays White and the far chair Black; the computer plays whichever side no
// one sits for (Black when no one sits at all, and neither while both chairs are taken). Anyone else watches. A square
// is two paints: its fill, light or dark, whose colour is the station's board ink (the bare glass while another game is
// shown, so the board comes and goes in two writes), and over it a ring whose colour is the square's own: the bare glass
// at rest, so it draws the board's grid, and lit for a chair's cursor, a lifted piece and the last move.
//
// A chair points at a square or steps its cursor; on its side's turn, with the board at rest, a pick on its own piece
// lifts that piece's body, which then hovers over the chair's cursor; a pick on another square sets it down there, a
// move the game's own apply path relocates (a capture's piece is released, a castling rook stands on its square, a pawn
// on the last rank is queened and its body comes back as a queen) and the settled board's judge decides. A pick on the
// square it left, the cancel button or standing up puts it back. An arrangement judged illegal, a set-down or a knock
// alike, is put back as the last legal one stood: the cells are restored and every body stands on its square again.
// NEW GAME starts the game afresh (chess.puck's `chessFreshGame`).
import "../standard/game-station"
import "../standard/chess-pieces"
import "../standard/holodeck"
import "../standard/kits"
import "chess"

let chessStationSquare = 0.15
// The pieces' look scale (the standard's set stands on a 10 cm square) and the board's near right corner.
let chessStationPieceScale = 1.5
let chessStationX0 = (gameStationBoardMid[0] - (4 * chessStationSquare))
let chessStationZ0 = (gameStationBoardMid[1] - (4 * chessStationSquare))
// A square's centre in the station's frame, [x, z], and whether it is light (row + column even: column 0 of rank 1 is
// h1, so a1 is dark at the near chair's left).
function chessStationSquareAt(cell) = [
  (chessStationX0 + (chessStationSquare * ((cell % 8) + 0.5))),
  (chessStationZ0 + (chessStationSquare * (floor(cell / 8) + 0.5)))
]
let chessStationParity = map(range(0, 64), cell => ((floor(cell / 8) + (cell % 8)) % 2))
// How high over the glass a body is set down, hovers while lifted, and spawns before it is first posed.
let chessStationDrop = 0.03
let chessStationHover = 0.25
let chessStationSpawn = 0.3
// The rings' codes, which name their inks in `chessStationInks`.
let chessStationRings = { last: 2, picked: 3, cursor: 4, rest: 5, rival: 6 }
let chessStationLineTexts = [
  "WHITE TO MOVE", "BLACK TO MOVE", "WHITE IS IN CHECK", "BLACK IS IN CHECK", "THE COMPUTER IS MOVING", "DRAWN"
]
// The chairs and the side each plays: the near chair White (turn 0), the far chair Black (turn 1).
let chessStationChairs = [{ name: "near", side: 0, turn: 0 }, { name: "far", side: 2, turn: 1 }]

// The pieces' two sides: ivory with amber trim, charcoal with teal trim, each glowing faintly as the glass's content does.
let chessStationPieces = [
  {
    name: "white"
    body { color: "#EFE6D2", roughness: 0.35, specular: 0.3, emissive: 120 }
    trim { color: "#FFC46A", roughness: 0.3, specular: 0.2, emissive: 400 }
  }
  {
    name: "black"
    body { color: "#1C2026", roughness: 0.25, specular: 0.4, coat: 0.5 }
    trim { color: "#8FD8DE", roughness: 0.3, specular: 0.2, emissive: 400 }
  }
]
// The creation a piece code wears: White's codes positive, Black's negative, 0 none.
function chessStationPrototypeOf(code) = ((code == 0) ? "chessStationBlank" :
  $"chessStation-{chessStationPieces[(code > 0) ? 0 : 1].name}-{chessPieceKinds[absolute(code) - 1]}")
let chessStationKinds = flatMap(
  range(0, 2),
  s => map(range(0, 6), k => chessStationPrototypeOf((1 - (2 * s)) * (k + 1)))
)
// The slots a pawn starts in: the only pieces whose code, and so whose look, changes while their body stands.
let chessStationPawnSlots = filter(range(0, 32), i => absolute(initialPieceCodes[i]) == 1)

// The holodeck rows of the stations' pieces, apart from the patience cards' (patience-station.puck): each piece body's
// cells keyed by its placement, and each station's pool keyed by its place in the list.
let chessHoloRows = { live: "chessLive", at: "chessAt", shown: "chessShown", since: "chessSince" }

// A station's piece keys, in piece order: the names of its piece placements, which key its cells in chess.puck's rows.
function chessStationKeys(station) = map(range(0, 32), i => $"{station.id}-piece{i}")

// The holodeck's bodies for one station: piece `n` is `<station>-piece<n>`, spawning over its starting square in the
// board's frame. A pawn wears a look of its own named for its body, which its rules change when it is queened; every
// other piece wears its kind's look.
function chessStationBodies(station) = map(range(0, 32), i => {
  id: $"{station.id}-piece{i}"
  prototype: chessStationPrototypeOf(initialPieceCodes[i])
  look: ((absolute(initialPieceCodes[i]) == 1) ? $"{station.id}-piece{i}" : chessStationPrototypeOf(initialPieceCodes[i]))
  at [
    chessStationSquareAt(initialPieceCells[i])[0],
    (gameStationSurface + chessStationSpawn)
    chessStationSquareAt(initialPieceCells[i])[1]
  ]
})

// What every station of a world shares, at the world's top level: the pieces' looks (each kind's, and each station's
// pawns', which `holodeckLook` names) and the kit every piece body moves under. A piece is a rigid body whose box stands
// on its foot, as wide as the foot's step and as tall as a pawn, so it rests, slides and topples as a turned piece does.
template chessStationSet(stations) {
  looks: concat(
    map(chessStationKinds, name => {
      motion { cues [], gaitAmplitude: 0, replayFrames: false, secondsPerFrame: 0 }
      name: name
      scale: chessStationPieceScale
      source: creation(prototypeId: name)
    }),
    holodeckLooks(looks: chessStationPawnLooks(stations), scale: chessStationPieceScale)
  )

  pieceKit(
    name: "chessStationPiece",
    collider: box(halfExtents: [0.04, 0.052, 0.04], rotation: [0, 0, 0, 1]),
    mass: 0.12,
    friction: 0.5,
    restitution: 0.1,
    rollingResistance: 0.0015
  )
}
function chessStationPawnLooks(stations) = flatMap(stations, station => map(chessStationPawnSlots, i => {
  name: $"{station.id}-piece{i}"
  prototype: chessStationPrototypeOf(initialPieceCodes[i])
}))

// A square's two paints on station `index`'s glass: its fill in the station's board ink and its ring in its own.
function chessStationSquarePaints(station, index, cell) = [
  displayFill(
    gameStationWorld(station, chessStationSquareAt(cell)[0], chessStationSquareAt(cell)[1]),
    [0.073, 0.073],
    ((chessStationParity[cell] == 0) ? $"state.chessStationBoardInkOf{index}.light" :
      $"state.chessStationBoardInkOf{index}.dark"),
    0.004,
    gameStationReading(station)
  )
  displayRing(
    gameStationWorld(station, chessStationSquareAt(cell)[0], chessStationSquareAt(cell)[1]),
    [0.066, 0.066],
    $"state.chessStationRingInkOf{index}.{cell}",
    0.009,
    0.25,
    gameStationReading(station)
  )
]

// The board area's panels for a station's prototype: two ranks a panel, from the board area's near edge to its far
// edge, so each carries 32 paints.
function chessStationPanels(station, index) = map([0, 2, 4, 6], first => {
  z0: ((first == 0) ? gameStationBoard.z0 : (chessStationZ0 + (chessStationSquare * first)))
  z1: ((first == 6) ? gameStationBoard.z1 : (chessStationZ0 + (chessStationSquare * (first + 2))))
  paints: flatMap(range((8 * first), (8 * (first + 2))), cell => chessStationSquarePaints(station, index, cell))
})

template chessStationPrototypes() {
  chessPiecePrototypes(prefix: "chessStation", sides: chessStationPieces)
  gameStationTokenBlank(id: "chessStationBlank")
}

// What the world holds for the stations' boards: each station's square rings' inks (a member a station keyed by cell)
// and its two square inks, the inks and status lines every station's rules copy from, the creation each piece code
// wears (keyed by the code), and the pawns' looks.
template chessStationDisplayState(stations, look = gameStationLook) {
  let count = length(stations)

  table chessStationRingInkOf[count] capacity(64) = map(range(0, 64), cell => look.off)
  table chessStationBoardInkOf[count] capacity(2) {
    light = look.light
    dark = look.dark
  }
  row {
    name: "chessStationInks"
    kind: Text
    cells [
      { key: "light", value: look.light }
      { key: "dark", value: look.dark }
      { key: "2", value: look.last }
      { key: "3", value: look.picked }
      { key: "4", value: look.cursor }
      { key: "5", value: look.off }
      { key: "6", value: look.rival }
    ]
  }
  row {
    name: "chessStationLines"
    kind: Text
    capacity: length(chessStationLineTexts)
    cells: map(range(0, length(chessStationLineTexts)), code => { key: $"{code}", value: chessStationLineTexts[code] })
  }
  row {
    name: "chessStationCodeLooks"
    kind: Text
    capacity: 13
    cells: map(range(-6, 7), code => { key: $"{code}", value: chessStationPrototypeOf(code) })
  }
  holodeckLookState(looks: chessStationPawnLooks(stations))
}

// Station `index`'s board: a placement at the station that anchors its chess board's grid (chess.puck's
// `chessBoard<index>`, which a settled piece's square is read against and a pose stands a body on), and the holodeck's
// 32 piece bodies, its pool keyed by the station's place.
template chessStationBoard(station, index) {
  placement $"{station.id}-chess-board" {
    prototype: "chessStationBlank"
    board {
      occupancy: $"chessBoard{index}"
      topology: $"chessBoard{index}"
    }
    position: station.at
    yawDegrees: gameStationYaw(station)
  }
  holodeckPool(
    bodies: chessStationBodies(station),
    kit: "chessStationPiece",
    pool: $"{index}",
    parent: $"{station.id}-chess-board",
    rows: chessHoloRows
  )
}

// Every station's board grid, inside the world's `state` block: 15 cm squares on the glass, in the frame of the board
// placement that anchors it, so a pose and a settled read both land in it with no `frame:` of their own. A piece counts
// as standing on a square while its foot is within 12 cm over the glass.
template chessStationGrids(count) {
  chessBoardGrids(
    count: count,
    cellSize: chessStationSquare,
    origin: [chessStationX0, gameStationSurface, chessStationZ0],
    band: 0.12
  )
}

// The stations' chess state, inside the world's `state.world` block, a member a station of each family: each chair's
// cursor, lifted square (-1 for none) and last pointed pick cell, whether the board was last drawn shown and the status
// line's last code; each square's ring code, keyed by cell (`chessStationCellNo` reads a key's cell); the code each piece's
// body was last materialized wearing; the turn and start the last legal arrangement was saved at and a fresh game's
// request to stand every body again; a station that plays itself its opening, the turn it last counted and the tick its
// game stalls at (`autoplay`: each station's `{ start, stall, opening }`, or null when none plays itself); the turns
// played (`chessStationPlies`, counted across fresh games) and games set up afresh (`chessStationGames`); and the pieces'
// holodeck rows.
template chessStationState(stations, autoplay = null) {
  let count = length(stations)

  table chessStationCursorOf[count] capacity(2) {
    near = 11
    far = 51
  }
  table chessStationPickedOf[count] capacity(2) {
    near = -1
    far = -1
  }
  table chessStationPointerOf[count] capacity(2) {
    near = -1
    far = -1
  }
  table chessStationShowOf[count] capacity(2) {
    shown = 1
    status = -1
  }
  table chessStationCellNo capacity(64) = range(0, 64)
  table chessStationRingCodeOf[count] capacity(64) = map(range(0, 64), cell => chessStationRings.rest)
  table chessStationLookCodeOf[count] as s capacity(32) {
    for i in range(0, 32) {
      [chessStationKeys(stations[s])[i]] = initialPieceCodes[i]
    }
  }
  table chessStationSavedOf[count] capacity(4) {
    turn = -1
    started = -1
    fresh = 0
    stood = 0
  }
  table chessStationSelfOf[count] capacity(3) {
    opened = 0
    turn = 0
    due = 0
  }
  if autoplay != null {
    table chessStationAutoOf[count] as s capacity(4) {
      start = autoplay[s].start
      stall = autoplay[s].stall
      from = autoplay[s].opening[0]
      to = autoplay[s].opening[1]
    }
  }
  holodeckState(
    bodies: flatMap(stations, station => chessStationBodies(station)),
    pools: map(range(0, count), s => $"{s}"),
    rows: chessHoloRows
  )
  slot chessStationPlies[count] = 0
  slot chessStationGames[count] = 0
}

// The chairs' play and the game's upkeep, one set for every station after the judge and the doors and ahead of
// chess.puck's put-down templates. Every rule here is live only (`search(ply) == 0`): the computer's search judges the
// game's own rules, never these. While another game is shown the chess game holds: the computer searches nothing, the
// doors take nothing and the judge reads no body.
//
// With `autoplay`, the computer plays both sides from each station's own start (chessStationState's `autoplay`): it opens
// with White's move through the move door the console's `station.chess` uses, once the board has first rested and the
// station's start has passed, then hands each side to the computer as its turn comes. A game that passes no turn for the
// station's stall (a draw limit, a mate) is set up afresh.
template chessStationPlay(game, settleTicks, autoplay = false) {
  let pick = gameStationBits.pick

  rule "chess-station-hold" {
    local held = gameStationGame[$member] != game
    when search(ply) == 0 and chessHold[$member] != held
    mode: Level
    forEach: gameStationOf
    chessHold[$member] = held
  }

  if autoplay {
    // The turns played, counted across fresh games, each putting off the tick the game is called stalled at.
    rule "chess-station-plies" {
      when search(ply) == 0 and chessTurn[$member] != chessStationSelfOf[$member].turn
      mode: Level
      forEach: gameStationOf
      chessStationSelfOf[$member].turn = chessTurn[$member]
      chessStationPlies[$member] += 1
      chessStationSelfOf[$member].due = $tick + chessStationAutoOf[$member].stall
    }

    rule "chess-station-self-open" {
      when (search(ply) == 0 and
        chessStationSelfOf[$member].opened == 0 and
        chessHold[$member] == 0 and
        chessGameStarted[$member] == 1 and
        chessSettleHold[$member] == settleTicks and
        $tick >= chessStationAutoOf[$member].start)
      mode: Level
      forEach: gameStationOf
      chessInputOf[$member].from = chessStationAutoOf[$member].from
      chessInputOf[$member].to = chessStationAutoOf[$member].to
      chessInputOf[$member].request = 1
      chessStationSelfOf[$member].opened = 1
      chessStationSelfOf[$member].due = $tick + chessStationAutoOf[$member].stall
    }

    rule "chess-station-self-side" {
      when search(ply) == 0 and chessStationSelfOf[$member].opened == 1 and chessAiSide[$member] != chessTurn[$member]
      mode: Level
      forEach: gameStationOf
      chessAiSide[$member] = chessTurn[$member]
    }

    rule "chess-station-self-stalled" {
      when search(ply) == 0 and chessStationSelfOf[$member].opened == 1 and $tick >= chessStationSelfOf[$member].due
      mode: Level
      forEach: gameStationOf
      chessFreshOf[$member].request = 1
      chessStationSavedOf[$member].fresh = 1
      chessStationGames[$member] += 1
      chessStationSelfOf[$member].opened = 0
      chessStationSelfOf[$member].turn = 0
      chessAiSide[$member] = 1
    }
  } else {
    // The computer plays the side whose chair stands empty: Black with both empty, neither with both taken.
    rule "chess-station-sides" {
      local white = gameStationChairOf[$member].near != 0
      local black = gameStationChairOf[$member].far != 0
      local side = white ? (black ? -1 : 1) : (black ? 0 : 1)
      when search(ply) == 0 and chessAiSide[$member] != side
      mode: Level
      forEach: gameStationOf
      chessAiSide[$member] = side
    }

    // The turns played, counted across fresh games.
    rule "chess-station-plies" {
      when search(ply) == 0 and chessTurn[$member] != chessStationSelfOf[$member].turn
      mode: Level
      forEach: gameStationOf
      chessStationSelfOf[$member].turn = chessTurn[$member]
      chessStationPlies[$member] += 1
    }
  }

  // NEW GAME sets every piece back and starts the game afresh.
  rule "chess-station-new" {
    when search(ply) == 0 and gameStationGame[$member] == game and (gameStationEdgesOf[$member].near & gameStationBits.action) != 0
    mode: Level
    forEach: gameStationOf
    chessFreshOf[$member].request = 1
    chessStationSavedOf[$member].fresh = 1
    chessStationPickedOf[$member].near = -1
    chessStationPickedOf[$member].far = -1
  }

  // The last legal arrangement, saved whole each time the turn passes and when a game starts: what an arrangement judged
  // illegal is put back to (chess.puck's put-down revert reads `chessPutBeforeOf`, which a set-down also saves).
  rule "chess-station-save" {
    when search(ply) == 0 and (chessTurn[$member] != chessStationSavedOf[$member].turn or chessGameStarted[$member] != chessStationSavedOf[$member].started)
    mode: Level
    forEach: gameStationOf
    transform copyRow(row: chessPutBeforeOf[$member], from: chessPieceCellOf[$member])
    transform copyRow(row: chessPutBeforeCodeOf[$member], from: chessPieceCodeOf[$member])
    chessStationSavedOf[$member].turn = chessTurn[$member]
    chessStationSavedOf[$member].started = chessGameStarted[$member]
  }

  // A settled board that changed and was judged illegal with no set-down awaiting its verdict (a piece knocked over or
  // pushed off its square) is put back as the last legal arrangement stood.
  rule "chess-station-restore" {
    when (search(ply) == 0 and
      chessHold[$member] == 0 and
      chessGameStarted[$member] == 1 and
      chessSettleHold[$member] == settleTicks and
      chessVerdict[$member] == 0 and
      chessBoardChanged[$member] and
      chessPutDownOf[$member].judging == 0 and
      chessPutDownOf[$member].revert == 0)
    mode: Level
    forEach: gameStationOf
    chessPutDownOf[$member].revert = 1
  }

  for chair in chessStationChairs {
    // The pointer puts the chair's cursor on the square under it whenever it moves onto another pick cell over the board.
    rule $"chess-station-point-{chair.name}" {
      local pointed = gameStationPointerOf[$member][chair.name]
      local x = gameStationCellX(pointed) - chessStationX0
      local z = gameStationCellZ(pointed) - chessStationZ0
      local onBoard = (
        (pointed >= 0) and (x >= 0) and (x < 8 * chessStationSquare) and (z >= 0) and (z < 8 * chessStationSquare)
      )
      when search(ply) == 0 and gameStationGame[$member] == game and pointed != chessStationPointerOf[$member][chair.name]
      mode: Level
      forEach: gameStationOf
      if onBoard {
        chessStationCursorOf[$member][chair.name] = 8 * toInt(z / chessStationSquare) + toInt(x / chessStationSquare)
      }
      chessStationPointerOf[$member][chair.name] = pointed
    }

    // A step moves the chair's cursor a square in its own frame: ahead away from the chair, right to its right.
    rule $"chess-station-step-{chair.name}" {
      local edges = gameStationEdgesOf[$member][chair.name]
      local ahead = ((edges & gameStationBits.ahead) != 0) - ((edges & gameStationBits.behind) != 0)
      local right = ((edges & gameStationBits.right) != 0) - ((edges & gameStationBits.left) != 0)
      when search(ply) == 0 and gameStationGame[$member] == game and (ahead or right)
      mode: Level
      forEach: gameStationOf
      chessStationCursorOf[$member][chair.name] = seatStepCellOn(chair.side, chessStationCursorOf[$member][chair.name], 8, 8, ahead, right)
    }

    // On its side's turn, a pick lifts a piece of that side off a board at rest, lifts another in its place, puts the
    // lifted piece back on its own square, or sets it down on the cursor's square: the game's apply path relocates the
    // move (chess.puck's `chessAiOf` cells) and the settled board is judged against what the set-down saved
    // (`chessPutDownOf`).
    rule $"chess-station-pick-{chair.name}" {
      local turn = chessTurn[$member]
      local cursor = chessStationCursorOf[$member][chair.name]
      local picked = chessStationPickedOf[$member][chair.name]
      local own = (chessBoard[$member][cursor] * (1 - 2 * turn)) > 0
      local ours = (turn == chair.turn) and (chessAiSide[$member] != turn) and (chessAiOf[$member].pending == 0) and (chessPutDownOf[$member].judging == 0)
      when search(ply) == 0 and gameStationGame[$member] == game and (gameStationEdgesOf[$member][chair.name] & pick) != 0
      mode: Level
      forEach: gameStationOf
      if picked < 0 {
        if own and ours and chessSettleHold[$member] == settleTicks {
          chessStationPickedOf[$member][chair.name] = cursor
        }
      } else if cursor == picked {
        chessStationPickedOf[$member][chair.name] = -1
      } else if own and ours {
        chessStationPickedOf[$member][chair.name] = cursor
      } else if ours {
        chessAiOf[$member].from = picked
        chessAiOf[$member].to = cursor
        chessAiOf[$member].mover = chessBoard[$member][picked]
        chessAiOf[$member].pending = 1
        chessPutDownOf[$member].judging = 1
        chessStationPickedOf[$member][chair.name] = -1
      }
    }

    // The lifted piece is put back by the cancel button, by standing up, by another game taking the glass, and once its
    // square no longer holds a piece of the side to move.
    rule $"chess-station-cancel-{chair.name}" {
      local picked = chessStationPickedOf[$member][chair.name]
      when search(ply) == 0 and picked >= 0 and ((gameStationEdgesOf[$member][chair.name] & gameStationBits.cancel) != 0 or
          gameStationChairOf[$member][chair.name] == 0 or
          gameStationGame[$member] != game or
          (chessBoard[$member][picked] * (1 - 2 * chessTurn[$member])) <= 0)
      mode: Level
      forEach: gameStationOf
      chessStationPickedOf[$member][chair.name] = -1
    }
  }
}

// The holodeck, one set for every station after every writer of a piece's cell (the judge, the doors, the put-down's
// revert and the fresh game) and ahead of chess.puck's `chessPutSettled`. A station's pool stands while it shows chess,
// one write whatever the pieces; within it each piece's body stands while the piece is on the board wearing its code's
// look, and a queened pawn's look is rewritten and its body asked for afresh. A standing body is posed over its square
// whenever its cell is not the square it was last posed at in this showing; a lifted one hovers over its chair's cursor;
// a put-back arrangement and a fresh game stand every body again.
template chessStationHolodeck(game) {
  rule "chess-station-shown" {
    local shown = gameStationGame[$member] == game
    when search(ply) == 0 and chessShown[$member] != shown
    mode: Level
    forEach: gameStationOf
    holodeckShow(pool: $member, shown: shown, shownRow: chessShown, since: chessSince)
  }

  rule "chess-station-holodeck" {
    local want = (chessPieceCellOf[$member][$each] >= 0) and (chessStationLookCodeOf[$member][$each] == chessPieceCodeOf[$member][$each])
    when search(ply) == 0 and chessLive[$each] != want
    forEach: chessPieceCodeOf
    mode: Level
    holodeckSet(live: want, liveRow: chessLive, at: chessAt)
  }

  // A pawn queened on the last rank (or a queen back to a pawn in a fresh game) wears its code's look: its look, named for
  // its body, is rewritten, and the holodeck asks for its body afresh.
  rule "chess-station-look" {
    when search(ply) == 0 and chessStationLookCodeOf[$member][$each] != chessPieceCodeOf[$member][$each]
    mode: Level
    forEach: chessPieceCodeOf
    setState(state: holodeckLook, key: $each, fromState: chessStationCodeLooks, fromKey: chessPieceCodeOf[$member][$each])
    chessStationLookCodeOf[$member][$each] = chessPieceCodeOf[$member][$each]
  }

  // A put-back arrangement and a fresh game stand every body again in one write: the place rule poses a body
  // whenever its last pose (`chessAt`, the mark of its square plus 64 for this parity) is not its square's mark under
  // the parity now.
  rule "chess-station-stand" {
    when search(ply) == 0 and (chessPutDownOf[$member].revert == 1 or chessStationSavedOf[$member].fresh == 1)
    mode: Level
    forEach: gameStationOf
    chessStationSavedOf[$member].stood = 1 - chessStationSavedOf[$member].stood
    chessStationSavedOf[$member].fresh = 0
  }

  for chair in chessStationChairs {
    rule $"chess-station-hover-{chair.name}" {
      when (search(ply) == 0 and
        chessStationPickedOf[$member][chair.name] >= 0 and
        chessPieceCellOf[$member][$each] == chessStationPickedOf[$member][chair.name] and
        holodeckStands($member, chessLive, chessAt, chessShown, chessSince))
      forEach: chessPieceCodeOf
      mode: Level
      // The lifted square holds one piece.
      maxFirings: 1
      poseCell(
        key: `placement:$each`,
        topology: chessBoard[$member],
        expression: chessStationCursorOf[$member][chair.name],
        offset: [0, chessStationHover, 0]
      )
      holodeckTidy(at: chessAt)
    }
  }

  rule "chess-station-place" {
    local square = chessPieceCellOf[$member][$each]
    local posed = holodeckMark($member, square + 64 * chessStationSavedOf[$member].stood, chessSince)
    local lifted = (square == chessStationPickedOf[$member].near) or (square == chessStationPickedOf[$member].far)
    when search(ply) == 0 and square >= 0 and chessAt[$each] != posed and lifted == 0 and holodeckStands(
        $member,
        chessLive,
        chessAt,
        chessShown,
        chessSince
      )
    forEach: chessPieceCodeOf
    mode: Level
    poseCell(
      key: `placement:$each`,
      topology: chessBoard[$member],
      expression: square,
      offset: [0, chessStationDrop, 0]
    )
    chessAt[$each] = posed
  }
}

// The glass, one set for every station after the holodeck: the board's fills, the squares' rings and the status line.
template chessStationGlass(game) {
  // The board's fills show while chess is shown and take the bare glass's colour otherwise: two writes when it changes.
  rule "chess-station-board" {
    local shown = gameStationGame[$member] == game
    when search(ply) == 0 and chessStationShowOf[$member].shown != shown
    mode: Level
    forEach: gameStationOf
    if shown {
      setState(state: chessStationBoardInkOf[$member], key: light, fromState: chessStationInks, fromKey: light)
      setState(state: chessStationBoardInkOf[$member], key: dark, fromState: chessStationInks, fromKey: dark)
    } else {
      setState(state: chessStationBoardInkOf[$member], key: light, fromState: chessStationInks, fromKey: 5)
      setState(state: chessStationBoardInkOf[$member], key: dark, fromState: chessStationInks, fromKey: 5)
    }
    chessStationShowOf[$member].shown = shown
  }

  // The rings: each square's shows, in order of precedence, a lifted piece's square, the near chair's cursor and the far
  // chair's while someone sits there, the last legal move's two squares, and otherwise the bare glass, as does every ring
  // while chess is not shown. A ring is written only when what it shows changes, at most four a tick, so a cursor's step
  // relights its two squares at once.
  rule "chess-station-rings" {
    local cell = chessStationCellNo[$each]
    local shown = gameStationGame[$member] == game
    local want = (
      (shown == 0) ? chessStationRings.rest :
      ((chessStationPickedOf[$member].near == cell) or (chessStationPickedOf[$member].far == cell)) ? chessStationRings.picked :
      ((gameStationChairOf[$member].near != 0) and (chessStationCursorOf[$member].near == cell)) ? chessStationRings.cursor :
      ((gameStationChairOf[$member].far != 0) and (chessStationCursorOf[$member].far == cell)) ? chessStationRings.rival :
      ((chessVerdict[$member] == 1) and ((chessMoveOf[$member].from == cell) or (chessMoveOf[$member].to == cell))) ? chessStationRings.last :
      chessStationRings.rest
    )
    when search(ply) == 0 and chessStationRingCodeOf[$member][$each] != want
    mode: Level
    forEach: chessStationRingCodeOf
    maxFirings: 4
    chessStationRingCodeOf[$member][$each] = want
    setState(state: chessStationRingInkOf[$member], key: $each, fromState: chessStationInks, fromKey: chessStationRingCodeOf[$member][$each])
  }

  // The status line while chess is shown: whose move it is, a check, the computer at work or a draw.
  rule "chess-station-status" {
    local turn = chessTurn[$member]
    local code = (
      (gameStationGame[$member] != game) ? -1 :
      ((chessHalfmoveClock[$member] >= 150) or (chessRepetitionCount[$member] >= 5)) ? 5 :
      (chessAiSide[$member] == turn) ? 4 :
      (chessInCheckOf[$member][turn] == 1) ? (2 + turn) :
      turn
    )
    when search(ply) == 0 and chessStationShowOf[$member].status != code
    mode: Level
    forEach: gameStationOf
    chessStationShowOf[$member].status = code
    if code >= 0 {
      setState(state: gameStationStatus, key: $member, fromState: chessStationLines, fromKey: chessStationShowOf[$member].status)
    }
  }
}
