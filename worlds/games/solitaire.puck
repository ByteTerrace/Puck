// The patience collection: the games a game station's glass plays (patience-station.puck), one at a time. Every game is
// one set of rules over every table (klondike.puck, freecell.puck): a table is a station's place in the world's list,
// `solitaireTable[i]` names the game it plays (1 Klondike, 2 FreeCell; 0 pauses them all) and each game's rules are
// gated on it, so a game kept mid-deal keeps its piles while another is on the table. The station writes it from the
// game its glass shows. A library: the world expands `solitaireState(count)` inside its `state.world` block and
// `solitaireGame()` at its top level once whatever the number of tables, and authors the console's commands over every
// table (`patienceCommands`).
import "klondike"
import "freecell"

// The collection's state for `count` tables: the deck's constants once (a card is keyed 0 to 51 by suit * 13 + rank -
// 1, suits spades, hearts, clubs, diamonds), the game each table plays, and each game's own.
template solitaireState(count) {
  table solitaireCards capacity(52) = range(0, 52)

  row {
    name: "solitaireRank"
    kind: "Int"
    domain: keysOf(row: solitaireCards)
    capacity: 52
    cells: map(range(0, 52), i => { key: $"{i}", value: i % 13 + 1 })
  }

  row {
    name: "solitaireSuit"
    kind: "Int"
    domain: keysOf(row: solitaireCards)
    capacity: 52
    cells: map(range(0, 52), i => { key: $"{i}", value: floor(i / 13) })
  }

  solitaireCells(name: "solitaireTable", count: count, value: 0)
  klondikeState(count: count)
  freecellState(count: count)
}

// The collection's patterns and every game's rules, once in the world: a pile's length from a card to its end (matched
// with `prefix`), and whether its cards from one on run down a rank at a time in alternating colours.
template solitaireGame() {
  pattern solitaireLength: Int {
    value: "1"
    symbols {
      one = 1
    }
    match: any*
  }
  pattern solitaireRun: Int {
    value: "1 + (solitaireRank[$token] == solitaireRank[$previous] - 1) * (solitaireSuit[$token] % 2 != solitaireSuit[$previous] % 2)"
    symbols {
      face = 1..2
      next = 2
    }
    match: face next*
  }

  klondikeGame()
  freecellGame()
}

// One cell a table, keyed 0 to `count - 1`, each starting at `value`.
template solitaireCells(name, count, value) {
  table name capacity(count) = map(range(0, count), i => value)
}

// The console's lines into the tables' games, the same requests a seat makes through each game's mailbox. Every command
// names a table by its number, 0 for the world's first station.
function patienceCommands(stations) = [
  {
    name: "klondike.deal"
    help: "Deals a new game of Klondike on a game station's table: the table's number (0 for the world's first station), then draw one card (1) or three (3) from the stock."
    parameters [
      { name: "table", kind: Choice, values: map(range(0, length(stations)), i => $"{i}") }
      { name: "draw", kind: Choice, values ["1", "3"], default: "1" }
    ]
    lines [
      "world.state.cell.set klondikeOption {table} {draw}"
      "world.state.cell.set klondikeAction {table} 1"
      "world.state.cell.set klondikeRequest {table} 1 add"
    ]
  }
  {
    name: "klondike.draw"
    help: "Draws from a game station's Klondike stock, or turns the waste over once the stock is empty: the table's number."
    parameters [
      { name: "table", kind: Choice, values: map(range(0, length(stations)), i => $"{i}") }
    ]
    lines [
      "world.state.cell.set klondikeAction {table} 3"
      "world.state.cell.set klondikeRequest {table} 1 add"
    ]
  }
  {
    name: "klondike.move"
    help: "Moves the run led by a card (0 to 51, suit * 13 + rank - 1) from one pile to another on a game station's table (its number): piles 1 waste, 2 to 8 tableau, 10 to 13 foundations."
    parameters [
      { name: "table", kind: Choice, values: map(range(0, length(stations)), i => $"{i}") }
      { name: "from", kind: Number }
      { name: "to", kind: Number }
      { name: "card", kind: Number }
    ]
    lines [
      "world.state.cell.set klondikeFrom {table} {from}"
      "world.state.cell.set klondikeTo {table} {to}"
      "world.state.cell.set klondikeCard {table} {card}"
      "world.state.cell.set klondikeAction {table} 2"
      "world.state.cell.set klondikeRequest {table} 1 add"
    ]
  }
  {
    name: "freecell.deal"
    help: "Deals a new game of FreeCell on a game station's table: the table's number, 0 for the world's first station."
    parameters [
      { name: "table", kind: Choice, values: map(range(0, length(stations)), i => $"{i}") }
    ]
    lines [
      "world.state.cell.set freecellAction {table} 1"
      "world.state.cell.set freecellRequest {table} 1 add"
    ]
  }
  {
    name: "freecell.move"
    help: "Moves the run led by a card (0 to 51, suit * 13 + rank - 1) from one pile to another on a game station's table (its number, 0 for the world's first station): piles 0 to 3 free cells, 4 to 7 foundations (suits spades, hearts, clubs, diamonds), 8 to 15 columns."
    parameters [
      { name: "table", kind: Choice, values: map(range(0, length(stations)), i => $"{i}") }
      { name: "from", kind: Number }
      { name: "to", kind: Number }
      { name: "card", kind: Number }
    ]
    lines [
      "world.state.cell.set freecellFrom {table} {from}"
      "world.state.cell.set freecellTo {table} {to}"
      "world.state.cell.set freecellCard {table} {card}"
      "world.state.cell.set freecellAction {table} 2"
      "world.state.cell.set freecellRequest {table} 1 add"
    ]
  }
]
