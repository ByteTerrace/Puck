// The patience collection: the games a game station's glass plays (patience-station.puck), one at a time.
// `solitaire.table` names the game in play (1 Klondike, 2 FreeCell; 0 pauses them all) and each game's rules are gated
// on it, so a game kept mid-deal keeps its piles while another is on the table. The station writes it from the game its
// glass shows. A library: a station's module instance expands `solitaireState()` with `klondikeGame()` and
// `freecellGame()`, so each station holds its own collection, and the world authors the console's commands over every
// station's instance (`patienceCommands`).
import "klondike"
import "freecell"

template solitaireState() {

  table solitaire capacity(1) {
    table = 0
  }
}

// The console's lines into a station's games, the same requests its seat makes through each game's mailbox. A station's
// instance carries its id as its module alias, so `<station>$solitaireKlondike` is that station's Klondike mailbox.
function patienceCommands(stations) = [
  {
    name: "klondike.deal"
    help: "Deals a new game of Klondike on a game station: the station, then draw one card (1) or three (3) from the stock."
    parameters [
      { name: "station", kind: Choice, values: map(stations, station => station.id) }
      { name: "draw", kind: Choice, values ["1", "3"], default: "1" }
    ]
    lines [
      "world.state.cell.set {station}$solitaireKlondike option {draw}"
      "world.state.cell.set {station}$solitaireKlondike action 1"
      "world.state.cell.set {station}$solitaireKlondike request 1 add"
    ]
  }
  {
    name: "klondike.draw"
    help: "Draws from a game station's Klondike stock, or turns the waste over once the stock is empty."
    parameters [
      { name: "station", kind: Choice, values: map(stations, station => station.id) }
    ]
    lines [
      "world.state.cell.set {station}$solitaireKlondike action 3"
      "world.state.cell.set {station}$solitaireKlondike request 1 add"
    ]
  }
  {
    name: "klondike.move"
    help: "Moves the run led by a card (0 to 51, suit * 13 + rank - 1) from one pile to another on a game station: piles 1 waste, 2 to 8 tableau, 10 to 13 foundations."
    parameters [
      { name: "station", kind: Choice, values: map(stations, station => station.id) }
      { name: "from", kind: Number }
      { name: "to", kind: Number }
      { name: "card", kind: Number }
    ]
    lines [
      "world.state.cell.set {station}$solitaireKlondike from {from}"
      "world.state.cell.set {station}$solitaireKlondike to {to}"
      "world.state.cell.set {station}$solitaireKlondike card {card}"
      "world.state.cell.set {station}$solitaireKlondike action 2"
      "world.state.cell.set {station}$solitaireKlondike request 1 add"
    ]
  }
  {
    name: "freecell.deal"
    help: "Deals a new game of FreeCell on a game station."
    parameters [
      { name: "station", kind: Choice, values: map(stations, station => station.id) }
    ]
    lines [
      "world.state.cell.set {station}$solitaireFreecell action 1"
      "world.state.cell.set {station}$solitaireFreecell request 1 add"
    ]
  }
  {
    name: "freecell.move"
    help: "Moves the run led by a card (0 to 51, suit * 13 + rank - 1) from one pile to another on a game station: piles 0 to 3 free cells, 4 to 7 foundations (suits spades, hearts, clubs, diamonds), 8 to 15 columns."
    parameters [
      { name: "station", kind: Choice, values: map(stations, station => station.id) }
      { name: "from", kind: Number }
      { name: "to", kind: Number }
      { name: "card", kind: Number }
    ]
    lines [
      "world.state.cell.set {station}$solitaireFreecell from {from}"
      "world.state.cell.set {station}$solitaireFreecell to {to}"
      "world.state.cell.set {station}$solitaireFreecell card {card}"
      "world.state.cell.set {station}$solitaireFreecell action 2"
      "world.state.cell.set {station}$solitaireFreecell request 1 add"
    ]
  }
]
