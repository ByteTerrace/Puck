// FreeCell patience, as rules over piles of physical cards (solitaire.puck switches between the patience games and
// patience-station.puck lays the cards out on a game station's glass). One set of rules plays every table at once: each
// rule sweeps the tables (`forEach: solitaireTable`, keyed 0, 1, ... by table), every table's state is a cell under its
// key (`freecellRequest[$each]`) and every table's piles are the members of pile families (`freecellPile8Of[$each]`), so a
// change at one table wakes and costs that table's binding alone. The console and the seated player play a table through
// its mailbox: a request names an `action` (1 deal, 2 move a run from pile `from` to pile `to` led by card `card`) and bumps
// `request`; the door answers `applied`, `result` (1 played, -1 refused) and the rest of the cells below, and the cards
// follow.
//
// Piles: 0 to 3 the four free cells, 4 to 7 the foundations (suits 0 spades, 1 hearts, 2 clubs, 3 diamonds) and 8 to 15
// the eight columns. Cards are keyed 0 to 51 by suit * 13 + rank - 1 and every card is face up. A deal gathers every
// card into the deck, shuffles it with the seeded stream and deals a card a tick across the columns. A run of cards
// moves as the free cells and empty columns would let it be moved a card at a time: at most (empty cells + 1) times two
// to the power of the empty columns, not counting a target column that is itself empty.

let fcPowers = [1, 2, 4, 8, 16, 32, 64, 128, 256]

// Every pile a rule chooses by number, and the table of the piles in `keep` alone: a transfer or a match between piles a
// table picks live is priced by the dearest pile the table holds, so each rule names only the piles it can choose.
let fcZones = map(range(0, 16), k => $"freecellPile{k}Of")
function fcZonesOf(keep) = map(range(0, 16), k => contains(keep, k) ? fcZones[k] : "")

// Each table's mailbox and door, one row a field keyed by table, with the value a table starts at.
let fcFields = [
  { name: "Request", value: 0 }
  { name: "Applied", value: 0 }
  { name: "Action", value: 0 }
  { name: "From", value: -1 }
  { name: "To", value: -1 }
  { name: "Card", value: -1 }
  { name: "Stage", value: 0 }
  { name: "Busy", value: 0 }
  { name: "Status", value: 0 }
  { name: "Result", value: 0 }
  { name: "Moves", value: 0 }
  { name: "SourceOk", value: 0 }
  { name: "TargetOk", value: 0 }
  { name: "RunLength", value: 0 }
  { name: "EmptyCells", value: 4 }
  { name: "EmptyColumns", value: 0 }
  { name: "Deals", value: 0 }
  { name: "DealStep", value: 0 }
  { name: "GatherStep", value: 0 }
  { name: "MoveReady", value: 0 }
]

function freecellIdle() = (solitaireTable[$each] == 2 and
  freecellRequest[$each] != freecellApplied[$each] and
  freecellStage[$each] == 0 and
  freecellBusy[$each] == 0)

function freecellAsked(kind) = freecellIdle() and freecellStatus[$each] == 1 and freecellAction[$each] == kind

// FreeCell's state for `count` tables, inside the world's `state.world` block (solitaireState(count) expands it): each
// table's mailbox as one row a field, and each table's deck and sixteen piles as pile families.
template freecellState(count) {
  // The cards a move may carry for each count of empty columns: two to the power of that count.
  table solitaireFreecellPower capacity(9) = fcPowers

  for field in fcFields {
    solitaireCells(name: $"freecell{field.name}", count: count, value: field.value)
  }

  pile freecellDeckOf[count] of solitaireCards capacity(52) = map(range(0, 52), k => $"{k}")

  // A free cell holds one card, a foundation a suit's thirteen, and a column at most nineteen.
  for (zone, k) in fcZones {
    pile $"{zone}"[count] of solitaireCards capacity((k < 4) ? 1 : ((k < 8) ? 13 : 19))
  }

  row {
    name: "solitaireFreecellStream"
    kind: "Int"
    draw {
      generator {
        source: "StreamDraw"
      }
      timing: "Event"
    }
  }
}

// The game's rules, once in the world whatever the number of tables. Whether a column's last card takes the moving card
// reads that card itself (`zone(pile, last)`); the patterns they match are the collection's, solitaireGame's.
template freecellGame() {

  rule "solitaireFreecell-new-deal" {
    forEach: solitaireTable
    when freecellIdle() and freecellAction[$each] == 1
    freecellStage[$each] = 1
    freecellStatus[$each] = 0
    freecellResult[$each] = 0
    freecellBusy[$each] = 1
  }

  // A deal gathers the cards a card a tick, pile by pile from the first cell to the last column: `GatherStep` counts
  // those sixteen piles and moves on when the pile it names is empty.
  rule "solitaireFreecell-gather" {
    forEach: solitaireTable
    zones: fcZones
    when (solitaireTable[$each] == 2 and
      freecellStage[$each] == 1 and
      count($zones[freecellGatherStep[$each]]) > 0)
    draw $zones[freecellGatherStep[$each]] to freecellDeckOf[$each]
  }

  rule "solitaireFreecell-gather-advance" {
    forEach: solitaireTable
    zones: fcZones
    when (solitaireTable[$each] == 2 and
      freecellStage[$each] == 1 and
      freecellGatherStep[$each] < 15 and
      count($zones[freecellGatherStep[$each]]) == 0)
    freecellGatherStep[$each] = freecellGatherStep[$each] + 1
  }

  rule "solitaireFreecell-gather-reset" {
    forEach: solitaireTable
    when solitaireTable[$each] == 2 and freecellStage[$each] == 0 and freecellGatherStep[$each] != 0
    freecellGatherStep[$each] = 0
  }

  rule "solitaireFreecell-shuffle" {
    forEach: solitaireTable
    when (solitaireTable[$each] == 2 and
      freecellStage[$each] == 1 and
      freecellGatherStep[$each] == 15 and
      count(freecellDeckOf[$each]) == 52)
    transaction {
      shuffle freecellDeckOf[$each] with solitaireFreecellStream
      freecellStage[$each] = 3
    }
  }

  // The deal: 52 cards, a card a tick, across the eight columns (card k goes to column k % 8).
  rule "solitaireFreecell-deal" {
    forEach: solitaireTable
    zones: fcZonesOf(range(8, 16))
    when solitaireTable[$each] == 2 and freecellStage[$each] == 3
    draw freecellDeckOf[$each] to $zones[8 + freecellDealStep[$each] % 8]
  }

  rule "solitaireFreecell-deal-finish" {
    forEach: solitaireTable
    when solitaireTable[$each] == 2 and freecellStage[$each] == 3 and freecellDealStep[$each] == 51
    transaction {
      freecellStage[$each] = 0
      freecellStatus[$each] = 1
      freecellMoves[$each] = 0
      freecellDeals[$each] = freecellDeals[$each] + 1
      freecellResult[$each] = 1
      freecellApplied[$each] = freecellRequest[$each]
    }
  }

  // After the deal rules and their finish: a rule sees the cells the rules before it wrote this tick, so the step moves on
  // only once the card it names has been dealt, and stands at 0 between deals.
  rule "solitaireFreecell-deal-advance" {
    forEach: solitaireTable
    when solitaireTable[$each] == 2 and freecellStage[$each] == 3
    freecellDealStep[$each] = freecellDealStep[$each] + 1
  }

  rule "solitaireFreecell-deal-reset" {
    forEach: solitaireTable
    when solitaireTable[$each] == 2 and freecellStage[$each] == 0 and freecellDealStep[$each] != 0
    freecellDealStep[$each] = 0
  }

  // The empty cells and columns, read for the run a move may carry.
  rule "solitaireFreecell-empties" {
    forEach: solitaireTable
    mode: Level
    freecellEmptyCells[$each] = sum(range(0, 4), k => count($"freecellPile{k}Of"[$each]) == 0)
    freecellEmptyColumns[$each] = sum(range(8, 16), k => count($"freecellPile{k}Of"[$each]) == 0)
  }

  rule "solitaireFreecell-prepare-move" {
    forEach: solitaireTable
    when freecellAsked(2)
    freecellSourceOk[$each] = 0
    freecellTargetOk[$each] = 0
    freecellRunLength[$each] = 0
  }

  // A run leaves a column when it is in sequence from its leading card to the column's end; a free cell gives up its one
  // card; a foundation gives up nothing.
  rule "solitaireFreecell-source" {
    forEach: solitaireTable
    when freecellAsked(2) and $zones[freecellFrom[$each]][freecellCard[$each]] == 1
    zones: fcZonesOf(range(8, 16))
    freecellSourceOk[$each] = match(solitaireRun, $zones[freecellFrom[$each]])[freecellCard[$each]]
    freecellRunLength[$each] = match(solitaireLength, $zones[freecellFrom[$each]], prefix)[freecellCard[$each]]
  }

  rule "solitaireFreecell-source-cell" {
    forEach: solitaireTable
    when freecellAsked(2) and $zones[freecellFrom[$each]][freecellCard[$each]] == 1
    zones: fcZonesOf(range(0, 4))
    freecellSourceOk[$each] = 1
    freecellRunLength[$each] = 1
  }

  // A column takes a run on an empty column or on the card one rank above its leading card in the other colour, when the
  // free cells and the other empty columns could carry it a card at a time and the column has room.
  rule "solitaireFreecell-target-column" {
    forEach: solitaireTable
    when freecellAsked(2) and freecellSourceOk[$each] == 1
    zones: fcZonesOf(range(8, 16))
    freecellTargetOk[$each] = (
      (
        freecellRunLength[$each] <=
        (freecellEmptyCells[$each] + 1) *
          solitaireFreecellPower[freecellEmptyColumns[$each] - (count($zones[freecellTo[$each]]) == 0)]
      ) *
      (count($zones[freecellTo[$each]]) + freecellRunLength[$each] <= 19) *
      (count($zones[freecellTo[$each]]) == 0 ? 1 : (
        (solitaireRank[zone($zones[freecellTo[$each]], last)] == solitaireRank[freecellCard[$each]] + 1) *
        (solitaireSuit[zone($zones[freecellTo[$each]], last)] % 2 != solitaireSuit[freecellCard[$each]] % 2)
      ))
    )
  }

  // A free cell takes one card while it is empty.
  rule "solitaireFreecell-target-cell" {
    forEach: solitaireTable
    when freecellAsked(2) and freecellSourceOk[$each] == 1
    zones: fcZonesOf(range(0, 4))
    freecellTargetOk[$each] = (freecellRunLength[$each] == 1) * (count($zones[freecellTo[$each]]) == 0)
  }

  // A foundation takes the next rank of its own suit, one card at a time.
  rule "solitaireFreecell-target-foundation" {
    forEach: solitaireTable
    when freecellAsked(2) and freecellSourceOk[$each] == 1
    zones: fcZonesOf(range(4, 8))
    freecellTargetOk[$each] = (
      (freecellRunLength[$each] == 1) *
      (solitaireSuit[freecellCard[$each]] == freecellTo[$each] - 4) *
      (solitaireRank[freecellCard[$each]] == count($zones[freecellTo[$each]]) + 1)
    )
  }

  // A move is ready when the door is idle on a move request whose run and landing the rules above accepted, between two
  // different piles.
  rule "solitaireFreecell-move-ready" {
    forEach: solitaireTable
    mode: Level
    freecellMoveReady[$each] = (
      freecellAsked(2) and
      freecellSourceOk[$each] == 1 and
      freecellTargetOk[$each] == 1 and
      freecellFrom[$each] != freecellTo[$each]
    )
  }

  // The move: the run from its leading card goes from the source pile to the target pile, whichever two they are.
  rule "solitaireFreecell-move" {
    forEach: solitaireTable
    zones: fcZones
    when freecellMoveReady[$each] == 1 and freecellRequest[$each] != freecellApplied[$each]
    transaction {
      transform transfer(from: $zones[freecellFrom[$each]], to: $zones[freecellTo[$each]], selector: Slice, key: freecellCard[$each])
      freecellMoves[$each] = freecellMoves[$each] + 1
      freecellBusy[$each] = 1
      freecellResult[$each] = 1
      freecellApplied[$each] = freecellRequest[$each]
    }
  }

  rule "solitaireFreecell-reject" {
    forEach: solitaireTable
    when freecellIdle()
    transaction {
      freecellResult[$each] = -1
      freecellApplied[$each] = freecellRequest[$each]
    }
  }

  rule "solitaireFreecell-maintenance-start" {
    forEach: solitaireTable
    when solitaireTable[$each] == 2 and freecellStage[$each] == 0 and freecellBusy[$each] == 1
    freecellBusy[$each] = 0
  }

  rule "solitaireFreecell-win" {
    forEach: solitaireTable
    when solitaireTable[$each] == 2 and freecellStatus[$each] == 1 and freecellBusy[$each] == 0
    freecellStatus[$each] = (sum(range(4, 8), k => count($"freecellPile{k}Of"[$each])) == 52 ? 2 : 1)
  }
}
