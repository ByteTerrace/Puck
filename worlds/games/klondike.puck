// Klondike patience, as rules over piles of physical cards (solitaire.puck switches between the patience games and
// patience-station.puck lays the cards out on a game station's glass). One set of rules plays every table at once, as
// FreeCell's does (freecell.puck): each rule sweeps the tables (`forEach: solitaireTable`, keyed 0, 1, ... by table),
// every table's state is a cell under its key (`klondikeRequest[$each]`) and every table's piles are the members of pile
// families (`klondikePile2Of[$each]`), so a change at one table wakes and costs that table's binding alone. The console
// and the seated player play a table through its mailbox: a request names an `action` (1 deal, 2 move a run from pile
// `from` to pile `to` led by card `card`, 3 draw from the stock or turn the waste over) and bumps `request`; the door
// answers `applied`, `result` (1 played, -1 refused) and the rest of the cells below, and the cards follow.
//
// Piles: 0 stock, 1 waste, 2 to 8 the face-up part of the seven tableau columns, 10 to 13 the foundations (suits 0
// spades, 1 hearts, 2 clubs, 3 diamonds), and 16 to 22 the face-down part of columns 2 to 8 (column z's at z + 14).
// Cards are keyed 0 to 51 by suit * 13 + rank - 1. A card's face follows its pile: the stock and the face-down piles
// hold their cards face down and every other pile face up, so a column turns its next card over by moving it from its
// face-down pile to its face-up one. A deal gathers every card, shuffles the stock with the seeded stream and deals the
// tableau face down. `option` (1 or 3, the draw count) takes effect at the next deal.

// Each table's mailbox and door, one row a field keyed by table, with the value a table starts at.
let kdFields = [
  { name: "Request", value: 0 }
  { name: "Applied", value: 0 }
  { name: "Action", value: 0 }
  { name: "From", value: -1 }
  { name: "To", value: -1 }
  { name: "Card", value: -1 }
  { name: "Option", value: 1 }
  { name: "ActiveOption", value: 1 }
  { name: "Stage", value: 0 }
  { name: "Busy", value: 0 }
  { name: "Status", value: 0 }
  { name: "Result", value: 0 }
  { name: "Moves", value: 0 }
  { name: "Score", value: 0 }
  { name: "Passes", value: 0 }
  { name: "SourceOk", value: 0 }
  { name: "TargetOk", value: 0 }
  { name: "RunLength", value: 0 }
  { name: "Deals", value: 0 }
  { name: "DealStep", value: 0 }
  { name: "GatherStep", value: 0 }
  { name: "DrawLeft", value: 0 }
  { name: "MoveReady", value: 0 }
]

// The tableau columns' piles, the foundations, and the zone a column's face-down pile takes.
let kdColumns = [2, 3, 4, 5, 6, 7, 8]
let kdFoundations = [10, 11, 12, 13]
let kdDown = 14

// The deal: card k of the tableau's 28 goes face down to column kdDealTo[k], a row at a time across the columns that
// still want one (column z takes z - 1).
let kdDealTo = flatMap(range(0, 7), row => range(row + 2, 9))

// Every pile a rule chooses by number, the zone table each rule below reads: "" at a number no pile takes.
let kdZones = concat(
  "klondikeStockOf",
  "klondikeWasteOf",
  map(kdColumns, z => $"klondikePile{z}Of"),
  "",
  map(kdFoundations, z => $"klondikePile{z}Of"),
  "",
  "",
  map(kdColumns, z => $"klondikeDown{z}Of")
)

// The piles a deal gathers from, in the order it empties them, the foundations, and the columns' face-down piles.
let kdGather = [1, 2, 3, 4, 5, 6, 7, 8, 10, 11, 12, 13, 16, 17, 18, 19, 20, 21, 22]
let kdGatherLast = (length(kdGather) - 1)
let kdDowns = map(kdColumns, z => z + kdDown)

// The zone table of the piles in `keep` alone: a transfer or a match between piles a table picks live is priced by the
// dearest pile the table holds, so each rule names only the piles it can choose.
function kdZonesOf(keep) = map(range(0, length(kdZones)), z => contains(keep, z) ? kdZones[z] : "")

function klondikeIdle() = (solitaireTable[$each] == 1 and
  klondikeRequest[$each] != klondikeApplied[$each] and
  klondikeStage[$each] == 0 and
  klondikeBusy[$each] == 0)

function klondikeAsked(kind) = klondikeIdle() and klondikeStatus[$each] == 1 and klondikeAction[$each] == kind

// Klondike's state for `count` tables, inside the world's `state.world` block beside solitaireState(count): each
// table's mailbox as one row a field, and each table's piles as pile families.
template klondikeState(count) {
  table solitaireKlondikeDealTo capacity(28) = kdDealTo

  for field in kdFields {
    solitaireCells(name: $"klondike{field.name}", count: count, value: field.value)
  }

  pile klondikeStockOf[count] of solitaireCards capacity(52) = map(range(0, 52), k => $"{k}")
  pile klondikeWasteOf[count] of solitaireCards capacity(24)
  for z in concat(kdColumns, kdFoundations) {
    pile $"klondikePile{z}Of"[count] of solitaireCards capacity(13)
  }
  // Column z's face-down part holds the z - 1 cards the deal leaves it.
  for z in kdColumns {
    pile $"klondikeDown{z}Of"[count] of solitaireCards capacity(z - 1)
  }

  // Whether each card lies face down (1), a cell a card in each table's member: the stock and the face-down piles hold
  // theirs face down and every other pile face up. The rules that turn a card over write it, as they move the card: a
  // gather and a recycle put it in the stock, a draw and a reveal take it out.
  table klondikeFaceDownOf[count] capacity(52) = map(range(0, 52), k => 1)

  row {
    name: "solitaireKlondikeStream"
    kind: "Int"
    draw {
      generator {
        source: "StreamDraw"
      }
      timing: "Event"
    }
  }
}

// A column turns its next card face up once its face-up part is empty: the last card of its face-down pile moves over.
template klondikeReveal(z) {
  rule $"solitaireKlondike-reveal-{z}" {
    forEach: solitaireTable
    zones: kdZonesOf([z, z + kdDown])
    when (solitaireTable[$each] == 1 and
      klondikeStatus[$each] == 1 and
      klondikeStage[$each] == 0 and
      count($zones[z]) == 0 and
      count($zones[z + kdDown]) > 0)
    transaction {
      klondikeFaceDownOf[$each][zone($zones[z + kdDown], last)] = 0
      transform transfer(from: $zones[z + kdDown], to: $zones[z], selector: Last)
      klondikeBusy[$each] = 1
    }
  }
}

// The game's rules, once in the world whatever the number of tables. The patterns they match (a pile's length from a
// card on, and a run down in alternating colours) are the collection's, solitaireGame's.
template klondikeGame() {

  rule "solitaireKlondike-new-deal" {
    forEach: solitaireTable
    when klondikeIdle() and klondikeAction[$each] == 1 and (klondikeOption[$each] == 1 or klondikeOption[$each] == 3)
    klondikeActiveOption[$each] = klondikeOption[$each]
    klondikeStage[$each] = 1
    klondikeStatus[$each] = 0
    klondikeResult[$each] = 0
    klondikeBusy[$each] = 1
  }

  // A deal gathers the cards a card a tick, pile by pile in kdGather's order: `GatherStep` counts those piles (its zone
  // table lists them in that order) and moves on when the pile it names is empty.
  rule "solitaireKlondike-gather" {
    forEach: solitaireTable
    zones: map(kdGather, z => kdZones[z])
    when (solitaireTable[$each] == 1 and
      klondikeStage[$each] == 1 and
      count($zones[klondikeGatherStep[$each]]) > 0)
    klondikeFaceDownOf[$each][zone($zones[klondikeGatherStep[$each]], first)] = 1
    draw $zones[klondikeGatherStep[$each]] to klondikeStockOf[$each]
  }

  rule "solitaireKlondike-gather-advance" {
    forEach: solitaireTable
    zones: map(kdGather, z => kdZones[z])
    when (solitaireTable[$each] == 1 and
      klondikeStage[$each] == 1 and
      klondikeGatherStep[$each] < kdGatherLast and
      count($zones[klondikeGatherStep[$each]]) == 0)
    klondikeGatherStep[$each] = klondikeGatherStep[$each] + 1
  }

  rule "solitaireKlondike-gather-reset" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 0 and klondikeGatherStep[$each] != 0
    klondikeGatherStep[$each] = 0
  }

  rule "solitaireKlondike-shuffle" {
    forEach: solitaireTable
    when (solitaireTable[$each] == 1 and
      klondikeStage[$each] == 1 and
      klondikeGatherStep[$each] == kdGatherLast and
      count(klondikeStockOf[$each]) == 52)
    transaction {
      shuffle klondikeStockOf[$each] with solitaireKlondikeStream
      klondikeStage[$each] = 3
    }
  }

  // The deal: the tableau's 28 cards, a card a tick, face down.
  rule "solitaireKlondike-deal" {
    forEach: solitaireTable
    zones: kdZonesOf(kdDowns)
    local to = solitaireKlondikeDealTo[klondikeDealStep[$each]] + kdDown
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 3
    draw klondikeStockOf[$each] to $zones[to]
  }

  rule "solitaireKlondike-deal-finish" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 3 and klondikeDealStep[$each] == 27
    transaction {
      klondikeStage[$each] = 0
      klondikeStatus[$each] = 1
      klondikeMoves[$each] = 0
      klondikeScore[$each] = 0
      klondikePasses[$each] = 0
      klondikeDeals[$each] = klondikeDeals[$each] + 1
      klondikeResult[$each] = 1
      klondikeApplied[$each] = klondikeRequest[$each]
    }
  }

  // After the deal rules and their finish: a rule sees the cells the rules before it wrote this tick, so the step moves on
  // only once the card it names has been dealt, and stands at 0 between deals.
  rule "solitaireKlondike-deal-advance" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 3
    klondikeDealStep[$each] = klondikeDealStep[$each] + 1
  }

  rule "solitaireKlondike-deal-reset" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 0 and klondikeDealStep[$each] != 0
    klondikeDealStep[$each] = 0
  }

  rule "solitaireKlondike-prepare-move" {
    forEach: solitaireTable
    when klondikeAsked(2)
    klondikeSourceOk[$each] = 0
    klondikeTargetOk[$each] = 0
    klondikeRunLength[$each] = 0
  }

  // A run leaves a column's face-up part when it is in sequence from its leading card to the column's end; the waste
  // and a foundation give up only their last card.
  rule "solitaireKlondike-source" {
    forEach: solitaireTable
    when klondikeAsked(2) and klondikeFrom[$each] >= 2 and klondikeFrom[$each] <= 8 and $zones[klondikeFrom[$each]][klondikeCard[$each]] == 1
    zones: kdZonesOf(kdColumns)
    klondikeSourceOk[$each] = match(solitaireRun, $zones[klondikeFrom[$each]])[klondikeCard[$each]]
    klondikeRunLength[$each] = match(solitaireLength, $zones[klondikeFrom[$each]], prefix)[klondikeCard[$each]]
  }

  rule "solitaireKlondike-source-last" {
    forEach: solitaireTable
    when (klondikeAsked(2) and
      (klondikeFrom[$each] == 1 or (klondikeFrom[$each] >= 10 and klondikeFrom[$each] <= 13)) and
      count($zones[klondikeFrom[$each]]) > 0)
    zones: kdZonesOf(concat([1], kdFoundations))
    klondikeSourceOk[$each] = match(solitaireLength, $zones[klondikeFrom[$each]], prefix)[klondikeCard[$each]] == 1
    klondikeRunLength[$each] = 1
  }

  // A column takes a run on the card one rank above its leading card in the other colour, or a king's run when empty.
  rule "solitaireKlondike-target" {
    forEach: solitaireTable
    when klondikeAsked(2) and klondikeSourceOk[$each] == 1 and klondikeTo[$each] >= 2 and klondikeTo[$each] <= 8
    zones: kdZonesOf(kdColumns)
    klondikeTargetOk[$each] = (
      count($zones[klondikeTo[$each]]) == 0 ? (solitaireRank[klondikeCard[$each]] == 13) : (
        (solitaireRank[zone($zones[klondikeTo[$each]], last)] == solitaireRank[klondikeCard[$each]] + 1) *
        (solitaireSuit[zone($zones[klondikeTo[$each]], last)] % 2 != solitaireSuit[klondikeCard[$each]] % 2)
      )
    )
  }

  // A foundation takes the next rank of its own suit, one card at a time.
  rule "solitaireKlondike-target-foundation" {
    forEach: solitaireTable
    when klondikeAsked(2) and klondikeSourceOk[$each] == 1 and klondikeTo[$each] >= 10 and klondikeTo[$each] <= 13
    zones: kdZonesOf(kdFoundations)
    klondikeTargetOk[$each] = (
      (klondikeRunLength[$each] == 1) *
      (solitaireSuit[klondikeCard[$each]] == klondikeTo[$each] - 10) *
      (solitaireRank[klondikeCard[$each]] == count($zones[klondikeTo[$each]]) + 1)
    )
  }

  // A move is ready when the door is idle on a move request whose run and landing the rules above accepted, between two
  // different piles.
  rule "solitaireKlondike-move-ready" {
    forEach: solitaireTable
    mode: Level
    klondikeMoveReady[$each] = (
      klondikeAsked(2) and
      klondikeSourceOk[$each] == 1 and
      klondikeTargetOk[$each] == 1 and
      klondikeFrom[$each] != klondikeTo[$each]
    )
  }

  // The move: the run from its leading card goes from the source pile to the target pile, whichever two they are. The
  // score rises 10 for a card to a foundation, falls 15 for one taken from it and rises 5 for one from the waste.
  rule "solitaireKlondike-move" {
    forEach: solitaireTable
    zones: kdZonesOf(concat([1], kdColumns, kdFoundations))
    when klondikeMoveReady[$each] == 1 and klondikeRequest[$each] != klondikeApplied[$each]
    transaction {
      transform transfer(from: $zones[klondikeFrom[$each]], to: $zones[klondikeTo[$each]], selector: Slice, key: klondikeCard[$each])
      klondikeMoves[$each] = klondikeMoves[$each] + 1
      klondikeBusy[$each] = 1
      klondikeScore[$each] = maximum(0, klondikeScore[$each] + (
        klondikeFrom[$each] >= 10 ? -15 : (klondikeTo[$each] >= 10 ? 10 : (klondikeFrom[$each] == 1 ? 5 : 0))
      ))
      klondikeResult[$each] = 1
      klondikeApplied[$each] = klondikeRequest[$each]
    }
  }

  rule "solitaireKlondike-draw-start" {
    forEach: solitaireTable
    when klondikeAsked(3) and count(klondikeStockOf[$each]) > 0
    transaction {
      klondikeStage[$each] = 4
      klondikeDrawLeft[$each] = minimum(klondikeActiveOption[$each], count(klondikeStockOf[$each]))
      klondikeBusy[$each] = 1
    }
  }

  rule "solitaireKlondike-draw-card" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 4 and klondikeDrawLeft[$each] > 0
    transaction {
      klondikeFaceDownOf[$each][zone(klondikeStockOf[$each], first)] = 0
      draw klondikeStockOf[$each] to klondikeWasteOf[$each]
      klondikeDrawLeft[$each] = klondikeDrawLeft[$each] - 1
    }
  }

  rule "solitaireKlondike-draw-finish" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 4 and klondikeDrawLeft[$each] == 0
    transaction {
      klondikeStage[$each] = 0
      klondikeMoves[$each] = klondikeMoves[$each] + 1
      klondikeResult[$each] = 1
      klondikeApplied[$each] = klondikeRequest[$each]
    }
  }

  rule "solitaireKlondike-recycle-start" {
    forEach: solitaireTable
    when klondikeAsked(3) and count(klondikeStockOf[$each]) == 0 and count(klondikeWasteOf[$each]) > 0
    klondikeStage[$each] = 2
    klondikePasses[$each] = klondikePasses[$each] + 1
  }

  // The waste turns over a card a tick, face down.
  rule "solitaireKlondike-recycle-card" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 2 and count(klondikeWasteOf[$each]) > 0
    klondikeFaceDownOf[$each][zone(klondikeWasteOf[$each], first)] = 1
    draw klondikeWasteOf[$each] to klondikeStockOf[$each]
  }

  rule "solitaireKlondike-recycle-finish" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 2 and count(klondikeWasteOf[$each]) == 0
    transaction {
      klondikeStage[$each] = 0
      klondikeMoves[$each] = klondikeMoves[$each] + 1
      klondikeResult[$each] = 1
      klondikeApplied[$each] = klondikeRequest[$each]
    }
  }

  rule "solitaireKlondike-reject" {
    forEach: solitaireTable
    when klondikeIdle()
    transaction {
      klondikeResult[$each] = -1
      klondikeApplied[$each] = klondikeRequest[$each]
    }
  }

  rule "solitaireKlondike-maintenance-start" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStage[$each] == 0 and klondikeBusy[$each] == 1
    klondikeBusy[$each] = 0
  }

  for z in kdColumns {
    klondikeReveal(z: z)
  }

  rule "solitaireKlondike-win" {
    forEach: solitaireTable
    when solitaireTable[$each] == 1 and klondikeStatus[$each] == 1 and klondikeBusy[$each] == 0
    klondikeStatus[$each] = (
      (
        count(klondikePile10Of[$each]) +
        count(klondikePile11Of[$each]) +
        count(klondikePile12Of[$each]) +
        count(klondikePile13Of[$each])
      ) == 52 ?
        2 :
      1
    )
  }
}
