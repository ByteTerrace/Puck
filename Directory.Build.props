<Project>
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AnalysisLevel>latest</AnalysisLevel>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <Deterministic>true</Deterministic>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Nothing packs unless it opts in. A "blessed" project sets <IsPackable>true</IsPackable>
             in its own csproj, which turns on the shared version and NuGet metadata in
             build\Packaging.targets; every other project stays out of `dotnet pack` entirely. The
             '' guard leaves an explicit per-project choice (e.g. Puck.Analyzers) untouched. -->
        <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
        <Nullable>enable</Nullable>
        <OptimizationPreference>Speed</OptimizationPreference>
        <PlatformTarget>x64</PlatformTarget>
        <!-- AOT and trim analysis are the tree default; an incompatible project opts out in its own
             .csproj with a comment naming the blocker. IsAotCompatible enables the AOT and trim
             analyzers without changing the project's publish artifact. Executables that ship as
             Native AOT set PublishAot in their own project deliberately. -->
        <IsAotCompatible>true</IsAotCompatible>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
        <TargetFramework>net10.0</TargetFramework>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Single source of truth for the official C#/WinRT Windows SDK projection pack
             (microsoft.windows.sdk.net.ref). Puck.Platform PackageDownloads this exact pack for its
             own compile, and WindowsCaptureProjection.targets re-declares the pack's two runtime
             assemblies in every Windows-capture executable so they land in that executable's
             .deps.json. Every version literal and pack path derives from these two properties, so a
             pack bump is a one-line edit here. PackageDownload cannot float — it requires an exact
             bracketed version — so this centralization is itself the guard against a silent
             per-file version drift (a missed bump degrades to a runtime FileNotFoundException, not
             a build error). $(WindowsSdkNetRefRoot) lives in Directory.Build.targets because
             $(NuGetPackageRoot) is not yet defined when this file is imported. -->
        <WindowsSdkNetRefVersion>10.0.22621.57</WindowsSdkNetRefVersion>

        <!-- `dotnet run foo.cs` synthesizes a project at "foo.cs.csproj", which is the only signal that
             separates a file-based program from a real one. It matters because a file-based program is a
             single compilation unit by definition: injecting a second Compile item into it displaces the
             top-level-statement entry point and the SDK rejects the build with CA2266. Every item below
             that adds source or an analyzer to "every project" means every real project. -->
        <IsFileBasedProgram
            Condition="$(MSBuildProjectFullPath.EndsWith('.cs.csproj'))"
        >true</IsFileBasedProgram>

        <!-- A file-based program's project is synthesized, so it is the one shape in the tree that cannot
             carry its own <PuckKind>. Classifying it here rather than leaving it undeclared is the whole
             point: these are the projects an analyzer-hosted architecture gate could not have seen at all
             (see the ItemGroups below, which exclude them by this same condition), and two of them hold
             InternalsVisibleTo grants into Puck.World. A terminal kind declares no <PuckLayer>. -->
        <PuckKind Condition="'$(IsFileBasedProgram)' == 'true'">FileApp</PuckKind>

        <!-- A file-based program's synthesized project sits beside the .cs file rather than in its own
             directory, so restoring one with a lock file drops a packages.lock.json into whatever
             directory the script lives in — docs/verification/<name>/, a scratch folder. The
             lock would pin the tree-wide IsAotCompatible analyzer packages, which no script references
             and which every script would pin identically; committing that is litter and NOT committing
             it means `dotnet run <script>.cs` leaves the working tree dirty every time. Real projects
             keep their locks (the property above); file-based programs opt out. -->
        <RestorePackagesWithLockFile
            Condition="'$(IsFileBasedProgram)' == 'true'"
        >false</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsFileBasedProgram)' != 'true' AND ('@(Compile)' == '' OR !$([System.String]::Copy('@(Compile)').Contains('VerifiedCodeAttribute.cs')))">
        <!-- Puck.Maths carries zero ProjectReferences by design (see Puck.Maths.csproj), so the [VerifiedCode]
             marker attribute is linked into every project as source rather than shared via a project reference.
             The Condition guards against double-inclusion if Directory.Build.props is ever imported more than
             once for the same project — without it, a second pass would add the same Compile item twice, which
             MSBuild reports as an error under the repo-wide TreatWarningsAsErrors/CodeAnalysisTreatWarningsAsErrors
             gate. -->
        <Compile Include="$(MSBuildThisFileDirectory)build\VerifiedCodeAttribute.cs" Link="Properties\VerifiedCodeAttribute.cs" />
        <!-- The brand ledger Puck.Analyzers reads at RegisterCompilationStartAction time; see VerifiedCode.json
             itself for the schema and the analyzer's VerifiedCodeManifest.cs for the reader. -->
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)VerifiedCode.json" />
        <!-- The file-length ledger FileLengthAnalyzer reads (LEN001-LEN004); `puck lengths` regenerates it. -->
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)FileLengths.json" />
    </ItemGroup>

    <!-- Every project except the analyzer itself (which would otherwise be a build-order cycle: the analyzer
         cannot reference itself as an analyzer before it has built) carries Puck.Analyzers as a compiler
         extension, never as a regular assembly reference — ReferenceOutputAssembly="false" means it neither
         becomes a compile-time dependency nor ships in any output. -->
    <ItemGroup Condition="('$(MSBuildProjectName)' != 'Puck.Analyzers') AND ('$(IsFileBasedProgram)' != 'true') AND ('@(ProjectReference)' == '' OR !$([System.String]::Copy('@(ProjectReference)').Contains('Puck.Analyzers.csproj')))">
        <ProjectReference
            Include="$(MSBuildThisFileDirectory)src\Puck.Analyzers\Puck.Analyzers.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
        <None
            Condition="Exists('$(MSBuildThisFileDirectory)lib\win-x64\mimalloc-3.3\bin\mimalloc.dll')"
            CopyToOutputDirectory="PreserveNewest"
            Include="$(MSBuildThisFileDirectory)lib\win-x64\mimalloc-3.3\bin\mimalloc.dll"
            Link="mimalloc.dll"
        />
        <None
            Condition="Exists('$(MSBuildThisFileDirectory)lib\win-x64\mimalloc-3.3\bin\mimalloc-redirect.dll')"
            CopyToOutputDirectory="PreserveNewest"
            Include="$(MSBuildThisFileDirectory)lib\win-x64\mimalloc-3.3\bin\mimalloc-redirect.dll"
            Link="mimalloc-redirect.dll"
        />
        <None
            Condition="Exists('$(MSBuildThisFileDirectory)lib\linux-x64\mimalloc-3.3\lib\libmimalloc.so.3.3')"
            CopyToOutputDirectory="PreserveNewest"
            Include="$(MSBuildThisFileDirectory)lib\linux-x64\mimalloc-3.3\lib\libmimalloc.so.3.3"
            Link="libmimalloc.so"
        />
    </ItemGroup>
</Project>
