<Project>
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AnalysisLevel>latest</AnalysisLevel>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <Deterministic>true</Deterministic>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- A new commit recompiles only what reads the commit. The SDK's "+<commit>" informational-version suffix and
             SourceLink's *.sourcelink.json (whose URL names the commit) are compiler inputs of every project, so either
             one recompiles the whole tree on every commit. The suffix is off everywhere; SourceLink stays on for CI and
             official builds (ContinuousIntegrationBuild), which publish symbols, and is off for local builds. The one
             reader of the commit, Puck.World.Schema, embeds it as a resource of its own (WorldSchema.SourceRevision);
             git queries stay on, so SourceRevisionId is still known. -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <EnableSourceLink Condition="'$(ContinuousIntegrationBuild)' != 'true'">false</EnableSourceLink>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Nothing packs unless it opts in. A "blessed" project sets <IsPackable>true</IsPackable>
             in its own csproj, which turns on the shared version and NuGet metadata in
             build/Packaging.targets; every other project stays out of `dotnet pack` entirely. The
             '' guard leaves an explicit per-project choice (e.g. Puck.Analyzers) untouched. -->
        <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
        <Nullable>enable</Nullable>
        <OptimizationPreference>Speed</OptimizationPreference>
        <PlatformTarget>x64</PlatformTarget>
        <!-- AOT and trim analysis are the tree default; an incompatible project opts out in its own
             .csproj with a comment naming the blocker. IsAotCompatible enables the AOT and trim
             analyzers without changing the project's publish artifact. Executables that ship as
             Native AOT set PublishAot in their own project deliberately. -->
        <IsAotCompatible>true</IsAotCompatible>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!-- Every restore is locked, locally as in CI: a restore never rewrites a lock file, so a package or project
             reference change fails the build that made it (NU1004, naming the project) instead of rewriting the lock
             file silently and failing CI's locked restore later. `puck locks` re-records the lock files after such a
             change, and its update option takes newer packages within the floating ranges; both pass
             RestoreLockedMode=false, the one way to restore unlocked. -->
        <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
        <TargetFramework>net10.0</TargetFramework>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Build output is hard-linked rather than copied wherever the copy's source is replaced, never rewritten, when it
             changes. Every project otherwise copies its whole dependency closure into its own bin, so one built tree held
             each package and Puck assembly about seven times over. CopyLocal links each package file to the NuGet global
             cache and each project reference to the referenced project's bin; AdditionalFiles links None and Content
             items with CopyToOutputDirectory (assets, fonts, shader bytecode, world outputs, mimalloc) to the file the item
             names; CopyAdditionalFiles covers added modules and native references. MSBuild's Copy deletes a destination
             before it copies or links, so a rebuild replaces a link instead of writing through it, and a link it cannot
             make (another volume, the link-count limit) falls back to a copy with a message, not a warning.
             The hazard: a hard link is the same file under another name, so anything that writes an output file in place
             (opens it for writing, truncates it, appends to it) changes every linked name at once: the NuGet global cache,
             other projects' outputs, and the repository's own source files. Nothing in the tree does: output-side
             writers replace the file (AtomicFile, or delete then write), and `contributing.md` states the rule. Two copy
             paths stay plain copies because a writer they reach rewrites in place: the compiler truncates and rewrites
             obj/<name>.dll, .pdb and .xml, so linking those into bin (CopyFilesToOutputDirectory) or into a publish
             directory (PublishFiles, which publishes from obj) would let the next compile rewrite every copy, including
             a kept World build or a published release. -->
        <CreateHardLinksForAdditionalFilesIfPossible>true</CreateHardLinksForAdditionalFilesIfPossible>
        <CreateHardLinksForCopyAdditionalFilesIfPossible>true</CreateHardLinksForCopyAdditionalFilesIfPossible>
        <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
        <!-- Single source of truth for the official C#/WinRT Windows SDK projection pack
             (microsoft.windows.sdk.net.ref). Puck.Platform PackageDownloads this exact pack for its
             own compile, and WindowsCaptureProjection.targets re-declares the pack's two runtime
             assemblies in every Windows-capture executable so they land in that executable's
             .deps.json. Every version literal and pack path derives from these two properties, so a
             pack bump is a one-line edit here. PackageDownload cannot float — it requires an exact
             bracketed version — so this centralization is itself the guard against a silent
             per-file version drift (a missed bump degrades to a runtime FileNotFoundException, not
             a build error). $(WindowsSdkNetRefRoot) lives in Directory.Build.targets because
             $(NuGetPackageRoot) is not yet defined when this file is imported. -->
        <WindowsSdkNetRefVersion>10.0.22621.57</WindowsSdkNetRefVersion>

        <!-- The SDK synthesizes "foo.cs.csproj" for a file-based program, while the IDE language server's
             virtual project system synthesizes "foo.csproj" for standalone .cs files that have no physical
             project on disk. Keep its entry point and explicit directives, linking only the BCL helpers
             below; repository analyzers and project verification inputs apply to ordinary projects. -->
        <IsFileBasedProgram
            Condition="$(MSBuildProjectFullPath.EndsWith('.cs.csproj')) OR (!Exists('$(MSBuildProjectFullPath)') AND Exists('$([System.IO.Path]::ChangeExtension($(MSBuildProjectFullPath), &quot;.cs&quot;))'))"
        >true</IsFileBasedProgram>

        <!-- A file-based program's project is synthesized, so it is the one shape in the tree that cannot
             carry its own <PuckKind>. Classifying it here rather than leaving it undeclared is the whole
             point: these are the projects an analyzer-hosted architecture gate could not have seen at all
             (see the ItemGroups below, which exclude them by this same condition).
             A terminal kind declares no <PuckLayer>. -->
        <PuckKind Condition="'$(IsFileBasedProgram)' == 'true'">FileApp</PuckKind>

        <!-- A file-based program's synthesized project sits beside the .cs file rather than in its own
             directory, so restoring one with a lock file drops a packages.lock.json into whatever
             directory the script lives in — docs/verification/<name>/, a scratch folder. The
             lock would pin the tree-wide IsAotCompatible analyzer packages, which no script references
             and which every script would pin identically; committing that is litter and NOT committing
             it means `dotnet run <script>.cs` leaves the working tree dirty every time. Real projects
             keep their locks (the property above); file-based programs opt out. -->
        <RestorePackagesWithLockFile
            Condition="'$(IsFileBasedProgram)' == 'true'"
        >false</RestorePackagesWithLockFile>
    </PropertyGroup>

    <!-- File apps share the runtime repository lookup and run-directory policy by source, so a bootstrap program needs no CLI build. -->
    <ItemGroup Condition="'$(IsFileBasedProgram)' == 'true'">
        <Compile Include="$(MSBuildThisFileDirectory)build/RepositoryPaths.cs" Link="RepositoryPaths.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)build/RunDirectory.cs" Link="RunDirectory.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsFileBasedProgram)' != 'true' AND ('@(Compile)' == '' OR !$([System.String]::Copy('@(Compile)').Contains('VerifiedCodeAttribute.cs')))">
        <!-- Puck.Maths carries zero ProjectReferences by design (see Puck.Maths.csproj), so the [VerifiedCode]
             marker attribute is linked into every project as source rather than shared via a project reference.
             The Condition guards against double-inclusion if Directory.Build.props is ever imported more than
             once for the same project — without it, a second pass would add the same Compile item twice, which
             MSBuild reports as an error under the repo-wide TreatWarningsAsErrors/CodeAnalysisTreatWarningsAsErrors
             gate. -->
        <Compile Include="$(MSBuildThisFileDirectory)build/VerifiedCodeAttribute.cs" Link="Properties/VerifiedCodeAttribute.cs" />
        <!-- The format boundary markers `puck formats` reads from syntax; linked as source for the same reason. -->
        <Compile Include="$(MSBuildThisFileDirectory)build/FormatLeafAttribute.cs" Link="Properties/FormatLeafAttribute.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)build/FormatSeamAttribute.cs" Link="Properties/FormatSeamAttribute.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)build/FormatPartAttribute.cs" Link="Properties/FormatPartAttribute.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)build/DerivationAttribute.cs" Link="Properties/DerivationAttribute.cs" />
        <!-- The way onto the host's GPU, matched by name by GpuTraitAnalyzer (GPU001); linked like the brand. -->
        <Compile Include="$(MSBuildThisFileDirectory)build/OpensGpuDeviceAttribute.cs" Link="Properties/OpensGpuDeviceAttribute.cs" />
        <!-- The brand ledger Puck.Analyzers reads at RegisterCompilationStartAction time; see VerifiedCode.json
             itself for the schema and the analyzer's VerifiedCodeManifest.cs for the reader. -->
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)VerifiedCode.json" />
        <!-- The two ratchet ledgers: FileLengthAnalyzer reads the file-length ledger (LEN001-LEN004) and
             CommentSmellAnalyzer the comment-smell ledger (SMELL001-SMELL004); `puck lengths` and
             `puck comment-smells` regenerate them. -->
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)FileLengths.json" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)CommentSmells.json" />
    </ItemGroup>

    <!-- Every project except the analyzer itself (which would otherwise be a build-order cycle: the analyzer
         cannot reference itself as an analyzer before it has built) carries Puck.Analyzers as a compiler
         extension, never as a regular assembly reference — ReferenceOutputAssembly="false" means it neither
         becomes a compile-time dependency nor ships in any output. The API reference's workspace
         (docs/api/docfx.json sets PuckApiReference) reads declarations only, so it carries no analyzer: it
         reads sources alone and starts before the analyzer is compiled. -->
    <ItemGroup Condition="('$(MSBuildProjectName)' != 'Puck.Analyzers') AND ('$(IsFileBasedProgram)' != 'true') AND ('$(PuckApiReference)' != 'true') AND ('@(ProjectReference)' == '' OR !$([System.String]::Copy('@(ProjectReference)').Contains('Puck.Analyzers.csproj')))">
        <ProjectReference
            Include="$(MSBuildThisFileDirectory)src/Puck.Analyzers/Puck.Analyzers.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
        <!-- win-x64/linux-x64 native binaries: meaningless on browser-wasm (a wasm-hosted allocator, "mimalloc.wasm",
             already rides the Mono runtime pack itself) and otherwise copied into every RID's output regardless of
             which native host will ever load them. -->
        <None
            Condition="Exists('$(MSBuildThisFileDirectory)lib/win-x64/mimalloc-3.3/bin/mimalloc.dll') AND ('$(RuntimeIdentifier)' != 'browser-wasm')"
            CopyToOutputDirectory="PreserveNewest"
            Include="$(MSBuildThisFileDirectory)lib/win-x64/mimalloc-3.3/bin/mimalloc.dll"
            Link="mimalloc.dll"
        />
        <None
            Condition="Exists('$(MSBuildThisFileDirectory)lib/win-x64/mimalloc-3.3/bin/mimalloc-redirect.dll') AND ('$(RuntimeIdentifier)' != 'browser-wasm')"
            CopyToOutputDirectory="PreserveNewest"
            Include="$(MSBuildThisFileDirectory)lib/win-x64/mimalloc-3.3/bin/mimalloc-redirect.dll"
            Link="mimalloc-redirect.dll"
        />
        <None
            Condition="Exists('$(MSBuildThisFileDirectory)lib/linux-x64/mimalloc-3.3/lib/libmimalloc.so.3.3') AND ('$(RuntimeIdentifier)' != 'browser-wasm')"
            CopyToOutputDirectory="PreserveNewest"
            Include="$(MSBuildThisFileDirectory)lib/linux-x64/mimalloc-3.3/lib/libmimalloc.so.3.3"
            Link="libmimalloc.so"
        />
    </ItemGroup>
</Project>
